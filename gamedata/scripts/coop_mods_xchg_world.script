-- Ядро: без проверок режима (docs/MODES.md)
-- Dot Marks defuse and itms_manager placement use the G4 exchange on the player's map.
-- Co-op: the playing host has the objects, character positions and inventory.
-- Server: the world server relays the request; the authority of the player's map checks those same facts.
-- The engine replicates the resulting ALife changes. No saved state or additional wire verbs.

local api = rawget(_G, "coop")
local BOMB, PLACE = "dm_bomb", "item_place"
local GROUND = 65535
local DEFUSE_RANGE_SQ = 3.5 ^ 2 -- dotmarks_main, the Explosive preset
local PLACE_RANGE_SQ = 3 ^ 2 -- original offset (1.2 m forward, 1 m up) plus room for player replication
local MAX_COORD = 100000
local MAX_HEADING = 1.5 * math.pi + 1e-6 -- getH spans -pi/2 to 3*pi/2, with float rounding

local core = coop_mods_core
local xchg = coop_mods_xchg

local function present(from, who)
	return who and coop_mode.where(from) == "here" and who:alive()
end

local function placed_on_ground(se, section)
	return se and se.parent_id == GROUND and se:section_name() == section
end

local function mine_reward(dm, section)
	local cfg = dm.cfg
	if cfg and cfg.disarmables and next(cfg.disarmables) then return cfg.disarmables[section] end
	-- The HUD may not have loaded its presets yet. This is the table its parse_file_data inverts.
	local tm = core.mod("txr_mines")
	if tm and type(tm.EXPLOSIVE_SECTION_LOOKUP) == "table" then
		for item, mine in pairs(tm.EXPLOSIVE_SECTION_LOOKUP) do
			if mine == section then return item end
		end
	end
end

local function mine_target(dm, t, from, who)
	if not present(from, who) then return nil, "no_character_here" end
	local id = core.wire_id(t.i)
	local se = id and alife_object(id)
	local obj = se and level.object_by_id(id)
	if not (obj and placed_on_ground(se, obj:section())) then return nil, "no_world_mine" end
	local section = obj:section()
	local reward = mine_reward(dm, section)
	if not (type(reward) == "string" and ini_sys:section_exist(reward)) then return nil, "mine_section" end
	return { id = id, section = section, reward = reward, owner = who:id(), obj = obj, spent = { id } }
end

local function clean_stock_mine(tm, id)
	if tm and type(tm.clean_mines) == "function" then tm.clean_mines(id) end
end

local function clear_mine(token)
	local tm = core.mod("txr_mines")
	local registry = coop_npc_world._mines()
	token.stock = tm and tm._mines
	token.coop = registry
	token.stock_entry = token.stock and token.stock[token.id]
	token.coop_entry = registry[token.id]
	clean_stock_mine(tm, token.id)
	registry[token.id] = nil
end

local function restore_mine(token)
	local id = token.id
	if not placed_on_ground(alife_object(id), token.section) then return end
	if token.stock and not token.stock[id] then token.stock[id] = token.stock_entry end
	if token.coop and not token.coop[id] then token.coop[id] = token.coop_entry end
end

-- The dispatcher waits for deletion before completing. A separate cleanup only runs if the deletion never happened.
local function release(id, on_stuck)
	if alife_release_id(id) == false then return false, "release" end
	xchg.after_gone(id, function(gone)
		if not gone and alife_object(id) then on_stuck() end
	end)
	return true
end

local function install_mines(dm)
	if not (core.fn(dm, "remove_bomb") and core.fn(dm, "unregister_scanned_entity")) then return end
	xchg.serve(BOMB, {
		check = function(t, from, who)
			local token, why = mine_target(dm, t, from, who)
			if not token then return false, why end
			return who:position():distance_to_sqr(token.obj:position()) <= DEFUSE_RANGE_SQ, "mine_distance"
		end,
		reserve = function(t, from, who)
			local token, why = mine_target(dm, t, from, who)
			if not token then return nil, why end
			token.obj = nil
			return token
		end,
		commit = function(_, _, _, token)
			clear_mine(token)
			return release(token.id, function() restore_mine(token) end)
		end,
		rollback = function(_, _, _, token) restore_mine(token) end,
		after_gone = function(_, from, who, token)
			if not (present(from, who) and who:id() == token.owner) then return false, "no_character_here" end
			if not alife_create_item(token.reward, who) then return false, "reward_create" end
			return true
		end,
	})
	xchg.set_timeout(BOMB, 15000)
	core.wrap(dm, "remove_bomb", "xchg_world.remove_bomb", function(orig)
		return function(mark, ...)
			if not core.active() then return orig(mark, ...) end
			local id = mark and mark.is_disarmable and mark.id
			local key = id and core.hid(id)
			if key and not xchg.busy(BOMB, key) then
				xchg.ask(BOMB, { key = key, i = key }, function(ok)
					if not ok then return end
					local get_mark = core.fn(dm, "get_mark")
					local current = get_mark and get_mark(id)
					if current and current ~= mark then return end
					clean_stock_mine(core.mod("txr_mines"), id)
					dm.unregister_scanned_entity(id)
				end)
			end
			return true -- Dot Marks' CreateTimeEvent removes the timer on true.
		end
	end)
end

local function placeable(section)
	if not ini_sys:section_exist(section) then return false end
	-- The inventory menu exposes up to ten custom actions. Resolve the action from the source item's INI.
	for i = 1, 10 do
		if ini_sys:r_string_ex(section, "use" .. i .. "_action_functor") == "itms_manager.use_place" then return true end
	end
	return false
end

local function bounded(n, max)
	return type(n) == "number" and n >= -max and n <= max
end

local function place_target(t, from, who)
	if not present(from, who) then return nil, "no_character_here" end
	local id = core.wire_id(t.i)
	local se = id and alife_object(id)
	if not (se and se.parent_id == who:id()) then return nil, "place_owner" end
	local section = se:section_name()
	if not placeable(section) then return nil, "place_section" end
	if not (bounded(t.x, MAX_COORD) and bounded(t.y, MAX_COORD) and bounded(t.z, MAX_COORD) and bounded(t.h, MAX_HEADING)) then
		return nil, "place_coordinates"
	end
	local pos = vector():set(t.x, t.y, t.z)
	if not (who:position():distance_to_sqr(pos) <= PLACE_RANGE_SQ) then return nil, "place_distance" end
	return { id = id, section = section, pos = pos, heading = t.h, spent = { id } }
end

local function undo_place(token)
	if not token.replacement then return end
	local se = alife_object(token.replacement)
	if se and se:section_name() == token.section then alife_release_id(token.replacement) end
end

local function install_placement(items)
	if not core.fn(items, "use_place") then return end
	xchg.serve(PLACE, {
		check = function(t, from, who)
			local token, why = place_target(t, from, who)
			return token ~= nil, why
		end,
		reserve = place_target, -- G4's reserve receives (t, from, who) after coop_trust.pass
		commit = function(_, _, who, token)
			local se = alife_create(token.section, token.pos, who:level_vertex_id(), who:game_vertex_id())
			if not se then return false, "place_create" end
			token.replacement = se.id
			-- A ground spawn registers synchronously in ALife. Check this exact result; G4 after_made watches inventories.
			if not placed_on_ground(alife_object(token.replacement), token.section) then return false, "place_create" end
			se.angle = vector():set(0, token.heading, 0)
			local source = alife_object(token.id)
			if not (source and source.parent_id == who:id() and source:section_name() == token.section) then
				return false, "place_owner"
			end
			return release(token.id, function() undo_place(token) end)
		end,
		rollback = function(_, _, _, token) undo_place(token) end,
		after_gone = function() return true end,
	})
	xchg.set_timeout(PLACE, 15000)
	core.wrap(items, "use_place", "xchg_world.use_place", function(orig)
		return function(obj, ...)
			if not core.active() then return orig(obj, ...) end
			local actor = db.actor
			local parent = obj and obj:parent()
			if not (actor and parent and parent:id() == actor:id()) then return end
			local key = core.hid(obj:id())
			if not key or xchg.busy(PLACE, key) then return end
			local pos = actor:position()
			local height = pos.y
			local dir = device().cam_dir
			local heading = dir:getH()
			pos:add(dir:mul(1.2))
			pos.y = height + 1
			xchg.ask(PLACE, { key = key, i = key, x = pos.x, y = pos.y, z = pos.z, h = heading })
		end
	end)
end

local installed = {}
local function install_into(module, install)
	local m = core.mod(module)
	if not m then return end
	install(m)
	installed[module] = true
end

local function start_step(module, install)
	if not installed[module] then core.install("xchg_world", module, install_into, module, install) end
end

function on_game_start()
	if not api then return end
	start_step("ui_hud_dotmarks", install_mines)
	start_step("itms_manager", install_placement)
end
