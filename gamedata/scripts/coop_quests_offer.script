--[[
	Anomaly Coop - task offers prepared where the player stands (gamedata\scripts\coop_quests_offer.script).
	Ports the offer half of xrRazom's xrr_patch_quests + xrr_quest_serialize + xrr_patch_pda_taskboard.
	SPEC R-7.3 (texts and targets are computed by the host), R-7.8 (quest dialogs work for every player).

	Why: an NPC's "any work?" offer runs the task's on_job_descr / fetch_func effects (pick a target
	squad, a bounty, a stash, a fetch item, a delivery recipient) when the text is shown. On a client
	these read a frozen ALife copy, and their world side (pinned target squads, spawns) never reaches
	the host. So the co-op host or the map server builds the offer:
	  client: the dialog window opens (GUI_on_show "Dialog") -> quests.offer_req {n = npc, k = kind}
	  leader: generate_available_tasks + on_job_descr + fetch_func for every offered task, as if its
	          actor talked to that NPC (talk shims below), and sends per task the task vars it made and
	          the offer lines it drew (quests.offer_t), then the ordered list (quests.offer).
	  client: generate_available_tasks uses the host's list (tasks the group already has are left out),
	          text_npc_has_task shows the host's offer: the task vars go into the client's pstor, the
	          host's offer lines are shown, a fetch offer is drawn locally in the client's language.
	          Taking the task is coop_tasks' give request; the vars travel with it.
	No answer yet (or another kind of list) -> the stock local generation runs, as before.

	Host talk shims while it prepares an offer: db.actor:is_talking() = true, give_talk_message2 and
	give_game_news captured (nothing is shown on the host), mob_trade.GetTalkingNpc / get_speaker /
	"used_npc_id" = that NPC, CreateTimeEvent with timer 0 runs at once (the offer lines are drawn by
	such events). Everything is put back afterwards, also on errors.

	Host after a client's give (coop_tasks calls host_after_give): the host-side parts of an offer the
	client's own dialog prepared (storyline and mechanic offers stay local) - assault target squad
	pinned, bounty target squad kept in task_squads; if the client brought no task var, the host runs
	on_job_descr itself.
--]]

local qc = coop_quests_core
local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall
local table_concat = table.concat

local TAG = "offer"
local OFFER_TTL = 180000 -- ms a host offer stays usable on the client
local REQ_GAP = 1000 -- ms between two client requests for one NPC
local HOST_REQ_GAP = REQ_GAP / 2 -- allow for differences in delivery time
local BATCH_TIMEOUT = 5 -- s the taskboard waits for the host
local MAX_DIST_DIALOG = 30 -- m between the requester's character and the NPC (host check)
local MAX_DIST_BOARD = 200 -- m for the PDA taskboard
local MAX_MSGS = 4

-- iTheon's taskboard (lizzardman) treats these non-"sim_" NPCs as sim task givers (its local list).
local SIM_OVERRIDES = {
	bar_visitors_garik_stalker_guard = true,
	bar_visitors_zhorik_stalker_guard2 = true,
	bar_arena_guard = true,
	bar_dolg_general_zoneguard_stalker = true,
	mil_smart_terrain_7_7_freedom_bodyguard_stalker = true,
	mil_smart_terrain_7_7_freedom_bodyguard2_stalker = true,
}

local stats = {
	req_out = 0, req_in = 0, refused = 0, offers_in = 0, used = 0, local_gen = 0, shown = 0,
	after_give = 0, pinned = 0, rerun = 0, far_empty = 0, made = 0, made_in = 0,
}

-- An NPC who talks and gives tasks: a stalker, or a trader (Sidorovich is m_trader, class AI_TRD_S = clsid.script_trader, and the
-- stock IsStalker says no for him).
local function talker(o)
	if not o then return false end
	if IsStalker(o) then return true end
	local is_trader = rawget(_G, "IsTrader") or IsTrader
	return type(is_trader) == "function" and is_trader(o) == true
end

local function ini() return task_manager and task_manager.task_ini end

local function r_str(sec, key)
	local i = ini()
	if not i then return nil end
	local ok, v = pcall(i.r_string_ex, i, sec, key)
	return ok and v or nil
end

local function atm() return rawget(_G, "axr_task_manager") or axr_task_manager end

local function tmgr()
	local ok, tm = pcall(task_manager.get_task_manager)
	return ok and tm or nil
end

-- The task's own pstor vars (key = id or "<id>_...").
local function task_vars(id)
	local out = {}
	local st = db.actor and db.storage[db.actor:id()]
	local ps = st and st.pstor
	if not ps then return out end
	local n = #id
	for k, v in pairs(ps) do
		if type(k) == "string" and k:sub(1, n) == id and (#k == n or k:sub(n + 1, n + 1) == "_") then
			local tv = type(v)
			if tv == "string" or tv == "number" or tv == "boolean" or tv == "table" then out[k] = v end
		end
	end
	return out
end

-- Direct pstor write: the host has these values already (no save_var routing).
local function put_vars(vars)
	if type(vars) ~= "table" or not db.actor then return end
	local st = db.storage[db.actor:id()]
	if not st then return end
	st.pstor = st.pstor or {}
	for k, v in pairs(vars) do
		if type(k) == "string" then st.pstor[k] = v end
	end
end

local function is_sim_section(sec)
	if type(sec) ~= "string" then return false end
	if SIM_OVERRIDES[sec] then return true end
	return sec:find("sim_", 1, true) ~= nil or sec:find("simulation_", 1, true) ~= nil
end

-- The fetch var a task's fetch_func fills: first argument of the setup effect (stock: "<id>_fetch").
local function fetch_var_of(tid)
	local f = r_str(tid, "fetch_func")
	local name = f and f:match("%(%s*([^:%)%s]+)")
	return name or (tid .. "_fetch")
end

-------------------------------------------------------------------------------
-- Host: offer generation
-------------------------------------------------------------------------------
local cap = { on = false, msgs = nil }

local function cap_msg(caption, text, icon, templ)
	if not (cap.on and cap.msgs) or #cap.msgs >= MAX_MSGS then return end
	cap.msgs[#cap.msgs + 1] = {
		c = tostring(caption or ""), t = tostring(text or ""), i = tostring(icon or ""),
		p = tostring(templ or "iconed_answer_item"),
	}
end

-- Runs fn as if the host's actor talked to npc. Returns pcall's results.
function with_talk(npc, fn, ...)
	local saved = {}
	local mt = rawget(_G, "mob_trade") or mob_trade
	if mt then
		saved.gtn = mt.GetTalkingNpc
		mt.GetTalkingNpc = function() return npc end
	end
	saved.speaker = rawget(_G, "get_speaker")
	_G.get_speaker = function() return npc end
	local have_events = type(rawget(_G, "GetEvent")) == "function" and type(rawget(_G, "SetEvent")) == "function"
	if have_events then
		saved.used = GetEvent("used_npc_id")
		SetEvent("used_npc_id", npc:id())
	end
	saved.cte = rawget(_G, "CreateTimeEvent")
	local real_cte = saved.cte
	_G.CreateTimeEvent = function(ev_id, act_id, timer, f, ...)
		if (tonumber(timer) or 0) <= 0 and type(f) == "function" then
			if cap.on then
				local ok, err = pcall(f, ...)
				if not ok then qc.report(TAG, "offer line", err) end
			end
			return -- a deferred offer line nobody sees on the host
		end
		return real_cte(ev_id, act_id, timer, f, ...)
	end

	local res = { qc.with_actor({
		is_talking = function() return true end,
		give_talk_message2 = function(_, caption, text, icon, templ) cap_msg(caption, text, icon, templ) end,
		give_game_news = function() return nil end,
	}, fn, ...) }

	_G.CreateTimeEvent = saved.cte
	if have_events then SetEvent("used_npc_id", saved.used) end
	_G.get_speaker = saved.speaker
	if mt then mt.GetTalkingNpc = saved.gtn end
	return unpack(res)
end

-- Host, inside with_talk: the offer of one task (vars it made, lines it drew).
local function capture(tid)
	local d = { msgs = {} }
	cap.msgs = d.msgs
	local on_jd = r_str(tid, "on_job_descr")
	if on_jd then
		cap.on = true
		local ok, err = pcall(function()
			local cond = xr_logic.parse_condlist(db.actor, "task_manager", "condlist", on_jd)
			if cond then xr_logic.pick_section_from_condlist(db.actor, db.actor, cond) end
		end)
		cap.on = false
		if not ok then qc.report(TAG, "on_job_descr " .. tid, err) end
	end
	if r_str(tid, "fetch_descr") then
		local a = atm()
		if a and a.trigger_fetch_func then
			local ok, err = pcall(a.trigger_fetch_func, tid) -- its "needs:" line is drawn by the client
			if not ok then qc.report(TAG, "fetch_func " .. tid, err) end
		end
	end
	cap.msgs = nil
	d.vars = task_vars(tid)
	local a = atm()
	local b = a and a.bounties_by_id
	if type(b) == "table" and type(b[tid]) == "number" then d.bounty = b[tid] end
	return d
end

local function host_generate(npc, is_sim)
	local a = atm()
	if not (a and a.generate_available_tasks) then return nil, {} end
	local id = npc:id()
	local list, data = {}, {}
	local ok, err = with_talk(npc, function()
		if a.clear_skipped_tasks then a.clear_skipped_tasks() end
		a.generate_available_tasks(npc, is_sim and true or nil)
		local av = a.available_tasks and a.available_tasks[id]
		if type(av) == "table" then
			for _, tid in ipairs(av) do list[#list + 1] = tid end
		end
		for _, tid in ipairs(list) do
			local okc, d = pcall(capture, tid)
			if okc then data[tid] = d else qc.report(TAG, "capture " .. tostring(tid), d) end
		end
	end)
	if not ok then
		local oks, squad = pcall(function()
			local se = alife_object(npc:id())
			return se and se.group_id
		end)
		local okv, vertex = pcall(npc.game_vertex_id, npc)
		local okl, level_id = pcall(function()
			local graph = game_graph()
			if okv and type(vertex) == "number" and graph:valid_vertex_id(vertex) then
				return graph:vertex(vertex):level_id()
			end
		end)
		qc.report(TAG, string.format("generate for %s (squad=%d vertex=%d level=%d)", npc:name(),
			oks and tonumber(squad) or -1, okv and tonumber(vertex) or -1, okl and tonumber(level_id) or -1), err)
		return nil, {}
	end
	return list, data
end

local last_req = {} -- "peer:npc" -> time

-------------------------------------------------------------------------------
-- Host: the offers made to each player
-------------------------------------------------------------------------------
-- A give request (coop_tasks ops.give) carries the task vars his dialog prepared. They count as the host's own facts only where
-- they are what the host offered him (coop_tasks check task_give_offer). offer_here keeps, per player, task and NPC, the vars it
-- sent (serialized: a copy that nothing changes later), with his character (a peer slot may come back as another player). Kept
-- until the task is given to him, for OFFER_KEEP_MS at most, OFFERS_MAX per player (the oldest go first). In Server mode the
-- map server's cache is local to that process. The world server still judges a give using its existing no-offer rules.
local OFFER_KEEP_MS = 3600000
local OFFERS_MAX = 256
local made_offers = {} -- peer -> { n, tasks = { [task id] = { [npc id] = { s = serialized vars, at, char } } } }

local function character_of(peer)
	local ct = qc.mod("coop_tasks")
	local ok, c = pcall(function() return ct.character_of(peer) end)
	return ok and c or nil
end

-- Expose this function so the map server can pass an offer to the world server, which records it the same way it records
-- its own offers before coop_tasks validates the give.
function note_offer(peer, npc_id, tid, vars, bounty)
	local s = qc.ser(vars or {})
	if not (type(peer) == "number" and type(tid) == "string" and s) then return end
	local mine = made_offers[peer]
	if not mine then
		mine = { n = 0, tasks = {} }
		made_offers[peer] = mine
	end
	local per = mine.tasks[tid]
	if not per then
		per = {}
		mine.tasks[tid] = per
	end
	if per[npc_id] == nil then mine.n = mine.n + 1 end
	-- the bounty target the offer named is kept too (coop_tasks judges a give's t.bt)
	per[npc_id] = { s = s, at = time_global(), char = character_of(peer), bt = type(bounty) == "number" and bounty or nil }
	while mine.n > OFFERS_MAX do
		local old_t, old_n, old_at = nil, nil, nil
		for t, list in pairs(mine.tasks) do
			for n, o in pairs(list) do
				if not old_at or o.at < old_at then old_t, old_n, old_at = t, n, o.at end
			end
		end
		if not old_t then break end
		mine.tasks[old_t][old_n] = nil
		if next(mine.tasks[old_t]) == nil then mine.tasks[old_t] = nil end
		mine.n = mine.n - 1
	end
end

-- Host: copies of the vars of the offers of task `tid` this process made player `peer` (newest first); nil: none. Second value
-- Per offer, in the same order, { npc = the NPC that made it, bt = the bounty target it named or nil }.
function offers_of(peer, tid)
	local mine = made_offers[peer]
	local per = mine and mine.tasks[tid]
	if not per then return nil end
	local char, t, list = character_of(peer), time_global(), {}
	for npc_id, o in pairs(per) do
		if t - o.at <= OFFER_KEEP_MS and (o.char == nil or char == nil or o.char == char) then
			list[#list + 1] = { o = o, npc = npc_id }
		end
	end
	table.sort(list, function(a, b) return a.o.at > b.o.at end)
	local out, meta = {}, {}
	for _, e in ipairs(list) do
		local v = qc.des(e.o.s)
		if type(v) == "table" then
			out[#out + 1] = v
			meta[#meta + 1] = { npc = e.npc, bt = e.o.bt }
		end
	end
	if #out == 0 then return nil end
	return out, meta
end

-- The host refused player `peer`'s request for the offers of NPC `npc_id` (his machine makes them itself now): the
-- offers of that NPC kept for him go.
function forget_offers(peer, npc_id)
	local mine = made_offers[peer]
	if not (mine and npc_id) then return end
	for tid, per in pairs(mine.tasks) do
		if per[npc_id] ~= nil then
			per[npc_id] = nil
			mine.n = mine.n - 1
			if next(per) == nil then mine.tasks[tid] = nil end
		end
	end
end

-- Host: task `tid` was given to player `peer`: his offers of it are spent.
function offer_given(peer, tid)
	local mine = made_offers[peer]
	local per = mine and mine.tasks[tid]
	if not per then return end
	for _ in pairs(per) do mine.n = mine.n - 1 end
	mine.tasks[tid] = nil
end

-- Is this answer made over the far view: for a level this process does not lead (a world server for every level, the host
-- of split levels for the others)? There the NPC is a stand-in of its ALife record, not a game object.
local function over_far_view()
	local ok, scope = pcall(coop_mode.far().in_scope)
	return ok and scope ~= nil
end

local request_peer

-- The transport peer while the Core builds an offer. Mode adapters may read it synchronously.
function requester() return request_peer end

-- A mode adapter can report that its inputs for this requester have not arrived yet.
function request_ready(_) return true end

local function offer_here(t, from, relayed)
	stats.req_in = stats.req_in + 1
	local npc_id, seq = tonumber(t.n), tonumber(t.q)
	-- the NPC is a whole object id 1..65534, else none; the
	-- sequence number his answer carries back is a whole number too
	if not (npc_id and npc_id >= 1 and npc_id <= 65534 and npc_id == math.floor(npc_id)) then npc_id = nil end
	local valid_seq = seq and seq >= 0 and seq <= 1e9 and seq == math.floor(seq)
	if not valid_seq then seq = 0 end
	local kind = t.k == "sim" and "sim" or "dyn"
	local npc = npc_id and level.object_by_id(npc_id)
	local function refuse(why)
		if why == "error" then
			qc.log(TAG, "offer generation failed for peer %d, NPC %d, sequence %d", from, npc_id or 0, seq)
		else
			-- These request checks are mandatory in every trust mode.
			local trust = coop_trust
			if trust and type(trust.pass) == "function" then
				trust.pass("offer_request", false, "peer %d, NPC %d, sequence %d: %s", from, npc_id or 0, seq, why)
			end
		end
		stats.refused = stats.refused + 1
		-- Rate and sequence refusals leave the prior answer usable in the player's dialog.
		if why ~= "rate" and why ~= "seq" then forget_offers(from, npc_id) end
		qc.send("offer", { n = npc_id or 0, q = seq, k = kind, e = why, l = "" }, from)
	end
	if not (npc and talker(npc) and npc:alive()) then return refuse("npc") end
	if not valid_seq then return refuse("seq") end
	local key = tostring(from) .. ":" .. npc_id
	if last_req[key] and time_global() - last_req[key] < HOST_REQ_GAP then return refuse("rate") end -- answer, or a board batch waits
	local av = qc.avatar_obj(from)
	if relayed and not (av and from ~= 0 and from ~= qc.self_peer()) then return refuse("avatar") end
	local max = t.b == true and MAX_DIST_BOARD or MAX_DIST_DIALOG
	last_req[key] = time_global()
	if av and npc:position():distance_to_sqr(av:position()) > max * max then return refuse("far") end
	if not request_ready(from) then return refuse("faction") end

	local previous = request_peer
	request_peer = from
	local ok, list, data = pcall(host_generate, npc, kind == "sim")
	request_peer = previous
	if not ok then
		qc.report(TAG, "generate offer", list)
		return refuse("error")
	end
	if not list then return refuse("error") end
	local far = over_far_view()
	-- an empty list made over the far view is no answer to his machine, which makes this
	-- NPC's offers itself (client_on_offer): as after a refusal, an older offer of the NPC kept for him is no longer what his dialog
	-- shows
	if #list == 0 and far then forget_offers(from, npc_id) end
	for _, tid in ipairs(list) do
		local d = data[tid] or {}
		local msg = { n = npc_id, q = seq, i = tid }
		local v = qc.ser(d.vars or {})
		if v and #v <= qc.MAX_BLOB then
			msg.v = v
			note_offer(from, npc_id, tid, d.vars, d.bounty) -- what he was offered (coop_tasks task_give_offer)
		end
		local m = qc.ser(d.msgs or {})
		if m and #m <= 4000 then msg.m = m end
		if d.bounty then msg.bt = d.bounty end
		qc.send("offer_t", msg, from)
	end
	local sent = qc.send("offer", { n = npc_id, q = seq, k = kind, l = table_concat(list, ","), c = #list, f = far and 1 or nil }, from)
	if sent and relayed and t.b == true and #list > 0 then
		qc.log(TAG, "board reply peer=%d npc=%d seq=%d tasks=%d", from, npc_id, seq, #list)
	end
end

-------------------------------------------------------------------------------
-- Client: offers from the host
-------------------------------------------------------------------------------
local offers = {} -- local npc id -> { q, kind, list, tasks = {tid = {vars, msgs, bounty}}, asked, at, complete }
local incoming = {} -- seq -> { npc, tasks }
local seq = 0
local batch = nil -- { pending = {npc_id = true}, left, done }

local function batch_note(npc_id)
	local b = batch
	if not (b and b.pending[npc_id]) then return end
	b.pending[npc_id] = nil
	b.left = b.left - 1
	if b.left <= 0 then
		batch = nil
		if b.done then
			local ok, err = pcall(b.done)
			if not ok then qc.report(TAG, "taskboard refresh", err) end
		end
	end
end

local function offer_target(npc)
	if not talker(npc) then return nil end
	local id = npc:id()
	local host_id = qc.to_host_id(id)
	if type(host_id) ~= "number" or host_id < 1 or host_id > 65534 or host_id % 1 ~= 0
		or qc.is_character_id(id) or npc:section() == "coop_player_avatar" then return nil end
	return host_id
end

-- Client: asks the host for the offer of one NPC (local object). board = from the PDA taskboard.
function request_offer(npc, kind, board)
	if not qc.client_live() then return false end
	local host_id = offer_target(npc)
	if not host_id then return false end
	local id = npc:id()
	local o = offers[id]
	if o and o.asked and time_global() - o.asked < REQ_GAP then return true, false end -- asked already: no new answer comes
	seq = seq + 1
	kind = kind or (is_sim_section(npc:section()) and "sim" or "dyn")
	for q, inc in pairs(incoming) do
		if time_global() - inc.at > 60000 then incoming[q] = nil end -- never answered
	end
	incoming[seq] = { npc = id, board_npc = board and host_id or nil, tasks = {}, at = time_global() }
	offers[id] = offers[id] or { tasks = {} }
	offers[id].asked = time_global()
	local ok = qc.send("offer_req", { n = host_id, k = kind, q = seq, b = board and true or nil }, 0)
	if ok then stats.req_out = stats.req_out + 1 end
	return ok, ok
end

-- Client: offers for several NPCs, then done() (at the latest after BATCH_TIMEOUT). False if a batch
-- is already running.
function request_offers(npcs, done, board)
	if batch then return false end
	local b = { pending = {}, left = 0, done = done }
	batch = b
	for _, npc in ipairs(npcs or {}) do
		local id = npc:id()
		local _, sent = request_offer(npc, nil, board)
		if not b.pending[id] and sent then
			b.pending[id] = true
			b.left = b.left + 1
		end
	end
	if b.left == 0 then
		batch = nil
		if done then pcall(done) end
		return true
	end
	-- a finished batch leaves its timeout queued, and CreateTimeEvent ignores a pair that exists
	if type(rawget(_G, "RemoveTimeEvent")) == "function" then RemoveTimeEvent("coop_quests_offer", "batch_timeout") end
	CreateTimeEvent("coop_quests_offer", "batch_timeout", BATCH_TIMEOUT, function()
		if batch == b then
			batch = nil
			if b.done then
				local ok, err = pcall(b.done)
				if not ok then qc.report(TAG, "taskboard refresh", err) end
			end
		end
		return true
	end)
	return true
end

-- The world server relays a map server's reply with origin 0 (coop_script.cpp, server_on_script_event).
local function client_on_offer_t(t, from)
	if from ~= 0 or not qc.is_client() then return end
	local inc = incoming[tonumber(t.q)]
	if not (inc and type(t.i) == "string" and t.i ~= "") then return end
	local d = { vars = {}, msgs = {} }
	if type(t.v) == "string" then
		local v = qc.des(t.v)
		if type(v) == "table" then
			for k, x in pairs(v) do
				if type(k) == "string" and k:sub(1, #t.i) == t.i then d.vars[k] = x end
			end
		end
	end
	if type(t.m) == "string" then
		local m = qc.des(t.m)
		if type(m) == "table" then
			for i = 1, math.min(#m, MAX_MSGS) do
				local x = m[i]
				if type(x) == "table" then
					d.msgs[#d.msgs + 1] = {
						c = tostring(x.c or ""), t = tostring(x.t or ""), i = tostring(x.i or ""),
						p = type(x.p) == "string" and x.p ~= "" and x.p or "iconed_answer_item",
					}
				end
			end
		end
	end
	if type(t.bt) == "number" then d.bounty = qc.to_local_id(t.bt) end
	inc.tasks[t.i] = d
end

local function client_on_offer(t, from)
	if from ~= 0 or not qc.is_client() then return end
	local q = tonumber(t.q)
	local inc = q and incoming[q]
	incoming[q or -1] = nil
	local npc_id = inc and inc.npc or qc.to_local_id(tonumber(t.n))
	if not npc_id then return end
	stats.offers_in = stats.offers_in + 1
	if type(t.e) == "string" then
		qc.log(TAG, "host refused the offer of #%s: %s", tostring(npc_id), t.e)
		local o = offers[npc_id]
		if t.e == "faction" and inc and o and o.q and o.q < q then
			-- The refresh callback must fall back to stock while the faction is unavailable.
			offers[npc_id] = { tasks = {}, asked = o.asked }
		end
		batch_note(npc_id)
		return
	end
	local list = {}
	for tid in tostring(t.l or ""):gmatch("[^,]+") do list[#list + 1] = tid end
	-- A list with nothing in it that was made over the far view is no answer. A world server has no game objects of a
	-- player's level: it makes the offers over stand-ins, standing on fake_start itself, so its
	-- lists can come back empty for every NPC of a map.
	-- As after a refusal: the list of this NPC is made here, by the stock code over the real NPC; the give still asks the host.
	if #list == 0 and t.f then
		stats.far_empty = stats.far_empty + 1
		offers[npc_id] = { tasks = {}, asked = offers[npc_id] and offers[npc_id].asked }
		batch_note(npc_id)
		return
	end
	offers[npc_id] = {
		q = q, kind = t.k == "sim" and "sim" or "dyn", list = list, tasks = inc and inc.tasks or {},
		board_npc = inc and not t.f and inc.board_npc == tonumber(t.n) and inc.board_npc or nil,
		asked = offers[npc_id] and offers[npc_id].asked, at = time_global(), complete = true,
	}
	batch_note(npc_id)
end

local function fresh_offer(npc_id, kind)
	local o = offers[npc_id]
	if not (o and o.complete and o.kind == kind and time_global() - o.at < OFFER_TTL) then return nil end
	return o
end

-- The engine opens the granted dialog with this actor's actual talk partner.
local function talking_npc()
	local actor = db.actor
	local partner = actor and actor.get_talking_npc and actor:get_talking_npc()
	if offer_target(partner) then return partner end
	local id = type(rawget(_G, "GetEvent")) == "function" and GetEvent("used_npc_id")
	local o = type(id) == "number" and level.object_by_id(id)
	if offer_target(o) then return o end
	for _, st in pairs(db.storage) do
		local obj = st.object
		if obj then
			local ok, talking = pcall(obj.is_talking, obj)
			if ok and talking and offer_target(obj) then return obj end
		end
	end
	return nil
end

local function on_gui_show(name)
	if name ~= "Dialog" or not qc.client_live() then return end
	local npc = talking_npc()
	if npc then request_offer(npc) end
end

-- Offer lines on the client, one frame later (the talk window must be settled).
local function show_lines(tid, d, fetch)
	local lines = {}
	for _, m in ipairs(d.msgs or {}) do lines[#lines + 1] = m end
	CreateTimeEvent("coop_quests_offer", "lines_" .. tid, 0, function()
		if not db.actor then return true end
		for _, m in ipairs(lines) do
			pcall(db.actor.give_talk_message2, db.actor, m.c, m.t, m.i, m.p)
		end
		local tf = qc.mod("tasks_fetch")
		if fetch and tf and type(tf.postpone_fetch_for_next_frame) == "function" then
			pcall(tf.postpone_fetch_for_next_frame, fetch.var, fetch.sec, fetch.cnt)
		end
		return true
	end)
end

-- Applies the host's offer of tid on this client: vars, bounty; returns the fetch info if any.
local function adopt(tid, d)
	put_vars(d.vars)
	local a = atm()
	if d.bounty and a and type(a.bounties_by_id) == "table" then a.bounties_by_id[tid] = d.bounty end
	if not r_str(tid, "fetch_descr") then return nil end
	local var = fetch_var_of(tid)
	local sec = d.vars and d.vars[var]
	if type(sec) ~= "string" then return nil end
	local cnt = tonumber(d.vars[var .. "_count"]) or 1
	local name = ui_item and ui_item.get_sec_name and ui_item.get_sec_name(sec) or sec
	dialogs._FETCH_TEXT = name
	return { var = var, sec = sec, cnt = cnt, name = name }
end

local function client_task_text(a, b)
	local npc = dialogs.who_is_npc(a, b)
	if not npc then return nil end
	local id = npc:id()
	local av = atm().available_tasks[id]
	local tid = av and av[1]
	local o = offers[id]
	local d = tid and o and o.complete and o.tasks[tid]
	if not d then return nil end
	local fetch = adopt(tid, d)
	show_lines(tid, d, fetch)
	stats.shown = stats.shown + 1
	local fd = r_str(tid, "fetch_descr")
	if fd and fetch then
		return strformat(game.translate_string(fd), fetch.name or "")
	end
	return game.translate_string(r_str(tid, "job_descr") or "st_no_available_task")
end

local function on_offer_req(payload, from, relayed)
	local t = qc.decode(payload)
	if relayed then return offer_here(t, from, true) end -- the map server has the real NPC
	return qc.with_level_of(from, offer_here, t, from) -- the co-op host, or a world server without a bridge for this player yet
end

-------------------------------------------------------------------------------
-- Client wrappers
-------------------------------------------------------------------------------
local function patch_client()
	local a = atm()
	if a and type(a.generate_available_tasks) == "function" then
		local orig = a.generate_available_tasks
		a.generate_available_tasks = function(npc, is_sim, ...)
			if not (qc.client_live() and npc) then return orig(npc, is_sim, ...) end
			local id = npc:id()
			local o = fresh_offer(id, is_sim and "sim" or "dyn")
			if not o then
				local previous = offers[id]
				if previous then previous.board_list = nil end
				stats.local_gen = stats.local_gen + 1
				return orig(npc, is_sim, ...)
			end
			local tm = tmgr()
			local ti = tm and tm.task_info or {}
			local list = a.available_tasks[id]
			if type(list) ~= "table" then
				list = {}
				a.available_tasks[id] = list
			else
				empty_table(list)
			end
			for _, tid in ipairs(o.list) do
				if ti[tid] == nil then list[#list + 1] = tid end
			end
			if o.board_npc then o.board_list = list end
			stats.used = stats.used + 1
		end
	else
		qc.log(TAG, "! axr_task_manager.generate_available_tasks not found: offers stay local")
	end

	if dialogs and type(dialogs.text_npc_has_task) == "function" then
		local orig = dialogs.text_npc_has_task
		dialogs.text_npc_has_task = function(a1, b1, ...)
			if qc.client_live() then
				local ok, res = pcall(client_task_text, a1, b1)
				if ok and res then return res end
				if not ok then qc.report(TAG, "offer text", res) end
			end
			return orig(a1, b1, ...)
		end
	end
end

-------------------------------------------------------------------------------
-- PDA taskboard (iTheon's, lizzardman's custom version): rows from the host's offers
-------------------------------------------------------------------------------
-- The "needs: <item> (xN)" line of a task that asks for an item, as the stock script words it on this machine
-- (tasks_fetch.postpone_fetch_for_next_frame: this player's language, the task's icon). The stock board steals that line when
-- the task's script runs. On a client the script does not run: the host prepared the offer and sent the item with it, and
-- nobody drew the line, so every such row would have "-" for a title and the noise picture.
local function fetch_line(tid, d)
	if not r_str(tid, "fetch_descr") then return nil end
	local var = fetch_var_of(tid)
	local sec = d.vars and d.vars[var]
	if type(sec) ~= "string" then return nil end
	local tf = qc.mod("tasks_fetch")
	if not (tf and type(tf.postpone_fetch_for_next_frame) == "function") then return nil end
	local line
	local ok, err = qc.with_actor({
		give_talk_message2 = function(_, caption, text, icon)
			line = line or { task_title = caption, task_details = text, task_icon = icon }
		end,
	}, tf.postpone_fetch_for_next_frame, var, sec, tonumber(d.vars[var .. "_count"]) or 1)
	if not ok then qc.report(TAG, "taskboard line of " .. tostring(tid), err) end
	return line
end

local function patch_taskboard()
	local pt = qc.mod("pda_taskboard")
	local ut = qc.mod("ui_pda_taskboard_tab")
	if not (type(pt) == "table" and type(ut) == "table" and ut.pda_taskboard_tab) then return end
	local tab = ut.pda_taskboard_tab
	local orig_refresh = tab.OnBtnRefreshClicked
	local orig_prepare = pt.prepare_task
	local orig_details = pt.get_details
	if type(orig_refresh) == "function" and type(pt.get_nearby_npcs) == "function" and type(pt.refresh_tasks) == "function" then
		tab.OnBtnRefreshClicked = function(self, ...)
			if not qc.client_live() then return orig_refresh(self, ...) end
			if self.task_list and self.task_list.RemoveAll then self.task_list:RemoveAll() end
			local npcs = {}
			local ok, list = pcall(pt.get_nearby_npcs)
			if ok and type(list) == "table" then npcs = list end
			local started = request_offers(npcs, function()
				pt.refresh_tasks()
				if self.DrawCategoryList then self:DrawCategoryList() end
			end, true)
			if not started then return orig_refresh(self, ...) end
		end
	end
	if type(orig_prepare) == "function" then
		pt.prepare_task = function(task_data, ...)
			if not (qc.client_live() and type(task_data) == "table") then return orig_prepare(task_data, ...) end
			local o = offers[task_data.npc_id]
			local d = o and o.complete and o.tasks[task_data.task_id]
			if not d then return orig_prepare(task_data, ...) end
			-- never run on_job_descr here: world side effects for every task of every NPC around
			adopt(task_data.task_id, d) -- task vars + dialogs._FETCH_TEXT for the description below
			if type(pt.get_long_task_description) == "function" then
				local okd, txt = pcall(pt.get_long_task_description, task_data)
				if okd then task_data.task_description = txt end
			end
			-- The SS verdict needs a row built from the accepted list, after the board's own row filtering.
			if o.board_list and not o.board_row_logged then
				for _, tid in ipairs(o.board_list) do
					if tid == task_data.task_id then
						qc.log(TAG, "board prepared peer=%d npc=%d seq=%d", qc.self_peer(), o.board_npc, o.q)
						o.board_row_logged = true
						break
					end
				end
			end
		end
	end
	if type(orig_details) == "function" then
		pt.get_details = function(task_info, ...)
			local res = orig_details(task_info, ...)
			if res or not (qc.client_live() and type(task_info) == "table") then return res end
			local tid = task_info.task_id
			-- the offer of the NPC the row belongs to; another NPC's offer of that task when the row does not say whose it is
			local own = offers[task_info.npc_id]
			local d = own and own.complete and own.tasks[tid]
			if not d then
				for _, o in pairs(offers) do
					d = o.complete and o.tasks[tid]
					if d then break end
				end
			end
			if not d then return nil end
			local m = d.msgs and d.msgs[1]
			if m then return { task_title = m.c, task_details = m.t, task_icon = m.i } end
			return fetch_line(tid, d)
		end
	end
	local orig_click = tab.OnTaskClicked
	if type(orig_click) == "function" then
		tab.OnTaskClicked = function(self, ...)
			local item = qc.active() and self.task_list and self.task_list:GetSelectedItem()
			if item and item.is_blocked then
				local am = rawget(_G, "actor_menu")
				if am and am.set_msg then pcall(am.set_msg, 1, game.translate_string("st_coop_quests_npc_limit"), 5) end
			end
			return orig_click(self, ...)
		end
	end
	qc.log(TAG, "PDA taskboard: rows of a client come from the host's offers")
end

-- The journal is one for the group, so the stock limit of tasks per NPC counted every player's tasks: a friend's two tasks
-- left the NPC red and silent for everybody. In a session the limit is per player in the game.
local function patch_task_limit()
	local dlg = qc.mod("dialogs")
	local limit = type(dlg) == "table" and dlg.get_npc_task_limit
	if type(limit) ~= "function" then return end
	dlg.get_npc_task_limit = function(...)
		local n = limit(...)
		if not qc.active() then return n end
		local ok, list = pcall(qc.players)
		return n * math.max(ok and type(list) == "table" and #list or 1, 1)
	end
end

-------------------------------------------------------------------------------
-- Host: after a client's give request
-------------------------------------------------------------------------------
local function pin_squad(squad_id, stay)
	local squad = type(squad_id) == "number" and alife_object(squad_id)
	if not squad then return false end
	local soc = qc.mod("sim_offline_combat")
	if soc and type(soc.task_squads) == "table" then soc.task_squads[squad_id] = true end
	if stay then pcall(function() squad.stay_time = game.get_game_time() end) end
	stats.pinned = stats.pinned + 1
	return true
end

-- The giver as a talking NPC for on_job_descr effects (a squad gives through its commander):
-- a giver that is no whole object id 1..65534 is none (coop_tasks bounds the request too).
local function giver_npc(giver)
	if type(giver) ~= "number" or not (giver >= 1 and giver <= 65534 and giver == math.floor(giver)) then return nil end
	local o = level.object_by_id(giver)
	if o and talker(o) then return o end
	local se = alife_object(giver)
	local ok, cid = pcall(function() return se and se.commander_id and se:commander_id() end)
	o = ok and cid and level.object_by_id(cid)
	return o and IsStalker(o) and o or nil
end

-- Return the newest stored offer vars for the player and giver, matching either the NPC or the squad commander.
-- Return nil if neither has a stored offer.
local function offered_vars(id, from, giver)
	local list, meta = offers_of(from, id)
	if not list then return nil end
	local npc = giver_npc(giver)
	local nid = npc and npc:id()
	for i, vars in ipairs(list) do
		local m = type(meta) == "table" and meta[i]
		if type(m) == "table" and m.npc ~= nil and (m.npc == giver or m.npc == nid) then return vars end
	end
	return nil
end

-- Before host_after_give reruns on_job_descr, the mode layer can restore vendor caches from the player's offer.
-- The co-op host already has those caches. The world server needs the offer vars from the process that made it.
function prime_rerun(id, vars) end

function host_after_give(id, from, giver, got_vars)
	if not qc.active() or not coop_mode.decides_world() then return end
	stats.after_give = stats.after_give + 1
	local on_jd = r_str(id, "on_job_descr") or ""
	-- the client's dialog brought no task var: the host prepares the task itself
	if on_jd ~= "" and not (got_vars and got_vars[id]) and load_var(db.actor, id) == nil then
		local npc = giver_npc(giver)
		if npc then
			local okv, vars = pcall(offered_vars, id, from, giver)
			if okv and type(vars) == "table" then
				local okp, perr = pcall(prime_rerun, id, vars)
				if not okp then qc.report(TAG, "prime rerun " .. id, perr) end
			end
			stats.rerun = stats.rerun + 1
			local ok, err = with_talk(npc, function()
				local cond = xr_logic.parse_condlist(db.actor, "task_manager", "condlist", on_jd)
				if cond then xr_logic.pick_section_from_condlist(db.actor, db.actor, cond) end
			end)
			if not ok then qc.report(TAG, "host on_job_descr " .. id, err) end
		end
	end
	if on_jd:find("setup_assault_task", 1, true) then
		local var = load_var(db.actor, id)
		if type(var) == "table" then pin_squad(var.squad_id, true) end
	end
	if on_jd:find("setup_bounty_task", 1, true) then
		local a = atm()
		local target = a and type(a.bounties_by_id) == "table" and a.bounties_by_id[id]
		local se = type(target) == "number" and alife_object(target)
		if se and se.group_id and se.group_id ~= 65535 then pin_squad(se.group_id, false) end
	end
end

-------------------------------------------------------------------------------
-- Host: a give with no offer of its giver
-------------------------------------------------------------------------------
-- Storyline, mechanic and change-faction dialogs prepare vars on the player's machine. A refused or expired offer or an
-- empty far-view list can also leave a give without a matching offer. The host validates possible picks from the three
-- fetch generators in the stock and modpack task files and from bounty setup. On refusal, coop_tasks asks the host to
-- generate a valid pick.

local fetch_cats = nil -- category of items\settings\fetch_list.ltx -> { [section] = true }; false: not readable here

-- The fetch list tasks_fetch reads (its on_game_start): [fetch_list] names the categories, each category lists its sections.
local function categories()
	if fetch_cats ~= nil then return fetch_cats or nil end
	fetch_cats = false
	local ok, cats = pcall(function()
		local f = rawget(_G, "ini_file")
		local ini = type(f) == "function" and f("items\\settings\\fetch_list.ltx") or nil
		if not ini then return nil end
		local out = {}
		for i = 0, ini:line_count("fetch_list") - 1 do
			local _, cat = ini:r_line_ex("fetch_list", i, "", "")
			if type(cat) == "string" and cat ~= "" and ini:section_exist(cat) then
				local set = {}
				for j = 0, ini:line_count(cat) - 1 do
					local _, sec = ini:r_line_ex(cat, j, "", "")
					if type(sec) == "string" then set[sec] = true end
				end
				out[cat] = set
			end
		end
		return out
	end)
	if ok and type(cats) == "table" then fetch_cats = cats end
	return fetch_cats or nil
end

-- Can tasks_fetch.setup_fetch_task pick section `sec` for items type `kind`? Its lists, by kind: the category of that name;
-- supplies adds drink; weapons takes weapons or a weapons_<rank / faction> list; repair the two stock kits or its list; patch_general
-- a faction's patch. Membership only: the rank tiers narrow a list, they add nothing. nil: the list cannot be read here.
local function fetch_kind_has(kind, sec)
	if kind == "patch_general" then return sec:sub(-6) == "_patch" end
	local cats = categories()
	if not cats then return nil end
	local function in_cat(name) return type(cats[name]) == "table" and cats[name][sec] == true end
	if kind == "supplies" then return in_cat("supplies") or in_cat("drink") end
	if kind == "repair" then return sec == "sharpening_stones" or sec == "sewing_kit_b" or in_cat("repair") end
	if kind == "weapons" then
		if in_cat("weapons") then return true end
		for name, set in pairs(cats) do
			if name:sub(1, 8) == "weapons_" and set[sec] == true then return true end
		end
		return false
	end
	return in_cat(kind)
end

local function params_of(line, fname)
	local args = type(line) == "string" and line:match("=" .. fname .. "%(([^%)]*)%)")
	if not args then return nil end
	local p = {}
	for x in (args .. ":"):gmatch("([^:]*):") do p[#p + 1] = x end
	return p
end

local function count_in(n, lo, hi)
	n = tonumber(n) or 1
	return n == math.floor(n) and n >= (tonumber(lo) or 1) and n <= (tonumber(hi) or tonumber(lo) or 1)
end

-- The fetch part: ok (true / false / nil = no known generator), why, the keys it judged.
local function fetch_pick(tid, vars)
	local line = r_str(tid, "fetch_func")
	if not line then return true, nil, {} end
	for _, fname in ipairs({ "setup_fetch_task", "setup_generic_fetch_task", "setup_supplies_fetch_task_lostzone_patch" }) do
		local p = params_of(line, fname)
		if p and p[1] and p[1] ~= "" then
			local var = p[1]
			local keys = { var, var .. "_count" }
			local sec, cnt = vars[var], vars[var .. "_count"]
			if type(sec) ~= "string" then
				return false, string.format("his %s is %s, no section", var, tostring(sec)), keys
			end
			local fits, why
			if fname == "setup_fetch_task" then
				fits = fetch_kind_has(p[2] or "", sec)
				if fits == nil then return nil, "the fetch list is not readable here", keys end
				fits = fits and count_in(cnt, p[3], p[4] or p[3])
				why = string.format("%s x %s is no pick of setup_fetch_task(%s: %s, %s..%s)", sec, tostring(cnt or 1), var,
					tostring(p[2]), tostring(p[3] or 1), tostring(p[4] or p[3] or 1))
			elseif fname == "setup_generic_fetch_task" then
				fits = false
				for i = 3, #p do if p[i] == sec then fits = true end end
				fits = fits and (tonumber(cnt) or 1) == (tonumber(p[2]) or 1)
				why = string.format("%s x %s is no pick of setup_generic_fetch_task(%s)", sec, tostring(cnt or 1), var)
			else
				fits = sec:sub(-6) == "_patch" and count_in(cnt, p[2], p[3])
				why = string.format("%s x %s is no patch of setup_supplies_fetch_task_lostzone_patch(%s)", sec, tostring(cnt or 1), var)
			end
			return fits == true, not fits and why or nil, keys
		end
	end
	return nil, "its fetch_func is no generator known here", {}
end

-- Could tasks_bounty.setup_bounty_task (params p: id, all factions but p[4] or only p[4..], near) have picked `target`? A living
-- simulation stalker of those factions, no player's character. The world server's ALife records answer it in a server too.
local function bounty_target_ok(p, target)
	local se = type(target) == "number" and target > 0 and target < 65535 and alife_object(target) or nil
	if not se then return false, string.format("target %s is no object", tostring(target)) end
	local okl, alive = pcall(function() return se:alive() end)
	if okl and alive == false then return false, string.format("target %d is dead", target) end
	if qc.is_character_id and qc.is_character_id(target) then return false, string.format("target %d is a player", target) end
	local oks, sec = pcall(function() return se:section_name() end)
	if oks and type(sec) == "string" and not sec:find("sim_default", 1, true) then
		return false, string.format("target %d (%s) is no simulation stalker", target, sec)
	end
	local f = rawget(_G, "alife_character_community")
	local okc, comm = pcall(function() return type(f) == "function" and f(se) or nil end)
	if okc and type(comm) == "string" then
		local listed = false
		if p[2] == "true" then
			listed = comm == p[4] -- every faction but p[4]
		else
			for i = 4, #p do if p[i] == comm then listed = true end end
		end
		if (p[2] == "true" and listed) or (p[2] ~= "true" and not listed) then
			return false, string.format("target %d is of %s, no faction the task names", target, comm)
		end
	end
	return true, nil
end

-- The bounty part: ok (true / false / nil = not a target this checks), why, the keys it judged (the task's table var and "bt"),
-- job (the task's on_job_descr would make them: a bounty setup, a delivery). Other tables with a target (a stash, a measure, a
-- fate task) are read by their own functors on the host and by no check: not judged.
local function bounty_pick(tid, vars, bt)
	local tv = vars[tid]
	local named = type(tv) == "table" and rawget(tv, "target_id") or nil
	local p = params_of(r_str(tid, "on_job_descr"), "setup_bounty_task")
	if not p then
		if type(tv) == "table" and rawget(tv, "item_1_sec") ~= nil then
			return nil, "a delivery his machine made (the host has no such parcel)", { tid }, true
		end
		if bt ~= nil then return false, "the task is no bounty, he names a target", { "bt" }, false end
		return true, nil, {}, false
	end
	-- a bounty give that names no target is no pick of its setup (setup_bounty_task names
	-- one, or finds none and the task is not offered: TaskBlacklist). The host would keep the last run's target (bounties_by_id and
	-- the task's table survive its end; a dead one turns the new run in at once): "refuse" has the host run the setup itself
	if bt == nil and named == nil then
		return false, "a bounty give that names no target (the host keeps the last run's)", { tid, "bt" }, true
	end
	local target = bt
	if target == nil then target = named end
	if named ~= nil and bt ~= nil and named ~= bt then
		return false, string.format("his target %s and the task's var %s differ", tostring(bt), tostring(named)), { tid, "bt" }, true
	end
	local ok, why = bounty_target_ok(p, tonumber(target))
	return ok, why, { tid, "bt" }, true
end

-- Host: may the fact vars `vars` and the bounty target `bt` of a give of task `tid` with no offer of its giver be his machine's own
-- stock pick? -> ok (true / false; nil: no generator known here), why, judged (key -> "fetch" | "job": the part of the generation
-- that makes it; "bt" for the target), want (what host_make would make: { fetch, job }; no_bt: drop his target).
function own_pick(tid, vars, bt)
	vars = type(vars) == "table" and vars or {}
	local judged, want = {}, {}
	local okf, whyf, kf = fetch_pick(tid, vars)
	local okb, whyb, kb, job = bounty_pick(tid, vars, bt)
	for _, k in ipairs(kf) do judged[k] = "fetch" end -- the part of the generation that makes the key (want)
	for _, k in ipairs(kb) do judged[k] = "job" end
	if okf ~= true then want.fetch = true end
	if okb ~= true and job then want.job = true end
	if okb == false and not job then want.no_bt = true end -- a target named for a task that is no bounty: dropped
	-- a fetch or target key the task's generators do not make (no fetch_func, another var name): his word alone ("none": the host
	-- has nothing to make for it, "refuse" does not write it). A key the task's on_init writes itself
	-- (pstor_set can retain the price from a previous money task) is out of the judgement ("init": no line,
	-- written as his word, never as the host's fact; the on_init writes the host's own right after). The var of a fetch_func that is
	-- no generator known here is neither: that generator makes it (not judged, no knowledge).
	local fvar = r_str(tid, "fetch_func") and fetch_var_of(tid) or nil
	local inits = {}
	for k in tostring(r_str(tid, "on_init") or ""):gmatch("pstor_set%(%s*([^:%)%s]+)") do inits[k] = true end
	local whyn = nil
	for k in pairs(vars) do
		if judged[k] == nil and type(k) == "string" and k ~= tid and k ~= fvar and k ~= (fvar and fvar .. "_count")
			and (k:sub(-6) == "_fetch" or k:sub(-12) == "_fetch_count" or k:sub(-10) == "_target_id") then
			if inits[k] then
				judged[k] = "init"
			else
				judged[k] = "none"
				whyn = whyn or string.format("no generator of the task makes his %s", k)
			end
		end
	end
	if okf == false or okb == false or whyn then return false, whyf or whyb or whyn, judged, want end
	if okf == nil or okb == nil then return nil, whyf or whyb, judged, want end
	return true, nil, judged, want
end

-- Host: the task's own generation, run here as its dialog would: the fetch item (trigger_fetch_func) and / or on_job_descr (a
-- bounty target), with NPC `npc_id` of his talk (checked by the caller) or the giver (a squad gives through its commander) as the
-- speaker. Writes the host's pstor (its own facts) and the bounty table; the task's state sent to the players carries them back.
-- -> { vars = the task's vars now, bounty } or nil, why.
-- And the lines its dialog would have drawn (msgs: the bounty's target, captured as the offers capture them; fetch: the
-- "needs: X" line, which the player's machine draws in his language), for tell_made.
function host_make(tid, npc_id, giver, want)
	local npc = type(npc_id) == "number" and level.object_by_id(npc_id) or nil
	npc = npc or giver_npc(tonumber(giver))
	if not npc then return nil, "no NPC of the give is here to make it" end
	local msgs = {}
	local ok, err = with_talk(npc, function()
		if want and want.job then
			local on_jd = r_str(tid, "on_job_descr")
			local cond = on_jd and xr_logic.parse_condlist(db.actor, "task_manager", "condlist", on_jd)
			cap.on, cap.msgs = true, msgs
			local okc, errc = pcall(function()
				if cond then xr_logic.pick_section_from_condlist(db.actor, db.actor, cond) end
			end)
			cap.on, cap.msgs = false, nil
			if not okc then error(errc, 0) end
		end
		local a = atm()
		if want and want.fetch and r_str(tid, "fetch_func") and a and a.trigger_fetch_func then a.trigger_fetch_func(tid) end
	end)
	if not ok then return nil, tostring(err) end
	stats.made = stats.made + 1
	local a = atm()
	local b = a and a.bounties_by_id
	local vars = task_vars(tid)
	local fetch = nil
	if want and want.fetch and r_str(tid, "fetch_func") then
		local var = fetch_var_of(tid)
		if type(vars[var]) == "string" then fetch = { var = var, sec = vars[var], cnt = tonumber(vars[var .. "_count"]) or 1 } end
	end
	return { vars = vars, bounty = type(b) == "table" and tonumber(b[tid]) or nil, msgs = msgs, fetch = fetch }
end

-- In "refuse" the host made its own pick of task `tid` in place of what player `peer`'s dialog
-- said (coop_tasks host.give_own). His journal gets the host's vars with the task's state; this sends him the lines his dialog would
-- have drawn for it (made: host_make's answer), so the dialog and the journal agree. Event quests.made: i = task, m = the captured
-- talk lines, fv / fs / fc = the fetch var, its section and count.
function tell_made(peer, tid, made)
	if not (type(peer) == "number" and peer > 0 and peer <= coop_util.MAX_PEER and type(tid) == "string" and type(made) == "table") then return end
	local msg = { i = tid }
	local m = qc.ser(made.msgs or {})
	if m and #m <= 4000 then msg.m = m end
	local f = made.fetch
	if type(f) == "table" and type(f.var) == "string" and type(f.sec) == "string" then
		msg.fv, msg.fs, msg.fc = f.var, f.sec, tonumber(f.cnt) or 1
	end
	if not (msg.m or msg.fs) then return end
	qc.send("made", msg, peer)
end

-- Client: the host's own pick of a task he just took (tell_made): the lines, in the dialog when it is open, else as news.
local function client_on_made(t, from)
	-- only the deciding process (peer 0) sends it, and only to the player whose give it was (no question of the mode here)
	if from ~= 0 or not db.actor or type(t.i) ~= "string" or t.i == "" then return end
	local d = { msgs = {} }
	local m = type(t.m) == "string" and qc.des(t.m) or nil
	for i = 1, math.min(type(m) == "table" and #m or 0, MAX_MSGS) do
		local x = m[i]
		if type(x) == "table" then
			d.msgs[#d.msgs + 1] = { c = tostring(x.c or ""), t = tostring(x.t or ""), i = tostring(x.i or ""),
				p = type(x.p) == "string" and x.p ~= "" and x.p or "iconed_answer_item" }
		end
	end
	local fetch = nil
	if type(t.fv) == "string" and type(t.fs) == "string" and t.fs ~= "" then
		local cnt = tonumber(t.fc) or 1
		if not (cnt >= 1 and cnt <= 1000 and cnt == math.floor(cnt)) then cnt = 1 end
		fetch = { var = t.fv, sec = t.fs, cnt = cnt }
	end
	stats.made_in = stats.made_in + 1
	local okt, talking = pcall(function() return db.actor:is_talking() end)
	if okt and talking then
		show_lines(t.i, d, fetch)
		return
	end
	for _, x in ipairs(d.msgs) do pcall(db.actor.give_game_news, db.actor, x.c, x.t, x.i, 0, 5000) end
	if fetch then
		local okn, name = pcall(function() return ui_item.get_sec_name(fetch.sec) end)
		local text = (okn and type(name) == "string" and name or fetch.sec) .. " (x" .. tostring(fetch.cnt) .. ")"
		pcall(db.actor.give_game_news, db.actor, game.translate_string("ui_inv_needs") .. ":", text, "ui_inGame2_D_Sisshik", 0, 5000)
	end
end

-------------------------------------------------------------------------------
-- Status, start
-------------------------------------------------------------------------------
function print_status()
	local n = 0
	for _ in pairs(offers) do n = n + 1 end
	qc.log(TAG, "requests out %d in %d refused %d | offers in %d (%d empty over the far view) used %d, local lists %d, shown %d | %d NPC offers kept | after give %d, squads pinned %d, host on_job_descr %d | gives the host made itself %d, its picks shown here %d",
		stats.req_out, stats.req_in, stats.refused, stats.offers_in, stats.far_empty, stats.used, stats.local_gen, stats.shown, n,
		stats.after_give, stats.pinned, stats.rerun, stats.made, stats.made_in)
end

local installed = false
local function install()
	if installed then return end
	installed = true
	local ok, err = pcall(patch_client)
	if not ok then qc.report(TAG, "install client wrappers", err) end
	ok, err = pcall(patch_taskboard)
	if not ok then qc.report(TAG, "install taskboard", err) end
	ok, err = pcall(patch_task_limit)
	if not ok then qc.report(TAG, "install task limit", err) end
end

function on_game_start()
	if not qc.engine() then return end
	coop_mode.on_level_request(qc.EVENT_PREFIX .. "offer_req", on_offer_req, function(_, from)
		return type(from) == "number" and from > 0 and qc.active() and coop_mode.decides_world() and not coop_mode.from_level(from)
	end)
	qc.on("offer_t", client_on_offer_t, TAG)
	qc.on("offer", client_on_offer, TAG)
	qc.on("made", client_on_made, TAG) -- the host's own pick of a task he took (tell_made)
	RegisterScriptCallback("GUI_on_show", on_gui_show)
	-- after every script's on_game_start: these wrappers are the last link of any mod's chain
	RegisterScriptCallback("actor_on_first_update", install)
end
