--[[
	Anomaly Coop - NPC group: world things that assumed one player.
	Covered by C++ and not repeated here: anomaly field states and campfire flames (coop_objects ZoneState),
	anomaly damage to players (each owner computes its own, coop_objects), artefact movement (host physics,
	coop_objects), doors and buttons (a client's use goes to the host, coop_objects), explosions (host only).

	Mines (txr_mines):
	  - A client's "plant" goes to the host (npc.mine): the host creates the charge where the client stands
	    and arms it (proximity or timer). Stock plant_bomb on a client would fail (a client's alife create
	    returns no object) and leave the charge unarmed on the host.
	  - The request names the mine item (i). The host checks it is this player's: in his inventory, or on the ground at
	    his feet (Interaction Dot Marks plants a mine lying there), of the planted kind (coop_trust "mine_item"), removes
	    it itself and answers (npc.mine_ok): "took" = the host removed it, "left" = the client removes its own copy (a
	    check that failed in "log", a charge the host did not create), "no" = refused, the client keeps it. No answer in
	    15 s (the answer was lost): the client removes it itself.
	    Facts: Co-op - the host's ALife and his copy of the player's character; Server - the map server of the player's
	    level runs the handler (the world server passes it on) with the same facts of its level.
	  - Proximity charges trigger on the clients' proxies too (the stock check only sees db.actor, NPCs and
	    monsters). A client's charge blames that client: its blast hits NPCs "from" the client's proxy.
	  - A client's charge outlives his session (charges are saved with the game): the process that decides the world or
	    leads this map keeps its timer running and lets NPCs, monsters and players set it off with no client online too.
	  - On the host every charge goes off as its planter (coop.explode_as; the host's own stock charges as the
	    host's character), so the engine applies friendly fire to its blast. Without that engine
	    function the stock explode runs (the charge is its own initiator) and mine_blame re-blames NPC hits.
	Anomalies (bind_anomaly_field):
	  - Dynamic anomalies are not switched on next to ANY player (stock: next to the host only).
	  - Pulse anomalies (thunderbolts in bad weather) strike around every player, rolled by the host, and are
	    seen, heard and felt on every machine (npc.pulse); the psi/shock hit is applied by each machine to its
	    own player.
	  - An artefact a client picked up from an anomaly zone is forgotten by the zone on the host (the stock
	    hook is the host's own pickup), so the zone's reset after an emission does not delete it from the
	    client's inventory.
	Campfires (bind_campfire, owner domain on clients): a client lighting or putting out a fire asks the
	  host (npc.fire); the engine then shows the host's flame to everybody.
	Instruments: guitar / harmonica music is heard at the player's character on the other machines (npc.isnd).
	Silent kills (gameplay_silent_kills): the map authority judges stealth hits and records local and proxy kills
	  in the stock fresh-victim table. It alerts witnesses once, using visible players on that map.

	Events (ids in host numbering):
	  npc.mine   client -> host  { s = item section, m = mode, d = delay, x, y, z, lv, gv, i = mine item }
	  npc.mine_ok host -> client { i = mine item, r = "took" | "left" | "no" }
	  npc.pulse  host -> client  { x, y, z }
	  npc.fire   client -> host  { i = campfire object, on = bool }
	  npc.isnd   any -> all      { p = sound path, a = player's character }
	Stock functions wrapped: txr_mines.plant_bomb, trigger_mine; bind_anomaly_field.dyn_anomalies_update,
	pulse_anomaly_update; bind_campfire.campfire_go_on, campfire_go_off; itms_manager.use_guitar,
	use_harmonica. Callbacks: npc_on_before_hit, npc_on_update, monster_on_update, save_state, load_state.
--]]

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next

local TAG = "world"
local P -- coop_npc_players

local function log(fmt, ...) P.log(TAG, fmt, ...) end
local function report(what, err) P.report(TAG, what, err) end

local EV_MINE, EV_PULSE, EV_FIRE, EV_ISND = "npc.mine", "npc.pulse", "npc.fire", "npc.isnd"
local EV_MINE_OK = "npc.mine_ok"

local installed = false
-- This process decides the world or leads this map and holds clients' charges (actor_on_update, 4 Hz): they tick with or
-- without clients.
local mines_on = false
local orig = {}
local stats = { mines_out = 0, mines_in = 0, blasts = 0, blame = 0, pulses = 0, pulses_in = 0, fire_out = 0, fire_in = 0,
	music = 0, silent = 0, alerts = 0, artefacts = 0, as_planter = 0 }

local function vec(x, y, z) return vector():set(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0) end

-------------------------------------------------------------------------------
-- Mines
-------------------------------------------------------------------------------
local PLANTED = { mine_new = "mine_new_blow", ied_rpg_new = "rpg_new_blow", ied_new = "ied_new_blow" }
local FX = { mine_new = "mine", ied_rpg_new = "ied_rpg", ied_new = "ied" }
local MODE_PROX, MODE_TIMER = 0, 1
local TRIGGER_RADIUS_SQR = 2.5 * 2.5
local FUSE = 5

local mines = {} -- host: planted id -> { exp, mode, planter = proxy id, active }
-- The mine item a client asked to plant: client, waiting for the host's answer (waiting) and the items the host took whose
-- removal has not reached us yet (spent): neither is planted again (one item, one charge).
-- Host: the check's reach, and the container each player opened last (a mine taken from a box a moment ago is still in the
-- box on the host when the take comes after the plant).
local mine_item = { waiting = {}, spent = {}, ACK_MS = 15000, GROUND_REACH_SQR = 25,
	opened = {}, OPEN_MS = 10000, OPEN_REACH_SQR = 100, BOX_NEAR_SQR = 4 }

local function tss() return game.get_game_time():diffSec(level.get_start_time()) end

-- Host: sets off charge `id` as player character `by`. False when the engine has no coop.explode_as
-- yet or refuses (planter offline): the caller then runs the stock explode.
local function explode_as(id, by)
	local api = rawget(_G, "coop")
	local f = api and api.explode_as
	if type(f) ~= "function" or type(by) ~= "number" or not (coop_mode.decides_world() or coop_mode.leads_here()) then return false end
	if f(id, by) ~= true then return false end
	stats.as_planter = stats.as_planter + 1
	return true
end

local function client_plant(obj, mode, delay)
	local sec = obj:section()
	if not PLANTED[sec] then return orig.plant(obj, mode, delay) end
	local id = obj:id()
	-- an item already asked for (no answer yet, or taken by the host and not removed here yet), or gone: no second charge
	if mine_item.waiting[id] or mine_item.spent[id] or not level.object_by_id(id) then return end
	if FX[sec] and actor_effects then pcall(actor_effects.play_item_fx, FX[sec]) end
	local a = db.actor
	local pos = a:position()
	local sent = P.send(EV_MINE, { s = sec, m = tonumber(mode) or MODE_PROX, d = tonumber(delay) or FUSE,
		x = pos.x, y = pos.y, z = pos.z, lv = a:level_vertex_id(), gv = a:game_vertex_id(), i = P.to_host(id) }, 0)
	if sent then
		stats.mines_out = stats.mines_out + 1
		-- the host removes the item or tells us to; no answer (it was lost): we remove it
		mine_item.waiting[id] = time_global() + mine_item.ACK_MS
	end
end

-- Client: removes our copy of a mine item the host did not take.
local function client_drop_item(id)
	mine_item.waiting[id] = nil
	if level.object_by_id(id) then alife_release_id(id) end
end

local function client_on_mine_ok(t)
	local id = P.to_local(tonumber(t.i))
	if not (type(id) == "number" and mine_item.waiting[id]) then return end -- not ours, or answered already
	if t.r == "left" then
		client_drop_item(id)
	else
		mine_item.waiting[id] = nil -- "took": the host's removal reaches us; "no": refused, the item stays
		if t.r == "no" then
			log("! the host refused the mine of item %d: the item stays", id)
		else
			mine_item.spent[id] = time_global() + mine_item.ACK_MS -- not planted again before the host's removal arrives
		end
	end
end

local function client_mines_tick(now)
	for id, deadline in pairs(mine_item.waiting) do
		if now >= deadline then
			log("no answer to the mine of item %d in %d s: removed here (the answer was lost?)", id, mine_item.ACK_MS / 1000)
			client_drop_item(id)
		end
	end
	for id, deadline in pairs(mine_item.spent) do
		if now >= deadline then mine_item.spent[id] = nil end
	end
end

local function nick_of(peer)
	return coop_util.nick(peer) or "?"
end

-- Host: where object `id` is now: the online object's place (an item on the ground may have rolled since its entity was
-- written), else its server entity's.
local function place_of(id, se)
	local o = level.object_by_id(id)
	if o then return o:position() end
	se = se or alife_object(id)
	return se and se.position or nil
end

-- Host: a container (a box, a stash, a dead body) the mine may have come from a moment ago. A living holder (another
-- player, a trader) is none.
local function is_container(id)
	local o = level.object_by_id(id)
	if not o then return false end
	local box = rawget(_G, "IsInvbox")
	if type(box) == "function" and box(o) == true then return true end
	-- a dead body (alive() of something that is no creature writes a script error: asked of creatures only)
	local creature = false
	for _, name in ipairs({ "IsStalker", "IsMonster" }) do
		local f = rawget(_G, name)
		if type(f) == "function" and f(o) then creature = true end
	end
	if not creature then return false end
	local ok, alive = pcall(function() return o:alive() end)
	return ok and alive == false
end

-- Host: is container `id` (object o) a player's personal stash that is not
-- player `from`'s own (`me`: his character's id here)? A backpack stash (m_data.player_created_stashes), a Hideout Furniture stash
-- (placeable_type = stash), the box of a workbench (m_data.workshop_stashes: workbench -> box) or a fallen player's bag
-- (coop_death_stash, its owner's nick in its custom data). The owner of a backpack stash, of placed furniture and so of its
-- workbench box is booked when it is made (coop_mods_items, coop_mods_hf: m_data.coop_stash_owner, the character that made it):
-- his own is no other's. A backpack or furniture stash with no owner booked counts as another's; a workbench box with no
-- owner booked is an ordinary box. Another's stash is no container of the 2 m rule: a take
-- from it needs his own opening of it (the host's fact), as every honest take from a stash does. -> true, what it is (the line)
local function others_stash(id, o, from, me)
	local sec = o:section()
	local okm, md = pcall(function() return alife_storage_manager.get_state() end)
	md = okm and type(md) == "table" and md or {}
	local owners = type(md.coop_stash_owner) == "table" and md.coop_stash_owner or {}
	local function whose(key, what)
		local c = owners[key]
		if c ~= nil and c == me then return false end
		return true, c ~= nil and string.format("%s of character %s", what, tostring(c)) or what
	end
	local book = md.player_created_stashes
	if type(book) == "table" and book[id] ~= nil then return whose(id, "a player's backpack stash") end
	local okp, kind = pcall(function() return ini_sys:r_string_ex(sec, "placeable_type") end)
	if okp and kind == "stash" then return whose(id, "a Hideout Furniture stash") end
	local benches = md.workshop_stashes
	if type(benches) == "table" then
		for bench, box in pairs(benches) do
			if box == id then
				if owners[bench] == nil then return false end
				return whose(bench, "the box of a workbench")
			end
		end
	end
	if sec ~= "coop_death_stash" then return false end
	local okn, owner = pcall(function()
		local ini = o:spawn_ini()
		if ini and ini:section_exist(sec) and ini:line_exist(sec, "nick") then return ini:r_string(sec, "nick") end
	end)
	owner = okn and type(owner) == "string" and (owner:match('^"(.*)"$') or owner) or nil
	if owner ~= nil and owner ~= "" and owner == nick_of(from) then return false end
	return true, "a fallen player's bag of " .. tostring(owner or "?")
end

-- Host: is mine item `iid` this player's (in his inventory, or on the ground at his feet) and of section `sec`?
-- -> ok, what is wrong (for the log line)
local function mine_item_check(iid, sec, who, from)
	local se = iid and iid > 0 and iid < 65535 and iid == math.floor(iid) and alife_object(iid)
	if not se then return false, "no such item here" end
	local have = se:section_name()
	if have ~= sec then return false, string.format("the item is %s", tostring(have)) end
	local root, parent = iid, se.parent_id
	for _ = 1, 8 do
		if not parent or parent == 65535 then break end
		root = parent
		local p = alife_object(parent)
		parent = p and p.parent_id or nil
	end
	local at = who:position()
	if root == iid then -- on the ground (Interaction Dot Marks): at his feet
		local pos = place_of(iid, se)
		local d = pos and at:distance_to_sqr(pos)
		if d and d <= mine_item.GROUND_REACH_SQR then return true end
		return false, string.format("on the ground %.1f m from him", d and math.sqrt(d) or -1)
	end
	if root == who:id() then return true end
	-- taken from a container a moment ago, the take not here yet: a container within 2 m of him, or the one he opened in the
	-- last OPEN_MS within OPEN_REACH of him
	local pos = is_container(root) and place_of(root) or nil
	local d = pos and at:distance_to_sqr(pos)
	-- another player's personal stash only through his own opening of it
	local stash, what = false, nil
	if pos then stash, what = others_stash(root, level.object_by_id(root), from, who:id()) end
	if d and d <= mine_item.BOX_NEAR_SQR and not stash then return true end
	local o = mine_item.opened[from]
	if d and o and o.id == root and time_global() - o.at <= mine_item.OPEN_MS and d <= mine_item.OPEN_REACH_SQR then return true end
	return false, string.format("held by %d (%s%s), his character is %d", root,
		d and string.format("%.1f m from him", math.sqrt(d)) or "no container near him",
		stash and ("; " .. tostring(what) .. " he did not open") or "", who:id())
end

-- Host: the engine says player `peer` opened container `id` (a box or a dead body: coop_on_container_opened).
local function on_container_opened(peer, id)
	peer, id = tonumber(peer), tonumber(id)
	if peer and id and (coop_mode.decides_world() or coop_mode.leads_here()) then
		mine_item.opened[peer] = { id = id, at = time_global() }
	end
end

local function host_on_mine(t, from)
	local planted = type(t.s) == "string" and PLANTED[t.s]
	local who = P.object_of_peer(from)
	if not (planted and who) then return end
	local iid = tonumber(t.i)
	local item_ok, why = mine_item_check(iid, t.s, who, from)
	if not coop_trust.pass("mine_item", item_ok, "player %s (peer %d) planted %s with item %s: %s", nick_of(from), from, t.s,
		tostring(iid), tostring(why)) then
		if iid then P.send(EV_MINE_OK, { i = iid, r = "no" }, from) end
		return
	end
	local function answer(took)
		if iid then P.send(EV_MINE_OK, { i = iid, r = took and "took" or "left" }, from) end
	end
	local x, y, z = tonumber(t.x), tonumber(t.y), tonumber(t.z)
	if not (x and y and z) then return answer(false) end
	local pos = vec(x, y, z)
	if not (who:position():distance_to_sqr(pos) <= 25) then return answer(false) end -- planted where the player stands (NaN too)
	-- graph vertices of the planter's own character, never from the network (a bad lvid crashes the engine)
	local se = alife_create(planted, pos, who:level_vertex_id(), who:game_vertex_id())
	if not se then return answer(false) end
	local mode = (t.m == MODE_TIMER) and MODE_TIMER or MODE_PROX
	local delay = math.max(1, math.min(120, tonumber(t.d) or FUSE))
	mines[se.id] = { exp = tss() + delay * level.get_time_factor(), mode = mode, planter = who:id(), active = true }
	stats.mines_in = stats.mines_in + 1
	if item_ok then alife_release_id(iid) end -- his item, checked above: spent here, for everybody
	answer(item_ok)
end

local function blast(id)
	local m = mines[id]
	if not (m and m.active) then return end
	local obj = level.object_by_id(id)
	if obj then
		m.active = false
		stats.blasts = stats.blasts + 1
		if not explode_as(id, m.planter) then obj:explode(0) end
	end
end

local function near_mine(obj)
	if next(mines) == nil or not (obj and obj:alive()) then return end
	local now = tss()
	local pos = obj:position()
	for id, m in pairs(mines) do
		if m.active and m.mode == MODE_PROX and now >= m.exp then
			local mine = level.object_by_id(id)
			if mine and mine:position():distance_to_sqr(pos) <= TRIGGER_RADIUS_SQR then blast(id) end
		end
	end
end

local function host_mines_tick()
	-- Stock proximity charges: the proxies get no update callback of their own.
	local tm = _G["txr_mines"]
	if tm and tm.generic_on_update and type(tm._mines) == "table" and next(tm._mines) ~= nil then
		for _, p in ipairs(P.others()) do pcall(tm.generic_on_update, p) end
	end
	if next(mines) == nil then return end
	local now = tss()
	-- One pass of every player over every charge, at the first live proximity charge: a pass sets off every charge a
	-- player stands at, so a second one finds nothing more.
	local players_checked = false
	for id, m in pairs(mines) do
		if not alife_object(id) then
			mines[id] = nil
		elseif m.active then
			if m.mode == MODE_TIMER and now >= m.exp then
				blast(id)
			elseif m.mode == MODE_PROX and not players_checked then
				players_checked = true
				for _, p in ipairs(P.everyone()) do near_mine(p) end
			end
		end
	end
end

-- A client's charge hits as its planter (stock does the same for the host's charges with db.actor). Only for a charge
-- that went off by the stock explode: one set off by explode_as already names the planter.
local function mine_blame(npc, shit, bone_id, flags)
	local d = shit and shit.draftsman
	local m = d and mines[d:id()]
	if not m then return end
	local planter = level.object_by_id(m.planter)
	if not planter then return end
	local h = hit(shit)
	h.draftsman = planter
	npc:hit(h)
	flags.ret_value = false
	stats.blame = stats.blame + 1
end

-------------------------------------------------------------------------------
-- Anomalies
-------------------------------------------------------------------------------
local SAFE_DIST_SQR = 15 * 15 -- stock dyn_ano_safe_dist

local function dyn_update()
	if not P.host_on() then return orig.dyn() end
	local baf = bind_anomaly_field
	local lvl = level.name()
	local on_level = (baf.dyn_anomalies or {})[lvl]
	if on_level == nil then return true end
	for anomaly_id, state in pairs(on_level) do
		local obj = level.object_by_id(anomaly_id)
		local far = obj ~= nil and P.nearest_dist_sqr(obj:position()) > SAFE_DIST_SQR -- nobody stands in it
		if far then
			obj:enable_anomaly()
			if state == false then obj:disable_anomaly() end
			if baf.add_marker then baf.add_marker(lvl, obj:section(), anomaly_id, state) end
		end
	end
	return true
end

-- Stock pulse tuning (bind_anomaly_field file locals).
local PA = { snd_distance = 150, snd_delay = 5.5, p_hit = 10, e_hit = 20, hit_delay = 11.5, article = 50, max = 150,
	delay = 2 * 60 * 1000 }
local PA_CHANCE = { clear = 0, partly = 0, cloudy = 10, rain = 15, storm = 25, foggy = 0 }
local PA_MAPS = {
	k00_marsh = 0.5, k01_darkscape = 1, k02_trucks_cemetery = 1, l01_escape = 0.2, l02_garbage = 0.7,
	l03_agroprom = 0.5, l04_darkvalley = 0.5, l06_rostok = 1, l07_military = 0.5, l08_yantar = 0.7,
	l09_deadcity = 0.5, l10_red_forest = 1, jupiter = 1, pripyat = 1, zaton = 1, l13_generators = 1.5,
	l12_stancia_2 = 1.5, l12_stancia = 1.5, l11_pripyat = 0.2, l10_radar = 1, y04_pole = 0.7,
}
local pa = { light = nil, pfx = nil, close = nil, far = nil, seq = 0, next_at = {} }

local function pa_assets()
	if not pa.pfx then pa.pfx = particles_object("generator\\generator_accum_thunderbolt") end
	if not pa.close then pa.close = sound_object("anomaly\\emi_blowout") end
	if not pa.far then pa.far = sound_object("anomaly\\emi_blowout_01") end
	if not pa.light then
		pa.light = coop_world_fx.pulse_light()
	end
end

local function pa_sound(pos)
	if not db.actor then return true end
	local snd = distance_2d(db.actor:position(), pos) > PA.snd_distance and pa.far or pa.close
	if snd then
		if snd:playing() then snd:stop() end
		snd:play_at_pos(db.actor, pos)
		snd.volume = 1
	end
	pa.light:set_position(pos)
	pa.light.enabled = true
	pa.light:update()
	return true
end

local function pa_hit_one(kind, dist, range, ppe, ppe_id)
	local power = math.cos(dist * math.pi / range) + 1
	local h = hit()
	h.type = kind
	local immune = level_environment.is_actor_immune()
		or (kind == hit.telepatic and dialogs_yantar and dialogs_yantar.actor_has_psi_helmet())
	h.power = immune and 0 or surge_manager.SurgeManager:hit_power(power, h.type)
	h.impulse = 0
	h.direction = VEC_Z
	h.draftsman = db.actor
	db.actor:hit(h)
	level.remove_pp_effector(ppe_id)
	level.add_pp_effector(ppe, ppe_id, false)
	level.set_pp_effector_factor(ppe_id, h.power)
end

local function pa_hit(pos)
	coop_world_fx.pulse_light_step(pa.light, true)
	if not db.actor or GetEvent("current_safe_cover") then return true end
	local dist = distance_2d(db.actor:position(), pos)
	if dist < PA.article then SendScriptCallback("actor_on_interaction", "anomalies", nil, "pulse") end
	if dist < PA.p_hit then pa_hit_one(hit.telepatic, dist, PA.p_hit, "psi_fade.ppe", 666) end
	if dist < PA.e_hit then pa_hit_one(hit.shock, dist, PA.e_hit, "electro_fade.ppe", 667) end
	return true
end

local function pa_dim()
	coop_world_fx.pulse_light_step(pa.light, false)
	pa.light.enabled = false
	return true
end

local function do_pulse(pos)
	pa_assets()
	pa.pfx:play_at_pos(pos)
	pa.seq = pa.seq + 1
	local s = tostring(pa.seq)
	CreateTimeEvent("coop_npc_pulse", "snd" .. s, PA.snd_delay, pa_sound, pos)
	CreateTimeEvent("coop_npc_pulse", "hit" .. s, PA.hit_delay, pa_hit, pos)
	CreateTimeEvent("coop_npc_pulse", "lgt" .. s, PA.hit_delay + 0.5, pa_dim)
end

-- The host rolls a strike around every player (stock: around db.actor), each on its own timer.
local function pulse_update()
	if not (P.active() and (coop_mode.decides_world() or coop_mode.leads_here())) then return orig.pulse() end
	if pa.light and pa.light.enabled then pa.light:update() end
	if bLevelUnderground then return end
	local tg = time_global()
	local lvl_factor = PA_MAPS[level.name()] or 0
	local wm = level_weathers.get_weather_manager()
	local chance = PA_CHANCE[wm and wm:get_curr_weather() or ""] or 1
	for _, p in ipairs(P.everyone()) do
		local id = p:id()
		local at = pa.next_at[id]
		if not at then
			pa.next_at[id] = tg + PA.delay
		elseif tg >= at then
			pa.next_at[id] = tg + PA.delay
			if math.random(100) <= chance * lvl_factor then
				local pos = p:position()
				local ang = math.rad(math.random(0, 359))
				local d = math.random(0, PA.max)
				local at_pos = vector():set(pos.x + math.cos(ang) * d, pos.y + 60, pos.z + math.sin(ang) * d)
				do_pulse(at_pos)
				P.send(EV_PULSE, { x = at_pos.x, y = at_pos.y, z = at_pos.z }, -1)
				stats.pulses = stats.pulses + 1
			end
		end
	end
end

-- A client's pickup of a zone artefact happens on its proxy here: the zone must forget it, or its next
-- turn_off (after an emission) releases the artefact out of that player's inventory.
local function artefact_sweep()
	local baz = _G["bind_anomaly_zone"]
	local t = baz and baz.parent_zones_by_artefact_id
	if type(t) ~= "table" then return end
	for id, zone in pairs(t) do
		local obj = level.object_by_id(id)
		local parent = obj and obj:parent()
		if parent and P.is_proxy(parent) and zone and zone.on_artefact_take then
			local ok, err = pcall(zone.on_artefact_take, zone, obj)
			if ok then stats.artefacts = stats.artefacts + 1 else report("artefact take", err) end
		end
	end
end

local function client_on_pulse(t)
	if not db.actor then return end
	stats.pulses_in = stats.pulses_in + 1
	do_pulse(vec(t.x, t.y, t.z))
end

-------------------------------------------------------------------------------
-- Campfires
-------------------------------------------------------------------------------
local function campfire_id(cf)
	local bc = bind_campfire
	for id, binder in pairs(bc.campfires_all or {}) do
		if binder and rawequal(binder.campfire, cf) then return id end
	end
	-- Fallback: the nearest campfire object within reach.
	local obj = bc.get_nearby_campfire and bc.get_nearby_campfire(2.5, false)
	return obj and obj:id() or nil
end

local function wrap_campfire(name, on)
	local bc = _G["bind_campfire"]
	local f = bc and bc[name]
	if type(f) ~= "function" or orig[name] then return end
	orig[name] = f
	bc[name] = function(a, b)
		if not P.client_live() then return f(a, b) end
		-- go_on(obj, cf) / go_off(cf): the stock code runs (effects, message, matches use); its turn_on is
		-- refused here by the engine, so the host is asked. rain_pass decides whether lighting worked.
		local cf = on and b or a
		cf = cf or bc.get_nearby_campfire(2, true)
		local passed = not on
		local rp = bc.rain_pass
		if on and type(rp) == "function" then
			bc.rain_pass = function(...)
				local r = rp(...)
				passed = r and true or false
				return r
			end
		end
		local ok, err = pcall(f, a, b)
		if on and type(rp) == "function" then bc.rain_pass = rp end
		if not ok then report(name, err) end
		if cf and passed then
			local id = campfire_id(cf)
			if id and P.send(EV_FIRE, { i = P.to_host(id), on = on }, 0) then stats.fire_out = stats.fire_out + 1 end
		end
	end
end

local function host_on_fire(t, from)
	if type(t.i) ~= "number" then return end
	local who = P.object_of_peer(from)
	local bc = _G["bind_campfire"]
	local binder = bc and bc.campfires_all and bc.campfires_all[t.i]
	if not (who and binder and binder.campfire and binder.object) then return end
	if binder.object:position():distance_to_sqr(who:position()) > 16 then return end -- 4 m
	stats.fire_in = stats.fire_in + 1
	local cf = binder.campfire
	if t.on == true and not cf:is_on() then
		cf:turn_on()
	elseif t.on == false and cf:is_on() then
		cf:turn_off()
	end
end

-------------------------------------------------------------------------------
-- Instruments
-------------------------------------------------------------------------------
local function play_instrument(kind, count)
	-- Original itms_manager.use_guitar/use_harmonica supply sound paths and the owner's local effect.
	-- RayLink adds spatial playback at the corresponding player on other machines.
	local track = math.random(count)
	local path = "music\\" .. kind .. "_" .. tostring(track)
	local snd = sound_object(path)
	if not snd then return end
	local period = snd:length()
	local api = rawget(_G, "coop")
	local native = false
	if P.active() and api and type(api.instrument) == "function" then
		local ok, accepted = pcall(api.instrument, kind == "guitar" and 1 or 2, 2, track, math.floor(period))
		native = ok and accepted == true
	end
	if not native then snd:play_no_feedback(db.actor, 0, 0, db.actor:position(), 1.0, 1.0) end
	actor_effects.play_continuous_effect(period)
	if not native and P.active() and P.send(EV_ISND, { p = path, a = P.to_host(0) }, -1) then stats.music = stats.music + 1 end
end

local function on_isnd(t)
	if type(t.p) ~= "string" or not t.p:match("^music\\[%w_]+$") or type(t.a) ~= "number" then return end
	local who = level.object_by_id(P.to_local(t.a))
	if not who or who:id() == 0 then return end
	local snd = sound_object(t.p)
	if snd then snd:play_at_pos(who, who:position(), 0, sound_object.s3d) end
end

-------------------------------------------------------------------------------
-- Silent kills (one stock victim table for both the authority's player and proxies)
-------------------------------------------------------------------------------
local fresh_victims

local function silent_witness(id)
	if not P.is_player_id(id) then return level.object_by_id(id) end
end

local function silent_anybody_see(obj)
	local target = obj or db.actor
	for _, id in ipairs(db.OnlineStalkers) do
		local npc = silent_witness(id)
		if npc and IsStalker(npc, npc:clsid()) and npc:alive() and npc:see(target) then return npc end
	end
	return false
end

local function silent_closest_npc_dist(obj, victim)
	local subject = obj or db.actor
	local pos = subject:position()
	local subject_id, victim_id = subject:id(), victim:id()
	local closest = 99999999999 -- stock distance when there is no witness
	for _, id in ipairs(db.OnlineStalkers) do
		if id ~= subject_id and id ~= victim_id then
			local npc = silent_witness(id)
			if npc and IsStalker(npc) and npc:alive() then
				closest = math.min(closest, npc:position():distance_to(pos))
			end
		end
	end
	return closest
end

local function silent_kill(npc, shit, bone_id, flags)
	if not (fresh_victims and P.active() and coop_mode.leads_here()) then return end
	local sk = gameplay_silent_kills
	if not sk.feature_enabled() then return end
	if not (sk.melee_enabled() or sk.gun_enabled()) then return end
	local who = shit and shit.draftsman
	if not (who and shit.power ~= 0 and P.is_proxy(who) and coop_mode.where(P.peer_of(who)) == "here") then return end
	local victims = fresh_victims()
	if not victims or victims[npc:id()] then return end
	local weapon = who:active_item()
	if not weapon then return end
	local be = npc:best_enemy()
	if be and be:id() == who:id() then return end
	if sk.anybody_see(who) or sk.anybody_see(npc) then return end
	local to_player = sk.closest_npc_dist(who, npc)
	local to_victim = sk.closest_npc_dist(npc, who)
	local function kill()
		local h = hit(shit)
		h.draftsman = weapon
		h.power = 100
		npc:hit(h)
		victims[npc:id()] = sk.tss() + sk.get_fresh_time()
		flags.ret_value = false
		stats.silent = stats.silent + 1
		local compat = _G["coop_npc_compat"]
		if compat and compat.credit_silent_kill then pcall(compat.credit_silent_kill, who) end
	end
	if sk.melee_enabled() and sk.valid_backstab_weapon(weapon) and shit.type == hit.wound
		and to_player > sk.backstab_hear_range() and to_victim > sk.backstab_hear_range() then
		return kill()
	end
	if sk.headshot_only() and bone_id ~= 15 then return end
	if sk.gun_enabled() and shit.type == hit.fire_wound and sk.valid_silent_weapon(weapon)
		and to_player > sk.silent_weapon_hear_range(weapon) and to_victim > sk.silent_weapon_hear_range(weapon) then
		return kill()
	end
end

local function corpse_alert(sk, npc, victims)
	if not (npc and npc:alive() and sk.feature_enabled()) then return end
	local now = sk.tss()
	local suspect = sk.get_suspect_dist()
	for id, expires in pairs(victims) do
		local dead = level.object_by_id(id)
		if not dead or now >= expires then
			victims[id] = nil
		elseif npc:see(dead) and not sk.are_enemies(npc, dead) then
			for _, p in ipairs(P.everyone()) do
				if coop_mode.where(P.peer_of(p)) == "here" and npc:see(p)
					and p:position():distance_to(dead:position()) < suspect then
					local h = hit()
					h.type = hit.fire_wound
					h.power = 0
					h.impulse = 0
					h.direction = VEC_Y
					h.draftsman = p
					victims[id] = nil
					npc:hit(h)
					stats.alerts = stats.alerts + 1
					break
				end
			end
		end
	end
end

local function install_silent_kills()
	local C = coop_mods_core
	local sk = C.mod("gameplay_silent_kills")
	if not sk then return end
	local _, holder, index = C.find_local(sk, "M")
	if not holder then return end
	fresh_victims = function()
		local _, state = debug.getupvalue(holder, index) -- stock replaces M when it loads a save
		return state and state.victims
	end
	-- The stock host hit and the proxy hit use the same witness queries.
	local function session_witness_query(query)
		return function(original)
			return function(...)
				if P.active() then return query(...) end
				return original(...)
			end
		end
	end
	C.wrap(sk, "anybody_see", "silent_kills.anybody_see", session_witness_query(silent_anybody_see))
	C.wrap(sk, "closest_npc_dist", "silent_kills.closest_npc_dist", session_witness_query(silent_closest_npc_dist))
	local function wrap_callback(name, make)
		local wrapped, original = C.wrap(sk, name, "silent_kills." .. name, make)
		if not wrapped then return end
		coop_route.inherit_source(sk[name], original)
		C.swap_callback(name, original, sk[name])
	end
	wrap_callback("npc_on_before_hit", function(original)
		return function(...)
			if not P.active() or (coop_mode.leads_here() and coop_mode.actor_is_player()) then
				return original(...)
			end
		end
	end)
	wrap_callback("npc_on_update", function(original)
		return function(npc, ...)
			if not P.active() then return original(npc, ...) end
			local victims = fresh_victims()
			if not victims or next(victims) == nil or not coop_mode.leads_here() then return end
			local ok, err = pcall(corpse_alert, sk, npc, victims)
			if not ok then report("corpse alert", err) end
		end
	end)
end

-------------------------------------------------------------------------------
-- Install, callbacks, events
-------------------------------------------------------------------------------
local function install()
	local tm = _G["txr_mines"]
	if tm and type(tm.plant_bomb) == "function" then
		orig.plant = tm.plant_bomb
		tm.plant_bomb = function(obj, mode, delay)
			if P.client_live() then return client_plant(obj, mode, delay) end
			return orig.plant(obj, mode, delay)
		end
	end
	if tm and type(tm.trigger_mine) == "function" then
		-- the host's own charge goes off as the host's character (friendly fire covers it)
		orig.trigger = tm.trigger_mine
		tm.trigger_mine = function(id)
			if not explode_as(id, db.actor and db.actor:id()) then return orig.trigger(id) end
			local d = type(tm._mines) == "table" and tm._mines[id]
			if d then d.active = false end
		end
	end
	local baf = _G["bind_anomaly_field"]
	if baf and type(baf.dyn_anomalies_update) == "function" then
		orig.dyn = baf.dyn_anomalies_update
		baf.dyn_anomalies_update = dyn_update
	end
	if baf and type(baf.pulse_anomaly_update) == "function" then
		orig.pulse = baf.pulse_anomaly_update
		baf.pulse_anomaly_update = pulse_update
	end
	wrap_campfire("campfire_go_on", true)
	wrap_campfire("campfire_go_off", false)
	local im = _G["itms_manager"]
	if im then
		for name, spec in pairs({ use_guitar = { "guitar", 28 }, use_harmonica = { "harmonica", 5 } }) do
			if type(im[name]) == "function" and not orig[name] then
				orig[name] = im[name]
				im[name] = function(obj)
					if not P.active() then return orig[name](obj) end
					return play_instrument(spec[1], spec[2])
				end
			end
		end
	end
end

local function guard(what, f)
	return function(...)
		if not P.host_on() then return end
		local ok, err = pcall(f, ...)
		if not ok then report(what, err) end
	end
end

-- npc_on_update / monster_on_update, per creature per frame: a creature at a client's charge sets it off.
local function creature_on_update(obj)
	if not mines_on then return end
	local ok, err = pcall(near_mine, obj)
	if not ok then report("creature at a charge", err) end
end

local next_tick, next_sweep = 0, 0

local function actor_on_update()
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + 250
	if next(mine_item.waiting) ~= nil or next(mine_item.spent) ~= nil then
		local ok, err = pcall(client_mines_tick, now)
		if not ok then report("mine answers", err) end
	end
	local host_on = installed and P.host_on()
	mines_on = installed and next(mines) ~= nil and (coop_mode.decides_world() or coop_mode.leads_here())
	-- host_mines_tick also feeds stock charges the clients' proxies: that part needs clients, the clients' charges do not
	if host_on or mines_on then
		local ok, err = pcall(host_mines_tick)
		if not ok then report("mines", err) end
	end
	if host_on and now >= next_sweep then
		next_sweep = now + 2000
		local ok, err = pcall(artefact_sweep)
		if not ok then report("artefact sweep", err) end
	end
end

local function save_state(m_data)
	if next(mines) == nil then
		m_data.coop_npc_mines = nil
		return
	end
	local t = {}
	for id, m in pairs(mines) do
		if m.active then t[id] = { exp = m.exp, mode = m.mode, planter = m.planter } end
	end
	m_data.coop_npc_mines = t
end

local function load_state(m_data)
	mines = {}
	if type(m_data.coop_npc_mines) == "table" then
		for id, m in pairs(m_data.coop_npc_mines) do
			if type(id) == "number" and type(m) == "table" then
				mines[id] = { exp = tonumber(m.exp) or 0, mode = m.mode == MODE_TIMER and MODE_TIMER or MODE_PROX,
					planter = tonumber(m.planter) or 0, active = true }
			end
		end
	end
end

function print_status()
	local n = 0
	for _ in pairs(mines) do n = n + 1 end
	log("installed %s | mines out %d in %d armed %d blasts %d (as the planter %d) blamed %d | pulses %d in %d | campfire out %d in %d | music %d | silent kills %d alerts %d | zone artefacts released to players %d | errors %d",
		tostring(installed), stats.mines_out, stats.mines_in, n, stats.blasts, stats.as_planter, stats.blame, stats.pulses, stats.pulses_in,
		stats.fire_out, stats.fire_in, stats.music, stats.silent, stats.alerts, stats.artefacts, P.error_count(TAG))
end

function on_game_start()
	coop_util.add_status("coop_npc_world", 180)
	P = coop_npc_players
	if not rawget(_G, "coop") then return end
	if not installed then
		local ok, err = pcall(install)
		if not ok then report("install", err) end
		ok, err = pcall(install_silent_kills)
		if not ok then report("install silent kills", err) end
		installed = true
	end
	P.on(EV_MINE, host_on_mine, "host", TAG)
	P.on(EV_MINE_OK, client_on_mine_ok, "client", TAG)
	P.on(EV_FIRE, host_on_fire, "host", TAG)
	P.on(EV_PULSE, client_on_pulse, "client", TAG)
	P.on(EV_ISND, on_isnd, nil, TAG)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("npc_on_before_hit", guard("mine blame", mine_blame))
	RegisterScriptCallback("npc_on_before_hit", function(...)
		local ok, err = pcall(silent_kill, ...)
		if not ok then report("silent kill", err) end
	end)
	RegisterScriptCallback("npc_on_update", creature_on_update)
	RegisterScriptCallback("monster_on_update", creature_on_update)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	RegisterScriptCallback("coop_on_container_opened", guard("container opened", on_container_opened)) -- coop_main names it
end

function _mines() return mines end
function _stats() return stats end
