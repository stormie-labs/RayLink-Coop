--[[
	Anomaly Coop - "Co-op" page of the options menu (W4 menu), gamedata\scripts\coop_menu_options.script
	Installed by modxml_coop_menu.on_xml_read (dxml start-up), before ui_options builds its tree.

	Player group (every player sets their own; coop_settings.ltx: coop/coop_player/* = player):
		nickname (console coop_nick), port for hosting ([options] coop/coop_player/host_port, read by coop_menu),
		names above players and their distance (coop_nametags, coop_nametags_dist),
		party panel / player markers / chat feed on the HUD (W5: applied to coop_core_hud / coop_core_chat),
		HUD v2 (docs\HUD_V2.md): compass bar on/off and its field of view 120 / 160 / 200 (coop_hud_compass), a line
		that says where the ping key is (the key itself: Controls > Common, "Co-op: ping", modxml_coop_hud).
	Session rules group (the host's values are used; coop_settings.ltx: coop/coop_session/* = host):
		friendly fire, shared task rewards, bleed-out time, health after revive;
		W5: the economy group's rules (coop_economy_core.RULES, read through coop_settings.rule("economy/<id>");
		defaults here must match RULES). F3 task 17: the "clients may quicksave" rule is gone, nobody saves by hand
		in a session (coop_saves).
		F3 task 15: the host's death rules (docs\CHECKPOINTS_DEATH.md section 9), each one is the console variable of the
		engine of the same name (coop_<id>; coop_survival.cpp, coop_death.cpp, coop_checkpoints.cpp, coop_autosave.cpp):
		death mode (checkpoint | hardcore), what falls (drop | corpse | lose), respawn delay 0..300 s, contusion 0..60 min,
		money / gear wear / rank cut in %, the starting kit of a new hardcore character (Ruling F3-10, off), camps shown to
		the group, the emergency saves of the host (interval in min, how many are kept). Their strings: st_coop_death.xml.
		On a connected client the options window refuses edits of these and shows the lock note
		(coop_settings: option lock), the values shown there are the player's own for when he hosts.
	Console variables are saved by the engine in user.ltx (cfg_save on Apply), not in axr_options.ltx.
--]]

local installed = false

-- Check box bound to an integer console variable (coop_friendly_fire, coop_share_rewards, coop_nametags*: all
-- CCC_Integer 0..1). R5 I1: without bool_to_num the stock ui_options.On_Accept sends "on"/"off", which CCC_Integer
-- reads as 0, so the box could never switch the variable on.
local function check(id, cmd)
	return { id = id, type = "check", val = 1, cmd = cmd, bool_to_num = true }
end

-- Stored in axr_options.ltx (no console variable): coop/coop_<group>/<id>.
local function flag(id, def)
	return { id = id, type = "check", val = 1, def = def }
end

local function track(id, def, min, max, step)
	return { id = id, type = "track", val = 2, def = def, min = min, max = max, step = step }
end

-- Track bound to a numeric console variable of the host (CCC_Float or CCC_Integer): the stock window reads it as a string
-- (get_console_cmd(0)) and sends "<cmd> <value>", so both kinds work. The bounds are the engine's (the test checks them).
local function cvar_track(id, cmd, min, max, step)
	return { id = id, type = "track", val = 2, cmd = cmd, min = min, max = max, step = step }
end

-- List bound to a token console variable: val 0 reads the token name, `content` = { token, string id } in display order.
local function cvar_list(id, cmd, content)
	return { id = id, type = "list", val = 0, cmd = cmd, no_str = true, content = content }
end

local function slide(id, link)
	return { id = "slide_" .. id, type = "slide", link = link, text = "ui_mm_menu_" .. id, size = { 512, 50 } }
end

function build_page()
	return {
		id = "coop", gr = {
			{ id = "coop_player", sh = true, gr = {
				slide("coop_player", "ui_options_slider_player"),
				{ id = "nick", type = "input", val = 0, cmd = "coop_nick" },
				{ id = "host_port", type = "input", val = 2, min = 1, max = 65535, def = 27960 },
				check("nametags", "coop_nametags"),
				check("nametags_dist", "coop_nametags_dist"),
				flag("party_hud", true),
				flag("player_spots", true),
				flag("chat_feed", true),
				-- HUD v2 (docs\HUD_V2.md): the compass bar, its field of view, where the ping key is
				flag("compass_hud", true),
				{ id = "compass_fov", type = "list", val = 0, def = "160", no_str = true,
					content = {
						{ "120", "st_coop_hud_fov_120" },
						{ "160", "st_coop_hud_fov_160" },
						{ "200", "st_coop_hud_fov_200" },
					} },
				{ id = "ping_note", type = "desc", text = "st_coop_hud_ping_note", clr = { 255, 200, 200, 200 } },
			}, },
			{ id = "coop_session", sh = true, gr = {
				slide("coop_session", "ui_options_slider_other"),
				{ id = "note", type = "desc", text = "st_coop_opt_session_note", clr = { 255, 200, 200, 200 } },
				check("friendly_fire", "coop_friendly_fire"),
				check("share_rewards", "coop_share_rewards"),
				-- F3 task 15: the host's death rules. The old respawn / respawn_keep are synonyms of checkpoint in the
				-- engine (an old user.ltx still loads), they are not offered any more.
				cvar_list("death_mode", "coop_death_mode", {
					{ "checkpoint", "st_coop_opt_death_checkpoint" },
					{ "hardcore", "st_coop_opt_death_hardcore" },
				}),
				cvar_list("death_drop", "coop_death_drop", {
					{ "drop", "st_coop_opt_drop_drop" },
					{ "corpse", "st_coop_opt_drop_corpse" },
					{ "lose", "st_coop_opt_drop_lose" },
				}),
				{ id = "bleedout", type = "track", val = 2, cmd = "coop_bleedout", min = 10, max = 600, step = 10 },
				{ id = "revive_health", type = "track", val = 2, cmd = "coop_revive_health", min = 0.05, max = 1,
					step = 0.05, prec = 2 },
				cvar_track("respawn_delay", "coop_respawn_delay", 0, 300, 5),
				cvar_track("contusion", "coop_contusion", 0, 60, 1),
				cvar_track("death_money", "coop_death_money", 0, 100, 5),
				cvar_track("death_wear", "coop_death_wear", 0, 100, 5),
				cvar_track("death_rank", "coop_death_rank", 0, 100, 5),
				check("hardcore_new_kit", "coop_hardcore_new_kit"),
				check("checkpoints_group", "coop_checkpoints_group"),
				cvar_track("autosave_interval", "coop_autosave_interval", 0, 120, 5),
				cvar_track("autosave_count", "coop_autosave_count", 1, 50, 1),
				-- economy group (coop_settings.rule("economy/<id>"))
				flag("party_fast_travel", true),
				track("gather_radius", 20, 5, 100, 5),
				{ id = "sleep_rule", type = "list", val = 0, def = "vote", no_str = true,
					content = {
						{ "vote", "st_coop_opt_sleep_vote" },
						{ "safe_or_vote", "st_coop_opt_sleep_safe_or_vote" },
						{ "gather", "st_coop_opt_sleep_gather" },
						{ "host", "st_coop_opt_sleep_host" },
					} },
				track("sleep_radius", 6, 2, 30, 1),
				track("vote_timeout", 30, 10, 120, 5),
				track("teleport_radius", 50, 0, 200, 10),
				flag("travel_time", true),
				track("max_skip_hours", 48, 1, 168, 1),
				flag("money_transfer", true),
				{ id = "max_money_transfer", type = "input", val = 2, def = 1000000, min = 0, max = 100000000 },
				track("give_radius", 5, 1, 20, 1),
			}, },
		},
	}
end

local function has_page(list)
	for i = 1, #list do
		if type(list[i]) == "table" and list[i].id == "coop" then return true end
	end
	return false
end

-- Appends the page whenever ui_options (re)builds its tree. Append, never insert: init_opt_coder addresses stock
-- subtrees by index. Idempotent per Lua state.
function install()
	if installed then return end
	local uo = ui_options
	if not (uo and type(uo.init_opt_base) == "function") then return end
	installed = true
	local base = uo.init_opt_base
	uo.init_opt_base = function(...)
		base(...)
		if type(uo.options) == "table" and not has_page(uo.options) then
			table.insert(uo.options, build_page())
		end
	end
	-- Tree already built by someone before us: add the page now.
	if type(uo.options) == "table" and #uo.options > 0 and not has_page(uo.options) then
		table.insert(uo.options, build_page())
	end
end

-------------------------------------------------------------------------------
-- Player group toggles -> core HUD / chat (W5). Read straight from axr_options (player-owned paths); absent = on.
-------------------------------------------------------------------------------
local function player_flag(id)
	local am = rawget(_G, "axr_main")
	local cfg = am and am.config
	if not cfg then return true end
	local ok, v = pcall(function() return cfg:r_value("options", "coop/coop_player/" .. id, 1) end)
	if ok and v == false then return false end
	return true
end

local function player_value(id, def)
	local am = rawget(_G, "axr_main")
	local cfg = am and am.config
	if not cfg then return def end
	local ok, v = pcall(function() return cfg:r_value("options", "coop/coop_player/" .. id, 0, def) end)
	if ok and v ~= nil then return v end
	return def
end

function apply_player_flags()
	local hud = rawget(_G, "coop_core_hud")
	if hud and hud.set_party_enabled then pcall(hud.set_party_enabled, player_flag("party_hud")) end
	if hud and hud.set_spots_enabled then pcall(hud.set_spots_enabled, player_flag("player_spots")) end
	local compass = rawget(_G, "coop_hud_compass")
	if compass and compass.set_enabled then pcall(compass.set_enabled, player_flag("compass_hud")) end
	if compass and compass.set_fov then pcall(compass.set_fov, player_value("compass_fov", "160")) end
	local chat = rawget(_G, "coop_core_chat")
	if chat and chat.set_feed_enabled then pcall(chat.set_feed_enabled, player_flag("chat_feed")) end
end

local function on_option_change() apply_player_flags() end
local function actor_on_first_update() apply_player_flags() end

function on_game_start()
	if not rawget(_G, "coop") then return end
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
