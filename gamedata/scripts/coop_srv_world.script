-- Server (srv): the world keeps the emission schedule and the map servers apply its effects.
-- One phase for the world (docs/SPLIT_LEVELS.md 7b). Each map server judges its own players.
local api = rawget(_G, "coop")

-- The stock excludes its source and the hospital on top of valid_levels.
local NO_EMISSION = { l13_generators = true, l11_hospital = true }
local function level_open(name)
	local lw = rawget(_G, "level_weathers") or level_weathers
	return name ~= nil and lw ~= nil and lw.valid_levels ~= nil and lw.valid_levels[name] == true and not NO_EMISSION[name]
end

local function reaches_here()
	return level_open(level.name())
end

local function open_level_of_a_player()
	local l = api.levels
	if not (l and l.level_of_player and l.level_name) then return end
	for _, p in ipairs(coop_util.players()) do
		local id = not p.is_self and l.level_of_player(p.id)
		local name = id and l.level_name(id)
		if name and level_open(name) then return name end
	end
end

local function publish_phase(phase)
	-- Players use their own cover for the mirror. Map servers get shelter for their ghost.
	phase.own = true
	local player_phase = coop_main.encode(phase)
	for _, p in ipairs(coop_util.players()) do
		if not p.is_self then api.send_event("coop_env", player_phase, p.id) end
	end
	phase.own = nil
	local l = api.levels
	if l and l.map_servers then
		local map_phase = coop_main.encode(phase)
		for _, ms in ipairs(l.map_servers()) do
			api.send_event("coop_env", map_phase, ms.bridge)
		end
	end
end

local function relay_report(name, report, peer)
	local l = api.levels
	local bridge = l and l.bridge_of_player and l.bridge_of_player(peer)
	local valid = type(bridge) == "number" and bridge > 0
	if not coop_trust.guard("env_report_map", valid, "peer %d has no map server", peer) then return end
	report.peer = peer -- transport sender, as received by the world server
	api.send_event(name, coop_main.encode(report), bridge)
end

local function report_peer(from, report)
	local peer = tonumber(report.peer)
	local trusted = from == 0 and peer ~= nil
	if coop_trust.guard("env_map_relay", trusted, "invalid relay from peer %s", tostring(from)) then return peer end
end

local function outdoor_forecast(select_weather, wm, ...)
	-- The service level has no outdoor weather type. Run the stock forecast with
	-- the type shared by outdoor maps, including the stock pre-blowout preset roll.
	local weather_type = wm.weatherType
	wm.weatherType = "atmosfear"
	local ok, err = pcall(select_weather, wm, ...)
	wm.weatherType = weather_type
	if not ok then error(err, 0) end
end

local function install_weather()
	local sync = rawget(_G, "coop_world_weather") or coop_world_weather
	if not sync then return end
	if coop_mode.decides_world() then
		sync.set_weather_policy({
			choose = outdoor_forecast,
			prepare = function(wm)
				if wm.weatherType and not (wm.levelWeather or ""):find("^atmosfear") then wm:select_weather(false) end
			end,
		})
		return
	end
	local policy = { accepts = function(wm) return wm.weatherType == "atmosfear" end }
	if coop_mode.leads_here() then
		local last_manager, last_file
		policy.draw = function(wm, force)
			if weather and weather.is_paused and weather.is_paused() then return end
			if force or wm ~= last_manager or wm.weather_file ~= last_file then
				-- Replacing the base sky during a weather effect must preserve the effect.
				local playing = level.is_wfx_playing and level.is_wfx_playing()
				level.set_weather(wm.weather_file, not playing and (force or wm ~= last_manager))
				last_manager, last_file = wm, wm.weather_file
			end
		end
	end
	sync.set_weather_policy(policy)
end

function on_game_start()
	if not api then return end
	coop_mode.when_srv(function()
		install_weather()
		local policy = { reaches_here = reaches_here }
		if coop_mode.decides_world() then
			policy.publish = publish_phase
			policy.relay_report = relay_report

			-- The stock start consults the current map. On the service level, borrow an occupied
			-- open map for that call, then advance the schedule without running its map effects.
			local function schedule_around(cls, duration, finish)
				local start, update = cls.start, cls.update
				if start then
					cls.start = function(self, ...)
						local name = open_level_of_a_player()
						if not name then return start(self, ...) end
						printf("[srv-world] emission schedule: %s is open", name)
						local original_name = level.name
						level.name = function() return name end
						local result = { pcall(start, self, ...) }
						level.name = original_name
						if not result[1] then printf("[srv-world] emission schedule failed: %s", tostring(result[2])) end
						return unpack(result, 2)
					end
				end
				if update then
					cls.update = function(self, ...)
						if self.started ~= true or reaches_here() then return update(self, ...) end
						local ok, sec = pcall(function() return game.get_game_time():diffSec(self.inited_time) / level.get_time_factor() end)
						if ok and sec >= (self[duration] or 0) then self[finish](self) end
					end
				end
			end

			local sm = rawget(_G, "surge_manager") or surge_manager
			local pm = rawget(_G, "psi_storm_manager") or psi_storm_manager
			if sm and sm.CSurgeManager then schedule_around(sm.CSurgeManager, "surge_time", "end_surge") end
			if pm and pm.CPsiStormManager then schedule_around(pm.CPsiStormManager, "psi_storm_duration", "finish") end
		elseif coop_mode.leads_here() then
			policy.report_peer = report_peer
		end
		coop_env.set_policy(policy)
	end)
end
