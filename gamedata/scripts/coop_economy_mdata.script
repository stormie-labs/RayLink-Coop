--[[
	Anomaly Coop - script data that must follow items and players (gamedata\scripts\coop_economy_mdata.script)

	Clients load the host's save, so all Lua data (alife_storage_manager m_data) is right at join. After that
	four kinds of it would drift; each has its own channel here. Everything is a no-op outside a session.

	1. se_object store (se_save_var / se_load_var, m_data.se_object[id]): per-entity script vars such as an
	   item's parts condition ("parts"), a strapped weapon, a patched outfit ("unpatched"), a looted mutant
	   ("looted"), NPC PDA info. A change on any machine goes to the host; the host checks the sender may
	   write it (the item is in his inventory, or the var is a world flag players set), stores it and sends
	   it to everybody else. Host changes go to all clients. Companion / death-drop / release flags are the
	   host's (refused from clients). "pathpoint*" (companion walking) is not sent.
	   A client creates a weapon clone under a leased id. The host creates its copy when it answers the request,
	   possibly after its budget queue. The host holds writes for that id for HOLD_MS and checks them once the item
	   exists, so the host, its save and other players receive the state of the clone. GAMMA's alife_clone_weapon
	   copies the source id's table directly and calls se_save_var only for "parts"; after_clone sends the other
	   vars too. Item riders are held the same way.
	   Each value carries the sender's instance of the item (its stamp _coop_instance, or its name). The world
	   server and map server can stamp the same repair independently, and a co-op repair can target one client.
	   item_alias accepts a matching item under another stamp or its bare name (same_item), for parts, every se var
	   and item riders. An unstamped holder's jam and camo can reach a differently stamped authority. A value for
	   another item under the same id waits or is refused.
	2. Item riders (m_data[key][item_id]) of addons that keep per-item state in their own m_data table
	   (Powered Exos, 3DSS marks, Meat Spoiling, GAMMA pouches ...): the machine that holds the item polls its
	   inventory and sends changed entries; the host stores and relays them. Addons declare keys with
	   coop_economy_mdata.declare_item_key(key, { apply = function(id, value) end }).
	3. Per-player m_data of stock scripts (sleepiness, thirst, psy health of arszi_psy, disguise, detector,
	   radio frequency, items at a mechanic: MANIFEST): a client never saves, and its world comes from the host's save, where these
	   keys hold the HOST's values. The client sends its own values to the host every 15 s when they changed;
	   the host keeps them in its m_data under coop_peer_mdata[<character id>] in the host save.
	   When a client loads the host's world, its own values replace the host's in m_data right after the
	   save is read (alife_storage_manager.on_before_load_state), before any load_state callback (first
	   visit: the keys are cleared, the scripts start from their defaults). Third-party mod keys (skills, XP,
	   perks ...) are carried by coop_mods_pdata (mods group); a key it owns is skipped here.
	   coop_economy_mdata.register_player_key(key, provider): provider() returns the current value on a
	   client (default: the live m_data entry).
	   When the engine signals a load continuing this world (coop_on_world_leaving),
	   a client keeps every key as it is then in the session stash for that load ("@load:<epoch>|..."); the load of that
	   world reads it instead of the host's record (up to 15 s older), and the next look tells the host.
	4. World m_data keys that only the host writes but clients read (player-made stashes of addons ...):
	   polled on the host, sent to clients on change. coop_economy_mdata.register_world_key(key).
	   A client keeps the item values of 1 and 2 that it sends in the last CARRY_MS or has yet to send before a
	   load continuing this world. The session stash holds them with the keys of 3. The world server drops
	   writes between the player's trip request and the SessionReset of its rejoin. The co-op host drops writes
	   from a mover after its go. Once the client is live in the next world, carry_release reapplies and resends
	   a kept value that the save lacks.

	Events (values are coop_economy_core.pack strings):
		economy.se   any -> host -> others   { n, i1, v1, d1, ... }   id (host numbering), var, value; the world server passes
		                                                              what it relays on to every map server but the sender
		economy.imd  any -> host -> others   { n, i1, k1, d1, ... }   id, m_data key, value
		economy.pmd  client -> host          { k, d }                 per-player key, value (nil = cleared)
		economy.wmd  host -> clients         { k, d }                 world key, value
	A script that checks received se and imd batches first registers coop_economy_mdata.admit(f) (see admit below).
--]]

local core = coop_economy_core

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next

local FLUSH_MS = 300
local ITEM_POLL_MS = 1000
local PLAYER_POLL_MS = 15000
local WORLD_POLL_MS = 2000
local MAX_VALUE = 12000 -- bytes of one packed value
local MAX_BATCH = 12000 -- bytes of one batch payload (the engine limit is 16 KiB)
local PENDING_MS = 30000 -- a change for an entity that does not exist here yet waits this long
local HOLD_MS = 60000 -- host: a client's change of an item the host has not made yet (a leased create) waits this long
local HOLD_MAX = 512 -- host: at most this many held changes (the oldest go first)
local PEER_STORE = "coop_peer_mdata"
local CARRY_MS = 5000 -- client: a recently sent item value may not reach the world before the client's load
local CARRY_MAX = 512 -- client: at most this many item values carried through one load
local CARRY_BYTES = 128 * 1024 -- and this many bytes of them (a stash value holds 256 KiB)

local installed = false
local applying = false -- writing data that came from the network: do not send it again
local orig_save_var = nil

local pmd_next_poll = 0 -- time of the next look at the per-player keys
local stats = {
	se_out = 0, se_in = 0, se_refused = 0, se_pending = 0, se_held = 0,
	imd_out = 0, imd_in = 0, imd_refused = 0, imd_held = 0, clones = 0,
	pmd_out = 0, pmd_in = 0, pmd_applied = 0,
	wmd_out = 0, wmd_in = 0, errors = 0, oversize = 0,
	parts_alias = 0, parts_refused = 0, parts_parked = 0, -- parts under another stamp of the same item or of another item
	se_alias = 0, imd_alias = 0, clone_alias = 0, -- se vars, riders and clone sources accepted under another stamp or bare name
}

local function storage_state(asm) return asm.get_state() end

local function m_data()
	local ok, m = pcall(storage_state, rawget(_G, "alife_storage_manager"))
	return ok and type(m) == "table" and m or nil
end

local clone_busy, clone_transactions, clone_retired = {}, {}, {}
local clone_storage = nil

local function item_instance(id)
	if core.avatar_peer(id) ~= nil then return "player/" .. tostring(core.host_id(id)) end
	local m = m_data()
	local se = m and m.se_object and m.se_object[id]
	if se and se._coop_instance then return se._coop_instance end
	local object = alife_object(id)
	return object and object:name() or ""
end

local function clone_is_retired(id)
	local retired = clone_retired[id]
	if not retired then return false end
	local object = alife_object(id)
	if object and object:name() ~= retired.name then
		clone_retired[id] = nil
		return false
	end
	return true
end

-- An SE value's weapon stamp is "<name>/<host id>/<nonce>" (replacement::token in engine/src/xrCoop/coop_replacement.h).
-- An unstamped item's instance is its name. write_clone_initial stamps the item's own name on a spawn.
-- prepare_local_clone / host_replace -> clone_stage stamps a clone target with the source's name, so item_alias
-- cannot accept a different clone stamp as an alias for the target itself.
local function named_by(instance)
	local name, hid = instance:match("^(.+)/(%d+)/%d+$")
	if name then return name, tonumber(hid) end
	return instance, nil
end

-- Do instances `a` and `b` of item `hid` (host numbering) name the same
-- item? Equal, or the same name where every stamp among them carries the item's host id: another process's stamp of this item,
-- or its bare name (a copy no process stamped). The processes stamp a weapon each its own way when each of them writes its
-- EntitySpawn first (write_clone_initial -> clone_export): in the server mode a player's repair is answered by the world server
-- and by the map server of his level, each with a new stamp; in the co-op the host stamps its copy on any spawn it writes (a
-- repair to one client: the host and that client hold the stamp, the holder may hold none). The stamp only tells two objects
-- under one id apart; another name, or a stamp of another host id, names another item. Pure: reads nothing.
-- coop_mods_item_state takes its riders by this rule too.
function same_item(a, b, hid)
	if type(a) ~= "string" or type(b) ~= "string" or a == "" or b == "" then return false end
	if a == b then return true end
	local name_a, hid_a = named_by(a)
	local name_b, hid_b = named_by(b)
	return name_a == name_b and (hid_a == nil or hid_a == hid) and (hid_b == nil or hid_b == hid)
end

-- A value (a weapon's parts, any se var, an item rider) sent under another stamp of the item this process holds under
-- `lid`, or under its bare name: the instance names this item here (its object's name, and same_item with this process's own
-- instance of it). A value for another item (another name, another host id) is still refused or waits; every other check of
-- the value (holder, clone_busy / clone_retired, the item riders' id-reuse ticks) still applies after this one.
local function item_alias(lid, hid, instance)
	if type(instance) ~= "string" or instance == "" then return false end
	local object = alife_object(lid)
	if not object then return false end
	return named_by(instance) == object:name() and same_item(instance, item_instance(lid), hid)
end

-- Log parts received under another stamp, at most PARTS_SAY_MAX lines a minute.
local PARTS_SAY_MAX = 30
local parts_said = { n = 0, quiet = 0, until_ms = 0 }
local function say_parts(fmt, ...)
	local t = core.now()
	if t >= parts_said.until_ms then
		if parts_said.quiet > 0 then core.log("parts: %d more lines of the last minute not written", parts_said.quiet) end
		parts_said.n, parts_said.quiet, parts_said.until_ms = 0, 0, t + 60000
	end
	if parts_said.n >= PARTS_SAY_MAX then
		parts_said.quiet = parts_said.quiet + 1
		return
	end
	parts_said.n = parts_said.n + 1
	core.log(fmt, ...)
end

-- se vars the world server does not send its map servers (filled from SE_HOST_ONLY below): NPC state that the authority of each
-- level keeps itself, as before.
local se_not_to_bridges = {}
local se_targets = {} -- optional directed delivery for a variable, supplied by the authority that selects its recipient

function set_se_target(var, target_of)
	se_targets[var] = target_of
end

-- Sends `entries` ({ {id, key, packed}, ... }) as batches of `name`.
-- bridges (world server, split levels): the map servers to send them to as well; `skip`: vars they do not get.
local function send_batches(name, entries, target, except, bridges, skip)
	local batch, size, n = {}, 0, 0
	local function flush()
		if n == 0 then return end
		batch.n = n
		if bridges then
			for _, b in ipairs(bridges) do
				if b ~= except then core.send(name, batch, b) end
			end
		elseif core.owns_world() then
			core.send_clients(name, batch, except)
		else
			core.send(name, batch, target or 0)
		end
		batch, size, n = {}, 0, 0
	end
	for _, e in ipairs(entries) do
		local instance = e[4] or item_instance(core.local_id(e[1]))
		local len = #e[3] + #tostring(e[2]) + #instance + 24
		if len > MAX_VALUE then
			if not bridges then
				stats.oversize = stats.oversize + 1
				core.log("! %s %s/%s not sent: %d bytes", name, tostring(e[1]), tostring(e[2]), len)
			end
		elseif not (skip and skip[e[2]]) then
			if size + len > MAX_BATCH then flush() end
			n = n + 1
			batch["i" .. n], batch["k" .. n], batch["d" .. n] = e[1], e[2], e[3]
			batch["x" .. n] = instance
			size = size + len
		end
	end
	flush()
end

-- The world server relays a player's or map server's se vars to every map server except the sender. A map server
-- acts on the vars of the bodies, boxes and characters of its level (WPO strips a weapon by its "parts").
-- An item can change levels with its carrier, so each map server needs its current vars for the entities it loads
-- from the world save. The world server's own writes go to players unless a variable has directed delivery.
-- Item riders (imd) do not go this way.
local function relay_to_bridges(entries, except, local_write)
	if not local_write then
		local list = core.bridges()
		if #list > 0 then send_batches("se", entries, nil, except, list, se_not_to_bridges) end
	end
	local directed = {}
	for _, entry in ipairs(entries) do
		local target_of = se_targets[entry[2]]
		local target = target_of and target_of(entry[1])
		if target and target ~= except then
			local batch = directed[target] or {}
			batch[#batch + 1] = entry
			directed[target] = batch
		end
	end
	for target, batch in pairs(directed) do send_batches("se", batch, nil, nil, { target }) end
end

-- Admission of received batches: f(kind, t, from) runs on every "se" and "imd" batch (decoded, before this file reads it) and
-- may take entries out of it (t["k"..i] = nil); a function it returns runs once this file has stored the batch.
local admitters = {}

function admit(f)
	if type(f) ~= "function" then return end
	for _, g in ipairs(admitters) do
		if g == f then return end
	end
	admitters[#admitters + 1] = f
end

-- The handler of batch event `kind`: the admitters, `receive`, then what the admitters asked to run after it.
local function admitted(kind, receive)
	return function(t, from)
		local after = nil
		for _, f in ipairs(admitters) do
			local then_run = f(kind, t, from)
			if type(then_run) == "function" then
				after = after or {}
				after[#after + 1] = then_run
			end
		end
		receive(t, from)
		if after then
			for _, f in ipairs(after) do f() end
		end
	end
end

local function read_batch(t)
	local out = {}
	local n = core.int(t.n, 0, 2000) or 0
	for i = 1, n do
		local id = core.int(t["i" .. i], 0, 65534)
		local key = type(t["k" .. i]) == "string" and #t["k" .. i] <= 64 and t["k" .. i] or nil
		local d = t["d" .. i]
		if id and key and type(d) == "string" and #d <= MAX_VALUE then
			local v, err = core.unpack(d)
			if err == nil or d == "_" then out[#out + 1] = { id = id, key = key, value = v, packed = d, instance = t["x" .. i] } end
		end
	end
	return out
end

-------------------------------------------------------------------------------
-- 1. se_object store
-------------------------------------------------------------------------------
-- Never accepted from a client (NPC state the host's world logic owns).
local SE_HOST_ONLY = {
	_coop_instance = true,
	companion = true, companion_cannot_dismiss = true, companion_cannot_teleport = true, death_dropped = true,
	dont_release = true, do_not_deactivate = true, healing_charge = true,
}
for k in pairs(SE_HOST_ONLY) do se_not_to_bridges[k] = true end
-- Accepted from a client on any entity (flags a player sets on world objects he deals with).
local SE_WORLD_VARS = {
	looted = true, info = true, unpatched = true, strapped_item = true,
	last_seen_level = true, last_seen_time = true,
}

local se_out = {} -- "id\0var" -> { id (host numbering), var, packed }
local se_sig = {} -- "id\0var" -> packed value last sent / received
local se_recent = {} -- client, "id\0var" -> { id (host numbering), var, packed, instance, at = sent }: a load may come before it reached
local se_wait = {} -- changes for entities not here yet: { id (local), var, value, packed, until_ms }
local se_parts_wait = {} -- latest parts for an instance whose item has not arrived
local se_next_flush = 0
-- Local writes made while the host's world is being read: "id\0var" -> { id (local), var, value }.
-- They go out with the first live frame. A new Lua state starts with none.
local se_early = {}
local se_early_n = 0
local SE_EARLY_MAX = 512
local se_heard

-- A player's machine keeps recently sent values in case a load starts before they reach the world.
-- A map server never loads another world of this session: its process ends with its world.
local function carries() return core.follows_world() and coop_mode.is_player_mirror() end

local function not_sent(var)
	return type(var) ~= "string" or var == "_coop_instance" or var:sub(1, 9) == "pathpoint"
end

-- A host with no other players has nobody to tell. A client always has a host: the world server's seat plays
-- no character and has no row in coop.players(), even though it needs the client's parts, riders and player data.
local function nobody_to_tell()
	return not core.follows_world() and core.others_count() == 0
end

local function parts_held_by(id, holder)
	if holder == nil then return false end
	local item = alife_object(id)
	if item and item.parent_id == holder then return true end
	local root = core.root_of(id)
	if root == holder then return true end
	-- The chain can end just before registration of the carrier. The item's
	-- server-side parent still identifies that carrier during the handoff.
	local top = root and alife_object(root)
	return top ~= nil and top.parent_id == holder
end

-- queues entity `id`'s var for the next flush unless the others have this value already
local function se_queue(id, varname, val)
	if applying or type(id) ~= "number" or not_sent(varname) then return end
	if not core.live() then
		if not core.follows_world() then return end
		local key = tostring(id) .. "\0" .. varname
		if se_early[key] == nil then
			if se_early_n >= SE_EARLY_MAX then return end
			se_early_n = se_early_n + 1
		end
		se_early[key] = { id, varname, val }
		return
	end
	if nobody_to_tell() and not se_targets[varname] then return end
	if clone_busy[id] then return end
	local packed = core.pack(val)
	local hid = core.host_id(id)
	local key = tostring(hid) .. "\0" .. varname
	if se_sig[key] == packed then return end
	se_sig[key] = packed
	se_out[key] = { hid, varname, packed, item_instance(id) }
end

local function se_wrapper(id, name, varname, val, ...)
	-- GAMMA's server_object_on_register cleanup clears parts for every new entity.
	-- A replacement already has the source's parts before that callback. They belong
	-- to this transaction, not a previous object which happened to reuse the id.
	-- Only protect the pending target; normal creations and source cleanup stay unchanged.
	if varname == "parts" and val == nil and clone_transactions[id] then
		local m = m_data()
		if m and m.se_object and m.se_object[id] and m.se_object[id].parts ~= nil then return end
	end
	if varname == "parts" and not applying and core.follows_world() and coop_mode.is_player_mirror() then
		local actor = db and db.actor
		if not actor or not parts_held_by(id, actor:id()) then
			-- Registration and clone cleanup can clear storage of an entity
			-- that is already gone. That clear is local bookkeeping.
			if val == nil and not alife_object(id) then return orig_save_var(id, name, varname, val, ...) end
			return
		end
	end
	orig_save_var(id, name, varname, val, ...)
	se_queue(id, varname, val)
	if varname == "parts" and not applying and core.live() then se_heard(id, varname) end
end

-- Release writes queued during the world read once the session is live.
local function se_early_release()
	if se_early_n == 0 then return end
	local early = se_early
	se_early, se_early_n = {}, 0
	for _, e in pairs(early) do se_queue(e[1], e[2], e[3]) end
end

local function se_flush()
	se_early_release()
	if next(se_out) == nil then return end
	local entries = {}
	for _, e in pairs(se_out) do entries[#entries + 1] = e end
	se_out = {}
	table.sort(entries, function(a, b) return a[1] < b[1] or (a[1] == b[1] and a[2] < b[2]) end)
	stats.se_out = stats.se_out + #entries
	send_batches("se", entries, 0)
	if next(se_targets) then relay_to_bridges(entries, nil, true) end
	if carries() then
		local t = core.now()
		for key, e in pairs(se_recent) do
			if t - e.at > CARRY_MS then se_recent[key] = nil end
		end
		for _, e in ipairs(entries) do
			se_recent[tostring(e[1]) .. "\0" .. e[2]] = { e[1], e[2], e[3], e[4], at = t }
		end
	end
end

-- Writes a value that came from the network. False when the entity does not exist here (yet).
local function se_store(local_id, var, value)
	local m = m_data()
	if not (m and type(m.se_object) == "table") then return false end
	if m.se_object[local_id] == nil and value ~= nil and not alife_object(local_id) then return false end
	applying = true
	local ok, err = pcall(orig_save_var, local_id, nil, var, value)
	applying = false
	if not ok then
		stats.errors = stats.errors + 1
		core.log("! se var %s/%s: %s", tostring(local_id), var, tostring(err))
	end
	return true
end

-- Notify subscribers after an SE value is installed. Parts also notify for
-- local edits and initial metadata so all paths refresh the same item cell.
local se_listeners = {}
function on_se_value(f)
	if type(f) ~= "function" then return end
	for _, g in ipairs(se_listeners) do if g == f then return end end
	se_listeners[#se_listeners + 1] = f
end

se_heard = function(id, var)
	for _, f in ipairs(se_listeners) do
		local ok, err = pcall(f, id, var)
		if not ok then
			stats.errors = stats.errors + 1
			core.log("! se listener %s/%s: %s", tostring(id), tostring(var), tostring(err))
		end
	end
end

-- A requested item field uses the normal SE receiver and its instance check. fill: an answer to that player's ask, stored
-- only where his machine has no value (it may hold a newer one of its own already: the same table reached it on the
-- lane and he edited his own item since).
function send_se(peer, id, var, value, fill)
	local packed = core.pack(value)
	if #packed > MAX_VALUE then return false end
	return core.send("se", { n = 1, i1 = core.host_id(id), k1 = var, d1 = packed, x1 = item_instance(id), f = fill and 1 or nil }, peer)
end

-- f(...) with its SE writes kept on this machine. Propagate the result or error.
function quietly(f, ...)
	local was = applying
	applying = true
	local r = { pcall(f, ...) }
	applying = was
	if not r[1] then error(r[2], 0) end
	return unpack(r, 2, table.maxn(r))
end

-- Install a value through the same SE receiver without sending it on.
function apply_se(id, var, value)
	if type(id) ~= "number" or not_sent(var) then return false end
	se_sig[tostring(core.host_id(id)) .. "\0" .. var] = core.pack(value)
	se_recent[tostring(core.host_id(id)) .. "\0" .. var] = nil -- the authority's word is newer than what this machine sent
	if not se_store(id, var, value) then return false end
	se_heard(id, var)
	return true
end

local function client_may_write(from, hid, var)
	if clone_busy[hid] or clone_is_retired(hid) then return false end
	if SE_HOST_ONLY[var] then return false end
	if SE_WORLD_VARS[var] then return alife_object(hid) ~= nil end
	local p = core.player(from)
	if var == "parts" then return p ~= nil and parts_held_by(hid, p.avatar_id) end
	return p ~= nil and p.avatar_id ~= nil and core.root_of(hid) == p.avatar_id
end

-- Host: hold a client's changes for items it creates under a leased id until the host processes the request.
-- Entries are { from, e = entry, until_ms }, oldest first.
local se_hold = {}
local imd_hold = {}

local function hold(list, from, e)
	if #list >= HOLD_MAX then table.remove(list, 1) end
	list[#list + 1] = { from = from, e = e, until_ms = core.now() + HOLD_MS }
end

-- a client's change waits on the host while its item is not in the host's world (yet)
local function host_holds(host, from, id)
	return host and from > 0 and from < 0x100 and alife_object(id) == nil
end

local function on_se(t, from)
	local host = core.owns_world()
	if host and from <= 0 then return end
	if not host and from ~= 0 then return end
	if clone_storage ~= m_data() then clone_reset() end
	local relay = {}
	for _, e in ipairs(read_batch(t)) do
		local lid = host and e.id or core.local_id(e.id)
		local mismatch = alife_object(lid) and e.instance and e.instance ~= item_instance(lid)
		local m = m_data()
		local stamped = m and m.se_object and m.se_object[lid] and m.se_object[lid]._coop_instance
		-- item_alias accepts another stamp or the bare name for the same weapon's se vars, including parts, jam and camo.
		-- Holder and clone checks still apply.
		local alias = mismatch and item_alias(lid, e.id, e.instance)
		if alias then mismatch = false end
		if clone_is_retired(lid) or clone_busy[lid] then
			stats.se_refused = stats.se_refused + 1
		elseif e.key == "parts" and mismatch and not stamped and (not host or from >= 0x100) then
			-- An existing mirror can receive parts before it learns the
			-- matching initial stamp. Never apply them under the old stamp.
			-- A stamp of the same item passes item_alias and needs no wait.
			se_parts_wait[lid] = e
			stats.se_pending = stats.se_pending + 1
			stats.parts_parked = stats.parts_parked + 1
			say_parts("parts of %s [%s] from %s wait: sent for %s, another item than this one", tostring(e.id),
				tostring(item_instance(lid)), tostring(from), tostring(e.instance))
			if host then relay[#relay + 1] = { e.id, e.key, e.packed, e.instance } end
		elseif mismatch or (stamped and not e.instance) then
			stats.se_refused = stats.se_refused + 1
			if e.key == "parts" then
				stats.parts_refused = stats.parts_refused + 1
				say_parts("parts of %s [%s] from %s refused: sent for %s, another item than this one", tostring(e.id),
					tostring(item_instance(lid)), tostring(from), tostring(e.instance))
			end
		elseif not_sent(e.key) then
			-- ignore
		elseif t.f == 1 and not host and m and m.se_object and m.se_object[lid]
			and m.se_object[lid][e.key] ~= nil and not (type(m.se_object[lid][e.key]) == "table" and next(m.se_object[lid][e.key]) == nil) then
			-- an answer to an ask of this machine (send_se fill) that the lane beat: this machine's value stays
		elseif host_holds(host, from, e.id) then
			stats.se_held = stats.se_held + 1
			hold(se_hold, from, e)
		elseif host and from < 0x100 and not client_may_write(from, e.id, e.key) then -- 0x100 up: a map server, an authority of its level
			stats.se_refused = stats.se_refused + 1
		else
			local lid = host and e.id or core.local_id(e.id)
			se_sig[tostring(e.id) .. "\0" .. e.key] = e.packed
			se_recent[tostring(e.id) .. "\0" .. e.key] = nil -- a newer word than what this machine sent
			stats.se_in = stats.se_in + 1
			if not se_store(lid, e.key, e.value) then
				stats.se_pending = stats.se_pending + 1
				if e.key == "parts" then
					se_parts_wait[lid] = e
				else
					se_wait[#se_wait + 1] = { lid, e.key, e.value, instance = e.instance, until_ms = core.now() + PENDING_MS }
				end
			else
				if e.key == "parts" then se_parts_wait[lid] = nil end
				if alias and e.key == "parts" then
					stats.parts_alias = stats.parts_alias + 1
					say_parts("parts of %s [%s] from %s taken under another stamp of the same item (sent %s)", tostring(e.id),
						tostring(item_instance(lid)), tostring(from), tostring(e.instance))
				elseif alias then
					stats.se_alias = stats.se_alias + 1
					say_parts("se var %s of %s [%s] from %s taken under another stamp of the same item (sent %s)", e.key,
						tostring(e.id), tostring(item_instance(lid)), tostring(from), tostring(e.instance))
				end
				se_heard(lid, e.key)
			end
			if host then relay[#relay + 1] = { e.id, e.key, e.packed, e.instance } end
		end
	end
	if host and #relay > 0 then
		send_batches("se", relay, nil, from)
		relay_to_bridges(relay, from)
	end
end

-- Host: held changes whose item exists here are checked like a fresh one, stored and sent to the others.
local function se_release_held()
	if #se_hold == 0 then return end
	local keep, relay, t = {}, {}, core.now()
	for _, h in ipairs(se_hold) do
		local e = h.e
		if alife_object(e.id) ~= nil then
			if client_may_write(h.from, e.id, e.key)
				and (not e.instance or e.instance == item_instance(e.id) or item_alias(e.id, e.id, e.instance)) then
				se_sig[tostring(e.id) .. "\0" .. e.key] = e.packed
				stats.se_in = stats.se_in + 1
				if se_store(e.id, e.key, e.value) then se_heard(e.id, e.key) end
				relay[h.from] = relay[h.from] or {}
				local r = relay[h.from]
				r[#r + 1] = { e.id, e.key, e.packed, e.instance }
			else
				stats.se_refused = stats.se_refused + 1
			end
		elseif t < h.until_ms then
			keep[#keep + 1] = h
		else
			stats.se_refused = stats.se_refused + 1
		end
	end
	se_hold = keep
	for from, r in pairs(relay) do
		send_batches("se", r, nil, from)
		relay_to_bridges(r, from)
	end
end

local function se_retry()
	if core.owns_world() then se_release_held() end
	local m = next(se_parts_wait) and m_data()
	for id, e in pairs(se_parts_wait) do
		if not clone_busy[id] and alife_object(id) then
			local stamp = item_instance(id)
			local se = m and m.se_object and m.se_object[id]
			-- item_alias accepts the parts under another stamp of the same item.
			local same = stamp == e.instance or item_alias(id, e.id, e.instance)
			if clone_is_retired(id) or (se and se._coop_instance and not same) then
				se_parts_wait[id] = nil
			elseif same and se_store(id, "parts", e.value) then
				se_parts_wait[id] = nil
				se_sig[tostring(e.id) .. "\0parts"] = e.packed
				se_heard(id, "parts")
			end
		end
	end
	if #se_wait == 0 then return end
	local keep, t = {}, core.now()
	for _, w in ipairs(se_wait) do
		if not clone_busy[w[1]] and not clone_is_retired(w[1]) and (not alife_object(w[1]) or not w.instance
			or w.instance == item_instance(w[1]) or item_alias(w[1], core.host_id(w[1]), w.instance)) then
			if se_store(w[1], w[2], w[3]) then
				se_heard(w[1], w[2])
			elseif t < w.until_ms then
				keep[#keep + 1] = w
			end
		end
	end
	se_wait = keep
end

-------------------------------------------------------------------------------
-- 2. Item riders: m_data[key][item_id]
-------------------------------------------------------------------------------
local item_keys = {} -- { {key, apply}, ... }
local item_base = {} -- item id (local) -> { key -> packed }
local item_retry = {} -- restored source riders must be sent even before the first inventory poll
local imd_recent = {} -- client, "id\0key" -> { id (host numbering), key, packed, instance, at = sent } (se_recent)
local item_seeded = false
local item_next_poll = 0

function declare_item_key(key, opts)
	if type(key) ~= "string" then return end
	for _, d in ipairs(item_keys) do
		if d.key == key then
			if opts and opts.apply then d.apply = opts.apply end
			return
		end
	end
	item_keys[#item_keys + 1] = { key = key, apply = opts and opts.apply }
end

local function item_decl(key)
	for _, d in ipairs(item_keys) do
		if d.key == key then return d end
	end
end

local function item_apply(d, id, value)
	local applied, why = pcall(d.apply, id, value)
	if not applied then core.log("! item rider %s apply: %s", d.key, tostring(why)) end
end

-- One item's value of a rider table; no table is made just to keep nothing.
local function item_store(m, d, id, value)
	if type(m[d.key]) ~= "table" and value ~= nil then m[d.key] = {} end
	if type(m[d.key]) == "table" then m[d.key][id] = value end
	if d.apply then item_apply(d, id, value) end
end

local function item_poll()
	local m = m_data()
	if not (m and db.actor) then return end
	local silent = not item_seeded
	item_seeded = true
	local out = {}
	db.actor:iterate_inventory(function(_, item)
		local id = item:id()
		if clone_busy[id] then return end
		local b = item_base[id]
		if not b then
			b = {}
			item_base[id] = b
		end
		for _, d in ipairs(item_keys) do
			local tbl = m[d.key]
			local value
			if type(tbl) == "table" then value = tbl[id] end -- preserve false; nil means removal
			local packed = value == nil and "_" or core.pack(value)
			if b[d.key] ~= packed or item_retry[id] then
				b[d.key] = packed
				if not silent or item_retry[id] then out[#out + 1] = { core.host_id(id), d.key, packed, item_instance(id) } end
			end
		end
		item_retry[id] = nil
	end, db.actor)
	if #out > 0 then
		stats.imd_out = stats.imd_out + #out
		send_batches("imd", out, 0)
	end
	if carries() then
		local t = core.now()
		for key, e in pairs(imd_recent) do
			if t - e.at > CARRY_MS then imd_recent[key] = nil end
		end
		for _, e in ipairs(out) do
			imd_recent[tostring(e[1]) .. "\0" .. e[2]] = { e[1], e[2], e[3], e[4], at = t }
		end
	end
end

local function on_imd(t, from)
	local host = core.owns_world()
	if host and from <= 0 then return end
	if not host and from ~= 0 then return end
	local m = m_data()
	if not m then return end
	local relay = {}
	local p = host and core.player(from)
	for _, e in ipairs(read_batch(t)) do
		local d = item_decl(e.key)
		local lid = host and e.id or core.local_id(e.id)
		-- item_alias accepts the rider under another stamp of the same item or its bare name.
		local mismatch = alife_object(lid) and e.instance and e.instance ~= item_instance(lid)
		local alias = mismatch and item_alias(lid, e.id, e.instance)
		if alias then mismatch = false end
		if clone_busy[lid] or clone_is_retired(lid) or mismatch then
			stats.imd_refused = stats.imd_refused + 1
		elseif not d then
			-- an addon this machine does not have
		elseif host_holds(host, from, e.id) then
			stats.imd_held = stats.imd_held + 1
			hold(imd_hold, from, e)
		elseif host and not (p and p.avatar_id and core.root_of(e.id) == p.avatar_id) then
			stats.imd_refused = stats.imd_refused + 1
		else
			local lid = host and e.id or core.local_id(e.id)
			item_store(m, d, lid, e.value)
			item_base[lid] = item_base[lid] or {}
			item_base[lid][e.key] = e.packed
			imd_recent[tostring(e.id) .. "\0" .. e.key] = nil -- a newer word than what this machine sent
			stats.imd_in = stats.imd_in + 1
			if alias then
				stats.imd_alias = stats.imd_alias + 1
				say_parts("item rider %s of %s [%s] from %s taken under another stamp of the same item (sent %s)", e.key,
					tostring(e.id), tostring(item_instance(lid)), tostring(from), tostring(e.instance))
			end
			if host then relay[#relay + 1] = { e.id, e.key, e.packed } end
		end
	end
	if host and #relay > 0 then send_batches("imd", relay, nil, from) end
end

-- Host: held riders whose item exists here go to their holder's check, the store and the others.
local function imd_release_held()
	if #imd_hold == 0 then return end
	local m = m_data()
	if not m then return end
	local keep, relay, t = {}, {}, core.now()
	for _, h in ipairs(imd_hold) do
		local e = h.e
		local d = item_decl(e.key)
		if d and alife_object(e.id) ~= nil then
			local p = core.player(h.from)
			if not clone_busy[e.id] and not clone_is_retired(e.id) and p and p.avatar_id and core.root_of(e.id) == p.avatar_id
				and (not e.instance or e.instance == item_instance(e.id) or item_alias(e.id, e.id, e.instance)) then
				item_store(m, d, e.id, e.value)
				item_base[e.id] = item_base[e.id] or {}
				item_base[e.id][e.key] = e.packed
				stats.imd_in = stats.imd_in + 1
				relay[h.from] = relay[h.from] or {}
				local r = relay[h.from]
				r[#r + 1] = { e.id, e.key, e.packed }
			else
				stats.imd_refused = stats.imd_refused + 1
			end
		elseif d and t < h.until_ms then
			keep[#keep + 1] = h
		else
			stats.imd_refused = stats.imd_refused + 1
		end
	end
	imd_hold = keep
	for from, r in pairs(relay) do send_batches("imd", r, nil, from) end
end

local function declare_builtin_item_keys()
	local list = {
		{ "item_exo_device", "exo_devices" }, -- Powered Exos: power and PSU
		{ "z_mark_switch", "mark_switch_current_marks" }, -- Mark Switch / 3DSS reticle
		{ "scripted_canted_irons", "scripted_canted_irons" }, -- 3DSS canted sights
		{ "magnifier_switch", "magnifier_switch_bone_states" }, -- 3DSS magnifier
		{ "meat_spoiling", "expiration_table" }, -- Meat Spoiling clock
		{ "mag_pouches", "pouches" }, -- GAMMA Mags Reloaded pouches
		{ "speed_loaders", "speed_loaders" },
	}
	for _, e in ipairs(list) do
		if rawget(_G, e[1]) or coop_util.module(e[1]) then declare_item_key(e[2]) end
	end
end

-------------------------------------------------------------------------------
-- 3. Per-player m_data
-------------------------------------------------------------------------------
-- Top-level m_data keys that belong to one player. provider(): the current value on this machine.
local function from_save_state(modname, key)
	return function()
		local m = coop_util.module(modname)
		if not (m and type(m.save_state) == "function") then return nil, false end
		local t = {}
		local ok = pcall(m.save_state, t)
		return t[key], ok
	end
end

-- The engine saves only on the host. A client reads the live module state that save_state would write
-- so its disguise, detector and radio frequency survive a load.
-- A global accessor of a module: its value, or "not used" (the m_data entry stays) when the module or the function is missing.
local function from_global(modname, fname)
	return function()
		local m = coop_util.module(modname)
		local f = m and m[fname]
		if type(f) ~= "function" then return nil, false end
		local ok, v = pcall(f)
		if not ok then return nil, false end
		return v, true
	end
end

-- A file local of a module (its save_state is local): found as an upvalue of its functions (coop_mods_core.find_local).
local function from_local(modname, name)
	return function()
		local m = coop_util.module(modname)
		local mc = coop_util.module("coop_mods_core")
		if not (m and mc and type(mc.find_local) == "function") then return nil, false end
		local ok, v, holder = pcall(mc.find_local, m, name)
		if not (ok and holder) then return nil, false end
		return v, true
	end
end

-- actor_effects shows the detector at its first update when the loaded flag says so (actor_effects.script:1865-1867); while
-- that runs active_detector() is still nil, and the first look of a new Lua state comes right then: it would tell the host
-- "put away". Not read before this long after the first update; until then the m_data entry (his own, from the load) stands.
local DETECTOR_SETTLE_MS = 2000
local first_update_at = nil -- core.now() of the actor's first update in this Lua state

local function detector_out()
	local actor = db and db.actor
	if not (actor and first_update_at) or core.now() < first_update_at + DETECTOR_SETTLE_MS then return nil, false end
	return actor:active_detector() and true or false, true -- the stock's own save_state expression
end

-- Stock keys only: third-party mod keys (skills, XP, perks, ...) travel through coop_mods_pdata (mods group);
-- a key that file owns is skipped here.
MANIFEST = {
	sleep = from_save_state("actor_status_sleep", "sleep"), -- sleepiness
	drink = from_save_state("actor_status_thirst", "drink"), -- thirst
	psy_table = from_save_state("arszi_psy", "psy_table"), -- psy health (arszi_psy)
	disguise_state = from_global("gameplay_disguise", "is_actor_disguised"), -- gameplay_disguise (is_disguised)
	-- The player's side of the disguise (gameplay_disguise.script:1122-1123): the relation it replaced and whether he could
	-- talk to his faction. Left to the host's, the first update's has_comms() wrote a relation from the host's values
	-- (:220-223). The NPC side (disguise_highest_suspicion, disguise_npcs_memory) runs on the host and is not carried.
	disguise_previous_relation = from_local("gameplay_disguise", "previous_relation"),
	disguise_can_communicate = from_local("gameplay_disguise", "can_communicate"),
	detector_was_active = detector_out, -- actor_effects
	RF_freq = from_global("item_radio", "get_freq"), -- item_radio frequency
	RepairItemList = from_save_state("inventory_upgrades", "RepairItemList"), -- items lent to a mechanic, ids are the world's
	-- CSE_ALifeItemBolt::can_save is false: the stock keeps the counts here and creates the bolts at its first update.
	-- The saved counts belong to the host, so clients carry their own bolts across a level change.
	bolts = from_save_state("itms_manager", "bolts"),
	bolt_slot = from_save_state("itms_manager", "bolt_slot"),
}

-- Keep the host's values until the player supplies `told`. An empty bolts table reports zero bolts; a missing table
-- means the player has yet to report a count.
local KEEP_UNTIL_TOLD = { bolts = "bolts", bolt_slot = "bolts" }
-- Sections whose take or drop is told soon (a second), not at the next 15 s look: a level change may come first.
local TOLD_SOON = { bolt = true, bolt_bullet = true }

-- itms_manager.actor_on_first_update makes bolts from m_data, which can run on a client before the session is live.
-- coop_requests.cpp lua_create calls take_lease; client_forward_spawn drops the create when the client has no leased id.
-- Remove the client's reported bolts from m_data before load_state so the stock makes none of them. Create them
-- in the client's actor once live, a few per frame, using leased ids. Use only bolt sections and respect the stock limit.
local BOLT_DELAY_MS = 1000 -- after live: the host's IdLease of the new world comes first
local BOLT_BATCH = 10 -- creates a frame (the engine's own pace sends 20 in a row)
local BOLT_QUIET_MS = 5000 -- after the last create: his hands are not told while the new items come online
local BOLT_MAX_DEFAULT = 99 -- itms_manager.ltx [settings] bolt_max_num (ish_fixed_bolt_manager), 99 in Anomaly and GAMMA
local BOLT_MAX_CEIL = 500
local bolts_hold = nil -- { bolts = {sec = n}, slot = sec | nil, at = ms, queue = {sec, ...} } a client's own bolts to make
local bolts_quiet_until = 0
-- While the bolts are created and come online, a load carries the full { bolts, slot } rather than an incomplete inventory.
-- Set with bolts_hold and read while it or the quiet time lasts.
local bolts_carry = nil

function register_player_key(key, provider)
	if type(key) == "string" then MANIFEST[key] = type(provider) == "function" and provider or false end
end

-- Client: a value that must not wait for the 15 s poll (it may be all he has when his game goes down).
function send_player_keys()
	pmd_next_poll = 0
end

local function owned_elsewhere(key)
	local pd = rawget(_G, "coop_mods_pdata")
	if not (pd and type(pd.owns) == "function") then return false end
	local ok, r = pcall(pd.owns, key)
	return ok and r == true
end

local pmd_sig = {} -- key -> packed value last sent
local pmd_unsent = {} -- key -> the logged packed value over MAX_VALUE (the host would refuse it)
local pmd_loaded_for = nil -- m_data table holding the applied surrogate
local pmd_kept = false -- the stash holds the load's starting keys; skip sending from the departing world
local pmd_kept_at = 0
local PMD_KEPT_MS = 180000 -- ... unless that load never comes (a transition called off): the looks go on after this long

local function pmd_current(m, key)
	local provider = MANIFEST[key]
	if provider then
		local ok, v, used = pcall(provider)
		if ok and used ~= false then return v end
	end
	return m[key]
end

local function pmd_poll()
	local m = m_data()
	if not m then return end
	if pmd_kept then
		if core.now() - pmd_kept_at < PMD_KEPT_MS then return end
		pmd_kept = false -- resume sending if the load does not start
	end
	local bolts_busy = bolts_hold ~= nil or core.now() < bolts_quiet_until
	for key in pairs(MANIFEST) do
		local packed = not owned_elsewhere(key) and not (bolts_busy and KEEP_UNTIL_TOLD[key] == "bolts")
			and core.pack(pmd_current(m, key)) or nil
		if packed and pmd_sig[key] ~= packed then
			if #packed > MAX_VALUE then
				-- not sent and not signed: the next look sends it once it is small enough; told once per value
				if pmd_unsent[key] ~= packed then
					pmd_unsent[key] = packed
					stats.oversize = stats.oversize + 1
					core.log("! player key %s (%d bytes) not sent: over %d bytes", key, #packed, MAX_VALUE)
				end
			elseif core.send("pmd", { k = key, d = packed }, 0) then
				pmd_sig[key] = packed
				stats.pmd_out = stats.pmd_out + 1
			end
		end
	end
end

-- Host: entry of a player's character in its m_data store (created on demand).
local function peer_store(m, avatar_id, create)
	local root = m[PEER_STORE]
	if type(root) ~= "table" then
		if not create then return nil end
		root = {}
		m[PEER_STORE] = root
	end
	local se = alife_object(avatar_id)
	local name = se and se:name()
	local e = root[avatar_id]
	if e and name and e.name ~= name then -- another entity has reused the id
		e = nil
		root[avatar_id] = nil
	end
	if not e and create and name then
		e = { name = name, keys = {} }
		root[avatar_id] = e
	end
	return e
end

local function on_pmd(t, from)
	if not core.owns_world() or from <= 0 then return end
	local key = type(t.k) == "string" and t.k or nil
	if not (key and MANIFEST[key] ~= nil and type(t.d) == "string" and #t.d <= MAX_VALUE) then return end
	local v, err = core.unpack(t.d)
	if err and t.d ~= "_" then return end
	local p = core.player(from)
	local m = m_data()
	if not (p and p.avatar_id and m) then return end
	local e = peer_store(m, p.avatar_id, true)
	if not e then return end
	e.keys[key] = v
	stats.pmd_in = stats.pmd_in + 1
end

-- Host: what a client last reported of a per-player key, nil if nothing yet (the enemy audit's phantoms read his psy health).
function player_value(avatar_id, key)
	local m = m_data()
	local e = m and peer_store(m, avatar_id, false)
	return e and e.keys and e.keys[key]
end

-------------------------------------------------------------------------------
-- The host's record can lag a client's drink, sleep or psy hit by 15 s. At the start of a load continuing this world,
-- coop_main.on_world_leaving fires coop_on_world_leaving with the new world's epoch while the actor is available.
-- Store the current keys as "@load:<epoch>|<pack>" in the session stash, using the same rule as coop_mods_pdata.stash_data.
-- The load reads them instead of the host's record. The host is saving at this point; the client sends its next update
-- after the load.
-------------------------------------------------------------------------------
local STASH_KEY = "coop_economy_mdata"

local function world_epoch()
	local api = core.engine()
	if not (api and api.world_epoch) then return nil end -- kept data requires a world epoch
	local ok, e = pcall(api.world_epoch)
	return ok and tonumber(e) or nil
end

local function keep_for_load(epoch)
	epoch = tonumber(epoch)
	if not (epoch and epoch >= 0 and epoch == math.floor(epoch)) or not core.follows_world() or not core.live() then return end
	local api = core.engine()
	local m = m_data()
	if not (api and api.stash_set and m) then return end
	local bolts_busy = bolts_hold ~= nil or core.now() < bolts_quiet_until
	local t = {}
	for key in pairs(MANIFEST) do
		if owned_elsewhere(key) then
			-- coop_mods_pdata keeps it
		elseif KEEP_UNTIL_TOLD[key] == "bolts" and bolts_busy then
			-- his bolts of the last load are still being made: those, not his hands
			if bolts_carry then t[key] = core.copy(key == "bolts" and bolts_carry.bolts or bolts_carry.slot) end
		else
			t[key] = core.copy(pmd_current(m, key))
		end
	end
	local s = core.pack(t)
	local ok, done = pcall(api.stash_set, STASH_KEY, string.format("@load:%d|", epoch) .. s)
	if not (ok and done) then
		core.log("! player data for the load not kept (the stash refused %d bytes): the host's record is used", #s)
		return
	end
	pmd_kept = true
	pmd_kept_at = core.now()
	core.log("player data kept for the load into the world of epoch %d (%d bytes)", epoch, #s)
end

-- The keys kept for this load (under `key`, STASH_KEY by default), or nil. Read once: a state kept for another world (the host
-- loaded a save meanwhile) is dropped.
local function kept_for_load(key)
	key = key or STASH_KEY
	local api = core.engine()
	if not (api and api.stash_get) then return nil end
	local ok, s = pcall(api.stash_get, key)
	if not (ok and type(s) == "string") then return nil end
	if api.stash_set then pcall(api.stash_set, key, nil) end
	local epoch, body = s:match("^@load:(%d+)|(.*)$")
	if not epoch or tonumber(epoch) ~= world_epoch() then return nil end
	local t, err = core.unpack(body)
	if err ~= nil or type(t) ~= "table" then return nil end
	return t
end

-------------------------------------------------------------------------------
-- Stash item values of 1 and 2 that may not reach the world before a load. Read them with the player keys and
-- reapply them once the player is live in the next world.
-------------------------------------------------------------------------------
local ITEMS_STASH_KEY = "coop_economy_mdata_items"
local carry = nil -- client, the values kept for this load: { se = { {id, var, packed, instance}, ... }, imd = { ... } }

local function carry_add(out, seen, e, budget)
	local key = tostring(e[1]) .. "\0" .. tostring(e[2])
	if seen[key] then return end -- a newer one of this var is in already
	local len = #e[3] + #tostring(e[2]) + #(e[4] or "") + 24
	if budget.n >= CARRY_MAX or budget.bytes + len > CARRY_BYTES then
		budget.over = budget.over + 1
		return
	end
	seen[key] = true
	budget.n, budget.bytes = budget.n + 1, budget.bytes + len
	out[#out + 1] = { e[1], e[2], e[3], e[4] or "" }
end

local function recent_newest(list, t)
	local r = {}
	for _, e in pairs(list) do
		if t - e.at <= CARRY_MS then r[#r + 1] = e end
	end
	table.sort(r, function(a, b) return a.at > b.at end)
	return r
end

local function keep_items_for_load(epoch)
	epoch = tonumber(epoch)
	if not (epoch and epoch >= 0 and epoch == math.floor(epoch)) or not carries() or not core.live() then return end
	local api = core.engine()
	local m = m_data()
	if not (api and api.stash_set and m) then return end
	local budget = { n = 0, bytes = 0, over = 0 }
	local se, imd, seen_se, seen_imd = {}, {}, {}, {}
	-- not sent yet, so newer than anything sent: the queue of the next flush, the writes of the world's reading, the riders the
	-- next look would send
	for _, e in pairs(se_out) do carry_add(se, seen_se, e, budget) end
	for _, e in pairs(se_early) do
		if not clone_busy[e[1]] then carry_add(se, seen_se, { core.host_id(e[1]), e[2], core.pack(e[3]), item_instance(e[1]) }, budget) end
	end
	if item_seeded and db.actor then
		db.actor:iterate_inventory(function(_, item)
			local id = item:id()
			if clone_busy[id] then return end
			local b = item_base[id] or {}
			for _, d in ipairs(item_keys) do
				local tbl = m[d.key]
				local value
				if type(tbl) == "table" then value = tbl[id] end
				local packed = value == nil and "_" or core.pack(value)
				if b[d.key] ~= packed then carry_add(imd, seen_imd, { core.host_id(id), d.key, packed, item_instance(id) }, budget) end
			end
		end, db.actor)
	end
	local t = core.now()
	for _, e in ipairs(recent_newest(se_recent, t)) do carry_add(se, seen_se, e, budget) end
	for _, e in ipairs(recent_newest(imd_recent, t)) do carry_add(imd, seen_imd, e, budget) end
	if #se == 0 and #imd == 0 then
		pcall(api.stash_set, ITEMS_STASH_KEY, nil)
		return
	end
	local s = core.pack({ se = se, imd = imd })
	local ok, done = pcall(api.stash_set, ITEMS_STASH_KEY, string.format("@load:%d|", epoch) .. s)
	if not (ok and done) then
		core.log("! item data for the load not kept (the stash refused %d bytes): the world's save is used", #s)
		return
	end
	core.log("item data kept for the load into the world of epoch %d: %d se var(s), %d item rider(s)%s", epoch, #se, #imd,
		budget.over > 0 and string.format(" (%d over the limit left out)", budget.over) or "")
end

-- May this machine write a kept value of entity `lid` and send it? The world's rule for a client (client_may_write, on_imd)
-- seen from his side: his own item, or a world flag on an entity no other player holds.
local function mine_to_write(lid, world_var)
	if not alife_object(lid) or clone_busy[lid] or clone_is_retired(lid) then return false end
	local root = core.root_of(lid)
	local own = db.actor and db.actor:id()
	if root ~= nil and root == own then return true end
	if not world_var then return false end
	return root == nil or core.avatar_peer(root) == nil -- another player's: his to write
end

local function same_instance(lid, instance)
	-- item_alias accepts another stamp of this item or its bare name because the save can hold the world's stamp.
	return instance == nil or instance == "" or instance == item_instance(lid) or item_alias(lid, core.host_id(lid), instance)
end

-- At the client's first live frame, reapply and resend each kept value absent from the save.
-- A value already in the save needs no resend. When a newer world value arrives, on_se / on_imd remove the client's
-- send from the recent values.
local function carry_release()
	if not carry or not db.actor then return end
	local c = carry
	carry = nil
	local m = m_data()
	if not m then return end
	local n_se, n_imd = 0, 0
	for _, e in ipairs(type(c.se) == "table" and c.se or {}) do
		local hid, var, packed = core.int(e[1], 0, 65534), e[2], e[3]
		if hid and type(var) == "string" and type(packed) == "string" and not not_sent(var) and not SE_HOST_ONLY[var] then
			local lid = core.local_id(hid)
			local value, err = core.unpack(packed)
			local se = type(m.se_object) == "table" and m.se_object[lid] or nil
			if (err == nil or packed == "_") and same_instance(lid, e[4]) and mine_to_write(lid, SE_WORLD_VARS[var])
				and core.pack(se and se[var]) ~= packed then
				se_store(lid, var, value)
				se_queue(lid, var, value)
				n_se = n_se + 1
			end
		end
	end
	for _, e in ipairs(type(c.imd) == "table" and c.imd or {}) do
		local hid, key, packed = core.int(e[1], 0, 65534), e[2], e[3]
		local d = type(key) == "string" and item_decl(key) or nil
		if hid and d and type(packed) == "string" then
			local lid = core.local_id(hid)
			local value, err = core.unpack(packed)
			local tbl, cur = m[key], nil
			if type(tbl) == "table" then cur = tbl[lid] end
			if (err == nil or packed == "_") and same_instance(lid, e[4]) and mine_to_write(lid, false) and core.pack(cur) ~= packed then
				item_store(m, d, lid, value)
				item_retry[lid] = true -- the next look sends it, the first (silent) one of a world too
				n_imd = n_imd + 1
			end
		end
	end
	if n_se + n_imd > 0 then
		core.log("item data of the last world put back: %d se var(s), %d item rider(s) its save lacked", n_se, n_imd)
	end
end

-- Client loading the host's world: its own per-player values replace the host's before load_state runs.
local function apply_surrogate(m)
	if type(m) ~= "table" or pmd_loaded_for == m then return end
	pmd_loaded_for = m
	pmd_kept = false -- a new world: the looks go on
	bolts_hold, bolts_quiet_until, bolts_carry = nil, 0, nil -- a new world: what the last one had to make is void
	se_recent, imd_recent = {}, {} -- the save or the kept item data holds the preceding world's values
	local items = kept_for_load(ITEMS_STASH_KEY)
	carry = type(items) == "table" and items or nil
	local my = core.host_id(0)
	local root = m[PEER_STORE]
	local e = type(root) == "table" and root[my] or nil
	local record = type(e) == "table" and type(e.keys) == "table" and e.keys or {}
	local kept = kept_for_load()
	local keys = kept or record
	local n = 0
	pmd_sig = {}
	for key in pairs(MANIFEST) do
		local told = KEEP_UNTIL_TOLD[key]
		if told and keys[told] == nil then
			-- never told: the host's value stands, and the first look sends his own
		elseif not owned_elsewhere(key) then
			m[key] = core.copy(keys[key])
			-- what the host's record has: only changes are sent (a kept value newer than the record is one of them)
			pmd_sig[key] = core.pack(record[key])
			if keys[key] ~= nil then n = n + 1 end
		end
	end
	stats.pmd_applied = n
	if keys.bolts ~= nil and not owned_elsewhere("bolts") then
		-- his own bolts: made once he is live (bolts_make), not by the stock's first update while loading
		bolts_hold = { bolts = m.bolts, slot = m.bolt_slot }
		bolts_carry = { bolts = core.copy(m.bolts), slot = m.bolt_slot }
		m.bolts, m.bolt_slot = nil, nil
	end
	core.log("own player data applied before load_state: %d key(s)%s", n,
		kept and " (kept as he left the last world)" or e and "" or " (first visit: defaults)")
end

-- alife_storage_manager.CALifeStorageManager_load reads the save's m_data, calls on_before_load_state(), then
-- fires load_state: the client's own values go in between. Installed in on_game_start (before the load).
local function patch_load_state()
	local asm = coop_util.module("alife_storage_manager")
	if not (asm and type(asm.on_before_load_state) == "function") then
		core.log("! alife_storage_manager.on_before_load_state missing: player data of clients is the host's")
		return
	end
	local orig = asm.on_before_load_state
	asm.on_before_load_state = function(...)
		local r = orig(...)
		if core.follows_world() then
			local ok, err = pcall(apply_surrogate, m_data())
			if not ok then core.log("! player data: %s", tostring(err)) end
		end
		return r
	end
end

-------------------------------------------------------------------------------
-- 4. World m_data keys (host -> clients)
-------------------------------------------------------------------------------
-- A value over MAX_VALUE goes in pieces (coop_mods_core.send_big, "mods.economy_wmd": "<key>\n<packed>"), up to that chunker's
-- 256 KiB: a list over 12 KB must still reach the clients, and never fail silently.
-- wmd_sig is the value the clients were sent; a client a send failed for (still loading, a full queue) is owed
-- the key (wmd_owed[key][peer]) and gets the current value again alone, after a wait that doubles from one look to WMD_WAIT_MAX.
-- The others are not sent it again. A value that did not reach every client is logged once per key and value (the sends here
-- are quiet: coop_economy_core.send would log every try).
local world_keys = { "player_created_stashes", "workshop_stashes" }
local wmd_sig = {}
local wmd_seeded = false -- clients got the current values with the host's save
local wmd_next_poll = 0
local WMD_BIG = "economy_wmd"
local wmd_unsent = {} -- key -> unsent packed value (logged once per value)
local wmd_owed = {} -- key -> peer -> { at = next try (ms), wait = ms }
local WMD_WAIT_MAX = 60000

function register_world_key(key)
	if type(key) ~= "string" then return end
	for _, k in ipairs(world_keys) do
		if k == key then return end
	end
	world_keys[#world_keys + 1] = key
end

-- Sends world key `key` = `packed` to client `peer`, quietly (no log line per try). -> true; else false, why.
local function wmd_send_to(key, packed, peer)
	if #packed <= MAX_VALUE then
		local api = core.engine()
		if not (api and api.send_event) then return false, "no engine" end
		-- the event core.on("wmd") listens to (coop_economy_core.send without its line at every failed try)
		local ok, sent, why = pcall(api.send_event, "economy.wmd", coop_main.encode({ k = key, d = packed }), peer)
		if ok and sent == true then return true end
		return false, tostring(ok and why or sent)
	end
	local mc = coop_util.module("coop_mods_core")
	if not (mc and type(mc.send_big) == "function") then return false, "no chunker (coop_mods_core)" end
	if mc.send_big(WMD_BIG, key .. "\n" .. packed, peer) then
		stats.wmd_big = (stats.wmd_big or 0) + 1
		return true
	end
	return false, "not sent in pieces (at most 256 KiB)"
end

-- Tries client `peer` with the current value of `key`: sent, he owes nothing; else he is tried again after a wait twice the last.
local function wmd_try(key, packed, peer, now)
	local owed = wmd_owed[key]
	local sent, why = wmd_send_to(key, packed, peer)
	if sent then
		if owed then owed[peer] = nil end
		return true
	end
	if not owed then
		owed = {}
		wmd_owed[key] = owed
	end
	local last = owed[peer]
	local wait = last and math.min(last.wait * 2, WMD_WAIT_MAX) or WORLD_POLL_MS
	owed[peer] = { at = now + wait, wait = wait }
	if wmd_unsent[key] ~= packed then
		wmd_unsent[key] = packed -- told once per key and value
		stats.oversize = stats.oversize + 1
		core.log("! world key %s (%d bytes) not sent to %s: %s; tried again for him alone, at growing waits", key, #packed,
			tostring(core.nick_of(peer) or peer), tostring(why))
	end
	return false
end

local function wmd_poll()
	local m = m_data()
	if not m then return end
	local silent = not wmd_seeded
	wmd_seeded = true
	local now = core.now()
	local here = {}
	for _, p in ipairs(core.players()) do
		if not p.is_self then here[p.id] = true end
	end
	for _, key in ipairs(world_keys) do
		local packed = core.pack(m[key])
		local owed = wmd_owed[key]
		if owed then
			for peer in pairs(owed) do
				if not here[peer] then owed[peer] = nil end -- he left: a new join gets the values with the host's save
			end
		end
		if wmd_sig[key] ~= packed then
			wmd_sig[key] = packed
			if not silent then -- (the first look is the baseline)
				-- a new value: every client is tried at once (one who still owes the old one keeps his growing wait on a failure)
				stats.wmd_out = stats.wmd_out + 1
				for peer in pairs(here) do wmd_try(key, packed, peer, now) end
			end
		elseif owed then
			for peer, o in pairs(owed) do
				if now >= o.at then wmd_try(key, packed, peer, now) end
			end
		end
		if owed and next(owed) == nil then wmd_owed[key] = nil end
	end
end

local function wmd_known(key)
	for _, k in ipairs(world_keys) do
		if k == key then return true end
	end
	return false
end

-- Client: world key `key` = packed value `d` from the host.
local function wmd_apply(key, d)
	if not (type(key) == "string" and wmd_known(key) and type(d) == "string") then return end
	local v, err = core.unpack(d)
	if err and d ~= "_" then return end
	local m = m_data()
	if m then
		m[key] = v
		stats.wmd_in = stats.wmd_in + 1
	end
end

local function on_wmd(t, from)
	if core.owns_world() or from ~= 0 then return end
	wmd_apply(t.k, t.d)
end

-- The pieces of a big value, put together by coop_mods_core (side "client": from the host only).
local function on_wmd_big(str, from)
	if core.owns_world() or from ~= 0 or type(str) ~= "string" then return end
	local cut = str:find("\n", 1, true)
	if not cut then return end
	wmd_apply(str:sub(1, cut - 1), str:sub(cut + 1))
end

-------------------------------------------------------------------------------
-- 5. A weapon's clone (scope, kit, detach): its vars go with it
-------------------------------------------------------------------------------

-- Native replacement callbacks run synchronously around registration and its script callbacks.
-- Validate before pack(): pack deliberately turns unsupported values and excessive depth into nil.
local function clone_value_ok(value, depth, seen, count)
	count.n = count.n + 1
	if count.n > 2048 or depth > 8 then return false end
	local kind = type(value)
	if kind == "nil" or kind == "boolean" then return true end
	if kind == "number" then return value == value and value ~= math.huge and value ~= -math.huge end
	if kind == "string" then return #value <= 4096 end
	if kind == "userdata" then
		local ok, fields = pcall(function()
			if value.diffSec == nil or value.dateToString == nil then return nil end
			return utils_data.CTime_to_table(value)
		end)
		if not ok or type(fields) ~= "table" then return false end
		for _, field in pairs(fields) do
			local field_type = type(field)
			if field_type ~= "string" and field_type ~= "number" and field_type ~= "boolean" then return false end
		end
		return clone_value_ok(fields, depth + 1, seen, count)
	end
	if kind ~= "table" or seen[value] or getmetatable(value) ~= nil then return false end
	seen[value] = true
	for key, child in pairs(value) do
		if type(key) ~= "string" and type(key) ~= "number" then return false end
		if not clone_value_ok(key, depth + 1, seen, count) or not clone_value_ok(child, depth + 1, seen, count) then return false end
	end
	seen[value] = nil
	return true
end

local function clone_decode(packed)
	if type(packed) ~= "string" or #packed > 4096 then return nil end
	local value, why = core.unpack(packed)
	if why or type(value) ~= "table" or type(value.se) ~= "table" or type(value.riders) ~= "table" or type(value.se_present) ~= "boolean" then return nil end
	if not clone_value_ok(value, 0, {}, { n = 0 }) then return nil end
	for key in pairs(value.riders) do if not item_decl(key) then return nil end end
	if core.pack(value) ~= packed then return nil end -- detects any parser/CTime conversion that silently lost a value
	return value
end

function clone_export(id, stamp)
	local m = m_data()
	if not (m and type(m.se_object) == "table") then return nil end
	local snapshot = { se = {}, riders = {}, se_present = m.se_object[id] ~= nil or stamp ~= nil }
	for key, value in pairs(m.se_object[id] or {}) do
		if key ~= "name" then snapshot.se[key] = value end
	end
	for _, d in ipairs(item_keys) do
		if type(m[d.key]) == "table" then snapshot.riders[d.key] = m[d.key][id] end
	end
	if stamp and not snapshot.se._coop_instance then snapshot.se._coop_instance = stamp end
	if not clone_value_ok(snapshot, 0, {}, { n = 0 }) then return nil end
	local packed = core.pack(snapshot)
	if #packed > 4096 or not clone_decode(packed) then return nil end
	if stamp and not (m.se_object[id] and m.se_object[id]._coop_instance) then
		local object = alife_object(id)
		if not object then return nil end
		m.se_object[id] = m.se_object[id] or { name = object:name() }
		m.se_object[id]._coop_instance = snapshot.se._coop_instance
		clone_retired[id] = nil
	end
	return packed
end

local function clone_purge(id)
	local hid = core.host_id(id)
	local prefix = tostring(hid) .. "\0"
	for key in pairs(se_out) do if key:sub(1, #prefix) == prefix then se_out[key] = nil end end
	for key in pairs(se_sig) do if key:sub(1, #prefix) == prefix then se_sig[key] = nil end end
	for i = #se_wait, 1, -1 do if se_wait[i][1] == id then table.remove(se_wait, i) end end
	for _, list in ipairs({ se_hold, imd_hold }) do
		for i = #list, 1, -1 do if list[i].e.id == hid then table.remove(list, i) end end
	end
	item_base[id] = nil
	item_retry[id] = nil
end

local function clone_restore(id, snapshot, name)
	local m = m_data()
	m.se_object[id] = snapshot and snapshot.se_present and snapshot.se or nil
	if m.se_object[id] then m.se_object[id].name = name end
	for _, d in ipairs(item_keys) do
		if type(m[d.key]) == "table" then m[d.key][id] = nil end
		if snapshot and snapshot.riders[d.key] ~= nil then
			m[d.key] = m[d.key] or {}
			m[d.key][id] = snapshot.riders[d.key]
		end
	end
end

function clone_stage(source, target, name, packed, trust, token)
	local snapshot = clone_decode(packed)
	local m = m_data()
	if not snapshot or not m or type(name) ~= "string" or type(token) ~= "string" then return false end
	if clone_storage ~= m then clone_reset() end
	if clone_transactions[target] then
		local tx = clone_transactions[target]
		if trust == 2 and snapshot.se._coop_instance == tx.token then
			tx.staged = core.pack(snapshot)
			tx.activated = false
			clone_restore(target, snapshot, name)
			return true
		end
		if tx.token ~= token then return false end
		clone_restore(target, clone_decode(tx.staged), name)
		return true
	end
	if clone_busy[source] or clone_busy[target] then return false end
	local previous = m.se_object[target] and clone_decode(clone_export(target)) or nil
	if m.se_object[target] and not previous then return false end
	local original = source ~= 65535 and clone_export(source) or nil
	if source ~= 65535 and not original then return false end
	if trust == 1 then
		local host = m.se_object[source] or {}
		-- item_alias accepts the owner's source under another stamp of the same item or its bare name. Another
		-- player's repair can leave the owner unstamped, and the world server's repair answer can reach an
		-- unstamped map server copy. A different name or host id is refused; the engine checks the source name.
		local theirs = snapshot.se._coop_instance
		if theirs ~= host._coop_instance then
			local object = alife_object(source)
			local named = theirs or (object and object:name())
			if not item_alias(source, core.host_id(source), named) then return false end
			stats.clone_alias = stats.clone_alias + 1
			say_parts("clone of %s [%s] into %s: the owner's source under another stamp of the same item (sent %s)",
				tostring(core.host_id(source)), tostring(item_instance(source)), tostring(core.host_id(target)), tostring(named))
		end
		for key in pairs(SE_HOST_ONLY) do snapshot.se[key] = nil end
		for key in pairs(SE_HOST_ONLY) do snapshot.se[key] = host[key] end
		snapshot.se_present = snapshot.se_present or m.se_object[source] ~= nil
		original = core.pack(snapshot) -- the owner's permitted source state survives a rejected replacement
	end
	local early = se_parts_wait[target]
	if trust == 2 and early and snapshot.se.parts == nil and type(early.instance) == "string" then
		-- Accept waiting parts under the item's own stamp or another stamp matching its name and host id, as item_alias does.
		-- In Server the map server's parts can wait under its stamp while the weapon arrives with the world's stamp.
		-- Clear the waiting entry after applying it.
		local same = early.instance == snapshot.se._coop_instance
		if not same then
			local early_name, early_hid = named_by(early.instance)
			same = early_name == name and (early_hid == nil or early_hid == core.host_id(target))
			if same then
				stats.parts_alias = stats.parts_alias + 1
				say_parts("parts of %s [%s] waiting under %s taken with the item's arrival under another stamp of the same item",
					tostring(core.host_id(target)), tostring(name), tostring(early.instance))
			end
		end
		if same then snapshot.se.parts = early.value end
	end
	local rollback = original and clone_decode(original)
	if original and not rollback then return false end
	snapshot.se_present = true
	if trust ~= 2 or not snapshot.se._coop_instance then snapshot.se._coop_instance = token end
	local staged = core.pack(snapshot)
	if not clone_decode(staged) then return false end
	local source_updates = {}
	for _, entry in pairs(se_out) do
		if entry[1] == core.host_id(source) then source_updates[#source_updates + 1] = entry end
	end
	local original_name = m.se_object[source] and m.se_object[source].name
	clone_transactions[target] = { source = source, original = rollback, original_name = original_name,
		previous = previous, previous_name = m.se_object[target] and m.se_object[target].name, token = token, name = name,
		source_updates = source_updates, staged = staged }
	clone_busy[target] = true
	if source ~= 65535 then clone_busy[source] = true end
	clone_retired[target] = nil
	clone_purge(source)
	clone_purge(target)
	clone_restore(target, snapshot, name)
	if trust == 2 then se_parts_wait[target] = nil end
	return true
end

function clone_activate(target)
	local tx = clone_transactions[target]
	if tx and tx.activated then return true end
	local m = m_data()
	for _, d in ipairs(item_keys) do
		if d.apply and type(m[d.key]) == "table" then
			local ok = pcall(d.apply, target, m[d.key][target])
			if not ok then return false end
		end
	end
	if tx then tx.activated = true end
	if m.se_object[target] and m.se_object[target].parts ~= nil then se_heard(target, "parts") end
	return true
end

function clone_finish(target, accepted)
	local tx = clone_transactions[target]
	if not tx then return true end
	clone_purge(target)
	clone_purge(tx.source)
	if not accepted then
		if tx.source ~= 65535 then clone_restore(tx.source, tx.original, tx.original_name) end
		clone_restore(target, tx.previous, tx.previous_name)
		clone_retired[target] = { token = tx.token, name = tx.name }
	else
		if tx.source ~= 65535 and not alife_object(tx.source) then
			clone_retired[tx.source] = { token = tx.token, name = tx.original_name }
		end
	end
	clone_busy[target], clone_busy[tx.source], clone_transactions[target] = nil, nil, nil
	if not accepted and tx.source ~= 65535 then
		for key, value in pairs(tx.original.se) do
			if core.owns_world() or not SE_HOST_ONLY[key] then se_queue(tx.source, key, value) end
		end
		for _, entry in ipairs(tx.source_updates) do
			if core.owns_world() or not SE_HOST_ONLY[entry[2]] then
				local packed = core.pack(tx.original.se[entry[2]])
				local key = tostring(entry[1]) .. "\0" .. entry[2]
				se_out[key], se_sig[key] = { entry[1], entry[2], packed, entry[4] }, packed
			end -- retain tombstones and the source stamp, with the restored snapshot's authoritative value
		end
		item_retry[tx.source] = true
	end
	return true
end

function clone_pending(id) return clone_busy[id] == true end

function clone_adopt(id, packed)
	local snapshot = clone_decode(packed)
	local m = m_data()
	if not snapshot or not m or type(snapshot.se._coop_instance) ~= "string" then return false end
	local current = m.se_object[id] and m.se_object[id]._coop_instance
	if current and current ~= snapshot.se._coop_instance then return false end
	m.se_object[id] = m.se_object[id] or {}
	for key in pairs(SE_HOST_ONLY) do m.se_object[id][key] = snapshot.se[key] end
	-- A player's copy can predate the authority's initialization. Seed that
	-- existing instance too. Keep a newer value already received on the SE lane.
	local parts_key = tostring(core.host_id(id)) .. "\0parts"
	local parts_sig = se_sig[parts_key]
	local local_parts = se_out[parts_key] or se_recent[parts_key]
	local early = se_parts_wait[id]
	se_parts_wait[id] = nil
	if not parts_sig or (early and early.instance == snapshot.se._coop_instance) then
		local parts = snapshot.se.parts
		if parts == nil and early and early.instance == snapshot.se._coop_instance then parts = early.value end
		if parts ~= nil and core.pack(m.se_object[id].parts) ~= core.pack(parts) then
			m.se_object[id].parts = parts
			parts_sig = core.pack(parts)
			se_heard(id, "parts")
		end
	end
	clone_retired[id] = nil
	clone_purge(id)
	if not local_parts then se_sig[parts_key] = parts_sig end
	-- A player's copy resends only what it may write (mine_to_write): a repeat spawn of an NPC's weapon (a roster repair sends
	-- the holder's subtree again) must not echo the riders its save gave it back to the world as this player's word.
	local mirror = coop_mode.is_player_mirror()
	for key, value in pairs(m.se_object[id]) do
		if key ~= "name" and not SE_HOST_ONLY[key] and (key ~= "parts" or local_parts)
			and (not mirror or mine_to_write(id, SE_WORLD_VARS[key])) then
			se_queue(id, key, value)
		end
	end
	return true
end

-- Take only the stamp of another process's spawn of a weapon this copy knows, while this copy
-- holds no stamp of it or the same one (the engine: coop_trunk.cpp world_takes_spawn_stamp -> requests::adopt_spawn_stamp). Stamped
-- as clone_export does above; nothing else of the spawn: no SE_HOST_ONLY keys, no parts, no purge (held and pending changes of the
-- item stay), no resend. clone_adopt is the whole adoption a player's copy does from its authority's spawn.
function clone_take_stamp(id, packed)
	local snapshot = clone_decode(packed)
	local m = m_data()
	local stamp = snapshot and snapshot.se._coop_instance
	if type(stamp) ~= "string" or not (m and type(m.se_object) == "table") or clone_busy[id] then return false end
	local held = m.se_object[id] and m.se_object[id]._coop_instance
	if held then return held == stamp end
	local object = alife_object(id)
	if not object then return false end
	m.se_object[id] = m.se_object[id] or { name = object:name() }
	m.se_object[id]._coop_instance = stamp
	clone_retired[id] = nil
	return true
end

function clone_reset()
	clone_busy, clone_transactions, clone_retired = {}, {}, {}
	item_retry = {}
	se_parts_wait = {}
	clone_storage = m_data()
end
-- GAMMA's alife_clone_weapon (_g.script) copies m_data.se_object[old] to the clone directly; only item_parts.copy_parts_con
-- goes through se_save_var. Every var of the clone the others do not have yet goes out with the next flush.
function after_clone(old_id, new_id)
	if clone_busy[new_id] then return end
	local m = m_data()
	local tbl = m and type(m.se_object) == "table" and type(new_id) == "number" and m.se_object[new_id]
	if type(tbl) ~= "table" then return end
	stats.clones = stats.clones + 1
	for var, val in pairs(tbl) do
		if var ~= "name" then se_queue(new_id, var, val) end
	end
end

local clone_hooked = false
-- once: at install (after _g.script) or at the first update (a mod that defines it later); other wrappers may go
-- around it, after_clone only reads the result
function install_clone_hook()
	if clone_hooked then return end
	local orig = rawget(_G, "alife_clone_weapon")
	if type(orig) ~= "function" then return end
	clone_hooked = true
	_G.alife_clone_weapon = function(se_obj, ...)
		local old_id = se_obj and se_obj.id
		local new = orig(se_obj, ...)
		local new_id = new and new.id
		if type(new_id) == "number" and new_id ~= 65535 then
			local ok, err = pcall(after_clone, old_id, new_id)
			if not ok then core.log("! clone vars: %s", tostring(err)) end
		end
		return new
	end
end

-------------------------------------------------------------------------------
-- Install, update, status
-------------------------------------------------------------------------------
local function install()
	if installed then return end
	installed = true
	orig_save_var = rawget(_G, "se_save_var")
	if type(orig_save_var) == "function" then
		_G.se_save_var = se_wrapper
	else
		core.log("! se_save_var missing: entity script vars are not synced")
	end
	declare_builtin_item_keys()
	patch_load_state()
	install_clone_hook()
end

local function server_entity_on_unregister(se_obj)
	local id = se_obj and se_obj.id
	if type(id) ~= "number" then return end
	item_base[id] = nil
	se_parts_wait[id] = nil
	local key = tostring(core.host_id(id)) .. "\0parts"
	if not clone_busy[id] then se_sig[key], se_out[key] = nil, nil end
end

local function bolt_max()
	local im = coop_util.module("itms_manager")
	local ok, v = pcall(function() return im.ini_manager:r_float_ex("settings", "bolt_max_num") end)
	v = ok and tonumber(v) or BOLT_MAX_DEFAULT
	return math.max(0, math.min(math.floor(v), BOLT_MAX_CEIL))
end

-- Client, live: the own bolts taken out before load_state, as the stock's first update makes them (the slot's, then the
-- counts), a batch a frame. Only bolt sections (TOLD_SOON), a section at most at bolt_max().
local function bolts_make(t)
	local h = bolts_hold
	if not h.at then h.at = t + BOLT_DELAY_MS end
	if t < h.at then return end
	if not h.queue then
		local q, cap = {}, bolt_max()
		if type(h.slot) == "string" and TOLD_SOON[h.slot] then q[#q + 1] = h.slot end
		if type(h.bolts) == "table" then
			for sec, cnt in pairs(h.bolts) do
				if type(sec) == "string" and TOLD_SOON[sec] and type(cnt) == "number" then
					for _ = 1, math.min(math.floor(cnt), cap) do q[#q + 1] = sec end
				end
			end
		end
		h.queue, h.made = q, 0
	end
	local create = _G.alife_create_item -- at the call: the wrappers of other mods (3DSS) as the stock gets them
	if type(create) ~= "function" then
		core.log("! own bolts: no alife_create_item, %d not made", #h.queue)
		bolts_hold = nil
		return
	end
	local actor = db.actor
	if not actor then return end
	for _ = 1, BOLT_BATCH do
		local sec = table.remove(h.queue, 1) -- from the front: the slot's bolt first, it takes the empty bolt slot as in the stock
		if not sec then break end
		local ok, err = pcall(create, sec, actor)
		if ok then h.made = h.made + 1 else core.log("! own bolt [%s]: %s", sec, tostring(err)) end
	end
	if #h.queue == 0 then
		core.log("own bolts made again after the join: %d", h.made)
		bolts_hold = nil
		bolts_quiet_until = t + BOLT_QUIET_MS
	end
end

local function actor_on_update()
	if not core.live() then return end
	if clone_storage ~= m_data() then clone_reset() end
	local t = core.now()
	if bolts_hold and core.follows_world() then
		local ok, err = pcall(bolts_make, t)
		if not ok then
			core.log("! own bolts: %s", tostring(err))
			bolts_hold = nil
		end
	end
	if t >= se_next_flush then
		se_next_flush = t + FLUSH_MS
		if carry then
			-- the writes of this load go into the queue first: a kept value of the same var is what he left with and goes out
			-- after them (GAMMA's WPO rolls the parts again when the save has none: his machine and the world would differ)
			local ok, err = pcall(se_early_release)
			if not ok then core.log("! early se: %s", tostring(err)) end
			ok, err = pcall(carry_release)
			if not ok then core.log("! kept item data: %s", tostring(err)) end
		end
		local ok, err = pcall(se_flush)
		if not ok then core.log("! se flush: %s", tostring(err)) end
		se_retry()
	end
	if nobody_to_tell() then
		item_seeded = false -- nobody to tell: the next pass seeds again silently (a joiner loads a fresh save)
		wmd_seeded = false
		return
	end
	if #item_keys > 0 and t >= item_next_poll then
		item_next_poll = t + ITEM_POLL_MS
		local ok, err = pcall(item_poll)
		if not ok then core.log("! item riders: %s", tostring(err)) end
		if core.owns_world() then
			ok, err = pcall(imd_release_held)
			if not ok then core.log("! held riders: %s", tostring(err)) end
		end
	end
	if core.follows_world() and t >= pmd_next_poll then
		pmd_next_poll = t + PLAYER_POLL_MS
		local ok, err = pcall(pmd_poll)
		if not ok then core.log("! player data: %s", tostring(err)) end
		-- his bolts were left out of this look: they are looked at again right when they may be
		if bolts_hold then
			pmd_next_poll = math.min(pmd_next_poll, t + 1000)
		elseif t < bolts_quiet_until then
			pmd_next_poll = math.min(pmd_next_poll, bolts_quiet_until)
		end
	end
	if core.owns_world() and t >= wmd_next_poll then
		wmd_next_poll = t + WORLD_POLL_MS
		local ok, err = pcall(wmd_poll)
		if not ok then core.log("! world data: %s", tostring(err)) end
	end
end

function print_status()
	core.log("mdata: se vars out %d, in %d, refused %d, waited %d, held for the host's item %d (%d now) | item riders [%d keys] out %d, in %d, refused %d, held %d (%d now) | clones %d | player data out %d, in %d, applied at load %d | world keys out %d, in %d | oversize %d, errors %d",
		stats.se_out, stats.se_in, stats.se_refused, stats.se_pending, stats.se_held, #se_hold, #item_keys,
		stats.imd_out, stats.imd_in, stats.imd_refused, stats.imd_held, #imd_hold, stats.clones, stats.pmd_out,
		stats.pmd_in, stats.pmd_applied, stats.wmd_out, stats.wmd_in, stats.oversize, stats.errors)
	if (stats.wmd_big or 0) > 0 then core.log("mdata: world keys sent in pieces %d", stats.wmd_big) end
	local waiting = 0
	for _ in pairs(se_parts_wait) do waiting = waiting + 1 end
	core.log("mdata parts (P99): taken under another stamp of the same item %d | for another item: refused %d, waited %d (%d wait now) | other se vars %d, item riders %d, clone sources %d taken under another stamp of the same item",
		stats.parts_alias, stats.parts_refused, stats.parts_parked, waiting, stats.se_alias, stats.imd_alias, stats.clone_alias)
end

-- Tests only.
function _stats() return stats end

function on_game_start()
	if not core.engine() then return end
	coop_util.start_step("coop_economy_mdata", "install", install)
	core.on("se", admitted("se", on_se))
	core.on("imd", admitted("imd", on_imd))
	core.on("pmd", on_pmd)
	core.on("wmd", on_wmd)
	coop_util.start_step("coop_economy_mdata", "big world keys", function()
		local mc = coop_util.module("coop_mods_core")
		if mc and type(mc.on_big) == "function" then mc.on_big(WMD_BIG, on_wmd_big, "client") end
	end)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("server_entity_on_unregister", server_entity_on_unregister)
	for _, name in ipairs({ "actor_on_item_take", "actor_on_item_drop" }) do
		RegisterScriptCallback(name, function(obj)
			if not core.follows_world() then return end
			local ok, sec = pcall(function() return obj:section() end)
			-- a second, not at once: a pack of bolts is thirty takes, one word of them is enough
			if ok and TOLD_SOON[sec] then pmd_next_poll = math.min(pmd_next_poll, core.now() + 1000) end
		end)
	end
	RegisterScriptCallback("actor_on_first_update", function()
		first_update_at = core.now() -- start the detector's DETECTOR_SETTLE_MS wait
		coop_util.start_step("coop_economy_mdata", "clone hook", install_clone_hook)
	end)
	-- Keep a client's current keys when a load continuing this world starts. coop_main declares the callback on load;
	-- the core.on calls above load it. keep_for_load checks that this is a client.
	RegisterScriptCallback("coop_on_world_leaving", function(epoch)
		local ok, err = pcall(keep_for_load, epoch)
		if not ok then core.log("! player data for the load: %s", tostring(err)) end
		ok, err = pcall(keep_items_for_load, epoch) -- Keep item values that may not reach the world before the load.
		if not ok then core.log("! item data for the load: %s", tostring(err)) end
	end)
end
