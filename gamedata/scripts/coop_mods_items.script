--[[
	Anomaly Coop - item mods that touch the world (gamedata\scripts\coop_mods_items.script), W4 "mods".

	A client may create and remove items only in its own inventory (the engine forwards those to the host and
	refuses world objects, P7). These mods make world objects out of items, so the world half goes to the host:

	Glowsticks (zz_glowstick_mcm)
	  mods.gs_throw  client -> host { s section, t throw, c condition, x y z, dx dy dz, i item }
	                 the host creates the glowing lamp at the client's hand/eye with the client's aim and burns it
	                 down; a dropped glowstick (on the ground) is replaced by the lamp.
	  mods.gs_pick   client -> host { l lamp }  the host removes a lit lamp and gives the glowstick back with its
	                 charge. A client's own copy of the mod never picks lamps up or burns them (its table is empty).
	Items Model Drop After Usage (model_dropper_mcm)
	  mods.md_drop   client -> host { s section, a alted }  the mod's own drop runs on the host with the client's
	                 character as the actor; the debris is removed once no player is within 65 m.
	Autolooter (z_auto_looter)
	  mods.al_del    client -> host { c container }  after the client looted, the host deletes the leftovers with
	                 its own settings (not while the host itself is looting that container).
	Stash Overhaul corpse stashes (grok_stashes_on_corpses)
	  mods.gso_use   client -> host { n corpse }  the corpse's stash roll runs once, on the host, for that player.
	Corpse loot (death_manager)
	  mods.corpse_loot client -> host { n corpse }  a body gets its loot when it is first used. A client's spawns are
	                 refused, so a body opened only by a client stayed without it: the host fills it, once, for everybody;
	                 the host-only npc_on_use handlers of tasks (Mystery of the Swamps) hear the client's use too
	Backpack stash (item_backpack, ui_hud_dotmarks)
	  mods.stash_make  client -> host { i backpack, t name, p map spot, f whole bag }  the authority of the level makes the box where the
	                   player stands (a backpack on the ground: where it lies) and spends the backpack.
	  mods.stash_made  host -> client { b box, i backpack, s section, p, t, f }  the client shows the stash; with f it moves its own bag in.
	  mods.stash_free  client -> host { b box }  a stash emptied: the box goes, the player gets the backpack back.
	  mods.stash_book  map server -> world server { b, s, p, t | b, x }  player_created_stashes and the map spot live in the world's save.
	Placeable campfire (campfire_placeable)
	  mods.cf_place    client -> host { i item }  the stock's own place_campfire with the client's character as the actor; the item is
	                   spent when the campfire stands, a refusal loses nothing.
	Deployable gun (itms_manager): there is no [deployable_mgun] in Anomaly or GAMMA, the use burns the item on any machine. It comes back.
	Disassembly and addon detach in a box or a body (item_parts.disassembly_*, utils_item.detach_addon; by hand or the Autolooter)
	  a client takes the item into its own bag first (the host arbitrates the move), then the whole call runs on its own item:
	  parts and addons go into its bag, a detached gun goes back where it was. No events of their own.
	A window on a box: Anomaly searches in a Lua dialog, the engine's window that told the host (ReqContainer) never opens, so this file tells the
	engine what the dialog shows (coop.search_window). The host then sends the contents, keeps a bag open and fires coop_on_container_opened:
	Zone Customization Project's roll stays one roll a box, PBA's "less artefacts" runs for a client's box as well.
--]]

local api = rawget(_G, "coop")

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next

local function C() return coop_mods_core end
local function log(fmt, ...) C().log("items", fmt, ...) end

local installed = {}
local st = { gs_throw = 0, gs_pick = 0, md = 0, md_clean = 0, al = 0, gso = 0, stash = 0, stash_freed = 0, cf = 0, refused = 0 }

local function refuse(what, from, why)
	st.refused = st.refused + 1
	log("%s from #%s refused: %s", what, tostring(from), why)
end

local function near(obj, who, dist)
	local ok, d = pcall(function() return obj:position():distance_to_sqr(who:position()) end)
	return ok and d <= dist * dist
end

local function m_data() return alife_storage_manager.get_state() end

local spent = {} -- online release queues GE_DESTROY; reject replays until the source is gone

-------------------------------------------------------------------------------
-- Glowsticks
-------------------------------------------------------------------------------
local LAMP = "lights_glowstick"
local GS = { mod = nil, holder = nil, idx = nil }

-- The mod's live lamp table (id -> { section, charge }); a file local that load_state replaces.
local function gs_table()
	local m = GS.mod
	if not m then return nil end
	if type(m.glowsticks) == "table" then return m.glowsticks end
	if not GS.holder then
		local _, holder, idx = C().find_local(m, "glowsticks")
		GS.holder, GS.idx = holder, idx
	end
	if not GS.holder then return nil end
	local _, v = debug.getupvalue(GS.holder, GS.idx)
	return type(v) == "table" and v or nil
end

local function gs_clear_local_table()
	local m = GS.mod
	if type(m.glowsticks) == "table" then
		m.glowsticks = {}
	elseif GS.holder or gs_table() then
		debug.setupvalue(GS.holder, GS.idx, {})
	end
end

local function color_int(str)
	local c = {}
	for v in tostring(str):gmatch("[^,]+") do c[#c + 1] = math.max(0, math.min(255, math.floor((tonumber(v) or 0) * 255 + 0.5))) end
	for i = 1, 4 do c[i] = c[i] or 0 end
	return c, c[4] * 16777216 + c[1] * 65536 + c[2] * 256 + c[3]
end

-- Host: the lamp the mod would make, at the client's pose.
local function host_create_lamp(section, pos, dir, lv, gv, charge, throw)
	local se = alife_create(LAMP, pos, lv, gv)
	if not se then return nil end
	local data = utils_stpk and utils_stpk.get_lamp_data and utils_stpk.get_lamp_data(se)
	if not data then
		alife_release_id(se.id)
		return nil
	end
	local light = ini_sys:r_string_ex(section, "light_section") or "glowstick_definition"
	local hud = ini_sys:r_string_ex(section, "hud") or "device_glowstick_hud"
	se.angle = vector():set(dir.x + math.random(-5, 5), dir.y + math.random(-5, 5), dir.z + math.random(-5, 5))
	data.visual_name = ini_sys:r_string_ex(section, "visual") or "dynamics\\devices\\dev_glowstick\\dev_glowstick_glow"
	data.light_flags = 47
	if ini_sys:r_bool_ex(light, "volumetric", false) then
		data.light_flags = data.light_flags + 64
		data.volumetric_quality = ini_sys:r_float_ex(light, "volumetric_quality") or 0.5
		data.volumetric_intensity = ini_sys:r_float_ex(light, "volumetric_intensity") or 0.5
		data.volumetric_distance = ini_sys:r_float_ex(light, "volumetric_distance") or 0.5
	end
	local c, packed = color_int(ini_sys:r_string_ex(light, "color_r2") or "0.0,0.4,0.3,0.8")
	data.main_color = packed
	data.main_brightness = charge <= 0.01 and 0 or (c[1] + c[2] + c[3]) / 765 + 1
	data.main_color_animator = ini_sys:r_string_ex(light, "color_animator") or "empty"
	data.main_bone = ini_sys:r_string_ex(hud, "fire_bone") or "light_bone_2"
	data.main_range = ini_sys:r_float_ex(light, "range_r2") or 15
	utils_stpk.set_lamp_data(data, se)
	local t = gs_table()
	if t then t[se.id] = { section, charge } end -- the host's mod burns it down
	local force = throw and (((ui_mcm and ui_mcm.get and ui_mcm.get("glowsticks/throw_force")) or 8) * 1000) or 100
	local fx, fy, fz = dir.x * force, dir.y * force, dir.z * force
	C().when_online(se.id, LAMP, function(obj)
		local sh = obj:get_physics_shell()
		if sh then sh:apply_force(fx, fy, fz) end
	end, 2000)
	return se.id
end

local function is_glowstick_item(section)
	return type(section) == "string" and ini_sys:section_exist(section)
		and (ini_sys:r_string_ex(section, "light_section") ~= nil or section:find("glowstick", 1, true) ~= nil)
end

local function host_gs_throw(t, from)
	local who = C().avatar(from)
	local section, throw = t.s, t.t == true
	local x, y, z = tonumber(t.x), tonumber(t.y), tonumber(t.z)
	if not (who and is_glowstick_item(section) and x and y and z) then return refuse("gs_throw", from, "bad request") end
	local lv, gv = who:level_vertex_id(), who:game_vertex_id() -- never taken from the network
	local pos = vector():set(x, y, z)
	if not (pos:distance_to_sqr(who:position()) <= 9) then return refuse("gs_throw", from, "not at the player") end -- NaN too
	local function unit(v) v = tonumber(v) or 0 if v ~= v then return 0 end return math.max(-1, math.min(1, v)) end
	local dir = vector():set(unit(t.dx), unit(t.dy), unit(t.dz))
	local charge = math.max(0, math.min(1, tonumber(t.c) or 0.01))
	local iid = C().lid(tonumber(t.i))
	if spent[iid] then return refuse("gs_throw", from, "source item already spent") end
	local item = type(iid) == "number" and iid < 65535 and alife_object(iid)
	if not (item and item:section_name() == section) then return refuse("gs_throw", from, "no matching source item") end
	if throw or item.parent_id == who:id() then
		-- A throw still holds the detector. A drop request can overtake its ownership event.
		if item.parent_id ~= who:id() then return refuse("gs_throw", from, "source item is not the player's") end
	else
		if not (item.parent_id == nil or item.parent_id == 65535) then
			return refuse("gs_throw", from, "the dropped glowstick is not on the ground")
		end
		if not (item.position and who:position():distance_to_sqr(item.position) <= 9) then
			return refuse("gs_throw", from, "the dropped glowstick is not near the player")
		end
	end
	local id = host_create_lamp(section, pos, dir, lv, gv, charge, throw)
	if not id then return refuse("gs_throw", from, "lamp not created") end
	spent[iid] = true
	alife_release_id(item.id)
	st.gs_throw = st.gs_throw + 1
end

local function host_gs_pick(t, from)
	local id = C().lid(tonumber(t.l))
	local se = type(id) == "number" and id < 65535 and alife_object(id)
	local obj = se and level.object_by_id(id)
	local who = C().avatar(from)
	if not (se and obj and who and se:section_name() == LAMP and near(obj, who, 4)) then return refuse("gs_pick", from, "no lamp there") end
	local tbl = gs_table()
	local entry = tbl and tbl[id]
	if not entry then return refuse("gs_pick", from, "lamp not tracked") end
	local section, charge = entry[1] or "device_glowstick", tonumber(entry[2]) or 0
	if charge <= 0.01 then return refuse("gs_pick", from, "burnt out") end
	tbl[id] = nil
	alife_release_id(id)
	C().give(from, section, charge)
	st.gs_pick = st.gs_pick + 1
end

local function client_gs_key(key)
	if not (C().live_client() and db.actor) then return end
	if dik_to_bind(key) ~= key_bindings.kUSE then return end
	if _GUIs and not is_empty(_GUIs) then return end
	if not game.hud_motion_allowed() or game.only_movekeys_allowed() then return end
	level.iterate_nearest(db.actor:position(), 2, function(obj)
		if not (obj and obj:section() == LAMP) then return false end
		local p = game.world2ui(obj:position())
		if p.x < 350 or p.x > 750 or p.y < 250 or p.y > 500 then return false end
		local lamp = obj:get_hanging_lamp()
		if not (lamp and lamp:is_on()) then return false end
		C().to_host("gs_pick", { l = C().hid(obj:id()) })
		return true
	end)
end

local function install_glowsticks()
	local m = C().mod("zz_glowstick_mcm")
	if not (m and C().fn(m, "spawn_glowstick")) then return end
	GS.mod = m
	installed[#installed + 1] = "glowsticks"
	C().wrap(m, "spawn_glowstick", "zz_glowstick_mcm.spawn_glowstick", function(orig)
		return function(id, throw, ...)
			if not C().is_client() then return orig(id, throw, ...) end
			local itm = id and level.object_by_id(id)
			if not itm or (not throw and itm:parent()) then return true end
			local actor = db.actor
			local ok, pos = pcall(function() return actor:bone_position(throw and "eye_left" or "bip01_l_hand") end)
			pos = ok and pos or actor:position()
			pos.y = pos.y + 0.1
			local dir = device().cam_dir
			C().to_host("gs_throw", { i = C().hid(id), s = itm:section(), t = throw and true or false, c = itm:condition(),
				x = pos.x, y = pos.y, z = pos.z, dx = dir.x, dy = dir.y, dz = dir.z })
			return true
		end
	end)
	local wrapped, old = C().wrap(m, "actor_on_hud_animation_end", "zz_glowstick_mcm.actor_on_hud_animation_end", function(orig)
		return function(item, section, motion, ...)
			if not (C().is_client() and item and type(section) == "string"
				and section:find("glowstick", 1, true) and motion == "anm_throw_stick") then
				return orig(item, section, motion, ...)
			end
			-- Keep native hide/equip-next, but only the host may spend the source after creating its lamp.
			-- Scope the override to this callback and this item; a failed/rejected request keeps the item.
			local saved, release = rawget(m, "alife_release_id"), m.alife_release_id
			m.alife_release_id = function(id, ...)
				if id ~= item:id() then return release(id, ...) end
			end
			local ok, result = pcall(orig, item, section, motion, ...)
			m.alife_release_id = saved
			if not ok then error(result) end
			return result
		end
	end)
	if wrapped then C().swap_callback("actor_on_hud_animation_end", old, m.actor_on_hud_animation_end) end
	local binder = m.glowstick_binder
	C().wrap(binder, "update", "zz_glowstick_mcm.glowstick_binder.update", function(orig)
		return function(self, delta, ...)
			if not C().is_client() then return orig(self, delta, ...) end
			-- Burning down and removal are the host's; the client only shows the prompt.
			if self.first_update then
				self.first_update = nil
				pcall(function()
					if self.object:get_hanging_lamp():is_on() then self.object:set_tip_text("inventory_item_use") end
				end)
			end
		end
	end)
	C().on("gs_throw", host_gs_throw, "host")
	C().on("gs_pick", host_gs_pick, "host")
	C().set_limit("gs_throw", 4, 1)
	C().set_limit("gs_pick", 4, 2)
	RegisterScriptCallback("on_key_press", client_gs_key)
end

-------------------------------------------------------------------------------
-- Items Model Drop After Usage
-------------------------------------------------------------------------------
local MD_CLEAN_DIST = 65
local md = { dropped = {}, next_clean = 0 } -- host: id -> position of a client's debris

local function md_has_model(sec)
	if type(sec) ~= "string" or #sec > 96 then return false end
	if ini_sys:section_exist("dropper_" .. sec) then return true end
	for i = 1, 5 do
		if ini_sys:section_exist("dropper_" .. sec .. "_" .. i) then return true end
	end
	return false
end

local function host_md_drop(t, from)
	local M = C().mod("model_dropper_mcm")
	local who = C().avatar(from)
	if not (M and who and md_has_model(t.s)) then return refuse("md_drop", from, "no model for that item") end
	-- The mod's own drop with the requester's character as the actor; what it creates is ours to clean.
	local real = _G.alife_create
	local made = {}
	_G.alife_create = function(...)
		local se = real(...)
		if se then made[#made + 1] = se end
		return se
	end
	-- The mod places the drop at "the actor" in a time event, after this call: it landed at the host (live 2026-10-31).
	local events = rawget(_G, "demonized_time_events")
	local real_event = events and events.CreateTimeEvent
	if real_event then
		events.CreateTimeEvent = function(ev, action, delay, f, ...)
			return real_event(ev, action, delay, function(...)
				local body = C().avatar(from)
				if not body then return true end
				local run, done = C().as_player(body, f, ...)
				return done or not run
			end, ...)
		end
	end
	local okp, ok, e = pcall(C().as_player, who, M.spawn_object, t.s, t.a == true)
	if real_event then events.CreateTimeEvent = real_event end
	_G.alife_create = real -- restored even if as_player itself failed (W5)
	if not (okp and ok) then C().report("items", "model drop", okp and e or ok) end
	for _, se in ipairs(made) do md.dropped[se.id] = vector():set(se.position) end
	st.md = st.md + 1
end

local function host_md_clean()
	if not next(md.dropped) then return end
	local tg = time_global()
	if tg < md.next_clean then return end
	md.next_clean = tg + 5000
	local players = C().player_objects()
	for id, pos in pairs(md.dropped) do
		local near_any = false
		for _, p in ipairs(players) do
			if p.obj:position():distance_to_sqr(pos) <= MD_CLEAN_DIST * MD_CLEAN_DIST then near_any = true break end
		end
		if not near_any then
			local se = alife_object(id)
			if se and se:section_name():find("^dropper_") then
				alife_release(se)
				st.md_clean = st.md_clean + 1
			end
			md.dropped[id] = nil
		end
	end
end

local function install_model_dropper()
	local M = C().mod("model_dropper_mcm")
	if not (M and C().fn(M, "spawn_object")) then return end
	installed[#installed + 1] = "model_dropper"
	C().wrap(M, "spawn_object", "model_dropper_mcm.spawn_object", function(orig)
		return function(item_sec, alted, ...)
			if not C().is_client() then return orig(item_sec, alted, ...) end
			if alted then return true end -- the variants are the host's to expand
			if md_has_model(item_sec) then C().to_host("md_drop", { s = item_sec, a = false }) end
			return true
		end
	end)
	C().on("md_drop", host_md_drop, "host")
	C().set_limit("md_drop", 6, 1)
end

-------------------------------------------------------------------------------
-- Autolooter
-------------------------------------------------------------------------------
local al = { pending = {} }
local take_busy -- below: items of a container are being taken or given back (take first)

local function al_contents_key(lm, cont)
	local ok, items = pcall(lm.collect_items, cont)
	if not (ok and type(items) == "table") then return "" end
	local ids = {}
	for id in pairs(items) do ids[#ids + 1] = tostring(id) end
	table.sort(ids)
	return table.concat(ids, ",")
end

-- The host's answers to the loot (unloaded rounds, moved items) take a moment: wait until the container is
-- quiet, loot once more, then ask the host to delete what is left.
local function al_request_when_settled(lm, cont)
	local cid = cont:id()
	if al.pending[cid] then return end
	al.pending[cid] = true
	local t0, last, quiet, looted = time_global(), nil, time_global(), false
	CreateTimeEvent("coop_mods_al", "del_" .. cid, 0.25, function()
		local c = level.object_by_id(cid)
		if not c then
			al.pending[cid] = nil
			return true
		end
		local now = time_global()
		if looted then
			al.pending[cid] = nil
			C().to_host("al_del", { c = C().hid(cid) })
			return true
		end
		local key = al_contents_key(lm, c)
		if key ~= last then last, quiet = key, now end
		-- a gun stripped by take first is in the player's bag meanwhile: not quiet until it is back
		local busy = take_busy ~= nil and take_busy(cid)
		if busy then quiet = now end
		if now - t0 < (busy and 15000 or 6000) and (now - t0 < 1000 or now - quiet < 500) then
			ResetTimeEvent("coop_mods_al", "del_" .. cid, 0.25)
			return false
		end
		if C().fn(lm, "handle_loot") then pcall(lm.handle_loot, c) end
		looted = true
		ResetTimeEvent("coop_mods_al", "del_" .. cid, 0.25)
		return false
	end)
end

local function host_looting(id)
	local gui = ui_inventory and ui_inventory.GUI
	local ok, shown = pcall(function() return gui and gui:IsShown() and gui.npc_id == id end)
	return ok and shown == true
end

local function install_autolooter()
	local lm = C().mod("z_auto_looter")
	if not (lm and C().fn(lm, "handle_delete")) then return end
	installed[#installed + 1] = "autolooter"
	local _, orig_delete = C().wrap(lm, "handle_delete", "z_auto_looter.handle_delete", function(orig)
		return function(cont, ...)
			if not (C().is_client() and cont) then return orig(cont, ...) end
			local cfg = type(lm.config) == "table" and lm.config or {}
			if not (cfg.delete_body or cfg.delete_weapon or cfg.delete_armor or cfg.delete_misc) then return end
			if cfg.delete_body and IsStalker(cont) and not cont:alive() and ui_inventory and ui_inventory.GUI then
				pcall(function() if ui_inventory.GUI:IsShown() then ui_inventory.GUI:Close() end end)
			end
			al_request_when_settled(lm, cont)
		end
	end)
	C().on("al_del", function(t, from)
		local id = C().lid(tonumber(t.c))
		local cont = type(id) == "number" and id ~= 0 and level.object_by_id(id)
		local who = C().avatar(from)
		if not (cont and who and near(cont, who, 12)) then return refuse("al_del", from, "unknown or far container") end
		local corpse = (IsStalker(cont) or IsMonster(cont)) and not cont:alive()
		if not (corpse or IsInvbox(cont)) or C().is_player(id) then return refuse("al_del", from, "not a corpse or a box") end
		local placeable = C().fn(lm, "is_placable_stash")
		if placeable and placeable(cont) then return refuse("al_del", from, "a player's stash") end
		if host_looting(id) then return refuse("al_del", from, "the host is looting it") end
		local cfg = type(lm.config) == "table" and lm.config or {}
		if corpse and cfg.delete_body then
			alife_release_id(id) -- the mod's body branch would close the host's own loot window
		else
			local ok, e = pcall(orig_delete, cont)
			if not ok then C().report("items", "autolooter delete", e) end
		end
		st.al = st.al + 1
	end, "host")
	C().set_limit("al_del", 10, 2)
end

-------------------------------------------------------------------------------
-- Stash Overhaul: corpse stashes
-------------------------------------------------------------------------------
local gso_served = {}

local function install_gso()
	local g = C().mod("grok_stashes_on_corpses")
	if not (g and C().fn(g, "npc_on_use")) then return end
	installed[#installed + 1] = "gso"
	local _, orig_use = C().wrap(g, "npc_on_use", "grok_stashes_on_corpses.npc_on_use", function(orig)
		return function(npc, ...)
			if not (C().is_client() and npc) then return orig(npc, ...) end
			if npc:alive() then return end
			C().to_host("gso_use", { n = C().hid(npc:id()) })
		end
	end)
	C().on("gso_use", function(t, from)
		local id = C().lid(tonumber(t.n))
		local npc = type(id) == "number" and id ~= 0 and level.object_by_id(id)
		local who = C().avatar(from)
		if not (npc and who and IsStalker(npc) and not npc:alive() and near(npc, who, 6)) then
			return refuse("gso_use", from, "no corpse there")
		end
		-- Once per corpse while it lasts (ids are reused after a release).
		local key = tostring(id) .. ":" .. npc:section()
		if gso_served[key] then return end
		gso_served[key] = true
		local ok, e = C().as_player(who, orig_use, npc)
		if not ok then C().report("items", "corpse stash", e) end
		st.gso = st.gso + 1
	end, "host")
	C().set_limit("gso_use", 6, 2)
end

-------------------------------------------------------------------------------
-- Corpse loot
-------------------------------------------------------------------------------
local corpse_loot_wrapped = false

-- Host-only npc_on_use handlers of tasks that wait for a player to search a corpse (Mystery of the Swamps: the ecologists'
-- bodies). The stock callback runs on the machine of the player who used the body, where a host-domain handler is skipped, so
-- a client's search never reached them. Called one by one with the client's character: SendScriptCallback would run the loot,
-- stash and inventory handlers of every other mod a second time.
local USE_HANDLERS = { "tasks_mystery_of_the_swamps" }

-- guaranteed_loot counts the searches of "the player" and takes only id 0 for him: this process's actor stands for whoever searched.
local function count_guaranteed_drops(npc)
	local drops = C().fn(C().mod("guaranteed_loot"), "npc_on_use")
	if not drops then return end
	local done, err = pcall(drops, npc, db.actor)
	if not done then C().report("items", "guaranteed_loot.npc_on_use", err) end
end

-- At the first update: Haru's skills and FDDA replace create_release_item when they load, and a wrapper put here earlier
-- would be replaced with it. The stock function keeps a body to one roll (death_dropped).
local function wrap_corpse_loot()
	if corpse_loot_wrapped then return end
	corpse_loot_wrapped = true
	C().wrap(death_manager, "create_release_item", "death_manager.create_release_item", function(orig)
		return function(npc, ...)
			if not (C().is_client() and npc) then return orig(npc, ...) end
			if not npc:alive() then C().to_host("corpse_loot", { n = C().hid(npc:id()) }) end
		end
	end)
	-- The stock use_callback asks for the money right after the loot. On a client's copy of the body it can only be refused: it is
	-- made with the loot, where the body is.
	C().wrap(C().mod("item_money"), "actor_on_loot_money", "item_money.actor_on_loot_money", function(orig)
		return function(...)
			if C().is_client() then return end
			return orig(...)
		end
	end)
end

local function install_corpse_loot()
	if not C().fn(C().mod("death_manager"), "create_release_item") then return end
	installed[#installed + 1] = "corpse loot"
	RegisterScriptCallback("actor_on_first_update", wrap_corpse_loot)
	C().on("corpse_loot", function(t, from)
		local id = C().lid(tonumber(t.n))
		local npc = type(id) == "number" and id ~= 0 and level.object_by_id(id)
		local who = C().avatar(from)
		if not (npc and who and IsStalker(npc) and not npc:alive() and near(npc, who, 6)) then
			return refuse("corpse_loot", from, "no corpse there")
		end
		local ok, e = C().as_player(who, death_manager.create_release_item, npc)
		if not ok then C().report("items", "corpse loot", e) end
		local money = C().fn(C().mod("item_money"), "actor_on_loot_money")
		if money then
			local paid, why = C().as_player(who, money, npc)
			if not paid then C().report("items", "corpse money", why) end
		end
		if C().is_map_server() then C().to_host("corpse_dropped", { n = id, s = npc:name() }) end -- a body rolls once, in the world's save too
		for _, name in ipairs(USE_HANDLERS) do
			local handler = C().fn(C().mod(name), "npc_on_use")
			if handler then
				local done, err = pcall(handler, npc, who)
				if not done then C().report("items", name .. ".npc_on_use", err) end
			end
		end
		count_guaranteed_drops(npc)
	end, "host")
	C().set_limit("corpse_loot", 6, 2)
	C().on("corpse_dropped", function(t, from)
		local id = tonumber(t.n)
		if id and type(t.s) == "string" and C().is_bridge(from) then se_save_var(id, t.s, "death_dropped", true) end
	end, "world")
end

-------------------------------------------------------------------------------
-- Backpack stash
-------------------------------------------------------------------------------
local STASH_BOX = "inv_backpack"
local STASH_SLOT = 13
local STASH_CLASS = "EQ_BAKPK"
local STASH_SPOTS = { treasure_player = true, treasure = true }
local STASH_NAME_MAX = 64
local STASH_REACH = 4 -- a backpack on the ground, metres to the player
local STASH_FREE_REACH = 12
local STASH_BOX_WAIT_MS = 10000 -- a client: the box of its answer
local STASH_EMPTY_WAIT_MS = 5000 -- a client: what it took out of the box is on its way
local STASH_SPOT_WAIT_MS = 15000 -- the world server: a map server's box is on its way

local function stash_section(id)
	local book = m_data().player_created_stashes
	return type(book) == "table" and book[id] or nil
end

local function stash_note(id, section)
	local m = m_data()
	if type(m.player_created_stashes) ~= "table" then m.player_created_stashes = {} end
	m.player_created_stashes[id] = section
end

-- The world server: the book and the spot go with the save, coop_economy_mdata shows the book to every client.
local function stash_book(id, section, spot, name)
	stash_note(id, section)
	local deadline = time_global() + STASH_SPOT_WAIT_MS
	CreateTimeEvent("coop_mods_stash", "spot_" .. id, 0, function()
		if alife_object(id) then
			level.map_add_object_spot_ser(id, spot, name)
			return true
		end
		return time_global() > deadline
	end)
end

local function stash_unbook(id)
	local book = m_data().player_created_stashes
	if type(book) == "table" then book[id] = nil end
	for spot in pairs(STASH_SPOTS) do level.map_remove_object_spot(id, spot) end
end

local function stash_name()
	return string.format(game.translate_string("st_itm_stash_of_character"), db.actor:character_name())
end

local function client_stash_ask(item_id, name, spot, whole_bag)
	C().to_host("stash_make", { i = C().hid(item_id), t = name, p = spot, f = whole_bag == true })
end

-- What item_backpack.actor_on_item_use moves. Its loop is a closure of that function, the id of the box it needs comes late here.
local function client_stash_fill(box, backpack)
	local ib = C().mod("item_backpack")
	local keep = C().find_local(ib, "keep_items") or {}
	local actor = db.actor
	actor:iterate_inventory(function(_, item)
		if not item or item:id() == backpack or keep[item:section()] ~= nil then return end
		local sec = item:section()
		if IsAmmo(item) == true and ib.is_ammo_for_wpn(sec) == true then return end
		if ini_sys:r_string_ex(sec, "kind") == "i_medical" or ini_sys:r_bool_ex(sec, "quest_item", false) then return end
		if actor:is_on_belt(item) or ib.is_in_slot(item) then return end
		actor:transfer_item(item, box)
	end)
end

local function client_stash_made(t)
	local id = C().lid(tonumber(t.b))
	local section = t.s
	if not (id and type(section) == "string") then return end
	local spot = STASH_SPOTS[t.p] and t.p or "treasure_player"
	local name = tostring(t.t or "")
	C().when_online(id, nil, function(box)
		level.map_add_object_spot_ser(id, spot, name)
		actor_menu.set_msg(1, game.translate_string("st_stash_created"), 4)
		stash_note(id, section)
		SendScriptCallback("actor_on_stash_create", { stash_id = id, stash_name = name, stash_section = section })
		if t.f == true then client_stash_fill(box, C().lid(tonumber(t.i))) end
	end, STASH_BOX_WAIT_MS)
end

-- The items taken out are on their way here: this copy empty means the box of the authority is.
local function client_stash_free(id)
	local deadline = time_global() + STASH_EMPTY_WAIT_MS
	CreateTimeEvent("coop_mods_stash", "free_" .. id, 0, function()
		local box = level.object_by_id(id)
		if not box then return true end
		if box:is_inv_box_empty() then
			C().to_host("stash_free", { b = C().hid(id) })
			return true
		end
		return time_global() > deadline
	end)
end

local function host_stash_make(t, from)
	local who = C().avatar(from)
	local iid = C().lid(tonumber(t.i))
	local se = type(iid) == "number" and iid < 65535 and alife_object(iid)
	if not (who and se) then return refuse("stash_make", from, "no such item") end
	if spent[iid] then return refuse("stash_make", from, "the backpack is spent already") end
	local section = se:section_name()
	if ini_sys:r_string_ex(section, "class") ~= STASH_CLASS then return refuse("stash_make", from, "not a backpack") end
	local pos
	if C().root_of(iid) == who:id() then
		pos = who:position()
	elseif (se.parent_id == nil or se.parent_id == 65535) and who:position():distance_to_sqr(se.position) <= STASH_REACH * STASH_REACH then
		pos = se.position
	else
		return refuse("stash_make", from, "the backpack is not the player's")
	end
	local box = alife_create(STASH_BOX, pos, who:level_vertex_id(), who:game_vertex_id()) -- vertices never from the network
	if not box then return refuse("stash_make", from, "the box was not created") end
	spent[iid] = true
	alife_release_id(iid)
	local spot = STASH_SPOTS[t.p] and t.p or "treasure_player"
	local name = type(t.t) == "string" and t.t:sub(1, STASH_NAME_MAX):gsub("%c", " ") or ""
	if C().is_map_server() then
		stash_note(box.id, section) -- the book of a map server's save is the world server's: its own level it keeps itself
		C().to_host("stash_book", { b = box.id, s = section, p = spot, t = name })
	else
		stash_book(box.id, section, spot, name)
	end
	C().to_peer(from, "stash_made", { b = box.id, i = t.i, s = section, p = spot, t = name, f = t.f == true })
	st.stash = st.stash + 1
end

local function host_stash_free(t, from)
	local id = C().lid(tonumber(t.b))
	local box = type(id) == "number" and id ~= 0 and level.object_by_id(id)
	local who = C().avatar(from)
	if not (box and who and near(box, who, STASH_FREE_REACH)) then return refuse("stash_free", from, "no such box there") end
	local section = stash_section(id)
	if not (section and box:section() == STASH_BOX) then return refuse("stash_free", from, "not a player's stash") end
	if spent[id] or not box:is_inv_box_empty() then return refuse("stash_free", from, "not empty") end
	spent[id] = true
	alife_release_id(id)
	C().give(from, section)
	if C().is_map_server() then
		local book = m_data().player_created_stashes
		if type(book) == "table" then book[id] = nil end
		C().to_host("stash_book", { b = id, x = true })
	else
		stash_unbook(id)
	end
	st.stash_freed = st.stash_freed + 1
end

local function install_stash()
	local ib = C().mod("item_backpack")
	if not (ib and C().fn(ib, "actor_on_item_use") and C().fn(ib, "actor_on_item_take_from_box")) then return end
	installed[#installed + 1] = "backpack stash"
	C().wrap(ib.UICreateStash, "OnAccept", "item_backpack.UICreateStash.OnAccept", function(orig)
		return function(self, ...)
			if not C().is_client() then return orig(self, ...) end
			local name = self.input:GetText()
			client_stash_ask(self.id, name ~= "" and name or stash_name(), "treasure_player")
			self:Close()
		end
	end)
	local use_wrapped, use_old = C().wrap(ib, "actor_on_item_use", "item_backpack.actor_on_item_use", function(orig)
		return function(obj, ...)
			local backpack = C().is_client() and obj and obj:section() == "itm_actor_backpack" and db.actor:item_in_slot(STASH_SLOT)
			if not backpack then return orig(obj, ...) end
			client_stash_ask(backpack:id(), stash_name(), "treasure_player", true)
		end
	end)
	if use_wrapped then C().swap_callback("actor_on_item_use", use_old, ib.actor_on_item_use) end
	local take_wrapped, take_old = C().wrap(ib, "actor_on_item_take_from_box", "item_backpack.actor_on_item_take_from_box", function(orig)
		return function(box, obj, ...)
			if not (C().is_client() and box and stash_section(box:id())) then return orig(box, obj, ...) end
			if box:section() ~= STASH_BOX or not box:is_inv_box_empty() then return end
			hide_hud_inventory()
			local data = { stash_id = box:id(), cancel = false }
			SendScriptCallback("actor_on_stash_remove", data)
			if data.cancel then return end
			level.map_remove_object_spot(box:id(), "treasure_player")
			client_stash_free(box:id())
		end
	end)
	if take_wrapped then C().swap_callback("actor_on_item_take_from_box", take_old, ib.actor_on_item_take_from_box) end
	local dots = C().mod("ui_hud_dotmarks")
	C().wrap(dots, "deploy_backpack", "ui_hud_dotmarks.deploy_backpack", function(orig)
		return function(id, ...)
			if not C().is_client() then return orig(id, ...) end
			client_stash_ask(id, stash_name(), "treasure")
		end
	end)
	C().wrap(dots, "remove_placed_backpack", "ui_hud_dotmarks.remove_placed_backpack", function(orig)
		return function(id, mapspot, ...)
			if not (C().is_client() and id and stash_section(id)) then return orig(id, mapspot, ...) end
			level.map_remove_object_spot(id, mapspot or "treasure")
			client_stash_free(id)
			return true
		end
	end)
	C().on("stash_make", host_stash_make, "host")
	C().on("stash_free", host_stash_free, "host")
	C().on("stash_made", client_stash_made, "client")
	C().on("stash_book", function(t, from)
		local id = tonumber(t.b)
		if not (id and C().is_bridge(from)) then return end
		if t.x == true then return stash_unbook(id) end
		if type(t.s) == "string" then stash_book(id, t.s, STASH_SPOTS[t.p] and t.p or "treasure_player", tostring(t.t or "")) end
	end, "world")
	C().set_limit("stash_make", 3, 1)
	C().set_limit("stash_free", 3, 1)
	C().set_limit("stash_book", 20, 5)
end

-------------------------------------------------------------------------------
-- Placeable campfire
-------------------------------------------------------------------------------
local CAMPFIRE_ITEM = "itm_campfire"

local function install_campfire()
	local cp = C().mod("campfire_placeable")
	if not (cp and C().fn(cp, "place_campfire") and C().fn(cp, "actor_on_item_use")) then return end
	installed[#installed + 1] = "campfire"
	local item_id = nil -- a client: the item that waits for its fade
	-- Here because a host-only script of the stock does not run on a client. The stock's check of the ground, tip, fade and time, without
	-- its release: the authority spends the item when the campfire stands.
	local use_wrapped, use_old = C().wrap(cp, "actor_on_item_use", "campfire_placeable.actor_on_item_use", function(orig)
		return function(obj, ...)
			if not C().is_client() then return orig(obj, ...) end
			if not (obj and obj:section() == CAMPFIRE_ITEM) then return end
			local release = rawget(cp, "alife_release")
			cp.alife_release = function(item) item_id = item:id() end
			local ok, e = pcall(orig, obj, ...)
			cp.alife_release = release
			if not ok then error(e, 0) end
		end
	end)
	if use_wrapped then C().swap_callback("actor_on_item_use", use_old, cp.actor_on_item_use) end
	local _, place = C().wrap(cp, "place_campfire", "campfire_placeable.place_campfire", function(orig)
		return function(...)
			if not C().is_client() then return orig(...) end
			if item_id then C().to_host("cf_place", { i = C().hid(item_id) }) end
			item_id = nil
			return true
		end
	end)
	C().on("cf_place", function(t, from)
		local who = C().avatar(from)
		local iid = C().lid(tonumber(t.i))
		local se = type(iid) == "number" and iid < 65535 and alife_object(iid)
		if not (who and se and se:section_name() == CAMPFIRE_ITEM and C().root_of(iid) == who:id()) then
			return refuse("cf_place", from, "no campfire in the player's inventory")
		end
		if spent[iid] then return refuse("cf_place", from, "the item is spent already") end
		local ok, e = C().as_player(who, place) -- the spot is 2 m ahead of that character
		if not ok then return C().report("items", "campfire", e) end
		spent[iid] = true
		alife_release_id(iid)
		st.cf = st.cf + 1
	end, "host")
	C().set_limit("cf_place", 3, 1)
end

-------------------------------------------------------------------------------
-- Deployable gun
-------------------------------------------------------------------------------
local GUN_OBJECT = "deployable_mgun"

local function install_gun()
	C().wrap(C().mod("itms_manager"), "use_deployable_mgun", "itms_manager.use_deployable_mgun", function(orig)
		return function(obj, ...)
			if not C().active() or (ini_sys:section_exist(GUN_OBJECT) and not C().is_client()) then return orig(obj, ...) end
			-- The engine ate the item before this. A client makes no world object, and nobody can make one without its section.
			alife_create_item(obj:section(), db.actor)
			C().hud("st_coop_items_gun_refused", "This machine gun cannot be set up: the item is back in your inventory.")
		end
	end)
end

-------------------------------------------------------------------------------
-- A window on a box
-------------------------------------------------------------------------------
local LESS_ARTYS_DELAY = 1 -- s: a client's box asks for its treasure at the same time, that goes through the world server
local rolled = {} -- boxes a client's window rolled, when the mod's own table is not found

local function on_gui_show(name)
	local gui = name == "UIInventory" and api.search_window and ui_inventory.GUI
	if gui and gui.mode == "loot" then api.search_window(gui.npc_id) end
end

local function on_gui_hide(name)
	if name == "UIInventory" and api.search_window then api.search_window() end
end

local DEATH_BAG = "coop_death_stash" -- what a fallen player left: no treasure, the mods' rolls would add to it or take from it

-- smr_loot's physic_object_on_use_callback for a box the client opened: one roll a box, no roll for a stash or a body.
local function first_roll(smr, box)
	local id = box:id()
	if not IsInvbox(box) or stash_section(id) or box:section() == DEATH_BAG then return false end
	local boxes = C().find_local(smr, "boxes") or rolled
	if boxes[id] then return false end
	boxes[id] = true
	return true
end

local function install_box_rolls()
	RegisterScriptCallback("GUI_on_show", on_gui_show)
	RegisterScriptCallback("GUI_on_hide", on_gui_hide)
	local smr = C().mod("smr_loot")
	C().wrap(smr, "try_spawn", "smr_loot.try_spawn (a client's window)", function(orig)
		return function(box, ...)
			if C().identity_obj() and not first_roll(smr, box) then return end -- coop_mods_misc rolls under as_player
			return orig(box, ...)
		end
	end)
	local less_artys = C().fn(C().mod("zz_treasure_manager_pba_less_artys"), "physic_object_on_use_callback")
	if not less_artys then return end
	C().listen("container_opened", function(_, id)
		CreateTimeEvent("coop_mods_box", "less_artys_" .. id, LESS_ARTYS_DELAY, function()
			local box = level.object_by_id(id)
			local ok, e = pcall(function() return box and box:section() ~= DEATH_BAG and less_artys(box) end)
			if not ok then C().report("items", "less artefacts", e) end
			return true
		end)
	end)
end

-------------------------------------------------------------------------------
-- Disassembly and addon detach of an item in a box or a body (item_parts, utils_item)
-------------------------------------------------------------------------------
-- An item in a box or a dead body is the host's; a client's copy of it is a copy. The stock disassembly released the item
-- (refused on a client), gave the parts to its holder (a world spawn, refused) and cleared its parts table here, so the same
-- gun stood there again with new parts each time; a detach took the addon off the client's copy only (the addon's spawn into
-- the body was refused) and the host kept it on the gun (reports 2026-11-06, also armour of dead enemies and the
-- Autolooter's strip). A client takes such an item first, the ordinary move the host arbitrates for any loot, and then runs
-- the whole call on it as on an item of its own bag, the path that works: the parts and the addon go into its bag (as a
-- field strip's parts do, coop_mods_mags), the tool it holds wears, the release and the creates go through the host. A gun
-- that had its addons taken off goes back where it was (the clone, when a scope variant was swapped). An item that is
-- neither the player's nor in a box or a body (a living NPC's) is left alone and the player is told.
-- The wrappers sit outermost, also over the wrappers addons put in at their first update (3DSS keeps a silencer's condition
-- in its own detach wrapper), so the deferred call runs the whole chain; inner copies of ours see the player's own item and
-- pass it on.
local TK = { mine = {}, jobs = {}, backs = {}, spent = {}, taken = 0, failed = 0, back = 0, refused = 0, outer = 0, no_tool = 0 }
local TAKE_MS = 5000 -- the host answers a move in a round trip; a refusal says nothing to Lua
local BACK_S = 0.5 -- the gun's new state goes out with the next scan of the bag before the move back
local BACK_WAIT_MS = 5000
-- The engine's owner scan (coop_items.cpp scan_local) takes an item that has just come into the bag as the host's state
-- and sends nothing; a change made before that first scan (a detach right at the arrival) would never reach the host and
-- the addon would be on the host's gun and in the bag at once. The calls run once the item has been in the bag longer
-- than the periodic scan (500 ms).
local IN_BAG_MS = 600
local RETURN_MS = 3000 -- the gun given back counts as out of the box until the host has put it there (the Autolooter waits)

local function own(id)
	return type(id) == "number" and id ~= 0 and C().root_of(id) == 0
end

-- The game object is in the actor's own inventory too: the host's move reaches the ALife copy a frame before the game
-- object, and the stock gives the parts to obj:parent().
local function in_bag(obj)
	local ok, p = pcall(function() return obj:parent() end)
	return ok and p ~= nil and p:id() == 0
end

-- The box or dead body that holds the item (not a player's body), or nil.
local function holder_of(obj)
	local ok, p = pcall(function() return obj:parent() end)
	if not (ok and p) or p:id() == 0 then return nil end
	if IsInvbox(p) then return p end
	if (IsStalker(p) or IsMonster(p)) and not p:alive() and not C().is_player(p:id()) then return p end
	return nil
end

-- What a disassembly takes off its tool (GetItemList "disassemble"), 0 if unknown.
local function tool_wear(d)
	local ok, v = pcall(function() return GetItemList("disassemble")[d:section()] end)
	return ok and type(v) == "number" and v or 0
end

-- utils_item.degrade releases a tool whose condition is not above what the use takes off.
local function wears_out(d)
	local ok, c = pcall(function() return d:condition() end)
	local v = tool_wear(d)
	return ok and v > 0 and c <= v
end

-- The tool by id while it is the player's and no deferred disassembly has used it up (its release is on its way to the
-- host, the copy here is still in the bag), or nil. Tools are picked when the player asks; the uses come later.
local function usable_tool(id)
	if type(id) ~= "number" or TK.spent[id] then return nil end
	local d = level.object_by_id(id)
	if d and own(id) and in_bag(d) then return d end
	return nil
end

-- Another suitable tool in the bag (item_parts.get_suitable_dtool, GAMMA's best-tool pick), its id or nil.
local function item_tool(item)
	local ok, d = pcall(function() return item_parts.get_suitable_dtool(item) end)
	return ok and d and d:id() or nil
end

local function take_tip(id, fallback)
	local msg = C().text(id, fallback)
	if db.actor and news_manager and news_manager.send_tip then
		pcall(news_manager.send_tip, db.actor, msg, nil, "swiss_knife", 6000)
	end
end

-- The detached gun (or the clone that replaced it) goes back to the box or body once the host made it.
local function give_back(ids, cid)
	local key = "back_" .. tostring(ids[1])
	local deadline = time_global() + BACK_WAIT_MS
	TK.backs[key] = cid
	local sent_id, sent_at = nil, nil
	CreateTimeEvent("coop_mods_take", key, BACK_S, function()
		local function done() TK.backs[key] = nil return true end
		if sent_id then -- asked: busy until the host has put it back (or it went elsewhere)
			if C().root_of(sent_id) == cid or not alife_object(sent_id) or time_global() - sent_at > RETURN_MS then return done() end
			ResetTimeEvent("coop_mods_take", key, 0.25)
			return false
		end
		local cont = level.object_by_id(cid)
		if not (cont and db.actor) then return done() end -- the body is gone: the gun stays in the bag
		for _, wid in ipairs(ids) do
			local w = type(wid) == "number" and level.object_by_id(wid)
			if w and own(wid) and in_bag(w) then
				local lw = api and api.lease_waiting
				local ok, waiting = pcall(function() return lw and lw(wid) end)
				if ok and waiting == true and time_global() < deadline then -- the host has not made the clone yet
					ResetTimeEvent("coop_mods_take", key, 0.25)
					return false
				end
				db.actor:transfer_item(w, cont)
				TK.back = TK.back + 1
				sent_id, sent_at = wid, time_global()
				ResetTimeEvent("coop_mods_take", key, 0.25)
				return false
			end
		end
		return done()
	end)
end

-- Runs the item's queued calls once it is in the own bag; gives up after TAKE_MS.
local function take_wait(id)
	local deadline = time_global() + TAKE_MS
	CreateTimeEvent("coop_mods_take", "take_" .. id, 0.1, function()
		local job = TK.jobs[id]
		if not job then return true end
		local obj = level.object_by_id(id)
		if obj and own(id) and in_bag(obj) then
			local now = time_global()
			job.in_bag = job.in_bag or now
			if now - job.in_bag < IN_BAG_MS then -- the owner scan has not seen it yet
				ResetTimeEvent("coop_mods_take", "take_" .. id, 0.1)
				return false
			end
			TK.jobs[id] = nil
			TK.taken = TK.taken + 1
			local back = { id }
			for _, f in ipairs(job.calls) do
				local cur = level.object_by_id(back[1])
				if not cur then break end
				local ok, e, clone = pcall(f, cur, job)
				if not ok then
					C().report("items", "take first " .. job.what, e)
					break
				end
				if clone then table.insert(back, 1, clone) end
			end
			if job.back and not job.final then give_back(back, job.cid) end -- a gun taken apart is not given back
			return true
		end
		job.in_bag = nil
		if not obj or time_global() > deadline then
			TK.jobs[id] = nil
			TK.failed = TK.failed + 1
			log("take first: %s %s was not taken (refused or gone)", job.what, tostring(id))
			if obj then take_tip("st_coop_mods_take_failed", "Co-op: could not take the item from the body or the box.") end
			return true
		end
		ResetTimeEvent("coop_mods_take", "take_" .. id, 0.1)
		return false
	end)
end

-- Client: `call(obj)` runs now on an own item, after the take on an item of a box or a body; nothing else is touched.
-- Returns the call's results when it ran now. `final`: the call ends the item (disassembly), nothing is queued after it.
local function take_first(what, obj, back, call, final)
	local id = obj:id()
	if own(id) then return call(obj) end
	local job = TK.jobs[id]
	if job then -- asked for already (the Autolooter strips two addons in one go): runs with it
		-- after a disassembly nothing: the Autolooter strips the guns it has just taken apart (in single player they are gone)
		if job.final then return end
		job.calls[#job.calls + 1] = call
		job.final = final
		job.back = job.back or back
		return
	end
	local cont = holder_of(obj)
	if not cont then
		TK.refused = TK.refused + 1
		take_tip("st_coop_mods_take_none", "Co-op: only an item in your bag, a box or a body can be taken apart or stripped here.")
		return
	end
	TK.jobs[id] = { what = what, cid = cont:id(), calls = { call }, back = back, final = final }
	cont:transfer_item(obj, db.actor)
	take_wait(id)
end

-- coop_mods_guard: a scope variant's detach of a gun in a box or a body goes through take first (the guard checks the
-- swap again on the taken gun, inside the deferred call). True when this file takes that item first.
function takes_first(obj)
	return TK.mine["utils_item.detach_addon"] ~= nil and C().is_client() and obj ~= nil and not own(obj:id())
		and holder_of(obj) ~= nil
end

-- coop_mods_mags: a field strip of a gun that is being taken joins its calls (the host would refuse the strip of a gun
-- in the player's bag). `call(gun)` runs on the taken gun. True when it joined (or the gun is taken apart: dropped).
function take_join(id, call)
	local job = type(id) == "number" and TK.jobs[id]
	if not job then return false end
	if not job.final then job.calls[#job.calls + 1] = call end
	return true
end

take_busy = function(cid)
	for _, job in pairs(TK.jobs) do if job.cid == cid then return true end end
	for _, c in pairs(TK.backs) do if c == cid then return true end end
	return false
end

local function on_client(obj)
	return C().is_client() and db.actor ~= nil and obj ~= nil and type(obj) ~= "number" and obj.id ~= nil
end

local function disassembly_wrapper(what)
	return function(orig)
		return function(obj, obj_d, ...)
			if not on_client(obj) or own(obj:id()) then return orig(obj, obj_d, ...) end
			local tool = obj_d and obj_d:id()
			local n, extra = select("#", ...), { ... }
			return take_first(what, obj, false, function(item, job)
				local d = tool and usable_tool(tool)
				if tool and not d then d = usable_tool(item_tool(item)) end -- worn out or gone meanwhile: the next one
				if tool and not d then
					TK.no_tool = TK.no_tool + 1
					give_back({ item:id() }, job.cid)
					take_tip("st_news_dis_items", "You need a tool to take this apart.")
					return
				end
				if d and wears_out(d) then TK.spent[d:id()] = true end -- released by this use (utils_item.degrade)
				orig(item, d, unpack(extra, 1, n))
			end, true)
		end
	end
end

-- Native detach keeps the addon mounted until the host creates the loose item.
-- The original 3DSS wrapper returns before that answer, so its delayed condition
-- search cannot run. Carry its condition in the native transaction instead.
function native_silencer_state(weapon, committed)
	if committed then
		se_save_var(weapon:id(), nil, "3dss_silencer_condition", nil)
		return 1
	end
	local mod = C().mod("z_3dss_silencer_condition")
	if mod and type(mod.get_attached_silencer_condition) == "function" then
		return mod.get_attached_silencer_condition(weapon) or 1
	end
	return 1
end

local function detach_wrapper(orig)
	return function(wpn, addon, typ, ignore, ...)
		if not on_client(wpn) or own(wpn:id()) then return orig(wpn, addon, typ, ignore, ...) end
		local n, extra = select("#", ...), { ... }
		return take_first("detach", wpn, true, function(gun)
			-- a scope variant is swapped for a clone (item_weapon.detach_scope): that one goes back
			local clone, g = nil, rawget(_G, "alife_clone_weapon")
			local spy = nil
			if type(g) == "function" then
				spy = function(...)
					local se = g(...)
					if se ~= nil and clone == nil then pcall(function() clone = se.id end) end
					return se
				end
				_G.alife_clone_weapon = spy
			end
			local ok, e = pcall(orig, gun, addon, typ, ignore, unpack(extra, 1, n))
			if spy and rawget(_G, "alife_clone_weapon") == spy then _G.alife_clone_weapon = g end
			if not ok then error(e, 0) end
			return nil, clone
		end)
	end
end

local TAKE_HOOKS = {
	{ mod = "item_parts", key = "disassembly_weapon", make = disassembly_wrapper("disassembly") },
	{ mod = "item_parts", key = "disassembly_outfit", make = disassembly_wrapper("disassembly") },
	{ mod = "item_parts", key = "disassembly_item", make = disassembly_wrapper("disassembly") },
	{ mod = "utils_item", key = "detach_addon", make = detach_wrapper },
}

-- Puts each wrapper outermost again when an addon wrapped the function after it.
local function take_outer()
	for _, h in ipairs(TAKE_HOOKS) do
		local tbl = C().mod(h.mod)
		local cur = C().fn(tbl, h.key)
		if cur and cur ~= TK.mine[h.mod .. "." .. h.key] then
			local done, _ = C().wrap(tbl, h.key, h.mod .. "." .. h.key, h.make)
			if done then
				TK.mine[h.mod .. "." .. h.key] = tbl[h.key]
				TK.outer = TK.outer + 1
			end
		end
	end
end

local function install_take()
	if not (C().fn(C().mod("item_parts"), "disassembly_weapon") or C().fn(C().mod("utils_item"), "detach_addon")) then return end
	installed[#installed + 1] = "take first"
	take_outer()
	-- Addons wrap these at their first update too (3DSS): after every first update, and once more a moment later.
	RegisterScriptCallback("actor_on_first_update", function()
		CreateTimeEvent("coop_mods_take", "outer", 0, function() take_outer() return true end)
		CreateTimeEvent("coop_mods_take", "outer_late", 3, function() take_outer() return true end)
	end)
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
local first_done = false
local function actor_on_update()
	if C().is_host() then
		for id in pairs(spent) do if not alife_object(id) then spent[id] = nil end end
		host_md_clean()
	elseif not first_done and C().is_client() and GS.mod then
		-- The save's lamp table describes the host's lamps; a client never burns or picks them up itself.
		first_done = true
		local ok, e = pcall(gs_clear_local_table)
		if not ok then C().report("items", "glowstick table", e) end
	end
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included (W5).
local function start_step(what, f)
	local ok, err = pcall(f)
	if not ok then printf("! [coop_mods_items] %s failed: %s", what, tostring(err)) end
end

function on_game_start()
	if not api then return end
	start_step("install_glowsticks", install_glowsticks)
	start_step("install_model_dropper", install_model_dropper)
	start_step("install_autolooter", install_autolooter)
	start_step("install_gso", install_gso)
	start_step("install_corpse_loot", install_corpse_loot)
	start_step("install_stash", install_stash)
	start_step("install_campfire", install_campfire)
	start_step("install_gun", install_gun)
	start_step("install_box_rolls", install_box_rolls)
	start_step("install_take", install_take)
	if #installed == 0 then return end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("load_state", function() spent = {} end)
	C().status_line("items", function()
		return string.format("%s | glowsticks thrown %d picked %d | drops %d cleaned %d | autoloot deletes %d | corpse stashes %d | stashes %d freed %d | campfires %d | refused %d | taken first %d (not taken %d, given back %d, not a box %d, wrapped %d)",
			table.concat(installed, ", "), st.gs_throw, st.gs_pick, st.md, st.md_clean, st.al, st.gso, st.stash, st.stash_freed, st.cf, st.refused,
			TK.taken, TK.failed, TK.back, TK.refused, TK.outer) .. string.format(", no tool %d", TK.no_tool)
	end)
end
