--[[
	Anomaly Coop - giving items and money to other players (gamedata\scripts\coop_economy_money.script)
	SPEC R-6.7: every player has his own money; money and items can be passed between players.

	Items: the inventory context menu (ui_inventory) gets "Give to <player>" for every player whose character
	stands within give_radius. The action is the engine's own transfer to that character
	(db.actor:transfer_item); on a client it becomes one ownership request that the host checks and applies
	(coop_requests: never out of another player's pockets, within reach). Right after it the giver sends
	economy.gift { i = host id of the item } to the receiver, so that the receiver can be told "<nick> gave you: <item>."
	The receiver keeps the gift pending and tells it only once the item is in his own inventory (the host may refuse
	the transfer; event and item come in either order); see "Items given to this player" below.
	An item of more than one unit (rounds of ammo, a stack of items) goes through coop_economy_give instead: the amount
	window, whole boxes / items as above with u = units in economy.gift, and a split box made by the host, which then
	tells the receiver itself (economy.gift { i, u, g = giver } from 0). Units of one name add up: "<nick> gave you: X x45."

	Money: "Give money to <player>" opens a choice of amounts. The transfer itself is the engine's (F2 T1, the host
	ledger): coop.money_give(peer, amount) takes the money from the giver at once, on a client as a pending change,
	and the host checks it and credits the receiver, or gives it back with its next balance when it refuses. The
	receiver must be a player who has joined (and the host itself): the engine refuses one who is still loading or has
	left ("no such player"). This script checks the session rules (money_transfer, max_money_transfer) on the
	giver's machine and tells the player what happened. Nothing of money goes over our own events any more.

	F2 T6b (Ruling F2-19): the host enforces the rules itself. Its Lua pushes them into the ledger with
	coop.money_set_rules(enabled, max) (every 2 s and at once when an option changes), and the ledger refuses a transfer
	against them whatever the client's Lua did. The host's answer comes back to the player as a note, which the engine
	hands to the callback coop_money_note on the machine of that player:
		("received", giver_peer, amount)                         somebody gave you money ("X gave you N")
		("refused", receiver_peer | -1, change, why, cause)      the host did not take your change (a transfer to
		                                                         receiver_peer, an income > 0 or a payment < 0 of your own)
	why is the engine's English name of the verdict, cause is "script" | "dialog" | "transfer".
	Gifts are told in one line per 3 s ("X gave you N (x37)"), so that nobody can fill another player's news with them;
	the host also holds each character to a rate of transfers (coop_money.ltx transfer_burst, transfer_per_min).

	For other scripts:
		coop_economy_money.give_money(peer, amount) -> true when the engine accepted the transfer
--]]

local core = coop_economy_core

local tostring, type, ipairs, pairs, next, pcall = tostring, type, ipairs, pairs, next, pcall
local math_floor, math_huge, math_abs = math.floor, math.huge, math.abs
local table_concat = table.concat

local MAX_SLOTS = 8
local AMOUNTS = { 100, 500, 1000, 5000, 10000, 50000 }

local stats = { sent = 0, refused = 0, items_given = 0, host_refused = 0, gifts_got = 0, gift_lines = 0, gifts_lost = 0,
	gifts_bad = 0 }

local function money_text(amount)
	return tostring(amount) .. " " .. core.tr("st_coop_eco_currency", "RU")
end

-- coop.money_give names a refusal in English; the player gets it in his language.
local WHY_ID = {
	["not enough money"] = "poor",
	["over the maximum"] = "full", -- the receiver would go over the maximum
	["no such player"] = "gone", -- the receiver has not joined or has left
	["no character"] = "nochar", -- the GIVER has no character (the engine says nothing else about the receiver)
	["not in the world"] = "world", -- the giver is a client that has not entered the host's world yet
	["over the allowance"] = "allowance", -- F2 T6b: an income above what the host lets a player make by himself
	["transfers are off"] = "off", -- F2 T6b: money_transfer is off on the host
	["over the transfer limit"] = "limit", -- F2 T6b: above max_money_transfer of the host
	["too many transfers"] = "rate", -- T6b review I1: the host's rate bucket of transfers is empty
}

local function refusal_text(why)
	local id = WHY_ID[why] or "bad"
	return core.tr("st_coop_eco_money_why_" .. id, tostring(why))
end

-- The reason of a refusal the HOST told (F2 T6b). A verdict means something else by cause: "over the maximum" is the
-- receiver's purse for a transfer and the player's own for an income; "malformed" for a transfer is a receiver who left.
local function note_reason(why, cause)
	if why == "over the maximum" and cause ~= "transfer" then
		return core.tr("st_coop_eco_money_why_cap", "the host's money limit was reached")
	end
	if why == "malformed" and cause == "transfer" then
		return core.tr("st_coop_eco_money_why_gone", "the receiver is not in the game")
	end
	return refusal_text(why)
end

-------------------------------------------------------------------------------
-- Giver (any machine): the engine's host ledger does the rest
-------------------------------------------------------------------------------
function give_money(peer, amount)
	if not (core.live() and db.actor) then return false end
	if not core.rule("money_transfer") then
		core.tip(core.tr("st_coop_eco_money_off", "Money transfers are off in this session."))
		return false
	end
	local n = core.num(amount) -- NaN and infinity are no amounts
	amount = n and math_floor(n) or 0
	local have = db.actor:money()
	if amount > have then amount = have end
	local max = core.rule("max_money_transfer") or 1000000
	if amount > max then amount = max end
	if amount < 1 then
		core.tip(core.tr("st_coop_eco_money_none", "You have no money to give."))
		return false
	end
	local p = core.player(peer)
	if not p or p.is_self then
		core.tip(core.tr("st_coop_eco_money_no_target", "That player is not here."))
		return false
	end
	local api = core.engine()
	if not (api and type(api.money_give) == "function") then
		core.log("! coop.money_give is missing: the money was not given")
		return false
	end
	local ok, why = api.money_give(peer, amount)
	if not ok then
		stats.refused = stats.refused + 1
		core.log("money: %s", tostring(why))
		core.tip(core.fmt("st_coop_eco_money_refused", "Transfer refused: %s.", refusal_text(why)))
		return false
	end
	stats.sent = stats.sent + 1
	core.log("money: gave %d to %s", amount, p.nick)
	core.tip(core.fmt("st_coop_eco_money_out", "You gave %s to %s.", money_text(amount), p.nick))
	return true
end

-------------------------------------------------------------------------------
-- The host's rules into the ledger (F2 T6b)
-------------------------------------------------------------------------------
local RULES_EVERY_MS = 2000
local MAX_TRANSFER = 4294967295 -- the most coop.money_set_rules takes
local rules = { next_at = 0, missing_logged = false }

-- F3a task 6 (docs/plans/2026-10-24-f3a-split-levels.md 1.1, 1.2): the ledger belongs to the world server, so the rules go
-- into it from there. What a player does with money - give_money, the notes about gifts and refusals - is the same for the
-- host player and a remote client (the host player's coop.money_give goes to the world server over the internal channel and
-- is answered by a coop_money_note like any client's), so none of it asks "am I the host". A build without
-- coop.is_world_server() has the old name.
local function is_world_server()
	local api = core.engine()
	if not (api and core.in_session()) then return false end
	local f = type(api.is_world_server) == "function" and api.is_world_server or api.is_host
	local ok, yes = pcall(f)
	return ok and yes == true
end

-- World server: money_transfer and max_money_transfer as this host's options have them, pushed into the ledger. The ledger
-- keeps them for the process, but a new session or a new world may be a stranger to them: they are said again every 2 s.
local function push_rules()
	if not is_world_server() then return end
	local api = core.engine()
	if not (api and type(api.money_set_rules) == "function") then
		if not rules.missing_logged then
			rules.missing_logged = true
			core.log("! coop.money_set_rules is missing: the host cannot hold transfers to the session rules")
		end
		return
	end
	local on = core.rule("money_transfer") ~= false
	local max = core.rule("max_money_transfer")
	if max == math_huge then
		max = MAX_TRANSFER
	else
		max = core.num(max) or 1000000 -- NaN, text: the default
	end
	if max > MAX_TRANSFER then max = MAX_TRANSFER end
	if max < 0 then max = 0 end
	local called, ok, why = pcall(api.money_set_rules, on, math_floor(max))
	if not (called and ok) then core.log("! money rules not pushed: %s", tostring(called and why or ok)) end
end

local flush_gifts, items_pending, update_items -- below

local function actor_on_update()
	local t = core.now()
	flush_gifts(t)
	if items_pending() then
		local ok, err = pcall(update_items, t)
		if not ok then core.log("! gifts update: %s", tostring(err)) end
	end
	if t < rules.next_at then return end
	rules.next_at = t + RULES_EVERY_MS
	push_rules()
end

local function on_option_change()
	rules.next_at = 0 -- the next update says it
end

-------------------------------------------------------------------------------
-- What the host did with the player's money (coop_money_note, from the engine)
-------------------------------------------------------------------------------
local function who_text(peer)
	local p = type(peer) == "number" and peer >= 0 and core.player(peer) or nil
	return p and p.nick or core.tr("st_coop_eco_money_somebody", "another player")
end

-- Gifts (T6b review I1): a modified client can give 1 RU again and again, and every gift would be a news item, a log line
-- and a lookup of the players. The first gift after a quiet time is told at once; the ones that follow within GIFT_GAP_MS
-- are collected (by giver) and told as one line: the giver, the sum and the number of gifts.
local GIFT_GAP_MS = 3000
local gifts = { next_at = 0, by_peer = {}, count = 0, sum = 0, givers = 0 }

local function show_gifts()
	local g = gifts
	local count, sum, givers, only = g.count, g.sum, g.givers, nil
	if givers == 1 then only = next(g.by_peer) end
	gifts.by_peer, gifts.count, gifts.sum, gifts.givers = {}, 0, 0, 0
	if count < 1 then return end
	core.log("money: %d RU in %d gift(s) from %s", sum, count, only and who_text(only) or "several players")
	if givers > 1 then
		core.tip(core.fmt("st_coop_eco_money_in_many", "Players gave you %s (x%d).", money_text(sum), count))
	elseif count > 1 then
		core.tip(core.fmt("st_coop_eco_money_in_n", "%s gave you %s (x%d).", who_text(only), money_text(sum), count))
	else
		core.tip(core.fmt("st_coop_eco_money_in", "%s gave you %s.", who_text(only), money_text(sum)))
	end
end

-- Tells what has been collected once the gap since the last line is over.
function flush_gifts(t)
	if gifts.count > 0 and t >= gifts.next_at then
		gifts.next_at = t + GIFT_GAP_MS
		show_gifts()
	end
end

local function add_gift(peer, n)
	local key = (type(peer) == "number" and peer >= 0) and peer or -1
	if not gifts.by_peer[key] then
		gifts.by_peer[key] = true
		gifts.givers = gifts.givers + 1
	end
	gifts.count, gifts.sum = gifts.count + 1, gifts.sum + n
	flush_gifts(core.now())
end

local function on_money_note_body(kind, peer, amount, why, cause)
	local n = core.num(amount)
	if n == nil then return end
	n = math_floor(n)
	if kind == "received" then
		if n < 1 then return end
		add_gift(peer, n)
	elseif kind == "refused" then
		if n == 0 then return end
		stats.host_refused = stats.host_refused + 1
		local reason = note_reason(why, cause)
		core.log("money: the host refused %d (%s, %s)", n, tostring(cause), tostring(why))
		if cause == "transfer" then
			if type(peer) == "number" and peer >= 0 and core.player(peer) then
				core.tip(core.fmt("st_coop_eco_money_refused_to", "Transfer of %s to %s refused: %s.", money_text(math_abs(n)),
					who_text(peer), reason))
			else
				-- the receiver is gone: no name to put in (T6b review M7)
				core.tip(core.fmt("st_coop_eco_money_refused_amount", "Transfer of %s refused: %s.", money_text(math_abs(n)), reason))
			end
		elseif n > 0 then
			core.tip(core.fmt("st_coop_eco_money_host_gain", "The host did not credit %s: %s.", money_text(n), reason))
		else
			core.tip(core.fmt("st_coop_eco_money_host_spend", "The host did not accept the payment of %s: %s.",
				money_text(math_abs(n)), reason))
		end
	end
end

-- The engine calls this through SendScriptCallback: whatever it passes, nothing may throw.
local function on_money_note(kind, peer, amount, why, cause)
	local ok, err = pcall(on_money_note_body, kind, peer, amount, why, cause)
	if not ok then core.log("! coop_money_note: %s", tostring(err)) end
end

-------------------------------------------------------------------------------
-- Items given to this player: "<nick> gave you: <items>."
-------------------------------------------------------------------------------
-- The giver's menu action sends economy.gift { i = host id of the item } to the receiver; the host relays a client's
-- event with the true sender as `from`, and an event to 0 is the host player's. The host may refuse the transfer, and
-- the event and the item come in either order: the gift waits here and is told only once the item is in this actor's
-- own inventory, looked at when the event comes, in actor_on_item_take and at updates. The name is this machine's own
-- of that item, never the packet's. A gift whose item does not come within GIFT_WAIT_MS (refused) is dropped without a
-- word. Items of one giver that come within ITEM_LINE_MS are one line, and that is also the most a giver gets: one line
-- per ITEM_LINE_MS, so that another client cannot fill this player's news with gifts.
local GIFT_WAIT_MS = 15000
local MAX_WAITING = 32 -- gifts waiting for their item; a new one pushes the oldest out
local ITEM_LINE_MS = 1500
local ITEM_NAMES = 3 -- names in a line, the rest are counted ("A, B, C and 2 more")
local ITEM_CHECK_MS = 250
local MAX_ID = 65534

local waiting = {} -- local item id -> { from = giver peer, nick, at = ms, seq, u = units or nil }
local items = { n = 0, seq = 0, check_at = 0, lines = {} } -- lines: giver peer -> { nick, at, names = {}, units = {}, more }

function items_pending()
	return items.n > 0 or next(items.lines) ~= nil
end

-- The game object of item `id` when it is in this actor's inventory, else nil. Id 0 is the actor himself.
local function own_item(id)
	if id == 0 or not (db and db.actor) then return nil end
	local obj = level.object_by_id(id)
	if not obj or core.root_of(id) ~= 0 then return nil end
	return obj
end

local function item_name(obj)
	local sec = obj:section()
	local ok, name = pcall(function() return ui_item.get_sec_name(sec) end)
	if ok and type(name) == "string" and name ~= "" then return name end
	return tostring(sec)
end

local function forget(id)
	if waiting[id] then
		waiting[id] = nil
		items.n = items.n - 1
	end
end

-- The item of gift `g` is here: into the line of its giver (a new line starts its ITEM_LINE_MS now).
local function arrived(id, g, obj, t)
	forget(id)
	local line = items.lines[g.from]
	if not line then
		line = { nick = g.nick, at = t, names = {}, units = {}, more = 0 }
		items.lines[g.from] = line
	end
	local name = item_name(obj)
	-- Gifts counted in units (an amount from coop_economy_give: rounds, items of a stack) of one name add up: "Bandage x3".
	if g.u then
		for i, n in ipairs(line.names) do
			if n == name and line.units[i] then
				line.units[i] = line.units[i] + g.u
				stats.gifts_got = stats.gifts_got + 1
				return
			end
		end
	end
	if #line.names < ITEM_NAMES then
		line.names[#line.names + 1] = name
		line.units[#line.names] = g.u
	else
		line.more = line.more + 1
	end
	stats.gifts_got = stats.gifts_got + 1
end

-- The same item again only renews its entry (giver, time, units).
local function wait_for(id, from, nick, t, u)
	local g = waiting[id]
	if not g then
		if items.n >= MAX_WAITING then
			local oldest, seq = nil, nil
			for k, v in pairs(waiting) do
				if seq == nil or v.seq < seq then oldest, seq = k, v.seq end
			end
			if oldest ~= nil then
				forget(oldest)
				stats.gifts_lost = stats.gifts_lost + 1
			end
		end
		g = {}
		waiting[id] = g
		items.n = items.n + 1
	end
	items.seq = items.seq + 1
	g.from, g.nick, g.at, g.seq, g.u = from, nick, t, items.seq, u
end

local function tell_items(line)
	local count = #line.names + line.more
	if count < 1 then return end
	local shown = {}
	for i, name in ipairs(line.names) do
		local u = line.units and line.units[i]
		shown[i] = (u and u > 1) and core.fmt("st_coop_eco_item_count", "%s x%d", name, u) or name
	end
	local list = table_concat(shown, ", ")
	if line.more > 0 then list = core.fmt("st_coop_eco_item_in_more", "%s and %d more", list, line.more) end
	stats.gift_lines = stats.gift_lines + 1
	core.log("gift: %d item(s) from %s", count, tostring(line.nick))
	core.tip(core.fmt("st_coop_eco_item_in", "%s gave you: %s.", tostring(line.nick), list))
end

-- Item `id` (local) given by player `giver` is coming (or is here): told once it is in this actor's inventory. units: an
-- amount (rounds, items of a stack) or nil.
local function expect(id, giver, units)
	local p = core.player(giver)
	if not (p and not p.is_self) then
		stats.gifts_bad = stats.gifts_bad + 1
		return
	end
	local now = core.now()
	local obj = own_item(id)
	if obj then
		arrived(id, { from = giver, nick = p.nick, u = units }, obj, now) -- the item came first
	else
		wait_for(id, giver, p.nick, now, units)
	end
end

-- economy.gift { i = host id of the item, u = units } from the giver (coop_main runs it inside pcall). From the host
-- (from = 0) it may name the giver: g, a box of rounds the host made for this player out of the giver's (coop_economy_give).
local function on_gift(t, from)
	if not (core.live() and db and db.actor) or type(t) ~= "table" then return end
	if type(from) ~= "number" or from < 0 or from == core.self_id() then return end
	local hid = core.int(t.i, 1, MAX_ID)
	local id = hid and core.int(core.local_id(hid), 1, MAX_ID)
	local giver = from
	if from == 0 and t.g ~= nil then giver = core.int(t.g, 0, 255) end
	if not id or giver == nil or giver == core.self_id() then
		stats.gifts_bad = stats.gifts_bad + 1
		return
	end
	expect(id, giver, core.int(t.u, 1, 65535))
end

-- coop_economy_give on the host player's own machine: a box the host made for him (local id; nothing went over the net).
function expect_gift(id, giver, units)
	if not (core.live() and db and db.actor) then return end
	id = core.int(id, 1, MAX_ID)
	if not id or type(giver) ~= "number" or giver == core.self_id() then return end
	expect(id, giver, core.int(units, 1, 65535))
end

-- The engine calls this through SendScriptCallback: nothing may throw.
local function on_item_take(obj)
	if items.n == 0 or obj == nil then return end
	local ok, err = pcall(function()
		local id = obj:id()
		local g = waiting[id]
		local mine = g and own_item(id)
		if mine then arrived(id, g, mine, core.now()) end
	end)
	if not ok then core.log("! gift take: %s", tostring(err)) end
end

function update_items(t)
	if not core.live() then -- the session is over: nothing to tell any more
		waiting, items.n, items.lines = {}, 0, {}
		return
	end
	if items.n > 0 and t >= items.check_at then
		items.check_at = t + ITEM_CHECK_MS
		for id, g in pairs(waiting) do
			if t - g.at > GIFT_WAIT_MS then
				forget(id) -- refused: the item never came
				stats.gifts_lost = stats.gifts_lost + 1
			else
				local obj = own_item(id)
				if obj then arrived(id, g, obj, t) end
			end
		end
	end
	for from, line in pairs(items.lines) do
		if t - line.at >= ITEM_LINE_MS then
			items.lines[from] = nil
			tell_items(line)
		end
	end
end

-------------------------------------------------------------------------------
-- Inventory menu (ui_inventory.UIInventory)
-------------------------------------------------------------------------------
local slots = {} -- index -> { peer, nick, avatar_id } (players near enough for an item)
local money_slots = {} -- index -> { peer, nick }

local function refresh_slots()
	slots, money_slots = {}, {}
	if not (core.live() and db.actor) then return end
	local me = core.position_of_id(0)
	local radius = core.rule("give_radius") or 5
	for _, p in ipairs(core.players()) do
		if not p.is_self then
			if #money_slots < MAX_SLOTS then money_slots[#money_slots + 1] = { peer = p.id, nick = p.nick } end
			if #slots < MAX_SLOTS and p.obj and p.pos and me and core.dist(me, p.pos) <= radius then
				slots[#slots + 1] = { peer = p.id, nick = p.nick, avatar_id = p.avatar_id }
			end
		end
	end
end

local function patch_inventory()
	local inv = core.mod("ui_inventory")
	local cls = inv and inv.UIInventory
	if not (cls and type(cls.InitProperties) == "function") then return end

	function cls:coop_eco_CondGive(obj, bag, fname, i)
		return slots[i] ~= nil
	end
	function cls:coop_eco_NameGive(id, bag, fname, i)
		local s = slots[i]
		return s and core.fmt("st_coop_eco_give_to", "Give to %s", s.nick) or ""
	end
	function cls:coop_eco_ActionGive(id, bag, fname, i)
		local s = slots[i]
		if not (s and type(id) == "number" and id > 0 and id < 65535) then return end
		local item = level.object_by_id(id)
		local who = level.object_by_id(s.avatar_id)
		if not (item and who) then
			core.tip(core.tr("st_coop_eco_money_no_target", "That player is not here."))
			return
		end
		local p = item:parent()
		if not (p and p:id() == 0) then return end
		-- More than one unit (rounds of ammo, a stack of items): the amount window of coop_economy_give gives them.
		local give = core.mod("coop_economy_give")
		if give and type(give.offer) == "function" then
			local ok, taken = pcall(give.offer, self, id, bag, s)
			if ok and taken then return end
			if not ok then core.log("! give offer: %s", tostring(taken)) end
		end
		local name = item:section()
		pcall(function() name = ui_item.get_sec_name(item:section()) or name end)
		db.actor:transfer_item(item, who) -- a client: one ownership request, the host decides (coop_requests)
		stats.items_given = stats.items_given + 1
		-- the receiver is told once the item is his (on_gift); a failed send costs only that line
		if core.live() and type(s.peer) == "number" and s.peer >= 0 and s.peer ~= core.self_id() then
			local sent, err = pcall(core.send, "gift", { i = core.host_id(id) }, s.peer)
			if not sent then core.log("! economy.gift not sent: %s", tostring(err)) end
		end
		core.tip(core.fmt("st_coop_eco_item_given", "%s given to %s.", tostring(name), s.nick))
	end
	function cls:coop_eco_CondMoney(obj, bag, fname, i)
		return money_slots[i] ~= nil and core.rule("money_transfer") ~= false
	end
	function cls:coop_eco_NameMoney(id, bag, fname, i)
		local s = money_slots[i]
		return s and core.fmt("st_coop_eco_give_money_to", "Give money to %s...", s.nick) or ""
	end
	function cls:coop_eco_ActionMoney(id, bag, fname, i)
		local s = money_slots[i]
		if not s then return end
		-- The menu closes itself after this action: open the amount list on the next update.
		local ui = self
		CreateTimeEvent("coop_economy_money", "amounts", 0, function()
			local actions, names, params = {}, {}, {}
			local have = db.actor and db.actor:money() or 0
			for _, a in ipairs(AMOUNTS) do
				if a <= have then
					actions[#actions + 1] = "coop_eco_GiveAmount"
					names[#names + 1] = money_text(a)
					params[#params + 1] = { s.peer, a }
				end
			end
			if have > 0 then
				actions[#actions + 1] = "coop_eco_GiveAmount"
				names[#names + 1] = core.fmt("st_coop_eco_money_all", "All (%s)", money_text(have))
				params[#params + 1] = { s.peer, have }
			end
			if #names == 0 then
				core.tip(core.tr("st_coop_eco_money_none", "You have no money to give."))
			else
				pcall(function() ui.item_props:Reset(GetCursorPosition(), actions, names, params) end)
			end
			return true
		end)
	end
	function cls:coop_eco_GiveAmount(peer, amount)
		if give_money(peer, amount) then pcall(function() self:UpdateCharacter() end) end
	end

	local orig_init = cls.InitProperties
	function cls:InitProperties(obj, bag, ...)
		if core.live() then
			refresh_slots()
			if not self.coop_eco_props and type(self.properties) == "table" then
				self.coop_eco_props = true
				for i = 1, MAX_SLOTS do
					self.properties["coop_eco_give_" .. i] = {
						index = 40 + i, name_func = { "coop_eco_NameGive", i }, mode = { inventory = true },
						cont = { actor_bag = true, actor_equ = true, actor_belt = true },
						precondition1 = { "coop_eco_CondGive", i }, action = { "coop_eco_ActionGive", i },
					}
					self.properties["coop_eco_money_" .. i] = {
						index = 50 + i, name_func = { "coop_eco_NameMoney", i }, mode = { inventory = true },
						cont = { actor_bag = true, actor_equ = true, actor_belt = true },
						precondition1 = { "coop_eco_CondMoney", i }, action = { "coop_eco_ActionMoney", i },
					}
				end
			end
		else
			slots, money_slots = {}, {}
		end
		return orig_init(self, obj, bag, ...)
	end
end

-------------------------------------------------------------------------------
-- Status, start
-------------------------------------------------------------------------------
function print_status()
	core.log("money: transfers %d, refused %d (by the host %d) | items given %d | gifts got %d in %d line(s), waiting %d,"
		.. " lost %d, bad %d", stats.sent, stats.refused, stats.host_refused, stats.items_given, stats.gifts_got,
		stats.gift_lines, items.n, stats.gifts_lost, stats.gifts_bad)
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included (W5).
local function start_step(what, f)
	local ok, err = pcall(f)
	if not ok then printf("! [coop_economy_money] %s failed: %s", what, tostring(err)) end
end

local hooked = false
local function hook_engine()
	if hooked then return end
	hooked = true
	AddScriptCallback("coop_money_note") -- fired by the engine on the machine of the player it is about (coop_money.cpp)
	RegisterScriptCallback("coop_money_note", on_money_note)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_item_take", on_item_take)
	core.on("gift", on_gift)
	RegisterScriptCallback("on_option_change", on_option_change)
end

function on_game_start()
	if not core.engine() then return end
	start_step("patch_inventory", patch_inventory)
	start_step("hook_engine", hook_engine)
end
