--[[
	Anomaly Coop - message windows that work in the main menu and in game (R-1.3, R-1.4)
	gamedata\scripts\coop_ui.script, layout configs\ui\ui_coop_diff.xml

	Called by the engine (coop_script.cpp, once a dialog can be opened):
		coop_ui.on_rejected(info)   the host refused this player
			info = { reason, code, text, missing, extra, differ, missing_total, extra_total, differ_total,
			         key_path, log_path }
			missing/extra/differ: first files of each list (the engine log has all of them)
	For other scripts:
		coop_ui.show(title, summary, lines, footer)   lines: { "text" | { text = "...", color = <argb> }, ... }

	Uses only engine classes and functions, nothing from a running level: the main menu has no actor.
	Texts: configs\text\*\st_coop_menu.xml (st_coop_ui_*), the English text here when an id is missing.

	In game (W8): an envelope button right of the player's money in the inventory (configs\ui\ui_coop_inventory.xml,
	wraps ui_inventory.UIInventory:UpdateCharacter) - give money to another player via coop_economy_money.
--]]

local MAX_PER_GROUP = 40 -- files listed per group, the rest is summed up by kind

local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall
local string_format = string.format

local engine_log = rawget(_G, "log") -- engine print, exists even where _g's printf might not

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	line = "[coop-ui] " .. (ok and line or tostring(fmt))
	local pf = rawget(_G, "printf")
	if pf then
		pcall(pf, "%s", line)
	elseif engine_log then
		pcall(engine_log, line)
	end
end

-- Translated text with %s filled in order; the English fallback when the string table has no such id.
local function T(id, fallback, ...)
	local s
	local g = rawget(_G, "game")
	if g and g.translate_string then
		local ok, r = pcall(g.translate_string, id)
		if ok and type(r) == "string" and r ~= id and r ~= "" then s = r end
	end
	s = s or fallback
	if select("#", ...) > 0 then
		local args, i = { ... }, 0
		s = s:gsub("%%s", function()
			i = i + 1
			return tostring(args[i])
		end)
	end
	return s
end

local function argb(a, r, g, b)
	return GetARGB(a, r, g, b)
end

local CLR = {}
local function colors()
	if CLR.head then return CLR end
	CLR.head = argb(255, 240, 170, 90)
	CLR.item = argb(255, 205, 205, 205)
	CLR.dim = argb(255, 150, 150, 150)
	CLR.good = argb(255, 150, 210, 150)
	CLR.warn = argb(255, 240, 120, 100)
	return CLR
end

-------------------------------------------------------------------------------
-- Window
-------------------------------------------------------------------------------
class "UICoopMessage" (CUIScriptWnd)

function UICoopMessage:__init() super()
	self:InitControls()
	self:InitCallBacks()
end

function UICoopMessage:__finalize()
end

function UICoopMessage:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:Enable(true)

	local xml = CScriptXmlInit()
	self.xml = xml
	xml:ParseFile("ui_coop_diff.xml")

	xml:InitFrame("coop_shade", self)
	self.dialog = xml:InitStatic("coop_msg", self)
	xml:InitFrame("coop_msg:frame", self.dialog)
	xml:InitFrame("coop_msg:list_frame", self.dialog)
	self.cap = xml:InitTextWnd("coop_msg:cap", self.dialog)
	self.summary = xml:InitTextWnd("coop_msg:summary", self.dialog)
	self.scroll = xml:InitScrollView("coop_msg:scroll", self.dialog)
	self.footer = xml:InitTextWnd("coop_msg:footer", self.dialog)

	self.btn_ok = xml:Init3tButton("coop_msg:btn_ok", self.dialog)
	self:Register(self.btn_ok, "btn_ok")
end

function UICoopMessage:InitCallBacks()
	self:AddCallback("btn_ok", ui_events.BUTTON_CLICKED, self.Close, self)
end

function UICoopMessage:Fill(title, summary, lines, footer)
	self.cap:SetText(title or "")
	self.summary:SetText(summary or "")
	self.footer:SetText(footer or "")
	self.scroll:Clear()
	local default_clr = colors().item
	for _, l in ipairs(lines or {}) do
		local text, clr = l, default_clr
		if type(l) == "table" then
			text, clr = l.text, l.color or default_clr
		end
		text = tostring(text or "")
		local row = self.xml:InitTextWnd("coop_msg:row", nil)
		row:SetText(text ~= "" and text or " ")
		row:SetTextColor(clr)
		row:AdjustHeightToText()
		self.scroll:AddWindow(row, true)
		row:SetAutoDelete(true)
	end
	self.scroll:ScrollToBegin()
end

function UICoopMessage:Close()
	if self:IsShown() then
		self:HideDialog()
	end
end

function UICoopMessage:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE or dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
			self:Close()
			return true
		end
	end
	return res
end

GUI = nil -- the window (module field like stock item_recipe.GUI), kept while this Lua state lives
local fallback_box = nil

-- Stock message box with the title and the summary, if our window cannot be built (missing xml...).
local function show_fallback(title, summary)
	local ok, err = pcall(function()
		fallback_box = fallback_box or CUIMessageBoxEx()
		fallback_box:InitMessageBox("message_box_error")
		fallback_box:SetText(tostring(title) .. "\\n" .. tostring(summary or ""))
		fallback_box:ShowDialog(true)
	end)
	if not ok then log("! cannot show the message box either: %s", tostring(err)) end
	return ok
end

function show(title, summary, lines, footer)
	local ok, err = pcall(function()
		if not GUI then GUI = UICoopMessage() end
		GUI:Fill(title, summary, lines, footer)
		if not GUI:IsShown() then GUI:ShowDialog(true) end
	end)
	if not ok then
		log("! co-op window failed (%s), using the stock message box", tostring(err))
		GUI = nil
		return show_fallback(title, summary)
	end
	return true
end

-------------------------------------------------------------------------------
-- Refusal texts
-------------------------------------------------------------------------------
local KINDS = {
	{ "archive", "archives (db)" },
	{ "script", "scripts" },
	{ "config", "configs" },
	{ "texture", "textures" },
	{ "mesh", "models/animations" },
	{ "sound", "sounds" },
	{ "other", "other files" },
}

local function kind_name(k) return T("st_coop_ui_kind_" .. k[1], k[2]) end

local function kind_of(path)
	local p = path:lower()
	if p:match("^db[\\/]") then return "archive" end
	local ext = p:match("%.([%w_]+)$") or ""
	if ext == "script" then return "script" end
	if ext == "ltx" or ext == "xml" then return "config" end
	if ext == "dds" or ext == "thm" or ext == "seq" then return "texture" end
	if ext == "ogf" or ext == "omf" or ext == "skls" or ext == "anm" then return "mesh" end
	if ext == "ogg" or ext == "wav" then return "sound" end
	return "other"
end

local RANK = { archive = 1, script = 2, config = 3, other = 4, sound = 5, mesh = 6, texture = 7 }

-- Archives and scripts first: their names tell which addon it is. Then alphabetical.
local function sorted_files(list)
	local out = {}
	for _, p in ipairs(list or {}) do
		if type(p) == "string" then out[#out + 1] = p end
	end
	table.sort(out, function(a, b)
		local ra, rb = RANK[kind_of(a)], RANK[kind_of(b)]
		if ra ~= rb then return ra < rb end
		return a:lower() < b:lower()
	end)
	return out
end

local function add_group(lines, title, list, total)
	local files = sorted_files(list)
	total = tonumber(total) or #files
	if total <= 0 then return 0 end
	local c = colors()
	lines[#lines + 1] = { text = string_format("%s: %d", title, total), color = c.head }
	local shown = math.min(#files, MAX_PER_GROUP)
	for i = 1, shown do
		lines[#lines + 1] = { text = "      " .. files[i], color = c.item }
	end
	if total > shown then
		local by_kind = {}
		for i = shown + 1, #files do
			local k = kind_of(files[i])
			by_kind[k] = (by_kind[k] or 0) + 1
		end
		local parts = {}
		for _, k in ipairs(KINDS) do
			if by_kind[k[1]] then parts[#parts + 1] = string_format("%d %s", by_kind[k[1]], kind_name(k)) end
		end
		local unlisted = total - #files -- beyond what the engine handed over
		if unlisted > 0 then parts[#parts + 1] = T("st_coop_ui_more_log", "%s more in the log", unlisted) end
		lines[#lines + 1] = { text = "      " .. T("st_coop_ui_and_more", "... and %s more: %s", total - shown,
			table.concat(parts, ", ")), color = c.dim }
	end
	lines[#lines + 1] = " "
	return total
end

local function content_mismatch(info)
	local lines = {}
	local n = 0
	n = n + add_group(lines, T("st_coop_ui_missing", "Missing on your side (the host has them)"), info.missing,
		info.missing_total)
	n = n + add_group(lines, T("st_coop_ui_extra", "Extra on your side (the host does not have them)"), info.extra,
		info.extra_total)
	n = n + add_group(lines, T("st_coop_ui_differ", "Different version (both have them, the files differ)"), info.differ,
		info.differ_total)
	if n == 0 then
		lines[#lines + 1] = { text = T("st_coop_ui_no_list", "The host's list did not arrive; see the log for details."),
			color = colors().dim }
	end
	local summary = T("st_coop_ui_mods_summary", "The host refused the connection: your game files are not the same as "
		.. "the host's. Install exactly the same mods in the same versions as the host (or the host matches yours), "
		.. "then connect again. Archives and scripts are listed first: their names usually tell the addon.")
	local footer = T("st_coop_ui_mods_footer", "Full list: %s (lines \"missing here\", \"extra here\", \"different\").",
		tostring(info.log_path or "the game log"))
	return T("st_coop_ui_mods_title", "Your mod list differs from the host's"), summary, lines, footer
end

-- R1 I2: the key equals the host's or that of a player in the session right now. No advice to delete the key: a
-- character belongs to its key, and a deleted key on the wrong PC is a lost character.
local function duplicate_key(info)
	local c = colors()
	local key_path = tostring(info.key_path or "appdata\\coop_player.key")
	local lines = {
		{ text = T("st_coop_ui_key_what", "What it means:"), color = c.head },
		"      " .. T("st_coop_ui_key_what_text", "The host recognizes players by this key, not by the nickname: a "
			.. "character belongs to its key."),
		"      " .. T("st_coop_ui_key_who", "The key is changed by the player whose game folder is the copy, never on "
			.. "the PC whose character must stay. With a new key the host creates a new character."),
		"      " .. T("st_coop_ui_key_same_pc", "If the other game with this key is your own second game, close it and "
			.. "connect again."),
		" ",
		{ text = T("st_coop_ui_key_file", "Key file of this game:"), color = c.head },
		{ text = "      " .. key_path, color = c.dim },
	}
	if info.text and info.text ~= "" then
		lines[#lines + 1] = " "
		lines[#lines + 1] = { text = T("st_coop_ui_host_message", "Host message:"), color = c.head }
		lines[#lines + 1] = { text = "      " .. tostring(info.text), color = c.dim }
	end
	local summary = T("st_coop_ui_key_summary", "Your player key is the same as the host's or as the key of a player "
		.. "who is in this session right now. This happens when a game folder is copied: the key file is copied with "
		.. "it, and two players cannot share one key.")
	return T("st_coop_ui_key_title", "Your player key matches another player's"), summary, lines,
		T("st_coop_ui_key_footer", "The key is a random file made on the first co-op start. It holds no password or account data.")
end

local TITLES = {
	ProtocolMismatch = "Different co-op version",
	BuildMismatch = "Different game build",
	SessionFull = "The session is full",
	HostNotReady = "The host is not ready",
	Kicked = "Removed from the session",
	Timeout = "Connection timed out",
	Malformed = "Connection error",
}

local function generic(info)
	local reason = tostring(info.reason)
	local title = TITLES[reason] and T("st_coop_ui_title_" .. reason, TITLES[reason])
		or T("st_coop_ui_title_default", "The host refused the connection")
	local lines = {}
	if info.reason == "HostNotReady" then
		lines[#lines + 1] = T("st_coop_ui_hint_not_ready",
			"The host has to be in a loaded game (not in the main menu) to accept players.")
	elseif info.reason == "SessionFull" then
		lines[#lines + 1] = T("st_coop_ui_hint_full", "Ask the host to raise the player limit or wait until somebody leaves.")
	elseif info.reason == "ProtocolMismatch" or info.reason == "BuildMismatch" then
		lines[#lines + 1] = T("st_coop_ui_hint_build",
			"Install the same Anomaly Coop build as the host (both bin\\ and gamedata\\).")
	end
	return title, tostring(info.text or ""), lines, T("st_coop_ui_reason_code", "Reason code: %s", reason)
end

-- Engine entry (coop_script.cpp): the host refused this player.
function on_rejected(info)
	if type(info) ~= "table" then return end
	local title, summary, lines, footer
	if info.reason == "ContentMismatch" then
		title, summary, lines, footer = content_mismatch(info)
	elseif info.reason == "DuplicateKey" then
		title, summary, lines, footer = duplicate_key(info)
	else
		title, summary, lines, footer = generic(info)
	end
	log("host refusal shown: %s (missing %s, extra %s, different %s)", tostring(info.reason),
		tostring(info.missing_total or 0), tostring(info.extra_total or 0), tostring(info.differ_total or 0))
	show(title, summary, lines, footer)
end

-------------------------------------------------------------------------------
-- Inventory (W8): an envelope button right of the player's money gives money to another player.
-- The transfer itself is coop_economy_money.give_money (rules, host check, refunds); this is only the way in,
-- besides the item context menu "Give money to ...". Shown in the plain inventory mode of a live session with
-- somebody else in it and money transfers allowed by the host (economy/money_transfer).
-------------------------------------------------------------------------------
local GIVE_AMOUNTS = { 100, 500, 1000, 5000, 10000, 50000 }

local function session_live()
	local api = rawget(_G, "coop")
	if not api then return false end
	local ok, v = pcall(function() return api.is_active() and (api.is_host() or api.is_live()) end)
	return ok and v == true
end

local function other_players()
	local api = rawget(_G, "coop")
	local out = {}
	local ok, list = pcall(function() return api and api.players() end)
	for _, p in ipairs(ok and type(list) == "table" and list or {}) do
		if not p.is_self and type(p.id) == "number" then out[#out + 1] = p end
	end
	table.sort(out, function(a, b) return a.id < b.id end)
	return out
end

local function mod_of(name)
	local m = rawget(_G, name)
	if m == nil then
		local ok, mm = pcall(function() return _G[name] end) -- _G.__index loads the script
		m = ok and mm or nil
	end
	return type(m) == "table" and m or nil
end

local function money_allowed()
	local ec = mod_of("coop_economy_core")
	if ec and ec.rule then
		local ok, v = pcall(ec.rule, "money_transfer")
		if ok and v == false then return false end
	end
	return true
end

local function give(peer, amount)
	local em = mod_of("coop_economy_money")
	if not (em and em.give_money) then return false end
	local ok, res = pcall(em.give_money, peer, amount)
	if not ok then log("! give_money: %s", tostring(res)) end
	return ok and res == true
end

local function money_text(amount)
	return tostring(amount) .. " " .. T("st_coop_eco_currency", "RU")
end

-- Amount choice at the cursor (the cell properties box of the inventory).
local function amounts_menu(ui, peer)
	local have = db.actor and db.actor:money() or 0
	local actions, names, params = {}, {}, {}
	for _, a in ipairs(GIVE_AMOUNTS) do
		if a <= have then
			actions[#actions + 1] = "coop_ui_GiveAmount"
			names[#names + 1] = money_text(a)
			params[#params + 1] = { peer, a }
		end
	end
	if have > 0 then
		actions[#actions + 1] = "coop_ui_GiveAmount"
		names[#names + 1] = T("st_coop_eco_money_all", "All (%s)", money_text(have))
		params[#params + 1] = { peer, have }
	end
	if #names == 0 then
		give(peer, 0) -- says "You have no money to give."
		return
	end
	ui.item_props:Reset(GetCursorPosition(), actions, names, params)
end

-- The properties box closes itself after an action: the next list opens on the next update.
local function later(ui, f)
	if rawget(_G, "CreateTimeEvent") then
		CreateTimeEvent("coop_ui", "money_menu", 0, function()
			pcall(f, ui)
			return true
		end)
	else
		f(ui)
	end
end

local function on_money_button(ui)
	local list = other_players()
	if #list == 0 then return end
	if #list == 1 then
		amounts_menu(ui, list[1].id)
		return
	end
	local actions, names, params = {}, {}, {}
	for _, p in ipairs(list) do
		actions[#actions + 1] = "coop_ui_MoneyTo"
		names[#names + 1] = T("st_coop_eco_give_money_to", "Give money to %s...", tostring(p.nick))
		params[#params + 1] = { p.id }
	end
	ui.item_props:Reset(GetCursorPosition(), actions, names, params)
end

local function money_button(ui)
	local want = session_live() and ui.mode == "inventory" and money_allowed() and #other_players() > 0
		and mod_of("coop_economy_money") ~= nil
	local btn = ui.coop_ui_money_btn
	if not btn then
		if not want then return end
		local xml = CScriptXmlInit()
		xml:ParseFile("ui_coop_inventory.xml")
		btn = xml:Init3tButton("give_money", ui.player_dialog)
		ui.coop_ui_money_btn = btn
		ui:Register(btn, "coop_ui_give_money")
		ui:AddCallback("coop_ui_give_money", ui_events.BUTTON_CLICKED, function() on_money_button(ui) end, ui)
	end
	-- right of the money readout (its text is right-aligned), centred on it
	local m = ui.player_money
	local p = m:GetWndPos()
	btn:SetWndPos(vector2():set(p.x + m:GetWidth() + 3, p.y + (m:GetHeight() - btn:GetHeight()) / 2))
	btn:Show(want)
end

local patched_cls = nil

function patch_inventory()
	local inv = mod_of("ui_inventory")
	local cls = inv and inv.UIInventory
	if not (cls and type(cls.UpdateCharacter) == "function") or patched_cls == cls then return false end
	patched_cls = cls
	local orig = cls.UpdateCharacter
	function cls:UpdateCharacter(...)
		local r = orig(self, ...)
		local ok, err = pcall(money_button, self)
		if not ok then log("! inventory money button: %s", tostring(err)) end
		return r
	end
	function cls:coop_ui_MoneyTo(peer)
		later(self, function(ui) amounts_menu(ui, peer) end)
	end
	function cls:coop_ui_GiveAmount(peer, amount)
		if give(peer, amount) then pcall(function() self:UpdateCharacter() end) end
	end
	return true
end

-- In game only (the main menu has no inventory). Must not throw: axr_main runs on_game_start in one loop.
function on_game_start()
	if not rawget(_G, "coop") then return end -- an exe without co-op: stock inventory
	local ok, err = pcall(patch_inventory)
	if not ok then log("! inventory patch: %s", tostring(err)) end
end
