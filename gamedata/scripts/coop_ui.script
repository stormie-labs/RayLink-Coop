--[[
	Anomaly Coop - message windows that work in the main menu and in game (R-1.3, R-1.4)
	gamedata\scripts\coop_ui.script, layout configs\ui\ui_coop_diff.xml

	Called by the engine (coop_script.cpp, once a dialog can be opened):
		coop_ui.on_rejected(info)   the host refused this player
			info = { reason, code, text, missing, extra, differ, missing_total, extra_total, differ_total,
			         key_path, log_path }
			missing/extra/differ: first files of each list (the engine log has all of them)
	For other scripts:
		coop_ui.show(title, summary, lines, footer)   lines: { "text" | { text = "...", color = <argb> }, ... }

	Uses only engine classes and functions, nothing from a running level: the main menu has no actor.
--]]

local MAX_PER_GROUP = 40 -- files listed per group, the rest is summed up by kind

local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall
local string_format = string.format

local engine_log = rawget(_G, "log") -- engine print, exists even where _g's printf might not

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	line = "[coop-ui] " .. (ok and line or tostring(fmt))
	local pf = rawget(_G, "printf")
	if pf then
		pcall(pf, "%s", line)
	elseif engine_log then
		pcall(engine_log, line)
	end
end

local function argb(a, r, g, b)
	return GetARGB(a, r, g, b)
end

local CLR = {}
local function colors()
	if CLR.head then return CLR end
	CLR.head = argb(255, 240, 170, 90)
	CLR.item = argb(255, 205, 205, 205)
	CLR.dim = argb(255, 150, 150, 150)
	CLR.good = argb(255, 150, 210, 150)
	CLR.warn = argb(255, 240, 120, 100)
	return CLR
end

-------------------------------------------------------------------------------
-- Window
-------------------------------------------------------------------------------
class "UICoopMessage" (CUIScriptWnd)

function UICoopMessage:__init() super()
	self:InitControls()
	self:InitCallBacks()
end

function UICoopMessage:__finalize()
end

function UICoopMessage:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:Enable(true)

	local xml = CScriptXmlInit()
	self.xml = xml
	xml:ParseFile("ui_coop_diff.xml")

	xml:InitFrame("coop_shade", self)
	self.dialog = xml:InitStatic("coop_msg", self)
	xml:InitFrame("coop_msg:frame", self.dialog)
	xml:InitFrame("coop_msg:list_frame", self.dialog)
	self.cap = xml:InitTextWnd("coop_msg:cap", self.dialog)
	self.summary = xml:InitTextWnd("coop_msg:summary", self.dialog)
	self.scroll = xml:InitScrollView("coop_msg:scroll", self.dialog)
	self.footer = xml:InitTextWnd("coop_msg:footer", self.dialog)

	self.btn_ok = xml:Init3tButton("coop_msg:btn_ok", self.dialog)
	self:Register(self.btn_ok, "btn_ok")
end

function UICoopMessage:InitCallBacks()
	self:AddCallback("btn_ok", ui_events.BUTTON_CLICKED, self.Close, self)
end

function UICoopMessage:Fill(title, summary, lines, footer)
	self.cap:SetText(title or "")
	self.summary:SetText(summary or "")
	self.footer:SetText(footer or "")
	self.scroll:Clear()
	local default_clr = colors().item
	for _, l in ipairs(lines or {}) do
		local text, clr = l, default_clr
		if type(l) == "table" then
			text, clr = l.text, l.color or default_clr
		end
		text = tostring(text or "")
		local row = self.xml:InitTextWnd("coop_msg:row", nil)
		row:SetText(text ~= "" and text or " ")
		row:SetTextColor(clr)
		row:AdjustHeightToText()
		self.scroll:AddWindow(row, true)
		row:SetAutoDelete(true)
	end
	self.scroll:ScrollToBegin()
end

function UICoopMessage:Close()
	if self:IsShown() then
		self:HideDialog()
	end
end

function UICoopMessage:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE or dik == DIK_keys.DIK_RETURN or dik == DIK_keys.DIK_NUMPADENTER then
			self:Close()
			return true
		end
	end
	return res
end

GUI = nil -- the window (module field like stock item_recipe.GUI), kept while this Lua state lives
local fallback_box = nil

-- Stock message box with the title and the summary, if our window cannot be built (missing xml...).
local function show_fallback(title, summary)
	local ok, err = pcall(function()
		fallback_box = fallback_box or CUIMessageBoxEx()
		fallback_box:InitMessageBox("message_box_error")
		fallback_box:SetText(tostring(title) .. "\\n" .. tostring(summary or ""))
		fallback_box:ShowDialog(true)
	end)
	if not ok then log("! cannot show the message box either: %s", tostring(err)) end
	return ok
end

function show(title, summary, lines, footer)
	local ok, err = pcall(function()
		if not GUI then GUI = UICoopMessage() end
		GUI:Fill(title, summary, lines, footer)
		if not GUI:IsShown() then GUI:ShowDialog(true) end
	end)
	if not ok then
		log("! co-op window failed (%s), using the stock message box", tostring(err))
		GUI = nil
		return show_fallback(title, summary)
	end
	return true
end

-------------------------------------------------------------------------------
-- Refusal texts
-------------------------------------------------------------------------------
local KINDS = {
	{ "archive", "archives (db)" },
	{ "script", "scripts" },
	{ "config", "configs" },
	{ "texture", "textures" },
	{ "mesh", "models/animations" },
	{ "sound", "sounds" },
	{ "other", "other files" },
}

local function kind_of(path)
	local p = path:lower()
	if p:match("^db[\\/]") then return "archive" end
	local ext = p:match("%.([%w_]+)$") or ""
	if ext == "script" then return "script" end
	if ext == "ltx" or ext == "xml" then return "config" end
	if ext == "dds" or ext == "thm" or ext == "seq" then return "texture" end
	if ext == "ogf" or ext == "omf" or ext == "skls" or ext == "anm" then return "mesh" end
	if ext == "ogg" or ext == "wav" then return "sound" end
	return "other"
end

local RANK = { archive = 1, script = 2, config = 3, other = 4, sound = 5, mesh = 6, texture = 7 }

-- Archives and scripts first: their names tell which addon it is. Then alphabetical.
local function sorted_files(list)
	local out = {}
	for _, p in ipairs(list or {}) do
		if type(p) == "string" then out[#out + 1] = p end
	end
	table.sort(out, function(a, b)
		local ra, rb = RANK[kind_of(a)], RANK[kind_of(b)]
		if ra ~= rb then return ra < rb end
		return a:lower() < b:lower()
	end)
	return out
end

local function add_group(lines, title, list, total)
	local files = sorted_files(list)
	total = tonumber(total) or #files
	if total <= 0 then return 0 end
	local c = colors()
	lines[#lines + 1] = { text = string_format("%s: %d", title, total), color = c.head }
	local shown = math.min(#files, MAX_PER_GROUP)
	for i = 1, shown do
		lines[#lines + 1] = { text = "      " .. files[i], color = c.item }
	end
	if total > shown then
		local by_kind = {}
		for i = shown + 1, #files do
			local k = kind_of(files[i])
			by_kind[k] = (by_kind[k] or 0) + 1
		end
		local parts = {}
		for _, k in ipairs(KINDS) do
			if by_kind[k[1]] then parts[#parts + 1] = string_format("%d %s", by_kind[k[1]], k[2]) end
		end
		local unlisted = total - #files -- beyond what the engine handed over
		if unlisted > 0 then parts[#parts + 1] = string_format("%d more in the log", unlisted) end
		lines[#lines + 1] = { text = string_format("      ... and %d more: %s", total - shown, table.concat(parts, ", ")),
			color = c.dim }
	end
	lines[#lines + 1] = " "
	return total
end

local function content_mismatch(info)
	local lines = {}
	local n = 0
	n = n + add_group(lines, "Missing on your side (the host has them)", info.missing, info.missing_total)
	n = n + add_group(lines, "Extra on your side (the host does not have them)", info.extra, info.extra_total)
	n = n + add_group(lines, "Different version (both have them, the files differ)", info.differ, info.differ_total)
	if n == 0 then
		lines[#lines + 1] = { text = "The host's list did not arrive; see the log for details.", color = colors().dim }
	end
	local summary = "The host refused the connection: your game files are not the same as the host's. "
		.. "Install exactly the same mods in the same versions as the host (or the host matches yours), "
		.. "then connect again. Archives and scripts are listed first: their names usually tell the addon."
	local footer = string_format("Full list: %s (lines \"missing here\", \"extra here\", \"different\").",
		tostring(info.log_path or "the game log"))
	return "Your mod list differs from the host's", summary, lines, footer
end

local function duplicate_key(info)
	local c = colors()
	local key_path = tostring(info.key_path or "appdata\\coop_player.key")
	local lines = {
		{ text = "How to fix it on this PC:", color = c.head },
		"      1. Close the game.",
		"      2. Delete this file:",
		{ text = "            " .. key_path, color = c.good },
		"      3. Start the game and connect again. A new key is created automatically.",
		" ",
		{ text = "What it changes:", color = c.head },
		"      The host recognizes players by this key, not by the nickname. With a new key the host",
		"      creates a new character for you; the player whose folder you copied keeps theirs.",
		"      Do not do this on the PC whose character you want to keep.",
	}
	if info.text and info.text ~= "" then
		lines[#lines + 1] = " "
		lines[#lines + 1] = { text = "Host message:", color = c.head }
		lines[#lines + 1] = { text = "      " .. tostring(info.text), color = c.dim }
	end
	local summary = "Another player in this session already uses your player key. This happens when a game folder "
		.. "is copied from another player: the key file is copied with it, and two players cannot share one key."
	return "Your player key is already in use", summary, lines,
		"The key is a random file made on the first co-op start. It holds no password or account data."
end

local TITLES = {
	ProtocolMismatch = "Different co-op version",
	BuildMismatch = "Different game build",
	SessionFull = "The session is full",
	HostNotReady = "The host is not ready",
	Kicked = "Removed from the session",
	Timeout = "Connection timed out",
	Malformed = "Connection error",
}

local function generic(info)
	local title = TITLES[tostring(info.reason)] or "The host refused the connection"
	local lines = {}
	if info.reason == "HostNotReady" then
		lines[#lines + 1] = "The host has to be in a loaded game (not in the main menu) to accept players."
	elseif info.reason == "SessionFull" then
		lines[#lines + 1] = "Ask the host to raise the player limit or wait until somebody leaves."
	elseif info.reason == "ProtocolMismatch" or info.reason == "BuildMismatch" then
		lines[#lines + 1] = "Install the same Anomaly Coop build as the host (both bin\\ and gamedata\\)."
	end
	return title, tostring(info.text or ""), lines, string_format("Reason code: %s", tostring(info.reason))
end

-- Engine entry (coop_script.cpp): the host refused this player.
function on_rejected(info)
	if type(info) ~= "table" then return end
	local title, summary, lines, footer
	if info.reason == "ContentMismatch" then
		title, summary, lines, footer = content_mismatch(info)
	elseif info.reason == "DuplicateKey" then
		title, summary, lines, footer = duplicate_key(info)
	else
		title, summary, lines, footer = generic(info)
	end
	log("host refusal shown: %s (missing %s, extra %s, different %s)", tostring(info.reason),
		tostring(info.missing_total or 0), tostring(info.extra_total or 0), tostring(info.differ_total or 0))
	show(title, summary, lines, footer)
end
