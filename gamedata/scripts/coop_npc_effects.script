--[[
	Anomaly Coop - NPC group (W4 "npc"): what the host's world logic shows and plays reaches the players.
	Port of the behaviour of xrRazom 1.4 xrr_patch_effects, the anabiotic part of xrr_patch_weather and
	xrr_patch_arszi_psy (own code, our event API). Time, weather, emission and psi-storm phases are covered
	by coop_worldstate (C++) and coop_main (Lua); sleep requests by coop_worldstate.

	Host:
	  - NPC and object voices started by Lua (xr_sound.set_sound_play: meet greetings, wounded calls, camp
	    stories, restrictor play_sound) are played on the clients too (npc.snd), on the same object. Only
	    sent when some client is within [coop_npc] sound_radius of the object, or within the range of the
	    sound itself for a theme that has one (a door, a helicopter: object_sound). A theme of class
	    actor_sound (a voice in the player's head) started by a replicated restrictor goes to its audience
	    only.
	  - Looped sounds started/stopped by Lua (xr_sound.play_sound_looped / stop_sound_looped) follow at once
	    (npc.loop) and as a state (coop.sync, session scope, "npc.loops", every 2 s): the join save holds the
	    table, nothing plays it, and an object that comes online later needs its loop then. A client plays
	    what the state lists for objects online here and stops the rest of what it started. A map server is
	    refused that scope, and the key is the world server's level: it casts its list to each player of its
	    level (npc.loops, the list as the args), and that is the state of a player there.
	  - Cosmetic actor effects of the world logic (camera effectors, complex postprocess, psy gluks,
	    earthshake, actor sound, PDA tips) run on the host as before and are relayed (npc.cfx): to the audience of a
	    replicated restrictor, or to everybody when no restrictor fired them. Not while the host's player
	    is in a dialog (dialog effects belong to the talker, whose machine runs the dialog).
	Any machine, in a session:
	  - A puppet's voice table: xr_sound.update runs from the binder, suspended for puppets, so a played theme
	    stayed in sound_table and the next one lost its Lua part. The tick does it for the themes npc.snd played.
	  - Anabiotic (bind_stalker_ext) no longer moves the group's clock or ends the emission for everybody:
	    the player sleeps through it, "anabiotic_in_process" (the stock survive condition of the emission)
	    is held until the emission and psi-storm are over (cap 5 min, 20 s if none comes).
	  - arszi_psy: after a revive (coop_survival) a lethal psy health is lifted to a floor and its death
	    scene counters are reset, so the player is not sent back down at once or left with a black screen.

	Events (ids in host numbering):
	  npc.snd   host -> client  { i = object, s = theme, f = faction?, p = point?, n = the variant the host played? }
	            The voice itself comes from the engine (coop_sound.cpp, the host's file); the client's replay plays that
	            variant for the rest of the theme (stock PDA copy of a far voice, subtitle, a story's place) and leaves
	            an object_sound theme on a creature to the engine.
	  npc.loop  host -> client  { i = object, s = theme | "", on = bool }
	  npc.cfx   host -> client  { f = effect, n = name/section, id = effector id, l = loop, v = fov }
	Stock functions wrapped: xr_sound.set_sound_play, play_sound_looped, stop_sound_looped;
	xr_effects.run_cam_effector, run_cam_effector_global, stop_cam_effector, run_postprocess,
	stop_postprocess, play_sound_on_actor, yan_gluk, x18_gluk, aes_earthshake, warlab_stop_particle, send_tip,
play_particle_on_path (Warlab door scares, steam vents: the chance of each point is rolled per machine);
	bind_stalker_ext.anabiotic_callback, anabiotic_callback2.
--]]

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local TAG = "effects"
local P -- coop_npc_players

local function log(fmt, ...) P.log(TAG, fmt, ...) end
local function report(what, err) P.report(TAG, what, err) end

local EV_SND, EV_LOOP, EV_CFX, EV_LOOPS = "npc.snd", "npc.loop", "npc.cfx", "npc.loops"
-- client -> host { on = bool }: this player sleeps on an anabiotic (per-player emission immunity, W5;
-- coop_main's host kill check asks is_anabiotic(peer))
local EV_ANA = "npc.anabiotic"

local installed = false
local host_on = false
local orig = {}
local stats = { snd_out = 0, snd_in = 0, loop_out = 0, loop_in = 0, cfx_out = 0, cfx_in = 0, anabiotic = 0, psy_floor = 0 }

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op
local KEY_LOOPS = "npc.loops" -- session scope: a list of "id|theme", ids in host numbering
local LOOPS_TICK_MS = 2000
local LOOPS_RETELL_MS = 20000 -- a map server tells a player his list again: he may have reloaded on the spot
local SOUND_REACH_MAX = 300 -- m: what the engine's relay clamps a sound to

local function logic_audience(npc)
	local L = _G["coop_npc_logic"]
	if not (L and L.audience_of and npc) then return nil end
	local ok, aud = pcall(L.audience_of, npc)
	return ok and aud or nil
end

-- A press of a lever by other players: what it shows is theirs, the host's screen stays out of it (coop_npc_logic).
local function spares_host(npc)
	local L = _G["coop_npc_logic"]
	return L ~= nil and L.press_spares_host ~= nil and npc ~= nil and L.press_spares_host(npc)
end

-- Peers to receive something fired by `npc`: its audience (a restrictor's, a press's), else every client (-1 = all).
local function send_scoped(name, t, npc)
	local aud = logic_audience(npc)
	if not aud then
		return P.send(name, t, -1)
	end
	local sent = false
	local host_actor = db.actor and db.actor:id()
	for id in pairs(aud) do
		if id ~= host_actor then
			local peer = P.peer_of(id)
			if peer and P.send(name, t, peer) then sent = true end
		end
	end
	return sent
end

-------------------------------------------------------------------------------
-- Host: voices and looped sounds
-------------------------------------------------------------------------------
-- `reach`: the range of the sound itself, when the theme has one.
local function client_near(id, reach)
	local obj = level.object_by_id(id)
	if not obj then return false end
	local r = math.max(P.setting("sound_radius", 80), reach or 0)
	local r2 = r * r
	local pos = obj:position()
	for _, o in ipairs(P.others()) do
		if o:position():distance_to_sqr(pos) <= r2 then return true end
	end
	return false
end

local function plain(v)
	local tv = type(v)
	if tv == "number" or tv == "string" or tv == "boolean" then return v end
	return nil
end

-- set_sound_play answers with the sound object of an object_sound or actor_sound theme; a voice has none.
local function sound_reach(snd)
	if snd == nil then return nil end
	local ok, d = pcall(function() return snd.max_distance end)
	if ok and type(d) == "number" and d > 0 then return math.min(d, SOUND_REACH_MAX) end
	return nil
end

local function patch_sounds()
	local xs = _G["xr_sound"]
	if not xs then return end
	local set_play = xs.set_sound_play
	if type(set_play) == "function" and not orig.set_play then
		orig.set_play = set_play
		xs.set_sound_play = function(npc_id, sound, faction, point)
			if not (host_on and type(npc_id) == "number" and npc_id ~= 0) then
				return set_play(npc_id, sound, faction, point)
			end
			local before = xs.sound_table[npc_id]
			local r = set_play(npc_id, sound, faction, point)
			local after = xs.sound_table[npc_id]
			local theme = sound_theme and sound_theme.theme[sound]
			local started = after ~= nil and rawequal(after, theme)
				and (before == nil or theme.play_always == true)
			if started and not P.is_player_id(npc_id) then
				local ok, err = pcall(function()
					local npc = level.object_by_id(npc_id)
					-- n: the variant this machine chose. The engine relays that very file; a client that rolled
					-- its own would show another line's subtitle and PDA copy over it (a talk that is not there).
					local t = { i = npc_id, s = sound, f = plain(faction), p = plain(point), n = plain(theme.played_id) }
					local sent
					if theme.class_id == "actor_sound" then
						sent = send_scoped(EV_SND, t, npc)
					elseif client_near(npc_id, sound_reach(r)) then
						sent = P.send(EV_SND, t, -1)
					end
					if sent then stats.snd_out = stats.snd_out + 1 end
				end)
				if not ok then report("voice relay", err) end
			end
			return r
		end
	end
	local loop_play = xs.play_sound_looped
	if type(loop_play) == "function" and not orig.loop_play then
		orig.loop_play = loop_play
		xs.play_sound_looped = function(npc_id, sound)
			local t = host_on and type(npc_id) == "number" and xs.looped_sound[npc_id]
			local was = t and t[sound] ~= nil
			local r = loop_play(npc_id, sound)
			if host_on and npc_id ~= 0 and not was then
				local now = xs.looped_sound[npc_id]
				if now and now[sound] ~= nil and P.send(EV_LOOP, { i = npc_id, s = sound, on = true }, -1) then
					stats.loop_out = stats.loop_out + 1
				end
			end
			return r
		end
	end
	local loop_stop = xs.stop_sound_looped
	if type(loop_stop) == "function" and not orig.loop_stop then
		orig.loop_stop = loop_stop
		xs.stop_sound_looped = function(npc_id, sound)
			local busy = host_on and type(npc_id) == "number" and npc_id ~= 0 and xs.looped_sound[npc_id] ~= nil
			local r = loop_stop(npc_id, sound)
			if busy and P.send(EV_LOOP, { i = npc_id, s = type(sound) == "string" and sound or "", on = false }, -1) then
				stats.loop_out = stats.loop_out + 1
			end
			return r
		end
	end
end

-- Host: the loops as a state. The table also changes without the wrappers (xr_sound.stop_sounds_by_id at an object's
-- net_destroy, a save loaded), so it is read, not tracked.
local loops_sent = nil
local loops_told = {} -- map server: peer -> { sig, at }

local function tell_loops(sync, list, sig)
	-- Mk: this is its way, the session key of the world server is refused here
	local now = time_global()
	local here = {}
	for _, o in ipairs(P.others()) do
		local peer = P.peer_of(o)
		if peer then
			here[peer] = true
			local t = loops_told[peer]
			if not t or t.sig ~= sig or now - t.at >= LOOPS_RETELL_MS then
				local ok, why = sync.broadcast(EV_LOOPS, list, { to = peer })
				if ok == true then
					loops_told[peer] = { sig = sig, at = now }
				else
					report("loops of #" .. tostring(peer), why)
				end
			end
		end
	end
	for peer in pairs(loops_told) do
		if not here[peer] then loops_told[peer] = nil end -- he comes back with a new Lua state
	end
end

local function host_loops_tick()
	local xs = _G["xr_sound"]
	local sync = api and api.sync
	if not (xs and type(xs.looped_sound) == "table" and sync) then return end
	local list = {}
	for id, themes in pairs(xs.looped_sound) do
		if type(id) == "number" and id ~= 0 and type(themes) == "table" then
			for theme in pairs(themes) do list[#list + 1] = tostring(id) .. "|" .. tostring(theme) end
		end
	end
	table.sort(list)
	local sig = table.concat(list, ",")
	if P.is_map_server() then return tell_loops(sync, list, sig) end
	if sig ~= loops_sent and sync.set("session", KEY_LOOPS, list) == true then loops_sent = sig end
end

local client_loops = {} -- "local id|theme" -> { id, theme }: what this machine started for the host
local level_loops = nil -- client: the list of the map server of his level
local puppet_voices = {} -- local id -> true: a theme npc.snd played on it

local function loop_ready(id)
	local st = db.storage[id]
	return st ~= nil and st.object ~= nil and level.object_by_id(id) ~= nil
end

local function client_loop_start(id, theme)
	local key = tostring(id) .. "|" .. theme
	if client_loops[key] or not loop_ready(id) then return end
	if not (sound_theme and sound_theme.theme[theme]) then return end
	xr_sound.play_sound_looped(id, theme)
	client_loops[key] = { id, theme }
end

-- Split levels: the map server of this player's level tells him; a key of the world server is from the level he came from.
local function on_map_server_level()
	local l = api and api.levels
	if not (l and l.split and l.split() == true and l.my_level and l.led_by_host_process) then return false end
	local level = l.my_level()
	return level ~= nil and l.led_by_host_process(level) ~= true
end

local function client_loops_tick()
	local sync = api and api.sync
	local list = level_loops
	if not on_map_server_level() then list = sync and sync.get("session", KEY_LOOPS) end
	if type(list) ~= "table" then return end
	local want = {}
	for _, entry in ipairs(list) do
		local hid, theme = tostring(entry):match("^(%d+)|(.+)$")
		if hid then
			local id = P.to_local(tonumber(hid))
			want[tostring(id) .. "|" .. theme] = true
			client_loop_start(id, theme)
		end
	end
	for key, l in pairs(client_loops) do
		if not want[key] then
			xr_sound.stop_sound_looped(l[1], l[2])
			client_loops[key] = nil
		elseif not loop_ready(l[1]) then
			client_loops[key] = nil -- offline here: the next time it is online it needs its loop again
		end
	end
end

local function client_voices_tick()
	local xs = _G["xr_sound"]
	for id in pairs(puppet_voices) do
		if level.object_by_id(id) then
			xs.update(id)
		else
			xs.sound_table[id] = nil
		end
		if xs.sound_table[id] == nil then puppet_voices[id] = nil end
	end
end

-- The engine relays the sounds a host creature plays through CSoundPlayer and CScriptSound (coop_sound.cpp): an object_sound
-- theme on one is already heard here, from the host's file.
local function engine_relays(obj)
	for _, f in ipairs({ "IsStalker", "IsMonster", "IsTrader" }) do
		local is = rawget(_G, f)
		if type(is) == "function" and is(obj) then return true end
	end
	return false
end

-- The variant the host chose, if it is one of this theme's here (nil: none sent, false: not a valid one).
local function host_variant(th, id, n)
	if n == nil then return nil end
	if type(n) ~= "number" or n ~= math.floor(n) then return false end
	if th.class_id == "npc_sound" then
		local d = th.npc and th.npc[id]
		return d ~= nil and type(d.max) == "number" and n >= 0 and n <= d.max and n
	elseif th.class_id == "object_sound" then
		return type(th.sound) == "table" and th.sound[n] ~= nil and n
	end
	return nil
end

local function client_on_snd(t)
	if type(t.i) ~= "number" or type(t.s) ~= "string" then return end
	local th = sound_theme and sound_theme.theme[t.s]
	if not th then return end
	local id = P.to_local(t.i)
	local obj = id ~= 0 and level.object_by_id(id)
	if id ~= 0 and not obj then return end -- not online here
	if th.class_id == "object_sound" and obj and engine_relays(obj) then return end
	local n = host_variant(th, id, t.n)
	if n == false then return end
	local point = t.p
	if type(point) == "number" then point = P.to_local(point) end
	stats.snd_in = stats.snd_in + 1
	if id ~= 0 then puppet_voices[id] = true end
	-- The theme plays the host's variant: its voice is muted on a puppet (the engine relays the host's file), what is left
	-- (the stock PDA copy of a far voice, the subtitle, the place in a story) must be of that same line. The theme
	-- object stays the stock one; only its choice is answered for this call.
	local as = th
	if n then
		as = setmetatable({ select_next_sound = function() return n end }, { __index = th, __newindex = th })
		sound_theme.theme[t.s] = as
	end
	-- its subtitle news (news_manager.send_sound) comes from the host as core.news (coop_core_world): not
	-- twice (W5)
	local nm = rawget(_G, "news_manager")
	local send = nm and nm.send_sound
	if type(send) == "function" then nm.send_sound = function() return false end end
	local ok, err = pcall(xr_sound.set_sound_play, id, t.s, t.f, point)
	if type(send) == "function" then nm.send_sound = send end
	if as ~= th then
		sound_theme.theme[t.s] = th
		if xr_sound.sound_table[id] == as then xr_sound.sound_table[id] = th end
	end
	if not ok then error(err, 0) end
end

local function client_on_loop(t)
	if type(t.i) ~= "number" or type(t.s) ~= "string" then return end
	local id = P.to_local(t.i)
	stats.loop_in = stats.loop_in + 1
	if t.on == true then
		client_loop_start(id, t.s) -- an object not online here gets it from the state when it comes
	else
		xr_sound.stop_sound_looped(id, t.s ~= "" and t.s or nil)
		for key, l in pairs(client_loops) do
			if l[1] == id and (t.s == "" or l[2] == t.s) then client_loops[key] = nil end
		end
	end
end

-------------------------------------------------------------------------------
-- Host: cosmetic actor effects
-------------------------------------------------------------------------------
local function relay_fx(npc, t)
	if not host_on then return end
	if db.actor and db.actor:is_talking() and not spares_host(npc) then return end
	if send_scoped(EV_CFX, t, npc) then stats.cfx_out = stats.cfx_out + 1 end
end

local function num(v) return type(v) == "number" and v > 0 and v or nil end

-- Effects that are pure visuals/sounds on the receiving machine: replayed by name with the same params.
local REPLAY_BY_NAME = { yan_gluk = true, x18_gluk = true, aes_earthshake = true, warlab_stop_particle = true,
	play_sound_on_actor = true, send_tip = true, play_particle_on_path = true }

local function patch_effects()
	local xe = _G["xr_effects"]
	if not xe then return end
	local function wrap(name, after)
		local f = xe[name]
		if type(f) ~= "function" or orig["fx_" .. name] then return end
		orig["fx_" .. name] = f
		xe[name] = function(actor, npc, p, ...)
			local r
			if not (host_on and spares_host(npc)) then r = f(actor, npc, p, ...) end
			if host_on then
				local ok, err = pcall(after, npc, p)
				if not ok then report("relay " .. name, err) end
			end
			return r
		end
	end
	wrap("run_cam_effector", function(npc, p)
		if p and p[1] then relay_fx(npc, { f = "cam", n = p[1], id = num(p[2]) or 0, l = p[3] == "true" }) end
	end)
	wrap("run_cam_effector_global", function(npc, p)
		if p and p[1] then relay_fx(npc, { f = "cam", n = p[1], id = num(p[2]) or 0, l = false, v = type(p[3]) == "number" and p[3] or nil }) end
	end)
	wrap("stop_cam_effector", function(npc, p)
		if p and num(p[1]) then relay_fx(npc, { f = "stop_cam", id = p[1] }) end
	end)
	wrap("run_postprocess", function(npc, p)
		if p and p[1] then relay_fx(npc, { f = "pp", n = p[1], id = num(p[2]) or 0 }) end
	end)
	wrap("stop_postprocess", function(npc, p)
		if p and num(p[1]) then relay_fx(npc, { f = "stop_pp", id = p[1] }) end
	end)
	for name in pairs(REPLAY_BY_NAME) do
		wrap(name, function(npc, p)
			local args = {}
			if type(p) == "table" then for i = 1, #p do args[i] = tostring(p[i]) end end
			relay_fx(npc, { f = "named", n = name, a = table.concat(args, ":") })
		end)
	end
end

local function client_on_cfx(t)
	if not db.actor or type(t.f) ~= "string" then return end
	stats.cfx_in = stats.cfx_in + 1
	local id = tonumber(t.id) or 0
	if t.f == "cam" and type(t.n) == "string" then
		if id <= 0 then id = 1000 + math.random(100) end
		local fov = tonumber(t.v)
		if fov then
			level.add_cam_effector("camera_effects\\" .. t.n .. ".anm", id, t.l == true, "", fov)
		else
			level.add_cam_effector("camera_effects\\" .. t.n .. ".anm", id, t.l == true, "")
		end
	elseif t.f == "stop_cam" and id > 0 then
		level.remove_cam_effector(id)
	elseif t.f == "pp" and type(t.n) == "string" then
		if not ini_sys:section_exist(t.n) then return end
		if id <= 0 then id = 2000 + math.random(100) end
		level.add_complex_effector(t.n, id)
	elseif t.f == "stop_pp" and id > 0 then
		level.remove_complex_effector(id)
	elseif t.f == "named" and REPLAY_BY_NAME[t.n] then
		local f = orig["fx_" .. t.n] or (xr_effects and xr_effects[t.n])
		if type(f) == "function" then
			local p = (type(t.a) == "string" and t.a ~= "") and xr_logic.parse_func_params(t.a) or {}
			f(db.actor, nil, p)
		end
	end
end

-------------------------------------------------------------------------------
-- Anabiotic in a session: sleep through the emission, the clock stays the group's
-------------------------------------------------------------------------------
local ana = { on = false, t0 = 0, seen = false, next_check = 0, used_at = nil }
local ana_peers = {} -- host: peer -> time_global() until which that player counts as sleeping
local ANA_USE_MS = 15000 -- use -> first callback: the stock camera effector runs 10 s
local ANA_MAX_MS = 300000 + ANA_USE_MS + 30000 -- the owner's cap, the effector and a margin

-- Client: the info portion is this player's own (C1.2 coop.story_hold_infos keeps it off the host's story).
-- Without that engine function it stays the group's story, as before W5.
local function hold_local(fn, ...)
	local api = rawget(_G, "coop")
	local hold = P.is_client() and api and api.story_hold_infos
	if hold then pcall(hold, true) end
	local ok, err = pcall(fn, ...)
	if hold then pcall(hold, false) end
	if not ok then error(err, 0) end
end

local function ana_tell(on)
	if P.is_client() then P.send(EV_ANA, { on = on == true }, 0) end
end

-- This machine's player sleeps on an anabiotic (or is falling asleep): coop_main ignores an emission kill.
function anabiotic_self()
	return ana.on or (ana.used_at ~= nil and time_global() - ana.used_at < ANA_USE_MS)
end

-- Host: that player sleeps on an anabiotic (coop_main spares him at the emission's kill moment).
function is_anabiotic(peer)
	local u = ana_peers[peer]
	if u and time_global() < u then return true end
	ana_peers[peer] = nil
	return false
end

local function host_on_ana(t, from)
	ana_peers[from] = (t.on == true) and (time_global() + ANA_MAX_MS) or nil
	log("anabiotic: player #%d %s", from, t.on == true and "falls asleep" or "woke up")
end

local function emission_on()
	local sm = _G["surge_manager"]
	local pm = _G["psi_storm_manager"]
	local s = sm and sm.is_started and sm.is_started()
	local p = pm and pm.is_started and pm.is_started()
	return (s or p) and true or false
end

local function ana_poll(now)
	if not ana.on or now < ana.next_check then return end
	ana.next_check = now + 1000
	local busy = emission_on()
	if busy then ana.seen = true end
	local held = now - ana.t0
	if (ana.seen and not busy) or (not ana.seen and held > 20000) or held > 300000 then
		ana.on, ana.seen, ana.used_at = false, false, nil
		if has_alife_info("anabiotic_in_process") then hold_local(disable_info, "anabiotic_in_process") end
		ana_tell(false)
		log("anabiotic: woke up (%s)", busy and "time cap" or "emission over")
	end
end

local function patch_anabiotic()
	local bse = _G["bind_stalker_ext"]
	if not bse then return end
	local cb1, cb2 = bse.anabiotic_callback, bse.anabiotic_callback2
	if type(cb1) ~= "function" or type(cb2) ~= "function" or orig.ana1 then return end
	orig.ana1, orig.ana2 = cb1, cb2
	-- The use itself (stock gives anabiotic_in_process there): on a client the info stays this player's and the
	-- host learns who sleeps. bind_stalker reads this field when the actor spawns, after on_game_start.
	local use = bse.actor_on_item_use
	if type(use) == "function" then
		orig.use = use
		bse.actor_on_item_use = function(binder, item, ...)
			if not (P.active() and item) then return use(binder, item, ...) end
			local ok, sec = pcall(item.section, item)
			if not (ok and sec == "drug_anabiotic") then return use(binder, item, ...) end
			ana.used_at = time_global()
			if not P.is_client() then return use(binder, item, ...) end
			ana_tell(true)
			return hold_local(use, binder, item, ...)
		end
	end
	-- Stock: forwards the clock 35-45 minutes and may end the emission. In a session that would be the
	-- whole group's clock: only the sleep remains.
	bse.anabiotic_callback = function(...)
		if not P.active() then return cb1(...) end
		level.add_cam_effector("camera_effects\\surge_01.anm", 10, false, "bind_stalker_ext.anabiotic_callback2")
		ana.on, ana.t0, ana.seen, ana.next_check = true, time_global(), false, 0
		stats.anabiotic = stats.anabiotic + 1
	end
	-- Stock clears anabiotic_in_process here; in a session the poll clears it when the emission is over.
	-- Original bind_stalker_ext.anabiotic_callback2 restores these local sound controls and UI.
	-- The networked immunity lifetime is deliberately managed by RayLink's emission poll instead.
	bse.anabiotic_callback2 = function(...)
		if not P.active() then return cb2(...) end
		xr_effects.enable_ui(db.actor, nil)
		exec_console_cmd("snd_volume_music " .. tostring(_G.mus_vol))
		exec_console_cmd("snd_volume_eff " .. tostring(_G.amb_vol))
		_G.amb_vol = 0
		_G.mus_vol = 0
	end
end

-------------------------------------------------------------------------------
-- arszi_psy after a revive
-------------------------------------------------------------------------------
local revive = { low = false, engine = false }
local PSY_LETHAL, PSY_FLOOR = 0.001, 0.3

function on_actor_revived()
	local ap = _G["arszi_psy"]
	if not (ap and ap.get_psy_health and ap.set_psy_health) then return end
	local psy = ap.get_psy_health()
	if type(psy) == "number" and psy <= PSY_LETHAL then
		ap.set_psy_health(PSY_FLOOR)
		if ap.on_game_load then pcall(ap.on_game_load) end -- resets its death-scene stage and counter
		if ap.remove_all_psy_ppe_effects then pcall(ap.remove_all_psy_ppe_effects) end
		level.enable_input()
		stats.psy_floor = stats.psy_floor + 1
		log("revived: psy health %.3f -> %.2f", psy, PSY_FLOOR)
	end
end

local function engine_revived(reviver_peer, medkit_section)
	revive.engine, revive.low = true, false
	on_actor_revived()
end

-- Until the engine reports revives (older exe): a revive pins the health just above zero, then sets it to the
-- revive health in one step. coop_actor_revived (if the engine adds it) is used as well.
local function revive_poll()
	if revive.engine then return end -- the engine reports revives (coop_actor_revived)
	local a = db.actor
	if not a then return end
	local h = a.health
	if h < 0.02 then
		revive.low = true
	elseif revive.low and h >= 0.1 then
		revive.low = false
		on_actor_revived()
	elseif h >= 0.02 then
		revive.low = false
	end
end

-------------------------------------------------------------------------------
-- Install, update, events
-------------------------------------------------------------------------------
local next_tick, next_loops = 0, 0

local function loops_tick(now)
	if now < next_loops then return end
	next_loops = now + LOOPS_TICK_MS
	if P.is_host() then
		host_loops_tick()
	elseif P.client_live() then
		client_loops_tick()
		client_voices_tick()
	end
end

local function actor_on_update()
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + 500
	host_on = installed and P.host_with_clients()
	if not P.active() then return end
	local ok, err = pcall(loops_tick, now)
	if not ok then report("loops", err) end
	-- host: a save made during the hold comes back with anabiotic_in_process set and no hold in this Lua
	-- state; the poll clears it after the emission (or 20 s), or the host would be immune for good (W5)
	if not ana.on and P.is_world_server() and has_alife_info("anabiotic_in_process") then
		ana.on, ana.t0, ana.seen, ana.next_check = true, now, false, 0
	end
	ana_poll(now)
	revive_poll()
end

function print_status()
	log("installed %s | voices out %d in %d, loops out %d in %d, effects out %d in %d | anabiotic %d (holding %s), psy floor %d | errors %d",
		tostring(installed), stats.snd_out, stats.snd_in, stats.loop_out, stats.loop_in, stats.cfx_out, stats.cfx_in,
		stats.anabiotic, tostring(ana.on), stats.psy_floor, P.error_count(TAG))
end

function on_game_start()
	P = coop_npc_players
	if not rawget(_G, "coop") then return end
	if not installed then
		local steps = { { "sounds", patch_sounds }, { "effects", patch_effects }, { "anabiotic", patch_anabiotic } }
		for _, s in ipairs(steps) do
			local ok, err = pcall(s[2])
			if not ok then report("install " .. s[1], err) end
		end
		installed = true
	end
	P.on(EV_SND, client_on_snd, "client", TAG)
	P.on(EV_LOOP, client_on_loop, "client", TAG)
	P.on(EV_CFX, client_on_cfx, "client", TAG)
	if api and api.sync then
		api.sync.on(EV_LOOPS, function(list, from)
			if from == 0 and P.is_client() and type(list) == "table" then level_loops = list end
		end)
	end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	P.on(EV_ANA, host_on_ana, "host", TAG)
	-- created by coop_main at load; fired by the engine on the revived player's machine (C1.6)
	RegisterScriptCallback("coop_actor_revived", engine_revived)
end

function _set_host_on(v) host_on = v end
function _stats() return stats end
