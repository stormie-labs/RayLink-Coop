-- Ядро: без проверок режима (docs/MODES.md).
-- Delayed repairs belong to the current player's mechanic queue.
-- A different player's collection can clear the shared *_is_repairing info portion.
-- RepairItemList is already personal through coop_economy_mdata; save_state reads its live file local,
-- whereas m_data can be stale (load_state removes the key). No new saved keys or wire events.

local core = coop_mods_core
local installed = false

local function install()
	if installed then return end
	local mod = core.mod("inventory_upgrades")
	if not (mod and core.fn(mod, "save_state")) then return end
	installed = core.wrap(mod, "has_repair_info", "inventory_upgrades.has_repair_info", function(orig)
		return function(a, b, ...)
			if not core.active() then return orig(a, b, ...) end
			local scratch = {}
			local ok, err = pcall(mod.save_state, scratch)
			if not ok then
				core.report("upgrades", "read repair queue", err)
				return false
			end
			local queues = scratch.RepairItemList
			if type(queues) ~= "table" then return false end
			local npc = dialogs.who_is_npc(a, b)
			local queue = queues[npc:section()]
			return type(queue) == "table" and next(queue) ~= nil
		end
	end)
end

function on_game_start()
	core.install("upgrades", "install", install)
end
