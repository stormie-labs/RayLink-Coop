-- Сервер (srv): таблицы, которые сервер мира и серверы карт видят одинаково (docs/MODES.md)
--[[
	Anomaly Coop - split levels: tables of the stock and of the mods that the world server and a map server must see alike
	(docs\SPLIT_LEVELS.md 7a). A process holds its Lua state alone and only the world server saves, so a table a map server writes
	never reached the save, and a table the world server writes never reached a map server started before.

		coop_mode.share_up(name, get, set[, every_ms])     get() on a map server, set(value, level) on the world server
		coop_mode.share_down(name, get, set[, every_ms])   get() on the world server, set(value) on a map server

	The Core keeps what is registered (it never names this script, check_layers L3); this script carries it, from
	coop_mode.when_srv on: nothing of it runs in the co-op. get answers a table of strings, numbers and booleans
	(coop_quests_core.ser), or nil for nothing to tell yet. It is compared as a string and goes when it changed, in parts: one event
	carries at most PART characters. A map server that starts gets every down table.
--]]

local api = rawget(_G, "coop")

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local EV = "coop_share"
local PART = 6000
local EVERY_MS = 3000
local MAX_PARTS = 64
local HELLO = "__hello"
local said_hello = false

local parts = {} -- "from:name" -> { seq, n, got, list }
-- what was sent of each registered table (its entry in coop_quests_core.shared(): a table registered again starts anew)
local state = setmetatable({}, { __mode = "k" })

local function qc() return coop_quests_core end
local function levels() return api and api.levels end
local split, world_server, map_server = coop_srv_roles.split, coop_srv_roles.world_server, coop_srv_roles.map_server
local function cm() return rawget(_G, "coop_main") or coop_main end

local function ups() return qc().shared().up end
local function downs() return qc().shared().down end

local function sent_up(e)
	local s = state[e]
	if not s then
		s = { next = 0, sent = nil, seq = 0 }
		state[e] = s
	end
	return s
end

local function sent_down(e)
	local s = state[e]
	if not s then
		s = { next = 0, sent = {}, seq = 0 }
		state[e] = s
	end
	return s
end

local function send(name, seq, blob, target)
	local n = math.max(1, math.ceil(#blob / PART))
	if n > MAX_PARTS then
		printf("! [coop] share: %s is too long to send (%d)", name, #blob)
		return false
	end
	for i = 1, n do
		api.send_event(EV, cm().encode({ k = name, s = seq, i = i, n = n, d = blob:sub((i - 1) * PART + 1, i * PART) }), target)
	end
	return true
end

local function blob_of(e, name)
	local ok, v = pcall(e.get)
	if not ok then
		qc().report("share", name, v)
		return nil
	end
	if v == nil then return nil end
	return qc().ser(v)
end

local function tick_up(now)
	for name, e in pairs(ups()) do
		local s = sent_up(e)
		if now >= s.next then
			s.next = now + (e.every or EVERY_MS)
			local blob = blob_of(e, name)
			if blob and blob ~= s.sent then
				s.seq = s.seq + 1
				if send(name, s.seq, blob, 0) then s.sent = blob end
			end
		end
	end
end

local function tick_down(now)
	local list = levels().map_servers()
	for name, e in pairs(downs()) do
		local s = sent_down(e)
		local live = {}
		for _, ms in ipairs(list) do live[ms.bridge] = true end
		for bridge in pairs(s.sent) do
			if not live[bridge] then s.sent[bridge] = nil end -- the next process on that bridge knows nothing
		end
		local fresh = false
		for _, ms in ipairs(list) do fresh = fresh or s.sent[ms.bridge] == nil end
		if now >= s.next or fresh then
			s.next = now + (e.every or EVERY_MS)
			local blob = blob_of(e, name)
			if blob then
				for _, ms in ipairs(list) do
					if s.sent[ms.bridge] ~= blob then
						s.seq = s.seq + 1
						if send(name, s.seq, blob, ms.bridge) then s.sent[ms.bridge] = blob end
					end
				end
			end
		end
	end
end

local function level_of_bridge(from)
	for _, ms in ipairs(levels().map_servers()) do
		if ms.bridge == from then return ms.level end
	end
	return nil
end

local function on_part(payload, from)
	if type(from) ~= "number" or not split() then return end
	local q = qc()
	local world = world_server()
	local e
	local t = cm().decode(payload)
	local name = t.k
	if world then
		if not coop_mode.from_level(from) then return end
		e = ups()[name]
	elseif map_server() then
		if from ~= 0 then return end
		e = downs()[name]
	end
	if world and name == HELLO then
		for _, d in pairs(downs()) do sent_down(d).sent[from] = nil end -- a new process on this bridge: it knows nothing
		return
	end
	if not e then return end
	local key = tostring(from) .. ":" .. tostring(name)
	local p = parts[key]
	local seq, n, i = tonumber(t.s), tonumber(t.n), tonumber(t.i)
	if not (seq and n and i and n <= MAX_PARTS) then return end
	if not p or p.seq ~= seq then
		p = { seq = seq, n = n, got = 0, list = {} }
		parts[key] = p
	end
	if p.list[i] == nil then
		p.list[i] = tostring(t.d or "")
		p.got = p.got + 1
	end
	if p.got < p.n then return end
	parts[key] = nil
	local v = q.des(table.concat(p.list), MAX_PARTS * PART)
	if v == nil then
		printf("! [coop] share: %s from %s does not read", tostring(name), tostring(from))
		return
	end
	local ok, err
	if world then ok, err = pcall(e.set, v, level_of_bridge(from)) else ok, err = pcall(e.set, v) end
	if not ok then q.report("share", tostring(name), err) end
end

-- The host's move: this process stayed, the world server's Lua is new. What it was told is gone, a down table it sends by itself.
local function on_world_back()
	said_hello = false
	for _, e in pairs(ups()) do
		local s = sent_up(e)
		s.sent, s.next = nil, 0
	end
end

local function on_update()
	if not (api and split()) then return end
	local now = time_global()
	if map_server() then
		if not said_hello then
			said_hello = true
			api.send_event(EV, cm().encode({ k = HELLO }), 0)
		end
		tick_up(now)
	elseif world_server() then
		tick_down(now)
	end
end

function on_game_start()
	if not api then return end
	coop_mode.when_srv(function()
		cm().add_event_handler(EV, on_part)
		RegisterScriptCallback("actor_on_update", on_update)
		RegisterScriptCallback("coop_world_back", on_world_back)
	end)
end

-- tests only
_test = {
	tick = on_update,
}
