-- Ядро: без проверок режима (docs/MODES.md)
-- Item riders own the concrete weapon's selections and Lua jam type.
-- economy.se also carries changes (including NPC loot) to the world and its maps;
-- economy.imd carries the same riders with inventory/clone snapshots. No new wire verbs.
-- Every value includes the economy item_instance identity. A clear is a stamped value,
-- not a missing entry, so an old owner's Lua table cannot resurrect a cleared jam.
-- A client's move of its weapon carries the riders (carry / carried, coop_requests.cpp), and engine ticks
-- (coop.event_tick / coop.released_after) keep a rider of a released weapon off a same-name replacement.

local function C() return coop_mods_core end
local specs = {
	{ key = "coop_weapon_camo", module = "z_3dss_gamma_camo_system", field = "selected_by_weapon" },
	{ key = "coop_weapon_jam", module = "arti_jamming", field = "jammed_guns" },
}
local specs_by_key = {}
for _, s in ipairs(specs) do specs_by_key[s.key] = s end
-- since[id]: the engine tick from which this script holds state for the id's current instance.
local seen, pending, retired, since = {}, {}, {}, {}
local applying, installed, storage = false, false, nil
local receive_item, flush_se
local MAX_CARRY, MAX_PACKED = 4096, 2048 -- riders::kMaxCarry (engine/src/xrCoop/coop_item_rider_rules.h), one rider

local function data()
	local asm = C().mod("alife_storage_manager")
	return asm and asm.get_state and asm.get_state() or nil
end

-- engine/src/xrCoop/coop_item_rider_rules.h: the engine numbers the events reaching its Lua inbox and the
-- releases of entities on this process with one counter. arrival: the event being delivered now (now outside one).
local function ticks()
	local f = coop and coop.event_tick
	if type(f) ~= "function" then return nil, nil end
	local arrival, now = f()
	return tonumber(arrival), tonumber(now)
end

-- The engine released the entity under this local id after `tick`; false when it cannot say.
local function released_since(id, tick)
	local f = coop and coop.released_after
	return type(tick) == "number" and type(f) == "function" and f(id, tick) == true
end

-- The decider's last carry of a weapon (carried, below): hid -> { ms = time_global(), from = transport sender }.
-- Read only by the owner-check line, so a refusal says whether the item moved a moment before (at most 256 kept).
local carried_at, carried_n = {}, 0

-- Owner probe (dev66 carry_group: "item 19664: sender 1 is not its carrier", no way to tell from the line why).
-- What the world holds for the item: its section, the parent and root it sits under, the sender's character, the
-- rider's path and how long ago that sender's own carry moved it.
local function carrier_facts(id, hid, avatar, path)
	local sim = alife()
	local se = sim and sim:object(id)
	local parent = se and se.parent_id
	local root = C().mod("coop_economy_core").root_of(hid)
	local root_se = root and sim and sim:object(root)
	local last = carried_at[hid]
	return string.format("[%s] parent %s, root %s [%s], his character %s, %s rider, %s",
		se and se:section_name() or "not in the world", tostring(parent), tostring(root),
		root_se and root_se:section_name() or "?", tostring(avatar), tostring(path),
		last and string.format("carried by sender %s %d ms ago", tostring(last.from), time_global() - last.ms)
			or "no carry of it seen here")
end
local function carrier_text(...)
	local ok, text = pcall(carrier_facts, ...)
	return ok and text or "(no facts: " .. tostring(text) .. ")"
end

local function live(s)
	local mod = C().mod(s.module)
	if not mod then return nil end
	if s.field == "jammed_guns" then return mod.jammed_guns end
	-- The mod's public snapshot exposes the live selections reference, including
	-- after load_state replaces it. Avoid an upvalue scan for each inventory item.
	if mod.save_state then
		local snapshot = {}
		mod.save_state(snapshot)
		local state = snapshot.z_3dss_gamma_camo_system
		return state and state.selections
	end
end

-- Same precedence as coop_economy_mdata.item_instance, with the saved name available
-- while a clone target has metadata but no online game object yet. m: the storage, when the caller has it.
local function instance(id, m)
	m = m or data()
	local se = m and m.se_object and m.se_object[id]
	if se and se._coop_instance then return se._coop_instance end
	local obj = alife_object(id)
	return obj and obj:name() or se and se.name
end

-- Instances `a` and `b` of the weapon under local id `id` name the same item: equal, or another process's
-- stamp of it, or its bare name (coop_economy_mdata.same_item: the same name, and in a stamp the item's host id). Each
-- process mints its own stamp when it first writes the weapon's EntitySpawn; an unstamped copy's instance is its name. Another
-- name or another host id is another item. The id-reuse checks (fresh / released_since, clone_pending) stay with the callers.
local function same_item(id, a, b)
	if a == nil or b == nil then return false end
	if a == b then return true end
	local em = C().mod("coop_economy_mdata")
	return em ~= nil and type(em.same_item) == "function" and em.same_item(a, b, C().hid(id)) == true
end

local function copy_state(s, value)
	if s.field == "jammed_guns" then
		if value == nil or value == 0 then return 0 end
		if type(value) == "number" and value >= 1 and value <= 4 and value == math.floor(value) then return value end
		return nil
	end
	if value == nil or value == false then return false end
	if type(value) ~= "table" then return nil end
	local out = {}
	for k, v in pairs(value) do
		if (k ~= "file" and k ~= "section" and k ~= "sp34_variant") or type(v) ~= "string" or #v > 256 or #v == 0 then return nil end
		out[k] = v
	end
	if (out.file == nil) ~= (out.section == nil) then return nil end
	if out.sp34_variant and out.sp34_variant ~= "fde" and out.sp34_variant ~= "black" then return nil end
	return out
end

-- The engine released the instance this script held state for, and unregister_item never ran here: drop it as
-- unregister_item would, so a replacement under the same name and id starts with nothing.
local function forget(id)
	local m = data()
	local se = m and m.se_object and m.se_object[id]
	for _, s in ipairs(specs) do
		if m and type(m[s.key]) == "table" then m[s.key][id] = nil end
		if type(se) == "table" then se[s.key] = nil end
		local tbl = live(s)
		if tbl then tbl[id] = nil end
	end
	seen[id], pending[id], since[id] = nil, nil, nil
end

-- Called before this script reads or writes state of a weapon; true when it dropped the state of a released instance.
-- A clone transaction keeps its state on purpose.
local function fresh(id)
	if type(id) ~= "number" then return false end
	local t = since[id]
	local stale = t ~= nil and released_since(id, t)
	if t ~= nil and not stale then return false end -- the usual answer: one engine call
	local _, now = ticks()
	if stale then
		local em = C().mod("coop_economy_mdata")
		if em and em.clone_pending and em.clone_pending(id) then
			since[id] = now
			return false
		end
		forget(id)
	end
	if not since[id] then since[id] = now end
	return stale
end

local function store(s, id, value)
	fresh(id)
	local m = data()
	if not m then return end
	if m[s.key] then
		m[s.key][id] = value
	elseif value ~= nil then
		m[s.key] = { [id] = value }
	end
end

local function refresh(id)
	local mod = C().mod(specs[1].module)
	local obj = level.object_by_id(id)
	if obj and mod and mod.refresh_camo then
		if not mod.refresh_camo(obj) then
			local apply_default = C().find_local(mod, "apply_selected")
			if apply_default then apply_default(obj) end
		end
		return true
	end
	return false
end

local function checked_state(s, id, record)
	local valid = type(id) == "number" and id > 0 and id < 65535 and id == math.floor(id)
		and type(record) == "table" and type(record.instance) == "string" and #record.instance > 0 and #record.instance <= 256
	local state = valid and record.state ~= nil and copy_state(s, record.state)
	valid = valid and record.state ~= nil and state ~= nil
	if valid then
		for field in pairs(record) do
			if field ~= "instance" and field ~= "state" then valid = false break end
		end
	end
	if coop_trust.pass("item_state_value", valid, "item %s: invalid weapon rider", tostring(id)) and valid then return state end
end

-- The record's instance and the stamp it travelled with name this weapon (same_item: this process's instance of it,
-- another process's stamp of it or its bare name); a record of another item under the id is refused.
local function matches_instance(id, current, record, wire_stamp)
	local matches = (not current or same_item(id, current, record.instance))
		and (wire_stamp == nil or wire_stamp == "" or same_item(id, wire_stamp, record.instance))
	return coop_trust.pass("item_state_instance", matches, "item %s: weapon instance changed", tostring(id)) and matches
end

-- This process keeps exactly this record for the weapon already.
local function same_record(s, id, record)
	local m = data()
	local current = m and type(m[s.key]) == "table" and m[s.key][id]
	return type(current) == "table" and C().ser(current) == C().ser(record)
end

local function apply(s, id, record)
	if not C().active() then return end
	local state = checked_state(s, id, record)
	if state == nil then return false end
	-- A record of the instance the engine released here: never for the replacement.
	if fresh(id) then return false end
	local current = instance(id)
	local em = C().mod("coop_economy_mdata")
	-- The clone transaction deliberately replaces the source's stamp. Its rider has
	-- already passed clone_stage; bind it to the target before the object appears.
	if em and em.clone_pending and em.clone_pending(id) and current then
		record = { instance = current, state = state }
		store(s, id, record)
		local m = data()
		if m.se_object and m.se_object[id] then m.se_object[id][s.key] = record end
	end
	pending[id] = pending[id] or {}
	pending[id][s.key] = record
	if not current then return true end
	if not matches_instance(id, current, record) then
		-- An obsolete pending apply is a replay, never permission to paint a reused id.
		pending[id][s.key] = nil
		if not next(pending[id]) then pending[id] = nil end
		return false
	end
	local tbl = live(s)
	if type(tbl) ~= "table" then return true end
	applying = true
	tbl[id] = state
	if state == false or state == 0 then tbl[id] = nil end
	applying = false
	seen[id] = current
	if s ~= specs[1] or refresh(id) then
		pending[id][s.key] = nil
		if not next(pending[id]) then pending[id] = nil end
	end
	return true
end

local function receive_se(s, id, hid, record, packed, from, world)
	local em = C().mod("coop_economy_mdata")
	-- The economy holds a player's update when it has no ALife entity to check.
	-- Its SE listener will run if ownership is established when the entity appears.
	if (world and from < 0x100 and not alife_object(id)) or em.clone_pending(id) then return end
	if not apply(s, id, record) then return end
	if world then
		store(s, id, record)
	elseif receive_item then
		-- The economy receiver seeds item_poll's baseline. A received rider of
		-- the local player's own weapon must not be echoed back to the world.
		receive_item({ n = 1, i1 = hid, k1 = s.key, d1 = packed, x1 = record.instance }, 0)
	end
end

-- The economy's admission of a received se or imd batch (coop_economy_mdata.admit): only these two keys are checked here,
-- before the economy stores, queues or relays them. Other riders and SE vars in the same batch keep their ordinary handler.
-- Returns what runs once the economy has stored the batch.
local function admit_riders(kind, t, from)
	if not C().active() then return end
	local world = coop_mode.decides_world()
	local source = type(from) == "number" and from == math.floor(from) and from >= 0 and from <= 65535
		and ((world and from > 0) or (not world and from == 0))
	local allowed = coop_trust.pass("item_state_sender", source, "weapon rider: unexpected transport sender %s", tostring(from)) and source
	local ec = C().mod("coop_economy_core")
	local n = ec.int(t.n, 0, 2000)
	if not coop_trust.pass("item_state_batch", n ~= nil, "weapon rider: invalid batch size") or not n then return end
	local received, admitted = {}, {}
	local arrival = ticks()
	for i = 1, n do
		local key = "k" .. i
		local s = specs_by_key[t[key]]
		if s then
			local hid, packed, stamp = ec.int(t["i" .. i], 1, 65534), t["d" .. i], t["x" .. i]
			local valid = false
			-- item_poll can report an absent entry. An actual clear carries an instance.
			if allowed and not (kind == "imd" and packed == "_") then
				local wire_ok = hid ~= nil and type(packed) == "string" and #packed <= MAX_PACKED
				if coop_trust.pass("item_state_wire", wire_ok, "weapon rider: invalid id or payload") and wire_ok then
					local id = C().lid(hid)
					local record, err = ec.unpack(packed)
					local decoded = err == nil
					valid = coop_trust.pass("item_state_wire", decoded, "item %s: invalid rider encoding", tostring(hid))
						and decoded and checked_state(s, id, record) ~= nil and matches_instance(id, instance(id), record, stamp)
					-- It waited in the inbox while the engine released its weapon here (a replacement may
					-- have the same name and id now). An honest race, not a refusal: counted, never logged.
					valid = valid and coop_trust.guard("item_state_released", not released_since(id, arrival))
					if valid and world and from < 0x100 and alife_object(id) then
						local player = ec.player(from)
						local owner = player and player.avatar_id and ec.root_of(hid) == player.avatar_id
						if not owner and same_record(s, id, record) then
							-- The former holder's own copy of what his move carried: written already (carried).
							valid = coop_trust.guard("item_state_carried", false)
						else
							valid = coop_trust.pass("item_state_owner", owner, "item %s: sender %s is not its carrier: %s",
								tostring(hid), tostring(from),
								not owner and carrier_text(id, hid, player and player.avatar_id, kind) or "") and owner
						end
					end
					if valid then admitted[#admitted + 1] = id end
					if valid and kind == "se" then
						received[#received + 1] = { spec = s, id = id, hid = hid, record = record, packed = packed }
					end
				end
			end
			if not valid then
				t[key], t["i" .. i], t["d" .. i], t["x" .. i] = nil, nil, nil, nil
			end
		end
	end
	-- Before the economy stores them: what this script held for a released instance goes first.
	for _, id in ipairs(admitted) do fresh(id) end
	if not received[1] then return end
	-- Keep admitted SE deliveries until the weapon appears, including on maps
	-- where the shared economy's 30-second wait would expire.
	return function()
		for _, e in ipairs(received) do receive_se(e.spec, e.id, e.hid, e.record, e.packed, from, world) end
	end
end

local function restore_se(s, id, m)
	local se = m.se_object and m.se_object[id]
	local record = se and se[s.key]
	store(s, id, record)
	if record and not apply(s, id, record) then store(s, id, nil) end
end

local function restore(id)
	local m = data()
	if not m then return end
	for _, s in ipairs(specs) do
		local record = m[s.key] and m[s.key][id]
		if not (record and apply(s, id, record)) then restore_se(s, id, m) end
	end
end

-- m: the storage, when the caller has it.
local function observe(id, m)
	m = m or data()
	fresh(id)
	local current = instance(id, m)
	if not current then return end
	local changed = seen[id] and seen[id] ~= current
	for _, s in ipairs(specs) do
		local record = m and m[s.key] and m[s.key][id]
		if changed or (record and (type(record) ~= "table" or not same_item(id, record.instance, current))) then
			local tbl = live(s)
			if tbl then tbl[id] = nil end
		end
	end
	if seen[id] ~= current then restore(id) end
	seen[id] = current
end

local function owns(id)
	return coop_mode.actor_is_player() and db.actor and C().root_of(id) == db.actor:id()
end

-- WPO uses the stock SE field so saves, clone/initial snapshots and live changes
-- all refer to the same parts. A mirror can edit its carried weapon's existing
-- state, but only the process running the map can initialize that state.
local PARTS = "parts"
local MAX_PART_QUERIES = 64
local parts_asked, parts_queries, parts_dirty, parts_waiting = {}, {}, {}, {}
-- parts_after[id]: readers of this machine waiting for the item's parts ({ f, name }); routes[peer] (the world): the
-- process that led that player's map when last seen (0: none)
local parts_after, routes = {}, {}
-- The tables update swaps in for parts_dirty and routes (nil while one is in use).
local parts_dirty_spare, routes_spare = {}, {}
local parts_eval
local parts_seq = 0

-- What the ask path of the parts did on this process (coop_status, line "wpo"), and a log of it: one line
-- per ask, answer and refusal, at most WPO_SAY_MAX lines a minute (then one line with how many were left out).
local wpo = { asked = 0, answered = 0, refused = 0, unrouted = 0, rolled = 0, known = 0, waiting = 0, denied = 0, why = {} }
local WPO_SAY_MAX = 40
local wpo_said = { n = 0, quiet = 0, until_ms = 0 }
local function wpo_say(fmt, ...)
	local t = time_global()
	if t >= wpo_said.until_ms then
		if wpo_said.quiet > 0 then C().log("wpo", "%d more lines of the last minute not written", wpo_said.quiet) end
		wpo_said.n, wpo_said.quiet, wpo_said.until_ms = 0, 0, t + 60000
	end
	if wpo_said.n >= WPO_SAY_MAX then
		wpo_said.quiet = wpo_said.quiet + 1
		return
	end
	wpo_said.n = wpo_said.n + 1
	C().log("wpo", fmt, ...)
end

local function has_parts(obj)
	local im = C().mod("itms_manager")
	local ini = im and im.ini_parts
	if not ini then return true end
	local sec = obj:section()
	sec = ini_sys:r_string_ex(sec, "parent_section") or sec
	local list = ini:r_string_ex("con_parts_list", sec)
	return type(list) == "string" and list ~= ""
end

local function read_parts(id)
	local value = se_load_var(id, nil, PARTS)
	return type(value) == "table" and next(value) and value or nil
end

local function valid_parts(value)
	if type(value) ~= "table" or not next(value) then return false end
	for key, condition in pairs(value) do
		if type(key) ~= "string" or type(condition) ~= "number"
			or not (condition == -1 or condition >= 0 and condition <= 100) then return false end
	end
	return true
end

local function request_parts(obj, again)
	local id = obj:id()
	local name = obj:name()
	local holder = C().root_of(id)
	local asked = parts_asked[id]
	if not again and asked and not asked.refused and asked.name == name and asked.holder == holder
		and not released_since(id, asked.tick) then return asked end
	local hid = C().hid(id)
	if not hid or #name > 256 then return false end
	local _, now = ticks()
	parts_seq = parts_seq + 1
	-- Older passive readers can still receive a refusal without a sequence when there was no overlapping ask.
	local overlap = asked and (asked.overlap or (asked.sent and not asked.refused))
	local query = { w = hid, name = name, holder = holder, tick = now, q = parts_seq, overlap = overlap, at = time_global() }
	parts_asked[id], parts_queries[id] = query, query
	return query
end

local function flush_parts_queries()
	if not C().active() or not next(parts_queries) then return end
	-- One inventory draw can ask for a whole trader page. A request per
	-- cell exhausts the verb's burst allowance and leaves later cells blank.
	local t, ids, bytes = { n = 0 }, {}, 0
	for id, query in pairs(parts_queries) do
		if released_since(id, query.tick) then
			parts_asked[id], parts_queries[id] = nil, nil
		else
			bytes = bytes + 3 * #query.name + 48
			if t.n == MAX_PART_QUERIES or bytes > 10000 then break end
			t.n = t.n + 1
			t["w" .. t.n], t["s" .. t.n], t["q" .. t.n], ids[t.n] = query.w, query.name, query.q, id
		end
	end
	if t.n > 0 and C().to_host("wpo_eval", t) then
		for _, id in ipairs(ids) do
			local query = parts_queries[id]
			query.sent = true
			query.at = time_global()
			parts_queries[id] = nil
			wpo.asked = wpo.asked + 1
			wpo_say("ask %d [%s] in %s (%d in this ask)", query.w, query.name, tostring(query.holder), t.n)
		end
	end
end

-- The item's parts are not known on this player's machine yet: a reader that indexes them would fail here.
local function parts_missing(obj)
	return parts_eval ~= nil and obj ~= nil and C().active() and coop_mode.is_player_mirror() and has_parts(obj)
		and not read_parts(obj:id())
end

-- A reader that waited for the parts of an item the authority refused: told, as a refused action is.
local function say_unknown()
	local msg = C().text("st_coop_guard_failed", "Co-op: this action could not be done on a client.")
	if db.actor and news_manager and news_manager.send_tip then pcall(news_manager.send_tip, db.actor, msg, nil, "swiss_knife", 6000) end
end

-- A read the player started (an action, a gun taken in hand) asks again even while an ask is out: that one may be lost.
-- Cells and other passive reads share the ask that is out.
local function ask_now(obj)
	return request_parts(obj, true)
end

local function parts_gui()
	local inv = rawget(_G, "ui_inventory")
	local gui = inv and inv.GUI
	return gui and gui:IsShown() and type(gui.CC) == "table" and gui or nil
end

local function has_parts_cell(id, gui)
	gui = gui or parts_gui()
	if not gui then return false end
	for _, cc in pairs(gui.CC) do
		local ok, cell = pcall(function() return cc:GetCell_ID(id) end)
		if ok and cell then return true end
	end
	return false
end

-- Runs f(obj) once the parts of `obj` are known on this machine: at once when they are (or the item has none, or this
-- process is no player's mirror). A reader of G.A.M.M.A. that indexes the table goes through here (a disassembly, the
-- workshop's scheme, a field strip): it never gets a stand-in table, it waits for the authority's (asked for now), and a
-- refusal ends it with a word. One round trip at most: the authority gives a player's item its table as he gets it
-- (player_takes). Returns what f returns when it ran now.
function with_parts(obj, f)
	if not parts_missing(obj) then return f(obj) end
	if not ask_now(obj) then return say_unknown() end
	local id = obj:id()
	local list = parts_after[id]
	if not list then
		list = {}
		parts_after[id] = list
	end
	list[#list + 1] = { f = f, name = obj:name() }
end

-- The readers whose item's parts came: each runs once, on the same item.
local function run_after()
	local ready = {}
	for id in pairs(parts_after) do
		if read_parts(id) then ready[#ready + 1] = id end
	end
	for _, id in ipairs(ready) do
		local list = parts_after[id]
		parts_after[id] = nil
		local obj = level.object_by_id(id)
		for _, e in ipairs(list) do
			if obj and obj:name() == e.name then
				local ok, err = pcall(e.f, obj)
				if not ok then C().report("item_state", "parts reader", err) end
			end
		end
	end
end

-- An ask whose answer may be lost on its way: asked again now while the item is here without
-- parts. Events only, never a timer: the world back, the player's map led by another process, the item coming online here.
local function ask_again(id)
	local asked = parts_asked[id]
	local obj = asked and level.object_by_id(id)
	if obj and obj:name() == asked.name and not released_since(id, asked.tick) and has_parts(obj) and not read_parts(id)
		and (not asked.refused or parts_after[id] or has_parts_cell(id)) then
		if ask_now(obj) then return end
	end
	parts_asked[id], parts_queries[id] = nil, nil
end

local function ask_all_again()
	if not coop_mode.is_player_mirror() then return end
	local ids = {}
	for id in pairs(parts_asked) do ids[#ids + 1] = id end
	for _, id in ipairs(ids) do ask_again(id) end
end

-- The world: who leads each player's map (the srv layer's hook levels.bridge_of_player; the co-op has none, its host
-- leads the one map). When that changes (a map server came, went or was replaced), what he asked of the old one may be
-- lost with it: he hears so and asks again.
local function watch_routes()
	if not coop_mode.decides_world() then return end
	local bridge_of = coop_mode.hook("levels.bridge_of_player")
	if not bridge_of then return end
	local now = routes_spare or {}
	routes_spare = nil
	for id in pairs(now) do now[id] = nil end
	for _, p in ipairs(coop_util.players()) do
		if type(p.id) == "number" and not p.is_self then
			local ok, b = pcall(bridge_of, p.id)
			b = ok and tonumber(b) or 0
			now[p.id] = b
			if routes[p.id] ~= nil and routes[p.id] ~= b then C().to_peer(p.id, "wpo_eval_again", { r = b }) end
		end
	end
	routes, routes_spare = now, routes
end

local function evaluate_parts(obj, ...)
	if not C().active() then return parts_eval(obj, ...) end
	if not obj then return end
	if coop_mode.leads_here() then return parts_eval(obj, ...) end
	if not coop_mode.is_player_mirror() then return end
	local id = obj:id()
	if read_parts(id) then
		-- GAMMA keeps an existing table in step with the item's condition (armour re-evaluates, a weapon returns at
		-- once). The condition of what this player carries is his word, so his machine does that edit, as with a strip.
		if owns(id) then return parts_eval(obj, ...) end
		return
	end
	if has_parts(obj) then request_parts(obj) end
end

-- The parts this authority has of item `id`, to one player. fill: only where his machine has none (an answer to his ask).
function send_parts(peer, id, fill)
	local value = read_parts(id)
	if value then return coop_economy_mdata.send_se(peer, id, PARTS, value, fill) end
	return false
end

-- An answer of this authority, counted and in the log
local function wpo_answered(kind, from, hid, name)
	wpo[kind] = wpo[kind] + 1
	wpo_say("answer to peer %s: %d [%s] %s", tostring(from), hid, tostring(name), kind)
end

local function answer_parts(t, from)
	local hid = tonumber(t.w)
	if not (hid and hid > 0 and hid < 65535 and hid % 1 == 0 and type(t.name) == "string") then return end
	local id = C().lid(hid)
	if not id then return end
	local se = alife_object(id)
	local obj = level.object_by_id(id)
	local who = C().avatar(from)
	local why -- why it is refused, for the log and coop_status
	if not coop_mode.leads_here() then
		why = "this process leads no map"
	elseif not se then
		why = "no such item here"
	elseif not who then
		why = "his character is not here"
	elseif se:name() ~= t.name then
		why = "another item under this id"
	else
		local root = C().root_of(id)
		local at = level.object_by_id(root) or obj
		if root == who:id() or (at and at:position():distance_to_sqr(who:position()) <= 12 * 12) then
			local known = read_parts(id)
			local em = C().mod("coop_economy_mdata")
			local cloning = em and em.clone_pending and em.clone_pending(id)
			if not known and obj and has_parts(obj) and not cloning then
				-- The first roll goes to everybody on the SE lane in this frame, the asker too, once: a second copy (a
				-- direct answer as well) could come after his own edit of his own item and undo it.
				parts_eval(obj)
				if read_parts(id) then
					wpo_answered("rolled", from, hid, t.name)
					if flush_se and coop_economy_core.live() then flush_se() end
					return
				end
				why = "the roll gave no table"
			end
			-- Known here already: he missed it, or it is on its way to him; his machine keeps a table it has.
			if known and send_parts(from, id, true) then return wpo_answered("known", from, hid, t.name) end
			if not known and not obj then
				local waiting = parts_waiting[id]
				local stamp = instance(id)
				if stamp == t.name then stamp = nil end -- initial replication can stamp the same entity later
				if not waiting or waiting.name ~= t.name or released_since(id, waiting.tick) then
					local _, now = ticks()
					waiting = { name = t.name, stamp = stamp, tick = now, peers = {} }
					parts_waiting[id] = waiting
				end
				waiting.peers[from] = t
				return wpo_answered("waiting", from, hid, t.name)
			end
			why = why or known and "the table could not be sent" or cloning and "a clone of it is under way"
				or "it has no parts list"
		else
			why = "his character is farther than 12 m"
		end
	end
	-- The world authority can receive the ask itself while there is no map route for this player.
	local unrouted = coop_mode.decides_world() and not coop_mode.leads_here()
	wpo.denied = wpo.denied + 1
	wpo.why[why] = (wpo.why[why] or 0) + 1
	wpo_say("answer to peer %s: %d [%s] refused: %s%s", tostring(from), hid, t.name, why, unrouted and " (no map route)" or "")
	C().to_peer(from, "wpo_eval_no", { w = hid, name = t.name, q = t.q, unrouted = unrouted or nil })
end

local function answer_online_parts()
	for id, waiting in pairs(parts_waiting) do
		-- an asker who is no longer on this map hears a refusal: he asks again where he is when he reads the item
		for peer, t in pairs(waiting.peers) do
			if not C().avatar(peer) then
				waiting.peers[peer] = nil
				C().to_peer(peer, "wpo_eval_no", t)
			end
		end
		local se = alife_object(id)
		local replaced = not se or se:name() ~= waiting.name or released_since(id, waiting.tick)
			or (waiting.stamp and instance(id) ~= waiting.stamp)
		if not next(waiting.peers) then
			parts_waiting[id] = nil
		elseif replaced or level.object_by_id(id) then
			parts_waiting[id] = nil
			for peer, t in pairs(waiting.peers) do
				if replaced then C().to_peer(peer, "wpo_eval_no", t) else answer_parts(t, peer) end
			end
		end
	end
end

local function refresh_parts_cell(id)
	local gui = parts_gui()
	if not gui then return end
	local obj = level.object_by_id(id)
	if not obj then return end
	for _, cc in pairs(gui.CC) do
		local ok, err = pcall(function() if cc:GetCell_ID(id) then cc:UpdateItem(obj) end end)
		if not ok then C().report("item_state", "parts cell", err) end
	end
end

local function parts_changed(id, key)
	if key ~= PARTS then return end
	local asked = parts_asked[id]
	if asked and asked.sent and read_parts(id) then
		wpo.answered = wpo.answered + 1
		wpo_say("table of %d [%s] here, %d ms after the ask", asked.w, asked.name, time_global() - (asked.at or time_global()))
	end
	parts_asked[id], parts_queries[id] = nil, nil
	parts_dirty[id] = true
end

local function bind_parts_jamming(jam)
	local function active_gun()
		return db.actor and db.actor.active_item and db.actor:active_item()
	end
	local function missing_state(gun)
		return C().active() and coop_mode.is_player_mirror() and gun and jam.has_parts(gun) and not read_parts(gun:id())
	end
	local wrapped = C().wrap(jam, "unjam", "item_state.parts_unjam", function(orig)
		return function(wpn, ...)
			local gun = wpn or active_gun()
			if not missing_state(gun) then return orig(wpn, ...) end
			local explicit, n, args = wpn ~= nil, select("#", ...), { ... }
			return with_parts(gun, function(item)
				local current = not explicit and active_gun()
				if owns(item:id()) and (explicit or current and current:id() == item:id()) then
					return orig(item, unpack(args, 1, n))
				end
			end)
		end
	end)
	-- The inventory's custom action retained the old function at the mod's start.
	local add_functor = C().fn(C().mod("custom_functor_autoinject"), "add_functor")
	if wrapped and add_functor and C().fn(jam, "check_unjam") and C().fn(jam, "string_unjam") then
		add_functor("arti_unjam", jam.check_unjam, jam.string_unjam, nil, jam.unjam, false)
	end
	local update_jam = C().fn(jam, "actor_on_update") or C().find_local(jam, "actor_on_update")
	if not update_jam then return end
	-- arti_jamming keeps the gun in hand as its update last read it (cgd): the shot and jam callbacks use it. While the
	-- gun in hand has no parts here that update does not run, so GAMMA's own reset (as after a repair) takes the previous
	-- gun's data off it. The gun is asked for when it is taken in hand; after a refusal, again on the next equip or shot.
	local waiting_gun
	local function wait_for(gun)
		local id = gun:id()
		if waiting_gun == id then return end
		waiting_gun = id
		ask_now(gun)
		local current = C().fn(jam, "current_id") and jam.current_id()
		if current ~= nil and current ~= 0 and C().fn(jam, "reset_cgd") then jam.reset_cgd() end
	end
	C().swap_callback("actor_on_update", update_jam, function(...)
		local gun = active_gun()
		if missing_state(gun) then return wait_for(gun) end
		waiting_gun = nil
		return update_jam(...)
	end)
	RegisterScriptCallback("actor_on_weapon_before_fire", function()
		local gun = active_gun()
		if not missing_state(gun) then return end
		local asked = parts_asked[gun:id()]
		if asked and asked.shot and not asked.refused and asked.name == gun:name()
			and not released_since(gun:id(), asked.tick) then return end
		local query = ask_now(gun)
		if query then query.shot = true end
	end)
end

local function bind_favorite_parts()
	local favorite = C().mod("indirect_parts_favoriter")
	local wrapped = C().wrap(favorite, "init_favorite_parts_menu", "item_state.parts_favorite_menu", function(orig)
		return function(obj, bag, mode)
			if not parts_missing(obj) then return orig(obj, bag, mode) end
			local gui = parts_gui()
			return with_parts(obj, function(item)
				if gui and parts_gui() == gui and has_parts_cell(item:id(), gui) then return orig(item, bag, mode) end
			end)
		end
	end)
	C().wrap(favorite, "act_favorite_part", "item_state.parts_favorite_action", function(orig)
		return function(id, sec, mode)
			if not (C().active() and coop_mode.is_player_mirror() and (mode == 2 or mode == 3)) then return orig(id, sec, mode) end
			local obj = level.object_by_id(id)
			if not obj then return say_unknown() end
			return with_parts(obj, function(item) return orig(item:id(), sec, mode) end)
		end
	end)
	-- Refresh the action registered by value with the inventory's custom functors.
	if wrapped and C().fn(favorite, "on_game_start") then favorite.on_game_start() end
end

-- Readers of G.A.M.M.A. that index the parts table of an item at once, without a check. Bound at the first update: the
-- mods that replace them (item_parts_repair_notifications and its zzzz_ twin, the workshop's nearby-stashes patch) have
-- done so at their load by then; coop_mods_items puts its take-first wrappers around these again, outermost.
local AUTOLOOTER_READS = { -- the option that makes the filter read the parts: { config key, options table, value }
	cond_weapon_disassemble = { "disassemble_weapon", "disassemble_weapon_options", "with_usable_barrel" },
	cond_armor_disassemble = { "disassemble_armor", "disassemble_armor_options", "with_usable_parts" },
}

local readers_bound = false
local function bind_parts_readers(parts)
	if readers_bound then return end
	readers_bound = true
	bind_favorite_parts()
	-- Not tasks_fetch's reward (tasks_fetch.script:185): a turn-in ends on the deciding side only (coop_tasks), and the router
	-- keeps the mod's timer there by the chunk of its function (tasks_fetch = host). A coop_* wrapper of it runs everywhere.
	C().wrap(C().mod("NimbleTrade"), "has_bad_part", "item_state.parts_nimble", function(orig)
		return function(minimum, obj, ...)
			if parts_missing(obj) then
				request_parts(obj)
				return true -- Nimble's good_gun negates this predicate.
			end
			return orig(minimum, obj, ...)
		end
	end)
	-- A disassembly of an own item (by hand, or the Autolooter's after coop_mods_items has taken it) waits for its parts.
	for _, key in ipairs({ "disassembly_weapon", "disassembly_outfit" }) do
		C().wrap(parts, key, "item_state.parts_" .. key, function(orig)
			return function(obj, obj_d, ...)
				if not (C().active() and type(obj) ~= "number" and obj and obj.id and owns(obj:id())) then
					return orig(obj, obj_d, ...)
				end
				local n, args, tool = select("#", ...), { ... }, obj_d and obj_d:id()
				return with_parts(obj, function(item)
					local d = tool and level.object_by_id(tool)
					if tool and not (d and owns(tool)) then return end -- the tool went meanwhile
					if owns(item:id()) then return orig(item, d, unpack(args, 1, n)) end
				end)
			end
		end)
	end
	-- The workshop's parts scheme (ui_workshop.script:594 parts_con[...]) is drawn when the selected item's parts are here,
	-- and only while it is still the selected one.
	local ws = C().mod("ui_workshop")
	local ok, repair = pcall(function() return ws and ws.UIWorkshopRepair end)
	if ok and repair then
		-- drawn[page]: the item whose scheme the page shows (false: none drawn, the selected item's parts are awaited). While
		-- they are, the page still shows the scheme of the item selected before, and WPO's Repair writes the page's scheme into
		-- the selected item (zzzz_arti_jamming_repairs Repair: item_parts.set_parts_con(id, ...)): a table this machine made up.
		local drawn = setmetatable({}, { __mode = "k" })
		local function selected(page)
			local got, obj = pcall(function() return page.CC["inventory"]:GetCell_Selected(true) end)
			return got and obj or nil
		end
		C().wrap(repair, "ListPartScheme", "item_state.parts_workshop", function(orig)
			return function(page, ...)
				local obj = selected(page)
				if not obj then return orig(page, ...) end
				local id, n, args = obj:id(), select("#", ...), { ... }
				if parts_missing(obj) then drawn[page] = false end
				return with_parts(obj, function()
					local now = selected(page)
					if now and now:id() == id then
						drawn[page] = id
						return orig(page, unpack(args, 1, n))
					end
				end)
			end
		end)
		-- A repair goes to the item whose scheme is on the page, never to another one (a player's machine only).
		C().wrap(repair, "Repair", "item_state.parts_workshop_repair", function(orig)
			return function(page, ...)
				local shown = drawn[page]
				local obj = shown ~= nil and C().active() and coop_mode.is_player_mirror() and selected(page)
				if obj and obj:id() ~= shown then return say_unknown() end
				return orig(page, ...)
			end
		end)
	end
	-- The Autolooter's disassembly filters (z_auto_looter cond_*_disassemble) read the parts of loot with the options that
	-- ask for usable parts: loot whose parts are not here is not taken apart this time (asked for; the next run decides).
	local al = C().mod("z_auto_looter")
	for key, how in pairs(AUTOLOOTER_READS) do
		C().wrap(al, key, "item_state.parts_" .. key, function(orig)
			return function(obj, ...)
				if parts_missing(obj) then
					local cfg = type(al.config) == "table" and al.config or nil
					local mcm = C().mod("auto_looter_mcm")
					local options = mcm and type(mcm[how[2]]) == "table" and mcm[how[2]] or nil
					if not (cfg and options) or cfg[how[1]] == options[how[3]] then
						request_parts(obj)
						return false
					end
				end
				return orig(obj, ...)
			end
		end)
	end
end

-- The authority of the map (the co-op host; the map server of the level): an item comes into a player's character here,
-- whatever brought it (a take of loot, a pickup, a purchase, a reward or a craft product created for him). Single player
-- rolls its parts right then (item_parts actor_on_item_take); a player's machine never rolls, so the authority does it
-- here, with GAMMA's own roll from this machine's condition, and sends the table in this frame, with the item's move. A
-- table that exists is never rolled again (his machine keeps an own item's table in step with its wear). In the server
-- mode the world server has no player's map and no game object of his items: an item it creates for him gets its table
-- on the map server of his map, when the item comes into his character there.
local function player_takes(npc, obj)
	if not (parts_eval and npc and obj and C().active() and coop_mode.leads_here()) then return end
	if not C().is_remote_player(npc:id()) then return end
	local id = obj:id()
	local em = C().mod("coop_economy_mdata")
	if read_parts(id) or (em and em.clone_pending and em.clone_pending(id)) or not has_parts(obj) then return end
	local ok, err = pcall(parts_eval, obj)
	if not ok then return C().report("item_state", "parts on take", err) end
	if flush_se and coop_economy_core.live() then flush_se() end
end

-------------------------------------------------------------------------------
-- coop_status lines. "wpo": the asks and answers of this process. "wpo_census": the items with a parts list
-- this process knows, with a table and without, those without by their holder (read only: it walks the entities when the
-- command runs). On a player's machine "without" is what he would see without parts; on the world server what it does not
-- keep; on the authority of a map what nobody has looked at or taken yet (single player rolls those on the first look too).
-------------------------------------------------------------------------------
function status_text()
	local out, oldest, t = 0, nil, time_global()
	for _, q in pairs(parts_asked) do
		if q.sent and not q.refused then
			out = out + 1
			local age = t - (q.at or t)
			if not oldest or age > oldest then oldest = age end
		end
	end
	local why = {}
	for reason, n in pairs(wpo.why) do why[#why + 1] = reason .. " " .. n end
	table.sort(why)
	local waiting = 0
	for _ in pairs(parts_waiting) do waiting = waiting + 1 end
	return string.format("asks sent %d (out %d%s), answered %d, refused %d (no map route %d) | answers given: rolled %d, known %d, "
		.. "waiting %d (%d wait now), refused %d%s", wpo.asked, out, oldest and string.format(", the oldest %d s", math.floor(oldest / 1000)) or "",
		wpo.answered, wpo.refused, wpo.unrouted, wpo.rolled, wpo.known, wpo.waiting, waiting, wpo.denied,
		#why > 0 and (" [" .. table.concat(why, ", ") .. "]") or "")
end

-- Only a creature's server object has alive(). A game object has it for everything, and for a box or a stash the engine
-- answers false after writing "cannot access class member Alive!" with the whole Lua stack (script_game_object_use.cpp):
-- such a box counted as a body, one error per item. So the game object is not asked.
local function census_holder(id, root)
	if root == id then return "ground" end
	if C().is_player(root) then return "players" end
	local se = alife_object(root)
	if se and type(se.alive) == "function" then
		local ok, v = pcall(se.alive, se)
		if ok and v == true then return "npcs" end
		if ok and v == false then return "bodies" end
	end
	return "boxes"
end

function census_text()
	local im = C().mod("itms_manager")
	local ini = im and im.ini_parts
	if not ini then return "no parts lists (Weapon Parts Overhaul is not here)" end
	local m = data()
	local records = m and m.se_object
	local listed, n, with, stamped = {}, 0, 0, 0
	local without = { bodies = 0, npcs = 0, boxes = 0, ground = 0, players = 0 }
	for id = 1, 65534 do
		local se = alife_object(id)
		local ok, sec = false, nil
		if se then ok, sec = pcall(se.section_name, se) end
		if ok and type(sec) == "string" then
			if listed[sec] == nil then
				local list = ini:r_string_ex("con_parts_list", ini_sys:r_string_ex(sec, "parent_section") or sec)
				listed[sec] = type(list) == "string" and list ~= ""
			end
			if listed[sec] then
				n = n + 1
				if records and type(records[id]) == "table" and records[id]._coop_instance then stamped = stamped + 1 end
				if read_parts(id) then
					with = with + 1
				else
					local kind = census_holder(id, C().root_of(id) or id)
					without[kind] = without[kind] + 1
				end
			end
		end
	end
	return string.format("%d with a parts list, %d with a table, %d without (bodies %d, npcs %d, boxes %d, ground %d, players %d), "
		.. "%d stamped", n, with, n - with, without.bodies, without.npcs, without.boxes, without.ground, without.players, stamped)
end

function install_parts(parts, jam)
	if parts_eval then return end
	C().wrap(parts, "evaluate_parts", "item_state.parts", function(orig)
		parts_eval = orig
		return evaluate_parts
	end)
	C().wrap(parts, "get_parts_con", "item_state.parts_read", function(orig)
		return function(obj, id, ...)
			local value = orig(obj, id, ...)
			if type(value) ~= "table" or not C().active() or not coop_mode.is_player_mirror()
				or owns(obj and obj:id() or id) then return value end
			-- Focus and tooltip mods also obtain this table. Their in-place
			-- edits must not change the mirror of a world-owned item.
			local copy = {}
			for key, condition in pairs(value) do copy[key] = condition end
			return copy
		end
	end)
	local em = C().mod("coop_economy_mdata")
	if em then em.on_se_value(parts_changed) end
	local function batch_size(t)
		local n = tonumber(t.n)
		if not n or n % 1 ~= 0 or n < 1 or n > MAX_PART_QUERIES then return nil end
		return n
	end
	C().on("wpo_eval", function(t, from)
		local n = batch_size(t)
		if not n then return end
		for i = 1, n do answer_parts({ w = t["w" .. i], name = t["s" .. i], q = t["q" .. i] }, from) end
	end, "host")
	-- An ask the flood limit drops is refused like any other: the asker's ask is released and he asks again when he
	-- reads the item next. Silent, it stayed asked, and the item never got its parts on his machine.
	C().set_limit("wpo_eval", 20, 10, function(t, from)
		local n = batch_size(t)
		if not n then return end
		local no = { n = n }
		for i = 1, n do no["w" .. i], no["s" .. i], no["q" .. i] = t["w" .. i], t["s" .. i], t["q" .. i] end
		wpo.denied = wpo.denied + n
		wpo.why["over the ask limit"] = (wpo.why["over the ask limit"] or 0) + n
		wpo_say("answer to peer %s: %d asks refused: over the ask limit", tostring(from), n)
		C().to_peer(from, "wpo_eval_no", no)
	end)
	-- A refusal only ends the ask it answers. Keep the demand of open cells and readers waiting for a map route.
	local function release_ask(hid, name, q, unrouted)
		local id = C().lid(tonumber(hid))
		local asked = id and parts_asked[id]
		if not (asked and asked.sent and not asked.refused and asked.name == name) then return end
		if q == nil then
			if asked.overlap or parts_after[id] then return end
		elseif tonumber(q) ~= asked.q then return end
		wpo.refused = wpo.refused + 1
		if unrouted then wpo.unrouted = wpo.unrouted + 1 end
		wpo_say("refused by the authority: %d [%s]%s", asked.w, name, unrouted and " (no map route; asked again when one comes)" or "")
		if not unrouted and parts_after[id] then
			parts_after[id] = nil
			say_unknown()
		end
		if parts_after[id] or has_parts_cell(id) then
			asked.refused = true
		else
			parts_asked[id] = nil
		end
	end
	C().on("wpo_eval_no", function(t)
		if t.n == nil then return release_ask(t.w, t.name, t.q, t.unrouted == true) end
		local n = batch_size(t)
		if not n then return end
		for i = 1, n do release_ask(t["w" .. i], t["s" .. i], t["q" .. i]) end
	end, "client")
	-- Lost asks: asked again on events. The world says his map is led by another process now; the
	-- world is back after its move; the item came online on his machine.
	C().on("wpo_eval_again", ask_all_again, "client")
	RegisterScriptCallback("coop_world_back", ask_all_again)
	RegisterScriptCallback("game_object_on_net_spawn", function(obj)
		local id = obj and obj:id()
		if id and parts_asked[id] and coop_mode.is_player_mirror() then ask_again(id) end
	end)
	RegisterScriptCallback("npc_on_item_take", player_takes)
	C().status_line("wpo", status_text)
	C().status_line("wpo_census", census_text)
	RegisterScriptCallback("actor_on_update", flush_parts_queries)
	RegisterScriptCallback("actor_on_first_update", function()
		bind_parts_jamming(jam)
		bind_parts_readers(parts)
	end)
end

local function capture(s, id, npc)
	if applying or not C().active() or not id or not (owns(id) or (npc and coop_mode.leads_here())) then return end
	local em = C().mod("coop_economy_mdata")
	if em and em.clone_pending and em.clone_pending(id) then return end
	local stamp, tbl, m = instance(id), live(s), data()
	if not stamp or type(tbl) ~= "table" or not m then return end
	local state = copy_state(s, tbl[id])
	if state == nil then return end
	local previous = m[s.key] and m[s.key][id]
	if not previous and (state == false or state == 0) then return end
	local record = { instance = stamp, state = state }
	if previous and C().ser(previous) == C().ser(record) then return end
	store(s, id, record)
	seen[id] = stamp
	-- The existing channel checks sender/ownership/instance, bounds its payload and
	-- relays map facts through the world. A receiver never calls this writer.
	se_save_var(id, nil, s.key, record)
	-- Queue the rider for transport in the action's frame. Waiting for the
	-- economy poll can leave it behind an immediate inventory transfer.
	if flush_se and coop_economy_core.live() then flush_se() end
end

local function sync_item(obj)
	if not C().active() or not obj or not obj.id then return end
	local id = obj:id()
	observe(id)
	restore(id)
	refresh(id)
	if parts_eval and coop_mode.is_player_mirror() and owns(id) then evaluate_parts(obj) end
end

local function unregister_item(se)
	if not C().active() or not se or not se.id then return end
	local id = se.id
	parts_asked[id], parts_queries[id], parts_dirty[id], parts_after[id] = nil, nil, nil, nil
	-- Seen here: what this script keeps of the id from now on (a clone's source) is kept on purpose.
	local _, now = ticks()
	since[id] = now
	if coop_economy_mdata.clone_pending(id) then return end
	local m = data()
	if not m then return end
	local stamp = instance(id) or seen[id] or se:name()
	retired[id] = nil
	for _, s in ipairs(specs) do
		local records = m[s.key]
		local record = records and records[id]
		if type(record) == "table" and same_item(id, record.instance, stamp) then
			-- Stock alife_clone_weapon unregisters before after_clone. Keep
			-- its source through that call without exposing it under the old ID.
			retired[id] = retired[id] or {}
			retired[id][s.key] = record
		end
		if records then records[id] = nil end
		local tbl = live(s)
		if tbl then tbl[id] = nil end
	end
	seen[id], pending[id] = nil, nil
end

-- The walk of the actor's inventory: every item is observed (a first sight restores its saved riders), and captured
-- only when the mod's table or the storage has a rider of it: without one, capture has nothing to write.
local walk_m, walk_live = nil, {}
local function walk_item(_, obj)
	local id = obj:id()
	observe(id, walk_m)
	for i, s in ipairs(specs) do
		local tbl, records = walk_live[i], walk_m and walk_m[s.key]
		if (type(tbl) == "table" and tbl[id] ~= nil) or (records and records[id] ~= nil) then capture(s, id) end
	end
end

local function capture_inventory()
	if not C().active() or not coop_mode.actor_is_player() or not db.actor then return end
	walk_m = data()
	for i, s in ipairs(specs) do walk_live[i] = live(s) end
	db.actor:iterate_inventory(walk_item, db.actor)
	walk_m = nil
end

local function restore_all()
	if not C().active() then return end
	local current = data()
	if storage ~= nil and storage ~= current then
		parts_asked, parts_queries, parts_dirty, parts_waiting, parts_after, routes = {}, {}, {}, {}, {}, {}
	end
	seen, pending, retired, since, storage = {}, {}, {}, {}, current
	local ids = {}
	for _, s in ipairs(specs) do
		for id in pairs(storage and storage[s.key] or {}) do ids[id] = true end
	end
	for id in pairs(ids) do observe(id) restore(id) end
end

local function update()
	if not C().active() then return end
	if storage ~= data() then restore_all() end
	if next(parts_waiting) then answer_online_parts() end
	watch_routes()
	local dirty = parts_dirty
	if next(dirty) then
		-- What a cell's redraw marks goes to the other table, for the next frame.
		parts_dirty, parts_dirty_spare = parts_dirty_spare or {}, nil
		for id in pairs(dirty) do refresh_parts_cell(id) end
		for id in pairs(dirty) do dirty[id] = nil end
		parts_dirty_spare = dirty
	end
	if next(parts_after) then run_after() end
	if next(retired) then retired = {} end
	if next(pending) then
		-- apply can forget a released instance's pending entries (fresh): never re-add a key while pairs walks them.
		local ids = {}
		for id in pairs(pending) do ids[#ids + 1] = id end
		for _, id in ipairs(ids) do
			for _, s in ipairs(specs) do
				local record = pending[id] and pending[id][s.key]
				if record then apply(s, id, record) end
			end
		end
	end
	capture_inventory()
end

local function wrap_change(s, name, active_weapon)
	local mod = C().mod(s.module)
	local wrapped, original = C().wrap(mod, name, "item_state." .. s.module .. "." .. name, function(orig)
		return function(obj, ...)
			if not C().active() then return orig(obj, ...) end
			local target = not active_weapon and obj or nil
			if not target and db.actor and db.actor.active_item then target = db.actor:active_item() end
			local id = type(target) == "number" and target or target and target:id()
			if id then observe(id) end
			local result = orig(obj, ...)
			capture(s, id)
			return result
		end
	end)
	if wrapped and active_weapon then C().swap_callback(name, original, mod[name]) end
end

local function install_mods()
	local camo = C().mod(specs[1].module)
	if camo then
		wrap_change(specs[1], "select_camo")
		C().wrap(camo, "assign_drop_camo", "item_state.npc_camo", function(orig)
			return function(obj, ...)
				if not C().active() then return orig(obj, ...) end
				if not coop_mode.leads_here() then return false end
				if obj then observe(obj:id()) end
				local result = orig(obj, ...)
				if obj then capture(specs[1], obj:id(), true) end
				return result
			end
		end)
	end
	if C().mod(specs[2].module) then
		for _, name in ipairs({ "set_jam_status", "unset", "timed_unjam" }) do wrap_change(specs[2], name) end
		for _, name in ipairs({ "unjam", "unjam_replace" }) do wrap_change(specs[2], name) end
		wrap_change(specs[2], "actor_on_weapon_jammed", true)
	end
end

local function install_riders()
	local em = C().mod("coop_economy_mdata")
	if not em then return end
	receive_item = assert(C().find_local(em, "on_imd"), "economy item receiver missing")
	flush_se = assert(C().find_local(em, "se_flush"), "economy SE flush missing")
	local se_signatures = assert(C().upvalue(em.apply_se, "se_sig"), "economy SE signatures missing")
	em.admit(admit_riders)
	for _, s in ipairs(specs) do
		em.declare_item_key(s.key, { apply = function(id, value)
			if not C().active() then return end
			-- nil: the economy has no rider of this weapon. clone_activate gives it for a weapon spawned or cloned with none
			-- (every mirrored weapon spawn carries a clone initial), carry_release for a kept clear. A peer's malformed
			-- rider never gets here as nil: admit_riders checks the wire before the economy. So no trust check (it would
			-- log "invalid weapon rider" once per weapon of a trader's restock); the SE copy decides.
			if value ~= nil and apply(s, id, value) then
				-- A newer admitted item rider also supersedes an already queued SE value.
				if coop_mode.decides_world() and not em.clone_pending(id) then em.apply_se(id, s.key, value) end
				return
			end
			-- item_store has already replaced the saved rider. Recover the
			-- SE copy so a bad update can't erase the jam on the next load.
			local m = data()
			if m then restore_se(s, id, m) end
		end })
	end
	em.on_se_value(function(id, key)
		if not coop_mode.decides_world() then return end
		local s = specs_by_key[key]
		if not s then return end
		local m = data()
		local value = m and m.se_object and m.se_object[id] and m.se_object[id][key]
		local ec = C().mod("coop_economy_core")
		-- SE retries write their queued value without updating the signature.
		-- Keep the last admitted value of this instance in both save tables.
		local packed = se_signatures[tostring(C().hid(id)) .. "\0" .. key]
		if packed and type(value) == "table" and packed ~= ec.pack(value) then
			local latest = ec.unpack(packed)
			if type(latest) == "table" and same_item(id, latest.instance, value.instance) and apply(s, id, latest) then
				em.quietly(se_save_var, id, nil, key, latest)
				store(s, id, latest)
				return
			end
		end
		if apply(s, id, value) then store(s, id, value) end
	end)
	C().wrap(em, "clone_export", "item_state.clone_export", function(orig)
		return function(id, ...)
			if not C().active() then return orig(id, ...) end
			if not em.clone_pending(id) then observe(id) end
			for _, s in ipairs(specs) do capture(s, id) end
			local before = instance(id)
			local packed = orig(id, ...)
			local stamp = instance(id)
			if C().active() and packed and stamp and stamp ~= before then
				-- clone_export(id, stamp) has just given the SAME source an instance.
				-- Rebase before exporting again, including a later rejected transaction.
				local m = data()
				for _, s in ipairs(specs) do
					local record = m and m[s.key] and m[s.key][id]
					if type(record) == "table" and same_item(id, record.instance, before) then
						local rebound = { instance = stamp, state = record.state }
						store(s, id, rebound)
						se_save_var(id, nil, s.key, rebound)
					end
				end
				seen[id] = stamp
				packed = orig(id)
			end
			return packed
		end
	end)
	C().wrap(em, "after_clone", "item_state.after_clone", function(orig)
		return function(old_id, new_id, ...)
			if C().active() and new_id and not em.clone_pending(new_id) then
				local m, stamp = data(), instance(new_id)
				local source_stamp = old_id and (instance(old_id) or seen[old_id])
				local released = old_id and not alife_object(old_id) and retired[old_id]
				if released then retired[old_id] = nil end
				for _, s in ipairs(specs) do
					local records = m and m[s.key]
					local record = records and records[new_id]
					if type(record) ~= "table" or not same_item(new_id, record.instance, stamp) then
						local source = records and records[old_id]
						record = type(source) == "table" and same_item(old_id, source.instance, source_stamp) and source
							or released and released[s.key]
					end
					if record and stamp then
						record = { instance = stamp, state = record.state }
						store(s, new_id, record) apply(s, new_id, record)
						se_save_var(new_id, nil, s.key, record)
					end
				end
			end
			return orig(old_id, new_id, ...)
		end
	end)
end

-- engine/src/xrCoop/coop_item_rider_rules.h: a client's move of its weapon is applied when the request
-- arrives, its se copy of the same change waits in a Lua inbox and is checked there against the next holder. So the
-- request carries the riders, and the process that applies the move writes them first, under its own holder check.

-- coop_requests.cpp send_action, on a client: the weapon `id` (local) leaves this character in a ReqDrop / ReqTransfer.
-- The text goes with the request; nil: nothing to carry.
function carry(id)
	if not C().active() or type(id) ~= "number" then return nil end
	local m, ec, cm = data(), C().mod("coop_economy_core"), C().mod("coop_main")
	local stamp = instance(id)
	if not (m and ec and cm and stamp) then return nil end
	local t, n = {}, 0
	for _, s in ipairs(specs) do
		capture(s, id) -- a direct write of the mod's table in this frame, before the next poll saw it
		local record = type(m[s.key]) == "table" and m[s.key][id]
		if type(record) == "table" and same_item(id, record.instance, stamp) and copy_state(s, record.state) ~= nil then
			local packed = ec.pack(record)
			if type(packed) == "string" and #packed <= MAX_PACKED then
				n = n + 1
				t["i" .. n], t["k" .. n], t["d" .. n], t["x" .. n] = C().hid(id), s.key, packed, stamp
			end
		end
	end
	local parts = parts_eval and owns(id) and read_parts(id)
	if parts and valid_parts(parts) then
		local packed = ec.pack(parts)
		if #packed <= MAX_PACKED then t.parts, t.parts_instance = packed, stamp end
	end
	if n == 0 and not t.parts then return nil end
	t.n = n
	local text = cm.encode(t)
	return type(text) == "string" and #text <= MAX_CARRY and text or nil
end

-- coop_requests.cpp host_move, on the process that applies a player's move of a weapon his character holds (the co-op
-- host; the map server of his level), before apply_move. hid: the weapon (host numbering); from: the transport sender;
-- text: what his client's carry gave; holder: his character as the engine knows it from the sender (nil: ask the
-- roster). Checked like his se rider; written as this process's own fact through the economy's se writer: the co-op
-- host keeps and relays it, a map server's goes up to the world server, which keeps and relays a map's facts.
-- True when a rider was written.
function carried(hid, from, text, holder)
	if not C().active() then return false end
	local ec, cm, em = C().mod("coop_economy_core"), C().mod("coop_main"), C().mod("coop_economy_mdata")
	local args = ec ~= nil and cm ~= nil and em ~= nil and type(text) == "string" and #text <= MAX_CARRY
		and ec.int(hid, 1, 65534) ~= nil and ec.int(from, 0, 65535) ~= nil and (holder == nil or ec.int(holder, 0, 65534) ~= nil)
	if not coop_trust.pass("item_state_carry", args, "weapon rider carry: invalid request") or not args then return false end
	if holder == nil then
		local player = ec.player(from)
		holder = player and player.avatar_id
	end
	local owner = holder ~= nil and ec.root_of(hid) == holder
	if not coop_trust.pass("item_state_owner", owner, "item %s: sender %s is not its carrier: %s", tostring(hid),
		tostring(from), not owner and carrier_text(C().lid(hid), hid, holder, "carry") or "") or not owner then
		return false
	end
	if not carried_at[hid] then
		carried_n = carried_n + 1
		if carried_n > 256 then carried_at, carried_n = {}, 1 end
	end
	carried_at[hid] = { ms = time_global(), from = from }
	local decoded, t = pcall(cm.decode, text)
	t = decoded and type(t) == "table" and t or {}
	local n = ec.int(t.n, t.parts ~= nil and 0 or 1, #specs)
	if not coop_trust.pass("item_state_batch", n ~= nil, "weapon rider carry: invalid batch size") or not n then return false end
	local id, written = C().lid(hid), false
	if em.clone_pending(id) then return false end
	for i = 1, n do
		local s, packed, stamp = specs_by_key[t["k" .. i]], t["d" .. i], t["x" .. i]
		local wire_ok = s ~= nil and ec.int(t["i" .. i], 1, 65534) == hid and type(packed) == "string" and #packed <= MAX_PACKED
		if coop_trust.pass("item_state_wire", wire_ok, "weapon rider carry: invalid id or payload") and wire_ok then
			local record, err = ec.unpack(packed)
			local ok = coop_trust.pass("item_state_wire", err == nil, "item %s: invalid rider encoding", tostring(hid)) and err == nil
			if ok and checked_state(s, id, record) ~= nil and matches_instance(id, instance(id), record, stamp) then
				-- As capture writes the holder's change: kept, shown here, sent through the economy.
				store(s, id, record)
				apply(s, id, record)
				se_save_var(id, nil, s.key, record)
				written = true
			end
		end
	end
	if t.parts ~= nil and parts_eval then
		local packed = t.parts
		local wire_ok = type(packed) == "string" and #packed <= MAX_PACKED
			and type(t.parts_instance) == "string" and same_item(id, t.parts_instance, instance(id))
		if coop_trust.pass("item_state_wire", wire_ok, "weapon parts carry: invalid value or instance") and wire_ok then
			local value, err = ec.unpack(packed)
			local ok = err == nil and valid_parts(value)
			if coop_trust.pass("item_state_value", ok, "weapon parts carry: invalid parts table") and ok then
				se_save_var(id, nil, PARTS, value)
				written = true
			end
		end
	end
	if written and flush_se and ec.live() then flush_se() end
	return written
end

local function step(name, f)
	local ok, err = pcall(f)
	if not ok then C().report("item_state", name, err) end
end

function on_game_start()
	if installed then return end
	installed = true
	step("mods", install_mods)
	step("riders", install_riders)
	step("callbacks", function()
		RegisterScriptCallback("actor_on_update", function() step("update", update) end)
		RegisterScriptCallback("actor_on_first_update", function() step("restore", restore_all) end)
		RegisterScriptCallback("load_state", function() step("load", restore_all) end)
		RegisterScriptCallback("save_state", function() step("save", capture_inventory) end)
		RegisterScriptCallback("game_object_on_net_spawn", sync_item)
		RegisterScriptCallback("server_entity_on_unregister", unregister_item)
		RegisterScriptCallback("actor_on_item_take", sync_item)
		RegisterScriptCallback("actor_on_weapon_jammed_wpo", function(obj) if obj then capture(specs[2], obj:id()) end end)
	end)
end
