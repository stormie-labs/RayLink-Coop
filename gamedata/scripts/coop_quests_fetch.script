-- Ядро: без проверок режима (docs/MODES.md)
--[[
	In a session, fetch tasks count and take eligible items from the group.
	The mod's file is not changed.

	m15:1  xr_effects.fetch_reward_and_remove pays one second after the hand-over: CreateTimeEvent(0, "delay_reward", 1, timer).
	       The queue of the build keeps one event per key (_g_patches.script CreateTimeEvent: a key it holds is not taken again),
	       so a second hand-over within that second lost its payment, also from the same player. Every hand-over gets its own key
	       "delay_reward|<task>|<character>|<counter>" and its reward context: the character it is for (coop_tasks
	       personal_character). When the timer fires, the context coop_tasks kept for it is used as it is; when it is gone, or the
	       player's peer changed since (a reconnect: the character stays, the peer does not), the reward runs again for that
	       character (coop_tasks.with_character). A character id, never a peer.
	m15:2  One criterion of an item a fetch task takes (acceptable below): its section; not on the belt of the character who holds
	       it; the condition two tasks ask for (0.9, as coop_tasks and the stock functor); counted in units (uses of a multi-use
	       item), an artefact asked for without a condition also in its containers. The mod's own rule (a worn artefact is no
	       hand-over) held for the host's actor only, and coop_tasks counted and moved the whole group's items, worn ones included.
	       The same criterion now makes
	         - the readiness check: task_status_functor.actor_has_fetch_item (stage 1 when the group has as many as the task asks),
	         - the hand-over check: coop_tasks' host.fetch_units, which its item_short asks for a client's turn-in,
	         - the collection: the delayed reward moves the acceptable items of the other players into this process's actor (the
	           turning-in player's first), the mod's timer then sees them first and nothing it may not take.
	       A quick slot holds a section, not an item: there is no quick-slot item to leave out (the mod leaves out the belt only).
	       The take goes through coop_quests_trust.check_take / note_take (coop_trust check quest_take).

	Who decides and what it lacks, per mode:
	  Co-op:  the host's process ends the tasks. Every player's character and items are game objects there, its own player's belt
	          it reads itself. A client's belt only his machine knows.
	  Server: the world server ends the tasks. A player stands on a map server; the world server has his record (what he carries,
	          coop.levels.carried: no belt). His belt only his machine knows.
	  So in both: this process's own player's belt is read here; every other player's belt is his machine's report "fetch_belt"
	  (event mods.fetch_belt: { o = ask, t = task, n, i1..in = ids of the items of the asked section on his belt, host
	  numbering }), the answer to "fetch_belt_ask" (event mods.fetch_belt_ask: { o, s = section, t = task }). The readiness check
	  asks at most every 2 s per player and section and uses a report up to 10 s old; a hand-over asks every player who holds the
	  section again and waits up to 3 s (from the hand-over) for those answers: only an answer to its own ask counts there. A
	  report that answers no open ask of its sender is dropped (coop_trust check fetch_belt_fresh). A player whose
	  belt is not known has no loose item that counts, and none is taken from him.

	Layer: the Core, no question of the mode. It runs where the mod's effects run (the process that ends tasks); the ask is
	answered on a player's own machine (coop_mods_core side "player"), the report taken by the owner of the world data (side
	"world": the co-op host, the world server).
	Outside a session every wrapper calls the original unchanged (single player as the mod is).
--]]

local tostring, tonumber, type, pairs, ipairs, pcall, unpack, next = tostring, tonumber, type, pairs, ipairs, pcall, unpack, next
local string_format, math_max = string.format, math.max

local TAG = "fetch"
local KEY = "delay_reward" -- the mod's timer (tasks_fetch.script fetch_reward_and_remove)
local WAIT_MS = 3000 -- a hand-over waits this long (from the hand-over) for the belt reports it asked for
local ASK_MS = 2000 -- the readiness check asks a player about a section again after this long
local READY_MS = 10000 -- a belt report counts for the readiness and hand-over checks this long
local ASK_TTL_MS = 10000 -- an unanswered ask expires, then its sender is remembered for one more TTL
local MAX_ASKS = 256 -- open asks at most
local MAX_BELT = 64 -- item ids in one report
local MAX_SEC = 64 -- characters of a section name in an ask
local MAX_TASK = 128 -- characters of a task id in an ask
local MAX_OP = 2147483647
local CONTAINERS = { "lead_box", "af_aam", "af_aac", "af_iam" } -- artefact containers (the mod's suffixes)
local MIN_COND = { -- the stock actor_has_fetch_item asks for a condition on these two (coop_tasks FETCH_MIN_COND)
	esc_2_12_stalker_nimble_task_1 = 0.9,
	jup_b220_trapper_task_3 = 0.9,
}

local stats = { handovers = 0, rekeyed = 0, rescoped = 0, ready = 0, asks = 0, reports = 0, stale = 0, late = 0, moved = 0,
	unknown = 0, refused = 0 }
local handover_seq = 0
local ask_seq = 0
local ask_n = 0
local asks = {} -- ask id -> { peer, char, sec, task, at, ho }
local expired_asks = {} -- ask id -> { peer, until_at }
local belts = {} -- character -> section -> { at, ids = set of local ids }: the last report of his machine
local asked_at = {} -- "<character>|<section>" -> when the readiness check asked last

local function ct() return coop_util.module("coop_tasks") end

-- This process's world is a copy (a player's machine): the mod's effects and timers stay as they are there. The router keeps
-- tasks_fetch's timer on the deciding side (coop_route_stock.ltx: tasks_fetch = host, time_event); a timer of this script would
-- be "view" (coop_*), so it is not made there.
local function mirror()
	local ok, yes = pcall(function() return coop_mode.is_player_mirror() end)
	return ok and yes == true
end

-- A whole number lo..hi, else nil (a client's number).
local function whole(v, lo, hi)
	v = tonumber(v)
	if not v or v ~= v or v % 1 ~= 0 or v < lo or v > hi then return nil end
	return v
end

-------------------------------------------------------------------------------
-- m15:1 - the reward context of one hand-over
-------------------------------------------------------------------------------
-- The character the effects run now are for (coop_tasks' reward scope), nil: none.
local function scope_character()
	local t = ct()
	local ok, c = pcall(function() return t.personal_character() end)
	return ok and tonumber(c) or nil
end

-- The peer of character `char` now, nil: not in the session.
local function live_peer(char)
	local t = ct()
	if char == nil or not t then return nil end
	local ok, p = pcall(t.peer_for_character, char)
	return ok and tonumber(p) or nil
end

-- fn(...) for hand-over `ho`: in the scope coop_tasks restored for the timer when it is still his, else again for his character.
local function run_for(ho, fn, ...)
	local t = ct()
	local char = ho.char
	if char == nil or not t then return fn(...) end
	local live = live_peer(char)
	local okr, rp = pcall(t.reward_peer)
	local scoped_peer = okr and tonumber(rp) or 0
	if scope_character() == char and (live == nil or live == scoped_peer) then return fn(...) end
	stats.rescoped = stats.rescoped + 1
	return t.with_character(char, fn, ...)
end

-------------------------------------------------------------------------------
-- m15:2 - the criterion
-------------------------------------------------------------------------------
-- The host's own record of a task fact (coop_quests_trust.recorded), without a record the live pstor; second value true: the
-- live value is a client's word the host did not take (the same answer as coop_tasks host.fact_of).
local function fact_of(key)
	local a = db.actor
	if not a then return nil, false end
	local okl, live = pcall(load_var, a, key)
	live = okl and live or nil
	local qt = coop_util.module("coop_quests_trust")
	local ok, v, known = pcall(function() return qt.recorded(key) end)
	if ok and known then
		if v == nil then return nil, live ~= nil end
		return v, false
	end
	return live, false
end

local function multi_of(sec)
	local ok, m = pcall(function() return IsItem("multiuse", sec) end)
	return ok and m and true or false
end

-- THE criterion: units of `item` a fetch task of `sec` takes, 0: none. `belt` is the set of ids on the belt of its holder; nil:
-- not known, then no loose item counts.
local function acceptable(item, sec, belt, min_cond, multi)
	local oks, s = pcall(item.section, item)
	if not (oks and s == sec) or belt == nil then return 0 end
	local oki, id = pcall(item.id, item)
	if not oki or belt[id] then return 0 end
	if min_cond then
		local okc, c = pcall(item.condition, item)
		if not (okc and (tonumber(c) or 1) >= min_cond) then return 0 end
	end
	if multi then
		local oku, u = pcall(item.get_remaining_uses, item)
		return oku and tonumber(u) or 1
	end
	return 1
end

-- A container (one of CONTAINERS) of artefact `sec` that `obj` carries: the item and its suffix, or nil.
local function container_of(obj, sec)
	for _, cont in ipairs(CONTAINERS) do
		local ok, c = pcall(obj.object, obj, sec .. "_" .. cont)
		if ok and c then return c, cont end
	end
	return nil
end

local function containers(obj, sec)
	local n = 0
	for _, cont in ipairs(CONTAINERS) do
		pcall(function()
			obj:iterate_inventory(function(_, item)
				if item:section() == sec .. "_" .. cont then n = n + 1 end
			end, nil)
		end)
	end
	return n
end

-- The ids on the belt of this process's own actor (a set), nil: cannot be read.
local function own_belt(obj)
	local set = {}
	local ok = pcall(function()
		obj:iterate_belt(function(_, item) set[item:id()] = true end)
	end)
	return ok and set or nil
end

-- The group's characters here (coop_quests_core.bodies: own actor when it is a player's, the others as objects or records), the
-- player `first` first, then this process's own, then the rest (coop_tasks' order: the turning-in player's items go first).
local function holders(first)
	local qc = coop_util.module("coop_quests_core")
	local ok, list = pcall(function() return qc.bodies() end)
	if not (ok and type(list) == "table") then return {} end
	local out, own, rest = {}, nil, {}
	for _, h in ipairs(list) do
		if h.self then
			own = h
		elseif first ~= nil and h.peer == first then
			out[#out + 1] = h
		else
			rest[#rest + 1] = h
		end
	end
	if own then out[#out + 1] = own end
	for _, h in ipairs(rest) do out[#out + 1] = h end
	return out
end

local function has_loose(obj, sec)
	local found = false
	pcall(function()
		obj:iterate_inventory(function(_, item)
			if item:section() == sec then
				found = true
				return true
			end
		end, nil)
	end)
	return found
end

-- The belt of holder h for section `sec`: his own when he is this process's player, the answer to hand-over `ho`'s ask, else
-- (ho nil) his machine's last report while it is fresh. nil: not known.
local function belt_of(h, sec, ho)
	if h.self then return own_belt(h.obj) end
	if ho then return ho.belts[h.id] end
	local per = belts[h.id]
	local b = per and per[sec]
	if b and time_global() - b.at <= READY_MS then return b.ids end
	return nil
end

-------------------------------------------------------------------------------
-- m15:2 - asks and reports
-------------------------------------------------------------------------------
local function prune()
	local t = time_global()
	for op, a in pairs(asks) do
		if t - a.at > ASK_TTL_MS then
			asks[op] = nil
			ask_n = ask_n - 1
			local until_at = a.at + 2 * ASK_TTL_MS
			if t <= until_at then expired_asks[op] = { peer = a.peer, until_at = until_at } end
		end
	end
	for op, a in pairs(expired_asks) do
		if t > a.until_at then expired_asks[op] = nil end
	end
	for k, at in pairs(asked_at) do
		if t - at > ASK_TTL_MS then asked_at[k] = nil end
	end
	for char, per in pairs(belts) do
		for sec, b in pairs(per) do
			if t - b.at > READY_MS then per[sec] = nil end
		end
		if next(per) == nil then belts[char] = nil end
	end
end

local function load_pending(peer)
	local api = rawget(_G, "coop")
	local session = api and api.session_info and api.session_info()
	for _, row in ipairs(session and session.players or {}) do
		if row.id == peer and row.joined == false then return true end
	end
	local transition = api and api.transition and api.transition()
	for _, row in ipairs(transition and transition.rows or {}) do
		if row.peer == peer and row.mark == "loading" then return true end
	end
	return false
end

-- Asks holder h's machine which items of `sec` are on his belt. True when the ask went out.
local function ask(h, sec, task, ho)
	if type(h.peer) ~= "number" or type(h.id) ~= "number" or #sec > MAX_SEC or #task > MAX_TASK then return false end
	if load_pending(h.peer) then return false end
	prune()
	if ask_n >= MAX_ASKS then return false end
	ask_seq = ask_seq % MAX_OP + 1
	local op = ask_seq
	if not coop_mods_core.to_peer(h.peer, "fetch_belt_ask", { o = op, s = sec, t = task }) then return false end
	asks[op] = { peer = h.peer, char = h.id, sec = sec, task = task, at = time_global(), ho = ho }
	ask_n = ask_n + 1
	asked_at[tostring(h.id) .. "|" .. sec] = time_global()
	stats.asks = stats.asks + 1
	return true
end

-- The readiness check keeps a holder's report fresh: an ask when it is older than ASK_MS and none went out since.
local function refresh(h, sec, task)
	local t = time_global()
	local per = belts[h.id]
	local b = per and per[sec]
	if b and t - b.at < ASK_MS then return end
	local last = asked_at[tostring(h.id) .. "|" .. sec]
	if last and t - last < ASK_MS then return end
	ask(h, sec, task, nil)
end

-- A player's machine: which items of the asked section are on my belt (side "player": the ask comes from peer 0).
local function on_ask(t, from)
	local op = whole(t.o, 1, MAX_OP)
	local sec, task = t.s, t.t
	if not op or type(sec) ~= "string" or sec == "" or #sec > MAX_SEC or type(task) ~= "string" or #task > MAX_TASK then return end
	local a = db.actor
	if not a then return end
	local out, n = { o = op, t = task }, 0
	pcall(function()
		a:iterate_belt(function(_, item)
			if n < MAX_BELT and item:section() == sec then
				local id = coop_mods_core.hid(item:id())
				if type(id) == "number" then
					n = n + 1
					out["i" .. n] = id
				end
			end
		end)
	end)
	out.n = n
	coop_mods_core.to_host("fetch_belt", out)
end

-- The owner of the world data: a player's report. Only the answer to an open ask of his counts; the sender is the transport's.
local function on_report(t, from)
	prune()
	local op = whole(t.o, 1, MAX_OP)
	local a = op and asks[op]
	local expired = op and expired_asks[op]
	if not a and expired and expired.peer == from then
		stats.late = stats.late + 1
		return
	end
	local fresh = a ~= nil and a.peer == from and t.t == a.task
	local tr = coop_util.module("coop_trust")
	if tr and type(tr.pass) == "function" then
		tr.pass("fetch_belt_fresh", fresh, "player #%d: dropped a belt report answering no open ask of his (ask %d)",
			tonumber(from) or -1, op or 0)
	end
	if not fresh then
		stats.stale = stats.stale + 1
		return
	end
	asks[op] = nil
	ask_n = ask_n - 1
	local ids = {}
	local n = whole(t.n, 0, MAX_BELT) or 0
	for i = 1, n do
		local id = whole(t["i" .. i], 1, 65534)
		local l = id and coop_mods_core.lid(id)
		if type(l) == "number" then ids[l] = true end
	end
	stats.reports = stats.reports + 1
	belts[a.char] = belts[a.char] or {}
	belts[a.char][a.sec] = { at = time_global(), ids = ids }
	local ho = a.ho
	if ho then
		if ho.done then
			stats.late = stats.late + 1
			return
		end
		ho.belts[a.char] = ids
		ho.waiting = ho.waiting - 1
	end
end

-------------------------------------------------------------------------------
-- m15:2 - the readiness and hand-over checks
-------------------------------------------------------------------------------
-- Units of `sec` the group can hand over for `task` by the criterion. ho: a hand-over (its own reports), nil: the checks (the
-- last reports; a holder with loose items of `sec` is asked when his report is old or missing).
local function units(task, sec, ho)
	local min_cond = MIN_COND[task]
	local multi = multi_of(sec)
	local with_cont = not min_cond and sec:find("af_", 1, true) ~= nil
	local n = 0
	for _, h in ipairs(holders(nil)) do
		local belt = belt_of(h, sec, ho)
		local loose = false
		pcall(function()
			h.obj:iterate_inventory(function(_, item)
				local u = acceptable(item, sec, belt, min_cond, multi)
				n = n + u
				if not loose then
					local ok, s = pcall(item.section, item)
					loose = ok and s == sec
				end
			end, nil)
		end)
		if with_cont then n = n + containers(h.obj, sec) end
		if loose and not h.self and not ho then refresh(h, sec, task) end
	end
	return n
end

-- The verdict of the checks for task `task`: units the group can hand over and how many it asks for; nil: no fetch item.
local function verdict(task)
	local sec, foreign = fact_of(task .. "_fetch")
	if foreign then return 0, 1 end -- the item is a client's word: 0 of 1 (coop_tasks host.fetch_units)
	if type(sec) ~= "string" or sec == "" then return nil end
	local need = math_max(1, tonumber((fact_of(task .. "_fetch_count"))) or 1)
	return units(task, sec, nil), need
end

local function make_ready(orig)
	return function(tsk, task_id, ...)
		if not (coop_util.active() and type(task_id) == "string" and tsk ~= nil) or mirror() then return orig(tsk, task_id, ...) end
		local ok, n, need = pcall(verdict, task_id)
		if not ok then
			coop_mods_core.report(TAG, "readiness", n)
			return orig(tsk, task_id, ...)
		end
		if n == nil then return orig(tsk, task_id, ...) end
		stats.ready = stats.ready + 1
		tsk.stage = n >= need and 1 or 0
	end
end

-- coop_tasks' host.fetch_units(task_id) -> units, need, foreign: its item_short refuses a client's turn-in below `need`.
local function make_units(orig)
	return function(task_id, ...)
		local n, need, foreign = orig(task_id, ...)
		if not coop_util.active() or n == nil or foreign then return n, need, foreign end
		local ok, mine = pcall(verdict, task_id)
		if ok and type(mine) == "number" then return mine, need, foreign end
		return n, need, foreign
	end
end

-------------------------------------------------------------------------------
-- m15:2 - the collection
-------------------------------------------------------------------------------
local function units_all(obj, sec, multi)
	local n = 0
	pcall(function()
		obj:iterate_inventory(function(_, item)
			if item:section() == sec then n = n + (multi and (tonumber(item:get_remaining_uses()) or 1) or 1) end
		end, nil)
	end)
	return n
end

-- Moves up to `left` units of the acceptable items of holder h into this process's actor. Returns the units, the ids moved
-- go into `moved`.
local function move_from(h, ho, left, moved)
	local a = db.actor
	local sec = ho.sec
	local belt = belt_of(h, sec, ho)
	if belt == nil then
		if has_loose(h.obj, sec) then
			stats.unknown = stats.unknown + 1
			coop_mods_core.log(TAG, "hand-over %d of task %s: no fresh belt report from #%s in %d ms: his items of %s stay with him", ho.id,
				ho.task, tostring(h.peer), WAIT_MS, sec)
		end
		return 0
	end
	local min_cond, multi = MIN_COND[ho.task], multi_of(sec)
	local items, got = {}, 0
	pcall(function()
		h.obj:iterate_inventory(function(_, item)
			if got < left then
				local u = acceptable(item, sec, belt, min_cond, multi)
				if u > 0 then
					items[#items + 1] = item
					got = got + u
				end
			end
		end, nil)
	end)
	for _, item in ipairs(items) do
		local okid, id = pcall(item.id, item)
		if pcall(h.obj.transfer_item, h.obj, item, a) and okid then moved[id] = true end
	end
	stats.moved = stats.moved + #items
	return got
end

-- The acceptable items of the group come to this process's actor before the mod's timer collects there: the turning-in player's
-- first, then what this process's own player holds (the timer takes it where it is), then the others; an artefact asked for may
-- sit in a container another player carries. Returns the set of ids moved.
local function gather(ho, need)
	local sec = ho.sec
	local left = need
	local moved = {}
	local list = holders(live_peer(ho.char) or ho.peer)
	local min_cond, multi = MIN_COND[ho.task], multi_of(sec)
	for _, h in ipairs(list) do
		if left <= 0 then break end
		if h.self then
			local belt = own_belt(h.obj)
			pcall(function()
				h.obj:iterate_inventory(function(_, item) left = left - acceptable(item, sec, belt, min_cond, multi) end, nil)
			end)
		else
			left = left - move_from(h, ho, left, moved)
		end
	end
	if left > 0 and not min_cond and sec:find("af_", 1, true) then
		local t = ct()
		for _, h in ipairs(list) do
			if left <= 0 then break end
			local c, cont = nil, nil
			if not h.self then c, cont = container_of(h.obj, sec) end
			if c then
				-- the artefact into this actor, the empty container back to its owner: outside the reward's item routing
				local ok, err = pcall(t.with_recipient, 0, function()
					alife_release_id(c:id())
					alife_create_item(sec, db.actor)
					alife_create_item(cont, h.obj)
				end)
				if not ok then coop_mods_core.report(TAG, "container", err) end
				left = left - 1
			end
		end
	end
	return moved
end

-- f(...) with db.actor:iterate_inventory showing the items moved for it first, then this actor's own acceptable ones, and no
-- other item of the section: the mod's timer takes exactly what the criterion allows.
local function with_order(ho, moved, f, ...)
	local qc = coop_util.module("coop_quests_core")
	local a = db.actor
	if not (a and qc and type(qc.with_actor) == "function") then return f(...) end
	local real = a.iterate_inventory
	local sec, min_cond, multi = ho.sec, MIN_COND[ho.task], multi_of(ho.sec)
	local fields = {
		iterate_inventory = function(me, fn, x)
			local belt = own_belt(me) or {}
			local first, rest = {}, {}
			real(me, function(_, item)
				local ok, id = pcall(item.id, item)
				if ok and moved[id] then
					first[#first + 1] = item
				elseif acceptable(item, sec, belt, min_cond, multi) > 0 then
					rest[#rest + 1] = item
				end
			end, nil)
			for _, item in ipairs(first) do if fn(x, item) == true then return end end
			for _, item in ipairs(rest) do if fn(x, item) == true then return end end
		end,
	}
	local res = { qc.with_actor(fields, f, ...) }
	if not res[1] then error(res[2], 0) end
	return unpack(res, 2)
end

-- The delayed reward of hand-over `ho`, when its reports are in: the take's check, the items brought, the mod's timer.
local function finish(ho, f, ...)
	ho.done = true
	if not ho.sec then return f(...) end
	local need = math_max(1, tonumber((fact_of(ho.var .. "_count"))) or ho.need or 1)
	local qt = coop_util.module("coop_quests_trust")
	local ticket = nil
	if qt and type(qt.check_take) == "function" then
		local okc, pass, tk = pcall(qt.check_take, ho.peer or 0, ho.sec, need, "quest_take")
		if okc and pass == false then
			stats.refused = stats.refused + 1
			coop_mods_core.log(TAG, "hand-over %d of task %s: the take of %d x %s is refused (coop_trust quest_take)", ho.id, ho.task, need,
				ho.sec)
			return true
		end
		ticket = okc and tk or nil
	end
	local moved = gather(ho, need)
	local multi = multi_of(ho.sec)
	local a = db.actor
	local before = a and units_all(a, ho.sec, multi) or 0
	local res = { pcall(with_order, ho, moved, f, ...) }
	local after = a and units_all(a, ho.sec, multi) or 0
	if ticket and qt and type(qt.note_take) == "function" and before > after then pcall(qt.note_take, ticket, ho.sec, before - after) end
	if not res[1] then error(res[2], 0) end
	return unpack(res, 2)
end

-------------------------------------------------------------------------------
-- The hand-over (xr_effects.fetch_reward_and_remove)
-------------------------------------------------------------------------------
-- The mod's delayed reward of hand-over `ho`: waits for the belt reports it asked for (false keeps the event for the next frame),
-- then runs in its context.
local function delayed(ho, f)
	return function(...)
		if ho.waiting > 0 and time_global() - ho.at < WAIT_MS then return false end
		return run_for(ho, finish, ho, f, ...)
	end
end

-- The task id of the mod's var "<task>_fetch".
local function task_of(var)
	if var:sub(-6) == "_fetch" then return var:sub(1, -7) end
	return var
end

-- inner(actor, npc, p) with the mod's CreateTimeEvent(0, KEY, ...) given its own key and context. The mod's chunk looks its
-- globals up in its own module table first (CScriptStorage): a field there for the length of the call reaches only the mod.
local function with_own_key(ho, inner, ...)
	local fm = coop_util.module("tasks_fetch")
	if type(fm) ~= "table" then return inner(...) end
	local prev = rawget(fm, "CreateTimeEvent")
	rawset(fm, "CreateTimeEvent", function(ev, act, t, f, ...)
		if ev == 0 and act == KEY and type(f) == "function" then
			act = string_format("%s|%s|%s|%d", KEY, ho.task, tostring(ho.char), ho.id)
			f = delayed(ho, f)
			stats.rekeyed = stats.rekeyed + 1
		end
		local cte = prev or rawget(_G, "CreateTimeEvent")
		return cte(ev, act, t, f, ...)
	end)
	local res = { pcall(inner, ...) }
	rawset(fm, "CreateTimeEvent", prev)
	if not res[1] then error(res[2], 0) end
	return unpack(res, 2)
end

local function make_handover(orig)
	-- coop_tasks' wrapper (patch_party_items) moves the other players' items of the section into this actor at the hand-over,
	-- worn ones included, before any report could come: the collection above does it when they are in, so the hand-over calls
	-- the function that wrapper calls (its upvalue fetch_reward). Without it the hand-over goes through that wrapper as before.
	local inner = orig
	local g, nxt = coop_mods_core.upvalue(orig, "gather_fetch"), coop_mods_core.upvalue(orig, "fetch_reward")
	if type(g) == "function" and type(nxt) == "function" then
		inner = nxt
	else
		coop_mods_core.log(TAG, "! coop_tasks' gathering wrapper not found: other players' worn items may be gathered at a hand-over")
	end
	return function(actor, npc, p)
		if not (coop_util.active() and type(p) == "table" and type(p[1]) == "string") or mirror() then return orig(actor, npc, p) end
		handover_seq = handover_seq + 1
		stats.handovers = stats.handovers + 1
		local t = ct()
		local okr, rp = pcall(function() return t.reward_peer() end)
		local sec = fact_of(p[1])
		local ho = { id = handover_seq, var = p[1], task = task_of(p[1]), char = scope_character(), at = time_global(),
			peer = okr and tonumber(rp) or nil, sec = type(sec) == "string" and sec ~= "" and sec or nil, belts = {}, waiting = 0 }
		if ho.sec then
			ho.need = tonumber((fact_of(p[1] .. "_count"))) or 1
			for _, h in ipairs(holders(ho.peer)) do
				if not h.self and has_loose(h.obj, ho.sec) and ask(h, ho.sec, ho.task, ho) then ho.waiting = ho.waiting + 1 end
			end
		end
		return with_own_key(ho, inner, actor, npc, p)
	end
end

-------------------------------------------------------------------------------
-- Install, status
-------------------------------------------------------------------------------
local installed = false

local function install()
	if installed then return end
	installed = true
	if not coop_util.module("tasks_fetch") then return end -- the mod is not in this build: nothing to do
	local xe = rawget(_G, "xr_effects") or xr_effects
	coop_mods_core.wrap(xe, "fetch_reward_and_remove", "tasks_fetch.fetch_reward_and_remove (coop_quests_fetch)", make_handover)
	local tsf = rawget(_G, "task_status_functor") or task_status_functor
	coop_mods_core.wrap(tsf, "actor_has_fetch_item", "task_status_functor.actor_has_fetch_item (coop_quests_fetch)", make_ready)
	local host = coop_mods_core.find_local(ct(), "host")
	if type(host) == "table" then
		coop_mods_core.wrap(host, "fetch_units", "coop_tasks host.fetch_units (coop_quests_fetch)", make_units)
	else
		coop_mods_core.log(TAG, "! coop_tasks' host table not found: a client's turn-in is checked by coop_tasks' own count")
	end
end

local function status_text()
	return string_format("hand-overs %d (own timer keys %d, run again for their character %d, takes refused %d), readiness checks %d, "
		.. "belt asks %d, reports %d (stale %d, late %d), items moved %d, holders without a report %d", stats.handovers,
		stats.rekeyed, stats.rescoped, stats.refused, stats.ready, stats.asks, stats.reports, stats.stale, stats.late, stats.moved,
		stats.unknown)
end

function on_game_start()
	if not rawget(_G, "coop") then return end
	coop_util.start_step("coop_quests_fetch", "events", function()
		coop_mods_core.on("fetch_belt_ask", on_ask, "player")
		coop_mods_core.on("fetch_belt", on_report, "world")
		coop_mods_core.set_limit("fetch_belt", 16, 8)
	end)
	-- after every on_game_start: coop_tasks wraps the same functions there, these wrappers go around them
	coop_util.start_step("coop_quests_fetch", "callback", function()
		RegisterScriptCallback("actor_on_first_update", function() coop_util.start_step("coop_quests_fetch", "install", install) end)
	end)
	coop_util.start_step("coop_quests_fetch", "status", function() coop_mods_core.status_line(TAG, status_text) end)
end
