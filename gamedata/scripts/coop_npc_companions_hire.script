-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - companion hire (gamedata\scripts\coop_npc_companions_hire.script).
	The companion limit and G_FLAT's individual recruit for every player, decided by the authority of the map the companions stand on.
	Partner of coop_npc_companions.script (its recruit channel npc.comp, its leaders); that file calls this one by name.

	The count. The stock counts one player's ordinary companions (axr_companions.non_task_companions: a dialog's
	  recruit, not a task's or a story's) and the mods' room rules read that count: dialogs_axr_companion.is_room_in_actor_squad
	  (Custom Companion Squad Size's replacement in G.A.M.M.A.) and individually_recruitable_companions.is_room_for_one_in_actor_squad.
	  The stock table holds every player's companions on the authority and nothing true on a player's machine, so
	  axr_companions.get_companion_count answers a player's own count:
	    on the authority of a map (the co-op host, a map server): the ordinary members of the companion squads that player leads here
	      (coop_npc_companions.hire_owner), plus in the server those he leads on the other maps (the world server's word, below); the
	      process's own player (the co-op host): the squads with no leader here; inside with_identity: the player it runs for;
	    on a player's machine: the number the authority of his map sent him (npc.comp_count); the stock answer until it came;
	    outside a session: the stock answer.
	  An ordinary companion: a member in the stock's non_task_companions, or one with the stock's mark "companion" and without
	  "companion_cannot_dismiss" (add_special_squad, nta_utils.spawn_companion_squad, tasks_agent_rescue and the Fanatic set it on every
	  task's and story's companion): a map server that adopted a squad from another map has its marks, not the stock table.
	  The authority re-checks room using the requester's count for the three stock hire dialogs and G_FLAT's individual recruits.
	  room_on_decider, called by coop_npc_companions host_on_cmd, uses coop_trust "comp_hire_room" (ships in "log" mode).
	Server: each map server tells the world server its counts per character (coop_quests_core share "comp_hired", up, with its level);
	  the world server tells every map server the rows of every map and its own (down); a map server adds those of the other maps.
	  A squad on its way between maps (the world server's followers) counts on neither until a map adopts it.
	The individual recruit (m31:1, G_FLAT's Individually Recruitable Companions). The dialog's action clones the NPC, releases it, and
	  a time event makes the clone a companion and opens the talk with it: a player's machine cannot create a squad member (its world
	  is a copy). There the action is one request (npc.comp, coop_npc_companions patch_client_actions); the authority checks it as a
	  recruit (face to face, a talk in the last 5 s, not a companion of the group, room), then recruit_one: clones and releases as the
	  mod does, and when the clone is online it joins that player (coop_npc_companions.recruit_for: the stock recruit, his leader
	  entry, the paid one with the days he paid for) and his machine opens the talk with it (npc.comp_one). One under way per player.
	  The co-op host's own recruit runs the mod's own code, as before.
	The dialog on the decider. The request skips the dialog's free and paid preconditions, and a release cannot
	  be undone, so recruit_one checks those preconditions before cloning:
	  dialogs_axr_companion.is_non_story and is_not_hostage_task_giver as always-on guards (coop_trust.guard "comp_one_story": a story NPC
	  or a hostage task's giver is never released); not_a_one_man_squad, and is_actor_friend (free) or txr_paid_companions.is_actor_natural,
	  is_paid_companion_faction, is_not_dangerous_map (paid) under his identity (his character's relation) through coop_trust.pass
	  "comp_one_dialog". The hostage giver's mark is in the group's task book (drx_sl_* of this process's own actor, coop_tasks; a map server
	  holds the world server's copy), so that one runs as this process.
	The price on the decider. The paid dialogs take the money with take_guard_money_1/2 on the player's machine.
	  In a session it names the days and the multiplier shown in the dialog (the squad's price roll in dialog_squad)
	  and displays the stock payment message (coop_npc_companions patch_client_actions). The authority of his
	  map takes the price from the world's book (coop.money_of / coop.money_grant: the co-op host's ledger, a map server's word up to the
	  world server) before anything joins him, and refuses a player who has too little ("st_not_enough_money" to him; coop_trust.guard
	  "comp_paid_money": what he cannot pay for he does not get). The price, as take_guard_money_1/2 compute it: the multiplier x
	  money_1_base (one day) or money_2_base (two days, p = 172800). The multiplier: the one his dialog showed when the stock could have
	  rolled it for that squad (is_squad_competent :62-75: 1.80-2.40 veteran, 1.30-1.60 advanced, else 0.80-1.20), else this process's own
	  roll of the squad, else the top of that range; a modified client pays at least the stock's lowest price of that squad. G_FLAT's paid
	  one is paid in recruit_one (given back when no clone came of it); the stock's (dialogs.xml paid_companion_dialog: take_guard_money_N,
	  become_actor_companion, register_paid_companion) when its recruit comes (pay_hire), and its register gets the days he paid for
	  (paid_days). The co-op host's own and single player: the stock's action takes the money where the dialog runs, as before.
	Events (ids in host numbering):
	  npc.comp_count  authority -> player  { n = his ordinary companions on every map }
	  npc.comp_one    authority -> player  { i = NPC }: open the talk with it once it is here (the clone, or the NPC itself)
--]]

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local TAG = "companions"
local P -- coop_npc_players
local EV_COUNT, EV_ONE, SHARE = "npc.comp_count", "npc.comp_one", "comp_hired"
local IRC = "individually_recruitable_companions"
-- the recruits a mod's room rule covers: "squad" the NPC's whole squad joins (the stock dialog), "one" the NPC alone (G_FLAT's)
local LIMITED = {
	["dialogs_axr_companion.become_actor_companion"] = "squad",
	[IRC .. ".become_actor_companion_individually"] = "one",
	[IRC .. ".become_paid_actor_companion_individually_and_register"] = "one",
}
local HIRE_DIALOGS = {
	friendly_companion_dialog = true,
	friendly_companion_dialog_hostage_version = true,
	paid_companion_dialog = true,
}
local PAID = { [IRC .. ".become_paid_actor_companion_individually_and_register"] = true }
local DAY, TWO_DAYS = 86400, 172800 -- txr_paid_companions' guard_period of take_guard_money_1 / take_guard_money_2
local MAX_COUNT = 64 -- far beyond any squad limit: a bigger number on the wire is a bad one
local MAX_ID = 65534 -- 0xffff is the engine's invalid id
local PUSH_MS, ONE_WAIT_MS, TALK_WAIT_MS = 1000, 30000, 5000
-- The decider checks the dialog preconditions under the player's identity (coop_trust "comp_one_dialog").
local DAC, TP = "dialogs_axr_companion", "txr_paid_companions"
local DIALOG_FREE = { { IRC, "not_a_one_man_squad" }, { DAC, "is_actor_friend" } }
local DIALOG_PAID = { { IRC, "not_a_one_man_squad" }, { TP, "is_actor_natural" }, { TP, "is_paid_companion_faction" },
	{ TP, "is_not_dangerous_map" } }
-- Stock paid hire uses the price roll from txr_paid_companions.is_squad_competent (hundredths by squad section,
-- otherwise 80–120). Contract prices use money_1_base and money_2_base with stock defaults.
local PAID_DIALOG = "paid_companion_dialog"
local TIERS = { { "veteran", 180, 240 }, { "advanced", 130, 160 } }
local TIER_LO, TIER_HI = 80, 120
local BASE = { [DAY] = { "money_1_base", 1500 }, [TWO_DAYS] = { "money_2_base", 3000 } }
local MAX_PRICE = 1000000
local MSG_POOR = "st_not_enough_money" -- the stock's "Not enough money" (ui_st_other.xml)

local started = false
local asking = nil -- authority: the player whose count the mod's room rule reads now
local word = nil -- player's machine: his count, as the authority of his map said
local told = {} -- authority: peer -> the count he was told last
local rows = {} -- world server: level id -> { [character] = n }, as its map server said
local remote = { m = {}, w = {} } -- map server: the world server's word: the rows of every map, and its own
local pending = {} -- authority: clone id -> { from, paid, price, who, at }
local busy = {} -- authority: peer -> clone id of his individual recruit under way
local paid_hire = {} -- authority: peer -> { npc, period, price, who }: the stock paid hire he paid for, until its register
local talk_wait = nil -- player's machine: { id, at }: the talk to open once that NPC is here
local next_push = 0
local stats = { pushed = 0, room_failed = 0, ones = 0, ones_done = 0, ones_lost = 0, talks = 0, ones_refused = 0, paid = 0, paid_ru = 0,
	poor = 0, given_back = 0 }

local function whole(v, min, max)
	return type(v) == "number" and v == v and v >= min and v <= max and v % 1 == 0
end

-------------------------------------------------------------------------------
-- The count
-------------------------------------------------------------------------------
local function ordinary(ac, id)
	local nt = ac.non_task_companions
	if type(nt) == "table" and nt[id] then return true end
	local se = alife_object(id)
	if not se then return false end
	local name = se:name()
	return se_load_var(id, name, "companion") == true and not se_load_var(id, name, "companion_cannot_dismiss")
end

-- The ordinary companions of the squads this process holds: own = its own player's (no leader here), by = { [character] = n }.
local function count_here()
	local res = { own = 0, by = {} }
	local ac = axr_companions
	local cs = ac and ac.companion_squads
	if type(cs) ~= "table" then return res end
	local C = coop_npc_companions
	for squad_id in pairs(cs) do
		local owner = C.hire_owner(squad_id)
		local squad = owner ~= false and alife_object(squad_id)
		if squad then
			local ok, err = pcall(function()
				for k in squad:squad_members() do
					if ordinary(ac, k.id) then
						if owner then res.by[owner] = (res.by[owner] or 0) + 1 else res.own = res.own + 1 end
					end
				end
			end)
			if not ok then P.report(TAG, "hire count of squad " .. tostring(squad_id), err) end
		end
	end
	return res
end

local function my_level()
	local ok, lid = pcall(function() return alife():level_id() end)
	return ok and tonumber(lid) or nil
end

-- A character's ordinary companions on the other maps: the world server's word (server only; nothing in the co-op).
local function elsewhere(who)
	local n, mine = 0, my_level()
	if mine ~= nil then
		for lid, row in pairs(remote.m) do
			if lid ~= mine then n = n + (row[who] or 0) end
		end
	end
	return n + (remote.w[who] or 0)
end

-- Player `peer`'s count on this authority (here: count_here(), when the caller has it).
local function count_for(peer, here)
	here = here or count_here()
	if peer == P.self_peer() then return here.own end
	local who = P.avatar_of_peer(peer)
	if type(who) ~= "number" then return 0 end
	return (here.by[who] or 0) + elsewhere(who)
end

-- axr_companions.get_companion_count on this machine; nil: the stock answer.
local function count_now()
	if not P.active() then return nil end
	if asking ~= nil then return count_for(asking) end
	if coop_mode.is_player_mirror() then return word end
	if not (coop_mode.leads_here() or coop_mode.decides_world()) then return nil end
	local peer = P.self_peer()
	if P.in_identity() and db.actor then peer = P.peer_of(db.actor) or peer end
	return count_for(peer)
end

local function counting(orig)
	return function(...)
		local ok, n = pcall(count_now)
		if ok and type(n) == "number" then return n end
		if not ok then P.report(TAG, "companion count", n) end
		return orig(...)
	end
end

-- The authority of a map: every player of it learns his count when it changed.
function push_counts()
	if not (started and P.active() and coop_mode.leads_here()) then return end
	local here, present = count_here(), {}
	for _, p in ipairs(coop_util.players()) do
		if not p.is_self and type(p.avatar_id) == "number" then
			present[p.id] = true
			local n = math.min(count_for(p.id, here), MAX_COUNT)
			if told[p.id] ~= n and P.send(EV_COUNT, { n = n }, p.id) then
				told[p.id] = n
				stats.pushed = stats.pushed + 1
			end
		end
	end
	-- one who left (another map, the session): another authority told him since, he is told again when he is back
	for peer in pairs(told) do
		if not present[peer] then told[peer] = nil end
	end
end

-- His Lua state is new (npc.comp_req): he is told again.
function forget(peer)
	if type(peer) == "number" then told[peer] = nil end
end

local function on_count(t)
	if whole(t.n, 0, MAX_COUNT) then word = t.n end
end

-------------------------------------------------------------------------------
-- The room rule on the authority
-------------------------------------------------------------------------------
-- Squad hire dialogs have a room precondition; guide and story dialogs can use the same squad action without one.
-- Both G_FLAT recruit actions have a room precondition. Use the requesting player's count. -> true: go on
function room_on_decider(full, from, npc, dialog)
	local kind = LIMITED[full]
	if kind == "squad" and not HIRE_DIALOGS[dialog] then return true end
	if not (started and kind and npc) then return true end
	local core = coop_mods_core
	local m = core.mod(kind == "one" and IRC or "dialogs_axr_companion")
	local f = m and core.fn(m, kind == "one" and "is_room_for_one_in_actor_squad" or "is_room_in_actor_squad")
	if not f then return true end -- no such rule in this game
	asking = from
	local ok, room = pcall(f, db.actor, npc)
	asking = nil
	if not ok then
		P.report(TAG, "room rule", room)
		return true -- a broken rule refuses nobody
	end
	if room ~= true then stats.room_failed = stats.room_failed + 1 end
	return coop_trust.pass("comp_hire_room", room == true, "recruit of %s by player #%s: no room (%s ordinary companions)",
		tostring(npc:name()), tostring(from), tostring(count_for(from)))
end

-------------------------------------------------------------------------------
-- The price on the decider
-------------------------------------------------------------------------------
-- A player's balance in the world's book (coop.money_of: the co-op host's ledger; a map server: the world server's word), nil: unknown.
local function balance(peer)
	local api = rawget(_G, "coop")
	local f = api and api.money_of
	if type(f) ~= "function" then return nil end
	local ok, v = pcall(f, peer)
	v = ok and tonumber(v) or nil
	if v and v == v and v >= 0 then return v end
	return nil
end

-- Money from (delta < 0) or back to (delta > 0) a player through the book (coop.money_grant; a map server's goes up to the world
-- server). -> true: done
local function grant(peer, delta)
	local api = rawget(_G, "coop")
	local f = api and api.money_grant
	if type(f) ~= "function" then return false end
	local ok, done = pcall(f, peer, delta)
	return ok and done == true
end

local function squad_of(npc)
	local ok, sq = pcall(get_object_squad, npc)
	return ok and sq or nil
end

-- The range of the stock's roll for this squad, in hundredths (txr_paid_companions.is_squad_competent :62-75).
local function tier(squad)
	local ok, section = pcall(function() return squad:section_name() end)
	section = ok and type(section) == "string" and section or ""
	for _, t in ipairs(TIERS) do
		if section:find(t[1], 1, true) then return t[2], t[3] end
	end
	return TIER_LO, TIER_HI
end

-- A multiplier the stock could have rolled in [lo, hi] hundredths: its hundredths; anything else nil.
local function hundredths(m, lo, hi)
	if type(m) ~= "number" or m ~= m then return nil end
	local k = math.floor(m * 100 + 0.5)
	if k < lo or k > hi or math.abs(m * 100 - k) > 1e-6 then return nil end
	return k
end

-- A file local of txr_paid_companions on this process (its dialog_squad, its money_N_base).
local function stock_local(name)
	local core = coop_mods_core
	local m = core.mod(TP)
	if not m then return nil end
	return (core.find_local(m, name))
end

-- The price of a contract of `period` seconds with NPC's squad, as take_guard_money_1/2 compute it; m: the multiplier his dialog showed.
local function price_of(npc, period, m)
	local squad = squad_of(npc)
	local lo, hi = TIER_LO, TIER_HI
	if squad then lo, hi = tier(squad) end
	local k = hundredths(m, lo, hi)
	if not k and squad then
		local book = stock_local("dialog_squad")
		local row = type(book) == "table" and book[squad.id]
		k = hundredths(type(row) == "table" and row.money, lo, hi)
	end
	local b = BASE[period] or BASE[DAY]
	local base = tonumber(stock_local(b[1]))
	if not (base and base > 0 and base <= MAX_PRICE) then base = b[2] end
	return math.min(math.floor((k or hi) * base / 100 + 0.5), MAX_PRICE)
end

-- Takes `price` from player `from` for a hire of NPC; too little money: refused and told. -> true: paid
local function pay(from, price, npc, what)
	local have = balance(from)
	if not coop_trust.guard("comp_paid_money", have ~= nil and have >= price, "%s of %s by player #%s: %s RU, he has %s", what,
		tostring(npc:name()), tostring(from), tostring(price), tostring(have)) then
		stats.poor = stats.poor + 1
		local C = coop_npc_companions
		if C.tell_refused then C.tell_refused(from, MSG_POOR) end
		return false
	end
	if not grant(from, -price) then
		P.log(TAG, "%s of %s by player #%s refused: the book did not take %s RU", what, tostring(npc:name()), tostring(from), tostring(price))
		return false
	end
	stats.paid = stats.paid + 1
	stats.paid_ru = stats.paid_ru + price
	return true
end

-- His money back for a hire that did not happen; only to the character that paid (a seat goes to another player after a leave).
local function give_back(from, who, price)
	if not price then return end
	if who == nil or P.avatar_of_peer(from) ~= who then
		P.log(TAG, "hire of player #%s: %s RU not given back, he left", tostring(from), tostring(price))
		return
	end
	if grant(from, price) then
		stats.given_back = stats.given_back + 1
	else
		P.log(TAG, "hire of player #%s: %s RU not given back, the book refused", tostring(from), tostring(price))
	end
end

-- coop_npc_companions host_on_cmd, the stock paid hire's recruit (the dialog's second action, after take_guard_money_N named the days and
-- the price on his machine): paid here before the squad joins him. Any other recruit asks nothing. -> true: go on
function pay_hire(t, from, npc)
	if not (started and t.d == PAID_DIALOG) then return true end
	local period = t.p == TWO_DAYS and TWO_DAYS or DAY
	local price = price_of(npc, period, t.m)
	if not pay(from, price, npc, "paid hire") then return false end
	paid_hire[from] = { npc = npc:id(), period = period, price = price, who = P.avatar_of_peer(from) }
	return true
end

-- After that recruit's action: the squad did not join him -> his money back.
function hire_done(from, npc, joined)
	local h = paid_hire[from]
	if joined or not (h and h.npc == npc:id()) then return end
	paid_hire[from] = nil
	give_back(from, h.who, h.price)
end

-- The register of the stock paid hire's contract (its third action): the days he paid for, once, however late it comes. nil: he paid
-- for no hire of this NPC here (his last paid hire is kept, one per player, until its register).
function paid_days(from, npc)
	local h = paid_hire[from]
	if not (h and h.npc == npc:id()) then return nil end
	paid_hire[from] = nil
	return h.period
end

-- Before the stock paid hire registers, return whether it may proceed and the paid days (nil for no payment).
-- A register that names no payment never replaces a running contract (the stock writes a new join_time: a renewal for free). An
-- honest player never sends one (the paid dialog wants is_not_actor_companion): an always-on guard.
function paid_register(from, npc, squad)
	local days = paid_days(from, npc)
	local tp = coop_mods_core.mod(TP)
	local book = tp and tp.paid_companions
	local running = days == nil and squad ~= nil and type(book) == "table" and book[squad.id] ~= nil
	return coop_trust.guard("comp_paid_renew", not running, "contract of %s by player #%s: a register with nothing paid, the running one stays",
		tostring(npc:name()), tostring(from)), days
end

-------------------------------------------------------------------------------
-- The individual recruit's dialog on the decider
-------------------------------------------------------------------------------
-- A mod's precondition f(actor, npc), under the identity of `who` when given: true / false; nil: no such function in this game, or
-- it broke (then the second value is true, reported).
local function ask(script, name, actor, npc, who)
	local core = coop_mods_core
	local m = core.mod(script)
	local f = m and core.fn(m, name)
	if not f then return nil end
	local ok, res
	if who then
		ok, res = pcall(P.with_identity, who, f, actor, npc)
	else
		ok, res = pcall(f, actor, npc)
	end
	if not ok then
		P.report(TAG, script .. "." .. name, res)
		return nil, true
	end
	return res and true or false
end

-- G_FLAT's dialog would offer player `from` this recruit. `actor`: this process's own actor, the dialog's first speaker (the stock's
-- who_is_npc then names the NPC). -> true: go on
local function one_allowed(full, from, npc)
	local name, actor = tostring(npc:name()), db.actor
	-- a release cannot be undone: never a story NPC or a hostage task's giver, whatever coop_trust's mode
	local story, broke = ask(DAC, "is_non_story", actor, npc)
	if not coop_trust.guard("comp_one_story", story ~= false and not broke, "individual recruit of %s by player #%s: a story NPC (%s)",
		name, tostring(from), broke and "the rule broke" or "is_non_story") then return false end
	local giver
	giver, broke = ask(DAC, "is_not_hostage_task_giver", actor, npc)
	if not coop_trust.guard("comp_one_story", giver ~= false and not broke, "individual recruit of %s by player #%s: a hostage task's giver (%s)",
		name, tostring(from), broke and "the rule broke" or "is_not_hostage_task_giver") then return false end
	-- the rest as his dialog read it: his character's relation
	local who = P.object_of_peer(from)
	if not who then return false end
	local failed = {}
	for _, c in ipairs(PAID[full] and DIALOG_PAID or DIALOG_FREE) do
		if ask(c[1], c[2], actor, npc, who) == false then failed[#failed + 1] = c[2] end
	end
	return coop_trust.pass("comp_one_dialog", #failed == 0, "individual recruit of %s by player #%s: his dialog does not offer it (%s)",
		name, tostring(from), table.concat(failed, ", "))
end

-------------------------------------------------------------------------------
-- The individual recruit (G_FLAT)
-------------------------------------------------------------------------------
-- Player `from`'s machine opens the talk with NPC `id` (the mod: run_talk_dialog after the recruit, or with the NPC when no clone).
local function talk_on(from, id)
	if from ~= P.self_peer() then
		P.send(EV_ONE, { i = id }, from)
		return
	end
	local npc = level.object_by_id(id)
	if npc and db.actor and coop_mode.actor_is_player() then db.actor:run_talk_dialog(npc) end
end

local function done_one(clone_id, p)
	pending[clone_id] = nil
	if busy[p.from] == clone_id then busy[p.from] = nil end
end

-- The mod's time event, kept for player p.from: the clone joins him once it is online. -> true: over
local function finish_one(clone_id)
	local p = pending[clone_id]
	if not p then return true end
	local npc = level.object_by_id(clone_id)
	if not npc then
		if time_global() - p.at < ONE_WAIT_MS then return false end
		done_one(clone_id, p)
		stats.ones_lost = stats.ones_lost + 1
		P.log(TAG, "individual recruit of player #%s: clone %s never came online", tostring(p.from), tostring(clone_id))
		give_back(p.from, p.who, p.price)
		return true
	end
	done_one(clone_id, p)
	if P.avatar_of_peer(p.from) == nil and p.from ~= P.self_peer() then
		P.log(TAG, "individual recruit: player #%s left, clone %s stays free", tostring(p.from), tostring(clone_id))
		return true
	end
	if coop_npc_companions.recruit_for(p.from, npc, p.paid) then
		stats.ones_done = stats.ones_done + 1
	else
		give_back(p.from, p.who, p.price) -- refund payment if the clone fails to join
	end
	talk_on(p.from, clone_id)
	push_counts()
	return true
end

local function finish_one_safe(clone_id)
	local ok, res = pcall(finish_one, clone_id)
	if not ok then
		P.report(TAG, "individual recruit", res)
		pending[clone_id] = nil
		return true
	end
	return res
end

-- coop_npc_companions host_on_cmd, on the authority, after the recruit's checks: the mod's action for player `from`. full: which
-- action (the paid one registers a contract of t.p seconds and is paid here for those days).
function recruit_one(full, t, from, npc)
	if not started then return end
	local under_way = busy[from]
	if under_way and pending[under_way] then
		P.log(TAG, "individual recruit of %s by player #%s refused: his last one is not done", tostring(npc:name()), tostring(from))
		return
	end
	if not one_allowed(full, from, npc) then
		stats.ones_refused = stats.ones_refused + 1
		return
	end
	local core = coop_mods_core
	local util = core.mod("stalker_cloning_utility")
	local clone = util and core.fn(util, "clone_stalker")
	if not clone then return end
	local paid, price, who = nil, nil, nil
	if PAID[full] then -- collect before cloning and refund if cloning fails
		paid = t.p == TWO_DAYS and TWO_DAYS or DAY
		price = price_of(npc, paid, t.m)
		who = P.avatar_of_peer(from)
		if not pay(from, price, npc, "individual paid recruit") then return end
	end
	local ok, clone_id = pcall(clone, npc)
	if not ok then
		P.report(TAG, "individual recruit clone", clone_id)
		give_back(from, who, price)
		return
	end
	if not whole(clone_id, 1, MAX_ID) then -- the mod: no clone, the talk goes on with the NPC
		give_back(from, who, price)
		talk_on(from, npc:id())
		return
	end
	local released, err = pcall(alife_release, npc)
	if not released then P.report(TAG, "individual recruit release", err) end
	pending[clone_id] = { from = from, paid = paid, price = price, who = who, at = time_global() }
	busy[from] = clone_id
	stats.ones = stats.ones + 1
	CreateTimeEvent("coop_comp_hire", "one_" .. tostring(clone_id), 0, finish_one_safe, clone_id)
end

-- A player's machine: the authority's word to open the talk with an NPC as soon as its copy is here.
local function open_talk()
	local w = talk_wait
	if not w then return end
	local npc = level.object_by_id(w.id)
	if npc and db.actor then
		talk_wait = nil
		stats.talks = stats.talks + 1
		db.actor:run_talk_dialog(npc)
	elseif time_global() - w.at > TALK_WAIT_MS then
		talk_wait = nil
	end
end

local function on_one(t)
	if not whole(t.i, 1, MAX_ID) then return end
	talk_wait = { id = P.to_local(t.i), at = time_global() }
	open_talk()
end

-------------------------------------------------------------------------------
-- Server: the counts of every map (coop_quests_core share; nothing reads it in the co-op)
-------------------------------------------------------------------------------
local function clean(row)
	local t = {}
	if type(row) ~= "table" then return t end
	for who, n in pairs(row) do
		if whole(who, 0, MAX_ID) and whole(n, 0, MAX_COUNT) then t[who] = n end
	end
	return t
end

local function up_get() return count_here().by end

local function up_set(v, level_id)
	if whole(level_id, 0, 255) then rows[level_id] = clean(v) end
end

local function down_get() return { m = rows, w = count_here().by } end

local function down_set(v)
	if type(v) ~= "table" then return end
	local m = {}
	if type(v.m) == "table" then
		for lid, row in pairs(v.m) do
			if whole(lid, 0, 255) then m[lid] = clean(row) end
		end
	end
	remote = { m = m, w = clean(v.w) }
end

-------------------------------------------------------------------------------
-- Install, update
-------------------------------------------------------------------------------
local function install_count()
	local core = coop_mods_core
	local ac = core.mod("axr_companions")
	if ac then core.wrap(ac, "get_companion_count", "axr_companions.get_companion_count (companions per player)", counting) end
end

local function install_events()
	P.on(EV_COUNT, on_count, "client", TAG)
	P.on(EV_ONE, on_one, "client", TAG)
end

local function install_share()
	local qc = _G["coop_quests_core"]
	local share = qc and qc.share and qc.share()
	if not (share and share.up and share.down) then return end
	share.up(SHARE, up_get, up_set, 2000)
	share.down(SHARE, down_get, down_set, 2000)
end

local function actor_on_update()
	if talk_wait then open_talk() end
	local now = time_global()
	if now < next_push then return end
	next_push = now + PUSH_MS
	local ok, err = pcall(push_counts)
	if not ok then P.report(TAG, "hire counts", err) end
end

function print_status()
	if not started then return end
	local n = 0
	for _ in pairs(pending) do n = n + 1 end
	P.log(TAG, "hire: counts sent %d | room failed %d | individual recruits %d, done %d, lost %d, under way %d, refused %d | talks %d | paid %d (%d RU), too poor %d, given back %d",
		stats.pushed, stats.room_failed, stats.ones, stats.ones_done, stats.ones_lost, n, stats.ones_refused, stats.talks, stats.paid,
		stats.paid_ru, stats.poor, stats.given_back)
end

function on_game_start()
	if started then return end
	P = coop_npc_players
	if not rawget(_G, "coop") then return end
	started = true
	for _, s in ipairs({ { "count", install_count }, { "events", install_events }, { "share", install_share } }) do
		local ok, err = pcall(s[2])
		if not ok then P.report(TAG, "install hire " .. s[1], err) end
	end
	RegisterScriptCallback("actor_on_update", actor_on_update)
end

function _stats() return stats end
