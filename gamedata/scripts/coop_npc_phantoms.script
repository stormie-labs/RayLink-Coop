--[[
	Anomaly Coop - NPC group: phantoms for every player. The original scripts stay as they are: no module is reexecuted.

	Native hooks (host, with clients; otherwise every wrapped function is the original):
	  - phantom_manager: a monster spawns dynamic phantoms while it fights "the actor" within 30 m of db.actor, the host.
	    Its private handler now also runs as the client the monster fights, so the timer, the checks and the limit stand.
	    The engine sends the phantom at the nearest player (CPhantom::net_Spawn, every machine's copy at the same one).
	  - xcv_phantoms (G.A.M.M.A.): coop_route runs its actor_on_update as each player in turn. arszi_psy.get_ppe_intensity
	    now answers for that player (what his machine reports, coop_economy_mdata), not with the host's psy health. A
	    phantom's contact is measured to the nearest player; the psy hit lands on him in the phantom's name, because a hit
	    a character deals itself never reaches its owner (hits::to_owner).
	  - xcv_phantoms_fix: its replacement callback uses the original script's private settings and squad table
	    as if they were exports. Supply them to the replacement and its deferred cleanup during a session.
	  xcv's squad runs to "actor". sim_squad_scripted resolves that to id 0, and a player's character has none of a squad
	  target's methods, so the target stays and only the place changes: the engine asks get_current_task, and near a client
	  that is his place.
--]]

local type, ipairs, pcall, error = type, ipairs, pcall, error
local installed = false

-- The client a monster is fighting now, nil for anybody else.
local function fought_client(P, npc)
	local enemy = npc and npc:alive() and npc:get_enemy()
	return enemy and P.is_proxy(enemy) and enemy or nil
end

local function dynamic(C, P)
	local m = C.mod("phantom_manager")
	if not m then return false end
	local old, holder, index = C.find_local(m, "monster_on_update")
	if type(old) ~= "function" or not holder then return false end
	local wrapped = function(npc, st, ...)
		-- The route declares this wrapper host-only. A direct invocation on a client must not spawn either.
		if P.is_client() then return end
		local player = P.host_on() and not P.in_identity() and fought_client(P, npc)
		if not player then return old(npc, st, ...) end
		-- Stock asks this table, which knows fights with the host only: marked for this one call.
		local fights = xr_combat_ignore.fighting_with_actor_npcs
		local id = npc:id()
		local had = fights[id]
		fights[id] = true
		local ok, err = pcall(P.with_identity, player, old, npc, st, ...)
		fights[id] = had
		if not ok then error(err, 0) end
	end
	debug.setupvalue(holder, index, wrapped)
	C.swap_callback("monster_on_update", old, wrapped)
	return true
end

local function psy(C, P)
	local m, reports = C.mod("arszi_psy"), C.mod("coop_economy_mdata")
	local get = m and m.get_ppe_intensity
	if type(get) ~= "function" or not reports then return false end
	local _, holder, index = C.find_local(m, "psy_table")
	if not holder then return false end
	m.get_ppe_intensity = function(...)
		local who = P.in_identity() and (P.host_on() or (C.active() and coop_mode.leads_here())) and db.actor
		if not (who and P.is_proxy(who)) then return get(...) end
		local _, t = debug.getupvalue(holder, index) -- arszi replaces the table at load_state
		if type(t) ~= "table" then return get(...) end
		local report = reports.player_value(who:id(), "psy_table")
		local saved = t.actor_psy_health
		t.actor_psy_health = type(report) == "table" and report.actor_psy_health or 1 -- nothing reported yet: healthy
		local ok, value = pcall(get, ...)
		t.actor_psy_health = saved
		if not ok then error(value, 0) end
		return value
	end
	return true
end

-- xcv's squad table, read anew on every call (xcv replaces it at load_state). A file local of xcv_phantoms.script, or a
-- module field where G.A.M.M.A.'s configs\unlocalizers\xcv_phantoms_fix_unlocalizer.ltx has the engine
-- (script_storage.cpp) turn the local into one before the script compiles. nil: no such table.
local function xcv_squads(C, m)
	if type(m) ~= "table" then return nil end
	if type(rawget(m, "spawned_phantoms")) == "table" then
		return function() return rawget(m, "spawned_phantoms") end
	end
	local _, holder, index = C.find_local(m, "spawned_phantoms")
	if not holder then return nil end
	return function()
		local _, t = debug.getupvalue(holder, index)
		return t
	end
end

local function contact(C, P)
	local m = C.mod("xcv_phantoms")
	local update, psi_hit = m and m.monster_on_update, m and m.psi_health_hit
	if type(update) ~= "function" or type(psi_hit) ~= "function" then return false end
	local phantom_squads = xcv_squads(C, m)
	local power = C.find_local(m, "psi_hit_power")
	if not phantom_squads or type(power) ~= "number" then return false end
	local phantom -- the one touching a client, while xcv's update runs as him
	m.psi_health_hit = function(enable, ...)
		if not (phantom and enable) then return psi_hit(enable, ...) end
		local h = hit()
		h.power = math.random(power * 10 - 20, power * 10 + 10) / 1000
		h.bone = "bip01_spine"
		h.impulse = 0
		h.direction = vector()
		h.draftsman = phantom
		h.type = hit.telepatic
		db.actor:hit(h)
	end
	local wrapped = function(npc, ...)
		if P.is_client() then return end
		local squad = P.host_on() and not P.in_identity() and npc and npc:alive() and get_object_squad(npc)
		local spawned = phantom_squads()
		local near = squad and type(spawned) == "table" and spawned[squad.id] and P.nearest(npc)
		if not (near and P.is_proxy(near)) then return update(npc, ...) end
		phantom = npc
		local ok, err = pcall(P.with_identity, near, update, npc, ...)
		phantom = nil
		if not ok then error(err, 0) end
	end
	m.monster_on_update = wrapped
	C.swap_callback("monster_on_update", update, wrapped)
	return true
end

local function squad_place(C, P)
	local m, squads = C.mod("xcv_phantoms"), C.mod("sim_squad_scripted")
	local class = squads and squads.sim_squad_scripted
	local task = class and class.get_current_task
	if type(task) ~= "function" then return false end
	local phantom_squads = xcv_squads(C, m)
	if not phantom_squads then return false end
	class.get_current_task = function(self, ...) -- the engine asks this for every squad: the table first
		local spawned = phantom_squads()
		if not (type(spawned) == "table" and spawned[self.id] and P.host_on()) then return task(self, ...) end
		local near = P.nearest(self.position)
		if not (near and P.is_proxy(near)) then return task(self, ...) end
		return CALifeSmartTerrainTask(near:game_vertex_id(), near:level_vertex_id())
	end
	return true
end

-- The replacement overwrites the only closure that captures these two numeric locals.
-- Read their declarations from the effective base script without running it again.
local function xcv_settings()
	local fs = getFS()
	local path = fs:update_path("$game_scripts$", "xcv_phantoms.script")
	local src
	local file = io.open(path, "rb")
	if file then
		src = file:read("*a")
		file:close()
	elseif type(r_file_as_string) == "function" then
		src = r_file_as_string(path)
	end
	if type(src) ~= "string" then return end
	local function setting(key)
		local line = ("\n" .. src):match("\n[ \t]*local[ \t]+" .. key .. "[ \t]*=[ \t]*([^\r\n]*)")
		return line and tonumber((line:gsub("%-%-.*$", "")))
	end
	return setting("phantom_frequency"), setting("phantoms_appear_at")
end

local function xcv_fix(C, P)
	local m = C.mod("xcv_phantoms")
	local original = m and m.actor_on_update
	if type(original) ~= "function" or coop_route.script_of(original) ~= "xcv_phantoms_fix" then return false end
	-- G.A.M.M.A. ships configs\unlocalizers\xcv_phantoms_fix_unlocalizer.ltx: the engine makes these locals module
	-- fields before the script compiles, so the replacement reads what it expects. Nothing to supply.
	if type(rawget(m, "phantom_frequency")) == "number" and type(rawget(m, "phantoms_appear_at")) == "number"
		and type(rawget(m, "spawned_phantoms")) == "table" then return false end
	local _, holder, index = C.find_local(m, "spawned_phantoms")
	local ok, frequency, threshold = pcall(xcv_settings)
	local environment = getfenv(original)
	local scoped
	if ok and frequency and frequency > 0 and frequency < math.huge
		and threshold and threshold >= 0 and threshold < math.huge and threshold % 1 == 0 and holder then
		local exports = setmetatable({}, {
			__index = function(_, key)
				if key == "phantom_frequency" then return frequency end
				if key == "phantoms_appear_at" then return threshold end
				if key == "spawned_phantoms" then
					local _, squads = debug.getupvalue(holder, index)
					return squads
				end
				return m[key]
			end,
			__newindex = m, -- the mod's shared throttle still lives at xcv_phantoms.tmr
		})
		scoped = setmetatable({ xcv_phantoms = exports }, { __index = environment })
	else
		P.report("compat", "native phantom_xcv_fix", "cannot resolve private XCV spawn settings")
	end
	C.wrap(m, "actor_on_update", "xcv_phantoms_fix.actor_on_update", function(update)
		return function(...)
			if not C.active() then return update(...) end
			if not scoped then return end
			-- Any timer created here keeps the scoped environment and reads the live squad table.
			local previous = getfenv(update)
			setfenv(update, scoped)
			local ran, err = pcall(update, ...)
			setfenv(update, previous)
			if not ran then error(err, 0) end
		end
	end)
	coop_route.inherit_source(m.actor_on_update, original)
	C.swap_callback("actor_on_update", original, m.actor_on_update)
	C.wrap(m, "psi_health_hit", "xcv_phantoms_fix.psi_health_hit", function(psi_hit)
		return function(enable, ...)
			if C.active() and m.enable_psi_hit == false then enable = false end
			return psi_hit(enable, ...)
		end
	end)
	return true
end

function install(P, applied)
	if installed then return end
	local C = coop_mods_core
	if not (C and type(C.find_local) == "function") then return end
	installed = true
	for _, spec in ipairs({ { "phantoms", dynamic }, { "phantom_psy", psy }, { "phantom_contact", contact },
		{ "phantom_squad", squad_place }, { "phantom_xcv_fix", xcv_fix } }) do
		local ok, result = pcall(spec[2], C, P)
		if not ok then
			P.report("compat", "native " .. spec[1], result)
		elseif result then
			applied[#applied + 1] = "native:" .. spec[1]
		end
	end
end
