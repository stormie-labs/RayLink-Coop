--[[
	Anomaly Coop - saves in a co-op session (gamedata\scripts\coop_saves.script), F3 task 17.
	Spec: docs\CHECKPOINTS_DEATH.md section 7. Recon: docs\research\2026-10-22-f3-saves-sleep-recon.md section A.

	In a session NOBODY saves or loads by hand, the host included. The world is saved by the host's engine (emergency
	autosaves, a ring per game: coop_auto_<game>_<N>, or coop_auto_<N> of a world without a game; rotation rules in
	coop_autosave_rules.h) and the host goes back to one of them from the timeline of the Co-op window, which asks for the
	confirmation and calls restore(); the list window of this script stays for coop_saves.open_restore.
	The session is "active" (coop.is_active()): a host that waits for a save to load (host_when_ready) is not in a session
	yet, so the stock Load / Last save / New game still work for "host after load".

	Runs on every machine (a "view" script in configs\coop_domains_checkpoints.ltx).

	What is closed, and how (numbers are the paths of the recon, section A.3):
	  - the buttons Save / Load / Last save of the in-game menu are not created in a session (engine,
	    CUIMMShniaga::CreateList); here the Lua side covers an old menu that was opened before the session started:
	      * on_before_save_input (types 1 menu Save, 2 F5, 3 F6): S1-S4;
	      * on_before_load_input (F7): L1, L2;
	      * main_menu:OnButton_load_clicked / OnButton_last_save / OnButton_save_clicked of ui_main_menu: L3, L4, S3
	        (a mouse click has no key before it, so the hint goes to the menu's own message line);
	  - the stock timer autosave game_autosave_new.autosave (S7) does not save in a session, and its timer restarts when
	    the session ends (no tempsave at once);
	  - the other stock save modes (campfire saves, Agony, Timer, Ironman, Azazel) need a death or a save key of the player:
	    in a session the actor does not die (coop_survival::intercept_actor_kill) and saves are closed above;
	  - left open on purpose: the console commands save / load / load_last_save (the host's autosave engine, Restore and
	    debugging use them), the new-world save of itms_manager (S6, once, before the game), the packet M_SAVE_GAME that
	    the join flow sends itself (S11).

	No save is opened to build the list (like the stock Load dialog): a CSavedGameWrapper reads and unpacks the whole file and
	asserts (FATAL) on a cut one, and ten of them would stall the host's live session. The list holds what the folder says
	(name, slot, when the file was written, its size); the level and the game time are read by details(entry) for the row the
	host picked, and never for a file below MIN_SAVE_BYTES (a write cut short) or with a header that is not a saved game.
	The autosave engine should write to a temporary name and rename it (Task 12), then a cut file never has the final name.

	API:
	  coop_saves.list_autosaves() -> { { name, slot, file_time, size, damaged }, ... } newest first.
	      name "coop_auto_2" or "coop_auto_<game>_2", file_time "dd/mm/yyyy hh:mm" (when the file was written), size in bytes,
	      damaged = the file is
	      below MIN_SAVE_BYTES. Only what the autosave engine writes counts (coop_autosave_rules.h parse_slot); quicksaves
	      and other names are not listed. Works when no coop_auto_N exists yet (empty list). Nothing is opened.
	  coop_saves.details(entry) -> entry   fills level (the engine's level name), level_text (its translation), game_time_str
	      "dd/mm/yyyy hh:mm" once, under pcall; a file with a bad header or one the wrapper cannot read gets damaged = true.
	  coop_saves.restore(name[, game_id]) -> true | false, why   host only, in a session: "load <name>". Without game_id only an
	      autosave; with it also any save whose block says that game (the timeline of the Co-op window).
	      why = not_host | bad_name | missing | damaged
	  coop_saves.hold(on)                            renews or lets go the pause of the autosaves (see below)
	  coop_saves.open_restore(owner) -> window       opens the list over the Co-op window `owner`
	  coop_saves.text(key, ...)                      the string st_coop_saves_<key> with %s filled in order

	While the restore window is open the host's autosave timer is paused (coop.autosave.suspend, F3 T12 review I1): the
	window renews the pause every frame (UICoopRestore:Update) and lets it go on Back and after the load command; a window
	closed any other way stops renewing it and the engine ends it by itself after 3 seconds.
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall
local string_format = string.format

local EXT = ".scop"
local MAX_ROWS = 10 -- the host keeps 10 autosaves
local ROW_STEP = 32 -- px between the rows of ui_coop_saves.xml
local MAX_SLOT_DIGITS = 9
-- Below this a file is no saved game: the smallest real one (a fresh new game) is megabytes, a save cut short by a crash
-- or a power loss is often less. The header check of valid_saved_game only looks at the first 8 bytes.
local MIN_SAVE_BYTES = 65536

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-saves] %s", ok and line or tostring(fmt))
end

-------------------------------------------------------------------------------
-- Session
-------------------------------------------------------------------------------
local function in_session()
	if not api then return false end
	local ok, active = pcall(api.is_active)
	return ok and active == true
end

local function is_host()
	if not api then return false end
	local ok, host = pcall(api.is_host)
	return ok and host == true
end

-------------------------------------------------------------------------------
-- Texts
-------------------------------------------------------------------------------
-- st_coop_saves_<key> with %s filled in order (no string.format: translations may contain other %).
function text(key, ...)
	local id = "st_coop_saves_" .. tostring(key)
	local s = tostring(game and game.translate_string and game.translate_string(id) or id)
	local n = select("#", ...)
	if n > 0 then
		local args, i = { ... }, 0
		s = s:gsub("%%s", function()
			i = i + 1
			return tostring(args[i] == nil and "" or args[i])
		end)
	end
	return s
end

-- Real time: time_global() stands still in the paused in-game menu.
local function now_ms()
	local d = rawget(_G, "device")
	if d then
		local ok, t = pcall(function() return d():time_continual() end)
		if ok and type(t) == "number" then return t end
	end
	return time_global()
end

-- The frame counter of the engine (render_device.frame), or the real time when the exe has none.
local function input_stamp()
	local d = rawget(_G, "device")
	if d then
		local ok, frame = pcall(function() return d().frame end)
		if ok and type(frame) == "number" then return frame, true end
	end
	return now_ms(), false
end

-- The last key the open in-game menu got (main_menu_on_keyboard comes first in main_menu:OnKeyboard, then the F5 / F6 / F7
-- branches send the save and load callbacks, all in one frame): the hint of such a key belongs to the menu's own message
-- line, the HUD is not drawn under the menu.
local MENU_KEY_MS = 100 -- only without a frame counter
local menu_key = nil -- { menu =, stamp =, by_frame = }

local function on_main_menu_keyboard(dik, action, menu, in_level)
	local stamp, by_frame = input_stamp()
	menu_key = { menu = menu, stamp = stamp, by_frame = by_frame }
end

-- One key, one callback, the same frame: the instance is dropped as soon as it is looked at (the engine deletes the menu
-- object when it builds the next one, a reference kept longer could point at a dead menu).
local function menu_of_key()
	local mk = menu_key
	menu_key = nil
	if not mk then return nil end
	local stamp = input_stamp()
	if mk.by_frame then
		if stamp == mk.stamp then return mk.menu end
	elseif stamp - mk.stamp <= MENU_KEY_MS then
		return mk.menu
	end
	return nil
end

-- A hint and a line in the log. `menu`: the main menu instance when the refused action came from it (stock
-- main_menu:SetMsg(text, seconds)); otherwise over the game (actor_menu.set_msg, like the other co-op hints).
local function hint(key, menu)
	local msg = text(key)
	log("%s", msg)
	menu = menu or menu_of_key()
	if menu and type(menu.SetMsg) == "function" and pcall(menu.SetMsg, menu, msg, 4) then return end
	local am = rawget(_G, "actor_menu")
	if am and am.set_msg then pcall(am.set_msg, 1, msg, 4) end
end

-------------------------------------------------------------------------------
-- Refusing save and load input
-------------------------------------------------------------------------------
-- The hint of a refusal: st_coop_saves_auto_host|client for a save, load_host|client for a load.
local function refusal_key(kind)
	return (kind == "load" and "load_" or "auto_") .. (is_host() and "host" or "client")
end

-- The rollback death mode: saves work as in the stock game, the host's to make and load.
local function saves_open()
	return type(api) == "table" and type(api.saves_open) == "function" and api.saves_open() == true
end

local function rollback_on_its_way()
	local m = rawget(_G, "coop_rollback")
	return m and m.pending and m.pending() == true
end

-- Stock: level_input.action_quick_save (F5, type 2) and the menu's F5 / F6 / Save (types 2, 3, 1) send this before they
-- save; flags.ret = true stops them.
local function on_before_save_input(flags, typ, label)
	if type(flags) ~= "table" or not in_session() then return end
	if saves_open() then
		if rollback_on_its_way() then
			flags.ret = true
		elseif not is_host() then
			flags.ret = true
			if typ == 2 and coop_mods_core.to_host("save_req", {}) then hint("asked") else hint("host_only") end
		elseif api.life_of(0) ~= "alive" then -- the engine's actor stands in for him: such a save loads to a black screen
			flags.ret = true
			hint("not_alive")
		end
		return
	end
	flags.ret = true
	hint(refusal_key("save"))
end

-- Stock: level_input.action_quick_load (F7). Note the argument order.
local function on_before_load_input(dik, bind, flags)
	if type(flags) ~= "table" or not in_session() then return end
	if saves_open() then
		if is_host() and not rollback_on_its_way() then return end
		flags.ret = true
		hint("host_only")
		return
	end
	flags.ret = true
	hint(refusal_key("load"))
end

-------------------------------------------------------------------------------
-- Entries of the in-game menu that the stock script does not gate (an old menu, opened before the session started)
-------------------------------------------------------------------------------
local menu_wrappers = {} -- method name -> our wrapper (to wrap once)

-- method of ui_main_menu.main_menu, and what it would do. The stock Save checks the save gate itself, but a click has no key
-- before it, and a stale menu is shown without the HUD: its refusal goes to the menu's own message line too.
local MENU_ENTRIES = {
	{ "OnButton_load_clicked", "load" },
	{ "OnButton_last_save", "load" },
	{ "OnButton_save_clicked", "save" },
}

local function wrap_main_menu()
	local mod = rawget(_G, "ui_main_menu") or ui_main_menu
	local cls = mod and mod.main_menu
	if not cls then return 0 end
	local wrapped = 0
	for _, entry in ipairs(MENU_ENTRIES) do
		local fname, kind = entry[1], entry[2]
		local ok, orig = pcall(function() return cls[fname] end)
		if ok and type(orig) == "function" and menu_wrappers[fname] ~= orig then
			local function wrapper(self, ...)
				if in_session() and (not (saves_open() and is_host()) or rollback_on_its_way()) then
					hint(saves_open() and "host_only" or refusal_key(kind), self)
					return
				end
				return orig(self, ...)
			end
			if pcall(function() cls[fname] = wrapper end) then
				menu_wrappers[fname] = wrapper
				wrapped = wrapped + 1
			end
		end
	end
	return wrapped
end

-------------------------------------------------------------------------------
-- The stock timer autosave
-------------------------------------------------------------------------------
-- game_autosave_new.actor_on_first_update creates the time event with the value of `autosave` it has at that moment,
-- so the wrapper must be in place before the first update of a level: on_game_start is early enough.
local autosave_wrapper = nil

local function stock_autosave_module()
	local ok, mod = pcall(function() return rawget(_G, "game_autosave_new") or game_autosave_new end)
	if ok and type(mod) == "table" then return mod end
	return nil
end

local function wrap_autosave()
	local mod = stock_autosave_module()
	if not (mod and type(mod.autosave) == "function") then
		log("! game_autosave_new.autosave not found: the stock timer autosave is not wrapped")
		return false
	end
	if mod.autosave == autosave_wrapper then return true end
	local orig = mod.autosave
	local function wrapper(...)
		if in_session() then
			-- what the stock tick does when it does not save: look again in a minute
			ResetTimeEvent("actor", "autosave_new", 60)
			return false
		end
		return orig(...)
	end
	mod.autosave = wrapper
	autosave_wrapper = wrapper
	return true
end

-- In a session the stock tick does not reach its save, so its own last_save stays where it was: the first tick after the
-- session would write a tempsave at once. When the session ends, the stock timer starts again from now
-- (game_autosave_new.option_updated sets its last_save to the present time).
local was_in_session = false

local function actor_on_update()
	local now = in_session()
	if was_in_session and not now then
		local mod = stock_autosave_module()
		if mod and type(mod.option_updated) == "function" then pcall(mod.option_updated) end
	end
	was_in_session = now
end

-------------------------------------------------------------------------------
-- The autosaves
-------------------------------------------------------------------------------
-- The slots of the ring in use: coop.autosave.parse_slot, the engine's own rule (coop_autosave_rules.h): the running game's
-- coop_auto_<game>_<N>, or coop_auto_<N> without a game. An exe without it has only the old ring, and this is its rule: lower
-- case, a plain number from 1 (no leading zero), at most nine digits, nothing after it.
local function parse_slot(stem)
	if type(stem) ~= "string" then return nil end
	local a = api and api.autosave
	if type(a) == "table" and type(a.parse_slot) == "function" then
		local ok, n = pcall(a.parse_slot, stem)
		if ok then return tonumber(n) end
	end
	local digits = stem:match("^coop_auto_([1-9]%d*)$")
	if not digits or #digits > MAX_SLOT_DIGITS then return nil end
	return tonumber(digits)
end

local function game_time_text(sg)
	local y, m, d, h, mi, s, ms = 0, 0, 0, 0, 0, 0, 0
	y, m, d, h, mi, s, ms = sg:game_time():get(y, m, d, h, mi, s, ms)
	return string_format("%02d/%02d/%d %02d:%02d", d, m, y, h, mi) -- the same order as file_time
end

-- What the folder says about every coop_auto_N, newest first. No save is opened here.
function list_autosaves()
	local out = {}
	local fs = getFS()
	local flist = fs:file_list_open_ex("$game_saves$", bit_or(FS.FS_ListFiles, FS.FS_RootOnly), "*" .. EXT)
	local count = flist and flist:Size() or 0
	if count == 0 then return out end
	flist:Sort(FS.FS_sort_by_modif_down) -- newest first
	for i = 0, count - 1 do
		local file = flist:GetAt(i)
		local stem = file:NameFull():match("^(.*)%.scop$")
		local slot = parse_slot(stem)
		if slot then
			local oks, size = pcall(function() return tonumber(file:Size()) end)
			size = oks and size or nil
			out[#out + 1] = {
				name = stem,
				slot = slot,
				file_time = file:ModifDigitOnly(),
				size = size,
				damaged = size ~= nil and size < MIN_SAVE_BYTES,
			}
		end
	end
	return out
end

-- What the folder says about one save, autosave or not. Nothing is opened.
local function find_save(name)
	local fs = getFS()
	local flist = fs:file_list_open_ex("$game_saves$", bit_or(FS.FS_ListFiles, FS.FS_RootOnly), name .. EXT)
	if not flist or flist:Size() == 0 then return nil end
	for i = 0, flist:Size() - 1 do
		local file = flist:GetAt(i)
		if file:NameFull():lower() == (name .. EXT):lower() then
			local oks, size = pcall(function() return tonumber(file:Size()) end)
			size = oks and size or nil
			return { name = name, size = size, damaged = size ~= nil and size < MIN_SAVE_BYTES }
		end
	end
	return nil
end

local function find_autosave(name)
	for _, e in ipairs(list_autosaves()) do
		if e.name == name then return e end
	end
	return nil
end

-- Does the block of this save say this game?
local function save_of_game(name, game_id)
	local ok, gs = pcall(function() return rawget(_G, "coop_game_settings") or coop_game_settings end)
	if not (ok and type(gs) == "table" and type(gs.game_of_save) == "function") then return false end
	local okg, id = pcall(gs.game_of_save, name)
	return okg and id ~= nil and id == game_id
end

-- The Load dialog's way of reading a save, for ONE entry, once: level, level_text, game_time_str. A file known to be
-- damaged is never opened. valid_saved_game() first: the CSavedGameWrapper constructor asserts when the file is missing
-- (and, in the engine, when the body is cut: that one nothing here can catch, hence the size check above).
function details(e)
	if type(e) ~= "table" or e.details_done then return e end
	e.details_done = true
	if e.damaged then return e end
	local okv, valid = pcall(valid_saved_game, e.name)
	if not (okv and valid == true) then
		e.damaged = true
		log("%s: the header is not a saved game", e.name)
		return e
	end
	local ok, sg = pcall(CSavedGameWrapper, e.name)
	if not ok then
		e.damaged = true
		log("! cannot read %s: %s", e.name, tostring(sg))
		return e
	end
	local okl, level = pcall(function() return sg:level_name() end)
	local okt, when = pcall(game_time_text, sg)
	e.level = okl and tostring(level) or ""
	e.level_text = e.level
	if e.level ~= "" then
		local okr, translated = pcall(game.translate_string, e.level)
		if okr and type(translated) == "string" and translated ~= "" then e.level_text = translated end
	end
	e.game_time_str = okt and when or "?"
	return e
end

-- The host's autosave timer must not write while the Restore window is open: it writes into the oldest slot, which is
-- often the one the host is about to pick (F3 T12 review I1). coop.autosave.suspend(true) is a pause with a short lease
-- that the open window renews every frame (UICoopRestore:Update), so a window closed in any way, a button, Escape or the
-- main menu switched off, ends it by itself a moment later; suspend(false) lets it go on purpose, and the engine then
-- starts the interval afresh (the first frame after a load must not write over a slot). An exe without the call: nothing.
local function hold_autosaves(on)
	local a = api and api.autosave
	if type(a) ~= "table" or type(a.suspend) ~= "function" then return end
	local ok, err = pcall(a.suspend, on)
	if not ok then log("! cannot %s the autosaves: %s", on and "pause" or "resume", tostring(err)) end
end

-- For a confirmation of another window: the same lease, renewed every frame while it is open.
function hold(on)
	hold_autosaves(on)
end

-- Host in a session, a real autosave (or, with game_id, a save of that game) that is in the folder and not damaged: the
-- same command the stock Load dialog gives in a running game.
function restore(name, game_id)
	if not (in_session() and is_host()) then return false, "not_host" end
	local slot = parse_slot(name)
	if not slot and not (game_id and save_of_game(name, game_id)) then return false, "bad_name" end
	local e = slot and find_autosave(name) or (not slot and find_save(name)) or nil
	if not e then return false, "missing" end
	if e.damaged then return false, "damaged" end
	local ok, valid = pcall(valid_saved_game, name)
	if not (ok and valid == true) then return false, "damaged" end
	log("the host restores %s", name)
	exec_console_cmd("load " .. name)
	hold_autosaves(false)
	return true
end

-------------------------------------------------------------------------------
-- Window: the list, the confirmation, the load
-------------------------------------------------------------------------------
local CLR = {}
local function colors()
	if CLR.on then return CLR end
	CLR.on = GetARGB(255, 240, 200, 120)
	CLR.off = GetARGB(255, 205, 205, 205)
	return CLR
end

local FAIL_KEY = {
	not_host = "restore_failed_not_host",
	bad_name = "restore_failed_bad_name",
	missing = "restore_failed_missing",
	damaged = "restore_failed_damaged",
}

-- A row says what the folder says; the level and the game time come with the selection.
local function row_text(e)
	local s = e.name .. "   -   " .. tostring(e.file_time)
	if e.damaged then s = s .. "   -   " .. text("restore_row_damaged") end
	return s
end

class "UICoopRestore" (CUIScriptWnd)

function UICoopRestore:__init(owner) super()
	self.owner = owner
	self.entries = {}
	self.selected = nil
	self:InitControls()
	self:InitCallBacks()
end

function UICoopRestore:__finalize()
end

function UICoopRestore:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:Enable(true)

	local xml = CScriptXmlInit()
	xml:ParseFile("ui_coop_saves.xml")

	xml:InitFrame("restore_shade", self)
	local d = xml:InitStatic("restore", self)
	xml:InitFrame("restore:frame", d)
	xml:InitStatic("restore:cap", d)
	xml:InitTextWnd("restore:info", d)
	xml:InitFrame("restore:list_frame", d)
	self.empty = xml:InitTextWnd("restore:empty", d)

	self.rows = {}
	for i = 1, MAX_ROWS do
		local b = xml:Init3tButton("restore:btn_row", d)
		local pos = b:GetWndPos()
		b:SetWndPos(vector2():set(pos.x, pos.y + (i - 1) * ROW_STEP))
		self:Register(b, "btn_row_" .. i)
		self.rows[i] = b
	end

	self.confirm = xml:InitTextWnd("restore:confirm", d)
	self.btn_confirm = xml:Init3tButton("restore:btn_confirm", d)
	self:Register(self.btn_confirm, "btn_confirm")
	local back = xml:Init3tButton("restore:btn_back", d)
	self:Register(back, "btn_back")
end

function UICoopRestore:InitCallBacks()
	local E = ui_events.BUTTON_CLICKED
	for i = 1, MAX_ROWS do
		self:AddCallback("btn_row_" .. i, E, function() self:OnRow(i) end, self)
	end
	self:AddCallback("btn_confirm", E, self.OnConfirm, self)
	self:AddCallback("btn_back", E, self.GoBack, self)
end

-- Every frame while the window is shown: the pause of the autosaves is renewed. A window hidden by anything other than
-- GoBack / the load stops renewing it, and the engine lets the pause lapse by itself.
function UICoopRestore:Update()
	CUIScriptWnd.Update(self)
	if self:IsShown() then hold_autosaves(true) end
end

-- Reads the folder; called every time the window opens.
function UICoopRestore:Reset()
	hold_autosaves(true)
	self.selected = nil
	self.entries = {}
	local ok, list = pcall(list_autosaves)
	if ok and type(list) == "table" then
		for i = 1, math.min(#list, MAX_ROWS) do self.entries[i] = list[i] end
	else
		log("! cannot list the autosaves: %s", tostring(list))
	end
	local c = colors()
	for i, b in ipairs(self.rows) do
		local e = self.entries[i]
		b:Show(e ~= nil)
		if e then
			b:TextControl():SetText(row_text(e))
			b:TextControl():SetTextColor(c.off)
		end
	end
	self.empty:Show(#self.entries == 0)
	self.confirm:SetText("")
	self.btn_confirm:Enable(false)
end

function UICoopRestore:OnRow(i)
	local e = self.entries[i]
	if not e then return end
	self.selected = i
	local c = colors()
	for j, b in ipairs(self.rows) do b:TextControl():SetTextColor(j == i and c.on or c.off) end
	-- the only place a save is opened: the one that was picked, once, under pcall
	local okd, err = pcall(details, e)
	if not okd then
		e.damaged = true
		log("! details of %s: %s", e.name, tostring(err))
	end
	self.rows[i]:TextControl():SetText(row_text(e)) -- it may have turned out damaged
	if e.damaged then
		self.confirm:SetText(text("restore_failed_damaged"))
		self.btn_confirm:Enable(false)
		return
	end
	self.confirm:SetText(text("restore_confirm", e.name, e.level_text, e.game_time_str, e.file_time))
	self.btn_confirm:Enable(true)
end

function UICoopRestore:OnConfirm()
	local e = self.selected and self.entries[self.selected]
	if not e or e.damaged then return end
	local ok, why = restore(e.name)
	if not ok then
		self.confirm:SetText(text(FAIL_KEY[why] or FAIL_KEY.missing))
		return
	end
	-- The load command has closed the main menu. Nothing of ours may stay open (the stock Load dialog leaves it so).
	if self:IsShown() then self:HideDialog() end
end

function UICoopRestore:GoBack()
	if self:IsShown() then self:HideDialog() end
	self:Show(false)
	hold_autosaves(false)
	local owner = self.owner
	if owner then
		pcall(function()
			owner:ShowDialog(true)
			owner:Show(true)
		end)
	end
end

function UICoopRestore:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
		self:GoBack()
		return true
	end
	return res
end

-- Opens the list over the Co-op window `owner` (host only: the caller checks, restore() checks again).
function open_restore(owner)
	local dlg
	local ok, err = pcall(function()
		dlg = UICoopRestore(owner)
		dlg:Reset()
		dlg:ShowDialog(true)
		owner:HideDialog()
		owner:Show(false)
	end)
	if not ok then
		log("! restore window failed: %s", tostring(err))
		return nil
	end
	return dlg
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
function print_status()
	local wrapped = 0
	for _ in pairs(menu_wrappers) do wrapped = wrapped + 1 end
	log("saves: session %s, host %s | autosave wrapper %s, menu entries wrapped %d",
		in_session() and "yes" or "no", is_host() and "yes" or "no", autosave_wrapper and "on" or "off", wrapped)
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an error here
-- would skip all the scripts after this one, single player included.
local function start_step(what, f)
	local ok, err = pcall(f)
	if not ok then printf("! [coop_saves] %s failed: %s", what, tostring(err)) end
end

function on_game_start()
	if not api then return end -- an exe without co-op: nothing of this runs
	RegisterScriptCallback("on_before_save_input", on_before_save_input)
	RegisterScriptCallback("on_before_load_input", on_before_load_input)
	RegisterScriptCallback("main_menu_on_keyboard", on_main_menu_keyboard)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	start_step("wrap_main_menu", wrap_main_menu)
	start_step("wrap_autosave", wrap_autosave)
end
