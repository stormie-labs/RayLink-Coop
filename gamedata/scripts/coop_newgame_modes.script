--[[
	Anomaly Coop - the new game screen of a co-op host (gamedata\scripts\coop_newgame_modes.script), owner's rulings of
	2026-10-23. The stock screen (ui_mm_faction_select.UINewGame, tab "Modes") offers things that do not work in co-op or are
	not part of the design. When the new game is started for the host of a co-op session, the screen changes:

	  stays      Story mode (check_story), Open Zone (check_routes), Game difficulty, Economy difficulty, the faction, the name
	  hidden and forced off (checks unchecked, lists on "off", nothing of them reaches the game):
	             Life after life (check_azazel_mode), One life (check_hardcore) with its Lives and Days for an extra life
	             (list_hardcore_lives, list_hardcore_regen), Soulslike mode (check_soulslike_mode, GAMMA), Campfire saves
	             (check_campfire), Agony (check_conditions), Timer (list_timer), Survival mode (check_survival), Faction war
	             (check_warfare)
	  shown      a block "Game settings" in the place of the hidden second column (docs\GAME_SETTINGS.md 4.1): a strip of tabs
	             (Death, Party, World, Saves, Other) over the catalog of the host's settings (coop_game_schema), a row "caption -
	             combo box" per setting (coop_game_settings_view), a hint under the block. The lists start on the machine's
	             values (coop_game_settings.defaults(); without that module: the console's and axr's values over the catalog's
	             defaults). Start does three things, all before the world is made:
	               1. stage_new: the record of the new game (coop_game_record.new over the chosen values; the name, the faction
	                  dlg.selected_faction and the creation flags of the stock controls) goes to coop_game_settings.stage_new,
	                  which hands it to the engine; the first save of the world carries it
	               2. the group's rules (console variables c|*, session rules coop/coop_session/* of axr [options]) are written to
	                  the machine where they differ - "remember my choice" for the next new game; cfg_save after the console.
	                  The stock options and MCM keys of the machine are not touched, they act in a single player game
	               3. the stock OnStartGame (with whatever wrappers GAMMA put around it)
	             Untouched settings write nothing to the machine. The settings of a game are changed later in the Co-op window
	             (Game settings).
	A single player game (no session, nothing pending, no -coop_host) keeps the whole stock screen.

	Which new game is a co-op host's (is_coop_new_game): coop.session_info().pending_host - the Co-op window (coop_menu
	UICoopMenu:HostAfter) asks coop.host_when_ready(port) before it opens this screen, and the engine keeps the request
	until the new world is up (coop_script.cpp menu_pending_frame); .host - a session that is already running; or
	-coop_host on the command line (tools\launch.ps1 -HostSession: the engine hosts as soon as a level is ready,
	Manager::autostart). A connected client never is: it does not set up the group's game. tools\launch.ps1 -NewGame does not
	open this screen at all (it writes [character_creation] itself, without any of the modes), see on_game_start below.

	How it is wired (nothing of the stock files is edited):
	  - modxml_coop_newgame.script (dxml start-up, also in the cold-start main menu) registers main_menu_on_init, which calls
	    install(): a wrapper of ui_main_menu.main_menu:ShowFactionUI by assignment into the class table. After the stock
	    method has built and shown the dialog, apply() changes it. This is independent of the order in which GAMMA's own
	    wrappers of UINewGame (souslike_gamemode_injector_mcm: Main_Controls adds check_soulslike_mode) were installed, because
	    nothing is wrapped inside the dialog's construction.
	  - the dialog is cached by the stock menu (new_game_dlg). A cached dialog built for the other kind of game is dropped
	    before the stock method runs, and a co-op dialog is always built again (the console may have changed): the player
	    sees the right screen however he walked in and out.
	  - the start button's callback of THIS dialog is replaced (AddCallback replaces a control + event pair in this engine,
	    UIWndCallback.cpp): it forces the modes off again (a mod may have ticked them), clears their keys from
	    [character_creation], stages the game and writes the rules (when the stock would start: a name, no pop-up), then calls
	    dlg:OnStartGame() - the stock method with whatever wrappers GAMMA put around it. The stock reads the unchecked boxes
	    and writes no mode.
	  - on_game_start (every game start, before the stock on_game_load reads [character_creation]): for a co-op host the
	    mode keys are cleared from the config. This is for a start that did not come through the screen (a hand-edited
	    axr_options.ltx). The order of callbacks of one name is not defined, so it cannot be done in on_game_load.
	A failing step (an unknown layout, a missing control, a missing or failing coop_game_settings) is logged and skipped; it
	never stops the screen or the start. A game that could not be staged is made from the machine's values and takes its
	record from them at the first load.
--]]

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall
local string_format = string.format

local SECTION = "character_creation"
local REPOSITION_ROWS = { 30, 60 } -- y of the caption of the first and second row of the left column (stock layout)

local function coop_api()
	return rawget(_G, "coop") -- engine namespace, nil on an exe without co-op
end

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-newgame] %s", ok and line or tostring(fmt))
end

-- a step that may fail must not stop the ones after it
local function try(what, f, ...)
	local ok, err = pcall(f, ...)
	if not ok then log("! %s failed: %s", what, tostring(err)) end
	return ok
end

local function call(obj, method, ...)
	if obj == nil then return end
	local ok, err = pcall(obj[method], obj, ...)
	if not ok then log("! %s failed: %s", tostring(method), tostring(err)) end
end

local function tr(id)
	local ok, s = pcall(function() return game.translate_string(id) end)
	if ok and s ~= nil then return tostring(s) end
	return id
end

-- the module of a stock script (_G.__index loads gamedata\scripts\<name>.script on the first access)
local function mod(name)
	local m = rawget(_G, name)
	if m == nil then
		local ok, r = pcall(function() return _G[name] end)
		m = ok and r or nil
	end
	return type(m) == "table" and m or nil
end

-------------------------------------------------------------------------------
-- Which new game is a co-op host's
-------------------------------------------------------------------------------
local function command_line_hosts()
	local f = rawget(_G, "command_line")
	if type(f) ~= "function" then return false end
	local ok, line = pcall(f)
	return ok and type(line) == "string" and line:find("%-coop_host") ~= nil
end

function is_coop_new_game()
	local api = coop_api()
	if not api then return false end
	local ok, info = pcall(api.session_info)
	if ok and type(info) == "table" then
		if info.client == true then return false end
		if tonumber(info.pending_host) ~= nil then return true end
		if info.host == true then return true end
	end
	return command_line_hosts()
end

-------------------------------------------------------------------------------
-- The ten modes of the stock screen: fields of UINewGame, the caption of a field is <field>_cap
-------------------------------------------------------------------------------
local MODES = {
	{ field = "ck_azazel_mode", check = true },
	{ field = "ck_hardcore", check = true },
	{ field = "list_hardcore_lives" },
	{ field = "list_hardcore_regen" },
	{ field = "ck_soulslike_mode", check = true }, -- GAMMA only (Soulslike Gamemode adds it to the screen)
	{ field = "ck_campfire", check = true },
	{ field = "ck_conditions", check = true },
	{ field = "list_timer" },
	{ field = "ck_survival", check = true },
	{ field = "ck_warfare", check = true },
}

-- [character_creation] keys the stock OnStartGame writes for them (soulslike: the GAMMA injector)
local MODE_KEYS = {
	"new_game_hardcore_mode", "new_game_hardcore_mode_lives", "new_game_hardcore_mode_regenerate", "new_game_azazel_mode",
	"new_game_survival_mode", "new_game_campfire_mode", "new_game_conditions_mode", "new_game_warfare",
	"new_game_timer_mode", "new_game_soulslike_mode",
}

-- Clears the mode keys from axr_options.ltx [character_creation]; returns how many were set. Read without the cache of
-- ini_file_ex.r_value (it would keep a string under a key the stock reads as a bool); a cleared line is "".
local function clear_config_modes()
	local am = rawget(_G, "axr_main")
	local cfg = am and am.config
	if not cfg then return 0 end
	local n = 0
	for _, key in ipairs(MODE_KEYS) do
		local v
		if cfg.r_string_ex then v = cfg:r_string_ex(SECTION, key) else v = cfg:r_value(SECTION, key, 3) end
		if v ~= nil and v ~= "" and v ~= "false" then
			cfg:w_value(SECTION, key)
			n = n + 1
		end
	end
	if n > 0 then cfg:save() end
	return n
end

-------------------------------------------------------------------------------
-- The dialog
-------------------------------------------------------------------------------
local function hide_modes(dlg)
	for _, mode in ipairs(MODES) do
		local ctl, cap = dlg[mode.field], dlg[mode.field .. "_cap"]
		if ctl ~= nil then
			call(ctl, "Show", false)
			call(ctl, "Enable", false)
			if mode.check then call(ctl, "SetCheck", false) end
		end
		call(cap, "Show", false)
		if type(dlg.ck_states) == "table" then dlg.ck_states[mode.field] = nil end -- no hover hint of a hidden box
	end
end

-- everything the stock start reads is on "off" (a mod may have ticked a box; the lists keep their first entry)
local function force_off(dlg)
	for _, mode in ipairs(MODES) do
		if mode.check then call(dlg[mode.field], "SetCheck", false) end
	end
	if type(dlg.table_hardcore_lives) == "table" then dlg.selected_hardcore_lives = dlg.table_hardcore_lives[1] end
	if type(dlg.table_hardcore_regen) == "table" then dlg.selected_hardcore_regen = dlg.table_hardcore_regen[1] end
	if type(dlg.table_timer) == "table" then dlg.selected_timer = dlg.table_timer[1] end
	clear_config_modes()
end

-- one row of the left column: the caption at y, the check box one pixel above (stock layout)
local function move_row(dlg, field, y)
	local cap, ctl = dlg[field .. "_cap"], dlg[field]
	if cap == nil or ctl == nil then return end
	local pc, pk = cap:GetWndPos(), ctl:GetWndPos()
	cap:SetWndPos(vector2():set(pc.x, y))
	ctl:SetWndPos(vector2():set(pk.x, y - 1))
end

local function reflow(dlg)
	move_row(dlg, "ck_story", REPOSITION_ROWS[1])
	move_row(dlg, "ck_routes", REPOSITION_ROWS[2])
end

-------------------------------------------------------------------------------
-- The game settings block
-------------------------------------------------------------------------------
-- The tabs of the screen. "Difficulty" is the stock pair of lists on the left, so the block has no tab for it.
local TABS = { "death", "party", "world", "saves", "other" }
-- Catalog items that the controls of the stock screen carry (faction button, Story, Open Zone, the two lists): no row.
local EXTERNAL = { ["faction"] = true, ["w|story"] = true, ["w|routes"] = true, ["w|difficulty"] = true, ["w|economy"] = true }

local function schema()
	return mod("coop_game_schema")
end

-- Value of a console variable of the engine as a trimmed string, nil = there is no such variable
local function console_value(name)
	local f = rawget(_G, "get_console_cmd")
	if type(f) ~= "function" then return nil end
	local ok, v = pcall(f, 0, name)
	if not ok or v == nil then return nil end
	return (tostring(v):gsub("^%s+", ""):gsub("%s+$", ""))
end

-- Raw string of an option of axr_options.ltx on this machine, nil = not stored. Read without the cache of ini_file_ex.
local function machine_option(src, path)
	local am = rawget(_G, "axr_main")
	local cfg = am and am.config
	if not cfg then return nil end
	local section = src == "m" and "mcm" or "options"
	local ok, v
	if cfg.r_string_ex then
		ok, v = pcall(cfg.r_string_ex, cfg, section, path)
	else
		ok, v = pcall(cfg.r_value, cfg, section, path, 3)
	end
	if not ok or v == nil or v == "" then return nil end
	return tostring(v)
end

-- The machine's raw value of a catalog key, nil = the machine has none.
local function machine_raw(sc, key)
	local src, path = sc.parse_key(key)
	if src == "c" then return console_value(path) end
	if src == "o" or src == "m" then return machine_option(src, path) end
	return nil
end

-- The values the screen starts from when the host runtime (coop_game_settings.defaults) is not there: the machine's console
-- and options for the catalog's keys; the catalog's own defaults fill in the rest (the view).
local function fallback_values()
	local out = {}
	local sc = schema()
	if not sc then return out end
	for _, key in ipairs(sc.keys()) do
		local raw = machine_raw(sc, key)
		if raw ~= nil then out[key] = raw end
	end
	return out
end

-- coop_game_settings.defaults(): the machine's values and the catalog's defaults, as the record keeps them. A copy: the view
-- writes into it.
local function start_values()
	local gs = mod("coop_game_settings")
	if gs and type(gs.defaults) == "function" then
		local ok, v = pcall(gs.defaults)
		if ok and type(v) == "table" then
			local out = {}
			for k, x in pairs(v) do out[k] = x end
			return out
		end
		log("! coop_game_settings.defaults failed (%s): the values of the machine are read here", tostring(v))
	end
	return fallback_values()
end

-- How many options of the machine the record takes as they are: [options] / [mcm] keys outside the catalog.
local function count_other(values)
	local sc = schema()
	local n_o, n_m = 0, 0
	if not sc then return n_o, n_m end
	for key in pairs(values) do
		local src = sc.parse_key(key)
		if (src == "o" or src == "m") and sc.item(key) == nil then
			if src == "o" then n_o = n_o + 1 else n_m = n_m + 1 end
		end
	end
	return n_o, n_m
end

local function build_block(dlg)
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_coop_newgame.xml") -- ui_coop_newgame_16.xml on wide screens
	local parent = dlg.templ_options
	local path = "main_dialog:options:"
	local values = start_values()
	local ok_date, stamp = pcall(function() return os.date("%Y-%m-%d %H:%M") end)
	dlg.coop_snapshot_at = ok_date and stamp or ""
	dlg.coop_header = xml:InitStatic(path .. "cap_gs_header", parent)
	local view_module = mod("coop_game_settings_view")
	dlg.coop_view = view_module.new(dlg, {
		xml = xml, parent = parent, path = path, values = values, tabs = TABS, external = EXTERNAL,
		pages = {
			other = function()
				local n_o, n_m = count_other(values)
				return string_format(tr("st_coop_newgame_other"), tostring(n_o), tostring(n_m), dlg.coop_snapshot_at)
			end,
		},
		notes = { saves = "st_coop_newgame_saves_note" },
	})
	dlg.coop_hint = xml:InitTextWnd(path .. "text_gs_hint", parent)
	dlg.coop_hint:SetText(tr("st_coop_newgame_hint"))
end

-- "st_diff_2" -> 2 (the stock keeps the preset as the id of its string)
local function preset_number(id, prefix)
	return tonumber((tostring(id or ""):gsub("^" .. prefix, ""))) or 1
end

local function flag(ctl)
	if ctl == nil then return nil end
	local ok, v = pcall(function() return ctl:GetCheck() end)
	if ok and type(v) == "boolean" then return v end
	return nil
end

-- What the record takes from the stock controls: the name, the group's faction and the creation flags of the world; and the
-- title the player typed in the Co-op window before this screen.
function record_meta(dlg)
	local name = ""
	local ok, text = pcall(function() return dlg.character_name:GetText() end)
	if ok and type(text) == "string" then name = text end
	local games = mod("coop_games")
	return {
		name = name,
		title = games and games.take_new_title and games.take_new_title() or nil,
		faction = type(dlg.selected_faction) == "string" and dlg.selected_faction or nil,
		world = {
			story = flag(dlg.ck_story), routes = flag(dlg.ck_routes),
			difficulty = preset_number(dlg.selected_difficulty, "st_diff_"),
			economy = preset_number(dlg.selected_economy, "st_econ_"),
		},
	}
end

-- Hands the new game to the host runtime: the engine keeps it until the new world is made (coop.game.stage_new), the
-- world's first save carries it. False (and a log line) when it could not be done: the world is then made from the
-- machine's values and the record is taken from them at the first load (docs\GAME_SETTINGS.md 5).
local function stage(dlg, values)
	local gs = mod("coop_game_settings")
	if not (gs and type(gs.stage_new) == "function") then
		log("! coop_game_settings.stage_new is missing: the new game is not staged, the machine's values stay")
		return false
	end
	local rec = mod("coop_game_record")
	if not rec then
		log("! coop_game_record is missing: the new game is not staged")
		return false
	end
	local record = rec.new(values, record_meta(dlg))
	record.machine_snapshot_at = dlg.coop_snapshot_at
	local ok, res, why = pcall(gs.stage_new, record) -- true, or false and the reason
	if not ok then
		log("! stage_new failed: %s", tostring(res))
		return false
	end
	if res ~= true then
		log("! stage_new did not take the record: %s", tostring(why))
		return false
	end
	return true
end

-- Remembers the group's rules for the next new game: the console variables (c|*) and the session rules (coop/coop_session/*
-- of axr [options]) become the machine's values, written only where they differ. The stock options and the MCM keys of the
-- machine are not touched: they act in a single player game. cfg_save, as the options page does on Apply.
local function remember_rules(values)
	local sc = schema()
	if not sc then return end
	local exec = rawget(_G, "exec_console_cmd")
	local am = rawget(_G, "axr_main")
	local cfg = am and am.config
	local console_changed, axr_changed = false, false
	for _, key in ipairs(sc.keys()) do
		local src, path = sc.parse_key(key)
		local rule = src == "o" and path:find("^coop/coop_session/") ~= nil
		if (src == "c" or rule) and values[key] ~= nil then
			local chosen = sc.canon(key, values[key])
			local typed = nil
			local mraw = machine_raw(sc, key)
			if mraw ~= nil then typed = sc.normalize(key, mraw) end -- an invalid value counts as the default, as the view shows it
			if typed == nil then typed = sc.default(key) end
			if typed == nil or sc.to_raw(key, typed) ~= chosen then
				if src == "c" then
					if type(exec) == "function" then
						exec(path .. " " .. chosen)
						console_changed = true
					end
				elseif cfg then
					cfg:w_value("options", path, sc.normalize(key, chosen)) -- typed: ini_file_ex caches what it is given
					axr_changed = true
				end
			end
		end
	end
	if console_changed then exec("cfg_save") end
	if axr_changed then cfg:save() end
end

-- The new game: the record is staged (the world's faction and the settings of this game), the rules are remembered.
local function write_rules(dlg)
	local view = dlg.coop_view
	if type(view) ~= "table" then return end
	local values = view:collect()
	try("stage the new game", stage, dlg, values)
	try("remember the rules", remember_rules, values)
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
-- the stock OnStartGame returns without starting when a pop-up is open or the name is empty
local function will_start(dlg)
	if dlg.access == false then return false end
	local ok, name = pcall(function() return dlg.character_name:GetText() end)
	if ok and name == "" then return false end
	return true
end

-- Module function: the callback of btn_start of a co-op dialog (stored by AddCallback).
function on_start_clicked(dlg)
	try("modes off", force_off, dlg)
	if will_start(dlg) then try("game settings", write_rules, dlg) end
	return dlg:OnStartGame()
end

local function hook_start(dlg)
	dlg:AddCallback("btn_start", ui_events.BUTTON_CLICKED, on_start_clicked, dlg)
end

-- Sets up a freshly built stock dialog for a co-op host.
function apply(dlg)
	if dlg == nil then return end
	dlg.coop_modes_applied = true
	try("hide the modes", hide_modes, dlg)
	try("start button", hook_start, dlg)
	try("left column", reflow, dlg)
	try("game settings block", build_block, dlg)
end

local function wrap_show_faction_ui(orig)
	return function(self, ...)
		local coop_game = is_coop_new_game()
		local ok, dlg = pcall(function() return self.new_game_dlg end)
		if ok and dlg ~= nil then
			local was = false
			pcall(function() was = dlg.coop_modes_applied == true end)
			if coop_game or was then self.new_game_dlg = nil end -- built for the other kind of game, or the console may have changed
		end
		local result = orig(self, ...)
		if coop_game then
			local okd, built = pcall(function() return self.new_game_dlg end)
			if okd and built ~= nil then
				try("new game screen", apply, built)
			else
				log("! no new game dialog after ShowFactionUI: the stock screen stays")
			end
		end
		return result
	end
end

local ours = {} -- the wrappers this script made: never wrapped again

local function wrap(tbl, key, make)
	local orig = tbl[key]
	if type(orig) ~= "function" or ours[orig] then return false end
	local w = make(orig)
	ours[w] = true
	tbl[key] = w
	return true
end

-- Called from the main menu's init (modxml_coop_newgame). Idempotent.
function install()
	local m = mod("ui_main_menu")
	local cls = m and m.main_menu
	-- a luabind class (class "main_menu") is a userdata: the table-only check left the stock screen (live 2026-10-24)
	if type(cls) ~= "table" and type(cls) ~= "userdata" then
		log("! ui_main_menu.main_menu is missing: the new game screen stays the stock one")
		return false
	end
	return wrap(cls, "ShowFactionUI", wrap_show_faction_ui)
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop.
function on_game_start()
	if not coop_api() then return end
	try("clear the modes", function()
		if is_coop_new_game() and clear_config_modes() > 0 then log("modes of a co-op host cleared from [character_creation]") end
	end)
end
