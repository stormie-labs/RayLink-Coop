-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - the stock bounty squads (sim_squad_bounty.script) per character.

	The stock (Anomaly 1.5.3) keeps one bounty for db.actor: its rank and reputation (:126, :132), its faction (:34), one
	cooldown and one list of squads (:220-239), and sends every squad at "the actor" (:71), which is id 0. Its timers are the
	"host" domain (configs\coop_route_stock.ltx:75): the co-op host's process judged its own character, the world server judged
	its ghost at fake_start. Its smarts are chosen 200 m away from db.actor only (:45-46), so a squad could appear next to
	another player.

	In a session, on the process that decides the world (coop_mode.decides_world: the co-op host, the world server), the spawn
	timer runs per character instead:
	  - every player's character in the session is judged by its own rank and reputation (the object here, else its ALife record:
	    the engine puts a player's progress on both, coop_story.cpp apply_progress), with the stock's danger tables;
	  - each character has its own cooldown (the stock's delay from his first due tick, then from his last squad) and his own
	    squads (at most the stock's number for him);
	  - the faction is coop_faction.faction_of_character's (the group's in the co-op, his own in the server mode), its enemies
	    from the stock's faction list send the squad;
	  - the smart is on his map or a linked one (the map of his character, never of a ghost) and farther than the stock's
	    spawn_distance from every player's character on the smart's map;
	  - the squad is made as the stock makes it (create_squad, "actor", rush) and kept in the stock's active_squads too
	    (dynamic_news_manager's gossip, the stock's state timer).
	A squad sent at "the actor" (assigned target 0) whose target is a character of ours goes to that character
	(sim_squad_scripted:get_current_task): his object here, else his record. The squad of this process's own player character
	(the co-op host's) stays the stock's. A process that only runs squads (a map server holding one online) knows the targets
	from the world's decider (event below). Where the place in a session is the mode's: coop_mode.where says who is not placed yet.
	Outside a session every wrapper calls the stock as it is; a player's mirror never runs the timer (the router drops it).

	API:
	  coop_bounty.target_of(squad_id) -> character id (this process's numbering), his peer | nil
	  coop_bounty.targets_pending() -> true where this map needs its first target list from the decider
	  coop_bounty.squads_of(character_id) -> { [squad id] = section } (a copy)
	  coop_bounty.records() -> { [character id] = { last = CTime | nil, squads = { [squad id] = section } } } (a copy; only
	                           the world's decider keeps them current, another process has what its load gave it)
	  coop_bounty.position_of(character_id) -> position, game vertex, level vertex, level id | nil (his object here, else his record)
	  coop_bounty.status() -> one line (coop_status)
	Saved (the world's decider, save_state): m_data.coop_bounty = { v = 1, c = { [character id] = { t = CTime table,
	  s = { [squad id] = section } } } }. The stock's m_data.bounty_squad stays the stock's.
	Event: mods.bounty_t  world's decider -> every machine with a copy of the world (coop_mode.publish), on change and every
	  30 s while there are targets or a bridge has requested a snapshot: { g = generation, i = chunk index, k = chunk count,
	  n = entry count, s<i> = squad id, c<i> = character id } in host numbering; listened to from peer 0 only.
	Event: mods.bounty_req (empty payload) from a map server's bridge once per live connection while it lacks a list.
	  The decider answers with mods.bounty_t, including an empty list, and repeats it to recover from missed replies.
--]]

local type, pairs, ipairs, pcall, tostring, tonumber, next = type, pairs, ipairs, pcall, tostring, tonumber, next
local string_format, math_floor = string.format, math.floor

local TAG = "bounty"
local SNAPSHOT = "mods.bounty_t"
local REQUEST = "mods.bounty_req"
local SAVE_KEY = "coop_bounty"
local TARGETS_PER_CHUNK = 64
local MAX_ID = 65534
local MAX_CHUNKS = math.ceil((MAX_ID + 1) / TARGETS_PER_CHUNK)
local MAX_GENERATION = 0x7fffffff
local MAX_CHUNK_BYTES = 2048
local CHUNKS_PER_UPDATE = 32 -- leave room for other events in the engine's 512-entry outbox
local PUBLISH_MS = 30000
local LOOK_MS = 1000
local REQUEST_MS = 5000
local REQUEST_SLOTS = 16 -- the engine currently has seven map bridge slots
local TIMER_EV, TIMER_ACT = "cycle", "bounty_squad_spawn" -- the stock's time event (sim_squad_bounty.script:121, :299)

local cfg = nil -- the stock's tables and numbers (file locals of sim_squad_bounty), nil: not installed
local book = {} -- the world's decider: character id -> { last = CTime | nil, squads = { [squad id] = section } }
local owner = {} -- the world's decider: squad id -> character id (built from records)
local mirror = {} -- another process: squad id -> character id (local numbering), as the world's decider published it
local previous_mirror -- solely to cancel old orders omitted from the first complete snapshot after reconnect
local dirty = false -- the targets changed since the last publication
local next_publish = 0
local next_look = 0 -- actor_on_update looks at the publication once a second
local target_link_live, request_sent, have_snapshot = false, false, false
local snapshot_requested, repeat_snapshot = false, false
local request_after = {}
local outgoing, incoming
local send_generation, received_generation = 0, 0
local wrapped = { spawn = false, task = false }
local stats = { passes = 0, spawned = 0, near = 0, no_smart = 0, no_faction = 0, redirected = 0, published = 0, received = 0,
	dropped = 0, errors = 0 }

local function report(what, err)
	stats.errors = stats.errors + 1
	coop_mods_core.report(TAG, what, err)
end

local function valid_id(id)
	return type(id) == "number" and id >= 0 and id <= MAX_ID and id == math_floor(id)
end

local function count(t)
	local n = 0
	for _ in pairs(t) do n = n + 1 end
	return n
end

-- This process's own player character (the co-op host's, a client's), nil for a ghost.
local function own_character()
	local a = db.actor
	if a and coop_mode.actor_is_player() then return a end
	return nil
end

-------------------------------------------------------------------------------
-- Characters and where they stand
-------------------------------------------------------------------------------
-- Every player's character in the session, this process's own first: { id, peer, obj = his object here | nil }. A player who
-- is not placed yet (joining) and a ghost are left out.
local function characters()
	local out, seen = {}, {}
	local own = own_character()
	if own then
		local id = own:id()
		out[1] = { id = id, peer = coop_mods_core.self_peer(), obj = own }
		seen[id] = true
	end
	for _, p in ipairs(coop_util.players()) do
		local id = p.avatar_id
		if not p.is_self and valid_id(id) and not seen[id] and type(p.id) == "number" and coop_mode.where(p.id) ~= "joining" then
			seen[id] = true
			out[#out + 1] = { id = id, peer = p.id, obj = level.object_by_id(id) }
		end
	end
	return out
end

-- Position, game vertex, level vertex of a character: his object here, else his ALife record.
local function place(c)
	local o = c.obj
	if o then
		local ok, pos, gv, lv = pcall(function() return o:position(), o:game_vertex_id(), o:level_vertex_id() end)
		if ok and pos and type(gv) == "number" then return pos, gv, lv end
	end
	local se = alife_object(c.id)
	if se and se.position then return se.position, se.m_game_vertex_id, se.m_level_vertex_id end
	return nil
end

local function object_of(id)
	local own = own_character()
	if own and own:id() == id then return own end
	return level.object_by_id(id)
end

function position_of(id)
	if not valid_id(id) then return nil end
	local pos, gv, lv = place({ id = id, obj = object_of(id) })
	if not pos then return nil end
	return pos, gv, lv, coop_util.level_of_gvid(gv)
end

-- How many squads his rank and reputation call for (the stock's spawn_timer, :123-135, for him).
local function danger(c)
	local who = c.obj or alife_object(c.id)
	if not who then return 0 end
	local n = 0
	local rank = ranks.get_obj_rank_name(who)
	if rank and cfg.ranks[rank] then n = n + (tonumber(cfg.ranks[rank]) or 0) end
	local rep
	if who.character_reputation then rep = who:character_reputation() elseif who.reputation then rep = who:reputation() end
	if type(rep) == "number" then
		local name = utils_obj.get_reputation_name(rep)
		if name and cfg.reps[name] then n = n + (tonumber(cfg.reps[name]) or 0) end
	end
	return n
end

-- His community for the stock's enemy test: "actor_" .. the faction the world's decider gives him; without an answer, the
-- community his object or record has (the stock reads db.actor's).
local function community_of(c)
	local cf = coop_util.module("coop_faction")
	local f = cf and cf.faction_of_character and cf.faction_of_character(c.id)
	if type(f) == "string" and f ~= "" then return "actor_" .. f end
	local who = c.obj or alife_object(c.id)
	if not who then return nil end
	local comm
	if who.character_community then comm = who:character_community() elseif who.community then comm = who:community() end
	return type(comm) == "string" and comm or nil
end

-------------------------------------------------------------------------------
-- Records
-------------------------------------------------------------------------------
local function reindex()
	owner = {}
	for id, rec in pairs(book) do
		for sid in pairs(rec.squads) do owner[sid] = id end
	end
end

local function record(id)
	local rec = book[id]
	if not rec then
		rec = { squads = {} }
		book[id] = rec
	end
	return rec
end

-- A squad that is gone (or whose id is another object now) leaves the records, as the stock's state timer cleans its table.
local function clean()
	for id, rec in pairs(book) do
		for sid, section in pairs(rec.squads) do
			local se = alife_object(sid)
			local ok, sec = pcall(function() return se and se:section_name() end)
			if not (ok and sec == section) then
				rec.squads[sid] = nil
				dirty = true
			end
		end
		if rec.last == nil and next(rec.squads) == nil then book[id] = nil end
	end
	reindex()
end

-- The stock's own table (sim_squad_bounty.get_active_squads: a new table after its load) holds our squads too.
local function sync_stock()
	local m = coop_util.module("sim_squad_bounty")
	local get = m and coop_mods_core.fn(m, "get_active_squads")
	local t = get and get()
	if type(t) ~= "table" then return end
	for _, rec in pairs(book) do
		for sid, section in pairs(rec.squads) do
			if t[sid] == nil then t[sid] = section end
		end
	end
end

local function revoke_order(sid, section)
	local orders = coop_util.module("coop_bounty_orders")
	local revoke = coop_mods_core.fn(orders, "revoke")
	if revoke then
		local ok, err = pcall(revoke, sid, section)
		if not ok then report("revoke order", err) end
	end
end

-------------------------------------------------------------------------------
-- Publication of the targets (the world's decider) and its copy elsewhere
-------------------------------------------------------------------------------
local function needs_remote_targets()
	return coop_util.active() and coop_mode.leads_for_world_elsewhere()
end

local function update_target_link(needed)
	local live = needed and coop_mods_core.engine().is_live()
	if target_link_live and not live then
		if have_snapshot then previous_mirror = mirror end
		request_sent, have_snapshot = false, false
		incoming, received_generation = nil, 0
		mirror = {}
	end
	target_link_live = live
	return live
end

function targets_pending()
	return needs_remote_targets() and (not update_target_link(true) or not have_snapshot)
end

local function event_ok(name, ok, fmt, ...)
	if not coop_trust.pass(name, ok, fmt, ...) then return false end
	return ok -- sender, wire and rate checks are mandatory in every trust setting
end

-- A bridge asks the world itself, so this is a world event rather than a player's level request.
local function on_target_request(payload, from)
	local is_sender = type(from) == "number" and coop_util.active() and coop_mode.decides_world() and coop_mode.from_level(from)
	if not event_ok("bounty_request_sender", is_sender, "bounty request from non-bridge peer %s", tostring(from)) then return end
	if not event_ok("bounty_request_payload", payload == "", "nonempty bounty request from map peer %s", tostring(from)) then return end
	local now = time_global()
	for bridge, after in pairs(request_after) do
		if now >= after then request_after[bridge] = nil end
	end
	local allowed = request_after[from] == nil and count(request_after) < REQUEST_SLOTS
	if not event_ok("bounty_request_rate", allowed, "bounty request cooldown from map peer %s", tostring(from)) then return end
	request_after[from] = now + REQUEST_MS
	snapshot_requested, repeat_snapshot = true, true
end

local function snapshot_chunks()
	local t = { n = 0 }
	local chunks = { t }
	for sid, cid in pairs(owner) do
		local hs, hc = coop_mods_core.hid(sid), coop_mods_core.hid(cid)
		if valid_id(hs) and hs ~= 0 and valid_id(hc) then
			if t.n == TARGETS_PER_CHUNK then
				t = { n = 0 }
				chunks[#chunks + 1] = t
			end
			t.n = t.n + 1
			t["s" .. t.n], t["c" .. t.n] = hs, hc
		end
	end
	send_generation = send_generation % MAX_GENERATION + 1
	for i, chunk in ipairs(chunks) do chunk.g, chunk.i, chunk.k = send_generation, i, #chunks end
	return chunks
end

local function publish(force)
	if not (coop_util.active() and coop_mode.decides_world()) then return end
	local now = time_global()
	if not outgoing then
		if not (snapshot_requested or dirty or (next(owner) ~= nil and force)
			or (now >= next_publish and (repeat_snapshot or next(owner) ~= nil))) then return end
		outgoing = { chunks = snapshot_chunks(), index = 1 }
		dirty, snapshot_requested = false, false
	elseif force then
		return -- let actor_on_update pace the rest of this generation
	end
	for _ = 1, CHUNKS_PER_UPDATE do
		if not coop_mode.publish(SNAPSHOT, outgoing.chunks[outgoing.index]) then return end
		outgoing.index = outgoing.index + 1
		if outgoing.index > #outgoing.chunks then
			outgoing = nil
			stats.published = stats.published + 1
			next_publish = now + PUBLISH_MS
			return
		end
	end
end

local function uint(value, min, max)
	return type(value) == "number" and value >= min and value <= max and value == math_floor(value)
end

local function decode_chunk(payload)
	local t = coop_main.decode(payload)
	if not (uint(t.g, 1, MAX_GENERATION) and uint(t.k, 1, MAX_CHUNKS) and uint(t.i, 1, t.k)
		and uint(t.n, t.k == 1 and 0 or 1, TARGETS_PER_CHUNK) and count(t) == 4 + 2 * t.n) then return nil end
	local list = {}
	for i = 1, t.n do
		local hs, hc = t["s" .. i], t["c" .. i]
		if not (valid_id(hs) and hs ~= 0 and valid_id(hc)) then return nil end
		local sid, cid = coop_mods_core.lid(hs), coop_mods_core.lid(hc)
		if not (valid_id(sid) and sid ~= 0 and valid_id(cid)) or list[sid] ~= nil then return nil end
		list[sid] = cid
	end
	if coop_main.encode(t) ~= payload then return nil end
	return t, list
end

local function newer_generation(generation, previous)
	if previous == 0 then return true end
	local delta = (generation - previous) % MAX_GENERATION
	return delta > 0 and delta <= MAX_GENERATION / 2
end

local function accept_chunk(payload, from)
	if not event_ok("bounty_targets_sender", from == 0 and coop_mods_core.world_client(),
		"bounty target snapshot from unexpected peer %s", tostring(from)) then return false end
	if needs_remote_targets() and not event_ok("bounty_targets_link", update_target_link(true),
		"bounty target snapshot before the link is live") then return false end
	if not event_ok("bounty_targets_size", type(payload) == "string" and #payload <= MAX_CHUNK_BYTES,
		"invalid bounty target chunk size") then return false end
	local t, list = decode_chunk(payload)
	if not event_ok("bounty_targets", t ~= nil, "invalid bounty target chunk") then return false end
	if not newer_generation(t.g, received_generation) then return true end -- stale or delivered already

	if not incoming or incoming.generation ~= t.g then
		if incoming and not newer_generation(t.g, incoming.generation) then return true end
		incoming = { generation = t.g, total = t.k, parts = {}, bindings = {}, remaining = t.k }
	end
	if not event_ok("bounty_targets_count", incoming.total == t.k, "inconsistent bounty target chunk count") then return false end
	if incoming.parts[t.i] then return true end
	for sid in pairs(list) do
		if incoming.bindings[sid] ~= nil then
			return event_ok("bounty_targets_overlap", false, "squad occurs in multiple bounty target chunks")
		end
	end
	for sid, cid in pairs(list) do incoming.bindings[sid] = cid end
	incoming.parts[t.i] = true
	incoming.remaining = incoming.remaining - 1
	if incoming.remaining == 0 then
		if needs_remote_targets() then
			for sid in pairs(previous_mirror or mirror) do
				if incoming.bindings[sid] == nil then revoke_order(sid) end
			end
		end
		mirror, received_generation = incoming.bindings, incoming.generation
		previous_mirror = nil
		incoming, have_snapshot = nil, true
		stats.received = stats.received + 1
	end
	return true
end

local function on_targets(payload, from)
	if not accept_chunk(payload, from) then stats.dropped = stats.dropped + 1 end
end

-- The character a squad hunts here: the decider's records, another process's copy of them.
local function hunted(sid)
	if coop_mode.decides_world() then return owner[sid] end
	return mirror[sid]
end

function target_of(sid)
	if not valid_id(sid) then return nil end
	local cid = hunted(sid)
	if cid == nil then return nil end
	return cid, coop_mods_core.peer_of(cid)
end

function squads_of(id)
	local out = {}
	local rec = book[id]
	if rec then for sid, section in pairs(rec.squads) do out[sid] = section end end
	return out
end

function records()
	local out = {}
	for id, rec in pairs(book) do
		local squads = {}
		for sid, section in pairs(rec.squads) do squads[sid] = section end
		out[id] = { last = rec.last, squads = squads }
	end
	return out
end

-------------------------------------------------------------------------------
-- The spawn pass (the stock's spawn_timer and try_spawn, per character)
-------------------------------------------------------------------------------
-- The stock's test of a smart: no squad of its own is on its way there (sim_squad_bounty.script:47-56).
local function smart_free(smart)
	local smrt = SIMBOARD.smarts[smart.id]
	if not smrt then return false end
	for k in pairs(smrt.squads) do
		local squad = alife_object(k)
		if squad and squad.current_target_id and squad.current_target_id == smart.id and not squad:get_script_target() then
			return false
		end
	end
	return true
end

-- No player's character on the smart's map stands within the stock's spawn distance.
local function far_from_players(smart, bodies)
	local lid = coop_util.level_of_gvid(smart.m_game_vertex_id)
	for _, b in ipairs(bodies) do
		if b.lid == lid and b.pos:distance_to(smart.position) <= cfg.distance then return false end
	end
	return true
end

local function spawn_for(c, rec, bodies)
	local comm = community_of(c)
	local enemies = {}
	for i = 1, #cfg.factions do
		local f = cfg.factions[i]
		if comm and game_relations.is_factions_enemies(f, comm) then enemies[#enemies + 1] = f end
	end
	if #enemies == 0 then
		stats.no_faction = stats.no_faction + 1
		return
	end
	local section = cfg.squads[enemies[math.random(#enemies)]]
	if type(section) ~= "string" then
		stats.no_faction = stats.no_faction + 1
		return
	end
	local at = { m_game_vertex_id = c.gv } -- his map (in the server mode never the ghost's fake_start)
	local names = {}
	for name, smart in pairs(SIMBOARD.smarts_by_names) do
		if simulation_objects.is_on_the_same_level(at, smart) or simulation_objects.is_on_the_linked_level(at, smart) then
			if not far_from_players(smart, bodies) then
				stats.near = stats.near + 1
			elseif smart_free(smart) then
				names[#names + 1] = name
			end
		end
	end
	if #names == 0 then
		stats.no_smart = stats.no_smart + 1
		return
	end
	local name = names[math.random(#names)]
	local sq = sim_board.get_sim_board():create_squad(SIMBOARD.smarts_by_names[name], section)
	if not sq then return end
	sq.scripted_target = "actor"
	sq.rush_to_target = true
	local sec = sq:section_name()
	rec.squads[sq.id] = sec
	rec.last = game.get_game_time()
	owner[sq.id] = c.id
	dirty = true
	stats.spawned = stats.spawned + 1
	local m = coop_util.module("sim_squad_bounty")
	local get = m and coop_mods_core.fn(m, "get_active_squads")
	local t = get and get()
	if type(t) == "table" then t[sq.id] = sec end
	coop_mods_core.log(TAG, "squad %s (%d) at %s hunts character %d (peer %s)", tostring(sec), sq.id, tostring(name), c.id, tostring(c.peer))
end

local function spawn_pass()
	stats.passes = stats.passes + 1
	clean()
	local list = characters()
	local bodies = {}
	for _, c in ipairs(list) do
		local pos, gv, lv = place(c)
		local lid = coop_util.level_of_gvid(gv)
		if pos and lid ~= nil then
			c.pos, c.gv, c.lv, c.lid = pos, gv, lv, lid
			bodies[#bodies + 1] = c
		end
	end
	local now = game.get_game_time()
	for _, c in ipairs(bodies) do
		local ok, num = pcall(danger, c)
		if not ok then
			report("danger of " .. tostring(c.id), num)
			num = 0
		end
		if num > 0 then
			local rec = record(c.id)
			if not rec.last then
				rec.last = now -- the stock starts the cooldown at the first due tick (:145-148)
			elseif now:diffSec(rec.last) >= cfg.delay and count(rec.squads) < num then
				local fine, err = pcall(spawn_for, c, rec, bodies)
				if not fine then report("spawn for " .. tostring(c.id), err) end
			end
		end
	end
	sync_stock()
	publish(true)
end

-------------------------------------------------------------------------------
-- Wrappers
-------------------------------------------------------------------------------
local function make_spawn(orig)
	return function(...)
		-- single player (and a player's process before its session): the stock as it is
		if not coop_util.active() and coop_mode.actor_is_player() then return orig(...) end
		-- the world's decider runs the bounties; elsewhere the event goes, as the router drops a host timer
		if not coop_mode.decides_world() then return true end
		pcall(ResetTimeEvent, TIMER_EV, TIMER_ACT, cfg.delay_spawn)
		local ok, err = pcall(spawn_pass)
		if not ok then report("spawn pass", err) end
		return false
	end
end

local function task_of(self)
	local cid = hunted(self.id)
	if cid == nil then return nil end
	local own = own_character()
	if own and own:id() == cid then return nil end -- "the actor" is he: the stock's
	local _, gv, lv = place({ id = cid, obj = object_of(cid) })
	if type(gv) ~= "number" or type(lv) ~= "number" then return nil end
	return gv, lv
end

local function make_task(orig)
	return function(self, ...)
		if self.assigned_target_id ~= 0 or not coop_util.active() or coop_mode.is_player_mirror() then return orig(self, ...) end
		local ok, gv, lv = pcall(task_of, self)
		if not ok then
			report("task", gv)
			return orig(self, ...)
		end
		if gv == nil then return orig(self, ...) end
		stats.redirected = stats.redirected + 1
		return CALifeSmartTerrainTask(gv, lv)
	end
end

-------------------------------------------------------------------------------
-- Callbacks
-------------------------------------------------------------------------------
local function save_state(m_data)
	if type(m_data) ~= "table" then return end
	local c, any = {}, false
	for id, rec in pairs(book) do
		local row = { s = {} }
		local has = false
		if rec.last then
			local ok, t = pcall(utils_data.CTime_to_table, rec.last)
			if ok and type(t) == "table" then
				row.t = t
				has = true
			end
		end
		for sid, section in pairs(rec.squads) do
			row.s[sid] = section
			has = true
		end
		if has then
			c[id] = row
			any = true
		end
	end
	m_data[SAVE_KEY] = any and { v = 1, c = c } or nil
end

local function load_state(m_data)
	book = {}
	local d = type(m_data) == "table" and m_data[SAVE_KEY] or nil
	if type(d) == "table" and type(d.c) == "table" then
		for id, row in pairs(d.c) do
			if valid_id(id) and type(row) == "table" then
				local rec = { squads = {} }
				if type(row.t) == "table" then
					local ok, t = pcall(utils_data.CTime_from_table, row.t)
					if ok and t then rec.last = t end
				end
				if type(row.s) == "table" then
					for sid, section in pairs(row.s) do
						if valid_id(sid) and type(section) == "string" then rec.squads[sid] = section end
					end
				end
				book[id] = rec
			end
		end
	end
	reindex()
	dirty, outgoing = true, nil
end

-- A local squad can leave the map, but only the world's unregister removes a character from the bounty book.
-- Disconnect and handoff leave the authoritative character registered.
local function server_entity_on_unregister(se_obj)
	local id = se_obj and se_obj.id
	if not valid_id(id) then return end
	mirror[id] = nil
	if previous_mirror then previous_mirror[id] = nil end
	if not coop_mode.decides_world() then return end

	local cid = owner[id] -- a removed squad's id may be reused before the next spawn pass
	if cid ~= nil then
		owner[id] = nil
		if book[cid] then book[cid].squads[id] = nil end
		dirty, outgoing = true, nil
	end
	local rec = book[id]
	if not rec then return end
	book[id] = nil
	for sid, section in pairs(rec.squads) do
		if owner[sid] == id then
			owner[sid] = nil
			dirty, outgoing = true, nil
			revoke_order(sid, section)
		end
	end
end

local function on_game_load()
	sync_stock()
end

local function actor_on_update()
	local live = update_target_link(needs_remote_targets())
	local now = time_global()
	if now < next_look then return end
	next_look = now + LOOK_MS
	if live and not (have_snapshot or request_sent) then
		request_sent = coop_mode.publish(REQUEST, "")
	end
	if not coop_util.active() then
		if outgoing then outgoing, dirty = nil, true end
		snapshot_requested, repeat_snapshot = false, false
		if next(request_after) ~= nil then request_after = {} end
	else
		publish(false)
	end
end

-------------------------------------------------------------------------------
-- Install
-------------------------------------------------------------------------------
-- The stock's file locals (sim_squad_bounty.script:13-26): its tables are filled by its own on_game_start, the references stay.
local function read_cfg(m)
	local L = coop_mods_core.find_local
	local factions, squads = (L(m, "factions")), (L(m, "faction_bounty_squads"))
	local dr, dp = (L(m, "danger_ranks")), (L(m, "danger_reputations"))
	if type(factions) ~= "table" or type(squads) ~= "table" or type(dr) ~= "table" or type(dp) ~= "table" then return nil end
	return {
		factions = factions, squads = squads, ranks = dr, reps = dp,
		delay = tonumber((L(m, "delay"))) or 60 * 60 * 24,
		delay_spawn = tonumber((L(m, "delay_spawn"))) or 300,
		distance = tonumber((L(m, "spawn_distance"))) or 200,
	}
end

local function install()
	local m = coop_util.module("sim_squad_bounty")
	if not m then return end
	cfg = read_cfg(m)
	if not cfg then
		coop_mods_core.log(TAG, "sim_squad_bounty has not the stock's locals: its bounty stays as it is")
		return
	end
	local ok, orig = coop_mods_core.wrap(m, "spawn_timer", "bounty.spawn_timer", make_spawn)
	wrapped.spawn = ok
	-- the router runs the wrapper where it ran the stock's timer ("host": the world's decider), not as a coop_* script
	local route = coop_util.module("coop_route")
	if ok and route and route.inherit_source then route.inherit_source(m.spawn_timer, orig) end
	local squads = coop_util.module("sim_squad_scripted")
	local cls = squads and squads.sim_squad_scripted
	if cls then wrapped.task = coop_mods_core.wrap(cls, "get_current_task", "bounty.get_current_task", make_task) end
end

function status()
	return string_format("%s%s | characters %d, squads %d, copy %d | passes %d, spawned %d, near a player %d, no smart %d, "
		.. "no faction %d | to a character %d | published %d, received %d, dropped %d, errors %d",
		wrapped.spawn and "timer" or "-", wrapped.task and " + task" or "", count(book), count(owner), count(mirror),
		stats.passes, stats.spawned, stats.near, stats.no_smart, stats.no_faction, stats.redirected, stats.published,
		stats.received, stats.dropped, stats.errors)
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop.
function on_game_start()
	local steps = {
		{ "install", install },
		{ "callbacks", function()
			if not cfg then return end
			RegisterScriptCallback("save_state", save_state)
			RegisterScriptCallback("load_state", load_state)
			RegisterScriptCallback("on_game_load", on_game_load)
			RegisterScriptCallback("actor_on_update", actor_on_update)
			RegisterScriptCallback("server_entity_on_unregister", server_entity_on_unregister)
		end },
		{ "events", function()
			if not cfg then return end
			coop_world_events.reserve(SNAPSHOT)
			coop_main.add_event_handler(SNAPSHOT, on_targets)
			coop_main.add_event_handler(REQUEST, on_target_request)
		end },
		{ "status", function() coop_mods_core.status_line(TAG, status) end },
	}
	for _, s in ipairs(steps) do
		local ok, err = pcall(s[2])
		if not ok then printf("! [coop_bounty] start step %s failed: %s", s[1], tostring(err)) end
	end
end

-- tests
function _stats() return stats end
