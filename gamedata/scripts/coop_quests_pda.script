--[[
	Anomaly Coop - PDA of the group (gamedata\scripts\coop_quests_pda.script).
	Ports xrRazom's xrr_patch_pda, xrr_patch_encyclopedia, xrr_patch_encyclopedia_messages_restored
	and xrr_achievement_sync on our events.

	Rankings: a client's ALife copy is frozen (NPC ranks of the join), so its PDA asks the host for the
	ranking list (quests.rank_req, at most every 5 s) and draws the host's list; until the first answer
	the stock local list is shown. On the host the players are in the list already (their characters
	are stalkers there).
	NPC PDAs: a dead stalker's PDA gets random messages (contact, stash, route, RF source) when it is
	registered. Its level authority generates them and sends them to its players (quests.pda); a client
	with no local messages asks that authority (mods.pda_req, answered by mods.pda_info or mods.pda_big).
	Stashes from PDA messages: the client's reveal is also done by the host (the host decides the
	content, quests.act "stash_reveal"; "stash" is a reward's new stash, coop_quests_missions). Opening a stash box on a client asks the host to fill it
	(treasure_manager.try_spawn_treasure, host-domain callback that does not run on a client).
	Encyclopedia: an article or note one player unlocks is unlocked for everybody (articles without the stock news,
	notes with the PDA note signal). Local unlock notifications are muted for replicated unlocks. An article another player
	opened is announced by coop_quests_news.show_article ("New article: ... (opened by <nick>)"), not while this machine
	is still loading the host's world (docs\MESSAGES.md).
	Achievements: an achievement one player earns is earned by everybody, with its rewards on each
	player's own machine (faction unlocks of the local config, rank / reputation); the stashes
	of "Tourist" are created by the host only. Money is the host's (the host ledger): the stock reward
	(iron_curtain: db.actor:give_money(40000)) is dropped on a client, which still gets the earned callback and its
	news, and the host grants it with coop.money_grant to every player who earned the achievement (event achv_got,
	and achv from the earner), once per character. The host pays only if it has the achievement itself and
	answers a claim it paid (achv_ack); a client repeats its claim until the answer, once in 5 s, at most 10 times.
--]]

local qc = coop_quests_core
local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local TAG = "pda"
local RANK_COOLDOWN = 5000
local RANK_CHUNK = 25
local BOX_GAP = 2000

local stats = { rank_req = 0, rank_in = 0, pda_out = 0, pda_in = 0, pda_req = 0, stash = 0, box = 0, ency_out = 0, ency_in = 0, achv_out = 0, achv_in = 0, achv_paid = 0 }

-------------------------------------------------------------------------------
-- Rankings
-------------------------------------------------------------------------------
local rank = { cache = nil, place = 0, last_req = 0, parts = nil, seq = 0, dirty = false }

local function rank_name_of_se(se)
	local ok, n = pcall(ranks.get_se_obj_rank_name, se)
	return ok and n or "novice"
end

local function rep_key(v)
	local ok, n = pcall(utils_obj.get_reputation_name, v)
	return ok and n or "st_reputation_neutral"
end

local function host_on_rank_req(t, from)
	if not qc.active() or not coop_mode.decides_world() or type(from) ~= "number" or from == 0 then return end
	local p = qc.mod("pda")
	if not (p and p.calculate_rankings and p.get_coc_ranking_list) then return end
	p.calculate_rankings()
	local list = p.get_coc_ranking_list()
	local size = p.get_rankings_array_size and p.get_rankings_array_size() or 100
	local sim = alife()
	local mine_id = qc.engine().avatar_of(from) -- on a map server's level he has no object here
	local nobody = not coop_mode.actor_is_player() -- a world server's ghost actor: no line, no place (an ordinary host's actor is its player)
	local entries = {}
	for i = 1, size do
		local id = list[i]
		if id == nil then break end
		local e
		if id == 0 and nobody then
			e = nil
		elseif id == 0 then
			local a = db.actor
			e = { n = a:character_name(), r = a:character_rank(), c = a:character_community(), p = a:character_reputation(),
				i = a:character_icon(), rn = ranks.get_obj_rank_name(a) }
		else
			local se = sim:object(id)
			if se then
				e = { n = se:character_name(), r = se:rank(), c = se:community(), p = se:reputation(),
					i = se:character_icon(), rn = rank_name_of_se(se), me = (id == mine_id) or nil }
			end
		end
		if e then
			e.pn = rep_key(e.p or 0)
			entries[#entries + 1] = e
		end
	end
	-- the requester's place among all ranked stalkers and players
	local my_rank = tonumber(t.r) or 0
	local place = 1
	if not nobody and db.actor:character_rank() > my_rank then place = place + 1 end
	for i = 1, 65534 do
		local se = sim:object(i)
		if se and i ~= mine_id and IsStalker(nil, se:clsid()) and se:alive() and se:community() ~= "zombied"
			and se:community() ~= "trader" and not (story_objects and story_objects.story_id_by_object_id[se.id])
			and se:rank() > my_rank then
			place = place + 1
		end
	end
	local parts = math.max(1, math.ceil(#entries / RANK_CHUNK))
	for part = 1, parts do
		local chunk = {}
		for i = (part - 1) * RANK_CHUNK + 1, math.min(part * RANK_CHUNK, #entries) do chunk[#chunk + 1] = entries[i] end
		qc.send("rank", { q = tonumber(t.q) or 0, k = part, m = parts, w = place, d = qc.ser(chunk) or "" }, from)
	end
end

local function client_on_rank(t, from)
	if from ~= 0 or not qc.is_client() then return end
	local q, part, parts = tonumber(t.q), tonumber(t.k), tonumber(t.m)
	if not (q and part and parts and parts <= 20) then return end
	if not rank.parts or rank.parts.q ~= q then rank.parts = { q = q, got = 0, list = {} } end
	local chunk = qc.des(t.d)
	if type(chunk) ~= "table" then return end
	rank.parts.list[part] = chunk
	rank.parts.got = rank.parts.got + 1
	if rank.parts.got < parts then return end
	local all = {}
	for i = 1, parts do
		for _, e in ipairs(rank.parts.list[i] or {}) do
			if type(e) == "table" then all[#all + 1] = e end
		end
	end
	rank.cache = all
	rank.place = tonumber(t.w) or 0
	rank.parts = nil
	rank.dirty = true
	stats.rank_in = stats.rank_in + 1
end

local function rank_desc(e)
	local mc = db.actor:character_community()
	local comm = tostring(e.c or "stalker")
	local fc = game_relations.is_factions_enemies(mc, comm) and "%c[255,255,1,1]"
		or game_relations.is_factions_friends(mc, comm) and "%c[255,1,255,1]" or "%c[255,255,255,1]"
	local rep = tonumber(e.p) or 0
	local rc = rep <= -500 and "%c[255,255,1,1]" or rep >= 500 and "%c[255,1,255,1]" or "%c[255,255,255,1]"
	return strformat([[ %s \n %s \n %s]],
		game.translate_string("ui_st_community") .. ": " .. fc .. game.translate_string(comm) .. "%c[default]",
		game.translate_string("ui_st_rank") .. ": %c[255,215,215,215]" .. game.translate_string("st_rank_" .. tostring(e.rn or "novice"))
			.. " %c[255,110,110,255]" .. tostring(e.r or 0) .. "%c[default]",
		game.translate_string("ui_st_reputation") .. ": " .. rc .. game.translate_string(tostring(e.pn or "st_reputation_neutral")) .. "%c[default]")
end

local function own_entry()
	local a = db.actor
	return { n = a:character_name(), r = a:character_rank(), c = a:character_community(), p = a:character_reputation(),
		rn = ranks.get_obj_rank_name(a), pn = rep_key(a:character_reputation()), me = true }
end

-- A client of a world server never shows the stock list: its own ALife holds the server's ghost as "the host's avatar" (the role
-- swap of the join), and the stock list would rank it under the server's name until the server's answer comes (the
-- server must exist nowhere). An ordinary host's client shows the stock list meanwhile.
function stock_ranks_allowed()
	local api = qc.engine()
	local ok, link = pcall(function() return api and api.server_link and api.server_link() end)
	return not (ok and type(link) == "table" and link.plays == false)
end

local function patch_rankings()
	local p = qc.mod("pda")
	if not (type(p) == "table" and type(p.calculate_rankings) == "function") then return end
	local size_of = function() return p.get_rankings_array_size and p.get_rankings_array_size() or 100 end
	local function cached() return qc.client_live() and rank.cache ~= nil end
	local stock_list
	local function stock_entry_ok(index)
		if not p.get_coc_ranking_list then return true end
		-- The stock calculator updates this table in place. Its getter logs the top ten.
		stock_list = stock_list or p.get_coc_ranking_list()
		local id = stock_list and stock_list[index]
		local se = id and alife_object(id)
		return se and IsStalker(se)
	end
	local function entry(i)
		if i == size_of() + 1 then return own_entry() end
		return rank.cache[i]
	end

	local calc = p.calculate_rankings
	p.calculate_rankings = function(...)
		if not qc.client_live() then return calc(...) end
		local t = time_global()
		if t - rank.last_req >= RANK_COOLDOWN and db.actor then
			rank.last_req = t
			rank.seq = rank.seq + 1
			if qc.send("rank_req", { r = db.actor:character_rank(), q = rank.seq }, 0) then stats.rank_req = stats.rank_req + 1 end
		end
		if not rank.cache then
			if stock_ranks_allowed() then return calc(...) end -- the stock list until the host answers
			return -- a world server's client: nothing until its answer (stock_ranks_allowed)
		end
	end

	local can_show = p.coc_rankings_can_show
	if type(can_show) == "function" then
		p.coc_rankings_can_show = function(index, ...)
			if not qc.active() then return can_show(index, ...) end -- single player: the stock, untouched
			if not coop_mode.actor_is_player() then return false end
			if not cached() then return stock_entry_ok(index) and can_show(index, ...) or false end
			if has_alife_info("ui_pda_hide") then return false end
			if index == size_of() + 1 then
				-- the own row is drawn once more after a new answer so it shows the new place
				if rank.dirty then
					rank.dirty = false
					return false
				end
				return true
			end
			return index <= #rank.cache
		end
	end
	local set_name = p.coc_rankings_set_name
	if type(set_name) == "function" then
		p.coc_rankings_set_name = function(index, ...)
			if not qc.active() then return set_name(index, ...) end -- single player: the stock, untouched
			if not coop_mode.actor_is_player() then return "" end
			if not cached() then return stock_entry_ok(index) and set_name(index, ...) or "" end
			local e = entry(index)
			if not e then return "" end
			local own = index == size_of() + 1 or e.me
			return strformat("%s. %s", own and rank.place or index, own and db.actor:character_name() or tostring(e.n or ""))
		end
	end
	local set_desc = p.coc_rankings_set_description
	if type(set_desc) == "function" then
		p.coc_rankings_set_description = function(index, ...)
			if not qc.active() then return set_desc(index, ...) end -- single player: the stock, untouched
			if not coop_mode.actor_is_player() then return "" end
			if not cached() then return stock_entry_ok(index) and set_desc(index, ...) or "" end
			local e = entry(index)
			if not e then return "" end
			if e.me then e = own_entry() end
			local ok, s = pcall(rank_desc, e)
			return ok and s or ""
		end
	end
	local set_hint = p.coc_rankings_set_hint
	if type(set_hint) == "function" then
		p.coc_rankings_set_hint = function(index, ...)
			if not qc.active() then return set_hint(index, ...) end -- single player: the stock, untouched
			if not coop_mode.actor_is_player() then return "" end
			if not cached() then return stock_entry_ok(index) and set_hint(index, ...) or "" end
			return ""
		end
	end
	local set_icon = p.coc_rankings_set_icon
	if type(set_icon) == "function" then
		p.coc_rankings_set_icon = function(index, ...)
			if not qc.active() then return set_icon(index, ...) end -- single player: the stock, untouched
			if not coop_mode.actor_is_player() then return "" end
			if not cached() then return stock_entry_ok(index) and set_icon(index, ...) or "" end
			local e = entry(index)
			if not e then return "" end
			if index == size_of() + 1 or e.me then return db.actor:character_icon() or "ui\\ui_noise" end
			return type(e.i) == "string" and e.i ~= "" and e.i or "ui\\ui_noise"
		end
	end
	local border = p.coc_rankings_show_border
	if type(border) == "function" then
		p.coc_rankings_show_border = function(index, ...)
			if not qc.active() then return border(index, ...) end -- single player: the stock, untouched
			if not coop_mode.actor_is_player() then return false end
			if not cached() then return stock_entry_ok(index) and border(index, ...) or false end
			if index == size_of() + 1 then return true end
			local e = rank.cache[index]
			return e and e.me == true or false
		end
	end
end

-------------------------------------------------------------------------------
-- NPC PDA messages
-------------------------------------------------------------------------------
local pda_cache = {} -- local item id -> received info or pending placeholder
local pda_view = {} -- the local item and window last rendered by get_ui
local PDA_REQ_GAP = 2000
local PDA_MAX_TRANSFER = 256 * 1024 -- coop_mods_core.send_big limit

local function valid_pda_id(id)
	return type(id) == "number" and id > 0 and id < 65535 and id % 1 == 0
end

local function displayed_pda_id()
	local actor = db.actor
	local obj = actor and (actor:active_item() or actor:item_in_slot(14))
	local dev = coop_mods_core.mod("item_device")
	local sections = dev and dev.device_npc_pda
	return obj and type(sections) == "table" and sections[obj:section()] and obj:id()
end

local function refresh_pda(id, info)
	local tab = pda_view.tab
	if pda_view.id ~= id or not tab then return end
	local menu = ActorMenu.get_pda_menu()
	if not (menu and menu:IsShown() and menu:GetActiveSection() == "eptNPC" and displayed_pda_id() == id) then return end
	local item = tab.message_list:GetSelectedItem()
	local index = item and item.indx
	local previous = index and tab.msg and tab.msg[index]
	tab:Reset(info)
	if info.state == "default" and index and info.msg[index] then
		local msg = info.msg[index]
		if previous and previous.stash == msg.stash and previous.stash_read then msg.stash_read = true end
		tab.message_list:SetSelectedIndex(index - 1) -- the list uses zero-based indexes
		tab:OnSelectMessage()
	end
end

local function apply_cached_pda(id, entry)
	if not alife_object(id) or not coop_economy_mdata.apply_se(id, "info", entry.info) then return false end
	entry.applied = true
	refresh_pda(id, entry.info)
	return true
end

local function host_send_pda(id, target, legacy)
	local info = se_load_var(id, nil, "info")
	if type(info) ~= "table" then return end
	local blob = qc.ser(info)
	local hid = coop_mods_core.hid(id)
	if not (blob and valid_pda_id(hid)) then return end
	local t = { i = hid, d = blob }
	local payload = qc.encode(t)
	local sent
	if #payload >= 15000 then
		sent = coop_mods_core.send_big("pda_big", payload, target)
	elseif target == -1 or legacy then
		sent = qc.send("pda", t, target)
	else
		sent = coop_mods_core.to_peer(target, "pda_info", t)
	end
	if sent then stats.pda_out = stats.pda_out + 1 end
end

local function client_on_pda(t, from)
	if from ~= 0 or not coop_mode.is_player_mirror() or not valid_pda_id(t.i) then return end
	local id = coop_mods_core.lid(t.i)
	if not valid_pda_id(id) then return end
	local entry = pda_cache[id]
	if entry and entry.blob == t.d and entry.applied then return end
	local info = qc.des(t.d, PDA_MAX_TRANSFER)
	if type(info) ~= "table" then return end
	entry = { info = info, blob = t.d }
	pda_cache[id] = entry
	stats.pda_in = stats.pda_in + 1
	apply_cached_pda(id, entry)
end

local function host_on_pda_req(t, from, legacy)
	local valid = valid_pda_id(t.i)
	if not coop_trust.pass("pda_req_id", valid, "peer %s, PDA id %s", tostring(from), tostring(t.i)) then return end
	if not valid then return end -- impossible to look up an invalid engine id even in log mode
	local id = coop_mods_core.lid(t.i)
	local exists = valid_pda_id(id) and alife_object(id) ~= nil
	if not coop_trust.pass("pda_req_entity", exists, "peer %s, PDA %s is absent", tostring(from), tostring(t.i)) then return end
	if exists then host_send_pda(id, from, legacy) end
end

local function request_pda(id, entry)
	local now = time_global()
	if entry.next_req and now < entry.next_req then return end
	local hid = coop_mods_core.hid(id)
	if valid_pda_id(hid) and coop_mods_core.to_host("pda_req", { i = hid }) then
		entry.next_req = now + PDA_REQ_GAP
		stats.pda_req = stats.pda_req + 1
	end
end

local function ensure_pda_info(id, for_view)
	local entry = pda_cache[id] or {}
	local info = se_load_var(id, nil, "info")
	if type(info) == "table" and info ~= entry.stub then return end
	if entry.info and apply_cached_pda(id, entry) then return end
	pda_cache[id] = entry
	if for_view and type(info) ~= "table" then
		entry.stub = { state = "default", msg = {}, contact = {
			name = game.translate_string("st_dyn_news_unknown_contact"), comm = "stalker",
			icon = "ui\\ui_noise", rank = "novice", repu = 0 } }
		coop_economy_mdata.quietly(se_save_var, id, nil, "info", entry.stub)
	end
	request_pda(id, entry)
end

local function patch_npc_pda()
	local tab = coop_mods_core and coop_mods_core.mod("ui_pda_npc_tab")
	if not tab then return end
	coop_mods_core.wrap(tab, "register_pda", "pda.register", function(reg)
		return function(npc, pda_sec, pda_id, ...)
			if not qc.active() then return reg(npc, pda_sec, pda_id, ...) end
			if coop_mode.is_player_mirror() then return end -- the authority sends the messages
			local r = reg(npc, pda_sec, pda_id, ...)
			-- a dead stalker's PDA is loot now: everybody gets its messages (others are asked for when taken)
			local dead = not npc or not pcall(npc.alive, npc) or not npc:alive()
			if dead and coop_mode.leads_here() and valid_pda_id(pda_id) then
				local ok, err = pcall(host_send_pda, pda_id, -1)
				if not ok then qc.report(TAG, "send pda", err) end
			end
			return r
		end
	end)
	coop_mods_core.wrap(tab, "use_view", "pda.use_view", function(view)
		return function(obj, ...)
			if qc.active() and obj and coop_mode.is_player_mirror() then ensure_pda_info(obj:id(), true) end
			return view(obj, ...)
		end
	end)
	-- get_ui runs when the PDA menu actually shows the tab, including the delayed 2D open.
	coop_mods_core.wrap(tab, "get_ui", "pda.get_ui", function(get_ui)
		return function(...)
			if not (qc.active() and coop_mode.is_player_mirror()) then return get_ui(...) end
			local wnd = get_ui(...)
			pda_view.id, pda_view.tab = displayed_pda_id(), wnd
			return wnd
		end
	end)
	-- a stash revealed by a PDA message: the host decides its content
	local cls = tab.pda_npc_tab
	coop_mods_core.wrap(cls, "OnSelectMessage", "pda.select_message", function(sel)
		return function(self, ...)
			if not qc.client_live() then return sel(self, ...) end
			local msg
			pcall(function()
				local item = self.message_list:GetSelectedItem()
				local m = item and item.indx and self.msg and self.msg[item.indx]
				if m and m.stash and not m.stash_read then msg = m end
			end)
			local r = sel(self, ...)
			if msg and msg.stash_read then
				local spot = level.map_has_object_spot(msg.stash, "treasure_searched") ~= 0 and "treasure_searched" or "treasure"
				local hint = "%c[255,255,160,0]" .. game.translate_string(msg.topic_title or "")
					.. "\\n%c[default]\\n%c[160,100,100,200]" .. game.translate_string("st_stash_of") .. " "
					.. tostring(self.contact and self.contact.name or "")
				qc.request_host_action("stash_reveal", { b = qc.to_host_id(msg.stash), s = spot, h = hint })
				stats.stash = stats.stash + 1
			end
			return r
		end
	end)
end

-- Client took an NPC PDA it has no messages for: ask the host now, before it is read.
local function client_item_take(item)
	if not (qc.active() and item and coop_mode and coop_mode.is_player_mirror()) then return end
	local dev = coop_mods_core.mod("item_device")
	local secs = type(dev) == "table" and dev.device_npc_pda
	if not (type(secs) == "table" and secs[item:section()]) then return end
	ensure_pda_info(item:id(), false)
end

local function install_pda_events()
	qc.on("pda", client_on_pda, TAG)
	if not coop_mods_core then return end
	coop_mods_core.set_limit("pda_req", 6, 2)
	coop_mods_core.on("pda_req", host_on_pda_req, "host")
	coop_mods_core.on("pda_info", client_on_pda, "player")
	coop_mods_core.on_big("pda_big", function(payload, from) client_on_pda(qc.decode(payload), from) end, "player")
	-- Keep the original request name routable for callers of the existing quests channel.
	coop_mode.on_level_request("quests.pda_req", function(payload, from)
		host_on_pda_req(qc.decode(payload), from, true)
	end, function(_, from) return type(from) == "number" and from ~= 0 end)
	RegisterScriptCallback("server_entity_on_unregister", function(se)
		local id = se and se.id
		if id then pda_cache[id] = nil end
		if id and pda_view.id == id then pda_view = {} end
	end)
	RegisterScriptCallback("coop_on_world_leaving", function()
		pda_cache, pda_view = {}, {}
	end)
end

local function host_stash(from, t)
	local tm = qc.mod("treasure_manager")
	local b = tonumber(t.b)
	if not (tm and tm.set_random_stash and b and alife_object(b)) then return end
	local state = tm.caches and tm.caches[b]
	if type(state) == "string" or state == true then return end -- filled or looted already
	local spot = (t.s == "treasure_searched") and "treasure_searched" or "treasure"
	-- the stock "treasure coordinates received" line (news_manager.send_treasure(0), called when the spot is added) is the
	-- reader's, not the host's: sent to the client who read the message (docs\MESSAGES.md)
	local nm = qc.mod("news_manager")
	local stock = nm and nm.send_treasure
	local swapped = type(stock) == "function" and type(from) == "number" and from ~= 0
	if swapped then
		nm.send_treasure = function(param)
			if param == 0 or param == nil then qc.send("treasure", { p = 0, b = b }, from) else return stock(param) end
		end
	end
	local ok, err = pcall(tm.set_random_stash, spot, type(t.h) == "string" and t.h or nil, nil, b)
	if swapped then nm.send_treasure = stock end
	if not ok then qc.report(TAG, "reveal stash", err) end
end

-- Client: the host revealed the stash this player's PDA message points to, or a task's reward did (coop_tasks). b: the stash
-- in host numbering. A notification override can describe the stash using stock point names in this machine's language.
local function client_on_treasure(t, from)
	if from ~= 0 or not qc.is_client() then return end
	local nm = qc.mod("news_manager")
	local helper = qc.mod("dynamic_news_helper")
	local b = tonumber(t.b)
	local text
	if b and helper and helper.GetPointDescription then
		local ok, s = pcall(helper.GetPointDescription, alife_object(qc.to_local_id(b)))
		if ok and type(s) == "string" then text = s end
	end
	if nm and nm.send_treasure then pcall(nm.send_treasure, 0, text) end
end

-- Client opened an inventory box: the host fills a revealed stash (its callback does not run here).
local box_last = {}
local function client_box_use(box, who)
	if not (qc.client_live() and box and IsInvbox and IsInvbox(box)) then return end
	if who and db.actor and who:id() ~= db.actor:id() then return end
	local id = box:id()
	local t = time_global()
	if box_last[id] and t - box_last[id] < BOX_GAP then return end
	box_last[id] = t
	qc.request_host_action("box", { b = qc.to_host_id(id) })
	stats.box = stats.box + 1
end

local function host_box(from, t)
	local tm = qc.mod("treasure_manager")
	local box = level.object_by_id(t.b) -- the quest action dispatcher already checked the object ID
	if not (tm and tm.try_spawn_treasure and box and IsInvbox(box)) then return end
	local who = qc.avatar_obj(from)
	if who and box:position():distance_to_sqr(who:position()) > 100 then return end
	tm.try_spawn_treasure(box)
	local caches_now = coop_mode.hook("brain.caches_now")
	if caches_now then caches_now() end -- the world server hears before the player takes anything
end

-------------------------------------------------------------------------------
-- Encyclopedia
-------------------------------------------------------------------------------
local ency = { orig_note = nil, orig_article = nil, applying = false, mutes = {} }

-- The article voice decorator needs the local interaction's temporary key and section. Replicated unlocks skip only the
-- speech, keeping the saved unlock and other decorators. This function returns the decorator's wrapped function or nil.
local function var_wrapped(fn)
	local info = debug.getinfo(fn, "S")
	if not (info and type(info.source) == "string" and info.source:match("ui_pda_encyclopedia_tab_varefined%.script$")) then
		return nil
	end
	for i = 1, 255 do
		local name, original = debug.getupvalue(fn, i)
		if name == nil then break end
		if name == "ui_pda_encyclopedia_tab_unlock_article" and type(original) == "function" then return original end
	end
	return nil
end

local function adapt_article_voice(fn, seen)
	if type(fn) ~= "function" then return fn end
	if seen[fn] then return seen[fn] end
	seen[fn] = fn
	local original = var_wrapped(fn)
	if original then
		local adapted = function(...)
			if ency.applying then return original(...) end
			return fn(...)
		end
		seen[fn] = adapted
		return adapted
	end
	-- An outer wrapper can capture the voice decorator. Adapt the captured function in place
	-- so its outer wrapper still runs for local and replicated unlocks alike.
	for i = 1, 255 do
		local name, value = debug.getupvalue(fn, i)
		if name == nil then break end
		if type(value) == "function" then
			local adapted = adapt_article_voice(value, seen)
			if adapted ~= value then debug.setupvalue(fn, i, adapted) end
		end
	end
	-- A notification wrapper can store the voice decorator in its module table instead of capturing it as an upvalue.
	-- Replace that field too so the notification wrapper keeps using the adapted unlock.
	local ok, env = pcall(getfenv, fn)
	if ok and type(env) == "table" and env ~= _G then
		for key, value in pairs(env) do
			if type(value) == "function" and value ~= fn and var_wrapped(value) then
				local adapted = adapt_article_voice(value, seen)
				if adapted ~= value then rawset(env, key, adapted) end
			end
		end
	end
	return fn
end

local function is_note(s) return s:find("encyclopedia__notes", 1, true) ~= nil end

local function unlocked(s, kind)
	local enc = ui_pda_encyclopedia_tab
	if kind == "note" or (not kind and is_note(s)) then return enc.is_unlocked_note(s) == true end
	return enc.is_unlocked_article(s) == true
end

-- Another mod that announces unlocks its own way registers that function here (muted while applying).
function mute_during_apply(tbl, key)
	if type(tbl) == "table" and type(key) == "string" then ency.mutes[#ency.mutes + 1] = { tbl = tbl, key = key } end
end

local function silently(fn, ...)
	for _, m in ipairs(ency.mutes) do
		m.saved = m.tbl[m.key]
		m.tbl[m.key] = function() end
	end
	local res = { pcall(fn, ...) }
	for i = #ency.mutes, 1, -1 do
		local m = ency.mutes[i]
		m.tbl[m.key], m.saved = m.saved, nil
	end
	return unpack(res)
end

local function apply_ency(s, kind)
	if type(s) ~= "string" or s == "" or unlocked(s, kind) then return false end
	ency.applying = true
	local ok, err
	if kind then
		-- The mass command has no per-entry UI, sound or news, on either side.
		ok, err = silently(kind == "note" and ency.orig_note or ency.orig_article, s)
	elseif is_note(s) then
		ok, err = pcall(ency.orig_note, s) -- notes keep the PDA note signal
	else
		ok, err = silently(ency.orig_article, s)
	end
	ency.applying = false
	if not ok then qc.report(TAG, "unlock " .. s, err) end
	stats.ency_in = stats.ency_in + 1
	return ok and unlocked(s, kind)
end

local ENCY_BATCH = 20 -- even escaped 200-byte sections fit in one 15 KB event
local function valid_ency_section(s)
	return type(s) == "string" and #s > 0 and #s <= 200
end

local function apply_ency_batch(t)
	if not (ency.orig_article and (t.k == "article" or t.k == "note")) then return end
	local sections = qc.des(t.d, 4300)
	if type(sections) ~= "table" then return end
	for i = 1, ENCY_BATCH do
		local s = sections[i]
		if valid_ency_section(s) then apply_ency(s, t.k) end
	end
end

local function publish_ency_batch(kind, batch)
	if #batch == 0 then return end
	if coop_mode.publish("quests.ency", { k = kind, d = qc.ser(batch) }) then
		stats.ency_out = stats.ency_out + #batch
	else
		qc.log(TAG, "! encyclopedia: could not send %d %s unlocks", #batch, kind)
	end
end

local function wrap_ency_mass(enc, method, kind, counter, upvalue)
	coop_mods_core.wrap(enc, method, "pda." .. method, function(orig)
		return function(...)
			if not (qc.active() and coop_mode.decides_world()) then return orig(...) end
			-- The stock count getter and mass unlock share the locked table. The original empties it.
			local locked = coop_mods_core.upvalue(enc[counter], upvalue)
			if type(locked) ~= "table" then return orig(...) end
			local before = {}
			for s in pairs(locked) do
				if valid_ency_section(s) then before[#before + 1] = s end
			end
			local n = orig(...)
			local batch = {}
			for _, s in ipairs(before) do
				if unlocked(s, kind) then
					batch[#batch + 1] = s
					if #batch == ENCY_BATCH then
						publish_ency_batch(kind, batch)
						batch = {}
					end
				end
			end
			publish_ency_batch(kind, batch)
			return n
		end
	end)
end

-- The article's name in this machine's language (the stock news words: UpdateName for artefacts and recipes, then the table).
local function article_title(s)
	local enc = qc.mod("ui_pda_encyclopedia_tab")
	local name = s
	if enc and type(enc.UpdateName) == "function" then
		local ok, n = pcall(enc.UpdateName, s)
		if ok and type(n) == "string" and n ~= "" then name = n end
	end
	local ok, text = pcall(game.translate_string, name)
	return ok and type(text) == "string" and text or name
end

-- An article another player opened (not a note: those keep the stock note line), shown here as news.
local function announce_other(s, nick)
	if is_note(s) or not qc.active() then return end
	local news = qc.mod("coop_quests_news")
	if not (news and news.show_article) then return end
	local ok, err = pcall(news.show_article, article_title(s), nick)
	if not ok then qc.report(TAG, "article news " .. s, err) end
end

-- A map server's logic has no player of its own: the name is of one who stands on its level, the news is the world's to tell.
local function level_nick()
	for _, p in ipairs(qc.players()) do
		if not p.is_self then return qc.nick_of(p.id) end
	end
	return nil
end

-- The name of what the host's own logic earned: the host player's nick (peer 0); a world server's seat plays no character and is
-- in no row: "World"
local function host_nick()
	if coop_mode.decides_world() and not coop_mode.seat_plays(0) then
		local okt, s = pcall(function() return game.translate_string("st_coop_core_chat_world") end)
		return okt and type(s) == "string" and s ~= "st_coop_core_chat_world" and s or "World"
	end
	return qc.nick_of(0)
end

local function announcement_check(name, valid, from)
	if coop_trust then coop_trust.pass(name, valid, "peer %s sent an invalid PDA announcement", tostring(from)) end
	return valid
end

-- Player names come from the transport's player row. Only the world or a registered map may supply a name.
local function announcement_nick(from, nick, decides)
	if decides and qc.remote_player_slot(from) then return true, qc.nick_of(from) end
	local sender_ok = (not decides and from == 0) or (decides and coop_mode.from_level(from))
	if not announcement_check("pda_announce_sender", sender_ok, from) then return false end
	-- coop_session.cpp caps a transport nickname at 48 bytes. A map may have no player's name yet.
	local nick_ok = nick == nil or (type(nick) == "string" and #nick > 0 and #nick <= 48)
	if not announcement_check("pda_announce_nick", nick_ok, from) then return false end
	return true, nick
end

-- Who tells what this machine opened (A-S5S: asked of coop_mode, test_srv_quests_pda): a player's machine its own word, a map
-- server (it leads its map, the world is decided elsewhere) its map's word with the name of a player there, the decider everybody.
local function announce_ency(s)
	if ency.applying or not qc.active() then return end
	if coop_mode.is_player_mirror() then
		if qc.client_live() then qc.send("ency", { s = s }, 0) end
	elseif coop_mode.leads_for_world_elsewhere() then
		qc.send("ency", { s = s, n = level_nick() }, 0)
	elseif qc.host_party() then
		qc.send("ency", { s = s, n = host_nick() }, -1)
	end
	stats.ency_out = stats.ency_out + 1
end

local function on_ency(t, from)
	-- Bulk packets are world publications. Player requests still carry one section.
	if from == 0 and t.d ~= nil then
		if qc.active() and not coop_mode.decides_world() then apply_ency_batch(t) end
		return
	end
	if not announcement_check("pda_ency_section", valid_ency_section(t.s), from) then return end
	local decides = qc.active() and coop_mode.decides_world()
	local ok, nick = announcement_nick(from, t.n, decides)
	if not ok then return end
	if decides then
		local fresh = apply_ency(t.s)
		if fresh then announce_other(t.s, nick) end
		for _, p in ipairs(qc.players()) do
			if not p.is_self and p.id ~= from then qc.send("ency", { s = t.s, n = nick }, p.id) end
		end
	else
		local fresh = apply_ency(t.s)
		-- applied while this machine loads the host's world: silent (no spam at join)
		if fresh and qc.client_live() then announce_other(t.s, nick) end
	end
end

local function patch_encyclopedia()
	local enc = qc.mod("ui_pda_encyclopedia_tab")
	if not (type(enc) == "table" and type(enc.unlock_note) == "function" and type(enc.unlock_article) == "function"
		and type(enc.is_unlocked_note) == "function" and type(enc.is_unlocked_article) == "function") then
		qc.log(TAG, "! encyclopedia functions not found: unlocks are not shared")
		return
	end
	mute_during_apply(qc.mod("actor_menu"), "set_notification")
	mute_during_apply(enc, "set_article")
	for _, name in ipairs({ "zz_encyclopedia_messages_restored", "zz_Encyclopedia_messages_restored" }) do
		local m = rawget(_G, name)
		if type(m) == "table" and type(m.set_article) == "function" then mute_during_apply(m, "set_article") end
	end
	ency.orig_note, ency.orig_article = enc.unlock_note, enc.unlock_article
	ency.orig_article = adapt_article_voice(ency.orig_article, {})
	-- the tab's own calls resolve through its module table, so they hit these too
	enc.unlock_note = function(s, ...)
		local before = type(s) == "string" and unlocked(s)
		local r = ency.orig_note(s, ...)
		if type(s) == "string" and not before and unlocked(s) then announce_ency(s) end
		return r
	end
	enc.unlock_article = function(s, ...)
		local before = type(s) == "string" and unlocked(s)
		local r = ency.orig_article(s, ...)
		if type(s) == "string" and not before and unlocked(s) then announce_ency(s) end
		return r
	end
	if coop_mods_core then
		wrap_ency_mass(enc, "unlock_all_articles", "article", "get_articles_locked_count", "locked_articles")
		wrap_ency_mass(enc, "unlock_all_notes", "note", "get_notes_locked_count", "locked_notes")
	end
end

-------------------------------------------------------------------------------
-- Achievements
-------------------------------------------------------------------------------
local achv_applying = false

-- Achievements of the stock game_achievements.script (Anomaly 1.5.3) that pay money with db.actor:give_money; no other
-- *_rewards function pays money. amount: what the stock function gives, news: its string for the earned callback.
local ACHV_MONEY = {
	iron_curtain = { amount = 40000, news = "st_achievement_22_unlock" },
}
local achv_paid = {} -- host: "<avatar id>:<achievement>" -> true; one money reward per character (a client can repeat a claim)

-- Client in the host's world: the stock <name>_rewards without its money (the rest of the function is the callback
-- that carries the news and sets the achievement); the host pays. Host and single player: the stock function.
local function patch_achv_money()
	local ga = qc.mod("game_achievements")
	if type(ga) ~= "table" then return end
	for name, money in pairs(ACHV_MONEY) do
		local key = name .. "_rewards"
		local orig = ga[key]
		if type(orig) == "function" then
			ga[key] = function(...)
				if not qc.client_live() then return orig(...) end
				SendScriptCallback("actor_on_achievement_earned", name, money.news)
			end
		end
	end
end

local function has_achv(name)
	local gs = qc.mod("game_statistics")
	if not (gs and type(gs.has_actor_achievement) == "function") then return false end
	local ok, v = pcall(gs.has_actor_achievement, name)
	return ok and v == true
end

-- Host: the money of an achievement for a client who earned it. The ledger (coop.money_grant) does the rest. Only if the
-- host has the achievement itself (a claim is not proof). True when the character has been paid for it, now or
-- before: that is what the host answers (achv_ack); false (no answer) leaves the claim to be repeated.
local function grant_achv_money(peer, name)
	local money = ACHV_MONEY[name]
	if not (money and qc.active() and coop_mode.decides_world() and type(peer) == "number" and peer ~= 0) then return false end
	local avatar = nil
	for _, p in ipairs(qc.players()) do
		if p.id == peer and not p.is_self then avatar = p.avatar_id end
	end
	if not avatar then return false end
	local key = tostring(avatar) .. ":" .. name
	if achv_paid[key] then return true end
	if not has_achv(name) then
		qc.log(TAG, "%s money for #%d not paid: the host does not have the achievement", name, peer)
		return false
	end
	local api = qc.engine()
	local grant = api and api.money_grant
	if type(grant) ~= "function" then
		qc.report(TAG, "achievement money", "coop.money_grant is missing")
		return false
	end
	local called, ok, why = pcall(grant, peer, money.amount)
	if called and ok then
		achv_paid[key] = true
		stats.achv_paid = stats.achv_paid + 1
		-- the "money received" line on his machine (the ledger sends only the balance)
		local rewards = qc.mod("coop_tasks_rewards")
		if rewards and rewards.money_line then pcall(rewards.money_line, peer, money.amount) end
		return true
	end
	qc.log(TAG, "! %s money for #%d refused: %s", name, peer, tostring(called and why or ok))
	return false
end

-- Client: claims the host has not answered yet, name -> { tries, at }. A claim is sent at once and repeated until the
-- host answers it (achv_ack): at most once in CLAIM_GAP_MS and CLAIM_TRIES times in all, only while this machine is in
-- the host's world. The host may be late (its character for us, its own achievement), and a lost claim is lost money.
local CLAIM_GAP_MS, CLAIM_TRIES = 5000, 10
local claims = {}

local function send_claim(name, c)
	c.tries = c.tries + 1
	c.at = time_global()
	qc.send("achv_got", { a = name }, 0)
end

-- Who the claims are for: the host (its nick) and our own peer id. A claim made in one session is not sent to
-- the host of another one, which would pay it for an achievement this client never earned in its world.
-- The host is the client's link (coop.server_link: a world server's seat is in no row); its nick is the nick of row 0
-- of an ordinary session, so the key is the same there. An older engine: row 0.
local function session_key()
	local api = qc.engine()
	local ok, link = pcall(function() return api and api.server_link and api.server_link() end)
	if ok and type(link) == "table" then return tostring(link.nick) .. "|" .. tostring(qc.self_peer()) end
	for _, p in ipairs(qc.players()) do
		if p.id == 0 then return tostring(p.nick) .. "|" .. tostring(qc.self_peer()) end
	end
	return nil
end

local function claim_achv(name)
	if claims[name] then return end
	local c = { tries = 0, at = 0, key = session_key() }
	claims[name] = c
	send_claim(name, c)
end

local function retry_claims()
	if next(claims) == nil or not qc.client_live() then return end
	local t = time_global()
	local key = session_key()
	for name, c in pairs(claims) do
		if key ~= c.key then
			claims[name] = nil
			qc.log(TAG, "! %s: the claim was made in another session, dropped", name)
		elseif t - c.at >= CLAIM_GAP_MS or t < c.at then
			if c.tries >= CLAIM_TRIES then
				claims[name] = nil
				qc.log(TAG, "! %s: the host did not answer the claim in %d attempts, gave up", name, c.tries)
			else
				send_claim(name, c)
			end
		end
	end
end

-- Runs fn with the achievement toast of the stock game_statistics.actor_on_achievement_earned (news_manager.send_tip)
-- naming the player who earned it: "<nick>: <text>". The earner's own machine does not come here.
local function with_earner(nick, fn, ...)
	local nm = qc.mod("news_manager")
	local news = qc.mod("coop_quests_news")
	local orig = nm and nm.send_tip
	nick = news and news.clean_nick and news.clean_nick(nick)
	if not (nick and type(orig) == "function") then return pcall(fn, ...) end
	nm.send_tip = function(actor, news_id, ...)
		local text = news_id
		if type(news_id) == "string" then
			local ok, tt = pcall(game.translate_string, news_id)
			text = ok and type(tt) == "string" and tt or news_id
		end
		return orig(actor, nick .. ": " .. tostring(text), ...)
	end
	local res = { pcall(fn, ...) }
	nm.send_tip = orig
	return unpack(res)
end

-- The achievement for this machine's actor, rewards included (its own *_rewards function). `nick`: who earned it.
local function apply_achv(name, nick)
	if has_achv(name) then return end
	local ga = qc.mod("game_achievements")
	local f = type(ga) == "table" and ga[name .. "_rewards"]
	achv_applying = true
	local ok, err
	if type(f) == "function" then
		if qc.is_client() then
			-- "Tourist" stashes are the host's
			local tm = qc.mod("treasure_manager")
			local crs = tm and tm.create_random_stash
			if crs then tm.create_random_stash = function() end end
			ok, err = with_earner(nick, f)
			if crs then tm.create_random_stash = crs end
		else
			ok, err = with_earner(nick, f)
		end
	else
		ok, err = with_earner(nick, SendScriptCallback, "actor_on_achievement_earned", name, "")
	end
	achv_applying = false
	if not ok then qc.report(TAG, "achievement " .. name, err) end
	stats.achv_in = stats.achv_in + 1
	-- the money of it is the host's: tell it this player has earned the achievement (repeated until it answers)
	if ok and ACHV_MONEY[name] and qc.client_live() then claim_achv(name) end
end

local function on_earned(name)
	if achv_applying or type(name) ~= "string" or not qc.active() then return end
	if coop_mode.is_player_mirror() then -- as announce_ency (A-S5S)
		if qc.client_live() then qc.send("achv", { a = name }, 0) end
	elseif coop_mode.leads_for_world_elsewhere() then
		qc.send("achv", { a = name, n = level_nick() }, 0)
	elseif qc.host_party() then
		qc.send("achv", { a = name, n = host_nick() }, -1)
	end
	stats.achv_out = stats.achv_out + 1
end

local function on_achv(t, from)
	local valid = type(t.a) == "string" and #t.a <= 200 and t.a:match("^[%w_]+$") ~= nil
	if not announcement_check("pda_achv_name", valid, from) then return end
	local decides = qc.active() and coop_mode.decides_world()
	local ok, nick = announcement_nick(from, t.n, decides)
	if not ok then return end
	if decides then
		apply_achv(t.a, nick)
		for _, p in ipairs(qc.players()) do
			if not p.is_self and p.id ~= from then qc.send("achv", { a = t.a, n = nick }, p.id) end
		end
		grant_achv_money(from, t.a) -- the earner's own stock reward lost its money on his machine
	else
		apply_achv(t.a, nick)
	end
end

-- Host: a client says it has earned an achievement that pays money (the receiver of the shared achievement). Paid, or
-- paid before: answered, so that the client stops claiming. Not paid (the host has no such achievement yet, no character
-- for him yet, the ledger refused): no answer, the client claims again.
local function on_achv_got(t, from)
	if type(t.a) ~= "string" or not t.a:match("^[%w_]+$") then return end
	if qc.active() and coop_mode.decides_world() and type(from) == "number" and from ~= 0 and grant_achv_money(from, t.a) then
		qc.send("achv_ack", { a = t.a }, from)
	end
end

-- Client: the host answered our claim.
local function on_achv_ack(t, from)
	if from ~= 0 or type(t.a) ~= "string" then return end
	claims[t.a] = nil
end

-------------------------------------------------------------------------------
-- Status, start
-------------------------------------------------------------------------------
function print_status()
	qc.log(TAG, "rankings: asked %d, answers %d, cached %s | NPC PDAs sent %d received %d asked %d | stash reveals %d, boxes %d | encyclopedia out %d in %d | achievements out %d in %d paid %d",
		stats.rank_req, stats.rank_in, tostring(rank.cache and #rank.cache or "no"), stats.pda_out, stats.pda_in, stats.pda_req,
		stats.stash, stats.box, stats.ency_out, stats.ency_in, stats.achv_out, stats.achv_in, stats.achv_paid)
end

local installed = false
local function install()
	if installed then return end
	installed = true
	for _, s in ipairs({
		{ "rankings", patch_rankings }, { "npc pda", patch_npc_pda }, { "encyclopedia", patch_encyclopedia },
		{ "achievement money", patch_achv_money },
	}) do
		local ok, err = pcall(s[2])
		if not ok then qc.report(TAG, "install " .. s[1], err) end
	end
end

function on_game_start()
	if not qc.engine() then return end
	qc.on("rank_req", host_on_rank_req, TAG)
	qc.on("rank", client_on_rank, TAG)
	local ok, err = pcall(install_pda_events)
	if not ok then qc.report(TAG, "install pda events", err) end
	qc.on("ency", on_ency, TAG)
	qc.on("achv", on_achv, TAG)
	qc.on("achv_got", on_achv_got, TAG)
	qc.on("achv_ack", on_achv_ack, TAG)
	qc.on("treasure", client_on_treasure, TAG)
	qc.register_host_action("stash_reveal", host_stash)
	qc.register_host_action("box", host_box)
	RegisterScriptCallback("actor_on_update", retry_claims)
	RegisterScriptCallback("actor_on_achievement_earned", on_earned)
	RegisterScriptCallback("physic_object_on_use_callback", client_box_use)
	RegisterScriptCallback("actor_on_item_take", client_item_take)
	RegisterScriptCallback("actor_on_first_update", install)
end
