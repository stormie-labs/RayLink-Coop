--[[
	Anomaly Coop - Hideout Furniture family (gamedata\scripts\coop_mods_hf.script).

	Hideout Furniture (Aoldri), Hideout Furniture Expansion (stove), Gadgets for Hideout Furniture (artefact
	harvester, weapon showcase) and the placed radio of Hideout Furniture. Furniture is world state: the host
	creates and removes it, keeps its data and owns the hidden boxes behind workbenches, stoves and harvesters.
	A client runs the player's half (placement preview, dialogs, tool and fuel use from its own inventory) and
	asks the host for the world half:

	  mods.hf_place    client -> host  { i item, s section, x y z, ax ay az, d data }  place an item (the host builds the data
	                                                           itself; d is not read)
	  mods.hf_pickup   client -> host  { o object }            pack furniture up (the mod's own pickup, run with
	                                                           the requester's character as the actor)
	  mods.hf_takeall  client -> host  { o box }               pack an empty, registered HF stash up
	  mods.hf_freeze   client -> host  { o object, f boolean } set furniture physics; hf_data carries is_frozen
	  mods.hf_lamp     client -> host  { o, on }               lamp on/off (tools already used by the client)
	  mods.hf_refuel   client -> host  { o, i fuel }           refill a lamp; hf_data carries the confirmed condition
	  mods.hf_box      client -> host  { k kind, o owner }     the hidden box of a workbench / stove / harvester
	  mods.hf_box_r    host -> client  { k, o, b box | -1 }    answer; the client opens the box when it is online
	  mods.hf_harv_insert  player -> map decider { o device, i item }  insert an artifact
	  mods.hf_harv_demount player -> map decider { o device }          return contents and pack the device up
	  mods.hf_harv_r       map decider -> requesting player { r reason }  a refused harvester action
	  mods.hf_data     host -> all     { o, d data | x, b? }   furniture data and optional harvester stash link
	  mods.hf_show     client -> host  { c case, i item, m 1|0, s section }   mount / unmount a showcase item
	  mods.hf_show_map host -> all     { c, m map }            what a showcase displays now
	  mods.hf_radio    host -> all     { o, on, p, q, k, c, v, n }   what a placed radio plays
	  mods.hf_radio_ctl client -> host { o, a action, p, q }   a client pressed a radio button
	The host checks that the requester's character is near the furniture and, for placing, that the item is in
	the requester's inventory and places exactly the section the item names.
--]]

local api = rawget(_G, "coop")

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next

local core = coop_mods_core
local function log(fmt, ...) core.log("hf", fmt, ...) end

local NEAR = 15 -- metres between the requester's character and the furniture
local installed = {}
local st = { place = 0, pickup = 0, lamp = 0, box = 0, refused = 0, data_out = 0, data_in = 0, radio_out = 0, radio_in = 0 }

local function refuse(what, from, why)
	st.refused = st.refused + 1
	log("%s from #%s refused: %s", what, tostring(from), why)
end

local function wrapper_of(id)
	local b = core.mod("bind_hf_base")
	local f = b and core.fn(b, "get_wrapper")
	if not f then return nil end
	local ok, w = pcall(f, id)
	return ok and w or nil
end

-- the furniture's reach, for the toggles of its devices (coop_mods_hf_toggles)
function near_ok(obj, who) return core.near(obj, who, NEAR) end
wrapper = wrapper_of

local function wrapper_fuel(w, condition)
	if not (w and type(condition) == "number" and condition == condition) then return end
	local fuel = math.max(0, math.min(1, condition))
	if type(w.fuel) == "number" then w.fuel = fuel end
	if type(w.condition) == "number" then w.condition = fuel end
end

-------------------------------------------------------------------------------
-- Lamp tools and fuel: the host checks and spends them
-------------------------------------------------------------------------------
-- A light names the tool (i, host numbering), a refuel the fuel item. The host checks it is this player's and of the kind the
-- lamp needs (coop_trust "hf_lamp_tool", "hf_refuel_item"), spends what the mod spends and answers mods.hf_item_r { i, r }:
--   "took"  the host removed it: a plain item (the mod's discharge removes it), the last use of a multi-use one, a tool at its
--           last step of condition (the mod's degrade removes it);
--   "spent" the host spent a use of a multi-use item or a step of condition itself, through the stock setters (the item's
--           writer, coop_mode.writes(item); its write is the item's new state and reaches the player's machine with the
--           item's field versions, so nothing is left to his machine and nothing of his is checked afterwards);
--   "left"  only a check that failed in "log" (the host could not see the item as his): his machine spends its own copy, an
--           owner's own change;
--   "no"    refused, or over the request rate (an explicit answer: the item never waits for silence): nothing spent.
-- No answer is no answer: the request is held and nothing is spent on a timer; the item is free again when its answer comes
-- or when it leaves the inventory. A request without the id, or with an id that is no number, fails a check of its own:
-- "hf_refuel_item_id", "hf_lamp_tool_id"; in "log" it goes through as before, in "refuse" nothing is lit or refuelled.
-- Facts: Co-op, the host's copy of the player's character and his items; Server, the map server of his level (core.on "host"
-- passes the request there) with the same facts.
-- wait: client, item -> { kind, lamp, revision }; done: client, item -> true (the host took it, its removal is on its way)
local spend = { wait = {}, done = {}, TOOL_STEP = 0.05 }
local fuel_revision = setmetatable({}, { __mode = "k" }) -- wrapper -> most recent authoritative condition message

-- The tools a lamp needs (ui_furniture_light.toggle_light): its require_tool list, and matches for the old require_matches.
local function lamp_tools(sec)
	local tools = sec and parse_list and parse_list(ini_sys, sec, "require_tool") or {}
	if sec and ini_sys:r_bool_ex(sec, "require_matches", false) then
		tools[#tools + 1] = "matches"
		tools[#tools + 1] = "box_matches"
	end
	return tools
end

-- What the mod's spend changes on item `obj` ("tool": degrade or discharge; "fuel": itms_manager.relocate_item_from_actor, one
-- use): "u" and the uses of a multi-use item, "c" and the condition of a degradable tool, nil for a plain item.
local function spend_state(obj, kind)
	local sec = obj:section()
	if IsItem("multiuse", sec) then return "u", obj:get_remaining_uses() end
	if kind == "tool" and utils_item.is_degradable(obj) then return "c", obj:condition() end
	return nil
end

-- Client: spends `obj` here as the mod does.
local function spend_here(obj, kind)
	if not obj then return end
	if kind == "tool" and utils_item.is_degradable(obj) then utils_item.degrade(obj, spend.TOOL_STEP) else utils_item.discharge(obj) end
end

-- Host: is item `iid` (host numbering) carried by `who` and of one of `sections`? -> the item, or nil and why
local function carried(iid, who, sections)
	local id = type(iid) == "number" and iid > 0 and iid < 65535 and iid == math.floor(iid) and core.lid(iid) or nil
	local se = type(id) == "number" and alife_object(id)
	if not se then return nil, "no such item here" end
	local sec = se:section_name()
	local fits = false
	for _, s in ipairs(sections) do
		if s == sec then fits = true end
	end
	if not fits then return nil, string.format("the item is %s, the lamp takes %s", tostring(sec), table.concat(sections, ", ")) end
	local root = core.root_of(id)
	if root ~= who:id() then return nil, string.format("held by %s, his character is %d", tostring(root), who:id()) end
	local obj = level.object_by_id(id)
	if not obj then return nil, "the item is not online here" end
	return obj
end

-- Host, the item's writer: spends what the mod spends, here. -> "took" (removed here) | "spent" (a use or a step
-- spent here through the stock setters: the item's new state, on its way to the player's machine)
local function host_spend(obj, kind)
	local k, v = spend_state(obj, kind)
	if k == nil or v == nil or (k == "u" and v <= 1) or (k == "c" and v <= spend.TOOL_STEP) then
		alife_release_id(obj:id())
		return "took"
	end
	spend_here(obj, kind)
	return "spent"
end

-- Client: asks the host with item `obj` and waits for its answer. False: asked already (no second request), the host took it
-- and its removal is not here yet (one item, one use), or not sent.
local function client_ask(verb, t, obj, kind, lamp_id)
	local id = obj:id()
	if spend.wait[id] or spend.done[id] then return false end
	t.i = core.hid(id)
	local lamp = lamp_id and wrapper_of(lamp_id)
	if not core.to_host(verb, t) then return false end
	spend.wait[id] = { kind = kind, lamp = lamp, revision = lamp and fuel_revision[lamp] }
	return true
end

-- Client: an item of `sec` in this player's inventory that neither waits for the host's answer nor was taken by
-- the host, so that a second honest light or refuel uses another one. Second value: he holds one of `sec`, but it is busy.
function spend.free_item(sec)
	local found, busy = nil, false
	db.actor:iterate_inventory(function(_, it)
		if found or it:section() ~= sec then return end
		local id = it:id()
		if spend.wait[id] or spend.done[id] then busy = true else found = it end
	end, db.actor)
	return found, busy
end

-- Client: what the host did with the item we named.
local function client_item_answer(t)
	local id = core.lid(tonumber(t.i))
	local w = type(id) == "number" and spend.wait[id]
	if not w then return end -- not ours, or answered already
	if t.r == "left" then
		spend.wait[id] = nil
		spend_here(level.object_by_id(id), w.kind)
	elseif t.r == "spent" then
		spend.wait[id] = nil -- the host spent it: its write brings the item's new state here
	elseif t.r == "no" then
		spend.wait[id] = nil
		log("the host refused the %s of item %d: nothing spent", w.kind == "fuel" and "refuel" or "light", id)
		return
	elseif t.r == "took" then
		-- "took": the host's removal (an entity release) and this answer (a Lua event) take separate channels; until the removal
		-- is here the item is still in this inventory and must not be named again (as the mine's spent)
		spend.wait[id] = nil
		spend.done[id] = true
	else
		return -- no answer of this protocol: still waiting
	end
	-- An item reply also confirms a refill. A newer hf_data condition takes precedence if it arrived first.
	if w.lamp and fuel_revision[w.lamp] == w.revision then wrapper_fuel(w.lamp, 1.0) end
end

-- Client: an item that left this inventory (the host's removal arrived, or it went elsewhere) waits for nothing. No timer: a
-- request without its answer stays held.
local function client_spend_tick()
	if next(spend.wait) == nil and next(spend.done) == nil then return end
	for id in pairs(spend.done) do
		if not level.object_by_id(id) then spend.done[id] = nil end
	end
	for id in pairs(spend.wait) do
		if not level.object_by_id(id) then spend.wait[id] = nil end
	end
end

-------------------------------------------------------------------------------
-- Hidden boxes (workbench, stove, harvester): asked from the host, opened when online
-------------------------------------------------------------------------------
local resolvers = {} -- host: kind -> function(owner_obj) -> box id
local link_tables = { workshop = "workshop_stashes", stove = "stove_stashes" } -- client mirrors the link here
local waiting = {} -- client: "kind:id" -> { at, on_ready }
local harv = {}

function harv.is_device(obj)
	if not obj then return false end
	local sec = obj:section()
	return sec == "placeable_artifact_harvester" or ini_sys:r_string_ex(sec, "script_binding") == "bind_artifact_harvester.init"
end

local function request_id(value)
	return core.object_id(core.lid(core.object_id(value, false, true)), false, true)
end

-- Trust records failed checks in log mode too. A checked action still needs real
-- objects, a reachable device and the actual owner's inventory to execute.
local function checked(name, ok, from, id)
	return coop_trust.pass(name, ok and true or false, "player #%s, object %s", tostring(from), tostring(id)) and ok
end

local function known_link(kind, owner_id)
	local key = link_tables[kind]
	local t = key and alife_storage_manager.get_state()[key]
	return type(t) == "table" and t[owner_id] or nil
end

local function open_box(box_id)
	core.when_online(box_id, nil, function(box)
		if hide_hud_inventory then hide_hud_inventory() end
		box:use(db.actor)
	end, 10000)
end

local function ask_box(kind, owner_id, on_ready)
	local key = kind .. ":" .. tostring(owner_id)
	local w = waiting[key]
	if w and time_global() - w.at < 10000 then
		w.on_ready = on_ready or w.on_ready
		return
	end
	waiting[key] = { at = time_global(), on_ready = on_ready }
	core.to_host("hf_box", { k = kind, o = core.hid(owner_id) })
end

local function host_box(t, from)
	local kind, owner = t.k, request_id(t.o)
	local resolve = type(kind) == "string" and resolvers[kind]
	local obj = resolve and type(owner) == "number" and level.object_by_id(owner)
	local who = core.avatar(from)
	local box = -1
	if kind == "harvester" and not checked("hf_harv_box",
		harv.is_device(obj) and who and coop_mode.where(from) == "here" and core.near(obj, who, NEAR), from, owner) then
		return core.to_peer(from, "hf_box_r", { k = kind, o = owner and core.hid(owner), b = box })
	end
	if not (obj and who and core.near(obj, who, NEAR) and coop_mode.writes(owner)) then
		refuse("hf_box " .. tostring(kind), from, "unknown, far, or another writer's furniture")
	else
		local ok, id = pcall(resolve, obj)
		if ok and type(id) == "number" then
			box = id
			st.box = st.box + 1
		elseif not ok then
			core.report("hf", "box " .. kind, id)
		end
	end
	core.to_peer(from, "hf_box_r", { k = kind, o = t.o, b = box })
end

local function client_box_answer(t)
	local kind, owner, box = t.k, core.lid(tonumber(t.o)), tonumber(t.b)
	if type(kind) ~= "string" or not owner then return end
	local key = kind .. ":" .. tostring(owner)
	local w = waiting[key]
	waiting[key] = nil
	if not box or box < 0 or box >= 65535 then
		core.hud("st_coop_mods_hf_box_refused", "The host could not open this storage.")
		return
	end
	box = core.lid(box)
	if kind == "harvester" and harv.set_mapping and box then harv.set_mapping(owner, box) end
	local tname = link_tables[kind]
	if tname then
		local m = alife_storage_manager.get_state()
		if type(m[tname]) ~= "table" then m[tname] = {} end
		m[tname][owner] = box
	end
	if w and w.on_ready then
		local ok, e = pcall(w.on_ready, box)
		if not ok then core.report("hf", "box open", e) end
	end
end

-------------------------------------------------------------------------------
-- Furniture data (hf_obj_manager): the host's copy is mirrored
-------------------------------------------------------------------------------
local data_orig = {} -- update_data / delete_data originals

-- The stock lamp saves its record on every binder update. What went out last, per object: { sig, rest, fuel, at }.
-- The same record is repeated every DATA_REPEAT_MS for players who joined since. A change of the fuel alone goes out
-- once a FUEL_MS or on a step of FUEL_STEP; any other change, and the lamp going out, go at once. A removed record and the
-- end of the session forget what went out: the next session, or a new object with the same id, starts with nothing sent.
local data_sent = {}
local DATA_REPEAT_MS, FUEL_MS, FUEL_STEP = 3000, 1000, 0.001

-- Record `d` without its condition, with the stash link: equal for two records that differ in fuel alone.
local function rest_of(d, link)
	local rest = {}
	for k, v in pairs(d) do
		if k ~= "condition" then rest[k] = v end
	end
	return (core.ser(rest) or "") .. link
end

-- Whether record `d` (serialized `s`, nil for a removed record) with stash link `box` goes out now; remembers it when it does.
local function data_due(id, d, s, box)
	local now, link = time_global(), "|" .. tostring(box)
	local sig, fuel = (s or "x") .. link, d and d.condition
	if type(fuel) ~= "number" then fuel = nil end
	local last, rest = data_sent[id], nil
	if last and now < last.at + DATA_REPEAT_MS then
		if sig == last.sig then return false end
		if fuel and last.fuel and now < last.at + FUEL_MS and math.abs(fuel - last.fuel) < FUEL_STEP
			and (fuel > 0) == (last.fuel > 0) then
			rest = rest_of(d, link)
			if rest == last.rest then return false end
		end
	end
	data_sent[id] = { sig = sig, rest = fuel and (rest or rest_of(d, link)), fuel = fuel, at = now }
	return true
end

local function refresh_frozen_menu(w)
	local pf = core.mod("placeable_furniture")
	local refresh = core.fn(pf, "update_radial_gui")
	local menu = pf and pf.RadialGUI
	local target = core.fn(pf, "get_wrapper_at_crosshair")
	if refresh and menu and menu:IsShown() and target and rawequal(target(), w) then refresh(w) end
end

local function host_publish_data(id)
	if not core.active() then
		if next(data_sent) then data_sent = {} end
		return
	end
	if not coop_mode.writes(id) then return end
	local hm = core.mod("hf_obj_manager")
	local get = hm and core.fn(hm, "get_data")
	if not get then return end
	local ok, d = pcall(get, id)
	local s = ok and type(d) == "table" and core.ser(d) or nil
	local wire_id = core.hid(id)
	if not wire_id then return end
	local box
	if harv.stash_id and harv.is_device(level.object_by_id(id)) then
		box = core.hid(harv.stash_id(id)) or -1
	end
	if s and #s < 4500 then -- encode may triple it
		if not data_due(id, d, s, box) then return end
		core.publish("hf_data", { o = wire_id, d = s, b = box })
	elseif not (ok and d) then
		if not data_due(id, nil, nil, box) then return end
		core.publish("hf_data", { o = wire_id, x = true, b = box })
	end
	st.data_out = st.data_out + 1
end

publish = host_publish_data

local function scalar_table(d, max)
	if type(d) ~= "table" then return nil end
	local out, n = {}, 0
	for k, v in pairs(d) do
		local tv = type(v)
		if type(k) == "string" and (tv == "number" or tv == "string" or tv == "boolean") then
			n = n + 1
			if n > (max or 64) then break end
			out[k] = v
		end
	end
	return out
end

local function client_data(t, from_level)
	local id = core.lid(tonumber(t.o))
	if not (id and data_orig.update and data_orig.delete) then return end
	-- A writer can hear the world's relay of its own update. Keep its current live state.
	if not from_level and not coop_mode.is_player_mirror() and level.object_by_id(id) and coop_mode.writes(id) then return end
	st.data_in = st.data_in + 1
	if t.b ~= nil and harv.set_mapping then harv.set_mapping(id, request_id(t.b)) end
	if t.x == true then
		pcall(data_orig.delete, id)
		return
	end
	local d = core.deser(t.d)
	if type(d) ~= "table" then return end
	pcall(data_orig.delete, id)
	pcall(data_orig.update, id, d)
	if not coop_mode.is_player_mirror() then return end
	local w = wrapper_of(id)
	if not w then return end
	if type(d.condition) == "number" then
		fuel_revision[w] = d
		wrapper_fuel(w, d.condition)
	end
	if type(d.is_frozen) == "boolean" then
		w.is_frozen = d.is_frozen
		refresh_frozen_menu(w)
	end
end

local function install_data_mirror()
	local hm = core.mod("hf_obj_manager")
	if not hm then return end
	core.wrap(hm, "update_data", "hf_obj_manager.update_data", function(orig)
		data_orig.update = orig
		return function(id, ...)
			if core.active() and not coop_mode.writes(id) then return end
			local r = orig(id, ...)
			host_publish_data(id)
			return r
		end
	end)
	core.wrap(hm, "delete_data", "hf_obj_manager.delete_data", function(orig)
		data_orig.delete = orig
		return function(id, ...)
			-- Unregister can remove the ALife record before the stock data cleanup runs.
			if not core.active() or not alife_object(id) then return orig(id, ...) end
			if not coop_mode.writes(id) then return end
			local r = orig(id, ...)
			data_sent[id] = nil
			core.publish("hf_data", { o = core.hid(id), x = true })
			return r
		end
	end)
	core.on("hf_data", function(t, from)
		if not coop_mode.decides_world() then
			if from == 0 then client_data(t) end
		else
			local source = coop_mode.from_level(from)
			if not coop_trust.pass("hf_data_sender", source, "unexpected furniture report from peer %s", tostring(from))
				or not source then return end
			-- A map server changed it: the world's save keeps it, every machine hears it.
			client_data(t, true)
			core.to_all("hf_data", t)
		end
	end)
end

-------------------------------------------------------------------------------
-- Empty HF stashes: one operation on the map that has the box and the requester.
-------------------------------------------------------------------------------
local packing = {}

local function is_hf_stash(obj)
	return obj and ini_sys:r_string_ex(obj:section(), "placeable_type") == "stash"
end

local function run_level_action(verb, action, t)
	if coop_mode.is_player_mirror() then return core.to_host(verb, t) end
	if coop_mode.actor_is_player() and coop_mode.writes(request_id(t.o)) then
		return action(t, core.self_peer())
	end
end

local function pack_stash(box, player, book, section)
	local id = box:id()
	local request = { stash_id = id, cancel = false }
	local ok, err = core.as_player(player, SendScriptCallback, "actor_on_stash_remove", request)
	if not ok then core.report("hf", "stash removal callback", err) end
	if not ok or request.cancel or not box:is_inv_box_empty() then return false end

	-- Reserve the return item before deleting the box. Roll it back if the box is still there.
	local item = alife_create_item(section, player)
	if not item then return false end
	local released, release_error = pcall(alife_release_id, id)
	if not released then core.report("hf", "stash release", release_error) end
	if alife_object(id) then
		alife_release_id(item.id)
		return false
	end

	book[id] = nil
	local items = core.mod("coop_mods_items")
	local note_owner = core.fn(items, "note_stash_owner")
	if note_owner then note_owner(id, nil) end
	level.map_remove_object_spot(id, "treasure")
	if not coop_mode.decides_world() then
		-- The world's stash book is sent to observers by the existing (chunked for large lists) m_data sync.
		core.publish("stash_book", { b = core.hid(id), x = true })
	end
	st.pickup = st.pickup + 1
	return true
end

local function host_takeall(t, from)
	local wire_id = core.object_id(t.o, false, true)
	local id = wire_id and core.object_id(core.lid(wire_id), false, true)
	if not coop_trust.pass("hf_takeall_id", id ~= nil, "player #%s: invalid HF stash id", tostring(from)) or not id then return end
	if packing[id] or not coop_mode.writes(id) then return end
	local box, player = level.object_by_id(id), core.avatar(from)
	local book = alife_storage_manager.get_state().player_created_stashes
	local section = type(book) == "table" and book[id]
	local matches = is_hf_stash(box) and type(section) == "string" and ini_sys:section_exist(section)
		and ini_sys:r_string_ex(box:section(), "item_section") == section and IsInvbox(box) and alife_object(id) ~= nil
	if not coop_trust.pass("hf_takeall_section", matches, "player #%s: box %d is not a registered HF stash", tostring(from), id)
		or not matches then return end
	if not coop_trust.pass("hf_takeall_near", player and core.near(box, player, NEAR), "player #%s: stash %d is out of reach", tostring(from), id)
		or not player then return end
	if not coop_mode.writes(player:id()) then return end
	local empty = box:is_inv_box_empty()
	if not coop_trust.pass("hf_takeall_empty", empty, "player #%s: stash %d still has items", tostring(from), id) or not empty then return end

	packing[id] = true
	local ok, packed = pcall(pack_stash, box, player, book, section)
	packing[id] = nil
	if not ok then core.report("hf", "packing stash", packed) end
	return ok and packed
end

local function install_takeall()
	if not core.mod("hf_monkeypatches") then return end
	local ui = core.mod("ui_inventory")
	if not ui then return end
	core.wrap(ui.UIInventory, "LMode_TakeAll", "hf_monkeypatches.UIInventory.LMode_TakeAll", function(orig)
		return function(self, ...)
			if not core.active() then return orig(self, ...) end
			local box, bag = self:GetPartner(), self.CC["npc_bag"]
			if not (bag and is_hf_stash(box)) or next(bag.indx_id) then return orig(self, ...) end
			if run_level_action("hf_takeall", host_takeall, { o = core.hid(box:id()) }) then hide_hud_inventory() end
		end
	end)
	core.on("hf_takeall", host_takeall, "host")
	core.set_limit("hf_takeall", 5, 1)
end

local function install_frozen()
	local b = core.mod("bind_hf_base")
	local hm = core.mod("hf_obj_manager")
	local cls = b and b.hf_binder_wrapper
	local set_frozen = core.fn(cls, "set_frozen")
	if not (set_frozen and hm and core.fn(hm, "update_data") and core.fn(hm, "get_data")) then return end
	local function host_frozen(t, from)
		local wire_id = core.object_id(t.o, false, true)
		local id = wire_id and core.object_id(core.lid(wire_id), false, true)
		local valid = id ~= nil and type(t.f) == "boolean"
		if not coop_trust.pass("hf_freeze_args", valid, "player #%s: invalid freeze request", tostring(from)) or not valid then return end
		if not coop_mode.writes(id) then return end
		local w, player = wrapper_of(id), core.avatar(from)
		local d = w and hm.get_data(id)
		local movable = type(d) == "table" and not d.is_world_obj and w.object ~= nil
		if not coop_trust.pass("hf_freeze_object", movable, "player #%s: furniture %d cannot be frozen or unfrozen", tostring(from), id)
			or not movable then return end
		if not coop_trust.pass("hf_freeze_near", player and core.near(w.object, player, NEAR), "player #%s: furniture %d is out of reach", tostring(from), id)
			or not player then return end
		set_frozen(w, t.f)
		if w.is_frozen == t.f then
			hm.update_data(id, { is_frozen = t.f })
			if coop_mode.actor_is_player() then refresh_frozen_menu(w) end
		end
	end
	local function request_frozen(orig)
		return function(self, value, ...)
			if not core.active() then return orig(self, value, ...) end
			if self.object then
				return run_level_action("hf_freeze", host_frozen, { o = core.hid(self.object:id()), f = value })
			end
		end
	end
	core.wrap(cls, "set_frozen", "bind_hf_base.hf_binder_wrapper.set_frozen", request_frozen)
	-- LuaBind copies methods at class declaration. Later classes inherit our wrapper already.
	for module, member in pairs({
		bind_alarm_system = "alarm_system_wrapper",
		bind_artifact_harvester = "artifact_harvester_wrapper",
		bind_digital_clock_furniture = "haru_placeable_digital_clock_wrapper",
		bind_hideout_cat = "hideout_cat_wrapper",
		bind_light_furniture = "placeable_light_wrapper",
		bind_table_fan = "haru_placeable_fan_wrapper",
		bind_trading_computer = "trading_computer_wrapper",
		bind_workshop_furniture = "hf_workshop_wrapper",
		placeable_radio = "placeable_radio_wrapper",
	}) do
		local mod = rawget(_G, module) and core.mod(module)
		local subclass = mod and mod[member]
		if core.fn(subclass, "set_frozen") == set_frozen then
			core.wrap(subclass, "set_frozen", module .. "." .. member .. ".set_frozen", request_frozen)
		end
	end
	core.wrap(b, "freeze_obj", "bind_hf_base.freeze_obj", function(orig)
		return function(id, ...)
			if not core.active() then return orig(id, ...) end
			local d, w = hm.get_data(id), wrapper_of(id)
			if not coop_mode.is_player_mirror() and coop_mode.writes(id) and w and d and d.is_frozen == false and not d.is_world_obj then
				if not w.object:get_physics_shell() then return false end
				set_frozen(w, false)
				return true
			end
			local frozen = orig(id, ...)
			if coop_mode.is_player_mirror() and w and d and type(d.is_frozen) == "boolean" then w.is_frozen = d.is_frozen end
			return frozen
		end
	end)
	core.on("hf_freeze", host_frozen, "host")
	core.set_limit("hf_freeze", 5, 2)
end

local function install_lamp_mirror()
	local b = core.mod("bind_light_furniture")
	local cls = b and b.placeable_light_wrapper
	local function runs_stock(self)
		return not core.active() or (not coop_mode.is_player_mirror() and self.object and coop_mode.writes(self.object:id()))
	end
	core.wrap(cls, "save_data", "bind_light_furniture.placeable_light_wrapper.save_data", function(orig)
		return function(self, ...)
			if runs_stock(self) then return orig(self, ...) end
		end
	end)
	core.wrap(cls, "update", "bind_light_furniture.placeable_light_wrapper.update", function(orig)
		return function(self, ...)
			if runs_stock(self) then return orig(self, ...) end
			-- The stock visual update still runs. Its infinite-fuel branch skips the consumption step.
			local previous = self.infinite_fuel
			self.infinite_fuel = true
			local ok, result = pcall(orig, self, ...)
			self.infinite_fuel = previous
			if not ok then error(result, 0) end
			return result
		end
	end)
end

-------------------------------------------------------------------------------
-- Placing and packing up
-------------------------------------------------------------------------------
local orig_create = nil
local place_item = nil -- client: the item being placed (kept away from the mod, the host spends it)

local function euler(rot)
	if type(rot) ~= "table" and type(rot) ~= "userdata" then return nil end
	local ok, w = pcall(function() return rot.w end)
	if ok and w ~= nil then
		local ok2, v = pcall(function() return rot:to_euler_angles() end)
		if ok2 and v then return v end
		return nil
	end
	local ok3, v = pcall(function() return vector():set(rot.x, rot.y, rot.z) end)
	return ok3 and v or nil
end

local function client_place(section, loc, rot, lvid, gvid, item_id)
	local ang = euler(rot)
	if not ang then
		core.report("hf", "place", "unknown rotation")
		return
	end
	local data = {}
	local hm = core.mod("hf_obj_manager")
	local get = hm and core.fn(hm, "get_data")
	if get then
		local ok, d = pcall(get, item_id)
		if ok and type(d) == "table" then data = scalar_table(d) or {} end
	end
	local item = level.object_by_id(item_id)
	if item then data.condition = item:condition() end
	core.to_host("hf_place", {
		i = core.hid(item_id), s = section, x = loc.x, y = loc.y, z = loc.z, ax = ang.x, ay = ang.y, az = ang.z,
		d = core.ser(data) or "",
	})
end

-- Is placed section `sec` furniture that has an owner? A Hideout Furniture stash
-- (placeable_type = stash, as coop_npc_world's mine check reads it) or a workbench (placeable_workshop, bound by
-- bind_workshop_furniture: its box, m_data.workshop_stashes, is judged by the workbench's owner).
local function owned_kind(sec)
	local okt, kind = pcall(function() return ini_sys:r_string_ex(sec, "placeable_type") end)
	if okt and kind == "stash" then return true end
	if sec == "placeable_workshop" then return true end
	local okb, bind = pcall(function() return ini_sys:r_string_ex(sec, "script_binding") end)
	return okb and type(bind) == "string" and bind:find("bind_workshop_furniture", 1, true) ~= nil
end

local function host_place(t, from)
	local item_id = core.lid(tonumber(t.i))
	local se = type(item_id) == "number" and item_id < 65535 and alife_object(item_id)
	local who = core.avatar(from)
	local section = t.s
	if not (se and who and core.root_of(item_id) == who:id()) then return refuse("hf_place", from, "item not in the player's inventory") end
	if not coop_mode.writes(item_id) then return refuse("hf_place", from, "another writer owns the item") end
	local psec = ini_sys:r_string_ex(se:section_name(), "placeable_section")
	if not (type(section) == "string" and psec == section) then return refuse("hf_place", from, "section does not match the item") end
	local x, y, z = tonumber(t.x), tonumber(t.y), tonumber(t.z)
	if not (x and y and z) then return refuse("hf_place", from, "bad position") end
	local pos = vector():set(x, y, z)
	if not (pos:distance_to_sqr(who:position()) <= NEAR * NEAR) then return refuse("hf_place", from, "too far") end -- NaN too
	local function fin(v) v = tonumber(v) or 0 if v ~= v or v == math.huge or v == -math.huge then return 0 end return v end
	local ang = vector():set(fin(t.ax), fin(t.ay), fin(t.az))
	-- Graph vertices of the requester's character (a few metres away): never taken from the network.
	local ok, res = pcall(orig_create, section, pos, ang, who:level_vertex_id(), who:game_vertex_id())
	local obj_id = ok and (type(res) == "number" and res or (res and res.id)) or nil
	if not obj_id then return refuse("hf_place", from, "the mod did not create " .. section .. " (" .. tostring(res) .. ")") end
	-- The furniture's data is built here, as the mod's placeable_furniture.transfer_item_data does: the host's own data of the
	-- item, then the item's condition when it is online. Nothing of the client's text (t.d): bind_light_furniture reads
	-- condition as the fuel, is_world_obj as endless fuel and is_on as lit, so a forged
	-- table made a lit lamp with endless fuel past hf_lamp_tool and hf_refuel_item. is_world_obj is the map's (hf_map_objects sets
	-- it on the host) and a lamp is lit only through hf_lamp: neither ever comes with an item. The condition is the host's copy of
	-- his item, which his machine reports (coop_items).
	local hm = core.mod("hf_obj_manager")
	local get = hm and core.fn(hm, "get_data")
	local okd, own = false, nil
	if get then okd, own = pcall(get, item_id) end
	local data = okd and scalar_table(own) or {}
	data.is_world_obj, data.is_on = nil, nil
	local item = level.object_by_id(item_id)
	local okc, cond = pcall(function() return item and item:condition() end)
	if okc and type(cond) == "number" and cond == cond then data.condition = math.max(0, math.min(1, cond)) end
	if next(data) and hm and hm.update_data then pcall(hm.update_data, obj_id, data) end
	if hm and hm.delete_data then pcall(hm.delete_data, item_id) end
	alife_release_id(item_id)
	-- its owner, his character: a mine from his own stash or his workbench's box (coop_npc_world) is judged by him. Booked
	-- only for a stash or a workbench, what that check reads (a lamp or a chair would grow the save's list for nothing), and
	-- forgotten whenever the object goes
	-- (coop_mods_items: server_entity_on_unregister), not only through hf_pickup.
	local items = core.mod("coop_mods_items")
	if owned_kind(section) and items and type(items.note_stash_owner) == "function" then
		pcall(items.note_stash_owner, obj_id, who:id())
	end
	st.place = st.place + 1
	log("placed %s -> %d for #%s", section, obj_id, tostring(from))
end

-- Packing up: the box behind a workbench must be empty first (only items travel back, not box contents).
local spent_pickups = setmetatable({}, { __mode = "k" }) -- the binder is local to this instance
local guarded_pickups = {}

local function pickup_available(w, id)
	return w and coop_mode.writes(id) and alife_object(id) ~= nil and not spent_pickups[w]
end

local function reserve_pickup(w, id, direct)
	if not pickup_available(w, id) then return false end
	if w.is_pickupable and not w:is_pickupable() then return false end
	for _, kind in ipairs({ "workshop", "stove" }) do
		local box = known_link(kind, id)
		if box and alife_object(box) and not coop_mode.writes(box) then return false end
	end
	if direct or not guarded_pickups[w.pickup] then spent_pickups[w] = true end
	return true
end

local function client_pickup(obj_id)
	local box_id = known_link("workshop", obj_id)
	local box = box_id and level.object_by_id(box_id)
	if box and not box:is_inv_box_empty() then
		core.hud("st_coop_mods_hf_empty_first", "Empty the workbench stash before packing it up.")
		return
	end
	core.to_host("hf_pickup", { o = core.hid(obj_id) })
end

local function host_pickup(t, from)
	local id = request_id(t.o)
	local obj = id and level.object_by_id(id)
	if not (obj and coop_mode.writes(id)) then return refuse("hf_pickup", from, "another writer or no furniture") end
	if harv.ready and harv.is_device(obj) then return harv.demount(t, from) end
	local who = core.avatar(from)
	if not (obj and who and core.near(obj, who, NEAR) and coop_mode.writes(who:id())) then
		return refuse("hf_pickup", from, "unknown or far furniture")
	end
	local hm = core.mod("hf_obj_manager")
	local data = hm and hm.get_data and select(2, pcall(hm.get_data, id))
	if type(data) == "table" and data.is_world_obj then return refuse("hf_pickup", from, "a world object") end
	for _, kind in ipairs({ "workshop", "stove" }) do
		local box_id = known_link(kind, id)
		local box = box_id and level.object_by_id(box_id)
		if box and not box:is_inv_box_empty() then return refuse("hf_pickup", from, "its storage is not empty") end
	end
	-- The mod's own pickup for this kind of furniture, with the requester's character as the actor:
	-- the item (and anything the mod hands back) goes into that player's inventory.
	local w = wrapper_of(id)
	local pick = w and w.pickup
	if type(pick) ~= "function" then return refuse("hf_pickup", from, "no binder for the object") end
	if not reserve_pickup(w, id) then return refuse("hf_pickup", from, "cannot pack this furniture") end
	local ok, e = core.as_player(who, pick, w)
	if not ok then
		core.report("hf", "pickup", e)
		return
	end
	st.pickup = st.pickup + 1
	local items = core.mod("coop_mods_items") -- its owner is forgotten with the furniture
	if items and type(items.note_stash_owner) == "function" then pcall(items.note_stash_owner, id, nil) end
	for _, kind in ipairs({ "workshop", "stove" }) do
		local tname = link_tables[kind]
		local tt = alife_storage_manager.get_state()[tname]
		if type(tt) == "table" and tt[id] and not alife_object(tt[id]) then tt[id] = nil end
	end
end

local function dialog_pickup(field, direct)
	return function(orig)
		return function(self, ...)
			local id = self[field]
			if not core.active() then return orig(self, ...) end
			if coop_mode.writes(id) then
				if reserve_pickup(wrapper_of(id), id, direct) then return orig(self, ...) end
				return
			end
			if not coop_mode.is_player_mirror() then return end
			pcall(function() self:Close() end)
			if type(id) == "number" then client_pickup(id) end
		end
	end
end

local function install_furniture()
	local b = core.mod("bind_hf_base")
	local pf = core.mod("placeable_furniture")
	if not (b or pf) then return end
	installed[#installed + 1] = "hideout_furniture"

	-- placing
	if pf and core.fn(pf, "create_object") then
		core.wrap(pf, "create_object", "placeable_furniture.create_object", function(orig)
			orig_create = orig
			return function(section, loc, rot, lvid, gvid, ...)
				local item = place_item
				place_item = nil
				if not core.active() or (item and coop_mode.writes(item)) then return orig(section, loc, rot, lvid, gvid, ...) end
				-- Map objects use the stock create gate and the host-domain route of hf_map_objects.
				if not item and not coop_mode.is_player_mirror() then return orig(section, loc, rot, lvid, gvid, ...) end
				if item and section and loc and rot and coop_mode.is_player_mirror() then
					local ok, e = pcall(client_place, section, loc, rot, lvid, gvid, item)
					if not ok then core.report("hf", "place request", e) end
				end
				return nil
			end
		end)
		core.wrap(pf, "func_place_item", "placeable_furniture.func_place_item", function(orig)
			return function(obj, ...)
				if not core.active() then return orig(obj, ...) end
				place_item = obj and obj:id() or nil
				if coop_mode.writes(place_item) then return orig(obj, ...) end
				if not coop_mode.is_player_mirror() then return end
				local sec = obj and ini_sys:r_string_ex(obj:section(), "placeable_section")
				local start = core.fn(pf, "start_placing_item")
				if sec and start then
					return start(sec)
				end
				return orig(obj, ...)
			end
		end)
		core.on("hf_place", host_place, "host")
		core.set_limit("hf_place", 5, 1)
	end

	-- packing up: every entry point a client can use
	if b and b.hf_binder_wrapper then
		local function wrap_wrapper_pickup(cls, label, calls_base)
			local ok = core.wrap(cls, "pickup", label, function(orig)
				return function(self, ...)
					if not core.active() then return orig(self, ...) end
					local id = self.object and self.object:id()
					if not id then return end
					if harv.ready and harv.is_device(self.object) then
						return harv.request_demount(self.object)
					end
					if coop_mode.writes(id) then
						if not pickup_available(self, id) then return false end
						-- The workshop does its box cleanup, then calls the base pickup to create the return item.
						if calls_base then
							local box = known_link("workshop", id)
							if box and alife_object(box) and not coop_mode.writes(box) then return false end
						else
							spent_pickups[self] = true
						end
						return orig(self, ...)
					end
					if not coop_mode.is_player_mirror() then return end
					local ok, pickable = pcall(function() return self.is_pickupable == nil or self:is_pickupable() end)
					if ok and not pickable then return end
					client_pickup(id)
					return true
				end
			end)
			if ok then guarded_pickups[cls.pickup] = true end
		end
		wrap_wrapper_pickup(b.hf_binder_wrapper, "bind_hf_base.hf_binder_wrapper.pickup")
		local bw = core.mod("bind_workshop_furniture")
		if bw and bw.hf_workshop_wrapper then
			wrap_wrapper_pickup(bw.hf_workshop_wrapper, "bind_workshop_furniture.hf_workshop_wrapper.pickup", true)
		end
	end
	if pf then
		core.wrap(pf, "pickup_obj", "placeable_furniture.pickup_obj", function(orig)
			return function(obj, ...)
				if core.active() and harv.ready and harv.is_device(obj) then return harv.request_demount(obj) end
				if not (core.active() and obj) then return orig(obj, ...) end
				if coop_mode.writes(obj:id()) then
					if reserve_pickup(wrapper_of(obj:id()), obj:id()) then return orig(obj, ...) end
					return
				end
				if not coop_mode.is_player_mirror() then return end
				local w = wrapper_of(obj:id())
				local ok, pickable = pcall(function() return not w or w.is_pickupable == nil or w:is_pickupable() end)
				if ok and not pickable then return end
				client_pickup(obj:id())
			end
		end)
	end
	local light, piano, radio, ws = core.mod("ui_furniture_light"), core.mod("ui_furniture_piano"),
		core.mod("placeable_radio"), core.mod("ui_furniture_workshop")
	core.wrap(light and light.UIFurnitureLight, "Pickup", "ui_furniture_light.UIFurnitureLight.Pickup", dialog_pickup("light_id"))
	core.wrap(piano and piano.UIFurniturePiano, "Pickup", "ui_furniture_piano.UIFurniturePiano.Pickup", dialog_pickup("obj_id", true))
	core.wrap(radio and radio.UIFurnitureRadio, "Pickup", "placeable_radio.UIFurnitureRadio.Pickup", dialog_pickup("obj_id"))
	core.wrap(ws and ws.UIFurnitureWorkshop, "Pickup", "ui_furniture_workshop.UIFurnitureWorkshop.Pickup", dialog_pickup("obj_id"))
	core.on("hf_pickup", host_pickup, "host")
	core.set_limit("hf_pickup", 5, 1)

	-- lamps
	if light then
		local _, orig_toggle = core.wrap(light, "toggle_light", "ui_furniture_light.toggle_light", function(orig)
			return function(obj_id, ...)
				if not core.active() or coop_mode.writes(obj_id) then return orig(obj_id, ...) end
				if not coop_mode.is_player_mirror() then return end
				local ok, e = pcall(function()
					local hm = core.mod("hf_obj_manager")
					local d = hm and hm.get_data and hm.get_data(obj_id)
					local turning_on = not (type(d) == "table" and d.is_on)
					if turning_on then
						-- Tools and matches the lamp needs come from this player's inventory: the first one he holds, as the mod
						-- picks it. The host checks and spends it: nothing is spent here before its answer.
						local se = alife_object(obj_id)
						local tools = lamp_tools(se and se:section_name())
						if #tools > 0 then
							-- one he holds that waits for no answer and was not taken by the host already
							local busy = false
							for _, tool in ipairs(tools) do
								local it, b = spend.free_item(tool)
								if it then
									client_ask("hf_lamp", { o = core.hid(obj_id), on = true }, it, "tool")
									return
								end
								busy = busy or b
							end
							-- his only tool is on its way to the host's answer or its removal: nothing (as a second click did before)
							if not busy then core.hud("st_ui_campfire_prereq", "You need a tool to light this.") end
							return
						end
					end
					core.to_host("hf_lamp", { o = core.hid(obj_id), on = turning_on })
				end)
				if not ok then core.report("hf", "lamp", e) end
			end
		end)
		core.on("hf_lamp", function(t, from)
			local id = core.lid(tonumber(t.o))
			local obj = type(id) == "number" and level.object_by_id(id)
			local who = core.avatar(from)
			local iid = tonumber(t.i)
			local function answer(r)
				if iid and r then core.to_peer(from, "hf_item_r", { i = iid, r = r }) end
			end
			if not (obj and who and core.near(obj, who, NEAR) and coop_mode.writes(id)) then
				answer("no")
				return refuse("hf_lamp", from, "unknown or far lamp")
			end
			local r = nil
			local tools = t.on == true and lamp_tools(obj:section()) or {}
			if #tools > 0 then
				-- the tool the lamp needs is this player's, named by its id
				local item, why = nil, nil
				local ok = false
				if iid then
					item, why = carried(iid, who, tools)
					if item and not coop_mode.writes(item:id()) then return answer("no") end
					ok = item ~= nil
					if not coop_trust.pass("hf_lamp_tool", ok, "player %s (#%s) lit lamp %s with item %s: %s", tostring(core.nick_of(from)),
						tostring(from), tostring(id), tostring(iid), tostring(why)) then
						return answer("no")
					end
				else
					-- no id, or an id that is no number, is its own check that always fails, as hf_refuel_item_id: "log" lights
					-- it (his machine spends its copy), "refuse" lights nothing. Passing hf_lamp_tool on "he holds one" would
					-- spend nothing anywhere: one box of matches would light the lamp again and again. No honest client sends
					-- one.
					local holds = false
					for _, tool in ipairs(tools) do
						if who:object(tool) then holds = true break end
					end
					if not coop_trust.pass("hf_lamp_tool_id", false,
						"player %s (#%s) lit lamp %s without the tool's id (sent %s; he holds %s)",
						tostring(core.nick_of(from)), tostring(from), tostring(id), tostring(t.i),
						holds and "one" or ("none of " .. table.concat(tools, ", "))) then
						return
					end
				end
				r = (ok and item) and host_spend(item, "tool") or "left" -- a failed check in "log": his own copy
			end
			local hm = core.mod("hf_obj_manager")
			if hm and hm.update_data then
				hm.update_data(id, { is_on = t.on == true })
			elseif orig_toggle then
				core.as_player(who, orig_toggle, id)
			end
			st.lamp = st.lamp + 1
			answer(r)
		end, "host")

		local function host_refuel(t, from)
			local wire_id = core.object_id(t.o, false, true)
			local id = wire_id and core.object_id(core.lid(wire_id), false, true)
			local obj = id and level.object_by_id(id)
			local who = core.avatar(from)
			local iid = core.object_id(t.i, false, true)
			local own = coop_mode.actor_is_player() and from == core.self_peer()
			local function answer(r)
				if not own and iid and r then core.to_peer(from, "hf_item_r", { i = iid, r = r }) end
			end
			local w = obj and wrapper_of(id)
			local is_lamp = obj and (ini_sys:r_string_ex(obj:section(), "placeable_type") == "light"
				or (w and (type(w.fuel) == "number" or type(w.condition) == "number")))
			if not coop_trust.pass("hf_refuel_object", is_lamp, "player #%s: invalid lamp id", tostring(from)) or not is_lamp then
				return answer("no")
			end
			if not coop_mode.writes(id) then return answer("no") end
			if not coop_trust.pass("hf_refuel_near", who and core.near(obj, who, NEAR), "player #%s: lamp %d is out of reach", tostring(from), id)
				or not who then return answer("no") end
			local hm = core.mod("hf_obj_manager")
			local update = core.fn(hm, "update_data")
			if not update then return answer("no") end
			if not iid and t.i ~= nil then
				coop_trust.pass("hf_refuel_item", false, "player #%s: invalid fuel item id", tostring(from))
				return answer("no")
			end
			local r = nil
			if t.i == nil then
				-- a request without the fuel item's id: his machine removed the fuel itself
				if not coop_trust.pass("hf_refuel_item_id", false, "player %s (#%s) refuelled lamp %s without the fuel item's id",
					tostring(core.nick_of(from)), tostring(from), tostring(id)) then
					return
				end
			else
				local fuel = ini_sys:r_string_ex(obj:section(), "fuel_section") or "charcoal"
				local item, why = carried(iid, who, { fuel })
				if item and not coop_mode.writes(item:id()) then return answer("no") end
				local ok = item ~= nil
				if not coop_trust.pass("hf_refuel_item", ok, "player %s (#%s) refuelled lamp %s with item %s: %s", tostring(core.nick_of(from)),
					tostring(from), tostring(id), tostring(iid), tostring(why)) then
					return answer("no")
				end
				r = ok and host_spend(item, "fuel") or "left" -- a failed check in "log": his own copy; own: no answer
			end
			wrapper_fuel(w, 1.0)
			update(id, { condition = 1.0 })
			answer(r)
		end
		core.wrap(light.UIFurnitureLight, "Refuel", "ui_furniture_light.UIFurnitureLight.Refuel", function(orig)
			return function(self, ...)
				if not core.active() then return orig(self, ...) end
				local fuel = ini_sys:r_string_ex(self.section or "", "fuel_section") or "charcoal"
				local item, busy = spend.free_item(fuel)
				if item then
					local t = { o = core.hid(self.light_id) }
					if coop_mode.is_player_mirror() then
						client_ask("hf_refuel", t, item, "fuel", self.light_id)
					elseif coop_mode.actor_is_player() and coop_mode.writes(self.light_id) then
						t.i = core.hid(item:id())
						host_refuel(t, core.self_peer())
					end
				elseif not busy then
					core.hud("st_coop_mods_hf_no_fuel", "I don't have any fuel for this.")
				end
				pcall(function() self:Close() end)
			end
		end)
		core.on("hf_refuel", host_refuel, "host")
		core.on("hf_item_r", client_item_answer, "client")
		RegisterScriptCallback("actor_on_update", client_spend_tick)
		-- over the rate: an explicit "no" for the named item (it would wait for an answer that never comes)
		local function limited(t, from)
			local iid = type(t) == "table" and core.object_id(t.i, false, true)
			if iid then core.to_peer(from, "hf_item_r", { i = iid, r = "no" }) end
		end
		core.set_limit("hf_lamp", 6, 2, limited)
		core.set_limit("hf_refuel", 5, 2, limited)
	end

	-- workbench box
	if ws and core.fn(ws, "GetStash") then
		local _, orig_get = core.wrap(ws, "GetStash", "ui_furniture_workshop.GetStash", function(orig)
			return function(wb, ...)
				if core.active() and not coop_mode.writes(wb) then return known_link("workshop", wb) end
				return orig(wb, ...)
			end
		end)
		resolvers.workshop = function(obj) return orig_get(obj:id()) end
		core.wrap(ws, "UseWorkshop", "ui_furniture_workshop.UseWorkshop", function(orig)
			return function(wb, ...)
				if not core.active() or coop_mode.writes(wb) then return orig(wb, ...) end
				if not coop_mode.is_player_mirror() then return end
				ask_box("workshop", wb, function(box)
					local open = core.fn(ws, "OpenWorkshop")
					core.when_online(box, nil, function()
						if open then open(box) else open_box(box) end
					end, 10000)
				end)
			end
		end)
		core.wrap(ws.UIFurnitureWorkshop, "AccessStash", "ui_furniture_workshop.UIFurnitureWorkshop.AccessStash", function(orig)
			return function(self, ...)
				local wb = self.obj_id
				if not core.active() or coop_mode.writes(wb) then return orig(self, ...) end
				if not coop_mode.is_player_mirror() then return end
				pcall(function() self:Close() end)
				if type(wb) == "number" then ask_box("workshop", wb, open_box) end
			end
		end)
	end
end

-------------------------------------------------------------------------------
-- Hideout Furniture Expansion: the stove's box
-------------------------------------------------------------------------------
local function install_stove()
	local us = core.mod("ui_stove_furniture")
	if not (us and core.fn(us, "access_inventory")) then return end
	installed[#installed + 1] = "hf_expansion"
	core.wrap(us.UICookStove, "Pickup", "ui_stove_furniture.UICookStove.Pickup", dialog_pickup("obj_id", true))
	local _, orig_access = core.wrap(us, "access_inventory", "ui_stove_furniture.access_inventory", function(orig)
		return function(obj, ...)
			if not (core.active() and obj) or coop_mode.writes(obj:id()) then return orig(obj, ...) end
			if coop_mode.is_player_mirror() then ask_box("stove", obj:id(), open_box) end
		end
	end)
	resolvers.stove = function(obj)
		orig_access(obj)
		RemoveTimeEvent(obj:id(), "container") -- the box opens for the requester, not on the host
		local t = alife_storage_manager.get_state().stove_stashes
		return type(t) == "table" and t[obj:id()] or nil
	end
	core.wrap(us, "start_dialog", "ui_stove_furniture.start_dialog", function(orig)
		return function(obj_id, ...)
			if core.is_client() and type(obj_id) == "number" and not known_link("stove", obj_id) then
				ask_box("stove", obj_id, nil) -- the link is known before a button needs it
			end
			return orig(obj_id, ...)
		end
	end)
	local cook_wait = setmetatable({}, { __mode = "k" })
	local function same_stove(self, pending)
		return core.active() and not pending.cancelled and self.obj_id == pending.id and self:IsShown()
			and level.object_by_id(pending.id) and db.actor and db.actor:id() == pending.actor
	end
	core.wrap(us.UICookStove, "Close", "ui_stove_furniture.UICookStove.Close", function(orig)
		return function(self, ...)
			local pending = cook_wait[self]
			if pending and pending.moved then pending.cancelled = true else cook_wait[self] = nil end
			return orig(self, ...)
		end
	end)
	core.wrap(us.UICookStove, "OpenCookUI", "ui_stove_furniture.UICookStove.OpenCookUI", function(orig)
		return function(self, ...)
			local pending = cook_wait[self]
			if not pending or not pending.moved then return orig(self, ...) end
			cook_wait[self] = nil
			if same_stove(self, pending) and level.object_by_id(pending.box) then return orig(self, ...) end
			if db.actor and db.actor:id() == pending.actor then us.GUI_on_hide("UICook") end
			return true
		end
	end)
	core.wrap(us.UICookStove, "UseCook", "ui_stove_furniture.UICookStove.UseCook", function(orig)
		return function(self, ...)
			if not (core.active() and coop_mode.actor_is_player()) then return orig(self, ...) end
			local id = self.obj_id
			local obj = id and level.object_by_id(id)
			if not (obj and db.actor) then return end
			local section = ini_sys:r_string_ex(obj:section(), "integrated_storage")
			local box_id = known_link("stove", id)
			local mirror = coop_mode.is_player_mirror()
			if not section or section == "" then
				if not box_id and mirror then return core.hud("st_coop_mods_hf_syncing", "The stove's storage is still syncing, try again.") end
				return orig(self, ...)
			end
			local pending = cook_wait[self]
			if pending and (pending.moved or (pending.id == id and time_global() < pending.until_ms)) then return end
			pending = { id = id, actor = db.actor:id(), until_ms = time_global() + 20000 }
			cook_wait[self] = pending
			local function wait_for_box(box_id)
				if cook_wait[self] ~= pending or not same_stove(self, pending) then return end
				core.when_online(box_id, section, function()
					if cook_wait[self] ~= pending then return end
					local box = level.object_by_id(box_id)
					if not (same_stove(self, pending) and known_link("stove", id) == box_id and box and box:section() == section) then
						cook_wait[self] = nil
						return
					end
					self:GiveStashToActor(box_id)
					pending.moved, pending.box = true, box_id
				end, 10000)
			end
			if box_id then
				pending.until_ms = time_global() + 10000
				wait_for_box(box_id)
			elseif coop_mode.writes(id) then
				wait_for_box(resolvers.stove(obj))
			elseif mirror then
				core.hud("st_coop_mods_hf_syncing", "The stove's storage is still syncing, try again.")
				ask_box("stove", id, wait_for_box)
			end
		end
	end)
end

-------------------------------------------------------------------------------
-- Gadgets: artefact harvester box, weapon showcase
-------------------------------------------------------------------------------
local show = { orig_spawn = nil, orig_remove = nil }

-- weapon_showcase.script keeps three globals (guns per case, their slots, their sections); made when missing.
local WS_TABLES = { "weapon_displays", "weapon_display_slots", "weapon_display_sections" }
local function ws_tables(ws)
	for _, key in ipairs(WS_TABLES) do
		if not ws[key] then ws[key] = {} end -- a saved false is "none" too, as the mod treats it
	end
	return ws[WS_TABLES[1]], ws[WS_TABLES[2]], ws[WS_TABLES[3]]
end

-- The slot of a case that shows `world_id` ("" when none).
local function slot_of(case_slots, world_id)
	for slot, shown in pairs(case_slots) do
		if shown == world_id then return tostring(slot) end
	end
	return ""
end

-- "item:world:slot:section|..." for one case.
local function encode_case(ws, case_id)
	local guns, slots, secs = ws_tables(ws)
	local case = guns[case_id]
	if type(case) ~= "table" then return "" end
	local case_slots, case_secs = slots[case_id] or {}, secs[case_id] or {}
	local parts = {}
	for item_id, world_id in pairs(case) do
		local fields = { tostring(item_id), tostring(world_id), slot_of(case_slots, world_id), tostring(case_secs[item_id] or "") }
		parts[#parts + 1] = table.concat(fields, ":")
	end
	return table.concat(parts, "|")
end

local function apply_case(ws, case_id, map)
	local guns, slots, secs = ws_tables(ws)
	if map == "" then
		guns[case_id], slots[case_id], secs[case_id] = nil, nil, nil
		return
	end
	local g, sl, sc = {}, {}, {}
	for entry in map:gmatch("[^|]+") do
		local a, b, c, d = entry:match("^(%d+):(%d+):(%d*):(.*)$")
		local item_id, world_id = tonumber(a), tonumber(b)
		if item_id and world_id then
			g[item_id] = world_id
			if tonumber(c) then sl[tonumber(c)] = world_id end
			if d and d ~= "" then sc[item_id] = d end
		end
	end
	guns[case_id], slots[case_id], secs[case_id] = g, sl, sc
end

local function publish_case(ws, case_id)
	if core.active() and coop_mode.writes(case_id) then core.publish("hf_show_map", { c = case_id, m = encode_case(ws, case_id) }) end
end

-- The map decider has the device, its hidden box and the player's inventory.
-- In the server mode the world passes the request there and keeps the published device data.
local harv_ops = {} -- device id -> initiating peer, character and progress of an unfinished demount

local function harvester_feedback(reason)
	if reason == "section" then
		actor_menu.set_msg(1, "Only configured artifacts can be inserted.", 3)
	elseif reason == "condition" then
		actor_menu.set_msg(1, "Artifact condition is too low for one production cycle.", 3)
	elseif reason == "occupied" then
		actor_menu.set_msg(1, "This harvester accepts exactly one input artifact.", 3)
	else
		core.hud("st_coop_guard_failed")
	end
end

local function harvester_refusal(from, reason)
	refuse("harvester", from, reason)
	if from == core.self_peer() and coop_mode.actor_is_player() then return harvester_feedback(reason) end
	return core.to_peer(from, "hf_harv_r", { r = reason })
end

local function harvester_target(t, from, check)
	local id = request_id(t.o)
	if not checked(check .. "_id", id ~= nil, from, id) then return nil, nil, "device" end
	local obj, player = level.object_by_id(id), core.avatar(from)
	if not checked(check .. "_device", harv.is_device(obj) and alife_object(id) ~= nil, from, id) then
		return nil, nil, "device"
	end
	if not coop_mode.writes(id) then return nil, nil, "device" end
	if not checked(check .. "_near", player and coop_mode.where(from) == "here" and core.near(obj, player, NEAR), from, id) then
		return nil, nil, "reach"
	end
	return obj, player
end

local function harvester_box(obj)
	local id = harv.stash_id(obj:id())
	local box = id and level.object_by_id(id)
	local content = id and alife_object(id)
	local section = ini_sys:r_string_ex(obj:section(), "integrated_storage")
	if box and content and section == box:section() and IsInvbox(box) then return box end
end

-- Pure validation for the preview and the action. The condition predicate from
-- Gadgets reads the object's current condition without changing it.
local function harvester_insert_reason(id, item)
	local sec = item:section()
	if not harv.valid_section(sec) or ini_sys:r_bool_ex(sec, "quest_item", false) then return "section" end
	if not harv.reaches_first(sec, item:id()) then return "condition" end
	local d = hf_obj_manager.get_data(id) or {}
	local active = core.object_id(d.artifact_item_id, false, true)
	if active and active ~= item:id() and alife_object(active) then
		local cond = harv.item_condition(active)
		if cond == nil or cond > 0 then return "occupied" end
	end
end

local function host_harvester_insert(t, from)
	local obj, player, reason = harvester_target(t, from, "hf_harv_insert")
	if not obj then return harvester_refusal(from, reason) end
	local id, item_id = obj:id(), request_id(t.i)
	if not checked("hf_harv_insert_item_id", item_id ~= nil, from, id) then return harvester_refusal(from, "item") end
	local item, se = level.object_by_id(item_id), alife_object(item_id)
	if not checked("hf_harv_insert_owner", item and se and se.parent_id == player:id(), from, item_id) then
		return harvester_refusal(from, "item")
	end
	local box = harvester_box(obj)
	if not checked("hf_harv_insert_box", box ~= nil, from, id) then return harvester_refusal(from, "device") end
	if not (coop_mode.writes(box:id()) and coop_mode.writes(item_id)) then return harvester_refusal(from, "device") end
	if harv_ops[id] then return harvester_refusal(from, "busy") end
	reason = harvester_insert_reason(id, item)
	if not checked("hf_harv_insert_valid", reason == nil, from, item_id) then return harvester_refusal(from, reason) end
	player:transfer_item(item, box)
	if se.parent_id ~= box:id() then return harvester_refusal(from, "transfer") end
	harv.clear_active(id) -- also discards a stale or spent input lock
	local ok, err = core.as_player(player, harv.after, box:id(), item, "loot", EDDListType.iActorBag)
	if not ok then core.report("hf", "harvester start", err) end
end

local function finish_harvester_demount(obj, box, player, section, op)
	local id = obj:id()
	if box then
		local contents = {}
		box:iterate_inventory_box(function(_, item) contents[#contents + 1] = item:id() end, box)
		for _, item_id in ipairs(contents) do
			local item, se = level.object_by_id(item_id), alife_object(item_id)
			if item and se and se.parent_id == box:id() then box:transfer_item(item, player) end
			if not (se and se.parent_id == player:id()) then return false end
			op.moved = true
		end
		if not box:is_inv_box_empty() then return false end
	end
	if not op.packed then
		local packed = alife_create_item(section, player)
		if not packed then return false end
		op.packed = true
	end
	if box then
		local box_id = box:id()
		alife_release_id(box_id)
		if alife_object(box_id) then return false end
	end
	harv.set_mapping(id, nil)
	harv.remove_display(id)
	alife_release_id(id)
	if alife_object(id) then return false end
	if data_orig.delete then data_orig.delete(id) end
	data_sent[id] = nil
	core.publish("hf_data", { o = core.hid(id), x = true, b = -1 })
	st.pickup = st.pickup + 1
	return true
end

function harv.demount(t, from)
	local obj, player, reason = harvester_target(t, from, "hf_harv_demount")
	if not obj then return harvester_refusal(from, reason) end
	local id = obj:id()
	local data = hf_obj_manager.get_data(id) or {}
	local section = ini_sys:r_string_ex(obj:section(), "item_section")
	local pickable = not data.is_world_obj and section and ini_sys:section_exist(section)
	if not checked("hf_harv_demount_pickable", pickable, from, id) then return harvester_refusal(from, "device") end
	local box, box_id = harvester_box(obj), harv.stash_id(id)
	if box_id and alife_object(box_id) and not box then return harvester_refusal(from, "busy") end
	if not coop_mode.writes(player:id()) or (box and not coop_mode.writes(box:id())) then
		return harvester_refusal(from, "busy")
	end
	local op = harv_ops[id]
	if op and (op.busy or op.from ~= from or op.actor ~= player:id()) then return harvester_refusal(from, "busy") end
	op = op or { from = from, actor = player:id() }
	harv_ops[id], op.busy = op, true
	local ok, packed = pcall(finish_harvester_demount, obj, box, player, section, op)
	op.busy = false
	if (ok and packed) or not (op.moved or op.packed) or not alife_object(id) then harv_ops[id] = nil end
	if ok and packed then return true end
	if not ok then core.report("hf", "harvester demount", packed) end
	return harvester_refusal(from, "transfer")
end

function harv.request_demount(obj)
	return run_level_action("hf_harv_demount", harv.demount, { o = core.hid(obj:id()) })
end

local function harvester_watch()
	if not core.active() or time_global() < harv.next_look then return end
	harv.next_look = time_global() + 1000
	for id, box_id in pairs(harv.links()) do
		if level.object_by_id(id) and level.object_by_id(box_id) and coop_mode.writes(id) and coop_mode.writes(box_id) then
			local d = hf_obj_manager.get_data(id) or {}
			local active = core.object_id(d.artifact_item_id, false, true)
			local item, se = active and level.object_by_id(active), active and alife_object(active)
			if item and se and se.parent_id ~= box_id then harv.after(box_id, item, "loot", nil) end
		end
	end
end

local function install_harvester_binder(cls, base)
	local function writes_harvester(id)
		if coop_mode.is_player_mirror() or not coop_mode.writes(id) then return false end
		local box = harv.stash_id(id)
		return not box or not alife_object(box) or coop_mode.writes(box)
	end
	-- Keep the mod's constructor (including super and the local wrapper registry),
	-- but gate its two world steps where the constructor calls them.
	local function guard_init(name, read)
		local fn, holder, index = core.upvalue(cls.__init, name)
		if not (holder and type(fn) == "function") then return end
		debug.setupvalue(holder, index, function(id, ...)
			if not core.active() or writes_harvester(id) then return fn(id, ...) end
			if read then return hf_obj_manager.get_data(id) or {} end
		end)
	end
	guard_init("ensure_defaults", true)
	guard_init("sync_display_for_active", false)
	local running, holder, index = core.upvalue(cls.refresh_sound_state, "is_production_running")
	if holder then
		local minimum = core.upvalue(running, "MIN_ACTIVE_CONDITION")
		debug.setupvalue(holder, index, function(d)
			if not (core.active() and coop_mode.is_player_mirror()) then return running(d) end
			local sec = d.artifact_section
			return core.object_id(d.artifact_item_id, false, true) and harv.valid_section(sec) and (tonumber(d.artifact_condition) or 0) > minimum
		end)
	end
	core.wrap(cls, "update", "bind_artifact_harvester.artifact_harvester_wrapper.update", function(orig)
		return function(self, delta, ...)
			if not core.active() or (self.object and writes_harvester(self.object:id())) then return orig(self, delta, ...) end
			base.update(self, delta)
			if coop_mode.is_player_mirror() then
				self:refresh_sound_state()
				self:refresh_progress_display()
			end
		end
	end)
	local registry = core.upvalue(cls.net_destroy, "harvester_wrappers")
	core.wrap(cls, "net_destroy", "bind_artifact_harvester.artifact_harvester_wrapper.net_destroy", function(orig)
		return function(self, ...)
			if not core.active() then return orig(self, ...) end
			local id = self.object:id()
			if self.snd_hum and self.snd_hum:playing() then self.snd_hum:stop() end
			RemoveTimeEvent("hf_artifact_harvester_stash", "open_" .. tostring(id))
			self:apply_display_number(0, false)
			if registry and rawequal(registry[id], self) then registry[id] = nil end
			return base.net_destroy(self, ...)
		end
	end)
end

local function install_harvester_inventory(before)
	local bags = core.upvalue(before, "valid_actor_bags")
	local function in_window(case_id)
		local obj = case_id and level.object_by_id(case_id)
		if harv.is_device(obj) then return case_id end
		-- Search the links read-only. The mod's lookup would cache a reverse link.
		for id, box_id in pairs(harv.links()) do if box_id == case_id then return id end end
	end
	core.swap_callback("ActorMenu_on_item_before_move", before, function(flags, case_id, item, mode, bag)
		if not core.active() then return before(flags, case_id, item, mode, bag) end
		if not (flags and flags.ret_value and item and mode == "loot" and bags[bag]) then return end
		local id = in_window(case_id)
		local reason = id and harvester_insert_reason(id, item)
		if reason then
			flags.ret_value = false
			harvester_feedback(reason)
		end
	end)
	core.swap_callback("ActorMenu_on_item_after_move", harv.after, function(case_id, item, mode, bag)
		if not core.active() then return harv.after(case_id, item, mode, bag) end
		local id = not bags[bag] and in_window(case_id)
		if id and coop_mode.writes(id) and coop_mode.writes(case_id) then
			return harv.after(case_id, item, mode, bag)
		end
	end)
	local ui = core.mod("ui_inventory")
	core.wrap(ui and ui.UIInventory, "Action_Move", "ui_inventory.UIInventory.Action_Move (harvester)", function(orig)
		return function(self, item, bag, ...)
			local id = core.active() and self.mode == "loot" and (bag == "actor_bag" or bag == "actor_equ")
				and in_window(self.npc_id)
			if not id then return orig(self, item, bag, ...) end
			item = self:CheckItem(item, "Action_Move")
			if not item then return end
			local reason = harvester_insert_reason(id, item)
			if reason then return harvester_feedback(reason) end
			return run_level_action("hf_harv_insert", host_harvester_insert, { o = core.hid(id), i = core.hid(item:id()) })
		end
	end)
end

local function install_harvester()
	local bh, b = core.mod("bind_artifact_harvester"), core.mod("bind_hf_base")
	local cls, base = bh and bh.artifact_harvester_wrapper, b and b.hf_binder_wrapper
	local open, save = core.fn(bh, "open_harvester_stash"), core.fn(bh, "harvester_save_state")
	if not (cls and base and open and save and core.mod("hf_obj_manager")) then return end
	local before = core.find_local(bh, "on_item_before_move")
	harv.after = core.find_local(bh, "on_item_after_move")
	local get_or_create = core.upvalue(open, "get_or_create_harvester_stash")
	harv.set_mapping = core.upvalue(get_or_create, "set_stash_mapping")
	harv.reaches_first = core.upvalue(before, "can_reach_first_spawn")
	harv.valid_section = core.upvalue(before, "is_valid_artifact_section")
	harv.item_condition = core.upvalue(before, "get_item_condition_and_setter")
	harv.clear_active = core.upvalue(harv.after, "clear_active")
	harv.remove_display = core.upvalue(harv.after, "remove_display")
	if not (harv.set_mapping and harv.reaches_first and harv.valid_section and harv.item_condition
		and harv.clear_active and harv.remove_display) then error("unsupported artifact harvester bindings", 0) end
	function harv.links()
		local m = {}
		save(m)
		return m.harvester_stashes
	end
	function harv.stash_id(id) return harv.links()[id] end
	resolvers.harvester = function(obj)
		local box_id = get_or_create(obj, true)
		if box_id then host_publish_data(obj:id()) end
		return box_id
	end
	core.wrap(bh, "open_harvester_stash", "bind_artifact_harvester.open_harvester_stash", function(orig)
		return function(id, ...)
			if not core.active() then return orig(id, ...) end
			if coop_mode.is_player_mirror() then return ask_box("harvester", id, open_box) end
			if coop_mode.writes(id) and coop_mode.actor_is_player() then
				local result = orig(id, ...)
				host_publish_data(id)
				return result
			end
		end
	end)
	-- Registration is idempotent in Gadgets, including when its own start runs later.
	bh.on_game_start()
	install_harvester_binder(cls, base)
	install_harvester_inventory(before)
	core.on("hf_harv_insert", host_harvester_insert, "host")
	core.on("hf_harv_demount", harv.demount, "host")
	core.on("hf_harv_r", function(t) harvester_feedback(t.r) end, "player")
	core.set_limit("hf_harv_insert", 6, 2, function(_, from) harvester_refusal(from, "busy") end)
	core.set_limit("hf_harv_demount", 4, 1, function(_, from) harvester_refusal(from, "busy") end)
	harv.next_look = 0
	RegisterScriptCallback("actor_on_update", harvester_watch)
	harv.ready = true
	installed[#installed + 1] = "hf_gadgets.harvester"
end

local function writes_display(case_id, world_id)
	return coop_mode.writes(case_id) and (not world_id or not alife_object(world_id) or coop_mode.writes(world_id))
end

local function respawn_own_displays(ws, orig, ...)
	local guns, slots, sections = ws_tables(ws)
	local owned, keep = false, {}
	for case_id, items in pairs(guns) do
		local writes = coop_mode.writes(case_id)
		if writes then
			for _, world_id in pairs(items) do
				if alife_object(world_id) and not coop_mode.writes(world_id) then writes = false; break end
			end
		end
		if writes then
			owned = true
		else
			keep[case_id] = { items, slots[case_id], sections[case_id] }
		end
	end
	if not owned then return true end
	for case_id in pairs(keep) do guns[case_id], slots[case_id], sections[case_id] = nil, nil, nil end
	local ok, result = pcall(orig, ...)
	-- Stock respawn replaces these tables. Keep rows for cases served by other writers.
	guns, slots, sections = ws_tables(ws)
	for case_id, rows in pairs(keep) do guns[case_id], slots[case_id], sections[case_id] = rows[1], rows[2], rows[3] end
	if not ok then error(result, 0) end
	return result
end

-- The case whose display copy `id` is (weapon_showcase.weapon_displays: case -> item -> display copy), nil for any other item.
local function display_case_of(ws, id)
	local guns = type(ws.weapon_displays) == "table" and ws.weapon_displays or {}
	for case_id, items in pairs(guns) do
		if type(items) == "table" then
			for _, world_id in pairs(items) do
				if world_id == id then return case_id end
			end
		end
	end
end

local function install_gadgets()
	local ws = core.mod("weapon_showcase")
	if not (ws and core.fn(ws, "spawn_displayed_item") and core.fn(ws, "remove_displayed_item")) then return end
	installed[#installed + 1] = "hf_gadgets.showcase"
	-- A display copy is a real weapon in its case, and the mod's veto runs only on
	-- the picker's machine. The process that applies a move asks coop_mods_move_limits.admit first (engine admitted_move): every
	-- move of a display copy is refused there, whoever asks and wherever it goes: into a container, and into a player's
	-- character (admitted_move asks for that destination too, without held moves: §8a A21 E-3, tests/lua/test_move_rules_player.lua).
	local limits = core.mod("coop_mods_move_limits")
	if limits and type(limits.add_rule) == "function" then
		limits.add_rule("hf_showcase_display", function(_, item)
			if display_case_of(ws, item) ~= nil then return false, "a weapon showcase display copy" end
		end)
	end
	core.wrap(ws, "spawn_displayed_item", "weapon_showcase.spawn_displayed_item", function(orig)
		show.orig_spawn = orig
		return function(case_id, item_id, gun_number, item_sec, ...)
			if not core.active() then return orig(case_id, item_id, gun_number, item_sec, ...) end
			if not coop_mode.writes(case_id) then
				if coop_mode.is_player_mirror() then
					core.to_host("hf_show", { c = core.hid(case_id), i = core.hid(item_id), m = 1, s = item_sec or "" })
				end
				return
			end
			local r = orig(case_id, item_id, gun_number, item_sec, ...)
			publish_case(ws, case_id)
			return r
		end
	end)
	core.wrap(ws, "remove_displayed_item", "weapon_showcase.remove_displayed_item", function(orig)
		show.orig_remove = orig
		return function(item_id, world_item_id, case_id, ...)
			if not core.active() then return orig(item_id, world_item_id, case_id, ...) end
			if not writes_display(case_id, world_item_id) then
				if coop_mode.is_player_mirror() then
					core.to_host("hf_show", { c = core.hid(case_id), i = core.hid(item_id), m = 0 })
					return true
				end
				return
			end
			local r = orig(item_id, world_item_id, case_id, ...)
			publish_case(ws, case_id)
			return r
		end
	end)
	core.wrap(ws, "respawn_weapon_displays", "weapon_showcase.respawn_weapon_displays", function(orig)
		return function(...)
			if not core.active() then return orig(...) end
			return respawn_own_displays(ws, orig, ...)
		end
	end)
	core.on("hf_show", function(t, from)
		local case_id, item_id = core.lid(tonumber(t.c)), core.lid(tonumber(t.i))
		local case = type(case_id) == "number" and level.object_by_id(case_id)
		local who = core.avatar(from)
		if not (case and who and type(item_id) == "number" and core.near(case, who, NEAR)) then return refuse("hf_show", from, "unknown or far case") end
		if not coop_mode.writes(case_id) then return refuse("hf_show", from, "another writer owns the case") end
		if t.m == 1 then
			local se = alife_object(item_id)
			if not (se and se.parent_id == case_id) then return refuse("hf_show", from, "the item is not in that case") end
			local displays = type(ws.weapon_displays) == "table" and ws.weapon_displays[case_id]
			local world_id = type(displays) == "table" and displays[item_id]
			if world_id and alife_object(world_id) then
				publish_case(ws, case_id)
				return
			end
			local sec = (type(t.s) == "string" and t.s ~= "" and ini_sys:section_exist(t.s)) and t.s or nil
			local ok, err = core.as_player(who, show.orig_spawn, case_id, item_id, nil, sec)
			if not ok then core.report("hf", "spawn display", err) end
		else
			local guns = ws.weapon_displays or {}
			local world_id = guns[case_id] and guns[case_id][item_id]
			if world_id and writes_display(case_id, world_id) then pcall(show.orig_remove, item_id, world_id, case_id) end
		end
		publish_case(ws, case_id)
	end, "host")
	core.on("hf_show_map", function(t, from)
		local case_id = core.lid(tonumber(t.c))
		local valid = case_id and type(t.m) == "string"
		if not coop_mode.decides_world() then
			if from == 0 and valid then apply_case(ws, case_id, t.m) end
		else
			local source = coop_mode.from_level(from)
			if not coop_trust.pass("hf_show_map_sender", source, "unexpected showcase report from peer %s", tostring(from))
				or not source then return end
			if not coop_trust.pass("hf_show_map_payload", valid, "invalid showcase report from peer %s", tostring(from))
				or not valid then return end
			apply_case(ws, case_id, t.m)
			core.to_all("hf_show_map", t)
		end
	end)
	core.set_limit("hf_show", 6, 2)
end

-------------------------------------------------------------------------------
-- Placed radio (placeable_radio): the host's programme plays on every machine
-------------------------------------------------------------------------------
local R = { P = nil, W = nil, orig = {}, catalog = nil, loc = {}, state = {}, seen = setmetatable({}, { __mode = "k" }),
	pub = {}, next_refresh = 0 }

local KIND_TRACK, KIND_SESSION = 0, 1

local function radio_local(name)
	local l = R.loc[name]
	if l == nil then
		local v, holder, idx = core.find_local(R.P, name)
		l = { v = v, holder = holder, idx = idx }
		R.loc[name] = l
	end
	if l.holder then
		local _, v = debug.getupvalue(l.holder, l.idx)
		return v
	end
	return R.P[name]
end

local function set_radio_local(name, value)
	local l = R.loc[name]
	if l and l.holder then debug.setupvalue(l.holder, l.idx, value) elseif R.P[name] ~= nil then R.P[name] = value end
end

local function lower(s) return string.lower((string.gsub(s or "", "/", "\\"))) end

local function list_names(path)
	local names, index = {}, {}
	local ok, fl = pcall(function() return getFS():file_list_open("$game_sounds$", path, bit_or(FS.FS_ListFiles, FS.FS_RootOnly)) end)
	local n = ok and fl and fl:Size() or 0
	for i = 1, n do
		local name = fl:GetAt(i - 1):sub(1, -5)
		names[i], index[lower(name)] = name, i
	end
	return { names = names, index = index }
end

local function radio_catalog()
	if R.catalog then return R.catalog end
	local pc, ps = radio_local("path_radio_ch"), radio_local("path_radio_session")
	if type(pc) ~= "table" or type(ps) ~= "table" then return nil end
	local cat = {}
	for ch = 1, #pc do
		cat[ch] = { p = pc[ch], q = ps[ch], [KIND_TRACK] = list_names(pc[ch]), [KIND_SESSION] = list_names(ps[ch]) }
	end
	R.catalog = cat
	return cat
end

local function channel_of(p, q)
	local cat = radio_catalog()
	if not cat then return nil end
	for ch, c in ipairs(cat) do
		if lower(c.p) == lower(p) and lower(c.q) == lower(q) then return ch end
	end
	return nil
end

local function radio_ok(w)
	return w and w.object and type(w.radio_ch) == "table" and type(w.radio_session) == "table"
		and type(w.radio_now) == "table" and type(w.radio_session_now) == "table"
end

local function playing(w)
	local ch = w.radio_selected
	if not (type(ch) == "number" and w.radio_ch[ch]) then return nil end
	local si, ti = w.radio_session_now[ch], w.radio_now[ch]
	local s = w.radio_session[ch] and w.radio_session[ch][si]
	if s and s:playing() then return KIND_SESSION, si, s end
	s = w.radio_ch[ch][ti]
	if s and s:playing() then return KIND_TRACK, ti, s end
	return nil
end

local function stop_music(w)
	for _, name in ipairs({ "radio_ch", "radio_ch_out", "radio_session", "radio_session_out" }) do
		for _, chan in pairs(w[name] or {}) do
			for _, snd in pairs(chan) do pcall(function() snd:stop() end) end
		end
	end
end

local function host_radio_publish(w, force)
	local id = w.object:id()
	if not coop_mode.writes(id) then return end
	local cat = radio_catalog()
	if not cat then return end
	local kind, idx = playing(w)
	local ch = w.radio_selected
	local on = w.radio_state == true
	local c = cat[ch]
	local clip = (on and c and kind and c[kind].names[idx]) or ""
	local vol = tonumber(radio_local("radio_vol")) or 0.5
	local p = R.pub[id] or { n = 0 }
	R.pub[id] = p
	local sig = table.concat({ tostring(on), tostring(ch), tostring(kind), clip, string.format("%.2f", vol) }, "|")
	if sig == p.sig and not force then return end
	if sig ~= p.sig then p.n = p.n + 1 end
	p.sig = sig
	core.to_all("hf_radio", { o = id, on = on, p = c and c.p or "", q = c and c.q or "", k = kind or -1, c = clip, v = vol, n = p.n })
	st.radio_out = st.radio_out + 1
end

local function client_radio_apply(w)
	local id = w.object:id()
	local s = R.state[id]
	local seen = R.seen[w]
	local previous = seen and seen.state
	if not s or previous == s then return end
	local volume = math.max(0, math.min(1, (tonumber(s.v) or 0.5) - (tonumber(radio_local("psi_vol")) or 0)))
	if previous and previous.on == s.on and previous.p == s.p and previous.q == s.q
		and previous.k == s.k and previous.c == s.c then
		if seen.sound and previous.v ~= s.v then seen.sound.volume = volume end
		seen.state = s
		return
	end
	seen = { state = s }
	R.seen[w] = seen
	stop_music(w)
	local ch = channel_of(s.p, s.q)
	w.radio_state = s.on == true
	w.radio_selected = ch or 0
	local cat = radio_catalog()
	local kind = tonumber(s.k)
	if not (s.on and ch and cat and (kind == KIND_TRACK or kind == KIND_SESSION)) then return end
	local i = cat[ch][kind].index[lower(s.c)]
	if not i then return end -- a clip this install does not have: silence rather than something else
	local snd
	if kind == KIND_SESSION then
		w.radio_session_now[ch] = i
		snd = w.radio_session[ch][i]
	else
		w.radio_now[ch] = i
		snd = w.radio_ch[ch][i]
	end
	if snd then
		pcall(function()
			snd:play_at_pos(w.object, w.object:position(), 0, sound_object.s3d)
			snd.volume = volume
			seen.sound = snd
		end)
	end
end

local RADIO_ACTIONS = { action_radio_start = true, action_radio_stop = true, action_radio_ch = true,
	action_radio_v_up = true, action_radio_v_down = true }

local function install_radio()
	R.P = core.mod("placeable_radio")
	R.W = R.P and R.P.placeable_radio_wrapper
	if not (R.W and core.fn(R.W, "update") and core.mod("bind_hf_base")) then return end
	-- File locals are looked up before the methods that hold them are wrapped.
	for _, name in ipairs({ "path_radio_ch", "path_radio_session", "radio_vol", "psi_vol", "safety_lock" }) do radio_local(name) end
	if not radio_catalog() then
		log("placed radio: station lists not found, radio not synced")
		return
	end
	installed[#installed + 1] = "hf_radio"
	core.wrap(R.W, "update", "placeable_radio.placeable_radio_wrapper.update", function(orig)
		R.orig.update = orig
		return function(w, delta, ...)
			if not (core.active() and radio_ok(w)) then return orig(w, delta, ...) end
			if not coop_mode.is_player_mirror() and coop_mode.writes(w.object:id()) then
				local r = orig(w, delta, ...)
				local ok, e = pcall(host_radio_publish, w, false)
				if not ok then core.report("hf", "radio publish", e) end
				return r
			end
			if not coop_mode.is_player_mirror() then return end
			local ok, e = pcall(client_radio_apply, w)
			if not ok then core.report("hf", "radio apply", e) end
			-- The mod's own picker stays shut on a client (safety lock); noise and emission effects still run.
			local lock = radio_local("safety_lock")
			set_radio_local("safety_lock", true)
			local ok2, r = pcall(orig, w, delta, ...)
			set_radio_local("safety_lock", lock)
			if not ok2 then core.report("hf", "radio update", r) end
			return r
		end
	end)
	for name in pairs(RADIO_ACTIONS) do
		core.wrap(R.W, name, "placeable_radio.placeable_radio_wrapper." .. name, function(orig)
			R.orig[name] = orig
			return function(w, value, ...)
				if not (core.active() and radio_ok(w)) then return orig(w, value, ...) end
				if not coop_mode.is_player_mirror() then
					if coop_mode.writes(w.object:id()) then return orig(w, value, ...) end
					return
				end
				local t = { o = core.hid(w.object:id()), a = name }
				if name == "action_radio_ch" then
					local c = radio_catalog() and radio_catalog()[value]
					if not c then return false end
					t.p, t.q = c.p, c.q
				end
				core.to_host("hf_radio_ctl", t)
				return false -- the radio follows the host's state
			end
		end)
	end
	core.on("hf_radio_ctl", function(t, from)
		local id = request_id(t.o)
		if not checked("hf_radio_id", id ~= nil, from, id) then return refuse("hf_radio_ctl", from, "invalid id") end
		if not coop_mode.writes(id) then return refuse("hf_radio_ctl", from, "another writer owns the radio") end
		local w = wrapper_of(id)
		local who = core.avatar(from)
		local action = t.a
		local valid = radio_ok(w) and type(action) == "string" and RADIO_ACTIONS[action] and R.orig[action]
		if not checked("hf_radio_action", valid, from, id) then
			return refuse("hf_radio_ctl", from, "unknown radio or action")
		end
		if not checked("hf_radio_near", who and coop_mode.where(from) == "here" and core.near(w.object, who, NEAR), from, id) then
			return refuse("hf_radio_ctl", from, "radio out of reach")
		end
		local arg = nil
		if action == "action_radio_ch" then
			arg = type(t.p) == "string" and type(t.q) == "string" and channel_of(t.p, t.q)
			if not checked("hf_radio_station", arg ~= nil and arg ~= false, from, id) then
				return refuse("hf_radio_ctl", from, "station not installed on the host")
			end
		end
		pcall(R.orig[action], w, arg)
		host_radio_publish(w, true)
	end, "host")
	core.on("hf_radio", function(t)
		local id = core.lid(tonumber(t.o))
		if not id then return end
		R.state[id] = { on = t.on == true, p = lower(tostring(t.p or "")), q = lower(tostring(t.q or "")),
			k = tonumber(t.k), c = lower(tostring(t.c or "")), v = tonumber(t.v) }
		st.radio_in = st.radio_in + 1
	end, "client")
	core.set_limit("hf_radio_ctl", 8, 3)
end

-- Host: radios that are on are announced again now and then (late joiners, lost state).
local function host_radio_refresh()
	if not (R.W and core.active()) then return end
	local tg = time_global()
	if tg < R.next_refresh then return end
	R.next_refresh = tg + 20000
	for id, p in pairs(R.pub) do
		local w = wrapper_of(id)
		if w and radio_ok(w) and w.radio_state then pcall(host_radio_publish, w, true) end
		if not w then R.pub[id] = nil end
	end
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included.
function on_game_start()
	if not api then return end
	core.install("hf", "install_furniture", install_furniture)
	core.install("hf", "install_stove", install_stove)
	core.install("hf", "install_harvester", install_harvester)
	core.install("hf", "install_gadgets", install_gadgets)
	core.install("hf", "install_data_mirror", install_data_mirror)
	core.install("hf", "install_takeall", install_takeall)
	core.install("hf", "install_frozen", install_frozen)
	core.install("hf", "install_lamp_mirror", install_lamp_mirror)
	core.install("hf", "install_radio", install_radio)
	if #installed == 0 then return end
	core.on("hf_box", host_box, "host")
	core.on("hf_box_r", client_box_answer, "client")
	core.set_limit("hf_box", 6, 2)
	RegisterScriptCallback("actor_on_update", host_radio_refresh)
	core.status_line("hf", function()
		return string.format("%s | placed %d, packed %d, lamps %d, boxes %d, refused %d | data out %d in %d | radio out %d in %d",
			table.concat(installed, ", "), st.place, st.pickup, st.lamp, st.box, st.refused, st.data_out, st.data_in,
			st.radio_out, st.radio_in)
	end)
end
