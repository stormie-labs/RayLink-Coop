--[[
	Anomaly Coop - small third-party mod patches (gamedata\scripts\coop_mods_misc.script).

	Each patch installs only when its mod is present and does nothing outside a co-op session.

	Experience Framework (experience_core)     XP, skills, traits, own XP tasks, potion buff are per player
	                                           (coop_mods_pdata, sub-keys of experience_framework_savedata;
	                                           NPC levels nls_storage stay the host's).
	Wearable Devices (wd_core)                 not adapted (its key list would come only from another co-op's patch;
	                                           the mod is not in our GAMMA to derive it from).
	Quick Action Wheel (haru_qaw)              the layout is per player; entries whose item is not in this
	                                           player's inventory any more are dropped at the first update.
	Kill Tracker (ish_kill_tracker)            a player's character is named by the player's nick; the mod's
	                                           own records are per player (keys found from its save_state).
	New Player Experience (npe_director)       what was shown is per player (its key npe): a client loads the host's
	                                           save at every level change and would be taught everything anew.
	Fair Fast Travel (game_fast_travel)        the cooldowns, the count of found points and the paused hunger are per
	                                           player (sub-keys of fast_travel_system; the zones it spawned are the world's).
	Small per-player keys (PREFS)              belt per outfit, voice cooldown, last helmet, sorting favourites/junk,
	                                           scope FOVs, NVG scope flag, DOF reload times are the player's own after a load.
	Guitar / harmonica (guitar_anim, harmonica_anim)  original Daiviey HUD entry points feed bounded native
	                                           coop.instrument state.
	Immersive Sleep (ui_sleep_dialog)          the tiredness veto judges the most tired player of the group
	                                           (mods.sleepy client -> host, mods.sleepy_max host -> all).
	Zone Customization Project (smr_loot)      bonus loot is rolled by the host only; a client's container is
	                                           rolled by the host when the engine reports its opening.
	Personal Adjustable Waypoint               the waypoint task is personal (coop_tasks.set_local_task, needs
	                                           coop.story_local_task in the engine); a player's character is
	                                           named by the nick.
	Body Health System (zzz_player_injuries)   after a co-op revive head/torso get back above zero and the medkit
	                                           heals the limbs (the mod's own heal never runs on a revive);
	                                           head_tbl and the body parts are per player (the parts live in the
	                                           actor's pstor, which comes with the host's save). Its concussion waits until the player stands:
	                                           hits on a body would turn the volume down and up again and again.
	Grok's actor damage balancer               the armour, the body part and the limb of Body Health System are its work,
	                                           and it leaves a bullet alone when the weapon of the hit is not on this
	                                           machine: the shooter's hands stand in, else the bullet is counted with
	                                           no armour piercing. Every hit by a player is in the log.
	AGDD Voiced Actor                          a player who is down or dead says nothing: grunts over the teammate he
	                                           watches.
	Oleh's Extended MovementSFX                footsteps of other players' characters (when the engine reports
	                                           avatar steps through core.on_avatar_step).
--]]

local api = rawget(_G, "coop")

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local core = coop_mods_core
local pdata = coop_mods_pdata

local installed = {}

local function log(tag, fmt, ...) core.log(tag, fmt, ...) end

-------------------------------------------------------------------------------
-- Experience Framework, Quick Action Wheel, Kill Tracker: per-player keys
-------------------------------------------------------------------------------
local EF_SUBS = { "XP", "skills_savedata", "traits_savedata", "tasks_manager", "potion_xp_buff" }
-- game_fast_travel.save_state: the rest of the table (spawned_travel_zones, zone_spawn_version) names objects of the world
local FFT_SUBS = { "cooldowns", "locations_found", "survival_paused", "stored_satiety" }

-- Everything a client has comes through a transition exactly as in a usual game: small per-player keys these mods keep in
-- m_data would come back as the HOST's after every world load (a client loads the host's save). Each one is read the way the mod saves it: the mod's own save function run on a scratch table, so the
-- value is exactly what its next save would write. A local save_state is reached as an upvalue (find_local).
--   module, its save function, keys it writes
-- Ids in the values: beltMemory (outfit and belt item OBJECT ids) is only ever looked up in the player's own inventory
-- (db.actor:object_id), so the player's own record can touch no other player's item; the rest is keyed by section names
-- (favourites, junk, FOVs, reload times) or is a flag.
local PREFS = {
	{ "remember_outfit_belt", "on_save_state", { "beltMemory" } }, -- the belt each of the last 5 outfits had
	{ "zzz_rax_sortingplus_mcm", "save_state", { "rax_favorite_itms", "rax_junk_itms" } }, -- z_auto_looter reads the favourites too
	{ "scope_fov_mcm", "save_state", { "snk_saved_hud_fov", "snk_saved_gl_fov" } }, -- per weapon / per grenade launcher
	{ "bas_nvg_scopes", "save_state", { "snk_bas_nvg_flag" } }, -- the NVG scope switch (false is a value)
	{ "ssfx_weapons_dof", "save_state", { "ssfx_saved_reload_time" } }, -- measured reload times per weapon section
}

-- These mods keep personal values outside m_data. Read their
-- live upvalues, and restore at load_state (after pdata replaces the world's
-- values, before on_game_load/first use). No map or mode knowledge is needed.
local function mod_local(M, name, value, write)
	local v, holder, index = core.find_local(M, name)
	if write and holder then debug.setupvalue(holder, index, value) end
	return v, holder
end

local function bounded_number(v, low, high, fallback)
	if type(v) ~= "number" or v ~= v then return fallback end
	return math.max(low, math.min(high, v))
end

local function personal_active()
	-- Registration and getters do not depend on a local actor.
	return core.active() and coop_mode.actor_is_player()
end

-- A Co-op host starts its session after its level is up (coop_manager.cpp autostart waits for level_ready; the in-game
-- Host comes later still) and its load_state comes before that: the records were restored only at a load_state with a
-- session, so on a Co-op host none came back and its next save in the session wrote the mods' defaults over them. A save
-- loaded without a session is kept, and its records are restored once this process has one: at the first update then,
-- or at a save in the session that comes before it. A Co-op client joins before its level loads and a server's session
-- starts before its Lua: their load_state has the session, as before. Single player never has one: nothing is restored.
-- The records are copied at the load: the table load_state gets is the game's m_data, the one every later save_state
-- writes into (CALifeStorageManager_before_save), its other callbacks in pairs order. Kept by reference, a save in the
-- session before the restore had the wrapped helmet save write this session's helmet (none yet) over the save's one.
-- from: the m_data of that load, so that its keys go into one copy
local late = { from = nil, save = nil, states = {} }

-- true: no save waits any more. Once the session runs, as at a load_state with one: restored only for a player's actor.
local function restore_late()
	local m = late.save
	if m == nil then return true end
	if not core.active() then return false end
	late.from, late.save = nil, nil
	if not personal_active() then return true end
	for _, s in ipairs(late.states) do
		local ok, e = pcall(s.restore, m[s.key], m)
		if not ok then core.report("misc", "late restore " .. s.key, e) end
	end
	return true
end

local function await_session()
	if restore_late() then UnregisterScriptCallback("actor_on_update", await_session) end
end

local function personal_state(key, get, restore)
	pdata.register(key, { get = get })
	late.states[#late.states + 1] = { key = key, restore = restore }
	RegisterScriptCallback("save_state", function(m)
		if not personal_active() then return end
		restore_late() -- the kept save's records first, never the defaults over them
		m[key] = get()
	end)
	RegisterScriptCallback("load_state", function(m)
		if not core.active() then
			if late.from ~= m then late.from, late.save = m, {} end
			late.save[key] = m[key]
			RegisterScriptCallback("actor_on_update", await_session)
			return
		end
		late.from, late.save = nil, nil
		if personal_active() then restore(m[key], m) end
	end)
end

local function install_helmet_prefs()
	local M = core.mod("liz_fdda_redone_headgear_animations_hotkey")
	if not M then return end
	-- Older/partial versions keep the previous ownership-only behaviour.
	local setter = core.fn(M, "set_last_helmet")
	if not (setter and core.fn(M, "toggle_helmet")) then pdata.register("lastHelmetId", {}); return end
	local chosen, pending = 0, false -- host numbering; zero explicitly clears an older choice
	local function own_helmet()
		local found
		if chosen > 0 and db.actor then
			local id = core.lid(chosen)
			db.actor:iterate_ruck(function(_, item)
				if item:id() == id then found = item end
			end, nil)
		end
		setter(found) -- also clears any kept userdata whose item is no longer ours
		pending = chosen > 0 and not found
	end
	personal_state("lastHelmetId", function() return chosen end, function(v, m)
		local valid = core.object_id(v, true) ~= nil
		-- Ids are identities, not magnitudes: an invalid id is dropped in every mode, never clamped or rounded to the id of a
		-- different inventory item (an always-on guard, coop_trust.guard: its line says "dropped")
		local accepted = coop_trust.guard("mods_misc_helmet_id", v == nil or valid, "invalid saved helmet id (%s)", type(v))
		chosen = accepted and valid and v or 0
		if v ~= nil then m.lastHelmetId = chosen end
		setter(nil)
		pending = chosen > 0
	end)
	core.wrap(M, "set_last_helmet", "misc.helmet_choice", function(orig) return function(item, ...)
		if not core.active() then return orig(item, ...) end
		-- The caller has just chosen a live item. Never obtain this id from lastHelmet later.
		chosen = item and core.hid(item:id()) or 0
		pending = false
		return orig(item, ...)
	end end)
	core.wrap(M, "toggle_helmet", "misc.helmet_hotkey", function(orig) return function(...)
		if not core.active() then return orig(...) end
		own_helmet()
		local before = mod_local(M, "lastHelmet")
		local current = db.actor and db.actor:item_in_slot(12)
		local id = current and core.hid(current:id()) -- capture BEFORE the animation can move the item
		local r = orig(...)
		-- The mod's slot lookup can return a different userdata for the same item.
		-- Detect the assignment by reference without dereferencing either saved value.
		local selected = mod_local(M, "lastHelmet")
		if id and selected and not rawequal(selected, before) then chosen, pending = id, false end
		return r
	end end)
	local old = core.fn(M, "on_save_state")
	if core.wrap(M, "on_save_state", "misc.helmet_save", function(orig) return function(m, ...)
		if not core.active() then return orig(m, ...) end
		m.lastHelmetId = chosen
	end end) then core.swap_callback("save_state", old, M.on_save_state) end
	local function retry()
		if core.active() and pending then own_helmet() end
	end
	RegisterScriptCallback("actor_on_first_update", retry)
	RegisterScriptCallback("actor_on_update", retry)
end

local function install_live_prefs()
	local N = core.mod("z_beefs_nvgs")
	if N then
		personal_state("coop_misc_nvg_state", function()
			return { gain = bounded_number(mod_local(N, "nvg_gain_current"), 0.1, 3, 1),
				direction = mod_local(N, "gain_directionality") ~= false }
		end, function(v)
			v = type(v) == "table" and v or {}
			mod_local(N, "nvg_gain_current", bounded_number(v.gain, 0.1, 3, 1), true)
			mod_local(N, "gain_directionality", v.direction ~= false, true)
		end)
	end
	local O = core.mod("liz_fdda_redone_outfit")
	if O then
		local function limit()
			local mcm = core.mod("liz_fdda_redone_mcm")
			local max = mcm and core.fn(mcm, "get_config") and mcm.get_config("outfit_anm/memory_size")
			max = bounded_number(max or mod_local(O, "mcm_memory_max"), -1, 64, 3)
			return max > 0 and math.floor(max) or 64 -- unlimited MCM history still has a bounded personal record
		end
		local function history(v)
			local out = {}
			if type(v) == "table" then
				for i = math.max(1, #v - limit() + 1), #v do
					local sec = v[i]
					if type(sec) == "string" and #sec > 0 and #sec <= 128 then out[#out + 1] = sec end
				end
			end
			return out
		end
		personal_state("coop_misc_outfit_history", function()
			local memory = mod_local(O, "memory")
			local last = bounded_number(mod_local(O, "memory_last"), -1, 2147483647, -1)
			local out = {}
			for i = math.max(0, last - limit() + 1), last do out[#out + 1] = memory and memory[i] end
			return history(out)
		end, function(v)
			local ordered, memory = history(v), {}
			for i, sec in ipairs(ordered) do memory[i - 1] = sec end
			mod_local(O, "memory", memory, true)
			mod_local(O, "memory_first", 0, true)
			mod_local(O, "memory_last", #ordered - 1, true)
		end)
	end
	local X = core.mod("exo_powers")
	if X then
		local deadline = 0
		core.wrap(X, "deactivate_powers", "misc.exo_cooldown", function(orig) return function(seconds, ...)
			if not core.active() then return orig(seconds, ...) end
			local r = orig(seconds, ...)
			deadline = time_global() + bounded_number(seconds, 0, 86400, 0) * 1000
			return r
		end end)
		core.wrap(X, "reset_cooldown", "misc.exo_reset", function(orig) return function(...)
			if core.active() then deadline = 0 end
			return orig(...)
		end end)
		personal_state("coop_misc_exo_cooldown_ms", function()
			return bounded_number(deadline - time_global(), 0, 86400000, 0)
		end, function(v)
			local left = bounded_number(v, 0, 86400000, 0)
			deadline = time_global() + left
			mod_local(X, "on_cooldown", left > 0, true)
			RemoveTimeEvent("exo_powers", "deactivate_power")
			if left > 0 then CreateTimeEvent("exo_powers", "deactivate_power", left / 1000, X.reset_cooldown) end
		end)
	end
	local R = core.mod("level_environment")
	if R then
		-- Stock on_game_load reads this key after pdata; refresh from live locals,
		-- not its possibly stale m_data copy. No console text comes from the wire.
		personal_state("r2_drops_control", function()
			return { bounded_number(mod_local(R, "droplet_pwr"), 0, 1, 0),
				bounded_number(mod_local(R, "droplet_speed"), 0, 1, 0) }
		end, function(v, m)
			v = type(v) == "table" and v or {}
			-- The stock later interpolates these into a console command: only
			-- locally bounded numbers may reach it, never saved strings/tables.
			m.r2_drops_control = { bounded_number(v[1], 0, 1, 0), bounded_number(v[2], 0, 1, 0) }
		end)
	end
end

local function install_prefs()
	local n = 0
	for _, spec in ipairs(PREFS) do
		local M = core.mod(spec[1])
		local save = M and (core.fn(M, spec[2]) or core.find_local(M, spec[2]))
		-- no save function found: the current value cannot be read, and a key that is never reported is better left alone
		if type(save) == "function" then
			for _, key in ipairs(spec[3]) do
				pdata.register(key, { get = function()
					local t = {}
					save(t)
					return t[key] -- nil (the helmet hotkey writes nothing while no helmet is off): the loaded value stays
				end })
				n = n + 1
			end
		end
	end
	install_helmet_prefs()
	install_live_prefs()
	-- its save_state is a global (agdd_voiced_actor.script:1481): the remaining ms of the long shout cooldown
	local voiced = core.mod("agdd_voiced_actor")
	if voiced and core.fn(voiced, "save_state") then
		pdata.register("varefined_random_long_cd", { prime = { "agdd_voiced_actor" } })
		n = n + 1
	end
	if n > 0 then installed[#installed + 1] = "prefs(" .. n .. " keys)" end
end

local function wheel_index(value, first, last)
	return type(value) == "number" and value >= first and value <= last and value == math.floor(value)
end

local function wheel_entry(classes, entry)
	if type(entry) ~= "table" or type(entry.class) ~= "string" or type(entry.section) ~= "string"
		or type(entry.args) ~= "table" or entry.args[1] ~= entry.section then return end
	local kind, id = entry.class, entry.id
	local class = classes[kind]
	if not class or (id ~= nil and not wheel_index(id, 0, 65534)) then return end

	-- The wheel later unpacks these args into constructors and engine calls.
	local args = { entry.section }
	if class.is_obj then
		local arg_id = entry.args[2]
		if not wheel_index(arg_id, 0, 65534) or (id ~= nil and id ~= arg_id) then return end
		id, args[2] = arg_id, arg_id
	end
	if kind == "QEquipWheelOption" then
		local slot = entry.args[3]
		-- Stock SCANNED_SLOTS spans 1..13; QEquip does not handle grenades.
		if not wheel_index(slot, 1, 13) or slot == 4 then return end
		args[3] = slot
	elseif kind == "QGrenadeWheelOption" or kind == "QDetectorWheelOption" then
		local slot = kind == "QGrenadeWheelOption" and 4 or 9
		if entry.args[2] ~= slot then return end
		args[2] = slot
	end
	return { class = kind, section = entry.section, id = id, args = args }, class.is_obj
end

local function wheel_load_data(manager, data)
	if type(data) ~= "table" or type(data.tabs) ~= "table" then return nil end
	local count, classes = manager.tab_count, manager.classes
	-- Nine is the wheel's MCM maximum. Use the local count so GUI tabs and layout agree.
	if not wheel_index(count, 1, 9) or type(classes) ~= "table" then return nil end
	local tabs = {}
	for i = 1, count do
		local source = data.tabs[i]
		local tab = { __sections = {}, __ids = {} }
		tabs[i] = tab
		if type(source) == "table" then
			for _, data_entry in ipairs(source) do
				local entry, by_id = wheel_entry(classes, data_entry)
				if entry then
					local index, key = tab.__sections, entry.section
					if by_id then index, key = tab.__ids, entry.id end
					if not index[key] then
						index[key] = true
						tab[#tab + 1] = entry
					end
				end
			end
		end
	end
	local selected = data.current_tab
	if not wheel_index(selected, 1, count) or type(data.tabs[selected]) ~= "table" then selected = 1 end
	return { tabs = tabs, current_tab = selected }
end

local function install_pdata()
	local inspect = core.mod("grok_doom_weapons_inspect")
	if inspect then
		-- Its save_state is local: collect the live table directly. Otherwise every
		-- world load gives the client the host's history and repeats first-equip animations.
		pdata.register("inspected_weapons", { get = function() return inspect.inspected_weapons end })
		installed[#installed + 1] = "weapon_inspection"
	end
	if core.mod("experience_core") then
		pdata.register("experience_framework_savedata", { subs = EF_SUBS, prime = { "experience_core" } })
		installed[#installed + 1] = "experience_framework"
	end
	local wheel = core.mod("haru_quick_action_wheel_mcm")
	if wheel then
		pdata.register("haru_qaw", { get = function()
			local tm = wheel.TAB_MANAGER -- created by the mod's later on_game_start
			if tm then return { tabs = tm.tabs, current_tab = tm.current_tab } end
		end })
		-- The callback is registered on the instance; it looks the class method up at load.
		core.wrap(wheel.TabManager, "load_state", "misc.wheel_load", function(orig) return function(tm, m, ...)
			if core.active() and coop_mode.is_player_mirror() and m.haru_qaw ~= nil then
				m.haru_qaw = wheel_load_data(tm, m.haru_qaw)
			end
			return orig(tm, m, ...)
		end end)
		installed[#installed + 1] = "quick_action_wheel"
	end
	if core.mod("ish_kill_tracker") then
		local n = pdata.register_module("ish_kill_tracker")
		installed[#installed + 1] = "kill_tracker(" .. n .. " keys)"
	end
	local npe = core.mod("npe_director")
	if npe and core.fn(npe, "get_state") then
		-- its save_state writes a line and the whole table to the log each time: the state is asked for directly
		pdata.register("npe", { get = function() return { npe_state = npe.get_state() } end })
		installed[#installed + 1] = "tutorials"
	end
	if core.mod("game_fast_travel") then
		pdata.register("fast_travel_system", { subs = FFT_SUBS, prime = { "game_fast_travel" } })
		installed[#installed + 1] = "fast_travel"
	end
	install_prefs()
end

-- Wheel entries that name an item by id: the item must be in this player's own inventory.
local function qaw_drop_lost_entries()
	if not core.is_client() then return end
	local qaw = alife_storage_manager.get_state().haru_qaw
	local mcm = core.mod("haru_quick_action_wheel_mcm")
	local tm = mcm and mcm.TAB_MANAGER
	if type(qaw) ~= "table" or type(qaw.tabs) ~= "table" or not (tm and type(tm.classes) == "table") then return end
	local dropped = 0
	for _, tab in pairs(qaw.tabs) do
		if type(tab) == "table" then
			for i = #tab, 1, -1 do
				local e = tab[i]
				local cls = type(e) == "table" and tm.classes[e.class]
				if type(cls) == "table" and cls.is_obj then
					local se = type(e.id) == "number" and e.id < 65535 and alife_object(e.id)
					if not (se and se.parent_id == 0 and se:section_name() == e.section) then
						if type(tab.__ids) == "table" and e.id then tab.__ids[e.id] = nil end
						table.remove(tab, i)
						dropped = dropped + 1
					end
				end
			end
		end
	end
	if dropped > 0 then log("qaw", "%d wheel entr(ies) dropped: their item is not in this inventory", dropped) end
end

local function install_kill_tracker()
	local ikt = core.mod("ish_kill_tracker")
	core.wrap(ikt, "safename", "ish_kill_tracker.safename", function(orig)
		return function(obj, ...)
			if core.active() and obj then
				local ok, id = pcall(function() return obj:id() end)
				if ok and core.is_remote_player(id) then
					local nick = core.nick_of(core.peer_of(id))
					if nick and nick ~= "" then return nick end
				end
			end
			return orig(obj, ...)
		end
	end)
end

-------------------------------------------------------------------------------
-- Guitar / harmonica: the song is heard at the player's character everywhere
-------------------------------------------------------------------------------
-- Provenance: installed GAMMA 382 Guitar Animation - Daiviey guitar_anim/harmonica_anim;
-- draw -> play -> holster_guitar -> restore, including harmonica's original holster_guitar spelling.
-- NPC world poses/attachments are the engine's original NPC assets, not HUD meshes or another co-op's code.
local function native_instrument(kind, phase, track, length)
	if not core.active() then return false end
	local ok, accepted = pcall(api.instrument, kind, phase, track or 0, length or 0)
	return ok and accepted == true
end

local function announcing(kind)
	return function(orig) return function(...)
		if not core.active() then return orig(...) end
		local real = _G.sound_object
		local native, fallback_play
		local proxy = setmetatable({}, {
			__call = function(_, name, ...)
				local s = real(name, ...)
				local prefix = kind == 1 and "^music\\guitar_(%d+)$" or "^music\\harmonica_(%d+)$"
				local n = type(name) == "string" and tonumber(name:match(prefix))
				if s and n and n >= 1 and n <= (kind == 1 and 28 or 5) then
					local function play(method, ...)
						local ok, length = pcall(function() return s:length() end)
						if ok and type(length) == "number" and length > 0 and length <= 600000 and
							native_instrument(kind, 2, n, math.floor(length)) then
							local args = core.pack(...)
							fallback_play = function() return s[method](s, unpack(args, 1, args.n)) end
							native = true
							return
						end
						return s[method](s, ...)
					end
					return setmetatable({
						play = function(_, ...) return play("play", ...) end,
						play_no_feedback = function(_, ...) return play("play_no_feedback", ...) end,
						play_at_pos = function(_, ...) return play("play_at_pos", ...) end,
					}, { __index = function(_, k)
						local value = s[k]
						if type(value) == "function" then return function(_, ...) return value(s, ...) end end
						return value
					end })
				end
				return s
			end,
			__index = function(_, k) return real[k] end,
		})
		_G.sound_object = proxy
		local res = core.pack(pcall(orig, ...))
		_G.sound_object = real
		if not res[1] then
			if native then
				native_instrument(kind, 0)
				if fallback_play then pcall(fallback_play) end
			end
			error(res[2], 0)
		end
		return unpack(res, 2, res.n)
	end end
end

local guitar_done = false
local function install_guitar()
	if guitar_done or not api then return end
	guitar_done = true
	for _, spec in ipairs({ { "guitar_anim", "guitar", 1 }, { "harmonica_anim", "harmonica", 2 } }) do
		local mod, name, kind = core.mod(spec[1]), spec[2], spec[3]
		core.wrap(mod, "play_" .. name, spec[1] .. ".play", announcing(kind))
		for _, action in ipairs({ { "draw_" .. name, 1 }, { "holster_guitar", 3 }, { "restore", 0 } }) do
			local phase = action[2]
			core.wrap(mod, action[1], spec[1] .. "." .. action[1], function(orig)
				return function(...)
					native_instrument(kind, phase)
					return orig(...)
				end
			end)
		end
	end
end

-------------------------------------------------------------------------------
-- Immersive Sleep: the group's most tired player decides
-------------------------------------------------------------------------------
local QUANT = 100
local SLEEP_TICK_MS = 5000
local sleep = { peers = {}, party = 0, sent = nil, pushed = nil, next_tick = 0 }

local function own_sleepiness()
	local ok, v = pcall(actor_status_sleep.get_last_sleep)
	return ok and type(v) == "number" and v or 0
end

local function quant(v) return math.floor(v / QUANT) * QUANT end

local function host_party_max()
	local m = own_sleepiness()
	local online = {}
	for _, p in ipairs(core.players()) do online[p.id] = true end
	for peer, v in pairs(sleep.peers) do
		if not online[peer] then sleep.peers[peer] = nil elseif v > m then m = v end
	end
	return m
end

local function party_view()
	if core.active() and coop_mode.decides_world() then return host_party_max() end
	return math.max(own_sleepiness(), sleep.party)
end

-- Scoped: other readers of get_last_sleep (stat bars) never see the group's value.
local function with_sleepiness(value, f, ...)
	local m = actor_status_sleep
	local cur = m.get_last_sleep
	m.get_last_sleep = function() return value end
	local ok, e = pcall(f, ...)
	m.get_last_sleep = cur
	if not ok then core.report("sleep", "sleep dialog", e) end
end

local function sleep_tick()
	local tg = time_global()
	if tg < sleep.next_tick then return end
	sleep.next_tick = tg + SLEEP_TICK_MS
	if core.active() and coop_mode.decides_world() then
		local q = quant(host_party_max())
		if q ~= sleep.pushed then
			sleep.pushed = q
			core.to_all("sleepy_max", { v = q })
		end
	elseif core.live_client() then
		local q = quant(own_sleepiness())
		if q ~= sleep.sent then
			sleep.sent = q
			core.to_host("sleepy", { v = q })
		end
	end
end

-- For coop_economy_group: a sleep approved by the group vote runs after the dialog's own call (and this
-- wrapper's scope) ended; it runs f inside the same group-sleepiness scope.
function with_party_sleepiness(f, ...)
	if not (sleep.on and core.active()) then return f(...) end
	return with_sleepiness(party_view(), f, ...)
end

local function install_sleep()
	local dlg, ass = core.mod("ui_sleep_dialog"), core.mod("actor_status_sleep")
	if not (dlg and core.fn(dlg, "get_immersive_sleep_hours") and ass and core.fn(ass, "get_last_sleep")) then return end
	local cls = dlg.UISleep
	if not cls then return end
	core.wrap(cls, "TestAndShow", "ui_sleep_dialog.UISleep.TestAndShow", function(orig)
		return function(self, ...)
			if not core.active() then return orig(self, ...) end
			with_sleepiness(party_view(), orig, self, ...)
		end
	end)
	core.wrap(cls, "OnButtonSleep", "ui_sleep_dialog.UISleep.OnButtonSleep", function(orig)
		return function(self, ...)
			if not core.active() then return orig(self, ...) end
			with_sleepiness(party_view(), orig, self, ...)
		end
	end)
	core.on("sleepy", function(t, from)
		local v = tonumber(t.v)
		if v then sleep.peers[from] = math.max(0, math.min(10000, v)) end
	end, "world")
	core.on("sleepy_max", function(t)
		local v = tonumber(t.v)
		if v then sleep.party = math.max(0, math.min(10000, v)) end
	end, "client")
	RegisterScriptCallback("actor_on_update", sleep_tick)
	sleep.on = true
	installed[#installed + 1] = "immersive_sleep"
end

-------------------------------------------------------------------------------
-- Zone Customization Project: loot rolled by the box or corpse writer
-------------------------------------------------------------------------------
local function install_zcp()
	local smr = core.mod("smr_loot")
	if not smr then return end
	local function enabled()
		local get_config = core.fn(core.mod("smr_amain_mcm"), "get_config")
		return not get_config or get_config("smr_enabled")
	end
	local function writer_roll(orig)
		return function(box, ...)
			if core.active() then
				if not (box and type(box.id) == "function" and coop_mode.writes(box:id())) then return end
				if not enabled() then return end
			end
			return orig(box, ...)
		end
	end
	local ok = core.wrap(smr, "try_spawn", "smr_loot.try_spawn", writer_roll)
	core.wrap(smr, "try_spawn_mag", "smr_loot.try_spawn_mag", writer_roll)

	-- Stock registers this callback from its host-routed first update. Keep its single-player registration
	-- and run the same roll on the corpse writer in a session, including a map server.
	local death, holder, index = core.find_local(smr, "npc_on_death_callback")
	local loot_config = core.fn(core.mod("smr_loot_mcm"), "get_config")
	if holder and type(death) == "function" and loot_config then
		debug.setupvalue(holder, index, function(...)
			if not core.active() then return death(...) end
		end)
		RegisterScriptCallback("npc_on_death_callback", function(npc, ...)
			if core.active() and npc and coop_mode.writes(npc:id()) and enabled() and loot_config("npc_spawn") then
				return death(npc, ...)
			end
		end)
	end

	if ok then
		-- A client's container: rolled with that player's character as the actor (magazines for its guns).
		core.listen("container_opened", function(peer, id)
			local box = level.object_by_id(id)
			local who = core.avatar(peer)
			if core.active() and box and who and coop_mode.writes(id) and enabled() then
				local done, e = core.as_player(who, smr.try_spawn, box)
				if not done then core.report("zcp", "roll for a client", e) end
			end
		end)
	end
	installed[#installed + 1] = "zcp"
end

-------------------------------------------------------------------------------
-- Personal Adjustable Waypoint
-------------------------------------------------------------------------------
local function install_paw()
	if not core.mod("tasks_placeable_waypoints") then return end
	-- Personal task: given, checked and finished on this machine only (quests group, coop_tasks).
	local ct = core.mod("coop_tasks")
	local ok = ct and type(ct.set_local_task) == "function" and ct.set_local_task("task_placeable_waypoint")
	if not ok then log("paw", "the waypoint task could not be made personal: it is handled like a group task") end
	local r = core.mod("ui_paw_reticle")
	core.wrap(r and r.UIPAWReticle, "GetTargetName", "ui_paw_reticle.UIPAWReticle.GetTargetName", function(orig)
		return function(self, obj, ...)
			if core.active() and obj then
				local ok, id = pcall(function() return obj:id() end)
				if ok and core.is_remote_player(id) then
					local nick = core.nick_of(core.peer_of(id))
					if nick and nick ~= "" then return nick end
				end
			end
			return orig(self, obj, ...)
		end
	end)
	installed[#installed + 1] = "paw"
end

-------------------------------------------------------------------------------
-- Body Health System: revive
-------------------------------------------------------------------------------
local PARTS = { "head", "torso", "leftarm", "rightarm", "leftleg", "rightleg" }

local function bhs_tables(b)
	return b and type(b.health) == "table" and type(b.maxhp) == "table" and type(b.timedhp) == "table"
end

-- What the mod's own load reads back.
local function bhs_save(b)
	if not (utils_obj and utils_obj.save_var) then return end
	for _, k in ipairs(PARTS) do
		pcall(utils_obj.save_var, db.actor, "health." .. k, b.health[k])
		pcall(utils_obj.save_var, db.actor, "timedhp." .. k, b.timedhp[k])
	end
end

-- What a concussion left behind when the player fell: the volume, its two effectors, the head's last value.
local function bhs_clear_concussion(b)
	local head = core.find_local(b, "head_tbl")
	if type(head) ~= "table" then return end
	head.previous, head.stage = nil, 0
	if head.volume then exec_console_cmd("snd_volume_eff " .. tostring(head.volume)) end
	level.remove_pp_effector(99123)
	level.remove_pp_effector(99133)
end

local function bhs_on_revived(reviver, section)
	local b = core.mod("zzz_player_injuries")
	if not (bhs_tables(b) and db.actor) then return end
	bhs_clear_concussion(b)
	-- The mod keeps the player down while head or torso is at zero.
	if (b.health.head or 0) <= 0 then b.health.head = 1 end
	if (b.health.torso or 0) <= 0 then b.health.torso = 1 end
	local kit = type(b.medkits) == "table" and type(section) == "string" and b.medkits[section]
	if type(kit) == "table" then
		for _, k in ipairs(PARTS) do
			local bonus = tonumber(kit[k])
			local hp, max = tonumber(b.health[k]), tonumber(b.maxhp[k])
			if bonus and hp and max then
				local add = math.max(0, math.min(bonus, max - hp))
				b.health[k] = hp + add
				b.timedhp[k] = (tonumber(b.timedhp[k]) or 0) + add
			end
		end
		b.medkits.lastregen = time_global()
		b.medkits.timedhealth = kit.timeregen
	end
	bhs_save(b)
	log("bhs", "revived (%s): head %s, torso %s", tostring(section), tostring(b.health.head), tostring(b.health.torso))
end

-- The body parts are each player's own (otherwise a GAMMA client breaks a leg at a level change). The mod keeps them in
-- the actor's pstor ("health.<part>", "timedhp.<part>", utils_obj.save_var), and the pstor comes with the host's save: a client
-- would get the HOST's parts at every load. A client's own parts are per-player data (coop_mods_pdata, BHS_KEY: the host keeps them
-- in its save, the session stash carries them over a level change; a change is reported within BHS_TICK_MS). At the actor's
-- first update, before the mod's own load (its first actor_on_update: LoadHealthStatus), they go into the mod and into the
-- pstor; a player the host has no record of starts whole. The host and single player keep the mod's own pstor.
-- The drain diagnostic (below, install_respawn) names the last co-op apply that touched the player's state.
local DRAIN_MS, DRAIN_MIN = 15000, 0.005
local drain = { start = nil, health = nil, hits = 0, lines = 0, apply = "none", apply_at = nil }

local function note_apply(what)
	drain.apply, drain.apply_at = what, time_global()
end

local BHS_KEY = "coop_bhs_parts"
local BHS_TICK_MS = 1000
local bhs_st = { pending = false, own = nil, last = nil, next = 0, applied = 0, reports = 0 }

local function bhs_snapshot()
	local b = core.mod("zzz_player_injuries")
	if not bhs_tables(b) then return nil end
	local h, t = {}, {}
	for _, k in ipairs(PARTS) do
		h[k] = tonumber(b.health[k])
		t[k] = tonumber(b.timedhp[k])
	end
	return { h = h, t = t }
end

-- Order-stable text of the parts (what tells a change).
local function bhs_text(s)
	if type(s) ~= "table" then return "" end
	local out = {}
	for _, k in ipairs(PARTS) do
		out[#out + 1] = tostring(s.h and s.h[k]) .. "/" .. tostring(s.t and s.t[k])
	end
	return table.concat(out, " ")
end

local function bhs_clamp(v, lo, hi, default)
	v = tonumber(v)
	if v == nil or v ~= v then return default end
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

-- load_state: what coop_mods_pdata restored for this player (nil: none), applied at the actor's first update.
local function bhs_on_load(m)
	bhs_st.pending = true
	local own = type(m) == "table" and m[BHS_KEY] or nil
	bhs_st.own = type(own) == "table" and own or nil
end

local function bhs_apply_own()
	if not bhs_st.pending then return end
	bhs_st.pending = false
	if not core.is_client() then return end
	local b = core.mod("zzz_player_injuries")
	if not (bhs_tables(b) and db.actor) then return end
	local own = bhs_st.own
	local h = own and type(own.h) == "table" and own.h or {}
	local t = own and type(own.t) == "table" and own.t or {}
	for _, k in ipairs(PARTS) do
		local max = tonumber(b.maxhp[k]) or 0
		local hp = bhs_clamp(h[k], 0, max, max)
		b.health[k] = hp
		b.timedhp[k] = bhs_clamp(t[k], 0, hp, 0)
	end
	bhs_save(b)
	bhs_st.last = bhs_text(bhs_snapshot())
	bhs_st.applied = bhs_st.applied + 1
	note_apply(own and "the world load: my BHS record" or "the world load: no BHS record, whole")
	log("bhs", "my body parts (%s): head %s, torso %s, arms %s/%s, legs %s/%s", own and "mine" or "no record: whole",
		tostring(b.health.head), tostring(b.health.torso), tostring(b.health.leftarm), tostring(b.health.rightarm),
		tostring(b.health.leftleg), tostring(b.health.rightleg))
end

local function bhs_tick()
	if bhs_st.pending or not core.live_client() then return end
	local now = time_global()
	if now < bhs_st.next then return end
	bhs_st.next = now + BHS_TICK_MS
	local text = bhs_text(bhs_snapshot())
	if text == "" or text == bhs_st.last then return end
	bhs_st.last = text
	local ok, e = pcall(pdata.report_now)
	if not ok then core.report("bhs", "report_now", e) end
	bhs_st.reports = bhs_st.reports + 1
end

-------------------------------------------------------------------------------
-- A co-op respawn is a fresh body
-------------------------------------------------------------------------------
-- The engine's respawn knows only its own condition (health, wounds, radiation). The stock never respawns, so the mods never
-- reset what killed the player: with a head or a torso still at zero BHS sets health to -1 on its next update, with
-- arszi_psy's psy health at or below 0.001 that mod sets it to 0 every in-game second (a player killed by psi would stand up
-- at his respawn point with the head and torso red and die again and again). Every respawn
-- (coop_mods_core "actor_respawned": a camp, a hardcore run's new character) gives them back, as G.A.M.M.A.'s own Soulslike
-- respawn does (soulslike_scenarios HealActor: psy 1), and at once into the per-player records: a level change right after
-- must not bring the dead values back. A teammate's revive is not a respawn: the damage stays (bhs_on_revived lifts only
-- head and torso off zero, coop_npc_effects lifts only a lethal psy health).
local fresh = { count = 0 }

local function bhs_fresh()
	local b = core.mod("zzz_player_injuries")
	if not (bhs_tables(b) and db.actor) then return end
	for _, k in ipairs(PARTS) do
		b.health[k] = b.maxhp[k]
		b.timedhp[k] = 0
	end
	bhs_clear_concussion(b)
	bhs_save(b)
	-- The respawn came before the first update of a new world: the record that load brought is from before the death.
	if bhs_st.pending then bhs_st.own = nil end
	bhs_st.last = bhs_text(bhs_snapshot())
	if core.live_client() then
		local ok, e = pcall(pdata.report_now)
		if not ok then core.report("bhs", "report_now", e) end
	end
end

local function psy_fresh()
	local ap = core.mod("arszi_psy")
	if not (ap and core.fn(ap, "set_psy_health")) then return end
	ap.set_psy_health(1)
	if core.fn(ap, "on_game_load") then pcall(ap.on_game_load) end -- its stage and death-scene counter
	if core.fn(ap, "remove_all_psy_ppe_effects") then pcall(ap.remove_all_psy_ppe_effects) end
	-- the psy table is a per-player key of coop_economy_mdata (polled every 15 s): to the host now
	local em = rawget(_G, "coop_economy_mdata")
	if core.live_client() and em and type(em.send_player_keys) == "function" then pcall(em.send_player_keys) end
end

local function radiation_fresh()
	local r = core.mod("grok_progressive_rad_damages")
	if not r then return end
	-- The engine clears the dose, but GAMMA leaves grok_rads at 1 until another
	-- radiation cough roll. BHS reads it to skip injury damage, even with zero dose.
	r.grok_rads, r.coughing, r.coughing_time, r.tg = 0, false, 0, nil
	-- This mod picks one of these IDs for its cough blur. Do not remove the
	-- separate coop contusion: its stamina penalty is part of respawning.
	for id = 645808, 645820 do pcall(level.remove_pp_effector, id) end
end

local function vitals_text()
	local a = db.actor
	local function field(name)
		local ok, v = pcall(function() return a[name] end)
		v = ok and tonumber(v) or nil
		return v and string.format("%.3f", v) or "?"
	end
	local ap = core.mod("arszi_psy")
	local ok_psy, psy = pcall(function() return ap and ap.get_psy_health and ap.get_psy_health() end)
	local b = core.mod("zzz_player_injuries")
	local parts = bhs_tables(b) and string.format("%s/%s", tostring(b.health.head), tostring(b.health.torso)) or "-"
	return string.format("health %s, psy %s (arszi %s), radiation %s, bleeding %s, head/torso %s", field("health"),
		field("psy_health"), ok_psy and type(psy) == "number" and string.format("%.3f", psy) or "-", field("radiation"),
		field("bleeding"), parts)
end

local function on_respawned_fresh()
	if not db.actor then return end
	local before = vitals_text()
	local ok, e = pcall(bhs_fresh)
	if not ok then core.report("respawn", "bhs", e) end
	ok, e = pcall(psy_fresh)
	if not ok then core.report("respawn", "psy", e) end
	ok, e = pcall(radiation_fresh)
	if not ok then core.report("respawn", "radiation", e) end
	fresh.count = fresh.count + 1
	note_apply("respawn: a fresh body")
	log("respawn", "fresh body: before %s | after %s", before, vitals_text())
end

-------------------------------------------------------------------------------
-- Diagnostic: a client's health falling with nothing hitting him
-------------------------------------------------------------------------------
-- A G.A.M.M.A. client's health can run down after a level change with no hit (Yadulin outpaces it while it acts).
-- Until the source is proven, one line per DRAIN_MS while his health fell at least DRAIN_MIN with no hit in that time: what
-- G.A.M.M.A. drains health from (thirst above 4000, satiety, radiation, bleeding, psy, the BHS head and torso) and the last co-op
-- apply that touched his state. Every player in a session, the host's too (it may start when a player dies),
-- with each player's life (alive / wounded / dead ...) at that moment.
local function players_life()
	local out = {}
	local ok, list = pcall(function() return core.players() end)
	if not (ok and type(list) == "table") then return "-" end
	for _, p in ipairs(list) do
		local life = "?"
		if api and api.life_of and p.id ~= nil then
			local okl, l = pcall(api.life_of, p.id)
			if okl and l ~= nil then life = tostring(l) end
		end
		out[#out + 1] = string.format("%s %s", tostring(p.nick or p.id), life)
	end
	return #out > 0 and table.concat(out, ", ") or "-"
end

-- What he wears changes his health every second with nothing on the screen: CActor::UpdateArtefactsOnBeltAndOutfit gives
-- health_restore_speed * condition of every artefact of the belt, and health_restore_speed of the outfit and of the helmet.
-- Such a loss shows in the engine's ledger as "condition", with no hit, no script, no radiation and no bleeding. The line names every worn item with its value and what they add up to in the window.
local function worn_text()
	local a = db.actor
	local sum = 0
	local function one(o, by_condition)
		local ok, sec = pcall(function() return o:section() end)
		if not (ok and type(sec) == "string") then return nil end
		local okc, cond = pcall(function() return o:condition() end)
		cond = okc and tonumber(cond) or 1
		local okv, v = pcall(function() return ini_sys:r_float_ex(sec, "health_restore_speed") end)
		v = okv and tonumber(v) or 0
		sum = sum + v * (by_condition and cond or 1)
		return string.format("%s %s x%.2f", sec, v == 0 and "0" or string.format("%.5f", v), cond)
	end
	local belt = {}
	pcall(function()
		a:iterate_belt(function(_, o)
			local s = one(o, true)
			if s then belt[#belt + 1] = s end
		end, a)
	end)
	local function slot(n)
		local ok, o = pcall(function() return a:item_in_slot(n) end)
		return ok and o and one(o, false) or "-"
	end
	local outfit, helmet = slot(7), slot(12)
	return string.format("belt %s, outfit %s, helmet %s; worn items give %.3f in %d s", #belt > 0 and table.concat(belt, ", ") or "-",
		outfit, helmet, sum * DRAIN_MS / 1000, DRAIN_MS / 1000)
end

local function drain_line(fell)
	local a = db.actor
	local function num(v)
		v = tonumber(v)
		return v and string.format("%.3f", v) or "-"
	end
	local function field(name)
		local ok, v = pcall(function() return a[name] end)
		return num(ok and v or nil)
	end
	local function call(modname, f)
		local m = core.mod(modname)
		if not (m and core.fn(m, f)) then return "-" end
		local ok, v = pcall(m[f])
		return ok and v ~= nil and tostring(v) or "-"
	end
	local b = core.mod("zzz_player_injuries")
	-- every part: BHS takes 0.029 health on a sprint step (13 %, once per 2.5 s) while a leg is at 3 HP or less, with no hit
	local parts = "-"
	if bhs_tables(b) then
		local out = {}
		for _, k in ipairs({ "head", "torso", "leftleg", "rightleg", "leftarm", "rightarm" }) do
			out[#out + 1] = string.format("%s %s/%s", k, tostring(b.health[k]), tostring(b.timedhp[k]))
		end
		parts = table.concat(out, ", ")
	end
	local sprint = "-"
	local ims = rawget(_G, "IsMoveState")
	if type(ims) == "function" then
		local ok_s, s = pcall(ims, "mcSprint")
		if ok_s then sprint = s and "yes" or "no" end
	end
	-- db.actor.satiety is the base condition's (1.000 always); the actor's own is CActorCondition::GetSatiety
	local satiety = field("satiety")
	local ok_sat, sat = pcall(function() return a:cast_Actor():conditions():GetSatiety() end)
	if ok_sat and type(sat) == "number" then satiety = string.format("%.3f", sat) end
	local ap = core.mod("arszi_psy")
	local ok_psy, psy = pcall(function() return ap and ap.get_psy_health and ap.get_psy_health() end)
	drain.lines = drain.lines + 1
	log("drain", "health %s fell %.3f in %d s with no hit: psy %s (arszi %s), BHS hp/timed %s, sprint %s, satiety %s, thirst %s, "
		.. "sleepiness %s, radiation %s, bleeding %s; %s; players: %s; last co-op apply: %s%s", field("health"), fell, DRAIN_MS / 1000,
		field("psy_health"), ok_psy and type(psy) == "number" and string.format("%.3f", psy) or "-", parts, sprint, satiety,
		call("actor_status_thirst", "get_last_drink"), call("actor_status_sleep", "get_last_sleep"), field("radiation"),
		field("bleeding"), worn_text(), players_life(), drain.apply, drain.apply_at and string.format(" %d s ago", math.floor((time_global() - drain.apply_at) / 1000)) or "")
end

local function drain_on_hit()
	drain.hits = drain.hits + 1
end

local function drain_tick()
	if not (db.actor and core.active()) then return end
	local now = time_global()
	local ok, h = pcall(function() return tonumber(db.actor.health) end)
	if not (ok and h) then return end
	if not drain.start then
		drain.start, drain.health, drain.hits = now, h, 0
		return
	end
	if now - drain.start < DRAIN_MS then return end
	local fell = drain.health - h
	if fell >= DRAIN_MIN and drain.hits == 0 then drain_line(fell) end
	drain.start, drain.health, drain.hits = now, h, 0
end

local function install_respawn()
	core.listen("actor_respawned", on_respawned_fresh) -- always: its log line says what a respawn stood up with
	RegisterScriptCallback("actor_on_update", drain_tick)
	RegisterScriptCallback("actor_on_hit_callback", drain_on_hit)
	-- G.A.M.M.A.'s damage balancer (grok_actor_damage_balancer.shit_booster) takes every hit in actor_on_before_hit, sets its power to 0 and
	-- lowers the health itself (set_health_ex), so actor_on_hit_callback does not count it; actor_on_before_hit runs for every hit
	RegisterScriptCallback("actor_on_before_hit", drain_on_hit)
	if bhs_tables(core.mod("zzz_player_injuries")) or core.mod("arszi_psy") then installed[#installed + 1] = "respawn" end
end

-- test hook (tests/lua/test_mods_respawn.lua): how many fresh-body resets ran
function _fresh_count() return fresh.count end

local function install_bhs()
	local b = core.mod("zzz_player_injuries")
	if not bhs_tables(b) then return end
	pdata.register("head_tbl", { prime = { "zzz_player_injuries" } })
	pdata.register(BHS_KEY, { get = bhs_snapshot })
	RegisterScriptCallback("load_state", bhs_on_load)
	RegisterScriptCallback("actor_on_first_update", bhs_apply_own)
	RegisterScriptCallback("actor_on_update", bhs_tick)
	local concussion = b.bhs_concussion
	if type(concussion) == "function" then
		b.bhs_concussion = function(...)
			if not coop_npc_players.standing(0) then return end
			return concussion(...)
		end
	end
	core.listen("actor_revived", bhs_on_revived)
	installed[#installed + 1] = "bhs"
end

-------------------------------------------------------------------------------
-- Grok's actor damage balancer
-------------------------------------------------------------------------------
local function weapon_of_hit(shit)
	local w = level.object_by_id(shit.weapon_id)
	if w and IsWeapon(w) then return w end
	local who = shit.draftsman
	local ok, item = pcall(function() return who and who:active_item() end)
	if ok and item and IsWeapon(item) then
		shit.weapon_id = item:id()
		return item
	end
	return nil
end

local function install_adb()
	local m = core.mod("grok_actor_damage_balancer")
	local before, booster = m and m.actor_on_before_hit, m and m.shit_booster
	if type(before) ~= "function" or type(booster) ~= "function" then return end
	local wrapped = function(shit, bone_id, flags)
		if not coop_npc_players.active() then return before(shit, bone_id, flags) end
		local bullet = shit.type == hit.fire_wound
		local weapon = bullet and weapon_of_hit(shit)
		local who = shit.draftsman
		if who and coop_npc_players.is_proxy(who:id()) then
			log("adb", "a player's hit: bone %s, type %s, power %.3f, weapon %s", tostring(bone_id), tostring(shit.type), shit.power,
				weapon and weapon:section() or "none")
		end
		before(shit, bone_id, flags)
		if bullet and shit.power > 0 then booster(shit, bone_id, 0) end -- it stopped at the weapon or its ammo
	end
	m.actor_on_before_hit = wrapped
	core.swap_callback("actor_on_before_hit", before, wrapped)
	installed[#installed + 1] = "damage_balancer"
end

-------------------------------------------------------------------------------
-- AGDD Voiced Actor: every line of the player's voice goes through actor_speak_base
-------------------------------------------------------------------------------
local function install_voiced()
	local v = core.mod("agdd_voiced_actor")
	local speak = v and v.actor_speak_base
	if type(speak) ~= "function" then return end
	v.actor_speak_base = function(...)
		if not coop_npc_players.standing(0) then return false end
		return speak(...)
	end
	installed[#installed + 1] = "voiced_actor"
end

-------------------------------------------------------------------------------
-- Oleh's Extended MovementSFX: other players' footsteps
-------------------------------------------------------------------------------
local STEP_DIR = "footstep\\n_"
local last_variant = {}

local function on_avatar_step(avatar_id, material, power, move_state)
	local fs = core.mod("footstep_sounds")
	local obj = type(avatar_id) == "number" and avatar_id ~= 0 and level.object_by_id(avatar_id)
	if not (fs and type(fs.available_materials) == "table" and obj) then return end
	local mat = fs.available_materials[material] or fs.available_materials["default"]
	if type(mat) ~= "string" or mat == "water_" then return end
	local last = last_variant[avatar_id]
	local n = math.random(last and 5 or 6)
	if last and n >= last then n = n + 1 end
	last_variant[avatar_id] = n
	local ok, snd = pcall(sound_object, STEP_DIR .. mat .. n)
	if ok and snd then
		pcall(function()
			snd:play_at_pos(obj, obj:position(), 0, sound_object.s3d)
			snd.volume = math.min(1, math.max(0.1, tonumber(power) or 0.5))
		end)
	end
end

local function install_oleh()
	if not (core.mod("footstep_sounds") and (core.mod("oleh_sound_utils") or core.mod("extended_movement_sounds")
		or core.mod("extended_movement_sounds_mcm"))) then return end
	core.listen("avatar_step", on_avatar_step)
	installed[#installed + 1] = "oleh_movement"
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
local function actor_on_first_update()
	if core.is_client() then
		local ok, e = pcall(qaw_drop_lost_entries)
		if not ok then core.report("qaw", "drop lost entries", e) end
	end
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included.
function on_game_start()
	if not api then return end
	core.install("misc", "install_pdata", install_pdata)
	core.install("misc", "install_kill_tracker", install_kill_tracker)
	core.install("misc", "install_guitar", install_guitar)
	if core.mod("guitar_anim") or core.mod("harmonica_anim") then installed[#installed + 1] = "guitar_anim" end
	core.install("misc", "install_sleep", install_sleep)
	core.install("misc", "install_zcp", install_zcp)
	core.install("misc", "install_paw", install_paw)
	core.install("misc", "install_bhs", install_bhs)
	core.install("misc", "install_respawn", install_respawn)
	core.install("misc", "install_adb", install_adb)
	core.install("misc", "install_voiced", install_voiced)
	core.install("misc", "install_oleh", install_oleh)
	if core.mod("haru_quick_action_wheel_mcm") then RegisterScriptCallback("actor_on_first_update", actor_on_first_update) end
	core.status_line("misc", function()
		return "installed: " .. (#installed > 0 and table.concat(installed, ", ") or "none (mods absent)")
	end)
end

-- Load time (before any on_game_start): the song functions may be captured by other mods at their start.
if api then core.install("misc", "guitar patch", install_guitar) end
