--[[
	Anomaly Coop - small third-party mod patches (gamedata\scripts\coop_mods_misc.script), W4 "mods".

	Each patch installs only when its mod is present and does nothing outside a co-op session.

	Experience Framework (experience_core)     XP, skills, traits, own XP tasks, potion buff are per player
	                                           (coop_mods_pdata, sub-keys of experience_framework_savedata;
	                                           NPC levels nls_storage stay the host's).
	Wearable Devices (wd_core)                 not adapted (2026-10-29 clean room: its key list came only from another
	                                           co-op's patch, the mod is not in our GAMMA to derive it from).
	Quick Action Wheel (haru_qaw)              the layout is per player; entries whose item is not in this
	                                           player's inventory any more are dropped at the first update.
	Kill Tracker (ish_kill_tracker)            a player's character is named by the player's nick; the mod's
	                                           own records are per player (keys found from its save_state).
	Guitar / harmonica (guitar_anim, harmonica_anim)  original Daiviey HUD entry points feed bounded native
	                                           coop.instrument state; older engines retain event mods.song.
	Immersive Sleep (ui_sleep_dialog)          the tiredness veto judges the most tired player of the group
	                                           (mods.sleepy client -> host, mods.sleepy_max host -> all).
	Zone Customization Project (smr_loot)      bonus loot is rolled by the host only; a client's container is
	                                           rolled by the host when the engine reports its opening.
	Personal Adjustable Waypoint               the waypoint task is personal (coop_tasks.set_local_task, needs
	                                           coop.story_local_task in the engine); a player's character is
	                                           named by the nick.
	Body Health System (zzz_player_injuries)   after a co-op revive head/torso get back above zero and the medkit
	                                           heals the limbs (the mod's own heal never runs on a revive);
	                                           head_tbl and the body parts are per player (the parts live in the
	                                           actor's pstor, which comes with the host's save: live 2026-11-07). Its concussion waits until the player stands:
	                                           hits on a body turned the volume down and up again and again.
	Grok's actor damage balancer               the armour, the body part and the limb of Body Health System are its work,
	                                           and it leaves a bullet alone when the weapon of the hit is not on this
	                                           machine: the shooter's hands stand in, else the bullet is counted with
	                                           no armour piercing. Every hit by a player is in the log.
	AGDD Voiced Actor                          a player who is down or dead says nothing: grunts over the teammate he
	                                           watches (live 2026-11-01).
	Oleh's Extended MovementSFX                footsteps of other players' characters (when the engine reports
	                                           avatar steps through coop_mods_core.on_avatar_step).
--]]

local api = rawget(_G, "coop")

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local function C() return coop_mods_core end
local function P() return coop_mods_pdata end

local installed = {}

local function log(tag, fmt, ...) C().log(tag, fmt, ...) end

-------------------------------------------------------------------------------
-- Experience Framework, Quick Action Wheel, Kill Tracker: per-player keys
-------------------------------------------------------------------------------
local EF_SUBS = { "XP", "skills_savedata", "traits_savedata", "tasks_manager", "potion_xp_buff" }

local function install_pdata()
	if C().mod("experience_core") then
		P().register("experience_framework_savedata", { subs = EF_SUBS, prime = { "experience_core" } })
		installed[#installed + 1] = "experience_framework"
	end
	if C().mod("haru_quick_action_wheel_mcm") then
		P().register("haru_qaw", { prime = { "haru_quick_action_wheel_mcm" } })
		installed[#installed + 1] = "quick_action_wheel"
	end
	if C().mod("ish_kill_tracker") then
		local n = P().register_module("ish_kill_tracker")
		installed[#installed + 1] = "kill_tracker(" .. n .. " keys)"
	end
end

-- Wheel entries that name an item by id: the item must be in this player's own inventory.
local function qaw_drop_lost_entries()
	if not C().is_client() then return end
	local qaw = alife_storage_manager.get_state().haru_qaw
	local mcm = C().mod("haru_quick_action_wheel_mcm")
	local tm = mcm and mcm.TAB_MANAGER
	if type(qaw) ~= "table" or type(qaw.tabs) ~= "table" or not (tm and type(tm.classes) == "table") then return end
	local dropped = 0
	for _, tab in pairs(qaw.tabs) do
		if type(tab) == "table" then
			for i = #tab, 1, -1 do
				local e = tab[i]
				local cls = type(e) == "table" and tm.classes[e.class]
				if type(cls) == "table" and cls.is_obj then
					local se = type(e.id) == "number" and e.id < 65535 and alife_object(e.id)
					if not (se and se.parent_id == 0 and se:section_name() == e.section) then
						if type(tab.__ids) == "table" and e.id then tab.__ids[e.id] = nil end
						table.remove(tab, i)
						dropped = dropped + 1
					end
				end
			end
		end
	end
	if dropped > 0 then log("qaw", "%d wheel entr(ies) dropped: their item is not in this inventory", dropped) end
end

local function install_kill_tracker()
	local ikt = C().mod("ish_kill_tracker")
	C().wrap(ikt, "safename", "ish_kill_tracker.safename", function(orig)
		return function(obj, ...)
			if C().active() and obj then
				local ok, id = pcall(function() return obj:id() end)
				if ok and C().is_remote_player(id) then
					local nick = C().nick_of(C().peer_of(id))
					if nick and nick ~= "" then return nick end
				end
			end
			return orig(obj, ...)
		end
	end)
end

-------------------------------------------------------------------------------
-- Guitar / harmonica: the song is heard at the player's character everywhere
-------------------------------------------------------------------------------
local songs = {} -- peer -> sound object playing on this machine

-- Provenance: installed GAMMA 382 Guitar Animation - Daiviey guitar_anim/harmonica_anim;
-- draw -> play -> holster_guitar -> restore, including harmonica's original holster_guitar spelling.
-- NPC world poses/attachments are the engine's original NPC assets, not HUD meshes or another co-op's code.
local function native_instrument(kind, phase, track, length)
	if not (C().active() and api and type(api.instrument) == "function") then return false end
	local ok, accepted = pcall(api.instrument, kind, phase, track or 0, length or 0)
	return ok and accepted == true
end

local function announcing(kind)
	return function(orig) return function(...)
		if not C().active() then return orig(...) end
		local real = _G.sound_object
		local track, snd, native, fallback_play
		local function pack(...) return { n = select("#", ...), ... } end
		local proxy = setmetatable({}, {
			__call = function(_, name, ...)
				local s = real(name, ...)
				if track == nil then track, snd = name, s end
				local prefix = kind == 1 and "^music\\guitar_(%d+)$" or "^music\\harmonica_(%d+)$"
				local n = type(name) == "string" and tonumber(name:match(prefix))
				if s and n and n >= 1 and n <= (kind == 1 and 28 or 5) and type(api.instrument) == "function" then
					local function play(method, ...)
						local ok, length = pcall(function() return s:length() end)
						if ok and type(length) == "number" and length > 0 and length <= 600000 and
							native_instrument(kind, 2, n, math.floor(length)) then
							local args = pack(...)
							fallback_play = function() return s[method](s, unpack(args, 1, args.n)) end
							native = true
							return
						end
						return s[method](s, ...)
					end
					return setmetatable({
						play = function(_, ...) return play("play", ...) end,
						play_no_feedback = function(_, ...) return play("play_no_feedback", ...) end,
						play_at_pos = function(_, ...) return play("play_at_pos", ...) end,
					}, { __index = function(_, k)
						local value = s[k]
						if type(value) == "function" then return function(_, ...) return value(s, ...) end end
						return value
					end })
				end
				return s
			end,
			__index = function(_, k) return real[k] end,
		})
		_G.sound_object = proxy
		local res = pack(pcall(orig, ...))
		_G.sound_object = real
		if not res[1] then
			if native then
				native_instrument(kind, 0)
				if fallback_play then pcall(fallback_play) end
			end
			error(res[2], 0)
		end
		if not native and type(api.instrument) ~= "function" and type(track) == "string" and snd then
			local ok, len = pcall(function() return snd:length() end)
			C().to_all("song", { s = track, l = ok and tonumber(len) or 0 })
		end
		return unpack(res, 2, res.n)
	end end
end

local function on_song(t, from)
	if api and type(api.instrument) == "function" then return end -- protocol 15 owns its only source
	local track = t.s
	if type(track) ~= "string" or #track > 200 or track:find("..", 1, true) then return end
	local obj = C().avatar(from)
	if not obj or obj:id() == 0 then return end
	local old = songs[from]
	if old then pcall(function() old:stop() end) end
	local ok, snd = pcall(sound_object, track)
	if not (ok and snd) then return end
	pcall(function() snd:play_at_pos(obj, obj:position(), 0, sound_object.s3d) end)
	songs[from] = snd
end

local guitar_done = false
local function install_guitar()
	if guitar_done or not api then return end
	guitar_done = true
	for _, spec in ipairs({ { "guitar_anim", "guitar", 1 }, { "harmonica_anim", "harmonica", 2 } }) do
		local mod, name, kind = C().mod(spec[1]), spec[2], spec[3]
		C().wrap(mod, "play_" .. name, spec[1] .. ".play", announcing(kind))
		for _, action in ipairs({ { "draw_" .. name, 1 }, { "holster_guitar", 3 }, { "restore", 0 } }) do
			local phase = action[2]
			C().wrap(mod, action[1], spec[1] .. "." .. action[1], function(orig)
				return function(...)
					native_instrument(kind, phase)
					return orig(...)
				end
			end)
		end
	end
end

-------------------------------------------------------------------------------
-- Immersive Sleep: the group's most tired player decides
-------------------------------------------------------------------------------
local QUANT = 100
local SLEEP_TICK_MS = 5000
local sleep = { peers = {}, party = 0, sent = nil, pushed = nil, next_tick = 0 }

local function own_sleepiness()
	local ok, v = pcall(actor_status_sleep.get_last_sleep)
	return ok and type(v) == "number" and v or 0
end

local function quant(v) return math.floor(v / QUANT) * QUANT end

local function host_party_max()
	local m = own_sleepiness()
	local online = {}
	for _, p in ipairs(C().players()) do online[p.id] = true end
	for peer, v in pairs(sleep.peers) do
		if not online[peer] then sleep.peers[peer] = nil elseif v > m then m = v end
	end
	return m
end

local function party_view()
	if C().is_world_server() then return host_party_max() end
	return math.max(own_sleepiness(), sleep.party)
end

-- Scoped: other readers of get_last_sleep (stat bars) never see the group's value.
local function with_sleepiness(value, f, ...)
	local m = actor_status_sleep
	local cur = m.get_last_sleep
	m.get_last_sleep = function() return value end
	local ok, e = pcall(f, ...)
	m.get_last_sleep = cur
	if not ok then C().report("sleep", "sleep dialog", e) end
end

local function sleep_tick()
	local tg = time_global()
	if tg < sleep.next_tick then return end
	sleep.next_tick = tg + SLEEP_TICK_MS
	if C().is_world_server() then
		local q = quant(host_party_max())
		if q ~= sleep.pushed then
			sleep.pushed = q
			C().to_all("sleepy_max", { v = q })
		end
	elseif C().live_client() then
		local q = quant(own_sleepiness())
		if q ~= sleep.sent then
			sleep.sent = q
			C().to_host("sleepy", { v = q })
		end
	end
end

-- For coop_economy_group: a sleep approved by the group vote runs after the dialog's own call (and this
-- wrapper's scope) ended; it runs f inside the same group-sleepiness scope (W5).
function with_party_sleepiness(f, ...)
	if not (sleep.on and C().active()) then return f(...) end
	return with_sleepiness(party_view(), f, ...)
end

local function install_sleep()
	local dlg, ass = C().mod("ui_sleep_dialog"), C().mod("actor_status_sleep")
	if not (dlg and C().fn(dlg, "get_immersive_sleep_hours") and ass and C().fn(ass, "get_last_sleep")) then return end
	local cls = dlg.UISleep
	if not cls then return end
	C().wrap(cls, "TestAndShow", "ui_sleep_dialog.UISleep.TestAndShow", function(orig)
		return function(self, ...)
			if not C().active() then return orig(self, ...) end
			with_sleepiness(party_view(), orig, self, ...)
		end
	end)
	C().wrap(cls, "OnButtonSleep", "ui_sleep_dialog.UISleep.OnButtonSleep", function(orig)
		return function(self, ...)
			if not C().active() then return orig(self, ...) end
			with_sleepiness(party_view(), orig, self, ...)
		end
	end)
	C().on("sleepy", function(t, from)
		local v = tonumber(t.v)
		if v then sleep.peers[from] = math.max(0, math.min(10000, v)) end
	end, "world")
	C().on("sleepy_max", function(t)
		local v = tonumber(t.v)
		if v then sleep.party = math.max(0, math.min(10000, v)) end
	end, "client")
	RegisterScriptCallback("actor_on_update", sleep_tick)
	sleep.on = true
	installed[#installed + 1] = "immersive_sleep"
end

-------------------------------------------------------------------------------
-- Zone Customization Project: loot rolled by the host
-------------------------------------------------------------------------------
local function install_zcp()
	local smr = C().mod("smr_loot")
	if not smr then return end
	local ok, orig_spawn = C().wrap(smr, "try_spawn", "smr_loot.try_spawn", function(orig)
		return function(box, ...)
			if C().is_client() then return end -- the host rolls; its loot reaches clients as world items
			return orig(box, ...)
		end
	end)
	C().wrap(smr, "try_spawn_mag", "smr_loot.try_spawn_mag", function(orig)
		return function(box, ...)
			if C().is_client() then return end
			return orig(box, ...)
		end
	end)
	if ok then
		-- A client's container: rolled with that player's character as the actor (magazines for its guns).
		C().listen("container_opened", function(peer, id)
			local box = level.object_by_id(id)
			local who = C().avatar(peer)
			if box and who then
				local done, e = C().as_player(who, smr.try_spawn, box)
				if not done then C().report("zcp", "roll for a client", e) end
			end
		end)
	end
	installed[#installed + 1] = "zcp"
end

-------------------------------------------------------------------------------
-- Personal Adjustable Waypoint
-------------------------------------------------------------------------------
local function install_paw()
	if not C().mod("tasks_placeable_waypoints") then return end
	-- Personal task: given, checked and finished on this machine only (quests group, coop_tasks).
	local ct = C().mod("coop_tasks")
	local ok = ct and type(ct.set_local_task) == "function" and ct.set_local_task("task_placeable_waypoint")
	if not ok then log("paw", "the waypoint task could not be made personal: it is handled like a group task") end
	local r = C().mod("ui_paw_reticle")
	C().wrap(r and r.UIPAWReticle, "GetTargetName", "ui_paw_reticle.UIPAWReticle.GetTargetName", function(orig)
		return function(self, obj, ...)
			if C().active() and obj then
				local ok, id = pcall(function() return obj:id() end)
				if ok and C().is_remote_player(id) then
					local nick = C().nick_of(C().peer_of(id))
					if nick and nick ~= "" then return nick end
				end
			end
			return orig(self, obj, ...)
		end
	end)
	installed[#installed + 1] = "paw"
end

-------------------------------------------------------------------------------
-- Body Health System: revive
-------------------------------------------------------------------------------
local PARTS = { "head", "torso", "leftarm", "rightarm", "leftleg", "rightleg" }

local function bhs_tables(b)
	return b and type(b.health) == "table" and type(b.maxhp) == "table" and type(b.timedhp) == "table"
end

-- What the mod's own load reads back.
local function bhs_save(b)
	if not (utils_obj and utils_obj.save_var) then return end
	for _, k in ipairs(PARTS) do
		pcall(utils_obj.save_var, db.actor, "health." .. k, b.health[k])
		pcall(utils_obj.save_var, db.actor, "timedhp." .. k, b.timedhp[k])
	end
end

-- What a concussion left behind when the player fell: the volume, its two effectors, the head's last value.
local function bhs_clear_concussion(b)
	local head = C().find_local(b, "head_tbl")
	if type(head) ~= "table" then return end
	head.previous, head.stage = nil, 0
	if head.volume then exec_console_cmd("snd_volume_eff " .. tostring(head.volume)) end
	level.remove_pp_effector(99123)
	level.remove_pp_effector(99133)
end

local function bhs_on_revived(reviver, section)
	local b = C().mod("zzz_player_injuries")
	if not (bhs_tables(b) and db.actor) then return end
	bhs_clear_concussion(b)
	-- The mod keeps the player down while head or torso is at zero.
	if (b.health.head or 0) <= 0 then b.health.head = 1 end
	if (b.health.torso or 0) <= 0 then b.health.torso = 1 end
	local kit = type(b.medkits) == "table" and type(section) == "string" and b.medkits[section]
	if type(kit) == "table" then
		for _, k in ipairs(PARTS) do
			local bonus = tonumber(kit[k])
			local hp, max = tonumber(b.health[k]), tonumber(b.maxhp[k])
			if bonus and hp and max then
				local add = math.max(0, math.min(bonus, max - hp))
				b.health[k] = hp + add
				b.timedhp[k] = (tonumber(b.timedhp[k]) or 0) + add
			end
		end
		b.medkits.lastregen = time_global()
		b.medkits.timedhealth = kit.timeregen
	end
	bhs_save(b)
	log("bhs", "revived (%s): head %s, torso %s", tostring(section), tostring(b.health.head), tostring(b.health.torso))
end

-- The body parts are each player's own (live 2026-11-07: a GAMMA client broke a leg at a level change). The mod keeps them in
-- the actor's pstor ("health.<part>", "timedhp.<part>", utils_obj.save_var), and the pstor comes with the host's save: a client
-- got the HOST's parts at every load. A client's own parts are per-player data (coop_mods_pdata, BHS_KEY: the host keeps them
-- in its save, the session stash carries them over a level change; a change is reported within BHS_TICK_MS). At the actor's
-- first update, before the mod's own load (its first actor_on_update: LoadHealthStatus), they go into the mod and into the
-- pstor; a player the host has no record of starts whole. The host and single player keep the mod's own pstor.
-- The drain diagnostic (below, install_respawn) names the last co-op apply that touched the player's state.
local DRAIN_MS, DRAIN_MIN = 15000, 0.005
local drain = { start = nil, health = nil, hits = 0, lines = 0, apply = "none", apply_at = nil }

local function note_apply(what)
	drain.apply, drain.apply_at = what, time_global()
end

local BHS_KEY = "coop_bhs_parts"
local BHS_TICK_MS = 1000
local bhs_st = { pending = false, own = nil, last = nil, next = 0, applied = 0, reports = 0 }

local function bhs_snapshot()
	local b = C().mod("zzz_player_injuries")
	if not bhs_tables(b) then return nil end
	local h, t = {}, {}
	for _, k in ipairs(PARTS) do
		h[k] = tonumber(b.health[k])
		t[k] = tonumber(b.timedhp[k])
	end
	return { h = h, t = t }
end

-- Order-stable text of the parts (what tells a change).
local function bhs_text(s)
	if type(s) ~= "table" then return "" end
	local out = {}
	for _, k in ipairs(PARTS) do
		out[#out + 1] = tostring(s.h and s.h[k]) .. "/" .. tostring(s.t and s.t[k])
	end
	return table.concat(out, " ")
end

local function bhs_clamp(v, lo, hi, default)
	v = tonumber(v)
	if v == nil or v ~= v then return default end
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

-- load_state: what coop_mods_pdata restored for this player (nil: none), applied at the actor's first update.
local function bhs_on_load(m)
	bhs_st.pending = true
	local own = type(m) == "table" and m[BHS_KEY] or nil
	bhs_st.own = type(own) == "table" and own or nil
end

local function bhs_apply_own()
	if not bhs_st.pending then return end
	bhs_st.pending = false
	if not C().is_client() then return end
	local b = C().mod("zzz_player_injuries")
	if not (bhs_tables(b) and db.actor) then return end
	local own = bhs_st.own
	local h = own and type(own.h) == "table" and own.h or {}
	local t = own and type(own.t) == "table" and own.t or {}
	for _, k in ipairs(PARTS) do
		local max = tonumber(b.maxhp[k]) or 0
		local hp = bhs_clamp(h[k], 0, max, max)
		b.health[k] = hp
		b.timedhp[k] = bhs_clamp(t[k], 0, hp, 0)
	end
	bhs_save(b)
	bhs_st.last = bhs_text(bhs_snapshot())
	bhs_st.applied = bhs_st.applied + 1
	note_apply(own and "the world load: my BHS record" or "the world load: no BHS record, whole")
	log("bhs", "my body parts (%s): head %s, torso %s, arms %s/%s, legs %s/%s", own and "mine" or "no record: whole",
		tostring(b.health.head), tostring(b.health.torso), tostring(b.health.leftarm), tostring(b.health.rightarm),
		tostring(b.health.leftleg), tostring(b.health.rightleg))
end

local function bhs_tick()
	if bhs_st.pending or not C().live_client() then return end
	local now = time_global()
	if now < bhs_st.next then return end
	bhs_st.next = now + BHS_TICK_MS
	local text = bhs_text(bhs_snapshot())
	if text == "" or text == bhs_st.last then return end
	bhs_st.last = text
	local ok, e = pcall(P().report_now)
	if not ok then C().report("bhs", "report_now", e) end
	bhs_st.reports = bhs_st.reports + 1
end

-------------------------------------------------------------------------------
-- A co-op respawn is a fresh body
-------------------------------------------------------------------------------
-- The engine's respawn knows only its own condition (health, wounds, radiation). The stock never respawns, so the mods never
-- reset what killed the player: with a head or a torso still at zero BHS sets health to -1 on its next update (live
-- 2026-10-31), with arszi_psy's psy health at or below 0.001 that mod sets it to 0 every in-game second (live 2026-11-08: psi
-- killed a player, he stood up at his respawn point with the head and torso red and died again and again). Every respawn
-- (coop_mods_core "actor_respawned": a camp, a hardcore run's new character) gives them back, as G.A.M.M.A.'s own Soulslike
-- respawn does (soulslike_scenarios HealActor: psy 1), and at once into the per-player records: a level change right after
-- must not bring the dead values back. A teammate's revive is not a respawn: the damage stays (bhs_on_revived lifts only
-- head and torso off zero, coop_npc_effects lifts only a lethal psy health).
local fresh = { count = 0 }

local function bhs_fresh()
	local b = C().mod("zzz_player_injuries")
	if not (bhs_tables(b) and db.actor) then return end
	for _, k in ipairs(PARTS) do
		b.health[k] = b.maxhp[k]
		b.timedhp[k] = 0
	end
	bhs_clear_concussion(b)
	bhs_save(b)
	-- The respawn came before the first update of a new world: the record that load brought is from before the death.
	if bhs_st.pending then bhs_st.own = nil end
	bhs_st.last = bhs_text(bhs_snapshot())
	if C().live_client() then
		local ok, e = pcall(P().report_now)
		if not ok then C().report("bhs", "report_now", e) end
	end
end

local function psy_fresh()
	local ap = C().mod("arszi_psy")
	if not (ap and C().fn(ap, "set_psy_health")) then return end
	ap.set_psy_health(1)
	if C().fn(ap, "on_game_load") then pcall(ap.on_game_load) end -- its stage and death-scene counter
	if C().fn(ap, "remove_all_psy_ppe_effects") then pcall(ap.remove_all_psy_ppe_effects) end
	-- the psy table is a per-player key of coop_economy_mdata (polled every 15 s): to the host now
	local em = rawget(_G, "coop_economy_mdata")
	if C().live_client() and em and type(em.send_player_keys) == "function" then pcall(em.send_player_keys) end
end

local function vitals_text()
	local a = db.actor
	local function field(name)
		local ok, v = pcall(function() return a[name] end)
		v = ok and tonumber(v) or nil
		return v and string.format("%.3f", v) or "?"
	end
	local ap = C().mod("arszi_psy")
	local ok_psy, psy = pcall(function() return ap and ap.get_psy_health and ap.get_psy_health() end)
	local b = C().mod("zzz_player_injuries")
	local parts = bhs_tables(b) and string.format("%s/%s", tostring(b.health.head), tostring(b.health.torso)) or "-"
	return string.format("health %s, psy %s (arszi %s), radiation %s, bleeding %s, head/torso %s", field("health"),
		field("psy_health"), ok_psy and type(psy) == "number" and string.format("%.3f", psy) or "-", field("radiation"),
		field("bleeding"), parts)
end

local function on_respawned_fresh()
	if not db.actor then return end
	local before = vitals_text()
	local ok, e = pcall(bhs_fresh)
	if not ok then C().report("respawn", "bhs", e) end
	ok, e = pcall(psy_fresh)
	if not ok then C().report("respawn", "psy", e) end
	fresh.count = fresh.count + 1
	note_apply("respawn: a fresh body")
	log("respawn", "fresh body: before %s | after %s", before, vitals_text())
end

-------------------------------------------------------------------------------
-- Diagnostic: a client's health falling with nothing hitting him
-------------------------------------------------------------------------------
-- Live 2026-11-08: a G.A.M.M.A. client's health ran down after a level change with no hit (Yadulin outpaced it while it acted).
-- Until the source is proven, one line per DRAIN_MS while his health fell at least DRAIN_MIN with no hit in that time: what
-- G.A.M.M.A. drains health from (thirst above 4000, satiety, radiation, bleeding, psy, the BHS head and torso) and the last co-op
-- apply that touched his state. Every player in a session, the host's too (owner 2026-11-08: maybe it starts when a player dies),
-- with each player's life (alive / wounded / dead ...) at that moment.
local function players_life()
	local out = {}
	local ok, list = pcall(function() return C().players() end)
	if not (ok and type(list) == "table") then return "-" end
	for _, p in ipairs(list) do
		local life = "?"
		if api and api.life_of and p.id ~= nil then
			local okl, l = pcall(api.life_of, p.id)
			if okl and l ~= nil then life = tostring(l) end
		end
		out[#out + 1] = string.format("%s %s", tostring(p.nick or p.id), life)
	end
	return #out > 0 and table.concat(out, ", ") or "-"
end

local function drain_line(fell)
	local a = db.actor
	local function num(v)
		v = tonumber(v)
		return v and string.format("%.3f", v) or "-"
	end
	local function field(name)
		local ok, v = pcall(function() return a[name] end)
		return num(ok and v or nil)
	end
	local function call(modname, f)
		local m = C().mod(modname)
		if not (m and C().fn(m, f)) then return "-" end
		local ok, v = pcall(m[f])
		return ok and v ~= nil and tostring(v) or "-"
	end
	local b = C().mod("zzz_player_injuries")
	-- every part: BHS takes 0.029 health on a sprint step (13 %, once per 2.5 s) while a leg is at 3 HP or less, with no hit
	local parts = "-"
	if bhs_tables(b) then
		local out = {}
		for _, k in ipairs({ "head", "torso", "leftleg", "rightleg", "leftarm", "rightarm" }) do
			out[#out + 1] = string.format("%s %s/%s", k, tostring(b.health[k]), tostring(b.timedhp[k]))
		end
		parts = table.concat(out, ", ")
	end
	local sprint = "-"
	local ims = rawget(_G, "IsMoveState")
	if type(ims) == "function" then
		local ok_s, s = pcall(ims, "mcSprint")
		if ok_s then sprint = s and "yes" or "no" end
	end
	-- db.actor.satiety is the base condition's (1.000 always); the actor's own is CActorCondition::GetSatiety (live 2026-11-09)
	local satiety = field("satiety")
	local ok_sat, sat = pcall(function() return a:cast_Actor():conditions():GetSatiety() end)
	if ok_sat and type(sat) == "number" then satiety = string.format("%.3f", sat) end
	local ap = C().mod("arszi_psy")
	local ok_psy, psy = pcall(function() return ap and ap.get_psy_health and ap.get_psy_health() end)
	drain.lines = drain.lines + 1
	log("drain", "health %s fell %.3f in %d s with no hit: psy %s (arszi %s), BHS hp/timed %s, sprint %s, satiety %s, thirst %s, "
		.. "sleepiness %s, radiation %s, bleeding %s; players: %s; last co-op apply: %s%s", field("health"), fell, DRAIN_MS / 1000,
		field("psy_health"), ok_psy and type(psy) == "number" and string.format("%.3f", psy) or "-", parts, sprint, satiety,
		call("actor_status_thirst", "get_last_drink"), call("actor_status_sleep", "get_last_sleep"), field("radiation"),
		field("bleeding"), players_life(), drain.apply, drain.apply_at and string.format(" %d s ago", math.floor((time_global() - drain.apply_at) / 1000)) or "")
end

local function drain_on_hit()
	drain.hits = drain.hits + 1
end

local function drain_tick()
	if not (db.actor and C().active()) then return end
	local now = time_global()
	local ok, h = pcall(function() return tonumber(db.actor.health) end)
	if not (ok and h) then return end
	if not drain.start then
		drain.start, drain.health, drain.hits = now, h, 0
		return
	end
	if now - drain.start < DRAIN_MS then return end
	local fell = drain.health - h
	if fell >= DRAIN_MIN and drain.hits == 0 then drain_line(fell) end
	drain.start, drain.health, drain.hits = now, h, 0
end

local function install_respawn()
	C().listen("actor_respawned", on_respawned_fresh) -- always: its log line says what a respawn stood up with
	RegisterScriptCallback("actor_on_update", drain_tick)
	RegisterScriptCallback("actor_on_hit_callback", drain_on_hit)
	-- live 2026-11-08 (Agroprom, a client: two hits in the log, both [drain] lines said "no hit"): G.A.M.M.A.'s damage
	-- balancer (grok_actor_damage_balancer.shit_booster) takes every hit in actor_on_before_hit, sets its power to 0 and
	-- lowers the health itself (set_health_ex), so actor_on_hit_callback does not count it; actor_on_before_hit runs for every hit
	RegisterScriptCallback("actor_on_before_hit", drain_on_hit)
	if bhs_tables(C().mod("zzz_player_injuries")) or C().mod("arszi_psy") then installed[#installed + 1] = "respawn" end
end

function _fresh_count() return fresh.count end

local function install_bhs()
	local b = C().mod("zzz_player_injuries")
	if not bhs_tables(b) then return end
	P().register("head_tbl", { prime = { "zzz_player_injuries" } })
	P().register(BHS_KEY, { get = bhs_snapshot })
	RegisterScriptCallback("load_state", bhs_on_load)
	RegisterScriptCallback("actor_on_first_update", bhs_apply_own)
	RegisterScriptCallback("actor_on_update", bhs_tick)
	local concussion = b.bhs_concussion
	if type(concussion) == "function" then
		b.bhs_concussion = function(...)
			if not coop_npc_players.standing(0) then return end
			return concussion(...)
		end
	end
	C().listen("actor_revived", bhs_on_revived)
	installed[#installed + 1] = "bhs"
end

-------------------------------------------------------------------------------
-- Grok's actor damage balancer
-------------------------------------------------------------------------------
local function weapon_of_hit(shit)
	local w = level.object_by_id(shit.weapon_id)
	if w and IsWeapon(w) then return w end
	local who = shit.draftsman
	local ok, item = pcall(function() return who and who:active_item() end)
	if ok and item and IsWeapon(item) then
		shit.weapon_id = item:id()
		return item
	end
	return nil
end

local function install_adb()
	local m = C().mod("grok_actor_damage_balancer")
	local before, booster = m and m.actor_on_before_hit, m and m.shit_booster
	if type(before) ~= "function" or type(booster) ~= "function" then return end
	local wrapped = function(shit, bone_id, flags)
		if not coop_npc_players.active() then return before(shit, bone_id, flags) end
		local bullet = shit.type == hit.fire_wound
		local weapon = bullet and weapon_of_hit(shit)
		local who = shit.draftsman
		if who and coop_npc_players.is_proxy(who:id()) then
			log("adb", "a player's hit: bone %s, type %s, power %.3f, weapon %s", tostring(bone_id), tostring(shit.type), shit.power,
				weapon and weapon:section() or "none")
		end
		before(shit, bone_id, flags)
		if bullet and shit.power > 0 then booster(shit, bone_id, 0) end -- it stopped at the weapon or its ammo
	end
	m.actor_on_before_hit = wrapped
	C().swap_callback("actor_on_before_hit", before, wrapped)
	installed[#installed + 1] = "damage_balancer"
end

-------------------------------------------------------------------------------
-- AGDD Voiced Actor: every line of the player's voice goes through actor_speak_base
-------------------------------------------------------------------------------
local function install_voiced()
	local v = C().mod("agdd_voiced_actor")
	local speak = v and v.actor_speak_base
	if type(speak) ~= "function" then return end
	v.actor_speak_base = function(...)
		if not coop_npc_players.standing(0) then return false end
		return speak(...)
	end
	installed[#installed + 1] = "voiced_actor"
end

-------------------------------------------------------------------------------
-- Oleh's Extended MovementSFX: other players' footsteps
-------------------------------------------------------------------------------
local STEP_DIR = "footstep\\n_"
local last_variant = {}

local function on_avatar_step(avatar_id, material, power, move_state)
	local fs = C().mod("footstep_sounds")
	local obj = type(avatar_id) == "number" and avatar_id ~= 0 and level.object_by_id(avatar_id)
	if not (fs and type(fs.available_materials) == "table" and obj) then return end
	local mat = fs.available_materials[material] or fs.available_materials["default"]
	if type(mat) ~= "string" or mat == "water_" then return end
	local last = last_variant[avatar_id]
	local n = math.random(last and 5 or 6)
	if last and n >= last then n = n + 1 end
	last_variant[avatar_id] = n
	local ok, snd = pcall(sound_object, STEP_DIR .. mat .. n)
	if ok and snd then
		pcall(function()
			snd:play_at_pos(obj, obj:position(), 0, sound_object.s3d)
			snd.volume = math.min(1, math.max(0.1, tonumber(power) or 0.5))
		end)
	end
end

local function install_oleh()
	if not (C().mod("footstep_sounds") and (C().mod("oleh_sound_utils") or C().mod("extended_movement_sounds")
		or C().mod("extended_movement_sounds_mcm"))) then return end
	C().listen("avatar_step", on_avatar_step)
	installed[#installed + 1] = "oleh_movement"
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
local function actor_on_first_update()
	if C().is_client() then
		local ok, e = pcall(qaw_drop_lost_entries)
		if not ok then C().report("qaw", "drop lost entries", e) end
	end
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included (W5).
local function start_step(what, f)
	local ok, err = pcall(f)
	if not ok then printf("! [coop_mods_misc] %s failed: %s", what, tostring(err)) end
end

function on_game_start()
	if not api then return end
	start_step("install_pdata", install_pdata)
	start_step("install_kill_tracker", install_kill_tracker)
	start_step("install_guitar", install_guitar)
	if C().mod("guitar_anim") or C().mod("harmonica_anim") then
		C().on("song", on_song)
		installed[#installed + 1] = "guitar_anim"
	end
	start_step("install_sleep", install_sleep)
	start_step("install_zcp", install_zcp)
	start_step("install_paw", install_paw)
	start_step("install_bhs", install_bhs)
	start_step("install_respawn", install_respawn)
	start_step("install_adb", install_adb)
	start_step("install_voiced", install_voiced)
	start_step("install_oleh", install_oleh)
	if C().mod("haru_quick_action_wheel_mcm") then RegisterScriptCallback("actor_on_first_update", actor_on_first_update) end
	C().status_line("misc", function()
		return "installed: " .. (#installed > 0 and table.concat(installed, ", ") or "none (mods absent)")
	end)
end

-- Load time (before any on_game_start): the song functions may be captured by other mods at their start.
if api then
	local ok, e = pcall(install_guitar)
	if not ok then printf("[coop-mods] [misc] ! guitar patch: %s", tostring(e)) end
end
