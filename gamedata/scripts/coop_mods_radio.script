-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - radios (gamedata\scripts\coop_mods_radio.script).

	RF receiver (stock item_radio)
	  The host owns the RF sources: hidden stashes per level (RF_stashes) and task targets (RF_targets). A client
	  loads them with the world's save; afterwards the world owner compares both tables every 2 s and sends changes
	  (mods.rf { a adds "id:freq:dist,..", r removals "id,..", s stash adds "lvl:id:freq,..", x stash removals,
	    d serialized sound descriptions, full a complete snapshot every 30 s }). Large snapshots
	  use mods.rf_big. A target waits for its streamed object. Both mods.rf and quests.rf retain the target's sound.
	  Only the world owner assigns a missing PDA frequency (mods.rf_freq / mods.rf_freq_r); a player's scanner waits
	  for that answer. The owner retires released NPC frequencies on mirrors even if a name and object id are reused.
	  Where the map is led, confirmed player inventory removes ordinary targets; mods.rf_taken carries a map's
	  confirmation to the world owner without asking that owner to inspect a player's map or inventory.
	  mods.rf_target carries ordinary quest sources registered or cleared on a map to the world owner.
	  The tuned frequency stays the player's own (RF_freq, a stock key: coop_economy_mdata).
	Zone FM (stock ui_pda_radio_tab)
	  Every machine runs its own channel clock; the host's decides. When a channel moves to another track or
	  station ident the host sends its file name (mods.fm { ch, k kind, n name }) and clients switch to the same
	  file; every 30 s the host repeats the current state for late joiners.
	RF Receiver Hidden Packages (tb_rf_receiver_packages)
	  The world owner checks each character's goodwill and adds that character and map to the shared queue.
	  Goodwill thresholds live in coop_rf_package_goodwill. mods.g96_rf_package addresses the spawn/intro news.
	  The package, its ambush and the reminders are the host's. A client never spawns them; it follows the
	  host's package through the RF targets and runs only the hunting half (scanner, pickup, reward into its
	  own inventory). When a client picks the package up the host closes its own package state.
--]]

local api = rawget(_G, "coop")

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next

local core = coop_mods_core
local function log(fmt, ...) core.log("radio", fmt, ...) end

local installed = {}
local st = { rf_out = 0, rf_in = 0, fm_out = 0, fm_in = 0, fm_missing = 0, pkg_closed = 0 }

-------------------------------------------------------------------------------
-- RF sources (item_radio)
-------------------------------------------------------------------------------
local rf = { sent_t = {}, sent_s = {}, pending = {}, frequencies = {}, requested = {}, next_tick = 0, next_full = 0,
	taken = {}, changes = {}, IR = nil }

local function rf_number(v, lo, hi)
	v = tonumber(v)
	return v and v == math.floor(v) and v >= lo and v <= hi and v or nil
end

-- Sound descriptions are paths or dense lists of paths, never functors/code or sound userdata.
local function rf_sound(v)
	if type(v) == "string" then
		if #v > 0 and #v <= 256 and v:match("^[%w_][%w_ /\\%.%-]*$") and not v:find("..", 1, true) then return v end
	elseif type(v) == "table" and #v > 0 and #v <= 32 then
		local out, n = {}, 0
		for k, path in pairs(v) do
			if not rf_number(k, 1, #v) or type(path) ~= "string" or not rf_sound(path) then return nil end
			out[k], n = path, n + 1
		end
		if n == #v then return out end
	end
end

local function rf_sound_wire(v)
	v = rf_sound(v)
	-- Dense list order is meaningful; the serializer's table iteration order is not a change signature.
	if type(v) == "table" then
		local out = {}
		for i, path in ipairs(v) do out[i] = #path .. ":" .. path end
		return "t" .. table.concat(out)
	end
	return type(v) == "string" and ("s" .. v) or ""
end

local function rf_target(v)
	if type(v) ~= "table" then return nil end
	local freq, dist = rf_number(v.freq, 1, 999), rf_number(v.dist or 200, 1, 100000)
	if freq and dist then return { freq = freq, dist = dist, snd = rf_sound(v.snd) } end
end

local function rf_identity(id, se)
	se = se or alife_object(id)
	if not se then return nil end
	local name = core.fn(se, "name") and se:name()
	local section = se:section_name()
	if type(name) == "string" and name ~= "" and type(section) == "string" then return name, section end
end

local function rf_pda_frequency(orig, id, defs)
	if not core.active() then return orig(id, defs) end
	if not rf_number(id, 1, 65534) then return nil end
	local name, section = rf_identity(id)
	if not name then return nil end -- no stable identity yet: let the next scan try again
	local IR = rf.IR
	IR.stalker_pda_frequencies = IR.stalker_pda_frequencies or {}
	local old = not coop_mode.decides_world() and rf.frequencies[core.hid(id)]
	if not (type(old) == "table" and old.name == name and (not old.section or old.section == section)) then
		old = IR.stalker_pda_frequencies[id]
	end
	if type(old) == "table" and old.name == name and (old.section == nil or old.section == section)
		and rf_number(old.freq, 1, 999) then
		IR.stalker_pda_frequencies[id] = { id = id, name = name, section = section, freq = tonumber(old.freq) }
		return tonumber(old.freq)
	end
	IR.stalker_pda_frequencies[id] = nil
	if coop_mode.decides_world() then
		local freq = orig(id, defs)
		local value = IR.stalker_pda_frequencies[id]
		if type(value) == "table" then value.section = section end
		return freq
	end
	if time_global() >= (rf.requested[id] or 0) then
		if core.to_host("rf_freq", { i = core.hid(id) }) then rf.requested[id] = time_global() + 3000 end
	end
	return nil -- the scan can retry; a mirror never invents a frequency
end

local function rf_apply_frequency(hid, freq, name, section)
	local id = core.lid(hid)
	if not (id and type(name) == "string" and rf_number(freq, 1, 999)) then return end
	local IR = rf.IR
	IR.stalker_pda_frequencies = IR.stalker_pda_frequencies or {}
	rf.frequencies[hid] = { freq = freq, name = name, section = section } -- may precede the streamed NPC
	rf.requested[id] = nil
	local local_name, local_section = rf_identity(id)
	if name == local_name and section == local_section then
		IR.stalker_pda_frequencies[id] = { id = id, name = name, section = section, freq = tonumber(freq) }
	end
end

local function rf_frequency_request(t, from)
	local hid = rf_number(t.i, 1, 65534)
	if not coop_trust.pass("rf_frequency_id", hid ~= nil, "peer %s requested invalid RF frequency id", tostring(from)) then return end
	if not hid then return end
	local id = core.lid(hid)
	local se = id and alife_object(id)
	local class = se and core.fn(se, "clsid") and se:clsid()
	local stalker = class and (class == clsid.script_stalker or class == clsid.stalker)
	if not coop_trust.pass("rf_frequency_object", stalker, "peer %s requested frequency for unavailable stalker %s", tostring(from), tostring(hid)) then return end
	if not stalker then return end
	local freq = rf.IR.init_or_get_stalker_pda_freq(id)
	local v = (rf.IR.stalker_pda_frequencies or {})[id]
	if freq and v then core.to_peer(from, "rf_freq_r", { i = hid, f = freq, n = v.name, c = v.section }) end
end

local function rf_forget_frequency(id, hid)
	local frequencies = rf.IR.stalker_pda_frequencies
	if type(frequencies) == "table" then frequencies[id] = nil end
	rf.frequencies[hid], rf.requested[id] = nil, nil
end

local function rf_frequency_reply(t, from)
	if not (from == 0 and core.active() and not coop_mode.decides_world()) then return end
	local hid = rf_number(t.i, 1, 65534)
	if not hid then return end
	if t.x then
		local id = core.lid(hid)
		if id then rf_forget_frequency(id, hid) end
	else
		rf_apply_frequency(hid, t.f, t.n, t.c)
	end
end

local function rf_unregister(se)
	if not (core.active() and se) then return end
	local id = se.id
	if not rf_number(id, 1, 65534) then return end
	local hid = core.hid(id)
	if coop_mode.decides_world() and (rf.IR.stalker_pda_frequencies or {})[id] then
		core.to_all("rf_freq_r", { i = hid, x = true })
	end
	rf_forget_frequency(id, hid)
	rf.taken[hid], rf.changes[hid] = nil, nil
	rf.pending[id] = nil
end

local function rf_load()
	if not core.active() then return end
	rf.sent_t, rf.sent_s = {}, {}
	rf.pending, rf.frequencies, rf.requested, rf.taken, rf.changes = {}, {}, {}, {}, {}
	rf.next_tick, rf.next_full = 0, 0
end

local function rf_level(se)
	return alife():level_name(game_graph():vertex(se.m_game_vertex_id):level_id())
end

local function rf_ordinary(section)
	return not section:find("quest_tb_package_", 1, true)
end

local function rf_remove(id)
	rf.IR.clear_target(id)
	local hid = core.hid(id)
	-- A quest event may have reached players before this source appeared in an RF snapshot.
	if rf.sent_t[hid] == nil then rf.sent_t[hid] = false end
end

-- Called where the inventory action is executed, and by the inventory poll for objects already held on load.
local function rf_take(id, peer)
	if not (peer ~= nil and coop_mode.seat_plays(peer) and coop_mode.where(peer) == "here"
		and coop_mode.decider(peer) == "this") then return end
	local target = (rf.IR.RF_targets or {})[id]
	local se = target and alife_object(id)
	if not se or not rf_ordinary(se:section_name()) then return end
	if coop_mode.decides_world() then
		rf_remove(id)
	else
		local hid = core.hid(id)
		local last = rf.taken[hid]
		if last and last.target == target then return end
		local name, section = rf_identity(id)
		if name then rf.taken[hid] = { n = name, c = section, l = rf_level(se), target = target } end
	end
end

local function rf_actor_take(item)
	if core.active() and coop_mode.leads_here() and coop_mode.actor_is_player() and item then
		rf_take(item:id(), core.self_peer())
	end
end

local function rf_npc_take(npc, item)
	if core.active() and coop_mode.leads_here() and npc and item then
		rf_take(item:id(), core.peer_of(npc:id()))
	end
end

local function rf_pickups()
	if not coop_mode.leads_here() then return end
	for id in pairs(rf.IR.RF_targets or {}) do rf_take(id, core.holder_peer(id)) end
end

local function rf_publish_pickups()
	local budget = 16
	for hid, fact in pairs(rf.taken) do
		if fact.sent then
			if not (rf.IR.RF_targets or {})[core.lid(hid)] then rf.taken[hid] = nil end
		elseif not rf.changes[hid] and core.publish("rf_taken", { i = hid, n = fact.n, c = fact.c, l = fact.l }) then
			fact.sent = true
			budget = budget - 1
			if budget == 0 then break end
		end
	end
end

local function rf_publish_changes()
	local budget = 16
	for hid, fact in pairs(rf.changes) do
		if core.publish("rf_target", fact) then
			rf.changes[hid] = nil
			budget = budget - 1
			if budget == 0 then break end
		end
	end
end

local function rf_reported_object(t, from)
	if not coop_mode.decides_world() then return end
	-- A world fact has no player request path. The sender is the transport's peer, never a payload field.
	-- A playing seat cannot attest inventory on another process; this is the delivery boundary, not a gameplay rule.
	local reporter = type(from) == "number" and from > 0 and not coop_mode.seat_plays(from)
	local admitted = coop_trust.pass("rf_source_sender", reporter, "peer %s cannot attest RF inventory", tostring(from))
	if not admitted or not reporter then return end
	local hid = rf_number(t.i, 1, 65534)
	local shape = hid and type(t.n) == "string" and #t.n > 0 and #t.n <= 256
		and type(t.c) == "string" and #t.c > 0 and #t.c <= 256 and type(t.l) == "string" and #t.l > 0 and #t.l <= 128
	if not coop_trust.pass("rf_source_fact", shape, "peer %s sent invalid RF inventory fact", tostring(from)) then return end
	if not shape then return end -- malformed values cannot be indexed even in diagnostic mode
	local id = core.lid(hid)
	if not id then return end
	local se = alife_object(id)
	if not se then return end
	local name, section = rf_identity(id, se)
	if name == t.n and section == t.c and rf_ordinary(section) and rf_level(se) == t.l then return id end
end

local function rf_on_taken(t, from)
	local id = rf_reported_object(t, from)
	if id and ((rf.IR.RF_targets or {})[id] or rf.sent_t[core.hid(id)] == nil) then rf_remove(id) end
end

local function rf_on_target(t, from)
	local id = rf_reported_object(t, from)
	if not id then return end
	if t.x == true then
		rf_remove(id)
	else
		local snd = core.deser(t.s or "")
		local target = rf_target({ freq = t.f, dist = t.d, snd = snd })
		local valid = t.x == nil and target and (snd == false or target.snd)
		if not coop_trust.pass("rf_source_target", valid, "peer %s sent invalid RF target", tostring(from)) then return end
		if valid then
			rf.IR.RF_targets = rf.IR.RF_targets or {}
			rf.IR.RF_targets[id] = target
		end
	end
end

local function rf_queue_map_target(id, out, target)
	if not (coop_mode.leads_here() and not coop_mode.decides_world()) then return end
	local se = alife_object(id)
	if not se then return end
	local name, section = rf_identity(id, se)
	if not (name and rf_ordinary(section) and (out.x or target)) then return end
	rf.changes[out.i] = { i = out.i, n = name, c = section, l = rf_level(se), x = out.x,
		f = out.f, d = out.d, s = out.s }
end

local function rf_host_diff()
	local IR = rf.IR
	local targets = type(IR.RF_targets) == "table" and IR.RF_targets or {}
	local stashes = type(IR.RF_stashes) == "table" and IR.RF_stashes or {}
	local full = time_global() >= rf.next_full
	local adds, rems, sadds, srems, sounds = {}, {}, {}, {}, {}
	local now_t = {}
	for id, v in pairs(targets) do
		local target = rf_target(v)
		if rf_number(id, 1, 65534) and target then
			local hid = core.hid(id)
			local row = string.format("%d:%d:%d", hid, target.freq, target.dist)
			local sig = row .. ":" .. rf_sound_wire(target.snd)
			now_t[hid] = sig
			if full or rf.sent_t[hid] ~= sig then
				adds[#adds + 1] = row
				sounds[hid] = target.snd or false -- an explicit reset to the mod's default
			end
		end
	end
	for id in pairs(rf.sent_t) do
		if not now_t[id] then rems[#rems + 1] = tostring(id) end
	end
	local now_s = {}
	for lvl, ids in pairs(stashes) do
		if type(lvl) == "string" and type(ids) == "table" and not lvl:find("[:,]") then
			for id, freq in pairs(ids) do
				if type(id) == "number" then
					local k = lvl .. ":" .. id
					local sig = string.format("%s:%d", k, tonumber(freq) or 0)
					now_s[k] = sig
					if full or rf.sent_s[k] ~= sig then sadds[#sadds + 1] = sig end
				end
			end
		end
	end
	for k in pairs(rf.sent_s) do
		if not now_s[k] then srems[#srems + 1] = k end
	end
	if not full and #adds + #rems + #sadds + #srems == 0 then return end
	local t = { a = table.concat(adds, ","), r = table.concat(rems, ","), s = table.concat(sadds, ","), x = table.concat(srems, ","),
		d = core.ser(sounds), full = full }
	local sent
	if #coop_main.encode(t) < 15000 then sent = core.to_all("rf", t)
	else sent = core.send_big("rf_big", core.ser(t), -1) end
	if sent then
		rf.sent_t, rf.sent_s = now_t, now_s
		if full then rf.next_full = time_global() + 30000 end
		st.rf_out = st.rf_out + 1
	end
end

local function rf_client_reconcile()
	local IR = rf.IR
	if type(IR.RF_targets) ~= "table" then IR.RF_targets = {} end
	for id, v in pairs(rf.pending) do
		if alife_object(id) then
			IR.RF_targets[id] = v
			rf.pending[id] = nil
		end
	end
end

local function rf_client_apply(t)
	local IR = rf.IR
	if not IR then return end
	st.rf_in = st.rf_in + 1
	if type(IR.RF_targets) ~= "table" then IR.RF_targets = {} end
	if type(IR.RF_stashes) ~= "table" then IR.RF_stashes = {} end
	if t.full then
		IR.RF_targets, IR.RF_stashes = {}, {}
		rf.pending = {}
	end
	local sounds = core.deser(t.d or "")
	for e in tostring(t.a or ""):gmatch("[^,]+") do
		local id, freq, dist = e:match("^(%d+):(%-?%d+):(%-?%d+)$")
		local hid = rf_number(id, 1, 65534)
		local value = rf_target({ freq = freq, dist = dist, snd = type(sounds) == "table" and sounds[hid] })
		id = hid and core.lid(hid)
		if id and value then rf.pending[id] = value end
	end
	for e in tostring(t.r or ""):gmatch("[^,]+") do
		local hid = rf_number(e, 1, 65534)
		local id = hid and core.lid(hid)
		if id then
			rf.pending[id] = nil
			IR.RF_targets[id] = nil
		end
	end
	for e in tostring(t.s or ""):gmatch("[^,]+") do
		local lvl, id, freq = e:match("^([^:]+):(%d+):(%-?%d+)$")
		if lvl then
			IR.RF_stashes[lvl] = IR.RF_stashes[lvl] or {}
			IR.RF_stashes[lvl][tonumber(id)] = tonumber(freq)
		end
	end
	for e in tostring(t.x or ""):gmatch("[^,]+") do
		local lvl, id = e:match("^([^:]+):(%d+)$")
		if lvl and IR.RF_stashes[lvl] then IR.RF_stashes[lvl][tonumber(id)] = nil end
	end
	rf_client_reconcile()
end

local function rf_receive(t, from)
	if from == 0 and core.active() and not coop_mode.decides_world()
		and (coop_mode.is_player_mirror() or coop_mode.leads_here()) then rf_client_apply(t) end
end

-- quests.rf predates mods.rf. Decorate its producer and the final event dispatch so load order cannot let its
-- legacy receiver overwrite snd again. Both wrappers are inert outside a session and leave other events alone.
local function install_rf_quests()
	local qc = core.mod("coop_quests_core")
	if qc then
		core.wrap(qc, "send", "radio.quests.rf.send", function(orig)
			return function(verb, t, ...)
				if not (core.active() and verb == "rf" and type(t) == "table") then return orig(verb, t, ...) end
				local out = {}
				for k, v in pairs(t) do out[k] = v end
				local id = rf_number(t.i, 1, 65534)
				if not id then return orig(verb, t, ...) end
				out.i = core.hid(id)
				local target = rf_target((rf.IR.RF_targets or {})[id])
				out.s = core.ser(target and target.snd or false)
				rf_queue_map_target(id, out, target)
				return orig(verb, out, ...)
			end
		end)
	end
	core.wrap(coop_main, "on_event", "radio.quests.rf.receive", function(orig)
		return function(verb, payload, from, ...)
			local result = orig(verb, payload, from, ...)
			if core.active() and verb == "quests.rf" and from == 0 and coop_mode.is_player_mirror() then
				local t = coop_main.decode(payload)
				local hid = rf_number(t.i, 1, 65534)
				local id = hid and core.lid(hid)
				if id then
					rf.IR.RF_targets[id] = nil -- the legacy receiver installed its incomplete copy
					if t.x then rf.pending[id] = nil
					else
						rf.pending[id] = rf_target({ freq = t.f, dist = t.d, snd = core.deser(t.s or "") })
					end
					rf_client_reconcile()
				end
			end
			return result
		end
	end)
end

-- A target quest code adds or clears goes out from here: the deciding process sends its diff at once, a map's leader
-- queues the change for the world server (rf_publish_changes). The mod's payload is the stock one: freq and dist as the
-- mod stored them, the sound serialized.
local function rf_target_changed(id, cleared)
	if not (core.active() and type(id) == "number") then return end
	if coop_mode.decides_world() then
		local ok, e = pcall(rf_host_diff)
		if not ok then core.report("radio", "rf diff", e) end
		return
	end
	local hid = core.hid(id)
	if not hid then return end
	local stored = not cleared and (rf.IR.RF_targets or {})[id] or nil
	local target = stored and rf_target(stored)
	local out = { i = hid, x = cleared or nil, f = stored and tonumber(stored.freq), d = stored and tonumber(stored.dist),
		s = core.ser(target and target.snd or false) }
	rf_queue_map_target(id, out, target)
end

local function install_rf()
	local IR = core.mod("item_radio")
	if not (IR and core.fn(IR, "add_target")) then return end
	rf.IR = IR
	for _, key in ipairs({ "add_target", "clear_target" }) do
		core.wrap(IR, key, "item_radio." .. key, function(orig)
			return function(id, ...)
				local r = orig(id, ...)
				rf_target_changed(id, key == "clear_target")
				return r
			end
		end)
	end
	installed[#installed + 1] = "item_radio"
	core.on("rf", rf_receive)
	core.on_big("rf_big", function(blob, from) local t = core.deser(blob) if type(t) == "table" then rf_receive(t, from) end end, "client")
	core.set_limit("rf_taken", 16, 8)
	core.on("rf_taken", rf_on_taken, "world")
	core.set_limit("rf_target", 16, 8)
	core.on("rf_target", rf_on_target, "world")
	core.set_limit("rf_freq", 128, 64)
	core.on("rf_freq", rf_frequency_request, "world")
	core.on("rf_freq_r", rf_frequency_reply)
	core.wrap(IR, "init_or_get_stalker_pda_freq", "radio.pda_frequency", function(orig)
		return function(id, defs) return rf_pda_frequency(orig, id, defs) end
	end)
	RegisterScriptCallback("server_entity_on_unregister", rf_unregister)
	RegisterScriptCallback("load_state", rf_load)
	RegisterScriptCallback("actor_on_item_take", rf_actor_take)
	RegisterScriptCallback("npc_on_item_take", rf_npc_take)
	install_rf_quests()
end

local function rf_tick()
	local tg = time_global()
	if tg < rf.next_tick then return end
	rf.next_tick = tg + 2000
	local ok, e = pcall(rf_pickups)
	if not ok then core.report("radio", "rf pickups", e) end
	if coop_mode.leads_here() and not coop_mode.decides_world() then
		local changed, change_err = pcall(rf_publish_changes)
		if not changed then core.report("radio", "rf target changes", change_err) end
		local sent, err = pcall(rf_publish_pickups)
		if not sent then core.report("radio", "rf confirmed pickups", err) end
	end
	if coop_mode.decides_world() then
		local ok, e = pcall(rf_host_diff)
		if not ok then core.report("radio", "rf diff", e) end
	elseif (coop_mode.is_player_mirror() or coop_mode.leads_here()) and next(rf.pending) then
		local ok, e = pcall(rf_client_reconcile)
		if not ok then core.report("radio", "rf reconcile", e) end
	end
end

-------------------------------------------------------------------------------
-- Zone FM (ui_pda_radio_tab)
-------------------------------------------------------------------------------
local KIND_TRACK, KIND_SESSION = 0, 1
local fm = { R = nil, loc = {}, names = {}, slots = {}, sent = {}, next_tick = 0, next_full = 0 }

local function fm_local(name)
	local l = fm.loc[name]
	if l == nil then
		local _, holder, idx = core.find_local(fm.R, name)
		l = { holder = holder, idx = idx }
		fm.loc[name] = l
	end
	if l.holder then
		local _, v = debug.getupvalue(l.holder, l.idx)
		return v
	end
	return fm.R[name]
end

local function fm_list(path)
	local out = {}
	local ok, fl = pcall(function() return getFS():file_list_open("$game_sounds$", path, bit_or(FS.FS_ListFiles, FS.FS_RootOnly)) end)
	local n = ok and fl and fl:Size() or 0
	for i = 1, n do out[i] = fl:GetAt(i - 1):sub(1, -5) end
	return out
end

-- The folders of channel ch, built as the tab builds them (stock ui_pda_radio_tab.script:31-34). Its path_radio_ch /
-- path_radio_session are main-chunk locals that no function captures and no unlocalizer lists: unreachable from here.
local function fm_folders(ch)
	local dir = "radio\\_channel_" .. tostring(ch)
	return dir .. "\\", dir .. "_session\\"
end

-- The tab lists the same folders; listing them again maps a track index back to its file name.
local function fm_build()
	local ch_t, ses_t = fm_local("radio_ch"), fm_local("radio_session")
	if not (type(ch_t) == "table" and type(ses_t) == "table") then return false end
	for ch = 1, #ch_t do
		local track_dir, session_dir = fm_folders(ch)
		local tracks, sessions = fm_list(track_dir), fm_list(session_dir)
		if type(ch_t[ch]) == "table" and type(ses_t[ch]) == "table" and #tracks == #ch_t[ch] and #sessions == #ses_t[ch] then
			fm.names[ch] = { [KIND_TRACK] = tracks, [KIND_SESSION] = sessions }
			fm.slots[ch] = { [KIND_TRACK] = {}, [KIND_SESSION] = {} }
			for i, n in ipairs(tracks) do fm.slots[ch][KIND_TRACK][n] = i end
			for i, n in ipairs(sessions) do fm.slots[ch][KIND_SESSION][n] = i end
		else
			log("Zone FM channel %d: track list differs from the tab's, not synced", ch)
		end
	end
	return next(fm.names) ~= nil
end

local function fm_current(ch)
	local ses_t, ses_now = fm_local("radio_session"), fm_local("radio_session_now")
	local ch_t, now = fm_local("radio_ch"), fm_local("radio_now")
	local s = ses_t[ch] and ses_t[ch][ses_now[ch]]
	if s and s:playing() then return KIND_SESSION, ses_now[ch] end
	local t = ch_t[ch] and ch_t[ch][now[ch]]
	if t and t:playing() then return KIND_TRACK, now[ch] end
	return nil
end

-- Outdoor speakers keep the clip they last played until it ends; stopping them makes them follow the clock.
local function fm_cut_speakers(ch)
	for _, name in ipairs({ "radio_ch_out", "radio_session_out" }) do
		local t = fm_local(name)
		for _, snd in pairs(t and t[ch] or {}) do pcall(function() snd:stop() end) end
	end
end

local function fm_host_tick(full)
	for ch in pairs(fm.names) do
		local kind, idx = fm_current(ch)
		local key = kind and (kind .. ":" .. idx) or ""
		if kind and (key ~= fm.sent[ch] or full) then
			if key ~= fm.sent[ch] then fm_cut_speakers(ch) end
			fm.sent[ch] = key
			core.to_all("fm", { ch = ch, k = kind, n = fm.names[ch][kind][idx] })
			st.fm_out = st.fm_out + 1
		end
	end
end

local function fm_client_apply(t)
	local ch, kind, name = tonumber(t.ch), tonumber(t.k), t.n
	if not (ch and fm.slots[ch] and (kind == KIND_TRACK or kind == KIND_SESSION) and type(name) == "string" and db.actor) then return end
	st.fm_in = st.fm_in + 1
	local idx = fm.slots[ch][kind][name]
	if not idx then
		st.fm_missing = st.fm_missing + 1
		return
	end
	local ck, ci = fm_current(ch)
	if ck == kind and ci == idx then return end
	local ch_t, ses_t = fm_local("radio_ch"), fm_local("radio_session")
	local now, ses_now = fm_local("radio_now"), fm_local("radio_session_now")
	pcall(function() ch_t[ch][now[ch]]:stop() end)
	pcall(function() ses_t[ch][ses_now[ch]]:stop() end)
	fm_cut_speakers(ch)
	local obj
	if kind == KIND_SESSION then
		ses_now[ch] = idx
		obj = ses_t[ch][idx]
	else
		now[ch] = idx
		obj = ch_t[ch][idx]
	end
	if obj then
		pcall(function()
			obj:play(db.actor, 0.5, sound_object.s2d) -- just behind the host, so the tab still sees a busy channel
			obj.volume = 0 -- the tab sets the real volume on its next update
		end)
	end
end

local function install_fm()
	local R = core.mod("ui_pda_radio_tab")
	if not R then return end
	fm.R = R
	local ok, built = pcall(fm_build)
	if not (ok and built) then
		log("Zone FM clock not reachable, channels not synced")
		return
	end
	installed[#installed + 1] = "zone_fm"
	core.on("fm", fm_client_apply, "client")
end

local function fm_tick()
	if not (fm.R and next(fm.names) and coop_mode.decides_world()) then return end
	local tg = time_global()
	if tg < fm.next_tick then return end
	fm.next_tick = tg + 1000
	local full = tg >= fm.next_full
	if full then fm.next_full = tg + 30000 end
	local ok, e = pcall(fm_host_tick, full)
	if not ok then core.report("radio", "fm", e) end
end

-------------------------------------------------------------------------------
-- RF Receiver Hidden Packages
-------------------------------------------------------------------------------
local PKG_PREFIX = "quest_tb_package_"
local PKG_GOODWILL = "coop_rf_package_goodwill"
local PKG_NEWS = "g96_rf_package"
local pkg = { TB = nil, tracked = nil, examined = {}, next_tick = 0, next_goodwill = 0, baseline = {}, orig_take = nil }

-- The package mod's state with no package (its own start values), and its receiver's.
local PKG_IDLE = { tb_package_active = false, tb_target_item = 0, tb_package_in_level = "empty", tb_reminder = "empty",
	tb_scan_time = 4000 }
local RECEIVER_IDLE = { tb_in_range = false, tb_sound_object = false, tb_flash_time = 0 }

local function pkg_clear_local()
	pkg.tracked = nil
	for field, value in pairs(PKG_IDLE) do pkg.TB[field] = value end
	if rf.IR then
		for field, value in pairs(RECEIVER_IDLE) do rf.IR[field] = value end
	end
end

-- Client: the host's package (an RF target) becomes the mod's current package here.
local function pkg_client_follow()
	local tb, IR = pkg.TB, rf.IR
	local targets = IR and type(IR.RF_targets) == "table" and IR.RF_targets or {}
	if pkg.tracked then
		if targets[pkg.tracked] then return end
		pkg_clear_local()
	end
	for id in pairs(pkg.examined) do
		if not targets[id] then pkg.examined[id] = nil end
	end
	for id, target in pairs(targets) do
		if pkg.examined[id] == nil then
			local se = alife_object(id)
			-- Saved RF targets can arrive before their streamed object; examine only once it exists.
			if se then pkg.examined[id] = se:section_name():find(PKG_PREFIX, 1, true) ~= nil end
			if pkg.examined[id] and type(target) == "table" and target.freq then
				pkg.tracked = id
				local level_id = game_graph():vertex(se.m_game_vertex_id):level_id()
				local follow = { tb_target_item = id, tb_freq = target.freq, tb_package_in_level = alife():level_name(level_id),
					tb_package_active = true, tb_badguy_spawned = true, tb_scan_time = 4000 } -- the ambush is the host's
				for field, value in pairs(follow) do tb[field] = value end
				log("following the host's package %d", id)
				return
			end
		end
	end
end

-- Client pickup: the reward goes into this player's own inventory (created by the host on request).
local function pkg_client_take(item)
	local tb = pkg.TB
	if not item then return end
	if item:id() == tb.tb_target_item and tb.tb_package_active then
		if rf.IR then rf.IR.clear_target(tb.tb_target_item) end
		pkg_clear_local()
	end
	local n = item:section():match("^" .. PKG_PREFIX .. "(%d+)$")
	if not n then return end
	local reward = "quest_package_" .. n
	if not ini_sys:section_exist(reward) then return end
	alife_create_item(reward, db.actor)
	tb.tb_bonus_items = (tb.tb_bonus_items or 0) + 1
	alife_release(item)
	if ui_mcm and ui_mcm.get and ui_mcm.get("RF_package_patch/unpacking") == "automatic" then
		local deadline = time_global() + 5000
		CreateTimeEvent("coop_mods_rf", "unpack_" .. n, 0.5, function()
			local got = db.actor and db.actor:object(reward)
			if got then
				if itms_manager and itms_manager.use_package_random then pcall(itms_manager.use_package_random, got) end
				return true
			end
			return time_global() > deadline
		end)
	end
end

-- Host: a client picked the package up (its pickup never reaches the host's own callback).
local function pkg_host_check()
	local tb, IR = pkg.TB, rf.IR
	local id = tonumber(tb.tb_target_item)
	if not (tb.tb_package_active and id and id > 0 and id < 65535) then return end
	local se = alife_object(id)
	if not se then return end
	local root = core.root_of(id)
	if root == id or not core.is_remote_player(root) then return end
	log("package %d picked up by player #%s, closed", id, tostring(core.peer_of(root)))
	if IR then IR.clear_target(id) end
	RemoveTimeEvent(id, "remind_about_radio_package")
	pkg_clear_local()
	tb.tb_badguy_spawned = false
	st.pkg_closed = st.pkg_closed + 1
end

local function pkg_show_news(t)
	if not (core.active() and coop_mode.actor_is_player() and db.actor and type(t.m) == "string" and #t.m <= 2000
		and type(t.i) == "string" and #t.i <= 128 and rf_number(t.c, 0, 65534) == core.hid(0)) then return end
	db.actor:give_game_news(game.translate_string("tb_anon_sender"), t.m, t.i, 0, 20000, 0)
	utils_obj.play_sound("device\\pda\\pda_sos")
	if t.note == true then pkg.TB.give_note() end
end

local function pkg_news(character, message, icon, note)
	local t = { c = character, m = message, i = icon, note = note }
	if character == 0 and coop_mode.actor_is_player() then
		pkg_show_news(t)
	else
		coop_credit.to_owner(character, PKG_NEWS, t)
	end
end

-- The stock spawner already consumes the map and icon at slots 1 and 2. Give its actor-only reads the
-- initiator's inventory and faction, and route its message to that character. The spawner still owns
-- coordinate selection, surge checks, RF target creation and its timers.
local function pkg_spawn_from_queue(orig, ...)
	local tb = pkg.TB
	local queue = tb.tb_package_queue
	local row = queue and queue[1]
	if not row then return orig(...) end
	local character = row.character
	if character == nil and coop_mode.actor_is_player() then return orig(...) end -- legacy queue in a host's save
	local source = getfenv(orig)
	local body = character == 0 and db.actor or (character ~= nil and coop_tasks.recipient_body(core.lid(character)))
	local actor = {
		object = function(_, section) return body and body:object(section) end,
		give_game_news = function(_, _, message, icon)
			if character ~= nil then pkg_news(character, message, icon) end
		end,
	}
	local env = setmetatable({ db = setmetatable({ actor = actor }, { __index = source.db }),
		get_actor_true_community = function() return body and body:character_community() or row.community end,
		utils_obj = setmetatable({ play_sound = function() end }, { __index = source.utils_obj }),
		-- The queued outdoor map is the context. The spawner's own actor can now be in a lab or on a console's map.
		GetEvent = function(name, ...)
			if name == "underground" then return false end
			return source.GetEvent(name, ...)
		end,
	}, { __index = source, __newindex = source })
	setfenv(orig, env)
	local ok, spawned = pcall(orig, ...)
	setfenv(orig, source)
	if not spawned or not ok then
		if not tb.tb_package_active and queue[1] ~= row then table.insert(queue, 1, row) end
		tb.tb_making_package = false
	end
	if not ok then error(spawned, 0) end
	return spawned
end

local function pkg_goodwill()
	local tb = pkg.TB
	if not (tb.tb_package_queue and tb.tb_factions and tb.tb_relations and tb.tb_relation_diff and not tb.tb_making_package) then return end
	local state = alife_storage_manager.get_state()
	if type(state[PKG_GOODWILL]) ~= "table" then state[PKG_GOODWILL] = {} end
	local records = state[PKG_GOODWILL]
	for _, p in ipairs(core.players()) do
		local id = p.avatar_id
		if rf_number(id, 0, 65534) and coop_mode.seat_plays(p.id) and coop_mode.where(p.id) ~= "joining" then
			local se = alife_object(id)
			-- The world owner gets each player's map from the roster, including players with no online object here.
			local map = p.level and alife():level_name(p.level)
			if not map and coop_mode.where(p.id) == "here" then map = level.name() end
			if map and (id == 0 or se) then
				local key = tostring(core.hid(id))
				local record = records[key] or {}
				records[key] = record
				for _, faction in ipairs(tb.tb_factions) do
					local rel = tb.tb_relations[faction]
					local previous = record[faction] or (id == 0 and rel[1]) or pkg.baseline[faction]
					local goodwill = coop_reputation.goodwill_of(faction, id)
					if previous and goodwill >= previous + tb.tb_relation_diff then
						tb.tb_package_queue[#tb.tb_package_queue + 1] = { map, rel[2], character = core.hid(id),
							community = se and se.community and se:community() or "stalker" }
						record[faction] = goodwill
					end
					if previous and not record.intro and goodwill >= previous + 50 then
						record.intro = true
						if id ~= 0 or not tb.tb_sufficient_passed then
							if id == 0 then tb.tb_sufficient_passed = true end
							pkg_news(core.hid(id), game.translate_string("tb_sooner_rf"), rel[2], true)
						end
					end
				end
			end
		end
	end
	if not tb.tb_package_active and tb.tb_package_queue[1] then tb.tb_radio_thing() end
end

local function install_packages()
	local tb = core.mod("tb_rf_receiver_packages")
	if not (tb and rf.IR) then return end
	pkg.TB = tb
	for faction, info in pairs(tb.tb_relations or {}) do pkg.baseline[faction] = info[1] end
	installed[#installed + 1] = "rf_packages"
	local function client_only(name, ret)
		core.wrap(tb, name, "tb_rf_receiver_packages." .. name, function(orig)
			return function(...)
				if core.world_client() then return ret end
				return orig(...)
			end
		end)
	end
	-- The spawning half is the host's.
	core.wrap(tb, "tb_radio_thing", "tb_rf_receiver_packages.tb_radio_thing", function(orig)
		return function(...)
			if not core.active() then return orig(...) end
			if not coop_mode.decides_world() then return false end
			return pkg_spawn_from_queue(orig, ...)
		end
	end)
	client_only("failsafepackagespawn", false)
	client_only("spawn_some_badguys", nil)
	core.wrap(tb, "checkrelationchange", "g96.rf.checkrelationchange", function(orig)
		return function(...)
			if not core.active() then return orig(...) end
			return true -- pkg_tick schedules the world-owner scan, also where the stock timer has no player
		end
	end)
	client_only("remindaboutpackage", true) -- the host's reminders reach everybody as news
	pkg.orig_take = tb.actor_on_item_take
	core.on(PKG_NEWS, pkg_show_news, "player")
	RegisterScriptCallback("load_state", function() pkg.next_goodwill = 0 end)
end

local pkg_rebound = false
local function pkg_tick()
	if not pkg.TB then return end
	if coop_mode.is_player_mirror() and not pkg_rebound then
		pkg_rebound = true
		core.swap_callback("actor_on_item_take", pkg.orig_take, pkg_client_take)
		if custom_functor_autoinject and custom_functor_autoinject.remove_functor then
			pcall(custom_functor_autoinject.remove_functor, "pda_package_cancel") -- cancelling is the host's
		end
	end
	local tg = time_global()
	if tg < pkg.next_tick then return end
	pkg.next_tick = tg + 2000
	local ok, e
	if coop_mode.decides_world() then
		ok, e = pcall(pkg_host_check)
		if tg >= pkg.next_goodwill then
			pkg.next_goodwill = tg + 30000
			local scanned, err = pcall(pkg_goodwill)
			if not scanned then core.report("radio", "package goodwill", err) end
		end
	elseif coop_mode.is_player_mirror() then
		ok, e = pcall(pkg_client_follow)
	else
		return
	end
	if not ok then core.report("radio", "packages", e) end
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
local function actor_on_update()
	if not core.active() then return end
	if rf.IR then rf_tick() end
	fm_tick()
	pkg_tick()
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included.
function on_game_start()
	if not api then return end
	core.install("radio", "install_rf", install_rf)
	core.install("radio", "install_fm", install_fm)
	core.install("radio", "install_packages", install_packages)
	if #installed == 0 then return end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	core.status_line("radio", function()
		return string.format("%s | rf out %d in %d (pending %d) | fm out %d in %d (missing here %d) | packages closed for clients %d",
			table.concat(installed, ", "), st.rf_out, st.rf_in, (function() local n = 0 for _ in pairs(rf.pending) do n = n + 1 end return n end)(),
			st.fm_out, st.fm_in, st.fm_missing, st.pkg_closed)
	end)
end
