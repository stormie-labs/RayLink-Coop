--[[
	Anomaly Coop - co-op debug: the command registry (gamedata\scripts\coop_debug_cmds.script), docs\DEBUG_DESIGN.md B.5, C.

	One table for the world server (coop_debug_server: requests of the players and the server console coop_dbg) and the F7 window
	(package 3: names, classes, keys, help). Loading it changes nothing: the executors run only where coop_debug_server calls them,
	on the world server or on the map server that leads the level (B.6).

	A command: { class, where, args, run, help, stock, [player], [target], [confirm] }
		class    view | world | self | spawn | target: the handler coop.dbg.<class> takes it; operator: the server console only
		where    ws            the world server runs it
		         player_level  the authority of the level of the player it is for (the world server, or his level's map server)
		         target_level  the authority of the level the target object stands on
		args     key -> { kind, [req], [def], [min], [max], [of] }: the flat request table (B.5), checked by validate
		player   the command is for a player: the requester, or @player at the console
		target   kind of the target t: "npc" (stalker or mutant), "stalker", "object" (anything but a player)
		confirm  the window asks before it sends (release, info, release_common_squads, inv_clear)
		run(ctx) -> true, msg[, id] | false, code
			ctx.a       the checked arguments
			ctx.peer    the player it is for (nil: none, a world command from the console)
			ctx.pl      P.player(ctx.peer) on this process (coop_npc_players)
			ctx.obj     the target t as a game object of this process (target commands)
			ctx.obj2    the second party t2 as a game object, else the player's character (relation, goodwill)
			ctx.by      the requester's name, for the log
	Refusal codes (B.5): debug_off old_client unknown_cmd bad_args no_player not_standing bad_target player_target too_far bad_vertex
	other_level cap failed.

	API:
		VERSION                        the schema version of a request (args.v)
		CLASSES                        class -> true
		get(id) -> command | nil
		list([class]) -> { id, ... }   sorted
		validate(id, args) -> true, clean | false, code, why    clean: only the schema's keys, converted (console strings too)
		help(id) -> "id key=... : what"
	Every action keeps the stock arguments and semantics (sources in .stock: S/ = anomaly scripts).
--]]

VERSION = 1
CLASSES = { view = true, world = true, self = true, spawn = true, target = true, operator = true }

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall
local math_floor, math_huge = math.floor, math.huge
local string_format = string.format

local MAX_STR = 64
local MAX_COORD = 100000
local MAX_ID = 65534
local MAX_PEER = 7 -- kMaxPlayers - 1
local MAX_ITEMS = 20 -- n without confirmation
local MAX_ITEMS_ALL = 100 -- n with ok = true (a whole category, confirmed in the window)
local MAX_MONEY = 1000000

-------------------------------------------------------------------------------
-- The stock spawner's class tables (S/ui_debug_launcher.script 1077-1194, 1646-1706). A section spawns as an item or an object
-- only when its class (or its kind) is listed, as in the stock "spawn by name" (1526-1547).
-------------------------------------------------------------------------------
