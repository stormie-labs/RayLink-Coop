cmds.inv_clear = {
	class = "target", where = "target_level", target = "object", args = T(), confirm = true,
	stock = "S/debug_cmd_list.script 1959-1991 inventory_owner removeall", help = "t=<id>: delete everything an NPC or a box holds (K44)",
	run = function(ctx)
		local sim, id, count = alife(), ctx.a.t, 0
		for i = 1, 65534 do
			local se_obj = sim:object(i)
			if se_obj and se_obj.parent_id == id then
				sim:release(se_obj, true)
				count = count + 1
			end
		end
		if count == 0 then return false, "failed" end
		return true, fmt("removed %d children of %s", count, name_of_obj(ctx.obj))
	end,
}

cmds.faction = {
	class = "target", where = "target_level", target = "stalker", args = T(nil, { c = { kind = "name", req = true } }),
	stock = "S/ui_debug_launcher.script 2505-2524 OnButton_Faction (target)", help = "t=<id> c=<community>: his squad's faction (F1)",
	run = function(ctx)
		local communities = utils_obj.get_communities_list()
		local known = false
		for _, c in pairs(communities) do if c == ctx.a.c then known = true end end
		if not known then return false, "bad_args" end
		local squad = get_object_squad(ctx.obj)
		if not squad then return false, "bad_target" end
		local c = 0
		for k in squad:squad_members() do
			local member = db.storage[k.id] and db.storage[k.id].object
			if member and member:alive() then
				member:set_character_community(ctx.a.c, 0, 0)
				for _, community in pairs(communities) do member:set_community_goodwill(community, 0) end
				c = c + 1
			end
		end
		return true, fmt("%d of %s's squad are %s now", c, name_of_obj(ctx.obj), ctx.a.c)
	end,
}

---------------------------------------------------------------- operator (the server console only)
cmds.lua = {
	class = "operator", where = "ws", args = { code = { kind = "code", req = true } },
	stock = "S/debug_cmd_list.script 793 execute; ui_debug_launcher Executer (X3)",
	help = "<code>: run Lua on the world server (the server console only: it runs on the host's PC)",
	run = function(ctx)
		local f, err = loadstring(ctx.a.code)
		if not f then return false, "bad_args", tostring(err) end
		local ok, r = pcall(f)
		if not ok then return false, "failed", tostring(r) end
		return true, fmt("lua: %s", tostring(r))
	end,
}

-------------------------------------------------------------------------------
-- API
-------------------------------------------------------------------------------
function get(id)
	return type(id) == "string" and cmds[id] or nil
end

function list(class)
	local out = {}
	for id, c in pairs(cmds) do
		if class == nil or c.class == class then out[#out + 1] = id end
	end
	table.sort(out)
	return out
end

-- -> true, clean | false, code, why
function validate(id, args)
	local c = get(id)
	if not c then return false, "unknown_cmd", tostring(id) end
	if type(args) ~= "table" then args = {} end
	local clean = {}
	for key, spec in pairs(c.args) do
		local raw = args[key]
		if raw == nil then
			if spec.req then return false, "bad_args", key .. " is missing" end
			clean[key] = spec.def
		else
			local conv = KINDS[spec.kind]
			local v = conv and conv(raw, spec)
			if v == nil then return false, "bad_args", key .. " is not a " .. spec.kind end
			clean[key] = v
		end
	end
	-- items: n <= 20, a whole category (ok, confirmed in the window) <= 100
	if clean.n and (id == "spawn_item") then
		if clean.n > MAX_ITEMS_ALL or (clean.n > MAX_ITEMS and not clean.ok) then return false, "cap", "n" end
	end
	local at = clean.at
	if at == "point" and not (clean.x and clean.y and clean.z and clean.lv) then return false, "bad_args", "at=point needs x y z lv" end
	if at == "smart" and not clean.sm then return false, "bad_args", "at=smart needs sm" end
	if c.check and not c.check(clean) then return false, "bad_args", "nothing to do" end
	return true, clean
end

function help(id)
	local c = get(id)
	if not c then return nil end
	return fmt("%s [%s] %s", id, c.class, c.help)
end
