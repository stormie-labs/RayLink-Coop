-- S/ui_debug_launcher.script 415-437
BASIC_KIT = {
	"device_pda_1", "itm_backpack", "vodka", "bread", "batteries_dead", "detector_radio", "detector_geiger", "lead_box",
	"detector_simple", "medkit", "helm_resp", "wpn_pm", "wpn_knife", "bolt", "device_torch_nv_3",
}

-- the class of a section as the stock spawner reads it: kind wins over class
function section_class(sec)
	local ini = rawget(_G, "ini_sys") or ini_sys
	if not (ini and type(sec) == "string" and ini:section_exist(sec)) then return nil end
	local read = ini.r_string_ex or ini.r_string
	local ok, class = pcall(read, ini, sec, "class")
	local ok2, kind = pcall(read, ini, sec, "kind")
	if ok2 and type(kind) == "string" and kind ~= "" then return kind end
	return ok and class or nil
end

function object_group(sec)
	local c = section_class(sec)
	return c and OBJECT_CLASSES[c] or nil
end

-------------------------------------------------------------------------------
-- Argument kinds
-------------------------------------------------------------------------------
local function finite(n) return type(n) == "number" and n == n and n ~= math_huge and n ~= -math_huge end

local function number_of(v)
	if type(v) == "string" then v = tonumber(v) end
	return finite(v) and v or nil
end

local function whole_of(v)
	local n = number_of(v)
	return n and n == math_floor(n) and n or nil
end

local BOOL_WORDS = {
	["1"] = true, ["true"] = true, on = true, yes = true, start = true,
	["0"] = false, ["false"] = false, off = false, no = false, stop = false,
}

local function bool_of(v)
	if type(v) == "boolean" then return v end
	if type(v) == "number" then
		if v == 1 then return true elseif v == 0 then return false end
		return nil
	end
	if type(v) == "string" then return BOOL_WORDS[v:lower()] end
	return nil
end

local function name_of(v)
	if type(v) == "number" and v == math_floor(v) then v = tostring(v) end
	if type(v) ~= "string" or #v == 0 or #v > MAX_STR then return nil end
	if not v:match("^[%w_%.%-]+$") or v:find("..", 1, true) then return nil end
	return v
end

-- kind -> converter(v, spec) -> value | nil
local KINDS = {
	id = function(v) local n = whole_of(v) return n and n >= 0 and n <= MAX_ID and n or nil end,
	peer = function(v) local n = whole_of(v) return n and n >= 0 and n <= MAX_PEER and n or nil end,
	int = function(v, s)
		local n = whole_of(v)
		if not n or (s.min and n < s.min) or (s.max and n > s.max) then return nil end
		return n
	end,
	num = function(v, s)
		local n = number_of(v)
		if not n or (s.min and n < s.min) or (s.max and n > s.max) then return nil end
		return n
	end,
	coord = function(v) local n = number_of(v) return n and n >= -MAX_COORD and n <= MAX_COORD and n or nil end,
	vertex = function(v) local n = whole_of(v) return n and n >= 0 and n < 4294967295 and n or nil end,
	bool = function(v) return bool_of(v) end,
	name = function(v) return name_of(v) end,
	enum = function(v, s)
		if type(v) ~= "string" then return nil end
		for _, w in ipairs(s.of) do if w == v then return v end end
		return nil
	end,
	item = function(v)
		local sec = name_of(v)
		local c = sec and section_class(sec)
		return c and ITEM_CLASSES[c] and sec or nil
	end,
	object = function(v)
		local sec = name_of(v)
		return sec and object_group(sec) and sec or nil
	end,
	code = function(v) return type(v) == "string" and #v > 0 and #v <= 4096 and v or nil end,
}

-------------------------------------------------------------------------------
-- Helpers of the executors
-------------------------------------------------------------------------------
local function P() return rawget(_G, "coop_npc_players") or coop_npc_players end

local function fmt(f, ...)
	local ok, s = pcall(string_format, f, ...)
	return ok and s or tostring(f)
end

local function name_of_obj(o)
	if not o then return "?" end
	local ok, n = pcall(o.name, o)
	return ok and tostring(n) or "?"
end

local function npc_ok(o) return o and ((IsStalker and IsStalker(o)) or (IsMonster and IsMonster(o))) and true or false end
local function stalker_ok(o) return o and IsStalker and IsStalker(o) and true or false end

-- the stock {pos, lvid, gvid} of an object
local function place_of(o)
	return o:position(), o:level_vertex_id(), o:game_vertex_id()
end

-- the point of a request, checked by the authority of the level: { pos, lvid, gvid } or nil, code
local function point_of(ctx)
	local a, me = ctx.a, ctx.pl and ctx.pl.object and ctx.pl.object()
	if not me then return nil, "no_player" end
	if a.at == "inv" or a.at == "near" then
		local pos, lv, gv = place_of(me)
		return { pos, lv, gv }
	end
	-- at = point: the client's stock formula (S/ui_debug_launcher.script 1461-1467), the server's checks (B.5 step 7)
	local vp = level.vertex_position(a.lv)
	local pos = vector():set(a.x, a.y, a.z)
	local dx, dz = (vp.x or 0) - a.x, (vp.z or 0) - a.z
	if dx * dx + dz * dz > 4 or math.abs((vp.y or 0) - a.y) > 10 then return nil, "bad_vertex" end
	if me:position():distance_to(pos) > 200 then return nil, "too_far" end
	local _, _, gv = place_of(me)
	return { pos, a.lv, gv }
end

local function on_off(v) return v and "on" or "off" end

-------------------------------------------------------------------------------
-- The commands (C.1)
-------------------------------------------------------------------------------
local cmds = {}

local function T(t, extra)
	local out = { t = { kind = "id", req = true } }
	for k, v in pairs(extra or {}) do out[k] = v end
	return out
end

local POINT = {
	x = { kind = "coord" }, y = { kind = "coord" }, z = { kind = "coord" }, lv = { kind = "vertex" },
}
local function with_point(t)
	for k, v in pairs(POINT) do t[k] = v end
	return t
end

---------------------------------------------------------------- view
cmds.obj_info = {
	class = "view", where = "ws", args = T(), stock = "S/ui_debug_launcher.script 115-155 get_info",
	help = "t=<id>: what the server knows of an object (T1)",
	run = function(ctx)
		local id, o = ctx.a.t, ctx.obj
		local se = alife_object(id)
		if not (se or o) then return false, "bad_target" end
		local r = { id = id, msg = fmt("object %s", id) }
		if se then
			r.section = se.section_name and se:section_name() or nil
			r.name = se.name and se:name() or nil
			if se.parent_id and se.parent_id ~= 65535 then r.parent = se.parent_id end
			if se.group_id and se.group_id ~= 65535 then r.squad = se.group_id end
		end
		if o then
			r.section = r.section or o:section()
			r.name = r.name or o:name()
			r.alive = o.alive and o:alive() or false
			if stalker_ok(o) then
				r.community = o:character_community()
				r.rank = o.character_rank and o:character_rank() or nil
				r.reputation = o.character_reputation and o:character_reputation() or nil
				local me = ctx.pl and ctx.pl.object and ctx.pl.object()
				if me and o.general_goodwill then r.goodwill = o:general_goodwill(me) end
				if me and o.relation then r.relation = o:relation(me) end
			end
		end
		r.msg = fmt("%s [%s] (%s)", tostring(r.name), tostring(r.section), id)
		return true, r
	end,
}

cmds.can_see = {
	class = "view", where = "target_level", target = "stalker", player = true, args = T(),
	stock = "S/ui_debug_launcher.script 210-219", help = "t=<id>: can the NPC see me (T8)",
	run = function(ctx)
		local me = ctx.pl.object()
		if not me then return false, "no_player" end
		local sees = ctx.obj:see(me) and true or false
		return true, { msg = fmt("%s %s", name_of_obj(ctx.obj), sees and "sees you" or "does not see you"), sees = sees }
	end,
}

---------------------------------------------------------------- world
cmds.time_add = {
	class = "world", where = "ws",
	args = { d = { kind = "int", min = 0, max = 30, def = 0 }, h = { kind = "int", min = 0, max = 240, def = 0 },
		m = { kind = "int", min = 0, max = 1440, def = 0 } },
	check = function(a) return a.d + a.h + a.m > 0 end,
	stock = "S/debug_cmd_list.script 1463-1474 time; S/ui_sleep_dialog.script 342 sleep",
	help = "d= h= m=: move the clock forward (K35, A16)",
	run = function(ctx)
		local a = ctx.a
		level.change_game_time(a.d, a.h, a.m)
		level_weathers.get_weather_manager():forced_weather_change()
		return true, fmt("time +%dd %dh %dm", a.d, a.h, a.m)
	end,
}

cmds.time_to = {
	class = "world", where = "ws",
	args = { h = { kind = "int", min = 0, max = 23, req = true }, m = { kind = "int", min = 0, max = 59, def = 0 } },
	stock = "coop_dedicated.cpp CCC_CoopTime (forward only)", help = "h= [m=]: forward to that hour (coop_time hh:mm)",
	run = function(ctx)
		local a = ctx.a
		local now = level.get_time_hours() * 60 + level.get_time_minutes()
		local target = a.h * 60 + a.m
		local delta = target > now and target - now or target + 24 * 60 - now
		level.change_game_time(0, math_floor(delta / 60), delta % 60)
		level_weathers.get_weather_manager():forced_weather_change()
		return true, fmt("time to %02d:%02d", a.h, a.m)
	end,
}

cmds.time_factor = {
	class = "world", where = "ws", args = { f = { kind = "num", min = 0.1, max = 1000, req = true } },
	stock = "level.set_time_factor (TimeSync carries it)", help = "f=: game time speed",
