cmds.unlock_routes = {
	class = "world", where = "ws", args = {}, stock = "S/txr_routes.script 1537-1549", help = "unlock every route (A17)",
	run = function()
		if not txr_routes.is_route_left() then return false, "failed" end
		local maps = txr_routes.maps
		for i = 1, #maps do
			for j = 1, #maps do
				txr_routes.open_route(maps[i], maps[j], true)
			end
		end
		return true, "all routes unlocked"
	end,
}

cmds.unlock_ency = {
	class = "world", where = "ws", args = { what = { kind = "enum", of = { "articles", "notes" }, req = true } },
	stock = "S/ui_pda_encyclopedia_tab.script CMD.unlock_all_articles / unlock_all_notes", help = "what=articles|notes (A18-19)",
	run = function(ctx)
		local tab = ui_pda_encyclopedia_tab
		local n = ctx.a.what == "articles" and tab.unlock_all_articles() or tab.unlock_all_notes()
		if not n then return false, "failed" end
		return true, fmt("%s %s unlocked", tostring(n), ctx.a.what)
	end,
}

cmds.release_common_squads = {
	class = "world", where = "ws", args = {}, confirm = true,
	stock = "S/debug_cmd_list.script 2146-2172 alife_release common", help = "remove the common squads (A4, K49 common)",
	run = function()
		local sim, c = alife(), 0
		for id in pairs(SIMBOARD.squads) do
			local se_squad = sim:object(id)
			if se_squad and se_squad.common then
				se_squad:remove_squad()
				c = c + 1
			end
		end
		if c == 0 then return false, "failed" end
		return true, fmt("%d common squads released", c)
	end,
}

-- The stock toggle overrides try_respawn until Lua restarts; the server keeps its own switch and the override reads it.
local respawn_hooked = false
function respawns_hook()
	if respawn_hooked then return end
	local st = smart_terrain and smart_terrain.se_smart_terrain
	if not (st and st.try_respawn) then return end
	local stock = st.try_respawn
	st.try_respawn = function(self, ...)
		local s = alife_storage_manager.get_state()
		if s and s.stop_respawns then return end
		return stock(self, ...)
	end
	respawn_hooked = true
end

cmds.respawns = {
	class = "world", where = "ws", args = { on = { kind = "bool", req = true } },
	stock = "S/ui_debug_launcher.script 385-402 toggle_respawn", help = "on=1|0: A-Life respawns of the smarts (G6)",
	run = function(ctx)
		alife_storage_manager.get_state().stop_respawns = not ctx.a.on
		respawns_hook()
		return true, fmt("respawns %s", on_off(ctx.a.on))
	end,
}

cmds.info = {
	class = "world", where = "ws", confirm = true,
	args = { k = { kind = "enum", of = { "give", "take" }, req = true }, i = { kind = "name", req = true } },
	stock = "S/debug_cmd_list.script 1859-1866 info give|take", help = "k=give|take i=<info>: an infoportion of the world (K43)",
	run = function(ctx)
		if ctx.a.k == "give" then give_info(ctx.a.i) else disable_info(ctx.a.i) end
		return true, fmt("info %s %s", ctx.a.k, ctx.a.i)
	end,
}

---------------------------------------------------------------- self
local function flag_cmd(key, stock, help)
	return {
		class = "self", where = "ws", player = true, args = { on = { kind = "bool", req = true } }, stock = stock, help = help,
		run = function(ctx)
			local d = coop and coop.debug
			if not (d and d.set_flags) then return false, "failed" end
			local ok = d.set_flags(ctx.peer, { [key] = ctx.a.on })
			if ok == false then return false, "failed" end
			return true, fmt("%s %s", key, on_off(ctx.a.on))
		end,
	}
end
cmds.god = flag_cmd("god", "S/ui_debug_launcher.script 71 g_god", "on=1|0: immortal (G1)")
cmds.ammo = flag_cmd("ammo", "S/ui_debug_launcher.script 72 g_unlimitedammo", "on=1|0: unlimited ammo (G2)")
cmds.invis = flag_cmd("invis", "S/debug_cmd_list.script 1314-1329 invisible", "on=1|0: AI does not see you (A1, K31)")

cmds.money = {
	class = "self", where = "ws", player = true, args = { a = { kind = "int", min = -MAX_MONEY, max = MAX_MONEY, req = true } },
	check = function(a) return a.a ~= 0 end,
	stock = "S/debug_cmd_list.script 1476-1482 money", help = "a=<RU>: money, +-1 000 000 at once (A2, K36)",
	run = function(ctx)
		local a = ctx.a.a
		if a < 0 and coop.money_of then
			local have = tonumber(coop.money_of(ctx.peer)) or 0
			if have <= 0 then return false, "failed" end
			if -a > have then a = -have end
		end
		local ok = coop.money_grant(ctx.peer, a)
		if ok == false then return false, "failed" end
		return true, fmt("money %+d", a)
	end,
}

