cmds.surge = {
	class = "world", where = "ws", args = { on = { kind = "bool", req = true } },
	stock = "S/debug_cmd_list.script 2591-2599", help = "start | stop (on=1|0): the emission (A12-13, K14)",
	run = function(ctx)
		if ctx.a.on then
			if not surge_manager.is_finished() then return false, "failed" end
			surge_manager.start_surge()
			return true, "emission started"
		end
		if not surge_manager.is_started() then return false, "failed" end
		surge_manager.stop_surge()
		return true, "emission stopped"
	end,
}

cmds.psi = {
	class = "world", where = "ws", args = { on = { kind = "bool", req = true } },
