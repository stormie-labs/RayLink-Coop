	SM_PSYSUCKER = "npc",
	C_HLCP_S = "vehicle", C_NIVA = "vehicle", SCRPTCAR = "vehicle",
	ON_OFF_S = "squad",
	O_PHYSIC = "physic", O_DSTRBL = "physic", P_DSTRBL = "physic", O_PHYS_S = "physic", O_DSTR_S = "physic", S_INVBOX = "physic",
	O_INVBOX = "physic", S_EXPLO = "physic", II_EXPLO = "physic",
	ZS_MBALD = "anomaly", ZS_GALAN = "anomaly", ZS_MINCE = "anomaly", ZS_RADIO = "anomaly", ZS_TORRD = "anomaly",
	ZS_NGRAV = "anomaly", Z_MBALD = "anomaly", Z_RADIO = "anomaly", Z_CFIRE = "anomaly", Z_NOGRAV = "anomaly", Z_TORRID = "anomaly",
