---------------------------------------------------------------- spawn
cmds.spawn_item = {
	class = "spawn", where = "player_level", player = true, standing = true,
	args = with_point({ sec = { kind = "item", req = true }, n = { kind = "int", min = 1, def = 1 },
		at = { kind = "enum", of = { "inv", "point", "near" }, def = "inv" }, ok = { kind = "bool", def = false } }),
	stock = "S/ui_debug_launcher.script 1447-1485 UIDebug_ItemSpawn:Spawn; S/debug_cmd_list.script 319-421 spawn",
	help = "sec=<section> [n=1..20] [at=inv|point|near] [x= y= z= lv=]: items (I2-I4, I6, K9)",
	run = function(ctx)
		local a = ctx.a
		local where, why = point_of(ctx)
		if not where then return false, why end
		local t = where
		if a.at == "inv" then
			local me = ctx.pl.object()
			t = { where[1], where[2], where[3], me:id() }
		end
		local last
		for _ = 1, a.n do
			local se = alife_create_item(a.sec, { t[1], t[2], t[3], t[4] })
			if se then last = se end
		end
		if not last then return false, "failed" end
		return true, fmt("%s x%d (%s)", a.sec, a.n, a.at), last.id
	end,
}

-- a squad's members as the stock spawner sets them up (S/ui_debug_launcher.script 2024-2042)
local function setup_squad(se_obj, smrt, pos, lv, gv)
	if smrt then se_obj:create_npc(smrt) else se_obj:create_npc(nil, pos, lv, gv) end
	local sim = alife()
	for k in se_obj:squad_members() do
		local se_npc = k.object or k.id and sim:object(k.id)
		if se_npc then
			SIMBOARD:setup_squad_and_group(se_npc)
			SendScriptCallback("squad_on_npc_creation", se_obj, se_npc, smrt)
		end
	end
end

-- S/ui_debug_launcher.script 2045-2057
local function setup_anomaly(se_obj)
	local data = utils_stpk.get_object_data(se_obj)
	if data then
		data.object_flags = 31
		data.restrictor_type = 0
		data.shapes = {}
		data.shapes[1] = {}
		data.shapes[1].shtype = 0
		data.shapes[1].offset = VEC_ZERO
		data.shapes[1].radius = 10
		utils_stpk.set_object_data(data, se_obj)
	end
end

function smart_by_name(name)
	local board = rawget(_G, "SIMBOARD")
	local smrt = board and board.smarts_by_names and board.smarts_by_names[name]
	return smrt
end

cmds.spawn_object = {
	class = "spawn", where = "player_level", player = true, standing = true,
	args = with_point({ sec = { kind = "object", req = true }, at = { kind = "enum", of = { "point", "near", "smart" }, def = "point" },
		sm = { kind = "name" } }),
	stock = "S/ui_debug_launcher.script 1940-2068 UIDebug_ObjSpawn:Spawn",
	help = "sec=<section> [at=point|near|smart] [x= y= z= lv=] [sm=<smart>]: NPC, squad, vehicle, anomaly, physic (O2, O5)",
	run = function(ctx)
		local a = ctx.a
		local pos, lv, gv, smrt
		if a.at == "smart" then
			smrt = smart_by_name(a.sm)
			local se_smart = smrt and alife_object(smrt.id)
			if not se_smart then return false, "bad_args" end
			pos, lv, gv = se_smart.position, se_smart.m_level_vertex_id, se_smart.m_game_vertex_id
		else
			local where, why = point_of(ctx)
			if not where then return false, why end
			pos, lv, gv = where[1], where[2], where[3]
		end
		local se_obj = alife_create(a.sec, pos, lv, gv)
		if not se_obj then return false, "failed" end
		local group = object_group(a.sec)
		if group == "squad" then
			setup_squad(se_obj, smrt, pos, lv, gv)
		elseif group == "anomaly" then
			setup_anomaly(se_obj)
		end
		return true, fmt("%s (%s)", a.sec, a.at == "smart" and a.sm or a.at), se_obj.id
	end,
}

-- the smart nearest to the player on his level (the stock uses smart_terrain.nearest_to_actor_smart: one actor)
local function nearest_smart(me)
	local board = rawget(_G, "SIMBOARD")
	if not (board and board.smarts) then return nil end
	local gg = game_graph()
	local my_level = gg:vertex(me:game_vertex_id()):level_id()
	local best, best_d = nil, math_huge
	for _, s in pairs(board.smarts) do
		local se = s.smrt
		if se and gg:vertex(se.m_game_vertex_id):level_id() == my_level then
			local d = se.position:distance_to_sqr(me:position())
			if d < best_d then best, best_d = se, d end
		end
	end
	return best
end

cmds.test_squad = {
	class = "spawn", where = "player_level", player = true, standing = true,
	args = { n = { kind = "int", min = 1, max = MAX_ITEMS, def = 3 } },
	stock = "S/debug_cmd_list.script 3434-3471 test_squad", help = "[n=3]: a squad of your faction at the nearest smart (K71)",
	run = function(ctx)
		local me = ctx.pl.object()
		local smart = me and nearest_smart(me)
		if not smart then return false, "failed" end
		local sim = alife()
		local se_me = alife_object(me:id())
		local comm = se_me and se_me.community and se_me:community() or "stalker"
		comm = comm:sub(1, 6) == "actor_" and comm:sub(7) or comm
		comm = comm == "dolg" and "duty" or comm
		comm = comm == "army" and "military" or comm
		local npc_sec = fmt("sim_default_%s_0", comm)
		local squad = sim:create("online_offline_group", smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id)
		for _ = 1, ctx.a.n do
			squad:add_squad_member(npc_sec, smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id)
		end
		squad:set_squad_relation()
		squad:refresh()
		SIMBOARD:assign_squad_to_smart(squad, smart.id)
		for k in squad:squad_members() do
			local se_obj = k.object or k.id and sim:object(k.id)
			if se_obj then SIMBOARD:setup_squad_and_group(se_obj) end
		end
		squad.scripted_target = smart:name()
		return true, fmt("%d x %s at %s", ctx.a.n, npc_sec, smart:name()), squad.id
	end,
}

