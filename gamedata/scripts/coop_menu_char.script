--[[
	Anomaly Coop - new character for a joining player (W4 menu), gamedata\scripts\coop_menu_char.script
	Port of xrRazom's peer faction screen on our architecture. Layout: the stock configs\ui\ui_mm_faction_select.xml
	(faction picture, loadout lists, faction popup) plus configs\ui\ui_coop_menu_char.xml (title, info, status).

	When the host creates a fresh proxy for a player (coop_join.cpp create_proxy; spawn -> se_stalker_on_spawn
	here), the proxy is marked "new" in the save's script storage (se_save_var coop_new_char). While a player's
	proxy is new, the host offers the choice to that player. The player picks a faction and buys starting gear
	with points of the host's economy tier, as in Anomaly's new game screen (configs\items\settings\
	new_game_loadouts.ltx: value_1 = false -> free kit, true -> bought with value_3 points, value_4 = highest
	economy tier). The host checks everything again with its own config, then sets the character's money on the host
	ledger (coop.money_set, F2 T6: money is the player's, R-6.7, and the host keeps the books; F2 T6b: first, so that
	a refusal and its retry never touch the inventory), then on the proxy: removes the NPC
	supplies, sets the faction community, spawns the kit (+ ammo for weapons, like the stock new game) and clears
	the mark. Items reach the player through the normal item sync. The client
	sets its own actor_<faction> community only. Returning players (proxy not new) are never asked.

	Events (coop_main.encode payloads, ids in host numbering):
		menu.char_offer      host -> player   { eco, points, nick }            repeated every 60 s while new
		menu.new_character   player -> host   { faction, buy = "sec,sec,..." } bought items only
		menu.char_result     host -> player   { ok, faction, money, items } | { ok = false, reason }

	Protocol 8 (owner, live test 2026-10-23: "first choose the faction, then appear where needed, in my faction"):
	a player whose key has no character chooses BEFORE the world, in the main menu, and the events above are left for
	characters still marked new in an older save. The engine (coop_join.cpp, xrCoop/coop_newchar.h) carries the offer
	and the choice (Msg::CharOffer / Msg::CharChoice) and calls, on the main thread:
		host:   join_terms() -> eco, points, story                the terms of the offer
		        host_plan_character(peer, faction, buy) -> { ok, faction, money, where, x, y, z, lvid, gvid } |
		                                                   { ok = false, reason }
		                                                   the check, and where the character starts (no point: next to
		                                                   the host)
		        host_make_character(peer, proxy, faction, buy) -> true, money, items | false, reason
		                                                   after the engine made the character there (offline, the
		                                                   profile's supplies stripped, the faction's community): kit,
		                                                   ammo and money; the world save follows
		client: join_offer(eco, points, level, refusal, flags) -> shown   the window, main menu or game; refusal is
		                                                   "" in a first offer (a string, never nil), else the host's
		                                                   reason code for the refused choice
		        join_choice() -> faction, buy | nil        what Done gave, taken once
		        join_closed(why)                           the world arrives: the window closes
	Where (host_start, as the stock new game, ui_mm_faction_select.script on_game_load): one of the faction's starts of
	plugins\new_game_start_locations.ltx at random (story mode: only those marked for it). Until split levels (F3a)
	every player is on the host's level: a start on another level does not count; then a camp of the faction on the
	host's level (a smart with base and the faction in misc\simulation_objects_props.ltx), nearest to the host; else
	next to the host. F3a: SPLIT_LEVELS = true (and newchar::kOwnLevels in the engine) keeps the faction's own level.

	Hardcore's new character (F3 Task 10, coop_survival.cpp). A client out of the run who holds USE gets his old character
	retired by the host (his things in a stash at the body, his key gone) and joins the world again: with no character for
	his key the flow above runs as for a new player, in the game this time (the window opens over the level; the answer
	of -coop_autochoose too). The host is his own authority: the engine retires his things into a stash, stands his actor
	up at his arrival point with nothing and 0 RU and fires the callback coop_host_new_character(); here the host chooses
	in the same window, and host_choose_self gives the kit to db.actor with apply_kit (community actor_<faction>, nothing
	of his released: his things went into the stash, what he picked up since stays) and his money on the ledger
	(coop.money_set(0, ...)). Until he is done the actor is marked new (NEW_VAR on id 0, kept in the save): the window
	comes back a minute after Later and after a load.
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall
local string_format = string.format

local PROXY_SECTION = "coop_player_avatar"
local NEW_VAR = "coop_new_char"
local OFFER_EVERY_MS = 60000
local TICK_MS = 2000
local LOADOUTS = "items\\settings\\new_game_loadouts.ltx"
local START_LOCATIONS = "plugins\\new_game_start_locations.ltx"
local HOOK_VAR = "coop_new_char_hook" -- made before the world: the mods' hook waits until the character is online
local STASH_JOINED = "coop_char_joined" -- client: the faction chosen before the world, told once in it
local SESSION_POLL_MS = 250
-- F3a (split levels): true lets a new character start on his faction's own level (newchar::kOwnLevels in the engine)
SPLIT_LEVELS = false

-- Factions a player can pick (the stock screen's list; zombied is a cheat there). Each needs <f>_loadout.
FACTIONS = { "stalker", "bandit", "csky", "dolg", "freedom", "killer", "army", "ecolog", "monolith",
	"renegade", "greh", "isg" }
local FACTION_SET = {}
for _, f in ipairs(FACTIONS) do FACTION_SET[f] = true end
local BASE_FACTIONS = { stalker = true, bandit = true, csky = true, dolg = true, freedom = true, killer = true,
	army = true, ecolog = true, monolith = true }

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	line = "[coop-char] " .. (ok and line or tostring(fmt))
	local pf = rawget(_G, "printf")
	if pf then pcall(pf, "%s", line) end
end

local function tr(id, ...)
	local cm = rawget(_G, "coop_menu")
	if cm == nil then
		local ok, m = pcall(function() return coop_menu end) -- _G.__index loads the script
		cm = ok and m or nil
	end
	if type(cm) == "table" and cm.tr then return cm.tr(id, ...) end
	return game.translate_string(id)
end

local function encode(t) return coop_main.encode(t) end
local function decode(s) return coop_main.decode(s) end

local function now_ms() return time_global and time_global() or 0 end

-------------------------------------------------------------------------------
-- Loadout (shared by the window and the host's check)
-------------------------------------------------------------------------------
local ini_itm_cache = nil
local function ini_itm()
	if not ini_itm_cache then ini_itm_cache = ini_file(LOADOUTS) end
	return ini_itm_cache
end

local function explode(s)
	local t = {}
	for v in tostring(s or ""):gmatch("[^,]+") do t[#t + 1] = (v:gsub("^%s+", ""):gsub("%s+$", "")) end
	return t
end

-- Points budget of an economy tier (1..3), as the stock screen.
function budget(eco, itm)
	itm = itm or ini_itm()
	return itm:r_float_ex("points", "total_points_eco_" .. tostring(eco)) or 1000
end

function faction_money(faction, itm)
	itm = itm or ini_itm()
	local sec = faction .. "_money"
	if itm:section_exist(sec) and itm:line_exist(sec, "money") then
		return math.floor(tonumber(itm:r_float_ex(sec, "money")) or 0)
	end
	return 0
end

-- { free = {sec, ...} (every copy), buy = { sec = {count, cost} }, buy_order = {sec, ...} } or nil.
function read_kit(faction, eco, itm, sys)
	itm, sys = itm or ini_itm(), sys or ini_sys
	local sec_list = tostring(faction) .. "_loadout"
	if not (FACTION_SET[faction] and itm:section_exist(sec_list)) then return nil end
	eco = tonumber(eco) or 1
	local kit = { free = {}, buy = {}, buy_order = {} }
	local n = itm:line_count(sec_list) or 0
	for i = 0, n - 1 do
		local _, sec, value = itm:r_line(sec_list, i, "", "")
		if type(sec) == "string" and sys:section_exist(sec) then
			local t = explode(value)
			local cap = tonumber(t[4])
			if not cap or eco <= cap then
				local count = math.max(0, math.floor(tonumber(t[2]) or 0))
				if t[1] == "false" then
					for _ = 1, count do kit.free[#kit.free + 1] = sec end
				elseif t[1] == "true" and count > 0 then
					if not kit.buy[sec] then kit.buy_order[#kit.buy_order + 1] = sec end
					kit.buy[sec] = { count = count, cost = math.max(0, tonumber(t[3]) or 0) }
				end
			end
		end
	end
	return kit
end

-- Host check of a bought list against the kit: ok, total cost | nil, reason.
function check_buys(kit, buys, points)
	local used, have = 0, {}
	for _, sec in ipairs(buys) do
		local b = kit.buy[sec]
		if not b then return nil, "items" end
		have[sec] = (have[sec] or 0) + 1
		if have[sec] > b.count then return nil, "items" end
		used = used + b.cost
	end
	if used > points then return nil, "points" end
	return true, used
end

-- Ammo for weapons of the kit, as the stock new game (ui_mm_faction_select.on_game_load): { ammo_sec = rounds }.
function ammo_for(items, itm, sys)
	itm, sys = itm or ini_itm(), sys or ini_sys
	local ammo = {}
	for _, sec in ipairs(items) do
		if sys:section_exist(sec) and sys:r_string_ex(sec, "ammo_class") then
			local slot = sys:r_float_ex(sec, "slot")
			local ani_slot = sys:r_float_ex(sec, "animation_slot")
			if slot and ((slot == 0 and ani_slot == 1) or slot == 1 or slot == 2) then
				local sec_ammo = explode(sys:r_string_ex(sec, "ammo_class"))[1]
				local special = itm:r_string_ex("ammo_type_per_wpn", sec)
				if special and sys:section_exist(special) then sec_ammo = special end
				if sec_ammo and sys:section_exist(sec_ammo) then
					local box = sys:r_float_ex(sec_ammo, "box_size") or 50
					local count = itm:r_float_ex("ammo_count", sec_ammo)
					if not count then count = (box < 30) and (2 * box) or box end
					ammo[sec_ammo] = (ammo[sec_ammo] or 0) + count
				end
			end
		end
	end
	return ammo
end

local function host_eco()
	local gd = rawget(_G, "game_difficulties")
	if gd == nil then
		local ok, m = pcall(function() return game_difficulties end)
		gd = ok and m or nil
	end
	local v = gd and gd.get_eco_factor and tonumber(gd.get_eco_factor("type"))
	v = v and math.floor(v) or 1
	return math.max(1, math.min(3, v))
end

-- Host check of a choice with the host's own config and economy tier:
-- { items = {sec, ...} (free kit + bought), money } | nil, reason ("faction", "items", "points").
function plan_kit(faction, buy)
	faction = type(faction) == "string" and faction or ""
	local eco = host_eco()
	local kit = read_kit(faction, eco)
	if not kit then return nil, "faction" end
	local buys = explode(type(buy) == "string" and buy or "")
	if #buys > 64 then return nil, "items" end
	local ok, why = check_buys(kit, buys, budget(eco))
	if not ok then return nil, why end
	local items = {}
	for _, s in ipairs(kit.free) do items[#items + 1] = s end
	for _, s in ipairs(buys) do items[#items + 1] = s end
	return { items = items, money = faction_money(faction) }
end

-------------------------------------------------------------------------------
-- Where a new character starts (protocol 8)
-------------------------------------------------------------------------------
local ini_map_cache = nil
local function ini_map()
	if not ini_map_cache then ini_map_cache = ini_file(START_LOCATIONS) end
	return ini_map_cache
end

-- The starts of a faction as the stock new game lists them (ui_mm_faction_select.script LoadMap, on_game_load):
-- [<faction>_start_locations] id = picture_level[,story]. Story mode lists the ones marked true or false, a game
-- without the story the ones not marked false. { {id, image, x, y, z, lvid, gvid}, ... } in the file's order.
function faction_starts(faction, story, ini)
	ini = ini or ini_map()
	local list = tostring(faction) .. "_start_locations"
	local out = {}
	if not ini:section_exist(list) then return out end
	for i = 0, (ini:line_count(list) or 0) - 1 do
		local _, id, value = ini:r_line(list, i, "", "")
		local t = explode(value)
		local listed
		if story then listed = t[2] == "true" or t[2] == "false" else listed = t[2] ~= "false" end
		if listed and type(id) == "string" and id ~= "" and ini:section_exist(id) then
			local x, y, z = ini:r_float_ex(id, "x"), ini:r_float_ex(id, "y"), ini:r_float_ex(id, "z")
			local lvid, gvid = ini:r_float_ex(id, "lvid"), ini:r_float_ex(id, "gvid")
			if x and y and z and lvid and gvid then
				out[#out + 1] = { id = id, image = t[1], x = x, y = y, z = z, lvid = math.floor(lvid), gvid = math.floor(gvid) }
			end
		end
	end
	return out
end

-- Where a new character of `faction` starts: { where = "start:<id>" | "camp:<smart>", x, y, z, lvid, gvid } or nil
-- (next to the host). opts: level (the level it must be on; nil = any, F3a), level_of(gvid) -> level, story,
-- camp(faction) -> point | nil (a camp of the faction on that level), pick(n) -> 1..n.
function start_for(faction, opts)
	local here = {}
	for _, s in ipairs(faction_starts(faction, opts.story)) do
		if opts.level == nil or opts.level_of(s.gvid) == opts.level then here[#here + 1] = s end
	end
	if #here > 0 then
		local s = here[math.max(1, math.min(#here, tonumber(opts.pick(#here)) or 1))]
		s.where = "start:" .. s.id
		return s
	end
	local camp = opts.camp and opts.camp(faction)
	if camp then
		camp.where = "camp:" .. tostring(camp.id)
		return camp
	end
	return nil
end

local function level_of(gvid)
	local gg = game_graph and game_graph()
	if not (gg and type(gvid) == "number" and gg:valid_vertex_id(gvid)) then return nil end
	return gg:vertex(gvid):level_id()
end

-- Host: the nearest smart terrain of the level that is a base of the faction (misc\simulation_objects_props.ltx
-- base = 1 and <faction> = 1: squads of the faction live there), or nil.
function faction_camp(faction, level, from)
	local board = rawget(_G, "SIMBOARD")
	if not (board and type(board.smarts) == "table" and level ~= nil) then return nil end
	local best, best_d
	for _, s in pairs(board.smarts) do
		local smart = type(s) == "table" and s.smrt
		local props = smart and smart.props
		if props and (tonumber(props.base) or 0) > 0 and (tonumber(props[faction]) or 0) > 0
			and level_of(smart.m_game_vertex_id) == level then
			local p = smart.position
			local d = 0
			if from then d = (p.x - from.x) ^ 2 + (p.y - from.y) ^ 2 + (p.z - from.z) ^ 2 end
			if not best or d < best_d then best, best_d = smart, d end
		end
	end
	if not best then return nil end
	local p = best.position
	return { id = best:name(), x = p.x, y = p.y, z = p.z, lvid = best.m_level_vertex_id, gvid = best.m_game_vertex_id }
end

local function story_mode()
	local h = rawget(_G, "has_alife_info")
	return not (h and h("story_mode_disabled"))
end

-- Host: the start of a new character of `faction` (start_for with the host's level, its story mode, its camps).
function host_start(faction)
	local actor = db and db.actor
	local level = actor and level_of(actor:game_vertex_id())
	if level == nil and not SPLIT_LEVELS then return nil end
	local from = actor and actor:position()
	return start_for(faction, {
		level = (not SPLIT_LEVELS) and level or nil,
		level_of = level_of,
		story = story_mode(),
		camp = function(f) return faction_camp(f, level, from) end,
		pick = function(n) return math.random(n) end,
	})
end

-------------------------------------------------------------------------------
-- Host
-------------------------------------------------------------------------------
function is_new(proxy_id)
	return proxy_id ~= nil and se_load_var(proxy_id, nil, NEW_VAR) == true
end

-- se_stalker_on_spawn (host only, [callbacks_host]): a proxy made just now is a new character.
local function se_stalker_on_spawn(se)
	if not (api and api.is_host()) then return end
	local ok, sec = pcall(function() return se:section_name() end)
	if ok and sec == PROXY_SECTION then
		se_save_var(se.id, se:name(), NEW_VAR, true)
		log("proxy %d is a new character: the player chooses faction and gear", se.id)
	end
end

local function nick_of(peer)
	for _, p in ipairs(api.players()) do
		if p.id == peer then return tostring(p.nick) end
	end
	return "?"
end

-- Other groups' start kit of a new character (W5: Mags Redux magazines, coop_mods_core listeners). Needs the
-- character in the world (its game object).
function new_character_hook(peer)
	local mc = rawget(_G, "coop_mods_core")
	if mc and type(mc.on_new_character) == "function" then
		local okm, errm = pcall(mc.on_new_character, peer)
		if not okm then log("! new character hook: %s", tostring(errm)) end
	end
end

function host_news(peer, faction)
	local nick = nick_of(peer)
	pcall(function()
		db.actor:give_game_news("Co-op", tr("st_coop_char_host_news", nick, game.translate_string("st_faction_" .. faction)),
			"ui_iconsTotal_grouping", 0, 6000)
	end)
end

local offered = {} -- peer -> time of the next offer
local SELF_ID = 0 -- the host's actor (F3 Task 10: his own new character)
local self_next_offer = 0 -- when the host's own choice window comes again (after Later, after a load)

local function host_tick()
	local seen = {}
	local t = now_ms()
	-- F3 Task 10: the host's own new character waits for his choice
	if is_new(SELF_ID) and db and db.actor and t >= self_next_offer then
		self_next_offer = t + OFFER_EVERY_MS
		host_offer_self()
	end
	for _, p in ipairs(api.players()) do
		if not p.is_self then
			seen[p.id] = true
			-- protocol 8: a character made before the world gets the mods' kit once it is in the world
			if p.avatar_id and se_load_var(p.avatar_id, nil, HOOK_VAR) == true and level.object_by_id(p.avatar_id) then
				se_save_var(p.avatar_id, nil, HOOK_VAR, nil)
				new_character_hook(p.id)
			end
			if p.avatar_id and is_new(p.avatar_id) then
				if not offered[p.id] or t >= offered[p.id] then
					offered[p.id] = t + OFFER_EVERY_MS
					local eco = host_eco()
					api.send_event("menu.char_offer", encode({ eco = eco, points = budget(eco), nick = p.nick }), p.id)
				end
			else
				offered[p.id] = nil
			end
		end
	end
	for id in pairs(offered) do
		if not seen[id] then offered[id] = nil end
	end
end

local function reply(to, t)
	api.send_event("menu.char_result", encode(t), to)
end

-- Replaces the proxy's supplies with the kit. Online proxy only (it stands where its player is). F3 Task 10, the host's
-- own new character: `community` actor_<faction> and `keep` (nothing of his is released: his things went into the stash,
-- what he picked up since is his).
local function apply_kit(npc, community, items, keep)
	local old = {}
	if not keep then
		npc:iterate_inventory(function(_, item)
			if item then old[#old + 1] = item:id() end
		end, npc)
		for _, id in ipairs(old) do
			alife_release_id(id)
		end
	end
	npc:set_character_community(community, 0, 0)
	local n = 0
	for _, sec in ipairs(items) do
		if alife_create_item(sec, npc) then n = n + 1 end
	end
	for sec, cnt in pairs(ammo_for(items)) do
		if alife_create_item(sec, npc, { ammo = cnt }) then n = n + 1 end
	end
	return #old, n
end

local function on_new_character(payload, from)
	if not (api and api.is_host()) or type(from) ~= "number" or from == 0 then return end
	local t = decode(payload)
	local proxy = api.avatar_of(from)
	if not proxy then return reply(from, { ok = false, reason = "no_character" }) end
	if not is_new(proxy) then return reply(from, { ok = false, reason = "not_new" }) end
	local faction = type(t.faction) == "string" and t.faction or ""
	local plan, why = plan_kit(faction, t.buy)
	if not plan then return reply(from, { ok = false, reason = why }) end
	local npc = level.object_by_id(proxy)
	if not npc then return reply(from, { ok = false, reason = "busy" }) end

	local items = plan.items
	local money = faction_money(faction)
	-- F2 T6: the character's money is the host ledger's; the client's balance follows with the engine's reply.
	-- F2 T6b: the money is set BEFORE the kit. A refusal then leaves the character as it is (the kit replaces the whole
	-- inventory, so a retry after a kit that was already made would wipe and spawn everything a second time). The "new"
	-- mark is cleared only when both are done: a refusal or a failed kit leaves the player his choice window to try
	-- again, and the retry sets the same money again (a set, not an add).
	local set_ok, set_why = false, "coop.money_set is missing"
	if type(api.money_set) == "function" then set_ok, set_why = api.money_set(from, money) end
	if not set_ok then
		log("! money of player #%d not set, the choice stays open: %s", from, tostring(set_why))
		return reply(from, { ok = false, reason = "busy" })
	end
	local ok2, removed, given = pcall(apply_kit, npc, faction, items)
	if not ok2 then
		log("! kit for player #%d failed: %s", from, tostring(removed))
		return reply(from, { ok = false, reason = "busy" })
	end
	se_save_var(proxy, nil, NEW_VAR, nil)
	offered[from] = nil
	log("player #%d: faction %s, %d NPC item(s) removed, %d item(s) given, money %d", from, faction, removed, given, money)
	reply(from, { ok = true, faction = faction, money = money, items = given })
	new_character_hook(from)
	host_news(from, faction)
end

-------------------------------------------------------------------------------
-- Host: a new character before the world (protocol 8; the engine's calls, see the header)
-------------------------------------------------------------------------------
-- The terms of the offer: the host's economy tier, the points it gives, and whether its game has the story on (which
-- faction starts count, shown in the window).
function join_terms()
	local eco = host_eco()
	return eco, budget(eco), story_mode()
end

-- The engine has a choice of player `peer`: refused, or accepted with the start of the character.
function host_plan_character(peer, faction, buy)
	if not (api and api.is_host()) then return { ok = false, reason = "busy" } end
	local plan, why = plan_kit(faction, buy)
	if not plan then
		log("player #%s: choice refused (%s)", tostring(peer), tostring(why))
		return { ok = false, reason = why }
	end
	local t = { ok = true, faction = faction, money = plan.money }
	local ok, s = pcall(host_start, faction)
	if not ok then log("! start of %s: %s", tostring(faction), tostring(s)) end
	if ok and s then
		t.where, t.x, t.y, t.z, t.lvid, t.gvid = s.where, s.x, s.y, s.z, s.lvid, s.gvid
	end
	return t
end

-- The engine made the character (`proxy`, offline, its profile's supplies stripped, the faction's community): the
-- kit, its ammo and the faction's money, as the in-world choice does; the world save follows. On false the engine
-- releases the character and offers the choice again.
function host_make_character(peer, proxy, faction, buy)
	if not (api and api.is_host()) then return false, "busy" end
	local plan, why = plan_kit(faction, buy)
	if not plan then return false, why end
	local se = alife_object(proxy)
	if not se then return false, "no_character" end
	local given = 0
	for _, sec in ipairs(plan.items) do
		if alife_create_item(sec, se) then given = given + 1 end
	end
	for sec, cnt in pairs(ammo_for(plan.items)) do
		if alife_create_item(sec, se, { ammo = cnt }) then given = given + 1 end
	end
	local set_ok, set_why = false, "coop.money_set is missing"
	if type(api.money_set) == "function" then set_ok, set_why = api.money_set(peer, plan.money) end
	if not set_ok then
		log("! money of player #%s not set: %s", tostring(peer), tostring(set_why))
		return false, "busy"
	end
	se_save_var(proxy, nil, NEW_VAR, nil)
	se_save_var(proxy, nil, HOOK_VAR, true)
	log("player #%s: new character %d, faction %s, %d item(s), money %d, before the world", tostring(peer), proxy,
		tostring(faction), given, plan.money)
	host_news(peer, faction)
	return true, plan.money, given
end

-------------------------------------------------------------------------------
-- Client: the choice window
-------------------------------------------------------------------------------
local offer = nil -- last offer { eco, points, nick } (protocol 8 adds join = true, level, story, refusal)
local state = { show = false, waiting = false, done = false }
local join = { choice = nil } -- protocol 8: what Done gave, until the engine takes it (join_choice)
GUI = nil

local function unlocked_factions()
	local out = {}
	for f in pairs(BASE_FACTIONS) do out[f] = true end
	local c = axr_main and axr_main.config
	for _, f in ipairs({ "renegade", "greh", "isg" }) do
		if c and c:r_value("unlocked_factions", f, 1) == true then out[f] = true end
	end
	return out
end

local FACTION_CELL = {
	stalker = { 1, 1 }, bandit = { 1, 2 }, csky = { 1, 3 },
	dolg = { 2, 1 }, freedom = { 2, 2 }, killer = { 2, 3 },
	army = { 3, 1 }, ecolog = { 3, 2 }, monolith = { 3, 3 },
	renegade = { 4, 1 }, greh = { 4, 2 }, isg = { 4, 3 },
}

-- Levels with a picture in the stock new game screen (configs\ui\textures_descr\ui_new_game.xml: ui_new_game_map_<level>).
local LEVEL_PICTURES = {
	l01_escape = true, l02_garbage = true, l03_agroprom = true, l03u_agr_underground = true, l04_darkvalley = true,
	l05_bar = true, l06_rostok = true, l07_military = true, l08_yantar = true, l09_deadcity = true, l10_limansk = true,
	l10_radar = true, l10_red_forest = true, l11_hospital = true, l11_pripyat = true, l12_stancia = true,
	k00_marsh = true, k01_darkscape = true, k02_trucks_cemetery = true, jupiter = true, pripyat = true, zaton = true,
}

local C_LABEL, C_VALUE = "%c[255,150,150,150]", "%c[255,225,225,225]"
local C_READY, C_WAIT, C_BAD = "%c[255,170,170,170]", "%c[255,240,200,120]", "%c[255,240,120,100]"

local function host_nick()
	for _, p in ipairs(api and api.players() or {}) do
		if p.id == 0 then return tostring(p.nick or "?") end
	end
	return "?"
end

local function level_name()
	local ok, n = pcall(function() return level.name() end)
	return ok and type(n) == "string" and n or nil
end

-- The player's colour (W6 palette, slot = peer id): r, g, b.
local function own_color()
	local al = rawget(_G, "coop_allies")
	if al == nil then
		local ok, m = pcall(function() return coop_allies end)
		al = ok and m or nil
	end
	local peer = api and api.self_id and api.self_id() or 1
	if type(al) == "table" and al.color then
		local ok, r, g, b = pcall(al.color, peer)
		if ok and r then return r, g, b end
	end
	return 83, 140, 224
end

class "UICoopNewChar" (CUIScriptWnd)

function UICoopNewChar:__init() super()
	self.factions = unlocked_factions()
	self.faction = "stalker"
	self.access = true
	self.points_left, self.points_used = 0, 0
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:Enable(true)
	self:InitControls()
	self:InitCallbacks()
	self:PopupFaction(false)
end

function UICoopNewChar:__finalize()
end

-- Layout: the stock new game screen (ui_mm_faction_select.xml, its _16 twin on wide screens) in the stock drawing
-- order, plus ui_coop_menu_char.xml (_16) where the stock screen has the start map, the portrait, the start list
-- and the game options: level picture under the description, the player's colour, the start line, and the
-- bottom panel with what this is, the host's rules and the host's answer.
function UICoopNewChar:InitControls()
	local xml = CScriptXmlInit()
	self.xml = xml
	xml:ParseFile("ui_mm_faction_select.xml") -- stock layout, so faction screen skins apply here too
	local own = CScriptXmlInit()
	self.own = own
	own:ParseFile("ui_coop_menu_char.xml")

	own:InitFrame("coop_shade", self)
	self.dialog = xml:InitStatic("main_dialog:frame_back", self)
	-- under the frame art
	self.box_map = xml:InitStatic("main_dialog:box_map", self.dialog)
	self.map_dim = own:InitStatic("coop_char:map_dim", self.dialog)
	self.box_faction = xml:InitStatic("main_dialog:box_faction", self.dialog)
	own:InitStatic("coop_char:color_bg", self.dialog)
	self.color_icon = own:InitStatic("coop_char:color_icon", self.dialog)
	self.box_item = xml:InitStatic("main_dialog:box_item", self.dialog)
	self.box_item_temp = xml:InitStatic("main_dialog:box_item", self.dialog)
	xml:InitStatic("main_dialog:frame_front", self.dialog)

	-- stock texts
	self.text_descr = xml:InitTextWnd("main_dialog:text_descr", nil)
	self.scroll_desc = xml:InitScrollView("main_dialog:scroll_desc", self.dialog)
	self.scroll_desc:AddWindow(self.text_descr, true)
	self.text_descr:SetAutoDelete(false)

	self.name = xml:InitTextWnd("main_dialog:input_name", self.dialog) -- the nickname, shown only
	self.text_relations = xml:InitTextWnd("main_dialog:text_relations", self.dialog)
	self.text_money = xml:InitTextWnd("main_dialog:text_money", self.dialog)
	self.text_points_left = xml:InitTextWnd("main_dialog:text_points_left", self.dialog)
	self.text_points_used = xml:InitTextWnd("main_dialog:text_points_used", self.dialog)
	for _, cap in ipairs({ "cap_character", "cap_inventory", "cap_loadout", "cap_name", "cap_money",
		"cap_points_left", "cap_points_used" }) do
		xml:InitStatic("main_dialog:" .. cap, self.dialog)
	end

	-- co-op texts
	own:InitStatic("coop_char:color_cap", self.dialog)
	self.start = own:InitTextWnd("coop_char:start", self.dialog)
	own:InitStatic("coop_char:cap", self.dialog)
	self.info = own:InitTextWnd("coop_char:info", self.dialog)
	own:InitStatic("coop_char:sep", self.dialog)
	self.facts = own:InitTextWnd("coop_char:facts", self.dialog)
	own:InitStatic("coop_char:status_bg", self.dialog)
	self.status = own:InitTextWnd("coop_char:status", self.dialog)

	self.btn_start = own:Init3tButton("coop_char:btn_start", self.dialog)
	self:Register(self.btn_start, "btn_start")
	self.btn_back = own:Init3tButton("coop_char:btn_later", self.dialog) -- Later; Leave before the world (protocol 8)
	self:Register(self.btn_back, "btn_back")
	self:Register(xml:Init3tButton("main_dialog:btn_faction", self.dialog), "btn_faction")

	self.CC = {}
	self.CC.inventory = utils_ui.UICellContainer("inventory", self, nil, "main_dialog:cont_inv", self.dialog)
	self.CC.loadout = utils_ui.UICellContainer("loadout", self, nil, "main_dialog:cont_loadout", self.dialog)
	for _, cc in pairs(self.CC) do
		cc.showcase = true
		cc.disable_drag = true
		cc.disable_stack = true
		cc:SetGridSpecs(35, 2)
	end
	self.ck_reset = xml:Init3tButton("main_dialog:check_reset", self.dialog)
	self:Register(self.ck_reset, "check_reset")

	-- faction popup
	self.black_1 = xml:InitStatic("main_dialog:popup_faction:frame_black", self.dialog)
	self.dialog_1 = xml:InitStatic("main_dialog:popup_faction:frame", self.dialog)
	self.cap_faction = xml:InitStatic("main_dialog:popup_faction:cap_faction", self.dialog_1)
	self.scroll_faction = xml:InitScrollView("main_dialog:popup_faction:scroll_faction", self.dialog_1)

	self.item_info = utils_ui.UIInfoItem(self, 1000)
	self.hint_wnd = utils_ui.UIHint(self)
end

function UICoopNewChar:InitCallbacks()
	local E = ui_events.BUTTON_CLICKED
	self:AddCallback("btn_start", E, self.OnStart, self)
	self:AddCallback("btn_back", E, self.OnLater, self)
	self:AddCallback("btn_faction", E, self.OnFactionClicked, self)
	self:AddCallback("check_reset", E, self.OnReset, self)
	for _, f in ipairs(FACTIONS) do
		self:AddCallback("btn_" .. f, E, function() self:OnFactionSelect(f) end, self)
	end
end

-- The level the character appears on: before the world (protocol 8) the host's, from the offer; in the world the
-- level the player is on now (the host's world).
function UICoopNewChar:Level()
	local o = self.offer or {}
	if o.join then return o.level end
	return level_name()
end

-- New offer (or the same again): texts, points of the host's tier, lists.
function UICoopNewChar:Fill(o)
	self.offer = o
	local nick = tostring(o.nick or "")
	self.name:SetText(nick)
	self.info:SetText(tr(o.join and "st_coop_char_info_join" or "st_coop_char_info", host_nick(), nick))
	self.btn_back:TextControl():SetText(tr(o.join and "st_coop_char_btn_leave" or "st_coop_char_btn_later"))
	if o.refusal then
		self:SetStatus("bad", tr("st_coop_char_refused", tr("st_coop_char_reason_" .. o.refusal)))
	else
		self:SetStatus("ready")
	end
	self.access = true
	self.btn_start:Enable(true)
	local lvl = self:Level()
	if lvl and LEVEL_PICTURES[lvl] then
		self.box_map:InitTexture("ui_new_game_map_" .. lvl)
		self.box_map:SetStretchTexture(true)
		self.box_map:Show(true)
		self.map_dim:Show(true)
	else
		self.box_map:Show(false)
		self.map_dim:Show(false)
	end
	local r, g, b = own_color()
	self.color_icon:SetTextureColor(GetARGB(255, r, g, b))
	self:UpdateAll()
end

-- Start line. In the world: next to the group on this level. Before the world (protocol 8): what the host will do with
-- the chosen faction (host_start): its start on the host's level, else a camp of it there or next to the group.
function UICoopNewChar:UpdateStart()
	local o = self.offer or {}
	local lvl = self:Level()
	local lvl_name = lvl and game.translate_string(lvl)
	if not (lvl_name and lvl_name ~= "" and lvl_name ~= lvl) then lvl_name = nil end
	if o.join and lvl then
		local here = start_preview(self.faction, lvl, o.story) == "start"
		self.start:SetText(tr(here and "st_coop_char_start_faction" or "st_coop_char_start_camp", lvl_name or lvl))
	elseif lvl_name and not o.join then
		self.start:SetText(tr("st_coop_char_start", lvl_name))
	else
		self.start:SetText(tr("st_coop_char_start_near"))
	end
end

-- Status line of the bottom panel: "ready" (hint), "waiting", or a refusal text.
function UICoopNewChar:SetStatus(kind, text)
	if kind == "ready" then
		local join_mode = self.offer and self.offer.join
		self.status:SetText(C_READY .. tr(join_mode and "st_coop_char_ready_join" or "st_coop_char_ready"))
	elseif kind == "waiting" then
		self.status:SetText(C_WAIT .. tr("st_coop_char_waiting"))
	else
		self.status:SetText(C_BAD .. tostring(text or ""))
	end
end

-- Host's rules for this character (right part of the bottom panel); money follows the chosen faction.
function UICoopNewChar:UpdateFacts()
	local o = self.offer or {}
	local eco = math.max(1, math.min(3, tonumber(o.eco) or 1))
	local points = tonumber(o.points) or budget(eco)
	local rows = {
		{ "st_coop_char_host", host_nick() },
		{ "st_coop_char_eco", game.translate_string("st_econ_" .. eco) },
		{ "st_coop_char_points", tostring(math.floor(points)) },
		{ "st_coop_char_money", tostring(faction_money(self.faction)) .. " RU" },
	}
	local parts = {}
	for _, row in ipairs(rows) do
		parts[#parts + 1] = C_LABEL .. tr(row[1]) .. " " .. C_VALUE .. tostring(row[2])
	end
	self.facts:SetText(table.concat(parts, "\\n"))
end

function UICoopNewChar:UpdateAll()
	local f = self.faction
	self.box_faction:InitTexture("ui_new_game_flair_" .. f)
	self.box_faction:SetStretchTexture(true)
	self.text_money:SetText(tostring(faction_money(f)) .. " RU")
	self:UpdateFacts()
	self:UpdateStart()
	self:UpdateDescr()
	self:LoadLoadout()
end

function UICoopNewChar:UpdateDescr()
	local f = self.faction
	local desc = "%c[0,250,250,250]" .. game.translate_string("st_mm_new_game_description")
		.. "\\n%c[0,150,150,150]" .. game.translate_string("st_faction_" .. f .. "_desc")
	self.text_descr:SetText(desc)
	self.text_descr:AdjustHeightToText()
	self.text_descr:SetWndSize(vector2():set(self.text_descr:GetWidth(), self.text_descr:GetHeight() + 10))
	self.scroll_desc:Clear()
	self.scroll_desc:AddWindow(self.text_descr, true)
	self.text_descr:SetAutoDelete(false)

	local rel = "%c[0,250,250,250]" .. game.translate_string("st_mm_new_game_relations") .. " \\n"
	for _, k in ipairs(FACTIONS) do
		if k ~= f and BASE_FACTIONS[k] then
			local r = relation_registry.community_relation("actor_" .. f, k)
			local clr = r >= 1000 and "%c[0,50,175,50]" or (r <= -1000 and "%c[0,175,50,50]" or "%c[0,175,175,50]")
			rel = rel .. "%c[0,150,150,150]" .. string.char(149) .. " " .. clr .. game.translate_string("st_faction_" .. k) .. "\\n"
		end
	end
	self.text_relations:SetText(rel)
	self.text_relations:AdjustHeightToText()
end

function UICoopNewChar:LoadLoadout()
	local o = self.offer or {}
	local kit = read_kit(self.faction, o.eco) or { free = {}, buy = {}, buy_order = {} }
	self.points_used = 0
	self.points_left = tonumber(o.points) or budget(o.eco or 1)
	local t_inv, p_inv, t_buy, p_buy = {}, {}, {}, {}
	for _, sec in ipairs(kit.free) do
		t_inv[#t_inv + 1] = sec
		p_inv[#p_inv + 1] = 0
	end
	for _, sec in ipairs(kit.buy_order) do
		local b = kit.buy[sec]
		for _ = 1, b.count do
			t_buy[#t_buy + 1] = sec
			p_buy[#p_buy + 1] = b.cost
		end
	end
	self.CC.inventory:Reinit(t_inv, p_inv)
	self.CC.loadout:Reinit(t_buy, p_buy)
	for _, name in ipairs({ "inventory", "loadout" }) do
		for _, ci in pairs(self.CC[name].cell) do
			if ci:IsShown() then
				local val = ci.flags.info or 0
				ci.flags.value = val
				ci.flags.value_str = game.translate_string("st_mm_new_game_points") .. ": " .. val
			end
		end
	end
	self:ShowPoints()
end

function UICoopNewChar:ShowPoints()
	self.text_points_used:SetText(tostring(self.points_used))
	self.text_points_left:SetText(tostring(self.points_left))
end

-- Bought items = cells of the inventory list with a price (the free kit costs 0).
function UICoopNewChar:Bought()
	local out = {}
	for _, ci in pairs(self.CC.inventory.cell) do
		if ci:IsShown() and ci.section and (ci.flags.value or 0) > 0 then
			for _ = 1, ci:CountChilds() + 1 do out[#out + 1] = ci.section end
		end
	end
	return out
end

function UICoopNewChar:On_CC_Mouse1(cont, idx)
	if not self.access then return end
	local ci = self.CC[cont] and self.CC[cont].cell[idx]
	if not (ci and ci.flags.value and ci.flags.value > 0) then return end
	local to_inv = cont == "loadout"
	local delta = to_inv and ci.flags.value or -ci.flags.value
	if self.points_left - delta < 0 then return end
	self.points_used = self.points_used + delta
	self.points_left = self.points_left - delta
	self:ShowPoints()
	self.CC[cont]:TransferItem(self.CC[to_inv and "inventory" or "loadout"], nil, ci.section)
end

function UICoopNewChar:PopupFaction(state_)
	self.black_1:Show(state_)
	self.dialog_1:Show(state_)
	self.cap_faction:Show(state_)
	self.scroll_faction:Clear()
	self.access = not state_
	if not state_ then return end
	local list = {}
	for _, f in ipairs(FACTIONS) do
		if self.factions[f] then list[#list + 1] = f end
	end
	local rows = math.ceil(#list / 3)
	local holder = self.xml:InitStatic("main_dialog:popup_faction:templ_faction", nil)
	local w, h = self.scroll_faction:GetWidth(), self.scroll_faction:GetHeight()
	for _, f in ipairs(list) do
		local b = self.xml:Init3tButton("main_dialog:popup_faction:btn_" .. f, holder)
		local cell = FACTION_CELL[f]
		local bw, bh = b:GetWidth(), b:GetHeight()
		local off_x, off_y = (w - bw * 3) / 4, (h - bh * rows) / (rows + 1)
		b:SetWndPos(vector2():set(off_x * cell[2] + bw * (cell[2] - 1), off_y * cell[1] + bh * (cell[1] - 1)))
		self:Register(b, "btn_" .. f)
	end
	self.scroll_faction:AddWindow(holder, true)
	holder:SetAutoDelete(false)
end

function UICoopNewChar:OnFactionClicked()
	if self.access and not state.waiting then self:PopupFaction(true) end
end

function UICoopNewChar:OnFactionSelect(f)
	if not self.factions[f] then return end
	self.faction = f
	self:PopupFaction(false)
	self:UpdateAll()
end

function UICoopNewChar:OnReset()
	if self.access and not state.waiting then self:LoadLoadout() end
end

function UICoopNewChar:OnStart()
	if not self.access or state.waiting then return end
	local buy = table.concat(self:Bought(), ",")
	if self.offer and self.offer.host_self then
		-- F3 Task 10: the host's own new character; he is his own authority, no event goes anywhere
		local ok, why = host_choose_self(self.faction, buy)
		if not ok then self:SetStatus("bad", tr("st_coop_char_refused", tr("st_coop_char_reason_" .. tostring(why)))) end
		return
	end
	if self.offer and self.offer.join then
		-- protocol 8: the engine takes it (join_choice) and sends it to the host as a CharChoice
		join.choice = { faction = self.faction, buy = buy }
		state.waiting = true
		self.btn_start:Enable(false)
		self:SetStatus("waiting")
		log("choice made before the world: %s, bought: %s", self.faction, buy ~= "" and buy or "-")
		return
	end
	local ok, why = api.send_event("menu.new_character", encode({ faction = self.faction, buy = buy }), 0)
	if not ok then
		self:SetStatus("bad", tr("st_coop_char_refused", tostring(why)))
		return
	end
	state.waiting = true
	self.btn_start:Enable(false)
	self:SetStatus("waiting")
	log("choice sent: %s, bought: %s", self.faction, buy ~= "" and buy or "-")
end

function UICoopNewChar:OnLater()
	if not self.access then return end
	if self.offer and self.offer.join then
		-- protocol 8: no world without a character: Leave ends the session (the co-op menu shows it)
		self:Close()
		offer, join.choice, state.waiting = nil, nil, false
		log("left the session from the choice window")
		if api and api.disconnect then pcall(api.disconnect) end
		return
	end
	if self.offer and self.offer.host_self then
		self_next_offer = now_ms() + OFFER_EVERY_MS -- F3 Task 10: the host's own window comes back a minute from now
	end
	self:Close()
	pcall(function() db.actor:give_game_news("Co-op", tr("st_coop_char_later_hint"), "ui_iconsTotal_grouping", 0, 5000) end)
end

function UICoopNewChar:Close()
	if self:IsShown() then self:HideDialog() end
end

-- Protocol 8: the window before the world follows the session: it ended (kicked, the host left) or the world is
-- loading (join_closed did not come): closed.
function UICoopNewChar:FollowSession()
	if not (self.offer and self.offer.join and api and api.session_info) then return end
	local now = now_ms()
	if now < (self.next_session_poll or 0) then return end
	self.next_session_poll = now + SESSION_POLL_MS
	local ok, info = pcall(api.session_info)
	if not ok or type(info) ~= "table" then return end
	local phase = tostring(info.phase or "")
	if not info.active or not (phase == "receiving-world" or phase == "handshaked" or phase == "connecting") then
		log("choice window closed: session %s", info.active and phase or "ended")
		join_closed(phase)
	end
end

function UICoopNewChar:Update()
	CUIScriptWnd.Update(self)
	self:FollowSession()
	if self.access then
		local found = false
		for _, cc in pairs(self.CC) do
			if cc:IsShown() then found = cc:Update(self.item_info) or found end
		end
		if not found then self.item_info:Update() end
	end
	self.hint_wnd:Update()
end

function UICoopNewChar:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false then
		for _, cc in pairs(self.CC) do
			if cc:IsShown() then cc:OnKeyboard(dik, keyboard_action) end
		end
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
			if not self.access then
				self:PopupFaction(false)
			elseif not (self.offer and self.offer.join) then -- before the world Escape does not leave the session
				self:OnLater()
			end
			return true
		end
	end
	return res
end

-- The branch join_offer / show_window took, logged the first time it is taken: the engine calls join_offer again every
-- 500 ms while it returns false, the client tick calls show_window every 2 s. Night run 1 (2026-10-23): the offer sat
-- in the window for 15 min and the log said nothing of it. join_closed starts over (the next offer is logged again).
local noted = {}
local function note(key, fmt, ...)
	if noted[key] then return end
	noted[key] = true
	log(fmt, ...)
end

local function show_window()
	if not offer or state.done then
		note("no offer", "window not opened: %s", state.done and "the character is set up already" or "no offer")
		return false
	end
	if not offer.join and not (db and db.actor) then -- in the world: once the actor exists
		note("no actor", "window waits for the actor (offer in the world)")
		return false
	end
	local ok, err = pcall(function()
		if not GUI then GUI = UICoopNewChar() end
		if not GUI:IsShown() then
			GUI:Fill(offer)
			GUI:ShowDialog(true)
		end
	end)
	if not ok then
		note("failed " .. tostring(err), "! new character window failed: %s", tostring(err))
		GUI = nil
	else
		note("shown", "choice window open (%s)", offer.join and "before the world" or "in the world")
	end
	return ok
end

-- Every offer opens the window again (after "Later" too); the client tick retries until the actor exists.
local function on_offer(payload, from)
	if from ~= 0 or not (api and api.is_client()) or state.done then return end
	local t = decode(payload)
	offer = { eco = math.max(1, math.min(3, tonumber(t.eco) or 1)), points = tonumber(t.points), nick = t.nick }
	if state.waiting then return end -- our choice is on its way
	state.show = not show_window()
end

local function on_result(payload, from)
	if from ~= 0 or not (api and api.is_client()) then return end
	local t = decode(payload)
	state.waiting = false
	if t.ok and type(t.faction) == "string" and FACTION_SET[t.faction] then
		state.done = true
		pcall(function() db.actor:set_character_community("actor_" .. t.faction, 0, 0) end)
		local money = math.floor(tonumber(t.money) or 0) -- for the log only: the host set it (coop.money_set)
		if GUI then GUI:Close() end
		local name = game.translate_string("st_faction_" .. t.faction)
		pcall(function() db.actor:give_game_news("Co-op", tr("st_coop_char_done", name), "ui_iconsTotal_grouping", 0, 7000) end)
		log("new character set up: %s, %d item(s), money %d", t.faction, tonumber(t.items) or 0, money)
		return
	end
	local reason = tostring(t.reason or "?")
	local text = tr("st_coop_char_refused", tr("st_coop_char_reason_" .. reason))
	log("host refused the choice: %s", reason)
	if reason == "not_new" then
		state.done = true
		if GUI then GUI:Close() end
		return
	end
	if GUI and GUI:IsShown() then
		GUI.btn_start:Enable(true)
		GUI:SetStatus("bad", text)
	end
end

-------------------------------------------------------------------------------
-- Client: the choice before the world (protocol 8; the engine's calls, see the header)
-------------------------------------------------------------------------------
-- Where the host will put a character of `faction` (host_start), as far as the client knows: "start" if the faction
-- has a start on the host's level (by the start's picture: no game graph in the main menu), else "camp" (a camp of
-- the faction there, or next to the group).
function start_preview(faction, level, story)
	if SPLIT_LEVELS then return "start" end
	for _, s in ipairs(faction_starts(faction, story)) do
		if s.image == level then return "start" end
	end
	return "camp"
end

local function own_nick()
	for _, p in ipairs(api and api.players() or {}) do
		if p.is_self then return tostring(p.nick or "") end
	end
	local ok, info = pcall(function() return api.session_info() end)
	return ok and type(info) == "table" and tostring(info.nick or "") or ""
end

-- Unattended test runs (`-coop_autochoose <faction>` with -coop_connect): the offer is answered at once with that
-- faction and no purchases, as if the player pressed Done. Nil without the flag or for an unknown faction.
local auto_retried = false -- the one retry after "busy" is spent (join_closed starts over)
local function auto_choice()
	local ok, cl = pcall(command_line)
	if not (ok and type(cl) == "string") then
		note("no command line", "! command_line() failed (%s): -coop_autochoose cannot be read", tostring(cl))
		return nil
	end
	local f = cl:match("%-coop_autochoose%s+([%w_]+)")
	if not f then
		if cl:find("-coop_autochoose", 1, true) then
			note("empty auto", "! -coop_autochoose without a faction: the window opens")
		end
		return nil
	end
	if not FACTION_SET[f] then
		note("bad auto " .. f, "! -coop_autochoose %s: not a faction a player can pick, the window opens", f)
		return nil
	end
	return f
end

-- The host's offer (again after a refused choice: `refusal` is its reason code): the window, now. flags: 1 = the
-- host's game has the story on. True if the window is shown (else the engine tries again).
function join_offer(eco, points, level, refusal, flags)
	if not api then
		note("no api", "! join_offer: no coop namespace in this Lua state, the window cannot open")
		return false
	end
	-- The engine passes the offer as it is on the wire: a first offer has refusal "" (CharOfferMsg), not nil. Night
	-- run 1 (2026-10-23): `not refusal` was false for "", -coop_autochoose never answered and the window waited.
	refusal = type(refusal) == "string" and refusal ~= "" and refusal or nil
	local auto = auto_choice()
	-- "busy" is the host's fallback reason (its Lua failed for a moment): an unattended run answers once more per
	-- window cycle instead of waiting for the host's 10-minute kick
	if auto and refusal == "busy" and not auto_retried then
		auto_retried = true
		log("test: the host was busy, the automatic choice goes once more")
		refusal = nil
	end
	if auto and not refusal then
		join.choice = { faction = auto, buy = "" }
		state.waiting = true
		log("test: offer answered at once with %s (-coop_autochoose)", auto)
		return true
	end
	if auto then -- answered once already: a choice the host refused is not sent again blindly
		note("auto refused " .. refusal, "test: the host refused the automatic choice (%s), the window opens", refusal)
	end
	offer = {
		join = true,
		eco = math.max(1, math.min(3, tonumber(eco) or 1)),
		points = tonumber(points),
		nick = own_nick(),
		level = type(level) == "string" and level ~= "" and level or nil,
		refusal = refusal,
		story = (math.floor(tonumber(flags) or 0) % 2) == 1,
	}
	join.choice = nil
	state.waiting, state.done, state.show = false, false, false
	if GUI and GUI:IsShown() then
		local ok, err = pcall(GUI.Fill, GUI, offer)
		if ok then
			note("refilled " .. tostring(refusal), "offer shown again in the open window%s",
				refusal and (", last choice refused: " .. refusal) or "")
		else
			note("failed " .. tostring(err), "! new character window failed: %s", tostring(err))
		end
		return ok
	end
	return show_window()
end

-- What Done gave since the last call: faction, bought "sec,sec,..." (nil if nothing). Kept for the news in the world:
-- the load rebuilds Lua, the session's stash stays.
function join_choice()
	local c = join.choice
	join.choice = nil
	if not c then return nil end
	if api and api.stash_set then pcall(api.stash_set, STASH_JOINED, c.faction) end
	return c.faction, c.buy
end

-- The world arrives (or the session ended): the window closes.
function join_closed(why)
	noted = {} -- the next offer's branches are logged again
	auto_retried = false
	join.choice = nil
	if offer and offer.join then offer = nil end
	state.waiting = false
	if GUI then pcall(GUI.Close, GUI) end
end

-------------------------------------------------------------------------------
-- Host: his own new character after a hardcore death (F3 Task 10; see the header)
-------------------------------------------------------------------------------
-- The window for the host's own choice (the faction kit, points of his economy tier), unless it is open already.
function host_offer_self()
	local eco = host_eco()
	offer = { eco = eco, points = budget(eco), nick = own_nick(), host_self = true }
	state.waiting, state.done = false, false
	state.show = not show_window()
end

-- The host chose for himself: the money first, as for a proxy (F2 T6b: a refusal leaves the inventory untouched), then
-- the kit into db.actor, the community actor_<faction>, the mark cleared. True, money, items given | false, reason.
function host_choose_self(faction, buy)
	if not (api and api.is_host()) then return false, "busy" end
	if not is_new(SELF_ID) then return false, "not_new" end
	local actor = db and db.actor
	if not actor then return false, "busy" end
	faction = type(faction) == "string" and faction or ""
	local plan, why = plan_kit(faction, buy)
	if not plan then
		log("the host's own choice refused (%s)", tostring(why))
		return false, why
	end
	local set_ok, set_why = false, "coop.money_set is missing"
	if type(api.money_set) == "function" then set_ok, set_why = api.money_set(SELF_ID, plan.money) end
	if not set_ok then
		log("! the host's money not set, the choice stays open: %s", tostring(set_why))
		return false, "busy"
	end
	local ok2, removed_or_err, given = pcall(apply_kit, actor, "actor_" .. faction, plan.items, true)
	if not ok2 then
		log("! the host's kit failed: %s", tostring(removed_or_err))
		return false, "busy"
	end
	se_save_var(SELF_ID, nil, NEW_VAR, nil)
	offer = nil
	state.show, state.waiting = false, false
	if GUI then pcall(GUI.Close, GUI) end
	log("the host's new character: faction %s, %d item(s), money %d", faction, given, plan.money)
	local name = game.translate_string("st_faction_" .. faction)
	pcall(function() actor:give_game_news("Co-op", tr("st_coop_char_done", name), "ui_iconsTotal_grouping", 0, 7000) end)
	new_character_hook(SELF_ID)
	return true, plan.money, given
end

-- The engine's callback: the host's things are in the stash, his actor stands at his arrival point with nothing. The
-- mark first (a save made now keeps the choice open), then the window, or -coop_autochoose's faction at once.
function host_new_character()
	if not (api and api.is_host()) then return end
	se_save_var(SELF_ID, nil, NEW_VAR, true)
	log("the host's character is out of the run: he chooses a new one")
	local auto = auto_choice()
	if auto then
		local ok, why = host_choose_self(auto, "")
		log("test: the host's new character %s (-coop_autochoose): %s", auto, ok and "made" or tostring(why))
		if ok then return end
	end
	self_next_offer = now_ms() + OFFER_EVERY_MS
	host_offer_self()
end

-------------------------------------------------------------------------------
-- Callbacks
-------------------------------------------------------------------------------
local next_tick = 0
local function actor_on_update()
	if not api then return end
	local t = now_ms()
	if t < next_tick then return end
	next_tick = t + TICK_MS
	if api.is_host() then
		local ok, err = pcall(host_tick)
		if not ok then log("! host tick: %s", tostring(err)) end
		return
	end
	-- protocol 8: the character chosen before the world, told once in it
	local joined = api.stash_get and api.stash_get(STASH_JOINED)
	if type(joined) == "string" and db and db.actor then
		api.stash_set(STASH_JOINED, nil)
		state.done = true
		local name = game.translate_string("st_faction_" .. joined)
		pcall(function() db.actor:give_game_news("Co-op", tr("st_coop_char_done", name), "ui_iconsTotal_grouping", 0, 7000) end)
		log("in the world as %s (chosen before it)", joined)
	end
	if state.show and not state.waiting then
		state.show = not show_window()
	end
end

function on_game_start()
	if not api then return end
	RegisterScriptCallback("se_stalker_on_spawn", se_stalker_on_spawn)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	AddScriptCallback("coop_host_new_character") -- fired by the engine (F3 Task 10, coop_survival.cpp), host only
	RegisterScriptCallback("coop_host_new_character", host_new_character)
end

-- Event handlers at load time (like coop_settings): they must exist before the first event of this world.
if api then
	local cm = rawget(_G, "coop_main")
	if cm == nil then
		local ok, m = pcall(function() return coop_main end)
		cm = ok and m or nil
	end
	if cm and cm.add_event_handler then
		cm.add_event_handler("menu.char_offer", on_offer)
		cm.add_event_handler("menu.new_character", on_new_character)
		cm.add_event_handler("menu.char_result", on_result)
	end
end
