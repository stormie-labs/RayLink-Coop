-- Persistent faction goodwill snapshots, keyed by stable player digests.
WINDOW = 72 * 60 * 60
CLOCK = "game_calendar_seconds"
-- The session rule trader_rep: who counts. best = the highest goodwill among the players in game; mean_online = their
-- mean; mean_recent = the mean over who is in game or was seen within WINDOW game seconds.
MODES = { best = true, mean_online = true, mean_recent = true }
DEFAULT_MODE = "best"
local MAX_TIME = 315537897599 -- 9999-12-31 23:59:59, engine calendar epoch (year 1).

local function number(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function timestamp(value)
	return number(value) and value >= 0 and value <= MAX_TIME and value == math.floor(value)
end

-- Same Gregorian calendar arithmetic as xrGame/date_time.cpp::generate_time.
-- CTime:diffSec(CTime()) would round a huge epoch through native float32.
function calendar_seconds(y, mo, d, h, mi, sec, ms)
	local fields = { y, mo, d, h, mi, sec, ms }
	for index = 1, 7 do
		local value = fields[index]
		if not number(value) or value ~= math.floor(value) then return nil end
	end
	if y < 1 or y > 9999 or mo < 1 or mo > 12 or h < 0 or h > 23
		or mi < 0 or mi > 59 or sec < 0 or sec > 59 or ms < 0 or ms > 999 then return nil end
	local leap = y % 400 == 0 or (y % 4 == 0 and y % 100 ~= 0)
	local months = { 31, leap and 29 or 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
	if d < 1 or d > months[mo] then return nil end
	local years = y - 1
	local days = years * 365 + math.floor(years / 4) - math.floor(years / 100) + math.floor(years / 400) + d - 1
	for month = 1, mo - 1 do days = days + months[month] end
	return ((days * 24 + h) * 60 + mi) * 60 + sec
end

function valid_key(key)
	return type(key) == "string" and #key == 64 and key:match("^[0-9a-f]+$") ~= nil
end

-- A nick for the PDA: no control bytes, no backslash (the UI reads \n as a new line), at most 32 bytes; nil if empty.
function clean_nick(nick)
	if type(nick) ~= "string" then return nil end
	nick = nick:gsub("%c", ""):gsub("\\", "/"):sub(1, 32)
	return nick ~= "" and nick or nil
end

function observe(book, key, seen, goodwill, nick)
	if not valid_key(key) or not timestamp(seen) or type(goodwill) ~= "table" then return false end
	local values = {}
	for faction, value in pairs(goodwill) do
		if type(faction) == "string" and number(value) and value >= -2147483648 and value <= 2147483647 then
			values[faction] = value
		end
	end
	book.players[key] = { last_seen = seen, goodwill = values, nick = clean_nick(nick) }
	return true
end

function restore(saved, now)
	local book = { v = 2, clock = CLOCK, players = {} }
	if type(saved) ~= "table" or type(saved.players) ~= "table" then return book end
	local legacy = saved.v == nil or saved.v == 1
	if not legacy and (saved.v ~= 2 or saved.clock ~= CLOCK) then return book end
	if legacy and saved.clock ~= nil then return book end
	local ready = timestamp(now)
	if legacy and not ready then book.v, book.clock = 1, nil end
	for key, row in pairs(saved.players) do
		if type(row) == "table" and timestamp(row.last_seen) and (not legacy or row.last_seen > 0) then
			-- Unix last_seen has no mapping to this world's timeline. Grant one fresh window.
			local seen = legacy and ready and now or row.last_seen
			if legacy or not ready or seen <= now then observe(book, key, seen, row.goodwill, row.nick) end
		end
	end
	return book
end

-- Keys of the players `mode` counts (sorted), or nil: no valid book or clock.
function counted(book, now, online, mode)
	if book.v ~= 2 or book.clock ~= CLOCK or not timestamp(now) then return nil end
	local recent = mode == "mean_recent"
	local keys = {}
	for key, row in pairs(book.players) do
		local age = now - row.last_seen
		if (online and online[key]) or (recent and age >= 0 and age < WINDOW) then keys[#keys + 1] = key end
	end
	table.sort(keys)
	return keys
end

-- value, count, keys counted, key whose value is the best (mode best). A counted player without a value for the
-- faction closes it (nil): an incomplete snapshot never opens a tier.
function aggregate(book, faction, now, online, mode)
	if not MODES[mode] then mode = DEFAULT_MODE end
	local keys = type(faction) == "string" and counted(book, now, online, mode)
	if not keys then return nil, 0, {} end
	local sum, top, top_key = 0, nil, nil
	for _, key in ipairs(keys) do
		local value = book.players[key].goodwill[faction]
		if not number(value) then return nil, #keys, keys end
		sum = sum + value
		if top == nil or value > top then top, top_key = value, key end
	end
	if #keys == 0 then return nil, 0, keys end
	if mode == "best" then return top, #keys, keys, top_key end
	return sum / #keys, #keys, keys
end

function average(book, faction, now, online)
	local value, count = aggregate(book, faction, now, online, "mean_recent")
	return value, count
end
