--[[
	Anomaly Coop - group actions and the shared clock (gamedata\scripts\coop_economy_group.script)

	Time belongs to the host (coop_worldstate: a client's level.change_game_time is refused there and only
	logged on the host). This script decides WHEN the host moves the clock for a player:
	  - time-passing items (GAMMA Wait.script "wait.wait") are proposals. The host applies the sleep_rule:
	        host          only the host may skip time; a client's wait is refused
	        gather        everybody within sleep_radius of the waiter
	        vote          every other player accepts in a message box (default; no answer = no)
	        safe_or_vote  a player standing in a shelter (or at a tent) accepts by himself, the others vote
	    On approval the waiter's machine runs the item; its level.change_game_time becomes an
	    "economy.skip" with the approval ticket, and the host moves the clock (TimeSync reaches everybody).
	  - sleep (ui_sleep_dialog) uses the shared rest of coop_rest.script and
	    the engine (coop.rest), the time is skipped when every player rests. Nothing here wraps the sleep dialog.
	  - travel (fast travel, backpack travel, guides): by default a trip takes no game time. The traveller's machine drops
	    its level.change_game_time call, the host's
	    own trip included. With the world's rule travel_takes_time on, the time cost of a group travel lands once, on the host
	    (coop_economy_travel arms it); a solo travel (party rule off, split levels) never moves the shared clock.
	  - other players see a fade and a PDA line when the host skipped time for somebody.
	Outside a session every wrapper calls the stock function unchanged.

	For other scripts:
		coop_economy_group.gather_radius() / party_fast_travel() / travel_as_group() / travel_takes_time()
		coop_economy_group.request_skip(kind, minutes, cont) -> true = proposal sent, cont() runs on approval
		coop_economy_group.with_arm(kind, fn, ...)   run fn; a level.change_game_time inside goes to the host
		coop_economy_group.subject(name, texts)   every machine: the lines of a vote about `name` (not a time skip):
			texts = { ask = { id, fallback }, no = ..., timeout = ..., left = ... }; ask is formatted with the asker's
			nick and the vote's argument, the others with the nick that decided it
		coop_economy_group.propose(name, from, voters, on_result, arg) -> true, nil when this is not the host
			host: the same vote as a time skip's (its box, the "Time to vote" setting, silence = no, a voter who leaves has
			no veto) among `voters` ({ [peer] = true }; `from` and players who are not here are left out); on_result(ok,
			reason, nick) runs on the host ("no" | "timeout" | "left"). With nobody to ask it is true at once.

	Events (payload coop_main.encode, sender checked on receipt):
		economy.propose  initiator -> host     { t = initiator ticket, k = kind, m = minutes }
		economy.vote     host -> voter         { t = host ticket, k, m, n = initiator nick, s = shelter counts; g = subject, a = its argument }
		economy.ballot   voter -> host         { t = host ticket, y = accepted }
		economy.verdict  host -> initiator     { t = initiator ticket, ok, r = reason, n = nick that blocked; t < 0: a vote ended, g = subject }
		economy.skip     initiator -> host     { k, t = initiator ticket (0 for travel), m = minutes }
		economy.fade     host -> other players { k, m, n = nick }
--]]

local core = coop_economy_core

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall
local math_floor = math.floor

local KINDS = { wait = true, travel = true } -- The engine's coop.rest handles sleep.
local GRANT_MS = 120000 -- an approval is valid this long
local ARM_MS = 60000 -- an approved skip must reach level.change_game_time within this time
local TRAVEL_GAP_MS = 8000 -- travel skips: one per player per this time
local TRAVEL_MAX_MIN = 12 * 60
local FADE_PPE, FADE_ID = "sleep_fade.ppe", 5527

local orig_cgt = nil -- level.change_game_time
local installed = false

local st = {
	arm = nil, -- { kind, ticket, until } this machine's next level.change_game_time goes to the host
	seq = 0, -- initiator tickets
	pending = {}, -- initiator: ticket -> { kind, minutes, cont, at }
	props = {}, -- host: host ticket -> proposal
	hseq = 0,
	grants = {}, -- host: "peer/ticket" -> { kind, minutes, until }
	last_travel = {}, -- host: peer -> time of the last travel skip
	ballot_box = nil, -- voter: open message box
	bypass = false,
}

local stats = { proposals = 0, approved = 0, denied = 0, skips = 0, refused = 0, fades = 0, errors = 0, trips_no_time = 0 }

-------------------------------------------------------------------------------
-- Rules and the gather check (xrRazom group-action gate)
-------------------------------------------------------------------------------
function gather_radius() return core.rule("gather_radius") or 20 end
function party_fast_travel() return core.rule("party_fast_travel") ~= false end
-- A travel moves the group (everybody gathered first, the others follow) when the rule is on and the levels are not
-- split: with split levels a player goes alone, the others are on maps of their own.
function travel_as_group()
	-- Without a session, keep the stock travel wrapper's ordinary single-player default.
	return party_fast_travel() and (coop_mode.group_travels() or not (core.in_session() or coop_mode.decides_world()))
end
-- A trip takes game time only where the world's settings say so (off by default).
function travel_takes_time() return core.rule("travel_takes_time") == true end

local function minutes_of(d, h, m)
	return ((tonumber(d) or 0) * 24 + (tonumber(h) or 0)) * 60 + (tonumber(m) or 0)
end

local function apply_clock(minutes)
	local mins = math_floor(minutes + 0.5)
	local h = math_floor(mins / 60)
	return orig_cgt(math_floor(h / 24), h % 24, mins % 60)
end

-------------------------------------------------------------------------------
-- Arming: the next level.change_game_time on this machine is a group action
-------------------------------------------------------------------------------
local function take_arm()
	local a = st.arm
	if not a then return nil end
	if core.now() > a.until_ms then
		st.arm = nil
		return nil
	end
	if not a.keep then st.arm = nil end
	return a
end

local function pack_n(...) return { n = select("#", ...), ... } end

-- Runs fn(...) with level.change_game_time going to the host as `kind` (every call during fn).
-- An error inside fn is logged (the arm is always cleared) and the call returns nothing.
function with_arm(kind, fn, ...)
	local prev = st.arm
	st.arm = { kind = kind, ticket = 0, until_ms = core.now() + ARM_MS, keep = true }
	local res = pack_n(pcall(fn, ...))
	st.arm = prev
	if not res[1] then
		stats.errors = stats.errors + 1
		core.log("! %s: wrapped call failed: %s", kind, tostring(res[2]))
		return nil
	end
	return unpack(res, 2, res.n)
end

-------------------------------------------------------------------------------
-- Host: after a skip
-------------------------------------------------------------------------------
local function after_skip(kind, minutes, by_peer)
	stats.skips = stats.skips + 1
	if kind == "travel" then
		pcall(function()
			surge_manager.get_surge_manager().time_forwarded = true
			psi_storm_manager.get_psi_storm_manager().time_forwarded = true
			level_weathers.get_weather_manager():forced_weather_change()
		end)
	end
	if minutes < 30 then return end
	local nick = core.nick_of(by_peer)
	core.send_clients("fade", { k = kind, m = math_floor(minutes), n = nick }, by_peer)
	if by_peer ~= core.self_id() then
		pcall(level.add_pp_effector, FADE_PPE, FADE_ID, false)
		core.tip(core.fmt("st_coop_eco_time_skipped", "%s: %d h %02d min passed (%s).", nick,
			math_floor(minutes / 60), math_floor(minutes % 60), coop_util.tr("st_coop_eco_kind_" .. kind, kind)))
	end
end

-------------------------------------------------------------------------------
-- level.change_game_time wrapper (both roles)
-------------------------------------------------------------------------------
local function cgt_wrapper(d, h, m)
	if not core.live() then return orig_cgt(d, h, m) end
	local minutes = minutes_of(d, h, m)
	local a = take_arm()
	if a and a.kind == "travel" and not travel_takes_time() then
		stats.trips_no_time = stats.trips_no_time + 1
		return -- a trip takes no game time in this world: nothing for the engine, nothing for the host
	end
	if core.owns_world() then
		local r = orig_cgt(d, h, m)
		if a and minutes > 0 then after_skip(a.kind, minutes, core.self_id()) end
		return r
	end
	if a then
		if minutes > 0 then core.send("skip", { k = a.kind, t = a.ticket, m = math_floor(minutes + 0.5) }, 0) end
		return
	end
	return orig_cgt(d, h, m) -- an unknown script: refused by the engine, the host is told (coop_worldstate)
end

-------------------------------------------------------------------------------
-- Proposals: initiator side
-------------------------------------------------------------------------------
local host_open -- forward

local REASONS = {
	host_only = { "st_coop_eco_deny_host_only", "Only the host can skip time in this session." },
	far = { "st_coop_eco_deny_far", "Everybody must be close to sleep (far: %s)." },
	no = { "st_coop_eco_deny_no", "%s does not want to skip time." },
	timeout = { "st_coop_eco_deny_timeout", "No answer from %s." },
	left = { "st_coop_eco_deny_left", "The vote was cancelled (%s left)." },
	busy = { "st_coop_eco_deny_busy", "Another time skip is being decided." },
	bad = { "st_coop_eco_deny_bad", "The host refused the time skip." },
}

local SUBJECTS = {} -- name -> { ask = { id, fallback }, no = ..., timeout = ..., left = ... }

function subject(name, texts)
	if type(name) == "string" and type(texts) == "table" then SUBJECTS[name] = texts end
end

local function verdict_text(r, nick, g)
	local s = g and SUBJECTS[g]
	local e = s and (s[r] or s.no) or REASONS[r] or REASONS.bad
	return core.fmt(e[1], e[2], tostring(nick or "?"))
end

local function on_verdict_local(ticket, ok, reason, nick)
	local p = st.pending[ticket]
	if not p then return end
	st.pending[ticket] = nil
	if not ok then
		stats.denied = stats.denied + 1
		core.tip(verdict_text(reason, nick))
		return
	end
	stats.approved = stats.approved + 1
	st.arm = { kind = p.kind, ticket = ticket, until_ms = core.now() + ARM_MS }
	st.bypass = true
	local okc, err = pcall(p.cont)
	st.bypass = false
	if not okc then
		stats.errors = stats.errors + 1
		st.arm = nil
		core.log("! %s continuation failed: %s", p.kind, tostring(err))
	end
end

-- Starts a group decision about skipping `minutes` (0 = unknown, e.g. a book). cont() runs on approval,
-- with this machine's next level.change_game_time sent to the host. Returns false outside a session or when
-- nobody else plays (the caller goes on as in single player).
function request_skip(kind, minutes, cont)
	if st.bypass or not core.live() or not KINDS[kind] or core.others_count() == 0 then return false end
	st.seq = st.seq + 1
	local t = st.seq
	st.pending[t] = { kind = kind, minutes = minutes or 0, cont = cont, at = core.now() }
	stats.proposals = stats.proposals + 1
	core.tip(coop_util.tr("st_coop_eco_waiting_group", "Asking the group..."), 3000)
	if core.owns_world() then
		host_open(core.self_id(), t, kind, minutes or 0)
	else
		core.send("propose", { t = t, k = kind, m = math_floor(minutes or 0) }, 0)
	end
	return true
end

-------------------------------------------------------------------------------
-- Proposals: host side
-------------------------------------------------------------------------------
-- Voter: the vote ended without this player's answer mattering any more.
local function close_ballot()
	st.ballot_for = nil
	local b = st.ballot_box
	st.ballot_box = nil
	if b then pcall(function() b.message_box:HideDialog() end) end
end

local function send_verdict(peer, ticket, ok, reason, nick)
	if peer == core.self_id() then
		on_verdict_local(ticket, ok, reason, nick)
	else
		core.send("verdict", { t = ticket, ok = ok, r = reason or "", n = nick or "" }, peer)
	end
end

local function grant(peer, ticket, kind, minutes)
	st.grants[tostring(peer) .. "/" .. tostring(ticket)] = { kind = kind, minutes = minutes, until_ms = core.now() + GRANT_MS }
end

-- A vote about a subject ended: the result to its caller, the end in the subject's words to everybody it asked and to the asker.
local function close_subject(ht, p, ok, reason, nick)
	if p.voters[core.self_id()] and st.ballot_for == ht then close_ballot() end
	if not ok then
		local msg = { t = -ht, ok = false, r = reason or "", n = nick or "", g = p.subject }
		local told = {}
		for peer in pairs(p.voters) do told[peer] = true end
		if p.from ~= nil then told[p.from] = true end
		for peer in pairs(told) do
			if peer == core.self_id() then
				core.tip(verdict_text(reason, nick, p.subject))
			else
				core.send("verdict", msg, peer)
			end
		end
	end
	local okc, err = pcall(p.cb, ok == true, reason, nick)
	if not okc then
		stats.errors = stats.errors + 1
		core.log("! vote '%s': its result failed: %s", tostring(p.subject), tostring(err))
	end
	core.log("vote '%s' of %s: %s%s", tostring(p.subject), core.nick_of(p.from), ok and "yes" or "no",
		ok and "" or (" (" .. tostring(reason) .. ")"))
end

local function close_prop(ht, ok, reason, nick)
	local p = st.props[ht]
	if not p then return end
	st.props[ht] = nil
	if p.cb then return close_subject(ht, p, ok, reason, nick) end
	if ok then grant(p.from, p.ticket, p.kind, p.minutes) end
	send_verdict(p.from, p.ticket, ok, reason, nick)
	if not ok then
		for peer in pairs(p.voters) do
			if peer ~= core.self_id() then
				core.send("verdict", { t = -ht, ok = false, r = reason or "", n = nick or "" }, peer)
			else
				core.tip(verdict_text(reason, nick))
			end
		end
	end
	if p.voters[core.self_id()] and st.ballot_for == ht then close_ballot() end
	core.log("time skip '%s' by %s (%d min): %s%s", p.kind, core.nick_of(p.from), p.minutes, ok and "approved" or "refused",
		ok and "" or (" (" .. tostring(reason) .. ")"))
end

local show_ballot -- forward

host_open = function(from, ticket, kind, minutes)
	local initiator = core.player(from)
	if not initiator then return end
	for _, p in pairs(st.props) do
		if p.from == from then return send_verdict(from, ticket, false, "busy") end
	end
	local voters, nv = {}, 0
	for _, p in ipairs(core.players()) do
		if p.id ~= from and p.avatar_id then -- a player still loading the world has no say yet
			voters[p.id] = true
			nv = nv + 1
		end
	end
	if nv == 0 then
		grant(from, ticket, kind, minutes)
		return send_verdict(from, ticket, true)
	end
	local rule = core.rule("sleep_rule")
	if rule == "host" and not coop_mode.seat_plays(0) then rule = "vote" end -- no host to decide: the players do
	if rule == "host" then
		if from == core.self_id() then
			grant(from, ticket, kind, minutes)
			return send_verdict(from, ticket, true)
		end
		return send_verdict(from, ticket, false, "host_only")
	elseif rule == "gather" then
		local far = core.far_players(initiator.pos, core.rule("sleep_radius") or 6, from)
		if #far > 0 then return send_verdict(from, ticket, false, "far", table.concat(far, ", ")) end
		grant(from, ticket, kind, minutes)
		return send_verdict(from, ticket, true)
	end
	st.hseq = st.hseq + 1
	local ht = st.hseq
	st.props[ht] = { from = from, ticket = ticket, kind = kind, minutes = minutes, voters = voters, yes = {},
		deadline = core.now() + (core.rule("vote_timeout") or 30) * 1000 }
	local msg = { t = ht, k = kind, m = math_floor(minutes), n = initiator.nick, s = (rule == "safe_or_vote") }
	for peer in pairs(voters) do
		if peer == core.self_id() then
			show_ballot(msg)
		else
			core.send("vote", msg, peer)
		end
	end
end

-- Split levels: the authority of a level is its map server, and the ballots are the world server's (every player answers his
-- host). A map server's proposal goes to the world server (propose_for), which runs the vote as its own and tells the map
-- server the result (verdict_for), so an arena proposal on a map server has a ballot.
local remote = {} -- map server: ticket -> { cb = on_result, until_ms = when the world server's silence is a no }
local remote_seq = 0
local MAX_VOTE_TICKET = 9007199254740991 -- largest safe integer in Lua
local MAX_VOTE_ARG = 128
local MAX_VERDICT_REASON = 16
local MAX_VERDICT_NICKS = 16 * 48 + 15 * 2 -- up to 16 missing voters, 48 bytes/nick (coop_session.cpp), ", " between them

local function optional_text(value, max_len)
	return value == nil or (type(value) == "string" and #value <= max_len)
end

local function parse_voters(list)
	-- propose_remote joins decimal seat numbers with commas (players 0..16).
	if type(list) ~= "string" or #list > 50 then return nil end
	local voters = {}
	if list == "" then return voters end
	for seat in (list .. ","):gmatch("([^,]*),") do
		local peer = core.player_id(seat)
		if peer == nil or seat ~= tostring(peer) then return nil end
		voters[peer] = true
	end
	return voters
end

local function propose_remote(name, from, voters, on_result, arg)
	local list = {}
	for peer in pairs(type(voters) == "table" and voters or {}) do
		if type(peer) == "number" then list[#list + 1] = tostring(peer) end
	end
	remote_seq = remote_seq + 1
	local k = remote_seq
	local sent = core.send("propose_for", { k = k, g = tostring(name), f = tonumber(from) or -1, v = table.concat(list, ","),
		a = arg ~= nil and tostring(arg) or "" }, 0)
	if not sent then return nil end
	-- the vote's own time at the world server, and as much again for the way there and back
	remote[k] = { cb = on_result, subject = tostring(name), until_ms = core.now() + ((core.rule("vote_timeout") or 30) + 30) * 1000 }
	stats.proposals = stats.proposals + 1
	return true
end

local function remote_end(k, ok, reason, nick)
	local r = remote[k]
	if not r then return end
	remote[k] = nil
	local okc, err = pcall(r.cb, ok == true, reason, nick)
	if not okc then
		stats.errors = stats.errors + 1
		core.log("! vote '%s': its result failed: %s", tostring(r.subject), tostring(err))
	end
	core.log("vote '%s' asked of the world server: %s%s", tostring(r.subject), ok and "yes" or "no",
		ok and "" or (" (" .. tostring(reason) .. ")"))
end

function propose(name, from, voters, on_result, arg)
	if not (core.live() and type(on_result) == "function") then return nil end
	if coop_mode.leads_here() and not coop_mode.decides_world() then return propose_remote(name, from, voters, on_result, arg) end
	if not core.owns_world() then return nil end
	local here = {}
	for _, p in ipairs(core.players()) do
		if p.avatar_id then here[p.id] = true end -- a player still loading the world has no say yet
	end
	local asked, n = {}, 0
	for peer in pairs(type(voters) == "table" and voters or {}) do
		if peer ~= from and here[peer] then
			asked[peer] = true
			n = n + 1
		end
	end
	if n == 0 then
		local ok, err = pcall(on_result, true)
		if not ok then core.log("! vote '%s': its result failed: %s", tostring(name), tostring(err)) end
		return true
	end
	st.hseq = st.hseq + 1
	local ht = st.hseq
	st.props[ht] = { from = from, subject = name, cb = on_result, voters = asked, yes = {}, kind = tostring(name), minutes = 0,
		deadline = core.now() + (core.rule("vote_timeout") or 30) * 1000 }
	stats.proposals = stats.proposals + 1
	local msg = { t = ht, g = tostring(name), a = arg ~= nil and tostring(arg) or "", n = core.nick_of(from) }
	for peer in pairs(asked) do
		if peer == core.self_id() then
			show_ballot(msg)
		else
			core.send("vote", msg, peer)
		end
	end
	return true
end

local function host_ballot(from, ht, yes)
	local p = st.props[ht]
	if not (p and p.voters[from]) then return end
	if not yes then return close_prop(ht, false, "no", core.nick_of(from)) end
	p.yes[from] = true
	for peer in pairs(p.voters) do
		if not p.yes[peer] then return end
	end
	close_prop(ht, true)
end

local function host_tick()
	local t = core.now()
	for ht, p in pairs(st.props) do
		local initiator_here = (p.cb and p.from == nil) or core.player(p.from) ~= nil
		if not initiator_here then
			close_prop(ht, false, "left", core.nick_of(p.from))
		elseif t > p.deadline then
			local missing = {}
			for peer in pairs(p.voters) do
				if not p.yes[peer] then missing[#missing + 1] = core.nick_of(peer) end
			end
			close_prop(ht, false, "timeout", table.concat(missing, ", "))
		else
			for peer in pairs(p.voters) do
				if not p.yes[peer] and not core.player(peer) then p.voters[peer] = nil end -- a voter left: no veto
			end
			local all = true
			for peer in pairs(p.voters) do
				if not p.yes[peer] then all = false break end
			end
			if all then close_prop(ht, true) end
		end
	end
	for k, g in pairs(st.grants) do
		if t > g.until_ms then st.grants[k] = nil end
	end
end

-- economy.skip from a client: apply an approved wait, or the time cost of a group travel.
local function host_skip(from, t)
	local kind = KINDS[t.k] and t.k or nil
	local minutes = core.num(t.m, 1, (core.rule("max_skip_hours") or 48) * 60)
	if not (kind and minutes) then
		stats.refused = stats.refused + 1
		return
	end
	if kind == "travel" then
		local last = st.last_travel[from]
		if not (travel_takes_time() and travel_as_group()) or minutes > TRAVEL_MAX_MIN
			or (last and core.now() - last < TRAVEL_GAP_MS) then
			stats.refused = stats.refused + 1
			core.log("travel time of %s (%d min) not applied (solo travel or too often)", core.nick_of(from), minutes)
			return
		end
		st.last_travel[from] = core.now()
	else
		local key = tostring(from) .. "/" .. tostring(core.int(t.t, 0) or -1)
		local g = st.grants[key]
		if not (g and g.kind == kind and (g.minutes == 0 or minutes <= g.minutes + 60)) then
			stats.refused = stats.refused + 1
			core.log("! %s skip of %s (%d min) refused: no approval", kind, core.nick_of(from), minutes)
			return
		end
		st.grants[key] = nil
	end
	apply_clock(minutes)
	after_skip(kind, minutes, from)
end

-------------------------------------------------------------------------------
-- Voter side
-------------------------------------------------------------------------------
local function in_shelter()
	if GetEvent and GetEvent("current_safe_cover") then return true end
	local tent = rawget(_G, "item_tent")
	if tent and tent.get_nearby_tent then
		local ok, r = pcall(tent.get_nearby_tent, 1.5)
		if ok and r then return true end
	end
	return false
end

local function answer(ht, yes)
	if core.owns_world() then
		host_ballot(core.self_id(), ht, yes)
	else
		core.send("ballot", { t = ht, y = yes == true }, 0)
	end
end

show_ballot = function(t)
	local ht = core.int(t.t, 1)
	if not ht then return end
	if t.s and in_shelter() then return answer(ht, true) end
	local s = type(t.g) == "string" and t.g ~= "" and SUBJECTS[t.g]
	local text
	if s and s.ask then
		text = core.fmt(s.ask[1], s.ask[2], tostring(t.n), tostring(t.a or ""))
	else
		text = core.fmt("st_coop_eco_vote_wait", "%s wants to pass time. Agree?", tostring(t.n))
	end
	st.ballot_for = ht
	local box = rawget(_G, "ui_dyn_msg_box") or coop_util.module("ui_dyn_msg_box")
	local shown = false
	if box and box.msg_box_ui then
		shown = pcall(function()
			st.ballot_box = box.msg_box_ui("message_box_yes_no", true, text,
				function() if st.ballot_for == ht then st.ballot_for = nil; answer(ht, true) end end,
				function() if st.ballot_for == ht then st.ballot_for = nil; answer(ht, false) end end)
		end)
	end
	core.tip(text, 10000)
	if not shown then core.log("! vote box not shown; the vote times out as a no") end
end

-------------------------------------------------------------------------------
-- Stock patches
-------------------------------------------------------------------------------
local function patch_wait()
	-- GAMMA "Books Pass Time" provides a wait table (Wait.script). In stock, _g.script defines wait as a function.
	-- Check the type before indexing it because an error stops later on_game_start callbacks.
	local w = rawget(_G, "wait")
	if type(w) ~= "table" then w = coop_util.module("wait") end
	if not (type(w) == "table" and type(w.wait) == "function") then return end
	local orig = w.wait
	w.wait = function(obj, ...)
		if st.bypass or not core.live() then return orig(obj, ...) end
		local args = pack_n(...)
		if request_skip("wait", 0, function() orig(obj, unpack(args, 1, args.n)) end) then return end
		return orig(obj, ...)
	end
	core.log("Wait.script patched: time-passing items are a group decision")
end

local function install()
	if installed then return end
	installed = true
	if level and type(level.change_game_time) == "function" then
		orig_cgt = level.change_game_time
		level.change_game_time = cgt_wrapper
	else
		core.log("! level.change_game_time missing: time skips are not routed")
	end
	patch_wait()
end

-------------------------------------------------------------------------------
-- Events
-------------------------------------------------------------------------------
local function register_events()
	core.on("propose", function(t, from)
		if not core.owns_world() or from <= 0 then return end
		local ticket = core.int(t.t, 1)
		local kind = KINDS[t.k] and t.k ~= "travel" and t.k or nil
		local minutes = core.num(t.m, 0, (core.rule("max_skip_hours") or 48) * 60)
		if not (ticket and kind and minutes) then return end
		host_open(from, ticket, kind, minutes)
	end)
	core.on("ballot", function(t, from)
		if not core.owns_world() or from <= 0 then return end
		local ht = core.int(t.t, 1)
		if ht then host_ballot(from, ht, t.y == true) end
	end)
	core.on("skip", function(t, from)
		if not core.owns_world() or from <= 0 then return end
		host_skip(from, t)
	end)
	-- Keep the vote relay handlers registered on every process so unexpected senders are counted.
	-- A map server asks the world server to run the vote and return the verdict.
	core.on("propose_for", function(t, from)
		local sender = coop_mode.from_level(from)
		if not core.event_ok("economy_propose_for_sender", sender, "vote request from unexpected peer %s", tostring(from)) then return end
		local k = core.int(t.k, 1, MAX_VOTE_TICKET)
		local asker = core.player_id(t.f)
		local voters = parse_voters(t.v)
		local valid = k and asker and voters and type(t.g) == "string" and #t.g <= 64 and SUBJECTS[t.g] ~= nil
			and optional_text(t.a, MAX_VOTE_ARG)
		if not core.event_ok("economy_propose_for_payload", valid, "invalid vote request from map peer %s", tostring(from)) then return end
		local function tell(ok, reason, nick)
			core.send("verdict_for", { k = k, ok = ok == true, r = reason or "", n = nick or "" }, from)
		end
		if not propose(t.g, asker, voters, tell, t.a) then tell(false, "bad") end
	end)
	core.on("verdict_for", function(t, from)
		local sender = from == 0 and coop_mode.leads_here() and not coop_mode.decides_world()
		if not core.event_ok("economy_verdict_for_sender", sender, "vote verdict from unexpected peer %s", tostring(from)) then return end
		local k = core.int(t.k, 1, MAX_VOTE_TICKET)
		local valid = k and type(t.ok) == "boolean" and optional_text(t.r, MAX_VERDICT_REASON) and optional_text(t.n, MAX_VERDICT_NICKS)
		if not core.event_ok("economy_verdict_for_payload", valid, "invalid vote verdict from peer %s", tostring(from)) then return end
		remote_end(k, t.ok, t.r ~= "" and t.r or nil, t.n ~= "" and t.n or nil)
	end)
	core.on("vote", function(t, from)
		if from ~= 0 or core.owns_world() then return end
		show_ballot(t)
	end)
	core.on("verdict", function(t, from)
		if from ~= 0 or core.owns_world() then return end
		local ticket = core.int(t.t)
		if not ticket then return end
		if ticket < 0 then -- a vote that included this player has ended
			if st.ballot_for == -ticket then close_ballot() end
			core.tip(verdict_text(t.r, t.n ~= "" and t.n or nil, type(t.g) == "string" and t.g ~= "" and t.g or nil))
			return
		end
		on_verdict_local(ticket, t.ok == true, t.r, t.n ~= "" and t.n or nil)
	end)
	core.on("fade", function(t, from)
		if from ~= 0 or core.owns_world() then return end
		local minutes = core.num(t.m, 0, 1e6) or 0
		local kind = KINDS[t.k] and t.k or "wait"
		stats.fades = stats.fades + 1
		pcall(level.add_pp_effector, FADE_PPE, FADE_ID, false)
		core.tip(core.fmt("st_coop_eco_time_skipped", "%s: %d h %02d min passed (%s).", tostring(t.n),
			math_floor(minutes / 60), math_floor(minutes % 60), coop_util.tr("st_coop_eco_kind_" .. kind, kind)))
	end)
end

-------------------------------------------------------------------------------
-- Update, status, start
-------------------------------------------------------------------------------
local next_tick = 0
local function actor_on_update()
	local t = core.now()
	if t < next_tick then return end
	next_tick = t + 500
	if core.owns_world() then host_tick() end
	for k, r in pairs(remote) do -- a map server: the world server never answered
		if t > r.until_ms then remote_end(k, false, "timeout") end
	end
	for ticket, p in pairs(st.pending) do -- the host never answered (left, dropped)
		if t - p.at > ((core.rule("vote_timeout") or 30) + 30) * 1000 then st.pending[ticket] = nil end
	end
end

function print_status()
	local np = 0
	for _ in pairs(st.props) do np = np + 1 end
	core.log("group: rule %s, party travel %s (radius %d m), a trip takes time %s | proposals %d, approved %d, refused %d, skips applied %d, refused skips %d, trips without time %d, fades %d, errors %d, open votes %d",
		tostring(core.rule("sleep_rule")), tostring(party_fast_travel()), gather_radius(), tostring(travel_takes_time()), stats.proposals,
		stats.approved, stats.denied, stats.skips, stats.refused, stats.trips_no_time, stats.fades, stats.errors, np)
end

function on_game_start()
	if not core.engine() then return end
	coop_util.start_step("coop_economy_group", "install", install)
	register_events()
	RegisterScriptCallback("actor_on_update", actor_on_update)
end
