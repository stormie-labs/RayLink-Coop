-- Ядро: без проверок режима (docs/MODES.md)
-- Campfire actions take no shared time. Extra transitions are
-- checked on the player's map, while their dialog, fade and move belong to the player.
-- mods.g15_lc_prompt { i }: decider -> player (transition object id).
-- mods.g15_lc_req { i, t }: player -> decider (object id and one-use ticket).
-- mods.g15_lc_result { t, ok }: decider -> player. Object ids use host numbering.

local core = coop_mods_core
local PROMPT, REQUEST, RESULT = "g15_lc_prompt", "g15_lc_req", "g15_lc_result"
local MAX_ID, MAX_TICKET = 65534, 2147483647
local REQUEST_MS, FADE_MS = 10000, 3000
local TRAVEL_OFFER = -1 -- coop_economy_travel.group_teleport: ask the other players on this map
local transitions, stock_teleport, pending
local seen, sweep_at = {}, 0
local started = false

local function report(what, err)
	core.report("travel_compat", what, err)
end

local function finish_campfire(cp, saved, ok, ...)
	cp.level = saved
	if not ok then error((...), 0) end
	return ...
end

local function install_campfire()
	local cp = core.mod("campfire_placeable")
	if not cp then return end
	for _, key in ipairs({ "gather_wood", "prepare_campfire" }) do
		core.wrap(cp, key, "campfire_placeable." .. key, function(orig)
			return function(...)
				if not core.active() then return orig(...) end
				-- Only these synchronous calls skip time. Keep the stock items,
				-- fades, cooldown and the existing mods.cf_place placement path.
				local saved = rawget(cp, "level")
				cp.level = setmetatable({ change_game_time = function() end }, { __index = cp.level })
				return finish_campfire(cp, saved, pcall(orig, ...))
			end
		end)
	end
end

local function bounded_int(value, min, max)
	if type(value) == "number" and value >= min and value <= max and value % 1 == 0 then return value end
end

local object_id = core.object_id

local function ticket_id(value)
	return bounded_int(value, 1, MAX_TICKET)
end

local function object_for(id)
	local local_id = id and object_id(core.lid(id))
	return local_id and level.object_by_id(local_id)
end

local function config_for(obj)
	local cfg = obj and transitions.lc_pool[obj:section()]
	return cfg and cfg.to_pos and cfg.to_gvid and cfg
end

local function coords(value)
	local fields = str_explode(value, ",")
	local x, y, z = tonumber(fields[1]), tonumber(fields[2]), tonumber(fields[3])
	if x and y and z and math.abs(x) <= 1e5 and math.abs(y) <= 1e5 and math.abs(z) <= 1e5 then
		return vector():set(x, y, z)
	end
end

local function destination(cfg)
	local pos = coords(cfg.to_pos)
	local dir = cfg.dir and coords(cfg.dir) or (not cfg.dir and vector():set(0, 0, 0))
	local gid = bounded_int(tonumber(cfg.to_gvid), 0, MAX_ID)
	if pos and dir and gid then return { pos = pos, dir = dir, gid = gid } end
end

local function within_reach(actor, obj)
	local radius = SYS_GetParam(2, obj:section(), "trigger_radius", 6)
	return actor:position():distance_to_sqr(obj:position()) <= radius * radius
end

local function precondition(actor, obj, cfg)
	if not cfg.precondition or cfg.precondition == "" then return true end
	local rule = xr_logic.parse_condlist(obj, nil, "precondition", cfg.precondition)
	return rule ~= "false" and xr_logic.pick_section_from_condlist(actor, obj, rule) ~= "false"
end

local function group_travel()
	return coop_mode.group_travels() and coop_economy_group.party_fast_travel()
end

local function travel_time()
	if not (coop_mode.decides_world() and group_travel() and coop_economy_group.travel_takes_time()) then return end
	local settings = core.upvalue(stock_teleport, "settings")
	if not (settings and settings.enable_time_advance) then return end
	local distance = math.random(800, 1600)
	local minutes = math.floor(distance / SYS_GetParam(2, "actor", "walk_accel", 11.5) * random_float(0.75, 1.25))
	-- The shared travel handler applies the clock, surge, psi and weather together.
	coop_economy_group.with_arm("travel", level.change_game_time, 0, math.floor(minutes / 60), minutes % 60)
end

local function actor_effects(actor, obj, cfg)
	if not precondition(actor, obj, cfg) then return false end
	if cfg.on_teleport then
		local rule = xr_logic.parse_condlist(obj, obj:section(), "on_teleport", cfg.on_teleport)
		xr_logic.pick_section_from_condlist(actor, obj, rule)
	end
	travel_time()
	return true
end

local function authorize(id, from)
	local obj = object_for(id)
	local actor = coop_mode.leads_here() and coop_mode.decider(from) == "this" and core.avatar(from)
	local cfg = config_for(obj)
	local usable = actor and actor:alive() and cfg and destination(cfg) ~= nil
	local reachable = usable and within_reach(actor, obj)
	if not coop_trust.pass("g15_transition_reach", reachable, "peer %s, transition #%s is unavailable or out of reach",
		tostring(from), tostring(id)) or not usable then return false end
	local ok, allowed = core.as_player(actor, actor_effects, actor, obj, cfg)
	if not ok then report("transition effects", allowed) end
	return ok and allowed == true
end

local function owner_of(trip)
	local actor = coop_mode.actor_is_player() and db.actor
	return actor and rawequal(actor, trip.actor) and actor:alive() and level.name() == trip.map and actor
end

local function confirmed(trip, ok)
	if not ok or not owner_of(trip) then
		pending = nil
		return
	end
	local cfg = trip.cfg
	if cfg.snd then utils_obj.play_sound(cfg.snd) end
	if not trip.same_map then
		hide_hud_all()
		if db.actor:is_talking() then db.actor:stop_talk() end
		SendScriptCallback("on_before_level_changing")
	end
	level.add_pp_effector("sleep_fade.ppe", 1313, false)
	trip.move_at = time_global() + FADE_MS
end

local function reply(t)
	local trip = pending
	if not trip or trip.move_at or ticket_id(t.t) ~= trip.ticket then return end
	if time_global() >= trip.expires then
		pending = nil
		return
	end
	local ok, err = pcall(confirmed, trip, t.ok == true)
	if not ok then
		pending = nil
		report("transition fade", err)
	end
end

local function begin(actor, obj)
	if pending or not (coop_mode.actor_is_player() and actor and db.actor and actor:id() == db.actor:id()
		and core.peer_of(actor:id()) == core.self_peer()) then return end
	local id = obj and object_id(core.hid(obj:id()))
	local cfg = config_for(obj)
	local dest = cfg and destination(cfg)
	if not (id and dest) then return end
	local same_map = transitions.is_gvid_on_the_actor_level(dest.gid)
	-- Authorization can apply transition effects, so ask before sending the request.
	if not same_map and not coop_economy_travel.allow_cross_map_travel() then return end
	local trip = { cfg = cfg, dest = dest, same_map = same_map,
		ticket = math.random(1, MAX_TICKET), actor = db.actor, map = level.name(), expires = time_global() + REQUEST_MS }
	pending = trip
	local self = core.self_peer()
	if coop_mode.leads_here() then
		reply({ t = trip.ticket, ok = authorize(id, self) })
	elseif not core.to_host(REQUEST, { i = id, t = trip.ticket }) then
		pending = nil
	end
end

local function move(trip, actor)
	local dest = trip.dest
	if not trip.same_map then
		if not coop_economy_travel.allow_cross_map_travel() then return end
		-- The engine's level-change path applies the session's cross-map rules.
		return ChangeLevel(dest.pos, level.vertex_id(dest.pos), dest.gid, dest.dir, false)
	end
	local origin = actor:position()
	-- Retain the stock heading modulo a turn, within the group event's bounds.
	local heading = (math.deg(dest.dir.y) + math.pi) % (2 * math.pi) - math.pi
	actor:set_actor_position(dest.pos)
	actor:set_actor_direction(heading)
	if group_travel() then
		coop_economy_travel.group_teleport(dest.pos, heading, origin, TRAVEL_OFFER, "travel")
	end
end

local function update()
	local now = time_global()
	if now >= sweep_at then
		for key, expires in pairs(seen) do
			if expires <= now then seen[key] = nil end
		end
		sweep_at = now + REQUEST_MS
	end
	local trip = pending
	if not trip then return end
	local actor = core.active() and owner_of(trip)
	if not actor or (not trip.move_at and now >= trip.expires) then
		pending = nil
	elseif trip.move_at and now >= trip.move_at then
		pending = nil
		local ok, err = pcall(move, trip, actor)
		if not ok then report("transition move", err) end
	end
end

local function respond(from, ticket, ok)
	core.to_peer(from, RESULT, { t = ticket, ok = ok })
end

local function request(t, from)
	local id, ticket = object_id(t.i), ticket_id(t.t)
	if not coop_trust.pass("g15_transition_request", id and ticket, "peer %s sent an invalid transition id or ticket",
		tostring(from)) or not ticket then return end
	local now = time_global()
	local key = tostring(from) .. ":" .. tostring(ticket)
	if seen[key] and seen[key] > now then return end
	seen[key] = now + REQUEST_MS + FADE_MS
	local ok, allowed = pcall(authorize, id, from)
	if not ok then report("transition request", allowed) end
	respond(from, ticket, ok and allowed == true)
end

local function show_prompt(obj)
	local actor = coop_mode.actor_is_player() and db.actor
	local cfg = config_for(obj)
	if pending or not (cfg and actor and actor:alive() and within_reach(actor, obj)) then return end
	if cfg.disable_dialog then return transitions.teleport_actor(actor, obj) end
	local ui = core.mod("lc_extra_transitions_ui")
	if not ui then return end
	local dialog = ui.create_dialog()
	dialog:SetObj(obj)
	dialog:Show()
end

local function nearby_players(obj, f)
	if not coop_mode.leads_here() then return false end
	for _, p in ipairs(core.player_objects()) do
		if coop_mode.where(p.peer) == "here" and p.obj:alive() and within_reach(p.obj, obj) and f(p) then return true end
	end
	return false
end

local function prompt_players(obj, cfg)
	nearby_players(obj, function(p)
		local ok, eligible = core.as_player(p.obj, precondition, p.obj, obj, cfg)
		if not ok then report("transition precondition", eligible) end
		if not (ok and eligible) then return end
		if p.peer == core.self_peer() then
			show_prompt(obj)
		else
			core.to_peer(p.peer, PROMPT, { i = core.hid(obj:id()) })
		end
	end)
end

local function wrap_world_callback(key, callback)
	local wrapped, orig = core.wrap(transitions, key, "lc_extra_transitions." .. key, function(f)
		return function(...)
			if not core.active() or coop_mode.decides_world() then return f(...) end
		end
	end)
	if wrapped then core.swap_callback(callback, orig, transitions[key]) end
end

local function install_transitions()
	transitions = core.mod("lc_extra_transitions")
	stock_teleport = core.fn(transitions, "teleport_actor")
	if not stock_teleport then return end
	core.wrap(transitions, "teleport_actor", "lc_extra_transitions.teleport_actor", function(orig)
		return function(actor, obj, ...)
			if not core.active() then return orig(actor, obj, ...) end
			local ok, err = pcall(begin, actor, obj)
			if not ok then
				pending = nil
				report("transition start", err)
			end
		end
	end)
	core.wrap(transitions, "handle_nearby_actor", "lc_extra_transitions.handle_nearby_actor", function(orig)
		return function(actor, obj, ...)
			if not core.active() then return orig(actor, obj, ...) end
			local cfg = config_for(obj)
			if cfg then prompt_players(obj, cfg) end
		end
	end)
	core.wrap(xr_conditions, "is_actor_inside_lc", "lc_extra_transitions.is_actor_inside_lc", function(orig)
		return function(actor, obj, ...)
			if not core.active() then return orig(actor, obj, ...) end
			local gate = config_for(obj) and obj or (config_for(actor) and actor)
			return gate and nearby_players(gate, function() return true end) or false
		end
	end, "lc_extra_transitions")
	wrap_world_callback("actor_on_first_update", "actor_on_first_update")
	wrap_world_callback("delete_level_transitions", "on_option_change")
	core.on(PROMPT, function(t) show_prompt(object_for(object_id(t.i))) end, "player")
	core.on(REQUEST, request, "host")
	core.on(RESULT, reply, "player")
	core.set_limit(REQUEST, 3, 1, function(t, from)
		local ticket = ticket_id(t.t)
		if ticket then respond(from, ticket, false) end
	end)
	RegisterScriptCallback("actor_on_update", update)
end

function on_game_start()
	if started or not rawget(_G, "coop") then return end
	started = true
	core.install("travel_compat", "campfire", install_campfire)
	core.install("travel_compat", "extra transitions", install_transitions)
end
