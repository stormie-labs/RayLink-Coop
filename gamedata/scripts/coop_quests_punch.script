-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - the robber's punch lands on the player he robs (gamedata\scripts\coop_quests_punch.script):
	xr_effects.script:2686, state_mgr_animation_list.script:336, state_mgr_animation.script:518.

	xr_effects.actor_punch puts the punch on db.actor: the input lock (30 s), the camera (camera_effects\fusker.anm) and the
	weapon in hand dropped. Two ways call it:
	  - a condlist effect (zat_b14_stalker_1, the Zaton robbery: remark@punch on_timer %=actor_punch%) as (actor, npc, p): the
	    stock then compares db.actor with itself, so its 2 m never mattered there;
	  - the special action of the "punch" animation (state_mgr_animation_list.animations.punch.into: {f = xr_effects.actor_punch})
	    as (npc), from state_mgr_animation:process_special_action. That list keeps the function itself, read when it loaded:
	    a wrapper of xr_effects.actor_punch alone misses it, so its entries are patched too.
	The process that leads the map (the co-op host; in the server mode the map server of that level, whose actor is a ghost)
	ran it on its own actor: the host got a client's punch, a map server punched nobody.

	Here, where the map is led (coop_mode.leads_here()): when an NPC is put in the "punch" state (state_mgr.set_state: xr_abuse,
	xr_remark) its victim is chosen and kept: the state's look_object when it is a player's character, else the player nearest
	to the NPC. Each punch lands on the kept victim of that NPC, else the player nearest to it, when he stands within reach
	(the stock's distance_to_sqr > 4: 2 m); a far victim gets nothing. The
	consequences are his own: his machine runs the stock function on its own actor (mods.qpunch, side "player"), once per order;
	the co-op host's own player gets the same function directly. A player's machine (its world is a copy) and a world server
	without the map do nothing with a punch: the decider orders it. Outside a session every wrapper is the stock function.

	For other scripts (G15-5, coop_npc_logic: the abuse and remark targets kept per player):
	  punch(victim_character_id, npc_id, kind) -> true | false, why
	      kind "keep": keep the victim for that NPC, no punch now; any other ("condlist", "anim", ...): the punch lands now
	  victim_of(npc_id) -> character id | nil      the kept victim (forgotten after KEEP_MS)
	Wire: mods.qpunch, the decider -> the victim's machine: { o = order id, n = NPC id (host numbering), k = kind }.
	Wrapped (coop_mods_core.wrap): xr_effects.actor_punch, state_mgr.set_state; patched: the punch entries of
	state_mgr_animation_list(_animpoint).animations.
--]]

local tostring, tonumber, type, pairs, ipairs, pcall, rawget = tostring, tonumber, type, pairs, ipairs, pcall, rawget
local string_format = string.format

local TAG = "punch"
local ORDER = "qpunch" -- mods.qpunch
local REACH_SQR = 4 -- the stock: db.actor:position():distance_to_sqr(npc:position()) > 4 -> no punch
local KEEP_MS = 60000 -- a kept victim is forgotten after a minute
local SERVED_MAX = 64 -- the orders this machine remembers: one punch per order
local MAX_ORDER = 48
local LISTS = { "state_mgr_animation_list", "state_mgr_animation_list_animpoint" } -- the lists whose entries keep functions

local stock_punch = nil -- xr_effects.actor_punch as it was
local kept = {} -- npc id -> { victim = character id, at = time_global() }
local served, served_order = {}, {}
local seq = 0
local installed = false

stats = { kept = 0, sent = 0, own = 0, landed = 0, again = 0, far = 0, nobody = 0, elsewhere = 0, copy = 0 }

local function id_of(o)
	if o == nil then return nil end
	local ok, id = pcall(function() return o:id() end)
	return ok and type(id) == "number" and id or nil
end

-- This process's own actor when it is a player's character (the co-op host's; a server's actor is a ghost).
local function own_id()
	if not (db.actor and coop_mode.actor_is_player()) then return nil end
	return id_of(db.actor)
end

-- The peer of a player's character on this process, the own player included; nil: no player's character.
local function peer_of_character(id)
	if type(id) ~= "number" then return nil end
	if id == own_id() then return coop_mods_core.self_peer() end
	if id == id_of(db.actor) then return nil end -- a ghost
	return coop_mods_core.peer_of(id)
end

local function object_of(id)
	if id == id_of(db.actor) then return db.actor end
	return level.object_by_id(id)
end

local function alive(o)
	local ok, v = pcall(function() return o:alive() end)
	return not ok or v ~= false
end

local function dist_sqr(a, b)
	local ok, d = pcall(function() return a:position():distance_to_sqr(b:position()) end)
	return ok and type(d) == "number" and d or nil
end

-- The living player's character nearest to the NPC on this process: its id, or nil.
local function nearest(npc)
	local best, best_d
	local function try(id)
		local o = id and object_of(id)
		local d = o and alive(o) and dist_sqr(o, npc)
		if d and (best_d == nil or d < best_d) then best, best_d = id, d end
	end
	try(own_id())
	for _, p in ipairs(coop_mods_core.players()) do
		if not p.is_self and type(p.avatar_id) == "number" then try(p.avatar_id) end
	end
	return best
end

local function remember(npc_id, victim)
	kept[npc_id] = { victim = victim, at = time_global() }
	stats.kept = stats.kept + 1
end

function victim_of(npc_id)
	local k = kept[tonumber(npc_id)]
	if not k then return nil end
	if time_global() - k.at > KEEP_MS then
		kept[tonumber(npc_id)] = nil
		return nil
	end
	return k.victim
end

-------------------------------------------------------------------------------
-- The victim's machine
-------------------------------------------------------------------------------
-- mods.qpunch, side "player" (from the decider through the world, peer 0), and the co-op host's own player directly: the stock
-- consequences on this machine's own actor. The actor stands for the NPC: the reach was judged where the map is led, the
-- positions here lag behind it.
local function land(t, from)
	local o = type(t) == "table" and t.o or nil
	if type(o) == "string" and #o > 0 and #o <= MAX_ORDER then
		local key = tostring(from) .. "|" .. o
		if served[key] then
			stats.again = stats.again + 1
			return
		end
		served[key] = true
		served_order[#served_order + 1] = key
		if #served_order > SERVED_MAX then served[table.remove(served_order, 1)] = nil end
	end
	if not (db.actor and stock_punch) then return end
	stats.landed = stats.landed + 1
	stock_punch(db.actor)
end

-------------------------------------------------------------------------------
-- Where the map is led
-------------------------------------------------------------------------------
local function deliver(victim, npc_id, kind)
	seq = seq + 1
	local t = { o = string_format("%d-%d", time_global(), seq), n = coop_mods_core.hid(npc_id), k = tostring(kind) }
	if victim == own_id() then
		-- the co-op host's own player: the order's own function, here (side "player" would bring it back a frame later)
		stats.own = stats.own + 1
		land(t, coop_mods_core.self_peer())
		return true
	end
	local peer = peer_of_character(victim)
	if peer == nil or coop_mode.decider(peer) ~= "this" then
		stats.elsewhere = stats.elsewhere + 1
		return false, "another process decides for him"
	end
	if not coop_mods_core.to_peer(peer, ORDER, t) then return false, "not sent" end
	stats.sent = stats.sent + 1
	return true
end

function punch(victim, npc_id, kind)
	victim, npc_id = tonumber(victim), tonumber(npc_id)
	if not (victim and npc_id) then return false, "no ids" end
	if not coop_mods_core.active() then return false, "no session" end
	if not coop_mode.leads_here() then
		stats.copy = stats.copy + 1
		return false, "the map is led elsewhere"
	end
	if peer_of_character(victim) == nil then
		stats.nobody = stats.nobody + 1
		return false, "not a player's character"
	end
	if kind == "keep" then
		remember(npc_id, victim)
		return true
	end
	local npc, body = level.object_by_id(npc_id), object_of(victim)
	if not (npc and body) then
		stats.elsewhere = stats.elsewhere + 1
		return false, "not on this map"
	end
	local d = dist_sqr(body, npc)
	if not d or d > REACH_SQR then
		stats.far = stats.far + 1
		return false, "out of reach"
	end
	remember(npc_id, victim)
	return deliver(victim, npc_id, kind)
end

-- A punch of `npc`: on its kept victim, else on the player nearest to it.
local function judge(npc, kind)
	local nid = id_of(npc)
	if not nid then return end
	if not coop_mode.leads_here() then
		stats.copy = stats.copy + 1
		return
	end
	local victim = victim_of(nid) or nearest(npc)
	if not victim then
		stats.nobody = stats.nobody + 1
		return
	end
	punch(victim, nid, kind)
end

-- xr_effects.actor_punch: a condlist calls it (actor, npc, p), scripts (npc)
local function effect(a, b, ...)
	if not coop_mods_core.active() then return stock_punch(a, b, ...) end
	if id_of(b) then return judge(b, "condlist") end
	return judge(a, "anim")
end

-- the special action of the punch animation (state_mgr_animation:process_special_action: action_table.f(self.npc))
local function anim(npc, ...)
	if not coop_mods_core.active() then return stock_punch(npc, ...) end
	return judge(npc, "anim")
end

-- an NPC is put in the "punch" state (xr_abuse: look_object = db.actor; xr_remark: its target): its victim is chosen now
-- and kept for the animation and the condlist that follow. The state's look_object when it is a player's character, else the
-- player nearest to the NPC (a server's ghost is nobody's).
local function assign(npc, target)
	local nid = id_of(npc)
	if not nid then return end
	local vid = id_of(type(target) == "table" and target.look_object or nil)
	if not (vid and peer_of_character(vid)) then vid = nearest(npc) end
	if vid then remember(nid, vid) end
end

local function set_state_of(orig)
	return function(npc, state_name, callback, timeout, target, extra, ...)
		if state_name == "punch" and coop_mods_core.active() and coop_mode.leads_here() then
			local ok, err = pcall(assign, npc, target)
			if not ok then coop_mods_core.report(TAG, "the punch's victim", err) end
		end
		return orig(npc, state_name, callback, timeout, target, extra, ...)
	end
end

-- The function and the ones it wraps (upvalues, a few levels down): when another script wrapped xr_effects.actor_punch before
-- this one, the list entries still hold the stock function under that wrapper.
local function chain_of(f)
	local set, todo = {}, { { f, 0 } }
	local getupvalue = debug and debug.getupvalue
	while todo[1] do
		local item = table.remove(todo)
		local g, depth = item[1], item[2]
		if type(g) == "function" and not set[g] then
			set[g] = true
			if getupvalue and depth < 3 then
				for i = 1, 60 do
					local name, v = getupvalue(g, i)
					if name == nil then break end
					if type(v) == "function" then todo[#todo + 1] = { v, depth + 1 } end
				end
			end
		end
	end
	return set
end

-- The animation lists keep the function itself ({f = xr_effects.actor_punch}, read when the list loaded, before any wrapper):
-- every such entry is pointed at anim. A wrapper of xr_effects alone would never see these punches.
local function patch_entries(t, punches, seen, depth)
	if depth > 6 or seen[t] then return 0 end
	seen[t] = true
	local n = 0
	for _, v in pairs(t) do
		if type(v) == "table" then
			local f = rawget(v, "f")
			if f ~= nil then
				if punches[f] then
					v.f = anim
					n = n + 1
				end
			else
				n = n + patch_entries(v, punches, seen, depth + 1)
			end
		end
	end
	return n
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
local function install()
	if installed then return end
	installed = true
	local xe = coop_mods_core.mod("xr_effects")
	local ok = xe and coop_mods_core.wrap(xe, "actor_punch", "xr_effects.actor_punch (the robbed player)", function(orig)
		stock_punch = orig
		return effect
	end)
	if not ok then
		coop_mods_core.log(TAG, "! xr_effects.actor_punch not found: the punch stays the stock one")
		return
	end
	local punches = chain_of(stock_punch)
	punches[effect] = true -- a list loaded after this install holds the wrapper
	local patched = 0
	for _, name in ipairs(LISTS) do
		local list = coop_mods_core.mod(name)
		local anims = list and rawget(list, "animations")
		if type(anims) == "table" then patched = patched + patch_entries(anims, punches, {}, 0) end
	end
	local sm = coop_mods_core.mod("state_mgr")
	local kept_ok = sm and coop_mods_core.wrap(sm, "set_state", "state_mgr.set_state (the punch's victim)", set_state_of)
	coop_mods_core.log(TAG, "the punch lands on the robbed player: %d entries of the animation lists%s", patched,
		kept_ok and "" or ", ! state_mgr.set_state not found: no victim is kept")
end

function on_game_start()
	if not coop_mods_core.engine() then return end
	coop_util.start_step("coop_quests_punch", "the order", function() coop_mods_core.on(ORDER, land, "player") end)
	coop_util.start_step("coop_quests_punch", "status", function()
		coop_mods_core.status_line(TAG, function()
			return string_format("kept %d, sent %d, own %d, landed %d (again %d), far %d, nobody %d, elsewhere %d, copy %d",
				stats.kept, stats.sent, stats.own, stats.landed, stats.again, stats.far, stats.nobody, stats.elsewhere, stats.copy)
		end)
	end)
	coop_util.start_step("coop_quests_punch", "install", function()
		RegisterScriptCallback("actor_on_first_update", function()
			local ok, err = pcall(install)
			if not ok then coop_mods_core.report(TAG, "install", err) end
		end)
	end)
end
