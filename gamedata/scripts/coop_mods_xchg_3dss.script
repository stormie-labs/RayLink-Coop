-- Ядро: без проверок режима (docs/MODES.md)
-- 3DSS battery extraction, canted scope removal and silencer installation.
-- The player's level authority handles extraction. The other two actions use the native
-- create/attach requests and keep the mod's condition transfer pending until they settle.

local api = rawget(_G, "coop")
local THERMAL, SILENCER = "z_3dss_thermal_battery", "z_3dss_silencer_condition"
local FUNCTOR, BATT = "3dss_remove_thermal_battery", "3dss_batt"
local WAIT_MS = 10000
local battery, scopes, silencers = nil, {}, {}
local used_silencers = {}
local installed = {}

local core = coop_mods_core
local xchg = coop_mods_xchg
local function own(obj)
	return obj and db.actor and core.root_of(obj:id()) == db.actor:id()
end

local function player()
	return core.active() and coop_mode.actor_is_player()
end

local function report(step, err) core.report("xchg_3dss", step, err) end

-- 3DSS keeps its selection and state setters private. Use the same functions for
-- built-in, main and canted sights, including its versioned loose-sight records.
local function thermal_helpers()
	local mod = core.mod(THERMAL)
	if not mod then return nil end
	local patches = core.upvalue(mod.on_game_start, "install_patches")
	local functor = core.upvalue(patches, "install_battery_functor")
	local action = core.upvalue(functor, "remove_battery")
	local label = core.upvalue(functor, "battery_remove_name")
	local read = core.upvalue(action, "removable_charge")
	local loose, loose_holder, loose_index = core.upvalue(action, "set_loose_charge")
	local loose_read, read_holder, read_index = core.upvalue(read, "loose_charge")
	local slot = core.upvalue(action, "set_slot_entry")
	local refresh = core.upvalue(action, "refresh_shader_if_needed")
	local entry = core.upvalue(mod.on_canted_removed, "get_slot_entry")
	local read_state = core.upvalue(loose, "read_state")
	local write_state = core.upvalue(loose, "write_state")
	local object_section = core.upvalue(loose, "object_section")
	if not (label and read and loose and loose_read and slot and entry and read_state and write_state and object_section) then return nil end
	local function read_condition(obj)
		if not core.active() then return loose_read(obj) end
		local installed = entry(obj, "loose")
		-- A fresh scope may have ordinary item condition even though it has never held a battery.
		if not (installed and installed.section == obj:section()) then return 0 end
		return obj:condition()
	end
	local function write_condition(item, section, value)
		if not core.active() then return loose(item, section, value) end
		if not item then return false end
		value = math.max(0, math.min(1, tonumber(value) or 0))
		local obj = type(item.set_condition) == "function" and item or level.object_by_id(item.id)
		if obj then
			obj:set_condition(value)
			if math.abs(obj:condition() - value) > 0.00001 then return false end
		elseif coop_mode.is_player_mirror() then
			-- A native detach can produce a lease placeholder before the local item
			-- exists. Use the stock ItemProcessor for its owner's deferred condition.
			if not (db.actor and item.parent_id == db.actor:id() and alife_process_item) then return false end
			alife_process_item(section or object_section(item), item.id, { cond = value })
		elseif not (api.items and api.items.set_initial and api.items.set_initial(item.id, { condition = value })) then
			return false
		end
		local state = read_state(item)
		state.loose = { section = section or object_section(item) }
		write_state(item, state)
		return true
	end
	debug.setupvalue(read_holder, read_index, read_condition)
	debug.setupvalue(loose_holder, loose_index, write_condition)
	return { mod = mod, label = label, action = action, read = read, loose = write_condition, slot = slot, entry = entry,
		refresh = refresh }
end

local function battery_section()
	return core.upvalue(battery.action, "battery_section")
end

local function battery_source(t, from, who)
	local id = core.wire_id(t.src)
	if id == nil or t.key ~= t.src then return nil, "bad source id" end
	local obj = level.object_by_id(id)
	if not (obj and who and core.root_of(id) == who:id() and core.holder_peer(id) == from and coop_mode.writes(id)) then
		return nil, "source not owned"
	end
	return obj
end

local function serve_battery()
	xchg.serve(BATT, {
		check = function(t, from, who)
			local obj, why = battery_source(t, from, who)
			return obj ~= nil, why -- coop_mods_xchg calls coop_trust.pass before reserve runs.
		end,
		reserve = function(t, from, who)
			local obj, why = battery_source(t, from, who)
			if not obj then return nil, why end
			battery = battery or thermal_helpers()
			if not battery then return nil, "no battery adapter" end
			local id = obj:id()
			if scopes[id] then return nil, "scope pending" end
			return { ids = { id }, obj = obj }
		end,
		commit = function(_, from, _who, token)
			local obj = token.obj
			local value, slot, section = battery.read(obj)
			if not value then return false, "no charge" end
			token.value, token.slot, token.section = value, slot, section
			if slot then
				battery.slot(obj, slot, section, 0)
				local current = battery.entry(obj, slot)
				if not current or current.charge ~= 0 then return false, "charge" end
			elseif not battery.loose(obj, section, 0) then
				return false, "charge"
			end
			if not core.give(from, battery_section(), value) then return false, "create" end
			return true, { slot = slot or "loose", section = section }
		end,
		rollback = function(_, _, _, token)
			if token.value == nil then return end
			if token.slot then battery.slot(token.obj, token.slot, token.section, token.value)
			else battery.loose(token.obj, token.section, token.value) end
		end,
	})
end

local function battery_menu(orig, obj, ...)
	if core.active() and (not player() or not own(obj) or scopes[obj:id()]) then return nil end
	return orig(obj, ...)
end

local function battery_action(orig, obj, ...)
	if not core.active() then return orig(obj, ...) end
	if not (player() and own(obj)) or scopes[obj:id()] then return end
	local id, source_section = core.hid(obj:id()), obj:section()
	if id == nil or xchg.busy(BATT, id) then return end
	xchg.ask(BATT, { key = id, src = id }, function(ok, result)
		if not ok then return end
		local local_id = core.lid(id)
		local source = local_id and level.object_by_id(local_id)
		if not (type(result) == "table" and own(source) and source:section() == source_section) then return end
		local slot = result.slot
		if slot == "loose" or slot == "main" or slot == "canted" then
			local entry = battery.entry(source, slot)
			if entry and entry.section == result.section then
				if slot ~= "loose" and battery.refresh then battery.refresh(source, slot, 0, true) end
			end
		end
		if actor_effects then actor_effects.play_item_fx(battery_section()) end
		utils_obj.play_sound("interface\\inv_batt")
	end)
end

local function battery_busy(obj)
	if not obj then return false end
	local id = obj:id()
	return scopes[id] ~= nil or xchg.busy(BATT, core.hid(id))
end

local function guard_battery_writes()
	local mod = battery.mod
	local drag = core.fn(mod, "on_item_drag_dropped")
	if core.wrap(mod, "on_item_drag_dropped", "3DSS battery pending exchange", function(orig)
		return function(first, second, ...)
			if player() and (battery_busy(first) or battery_busy(second)) then return end
			return orig(first, second, ...)
		end
	end) then
		core.swap_callback("ActorMenu_on_item_drag_drop", drag, mod.on_item_drag_dropped)
	end
	local start = core.upvalue(mod.on_game_start, "start_drain_event")
	local tick = core.upvalue(start, "drain_tick_callback")
	local drain, holder, index = core.upvalue(tick, "drain_active_scope")
	if drain then
		debug.setupvalue(holder, index, function(elapsed)
			if player() and db.actor and battery_busy(db.actor:active_item()) then return end
			return drain(elapsed)
		end)
	end
end

local function install_battery()
	battery = battery or thermal_helpers()
	local functors = battery and core.mod("custom_functor_autoinject")
	if not functors then return end
	local inventory = core.mod("ui_inventory")
	local gui = inventory and inventory.GUI
	local find = core.fn(gui, "get_functor_by_name")
	local handlers = find and find(gui, FUNCTOR)
	local registered = handlers ~= nil
	handlers = handlers or { cond_name = battery.label, func_name = battery.label, cond_action = battery.label,
		func_action = battery.action }
	for _, key in ipairs({ "cond_name", "func_name", "cond_action", "func_action" }) do
		core.wrap(handlers, key, "3DSS battery " .. key, function(orig)
			local run = key == "func_action" and battery_action or battery_menu
			return function(...) return run(orig, ...) end
		end)
	end
	if not registered then
		functors.add_functor(FUNCTOR, handlers.cond_name, handlers.func_name, handlers.cond_action, handlers.func_action, true)
	end
	installed.battery = true
	guard_battery_writes()
end

-- On a mirror the returned object is provisional until lease_waiting goes false.
-- Keep the sight mounted until then. Replay the single create inside remove_irons
-- with the actual result, so its bookkeeping and the 3DSS callback still run.
local function complete_scope(p)
	if not p.target then return end
	local se = alife_object(p.target)
	if not se then scopes[p.id] = nil return end -- refused create
	if p.mirror and api.lease_waiting(p.target) then return end
	scopes[p.id] = nil
	local owner, weapon = db.actor, level.object_by_id(p.id)
	if not (owner and owner:id() == p.owner and se.parent_id == p.owner and se:section_name() == p.section) then return end
	if not own(weapon) or p.canted.get_installed_section(weapon) ~= p.section then
		alife_release(se)
		return
	end
	local create, supplied = _G.alife_create_item, false
	_G.alife_create_item = function(section, parent, ...)
		if not supplied and section == p.section and parent and parent:id() == p.owner then
			supplied = true
			return se
		end
		return create(section, parent, ...)
	end
	local ok, err = pcall(p.remove, weapon, unpack(p.args, 1, p.args.n))
	_G.alife_create_item = create
	if not ok then report("canted removal", err) end
	if not supplied then alife_release(se) return end
	-- The thermal wrapper restores its snapshot if it did not see the create
	-- through its own spawn hook. Give it the exact result after it has returned.
	battery.mod.on_canted_removed(weapon, se, p.section)
end

local function scope_guard(canted, orig)
	return function(weapon, ...)
		if not player() or not weapon then return orig(weapon, ...) end
		local id = weapon:id()
		if scopes[id] then return end
		local entry = battery.entry(weapon, "canted")
		local section = canted.get_installed_section(weapon)
		if not entry or not section or entry.section ~= section then return orig(weapon, ...) end
		if not own(weapon) or xchg.busy(BATT, core.hid(id)) then return end
		local mirror = coop_mode.is_player_mirror()
		if mirror and (not api.lease_ids or not api.lease_waiting or api.lease_ids() < 1 or api.lease_waiting(id)) then return end
		local p = { id = id, owner = db.actor:id(), section = section, charge = entry.charge, canted = canted, remove = orig,
			mirror = mirror, args = core.pack(...) }
		scopes[id] = p
		if mirror then
			xchg.after_made(section, p.owner, function(made)
				if scopes[id] == p and made == p.target then complete_scope(p) end
			end)
		end
		local ok, se = pcall(alife_create_item, section, db.actor, { cond = p.charge })
		if not ok then report("canted create", se) end
		p.target = ok and se and se.id
		if not p.target then scopes[id] = nil return end
		complete_scope(p)
	end
end

local function install_scope()
	local canted = battery and core.mod("scripted_canted_irons")
	if not canted or not core.fn(canted, "get_installed_section") then return end
	installed.scope = core.wrap(canted, "remove_irons", "3DSS canted removal", function(orig)
		return scope_guard(canted, orig)
	end)
	if not installed.scope then return end
	-- Replacement installs call remove_irons and continue regardless of its result.
	-- A powered canted sight must finish its own detach first.
	for _, key in ipairs({ "install_irons", "install_rds_pos1", "install_rds_pos2", "install_rds_pos3" }) do
		core.wrap(canted, key, "3DSS canted " .. key, function(orig)
			return function(item, weapon, ...)
				local target = weapon
				if player() then
					target = target or (db.actor and db.actor:active_item())
					if target and (scopes[target:id()] or (canted.get_installed_section(target) and battery.entry(target, "canted"))) then
						return
					end
				end
				return orig(item, weapon, ...)
			end
		end)
	end
end

local function finish_silencer(p)
	if silencers[p.weapon] ~= p then return end
	local weapon = level.object_by_id(p.weapon)
	if p.gone and own(weapon) and weapon:section() == p.weapon_section
		and p.utils.get_attached_silencer(weapon) == p.section
	then
		local current = coop_mods_items.native_silencer_state(weapon, false)
		local wear = p.wear + math.max(0, p.baseline - current)
		p.write(weapon, { section = p.section, condition = math.max(0, p.condition - wear) })
	elseif not p.failed and time_global() < p.deadline then
		return
	end
	silencers[p.weapon], used_silencers[p.item] = nil, nil
end

local function install_silencer()
	local mod = core.mod(SILENCER)
	local utils = mod and core.mod("utils_item")
	if not utils then return end
	local fired = core.upvalue(mod.on_game_start, "actor_on_weapon_fired")
	local per_shot = core.upvalue(fired, "condition_per_shot")
	local enabled = core.upvalue(fired, "silencer_wear_enabled")
	local write = core.upvalue(fired, "write_state")
	if not (per_shot and enabled and write) then return end
	installed.silencer = core.wrap(utils, "attach_addon", "3DSS silencer attachment", function(orig)
		return function(weapon, item, kind, ...)
			if not player() or kind ~= "sil" or not (weapon and item) then return orig(weapon, item, kind, ...) end
			local wid, id = weapon:id(), item:id()
			if silencers[wid] or used_silencers[id] or not own(weapon) or not own(item) then return end
			local section = item:section()
			if not IsItem("sil", section) or utils.get_attached_silencer(weapon) then
				return orig(weapon, item, kind, ...)
			end
			local p = { weapon = wid, weapon_section = weapon:section(), item = id, section = section, utils = utils,
				condition = math.max(0, math.min(1, item:condition())), write = write, wear = 0,
				deadline = time_global() + WAIT_MS }
			local result = core.pack(orig(weapon, item, kind, ...))
			if result[1] == false then return unpack(result, 1, result.n) end
			p.baseline = coop_mods_items.native_silencer_state(weapon, false)
			silencers[wid], used_silencers[id] = p, p
			xchg.after_gone(id, function(gone)
				p.gone, p.failed = gone, not gone
				finish_silencer(p)
			end, WAIT_MS)
			return unpack(result, 1, result.n)
		end
	end)
	if not installed.silencer then return end
	core.swap_callback("actor_on_weapon_fired", fired, function(actor, weapon, ...)
		local p = player() and weapon and silencers[weapon:id()]
		if not p or utils.get_attached_silencer(weapon) ~= p.section then return fired(actor, weapon, ...) end
		if enabled() and IsWeapon(weapon) and not weapon:weapon_in_grenade_mode() then
			p.wear = p.wear + per_shot(p.section)
		end
	end)
	core.wrap(utils, "detach_addon", "3DSS silencer pending attachment", function(orig)
		return function(weapon, item, kind, ...)
			if player() and kind == "sil" and weapon and silencers[weapon:id()] then return end
			return orig(weapon, item, kind, ...)
		end
	end)
end

local function update()
	if not core.active() then return end
	if not installed.battery then core.install("xchg_3dss", "battery functor", install_battery) end
	if not installed.scope then core.install("xchg_3dss", "canted hook", install_scope) end
	if not installed.silencer then core.install("xchg_3dss", "silencer hook", install_silencer) end
	for _, p in pairs(scopes) do complete_scope(p) end -- an already-online lease may predate after_made's next poll
	for _, p in pairs(silencers) do
		if p.gone then finish_silencer(p) end -- the attachment itself can replicate after the removal
	end
end

function on_game_start()
	if not api then return end
	core.install("xchg_3dss", "battery exchange", serve_battery)
	core.install("xchg_3dss", "actor update", function() RegisterScriptCallback("actor_on_update", update) end)
end
