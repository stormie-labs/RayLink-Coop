-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - Keep Crafting Window Opened (Demonized): a repair waits for the confirmed removal of what the last one
	spent (gamedata\scripts\coop_mods_xchg_repair.script).

	zz_item_repair_keep_crafting_window_open replaces item_repair.UIRepair.OnRepair (:206): it repairs the item at once,
	spends the support part and a kit use (utils_item.discharge / degrade, alife_release for the last use), disables the
	button and refreshes the window 0.1 s later from the inventory of this machine (UpdateUi, :156). On a player's machine
	whose objects are copies (a co-op client, a server player) the release is a request (coop_requests.cpp client_destroy):
	the part stays here until the process that decides removes it, the refresh lists it again and gives the button back
	(a selection does too: stock item_repair.script:378), and a second repair is paid with the same part. On the co-op
	host the part's game object outlives its server object by a frame: a second click in that frame does the same.

	Here, in a session (every process with a player; the spend already goes through the engine's request path, so this
	only guards and refreshes):
	  - OnRepair records what it releases (alife_release / alife_release_id while it runs); while any of it is still here
	    (coop_mods_xchg.after_gone) a further OnRepair is ignored and the button stays off;
	  - the mod's own refresh (UpdateUi) is held while the removal is not confirmed and runs once it is, so the selection
	    and the lists are those of the real inventory; when the mod's timer does not run on this machine (routed host-only,
	    as the two other keep-window mods' are in coop_compat_crafting.ltx) the guard runs UpdateUi itself 0.3 s after the
	    repair, once the removal is confirmed; a window closed and opened again meanwhile (no selection) is left as it is;
	  - no confirmation in 5 s (a refused removal, a dead link): the window is closed, the next repair is the player's.
	Outside a session both wrappers call the mod unchanged. Installed only when the mod is there, at the first update and
	again within a second when a later script wraps the methods (zz_item_repair_sounds_oleh wraps OnRepair): outermost,
	so an ignored click plays no sound. Nothing on the wire, nothing saved.
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local type, pairs, ipairs, pcall, select, unpack, rawget, rawset, rawequal =
	type, pairs, ipairs, pcall, select, unpack, rawget, rawset, rawequal

local MOD = "zz_item_repair_keep_crafting_window_open"
local CONFIRM_MS = 5000 -- as the crafting windows' guard (coop_mods_guard SETTLE_MAX_MS)
local OWED_MS = 300     -- the mod refreshes 0.1 s after a repair; not by then: the guard does
local CHECK_MS = 1000
local MAX_REWRAPS = 5

stats = { waited = 0, ignored = 0, deferred = 0, refreshed = 0, closed = 0 }

local core = coop_mods_core
local function log(fmt, ...) core.log("xchg_repair", fmt, ...) end
local function id_of(x)
	if type(x) == "number" then return x end
	local ok, id = pcall(function()
		if type(x.id) == "number" then return x.id end
		return x:id()
	end)
	return ok and type(id) == "number" and id or nil
end

-- Runs f(self, ...): core.pack(pcall(..)) and the ids it released.
local function watched(f, self, ...)
	local ids = {}
	local function note(x)
		local id = id_of(x)
		if id then ids[id] = true end
	end
	local rel, rel_id = rawget(_G, "alife_release"), rawget(_G, "alife_release_id")
	if type(rel) == "function" then
		rawset(_G, "alife_release", function(x, ...) note(x); return rel(x, ...) end)
	end
	if type(rel_id) == "function" then
		rawset(_G, "alife_release_id", function(x, ...) note(x); return rel_id(x, ...) end)
	end
	local res = core.pack(pcall(f, self, ...))
	if type(rel) == "function" then rawset(_G, "alife_release", rel) end
	if type(rel_id) == "function" then rawset(_G, "alife_release_id", rel_id) end
	return res, ids
end

-------------------------------------------------------------------------------
-- The repair whose spend is on its way
-------------------------------------------------------------------------------
local waiting = nil -- { window, ids = { id = true }, left, refresh, since }

local function shown(win)
	local ok, yes = pcall(function() return win:IsShown() end)
	return ok and yes == true
end

local function close(win)
	stats.closed = stats.closed + 1
	local ok, e = pcall(function() win:OnCancel() end)
	if not ok then core.report("xchg_repair", "close the repair window", e) end
end

local owed = nil -- { window, due }: a confirmed repair whose refresh the mod has not run (yet)

local function refresh(win)
	if not shown(win) then return end
	-- closed and opened again meanwhile (OnCancel cleared the selection): the mod refreshes only with a selection
	local ok_sel, selected = pcall(function() return win.last_cont ~= nil and win.last_idx ~= nil end)
	if not (ok_sel and selected) then return end
	stats.refreshed = stats.refreshed + 1
	local ok, e = pcall(function() return win:UpdateUi() end)
	if not ok then
		core.report("xchg_repair", "refresh the repair window", e)
		close(win)
	end
end

local function confirmed(w)
	if waiting ~= w then return end
	waiting = nil
	if w.refresh then return refresh(w.window) end
	-- the mod's refresh (0.1 s after the repair) has not come: it comes and finds nothing to wait for; when its timer
	-- does not run here (routed host-only, as the other keep-window mods' are) the guard runs it a little later
	owed = { window = w.window, due = w.since + OWED_MS }
end

local function on_gone(w, id, gone)
	if waiting ~= w or not w.ids[id] then return end
	if gone ~= true then
		waiting = nil
		log("the removal of what a repair spent was not confirmed in %d ms: the window is closed", CONFIRM_MS)
		if shown(w.window) then close(w.window) end
		return
	end
	w.ids[id] = nil
	w.left = w.left - 1
	if w.left <= 0 then confirmed(w) end
end

local function wait_for(win, ids)
	local X = coop_mods_xchg
	local w = { window = win, ids = {}, left = 0, refresh = false, since = time_global() }
	for id in pairs(ids) do
		if X.after_gone(id, function(gone) on_gone(w, id, gone) end, CONFIRM_MS) then
			w.ids[id] = true
			w.left = w.left + 1
		end
	end
	if w.left == 0 then return end
	stats.waited = stats.waited + 1
	waiting = w
	pcall(function() win.btn_repair:Enable(false) end)
end

local function guard_repair(orig)
	return function(self, ...)
		if not core.active() then return orig(self, ...) end
		if waiting then
			stats.ignored = stats.ignored + 1
			if stats.ignored <= 3 or stats.ignored % 50 == 0 then
				log("a repair before the last one's spend was confirmed: ignored (#%d)", stats.ignored)
			end
			pcall(function() self.btn_repair:Enable(false) end)
			return
		end
		owed = nil -- a new repair: the mod schedules its own refresh
		local res, ids = watched(orig, self, ...)
		if next(ids) ~= nil then
			local ok, e = pcall(wait_for, self, ids)
			if not ok then core.report("xchg_repair", "wait for the spend", e) end
		end
		if not res[1] then error(res[2], 0) end
		return unpack(res, 2, res.n)
	end
end

local function guard_refresh(orig)
	return function(self, ...)
		if not core.active() then return orig(self, ...) end
		local w = waiting
		if w and rawequal(w.window, self) then
			stats.deferred = stats.deferred + 1
			w.refresh = true -- runs when the removal is confirmed
			return true -- a time event that is done
		end
		if owed and rawequal(owed.window, self) then owed = nil end -- the mod's own refresh came
		return orig(self, ...)
	end
end

-------------------------------------------------------------------------------
-- Install (outermost), start, status
-------------------------------------------------------------------------------
local GUARDS = {
	{ label = "item_repair.UIRepair.OnRepair", key = "OnRepair", make = guard_repair, n = 0 },
	{ label = "item_repair.UIRepair.UpdateUi", key = "UpdateUi", make = guard_refresh, n = 0 },
}

local function window_class()
	if not core.mod(MOD) then return nil end
	local ir = core.mod("item_repair")
	local ok, cls = pcall(function() return ir and ir.UIRepair end)
	return ok and cls or nil
end

local function ensure(g, cls)
	local cur = core.fn(cls, g.key)
	if not cur or cur == g.fn then return end
	if g.n >= MAX_REWRAPS then
		if not g.gave_up then
			g.gave_up = true
			log("! %s keeps being replaced, left as it is after %d wraps", g.label, g.n)
		end
		return
	end
	local ok = core.wrap(cls, g.key, g.label, g.make)
	if not ok then return end
	g.fn = core.fn(cls, g.key)
	g.n = g.n + 1
	if g.n > 1 then log("%s was wrapped by a later script: the guard is outermost again (#%d)", g.label, g.n) end
end

local next_check = 0
local function actor_on_update()
	local now = time_global()
	if owed and now >= owed.due then
		local o = owed
		owed = nil
		if core.active() then refresh(o.window) end
	end
	if now < next_check then return end
	next_check = now + CHECK_MS
	local cls = window_class()
	if not cls then return end
	for _, g in ipairs(GUARDS) do
		local ok, e = pcall(ensure, g, cls)
		if not ok then core.report("xchg_repair", "wrap " .. g.label, e) end
	end
end

local function status()
	local on = {}
	for _, g in ipairs(GUARDS) do
		if g.n > 0 then on[#on + 1] = g.label .. (g.n > 1 and ("x" .. g.n) or "") end
	end
	return string.format("repairs that waited for their spend %d (now %s), repeats ignored %d, refreshes held %d and run "
		.. "after the confirmation %d, windows closed without a confirmation %d | guarding: %s", stats.waited,
		waiting and "waiting" or "none", stats.ignored, stats.deferred, stats.refreshed, stats.closed,
		#on > 0 and table.concat(on, ", ") or "nothing (the mod is not installed)")
end

function on_game_start()
	if not api then return end
	core.install("xchg_repair", "start", function()
		RegisterScriptCallback("actor_on_update", actor_on_update)
		core.status_line("xchg_repair", status)
	end)
end
