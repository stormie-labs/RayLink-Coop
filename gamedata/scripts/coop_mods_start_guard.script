-- Ядро: без проверок режима (docs/MODES.md)
-- Co-op: the host decides inventory actions; Server: the level's object owner
-- decides them. The original release calls keep that engine path. This adapter
-- only waits for Live and observes confirmation in the own inventory.
-- Water and ImGui are local: probe the own actor, ask the original widget's route.
-- No new wire messages or saved keys. grw_in_water stays cleared in a session (the probe below replaces it).

local core = coop_mods_core
local api = rawget(_G, "coop")
local PERIOD_MS, WAIT_MS = 250, 15000
local cleanup = {}
local installed = {}
local widget_wrappers = setmetatable({}, { __mode = "k" })
local knife_sections = { "ammo_knife", "ammo_knife_2", "ammo_knife_3", "ammo_knife_4", "ammo_knife_5", "ammo_knife_6" }

local function own_actor()
	if not coop_mode.actor_is_player() then return nil, false end
	return db and db.actor, true
end

local function has_knife(actor)
	for _, section in ipairs(knife_sections) do
		if actor:object(section) then return true end
	end
	return false
end

local function install_cleanup()
	local mod = core.mod("grok_remove_knife_ammo_on_start")
	if not mod then return false end
	for _, key in ipairs({ "remove_knife_ammo_1", "remove_knife_ammo_2" }) do
		core.wrap(mod, key, "grok_remove_knife_ammo_on_start." .. key, function(orig)
			return function(...)
				if not core.active() then return orig(...) end
				if not api.is_live() then return false end -- keep the mod's event queued
				local actor, plays = own_actor()
				if plays == false then return true end
				local state = cleanup[key]
				if not state or (actor and state.actor and state.actor ~= actor:id()) then
					state = { started = time_global() }
					cleanup[key] = state
				end
				if state.done then return true end
				-- The first stock pass schedules the second even when its inventory is empty.
				-- Only short-circuit on an empty inventory after running the original once.
				if actor and state.next_try and not has_knife(actor) then state.done = true; return true end
				local now = time_global()
				if now - state.started >= WAIT_MS then
					state.done = true
					core.log("start_guard", "%s: removal still unconfirmed after %d ms", key, WAIT_MS)
					return true
				end
				if not actor then return false end -- Live can precede the Lua actor
				state.actor = actor:id()
				if state.next_try and now < state.next_try then return false end
				state.next_try = now + PERIOD_MS
				local ok, err = pcall(orig, ...)
				if not ok then core.report("start_guard", key, err) end
				-- A release call's return is not an acknowledgement. Several objects
				-- may share a section; continue until the inventory confirms all gone.
				if not has_knife(actor) then state.done = true; return true end
				return false
			end
		end)
	end
	return true
end

-- The probe of the water under the actor: its result stays while he stands where it was taken (the same ray gives the
-- same surface), so a player who does not move costs no ray.
local water = { x = nil, y = nil, z = nil, wet = false }
local probe_from, DOWN = vector(), vector():set(0, -1, 0)

local function in_water(actor)
	local pos = actor:position()
	if pos.x == water.x and pos.y == water.y and pos.z == water.z then return water.wet end
	water.x, water.y, water.z = pos.x, pos.y, pos.z
	probe_from:set(pos)
	probe_from.y = probe_from.y + 0.5
	local material = level.pick_material(probe_from, DOWN, 1.5, actor)
	water.wet = type(material) == "string" and material:find("water", 1, true) ~= nil
	return water.wet
end

local function clear_water()
	water.x = nil
	if not core.active() then return end
	local actor = own_actor()
	if actor then save_var(actor, "grw_in_water", nil) end
end

local function install_water()
	local mod = core.mod("gameplay_radioactive_water")
	if not mod then return false end
	local ok, old = core.wrap(mod, "actor_on_footstep", "gameplay_radioactive_water.actor_on_footstep", function(orig)
		return function(...)
			if not core.active() then return orig(...) end
			-- Footsteps do not persist a surface flag. Even a stationary actor is
			-- probed on update, after a load/transition and before applying damage.
		end
	end)
	if ok then core.swap_callback("actor_on_footstep", old, mod.actor_on_footstep) end
	ok, old = core.wrap(mod, "actor_on_update", "gameplay_radioactive_water.actor_on_update", function(orig)
		return function(obj, delta, ...)
			if not core.active() then return orig(obj, delta, ...) end
			if not api.is_live() then return end
			local actor = own_actor()
			if not actor then return end
			if load_var(actor, "grw_in_water") ~= nil then save_var(actor, "grw_in_water", nil) end
			if not in_water(actor) then return end
			local h = hit()
			h.impulse = 0
			h.direction = VEC_Z
			h.draftsman = actor
			h.type = hit.radiation
			h.power = delta * mod.get_damage_ms()
			actor:hit(h)
		end
	end)
	if ok then core.swap_callback("actor_on_update", old, mod.actor_on_update) end
	return true
end

local function wrap_widgets(groups, name)
	local group = groups[name]
	if type(group) ~= "table" or type(group._widgets) ~= "table" then return end
	for i, widget in ipairs(group._widgets) do
		if type(widget) == "function" and not widget_wrappers[widget] then
			core.wrap(group._widgets, i, "ImGui.Groups." .. name .. "[" .. i .. "]", function(orig)
				-- Capture the source BEFORE replacing it with this adapter's closure.
				local domain = api.route.of("imgui_on_render", orig)
				local wrapped = function(...)
					if core.active() and not api.route.runs(domain) then return end
					return orig(...)
				end
				widget_wrappers[wrapped] = true
				return wrapped
			end)
		end
	end
end

local function install_widgets()
	if not (api.route and api.route.of and api.route.runs) then return false end
	if not core.mod("_imgui_groups") then return false end
	local groups = ImGui and ImGui.Groups
	if type(groups) ~= "table" then return false end
	for name in pairs(groups) do wrap_widgets(groups, name) end
	local function registered(name, ...)
		wrap_widgets(groups, name)
		return ...
	end
	core.wrap(groups, "Widget", "ImGui.Groups.Widget", function(orig)
		return function(name, widget, ...)
			-- Register through the original, including its validation and any
			-- chained adapter. Its return values and the widgets' order survive.
			return registered(name, orig(name, widget, ...))
		end
	end)
	return true
end

local function on_load()
	if not core.active() then return end
	cleanup = {}
	clear_water()
end

local function start_step(name, f)
	if installed[name] then return end
	local ok, result = core.install("start_guard", name, f)
	if ok then installed[name] = result end
end

function on_game_start()
	if not api then return end
	start_step("cleanup", install_cleanup)
	start_step("water", install_water)
	start_step("widgets", install_widgets)
	start_step("load callback", function()
		RegisterScriptCallback("load_state", on_load)
		return true
	end)
end
