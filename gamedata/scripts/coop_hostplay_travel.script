-- Кооп (hostplay): the host's process leads the group between maps.

local function allow_trip()
	if not (coop_mode.group_travels() and coop_mode.is_player_mirror()) then return true end
	local core = coop_economy_core
	core.tip(coop_util.tr("st_coop_core_go_host_only", "Only the host can move the group."))
	return false
end

function on_game_start()
	if rawget(_G, "coop") then coop_economy_travel.set_cross_map_guard(allow_trip) end
end
