local function count_plain(s, needle)
	local n, at = 0, 1
	while true do
		local i = s:find(needle, at, true)
		if not i then return n end
		n = n + 1
		at = i + #needle
	end
end

local function replace_plain(s, from, to)
	local i = s:find(from, 1, true)
	return s:sub(1, i - 1) .. to .. s:sub(i + #from)
end

-- Pure part, testable: applies every pair once, in order; nil + reason if any `from` is not there exactly once. A pair
-- with all = true replaces every occurrence (at least one).
function rewrite_text(src, pairs_list)
	for i, pr in ipairs(pairs_list) do
		local n = count_plain(src, pr[1])
		if n ~= 1 and not (pr.all and n > 0) then return nil, string.format("pair %d found %d times", i, n) end
		for _ = 1, n do src = replace_plain(src, pr[1], pr[2]) end
	end
	return src
end

local function read_script(name)
	local fs = getFS and getFS()
	if not fs then return nil end
	local ok, path = pcall(fs.update_path, fs, "$game_scripts$", name .. ".script")
	if not (ok and type(path) == "string") then return nil end
	local fh = io.open(path, "rb")
	if not fh then return nil end
	local src = fh:read("*a")
	fh:close()
	return src, path
end

-- A rewrite runs the script a second time inside its own module. A script that wraps another module at load
-- (`TraderUpdate = trade_manager.update`, then `function trade_manager.update`) would capture its own wrapper the
-- second time, and that wrapper calls itself: stack overflow in TraderUpdate (live check 2026-10-23). The original
-- goes back before the second run.
local BEFORE_RERUN = {
	trader_autoinject = function(m)
		local tm = mod("trade_manager")
		local original = rawget(m, "TraderUpdate")
		if tm and type(original) == "function" then
			tm.update = original
		end
	end,
}

-- Runs rewritten source in the module's own environment, as the engine runs a script: the module table, `this`,
-- script_name(). Returns ok, error.
local function rerun(name, m, src, path)
	local header = "local this = ... local function script_name() return \"" .. name .. "\" end "
	local chunk, err = loadstring(header .. src, "@" .. path)
	if not chunk then
		return false, err
	end
	setfenv(chunk, m)
	if BEFORE_RERUN[name] then
		BEFORE_RERUN[name](m)
	end
	return pcall(chunk, m)
end

local function apply_rewrite(name, list)
	local m = mod(name)
	if not m then return end -- mod absent
	local src, path = read_script(name)
	if not src then
		log("rewrite %s skipped: not a loose file", name)
		return
	end
	local out, why = rewrite_text(src, list)
	if not out then
		log("rewrite %s skipped (another version of the script): %s", name, why)
		return
	end
	local ok, rerr = rerun(name, m, out, path)
	if not ok then
		report("rewrite " .. name, rerr)
		return
	end
	applied[#applied + 1] = "rewrite:" .. name
	log("rewrite %s applied (%d change(s))", name, #list)
end

function _rerun(name, m, src, path) return rerun(name, m, src, path) end
function _rewrites() return REWRITES end

-- A method rewrite: one function of a class module, compiled alone in the module's environment (at its own line numbers) and
-- put in the place of the original - on the class and in every wrapper that kept the original in an upvalue (Useful
-- Idiots keeps get_script_target as PATCH_get_script_target before any on_game_start). The whole module is not run again:
-- that would declare its luabind class anew and drop every other mod's patch of it. Like the rewrites above it applies
-- in and outside a session (on_game_start of a RayLink exe); outside one the fixed line answers what the author meant.
local METHOD_REWRITES = {
	-- G.A.M.M.A. sim_squad_scripted.script:139: the branch for a numeric target indexes the global `obj` (nil) instead of
	-- se_target. A numeric scripted_target (emission_guard_patch turns "123" into 123 at actor_on_first_update) ended
	-- the game: client reports RL-PMQ3-QJ23, RL-XK6N-8U4U, RL-M68Z-RV5K, RL-PVY5-ERKS (b40, split levels, l05_bar).
	{ module = "sim_squad_scripted", class = "sim_squad_scripted", method = "get_script_target",
		header = "function sim_squad_scripted:get_script_target()",
		{ "if se_target and (obj:clsid() == clsid.online_offline_group_s or obj:clsid() == clsid.smart_terrain) then",
		"if se_target and (se_target:clsid() == clsid.online_offline_group_s or se_target:clsid() == clsid.smart_terrain) then" },
	},
}

local function line_of(s, at)
	local n = 1
	for _ in s:sub(1, at - 1):gmatch("\n") do n = n + 1 end
	return n
end

-- Pure part, testable: the text of the function that starts with `header` (once in src) and ends at the first `end` at
-- the start of a line, and the line it starts at.
function method_text(src, header)
	if count_plain(src, header) ~= 1 then return nil, "header found " .. count_plain(src, header) .. " times" end
	local from = src:find(header, 1, true)
	local _, to = src:find("\nend[ \t]*\r?\n", from)
	if not to then _, to = src:find("\nend[ \t]*$", from) end
	if not to then return nil, "no end of the function" end
	return src:sub(from, to), line_of(src, from)
end

-- `file` is the script's file name: the engine's chunk name is its path (slashes of either kind), compared by the name.
local function is_original(f, file, line)
	if type(f) ~= "function" then return false end
	local info = debug.getinfo(f, "S")
	if not (info and info.linedefined == line and type(info.source) == "string") then return false end
	local s = info.source:lower():gsub("/", "\\")
	file = file:lower()
	return s == "@" .. file or s:sub(-(#file + 1)) == "\\" .. file
end

-- Every reference to the original reachable from `f` through upvalues (a wrapper of a wrapper ...) gets `fixed`.
local function swap_upvalues(f, file, line, fixed, seen, depth)
	if seen[f] or depth > 4 then return 0 end
	seen[f] = true
	local n, i = 0, 1
	while true do
		local name, v = debug.getupvalue(f, i)
		if not name then break end
		if is_original(v, file, line) then
			debug.setupvalue(f, i, fixed)
			n = n + 1
		elseif type(v) == "function" then
			n = n + swap_upvalues(v, file, line, fixed, seen, depth + 1)
		end
		i = i + 1
	end
	return n
end

local function apply_method_rewrite(r)
	local tag = r.module .. "." .. r.method
	local m = mod(r.module)
	local cls = m and m[r.class]
	if not cls then return end -- mod absent
	local src, path = read_script(r.module)
	if not src then
		log("rewrite %s skipped: not a loose file", tag)
		return
	end
	local text, line = method_text(src, r.header)
	local out, why = text and rewrite_text(text, r)
	if not out then
		log("rewrite %s skipped (another version of the script): %s", tag, why or line)
		return
	end
	local current = cls[r.method]
	local chunk, err = loadstring(string.rep("\n", line - 1) .. "local " .. r.class .. " = {} " .. out ..
		" return " .. r.class .. "." .. r.method, "@" .. path)
	if not chunk then
		report("rewrite " .. tag, err)
		return
	end
	setfenv(chunk, m)
	local ok, fixed = pcall(chunk)
	if not (ok and type(fixed) == "function") then
		report("rewrite " .. tag, fixed)
		return
	end
	-- the original must have no upvalues: compiled alone, its free names are the module's globals as in the file
	local up = debug.getinfo(fixed, "u")
	if up and up.nups ~= 0 then
		log("rewrite %s skipped: the method keeps %d upvalue(s)", tag, up.nups)
		return
	end
	local file, swapped = r.module .. ".script", 0
	if is_original(current, file, line) then
		cls[r.method] = fixed
		swapped = 1
	elseif type(current) == "function" then
		swapped = swap_upvalues(current, file, line, fixed, {}, 0)
	end
	if swapped == 0 then
		log("rewrite %s skipped: the original method is not reachable from the class", tag)
		return
	end
	applied[#applied + 1] = "rewrite:" .. tag
	log("rewrite %s applied (%d change(s), %d place(s))", tag, #r, swapped)
end

function _method_rewrites() return METHOD_REWRITES end

-------------------------------------------------------------------------------
-- Wrappers
-------------------------------------------------------------------------------
local function wrap_ai_rework()
	local m = mod("schemes_ai_gamma")
	if not m then return end
	for _, name in ipairs({ "scheme_camper", "scheme_cover" }) do
		local f = m[name]
		-- A zero-argument stub (another mod disabled it) answers a constant: nothing to do.
		local nparams = type(f) == "function" and debug.getinfo(f, "u").nparams -- nil on LuaJIT 2.0
		if type(f) == "function" and (nparams == nil or nparams > 0) and not orig[name] then
			orig[name] = f
			m[name] = function(enemy, npc, actor, ...)
				if not (host_on and enemy and P.is_proxy(enemy)) then return f(enemy, npc, actor, ...) end
				local ok, r = pcall(P.with_identity, enemy, f, enemy, npc, actor, ...)
				if not ok then
					report(name, r)
					return false
				end
				return r
			end
			applied[#applied + 1] = "ai_rework." .. name
		end
	end
end

local NIGHT_RADIUS = 75 -- night_mutants: safe_radius

local function wrap_night_mutants()
	local m = mod("night_mutants")
	local f = m and m.se_obj_outside_spawn_radius
	if type(f) ~= "function" or orig.night then return end
	orig.night = f
	m.se_obj_outside_spawn_radius = function(se_obj, ...)
		if not f(se_obj, ...) then return false end -- too close to the host's player
		if not (host_on and se_obj) then return true end
		for _, p in ipairs(P.others()) do
			local ok, outside = pcall(P.with_identity, p, f, se_obj, ...)
			if not ok then
				report("night_mutants radius", outside)
			elseif not outside then
				return false
			end
		end
		-- a player on another level has his record: the spawn is the world server's, on every level
		local qc = coop_quests_core
		local who, _, d = qc.nearest_body(se_obj, true)
		if who and who.far and d <= NIGHT_RADIUS * NIGHT_RADIUS then return false end
		return true
	end
	applied[#applied + 1] = "night_mutants"
end

-- Audit B5 (2026-10-24): NPCs do not loot a corpse or pick up an item within the loot distance of the HOST's actor
-- (xr_corpse_detection / xr_gather_items near_actor), so they looted a client's kills right in front of him. Any player
-- within that distance counts. The module calls near_actor through its own table: the wrapper is seen at once.
local function wrap_loot()
	for _, name in ipairs({ "xr_corpse_detection", "xr_gather_items" }) do
		local m = mod(name)
		local f = m and m.near_actor
		if type(f) == "function" and not orig["loot_" .. name] then
			orig["loot_" .. name] = f
			m.near_actor = function(obj)
				local r = f(obj)
				if r or not (host_on and obj) then return r end -- single player: the stock answer as it is
				local dist = tonumber(ui_options.get("gameplay/general/npc_loot_distance"))
				return dist ~= nil and dist > 0 and coop_npc_any_player_within(obj, dist) == true
			end
			applied[#applied + 1] = "loot:" .. name
		end
	end
end

-- Audit B3 (2026-10-24): a squad may not come online within excl_dist (75 m) of the player - the HOST's player, so
-- squads popped into view next to a far client. The stock rule runs again as each other player (with_identity); any
-- "no" stands. On a map server db.actor is its ghost, nobody: the players of its level are all that counts.
local function wrap_squads()
	local m = mod("sim_squad_scripted")
	local cls = m and m.sim_squad_scripted
	local f = cls and cls.check_online_status
	if type(f) ~= "function" or orig.squad_online then return end
	orig.squad_online = f
	cls.check_online_status = function(self, ...)
		local first = host_on and P.is_map_server() and P.others()[1] or nil
		if first then
			P.with_identity(first, f, self, ...)
		else
			f(self, ...)
		end
		if self.forced_online_status ~= nil or self.online or not host_on then return end
		for _, p in ipairs(P.others()) do
			local ok, err = pcall(P.with_identity, p, f, self, ...)
			if not ok then
				report("squad online exclusion", err)
			elseif self.forced_online_status == false then
				return
			end
		end
	end
	applied[#applied + 1] = "squad_exclusion"
	-- A squad sent at "the actor" (a bounty, a task) goes to id 0: on a map server that is its ghost. It goes to a player of the level.
	local actor = mod("se_actor")
	local ca = actor and actor.se_actor
	local function player_here()
		return host_on and P.is_map_server() and P.others()[1] or nil
	end
	local where, task = ca and ca.get_location, ca and ca.get_alife_task
	if type(where) == "function" then
		ca.get_location = function(self, ...)
			local p = player_here()
			if p then return p:position(), p:level_vertex_id(), p:game_vertex_id() end
			return where(self, ...)
		end
	end
	if type(task) == "function" then
		ca.get_alife_task = function(self, ...)
			local p = player_here()
			if p then return CALifeSmartTerrainTask(p:game_vertex_id(), p:level_vertex_id()) end
			return task(self, ...)
		end
	end
end

-- Audit B4: a smart terrain does not respawn within its respawn_radius of the HOST's player only; any player counts. The world
-- server alone respawns (a map server's try_respawn returns, coop_main): for a player on a map server's level it has no object, only
-- the record of his body, and "the actor is on this level" holds for him too (respawn_only_level).
local function player_near_record(self, r)
	local gg = game_graph()
	local lid = gg:vertex(self.m_game_vertex_id):level_id()
	local on_level = false
	for _, p in ipairs(P.players()) do
		local se = not p.is_self and type(p.avatar_id) == "number" and alife_object(p.avatar_id) or nil
		if se and gg:vertex(se.m_game_vertex_id):level_id() == lid then
			on_level = true
			if se.position:distance_to_sqr(self.position) <= r * r then return true, true end
		end
	end
	return false, on_level
end

local function wrap_smart_respawn()
	local m = mod("smart_terrain")
	local cls = m and m.se_smart_terrain
	local f = cls and cls.try_respawn
	if type(f) ~= "function" or orig.smart_respawn then return end
	orig.smart_respawn = f
	cls.try_respawn = function(self, ...)
		if not (host_on and self.position) then return f(self, ...) end
		local r = tonumber(self.respawn_radius) or 150
		if P.any_within(self.position, r) then return end -- a player is near: nothing spawns in his view
		local near_one, on_level = player_near_record(self, r)
		if near_one then return end
		if self.is_on_actor_level or not on_level then return f(self, ...) end
		self.is_on_actor_level = true
		local ok, err = pcall(f, self, ...)
		self.is_on_actor_level = nil
		if not ok then error(err, 0) end
	end
	applied[#applied + 1] = "smart_respawn"
end

-- Audit B7 (2026-10-24): helicopters (heli_combat / heli_fire, stock scripts in the archives: class methods are wrapped)
-- know the HOST's actor as "the actor" and every other player's character as an ordinary NPC, so a heli set on the
-- player (actor_always_enemy, combat_enemy = actor, heli_fire enemy = actor) never turned on a client. A player's
-- character counts as the actor: the actor's enemy rule (his own heli flag - set on his character when he shot the
-- heli - or actor_always_enemy), and "the actor" as a target is the nearest player.
-- Live 2026-10-31: heli_fire with enemy = actor picks once and keeps it, and a player who is down is alive for the engine: a
-- mission's heli fired at the host alone, even dead. It now works through the players it sees, on their feet, in turns.
-- Skyfall sets its heli on db.actor at every status check, past all of this (tasks_skyfall set_player_enemy ->
-- heli_combat:set_enemy): that one call goes through the same turns; a heli that sees nobody looks for the players it knows of.
local HELI_TURN_MS = 10000 -- how long one player has its attention
local HELI_LOOK_MS = 1000 -- how often it looks while it has nobody

local function heli_next_player(self, heli, anywhere)
	local seen = {}
	for _, o in ipairs(P.everyone()) do
		if P.standing(o) and (anywhere or heli:isVisible(o)) then seen[#seen + 1] = o end
	end
	if #seen == 0 then return nil end
	table.sort(seen, function(a, b) return a:id() < b:id() end)
	self.coop_turn = (self.coop_turn or 0) % #seen + 1
	return seen[self.coop_turn]
end

local function wrap_helis()
	local hc = mod("heli_combat")
	local cls = hc and hc.heli_combat
	local is_enemy = cls and cls.is_enemy
	if type(is_enemy) == "function" and not orig.heli_is_enemy then
		orig.heli_is_enemy = is_enemy
		cls.is_enemy = function(self, obj)
			if host_on and obj and P.is_player_id(obj:id()) and not P.standing(obj) then return false end
			if not (host_on and obj and P.is_proxy(obj)) then return is_enemy(self, obj) end
			-- the stock's checks for anybody, then its rule for the actor (heli_combat.script is_enemy)
			if not obj:alive() or IsWounded(obj) then return false end
			if xr_combat_ignore.ignore_enemy_by_overrides(self.object, obj) then return false end
			local se_obj = alife_object(self.object:id())
			if not (se_obj and se_obj.community) then return false end
			if string.find(character_community(obj), se_obj.community, 1, true) then return false end
			local st = db.storage[obj:id()]
			if st and st.heli_enemy_flag == true then return true end
			return self.actor_always_enemy or false
		end
		applied[#applied + 1] = "heli:enemy"
	end
	local from_data = cls and cls.set_enemy_from_custom_data
	if type(from_data) == "function" and not orig.heli_from_data then
		orig.heli_from_data = from_data
		cls.set_enemy_from_custom_data = function(self, combat_enemy, ...)
			local r = from_data(self, combat_enemy, ...)
			if host_on and combat_enemy == "actor" and self.st and self.st.enemy_id == AC_ID and self.object then
				local near = P.nearest(self.object:position())
				if near and P.is_proxy(near) then self.st.enemy_id = near:id() end
			end
			return r
		end
		applied[#applied + 1] = "heli:combat_enemy"
	end
	local hf = mod("heli_fire")
	local fcls = hf and hf.heli_fire
	local set_enemy = fcls and fcls.set_enemy
	if type(set_enemy) == "function" and not orig.heli_fire then
		orig.heli_fire = set_enemy
		fcls.set_enemy = function(self, ...)
			if not (host_on and self.enemy_ == "actor" and self.obj) then return set_enemy(self, ...) end
			local ok, heli = pcall(self.obj.get_helicopter, self.obj)
			if not (ok and heli) then return set_enemy(self, ...) end
			local now = time_global()
			local st = self.enemy_id and db.storage[self.enemy_id]
			local lost = self.enemy_id ~= nil and not (st and st.object and P.standing(st.object))
			local wait = (self.enemy_id and not self.flag_by_enemy) and HELI_TURN_MS or HELI_LOOK_MS
			if lost or now - (self.coop_picked or -wait) >= wait then
				self.coop_picked = now
				local target = heli_next_player(self, heli)
				self.enemy_id = target and target:id() or nil
				self.flag_by_enemy = target ~= nil
				if not target then heli:ClearEnemy() end
			end
			-- the stock would take the host's actor for an empty target
			if self.enemy_id == nil then return end
			return set_enemy(self, ...)
		end
		applied[#applied + 1] = "heli:fire"
	end
	local sky = mod("tasks_skyfall")
	local aim = sky and sky.set_player_enemy
	if type(aim) == "function" and not orig.heli_skyfall then
		orig.heli_skyfall = aim
		sky.set_player_enemy = function(...)
			if not P.is_host() then return aim(...) end
			local go = sky.get_dynamic_heli()
			local bound = go and go:binded_object()
			local combat = bound and bound.st and bound.st.combat
			if not combat then return end
			local now = time_global()
			local cur = combat.st.enemy_id
			if cur and P.is_player_id(cur) and P.standing(cur) and now < (combat.coop_until or 0) then return end
			local heli = go:get_helicopter()
			local target = heli_next_player(combat, heli) or heli_next_player(combat, heli, true)
			if target then
				combat.coop_until = now + HELI_TURN_MS
				combat:set_enemy(target)
			elseif cur then
				combat:forget_enemy()
			end
		end
		applied[#applied + 1] = "heli:skyfall"
	end
end

-- Audit B6 (2026-10-24): an old corpse is released when there are more than five and it lies 75 m from the HOST's
-- actor (release_body_manager Crelease_body:clear), so a body next to a client went while he came to loot it. A body
-- within that distance of any other player stays in the queue but is not offered to the stock pass this time. The stock's
-- clear(all) at a level change would take every body of a level the others stay on: with a player here it does nothing.
local RELEASE_DIST_SQR = 5625 -- release_body_manager MIN_RELEASE_DISTANCE (75 m, squared)
local function release_dist_sqr(dist)
	if tonumber(dist) then return tonumber(dist) end
	local o = mod("ui_options")
	local ok, v = pcall(function() return o and o.get("gameplay/general/corpse_min_dist") end)
	v = ok and tonumber(v)
	return v and v * v or RELEASE_DIST_SQR -- the stock keeps the option in a local of its own
end

local function wrap_body_release()
	local m = mod("release_body_manager")
	local cls = m and m.Crelease_body
	local f = cls and cls.clear
	if type(f) ~= "function" or orig.body_release then return end
	orig.body_release = f
	cls.clear = function(self, all, dist, ...)
		local queue = self and self.release_objects_table
		if not host_on or type(queue) ~= "table" then return f(self, all, dist, ...) end
		if all then
			local coop_api = mod("coop")
			local lv = coop_api and coop_api.levels
			if lv and lv.split and lv.split() == true and P.others()[1] then return end
			return f(self, all, dist, ...) -- without split levels everybody leaves together
		end
		local sim = alife()
		local near = release_dist_sqr(dist)
		local kept = {}
		for id, v in pairs(queue) do
			local se = sim and sim:object(id)
			if se and se.position then
				for _, p in ipairs(P.others()) do
					if p:position():distance_to_sqr(se.position) < near then
						kept[id] = v
						break
					end
				end
			end
		end
		if next(kept) == nil then return f(self, all, dist, ...) end
		for id in pairs(kept) do queue[id] = nil end
		local ok, err = pcall(f, self, all, dist, ...)
		for id, v in pairs(kept) do queue[id] = v end
		if not ok then report("body release", err) end
	end
	applied[#applied + 1] = "body_release"
end

-- Enemy audit F8 (2026-10-31): a mounted gun (ph_minigun) aims at a target's feet + 0.1 m; only the host's actor gets the chest
-- point (+1 m, the stock "FAKE" aim), so a client, a proxy on the host, was shot at the ground. rot_to_firepoint receives the
-- point the aim has just computed: for a player's proxy, when the point is on his spot (xz), it moves to his chest.
local CHEST_HEIGHT = 1 -- the stock chest aim of the actor
local AIM_XZ_SQR = 0.0025 -- 5 cm: the stock jitter is 1 cm

local function wrap_mounted_guns()
	local m = mod("ph_minigun")
	local cls = m and m.action_mgun
	local f = cls and cls.rot_to_firepoint
	if type(f) ~= "function" or orig.mgun_aim then return end
	orig.mgun_aim = f
	cls.rot_to_firepoint = function(self, pt, ...)
		local tid = host_on and pt and self.st and self.st.target_id
		if tid and P.is_proxy(tid) then
			local st = db.storage[tid]
			local target = st and st.object
			local ok, tp = pcall(function() return target:position() end)
			if ok and tp then
				local dx, dz = pt.x - tp.x, pt.z - tp.z
				if dx * dx + dz * dz <= AIM_XZ_SQR then pt.y = tp.y + CHEST_HEIGHT + (math.random(-1, 1) / 100) end
			end
		end
		return f(self, pt, ...)
	end
	applied[#applied + 1] = "mounted_guns"
end

-- Rostok peace zone: crimes per player.
local crime = {} -- proxy id -> true

local function wrap_peace_zone()
	local m = mod("gameplay_peace_zone")
	if not (m and type(m.npcs_friendly_to_community) == "function" and type(m.level_is_bar) == "function") then return end
	if orig.peace then return end
	local friendly = m.npcs_friendly_to_community
	orig.peace = friendly
	-- Both call sites pass the player second: false for a proxy keeps the mod's single crime bit off it.
	m.npcs_friendly_to_community = function(a, b, com, ...)
		if host_on and b and P.is_proxy(b) then return false end
		return friendly(a, b, com, ...)
	end
	local function pair(npc, who)
		if character_community(npc) == "arena_enemy" then return false end
		return friendly(npc, who, "dolg") and true or false
	end
	RegisterScriptCallback("npc_on_before_hit", function(npc, s_hit)
		local who = s_hit and s_hit.draftsman
		if not (host_on and who and P.is_proxy(who)) then return end
		if m.level_is_bar() and pair(npc, who) then crime[who:id()] = true end
	end)
	RegisterScriptCallback("on_enemy_eval", function(npc, ene, flags)
		if not (host_on and ene and P.is_proxy(ene)) or crime[ene:id()] then return end
		if m.level_is_bar() and IsStalker(npc) and pair(npc, ene) then
			flags.override = true
			flags.result = false
		end
	end)
	RegisterScriptCallback("save_state", function(m_data) m_data.coop_npc_peace_crime = crime end)
	RegisterScriptCallback("load_state", function(m_data)
		crime = type(m_data.coop_npc_peace_crime) == "table" and m_data.coop_npc_peace_crime or {}
	end)
	RegisterScriptCallback("on_level_changing", function() crime = {} end)
	applied[#applied + 1] = "peace_zone"
end

-- Called by coop_npc_world after a client's silent kill.
function credit_silent_kill(proxy)
	if not mod("stealth_kill_detection") then return end
	local peer = P.peer_of(proxy)
	if peer then P.send(EV_STAT, { k = "silent_kills" }, peer) end
end

local function client_on_stat(t)
	if t.k ~= "silent_kills" or not game_statistics then return end
	local s = game_statistics.actor_statistics
	if type(s) == "table" and s.silent_kills == nil then s.silent_kills = { count = 0, rank = 5, rept = 0 } end
	pcall(game_statistics.increment_statistic, "silent_kills")
end

-------------------------------------------------------------------------------
-- Install
-------------------------------------------------------------------------------
local next_tick = 0

local function actor_on_update()
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + 250
	host_on = installed and P.host_with_clients()
end

function print_status()
	log("installed %s | active: %s | errors %d", tostring(installed),
		#applied > 0 and table.concat(applied, ", ") or "nothing (no supported mod found)", P.error_count(TAG))
end

function on_game_start()
	P = coop_npc_players
	if not rawget(_G, "coop") then return end
	if not installed then
		installed = true
		-- for rewritten mod code: this machine is a client (its monster puppets have no AI, so no enemy)
		_G.coop_npc_on_client = function() return P.client_live() end
		local _ = coop_quests_core -- the far view is in place before a rewrite loads a task script (tasks_chimera_scan keeps it in a local)
		for name, list in pairs(REWRITES) do
			local ok, err = pcall(apply_rewrite, name, list)
			if not ok then report("rewrite " .. name, err) end
		end
		for _, r in ipairs(METHOD_REWRITES) do
			local ok, err = pcall(apply_method_rewrite, r)
			if not ok then report("rewrite " .. r.module .. "." .. r.method, err) end
		end
		local adapters = mod("coop_npc_adapters")
		if adapters then adapters.install(P, function() return host_on and P.host_with_clients() end, applied) end
		local phantoms = mod("coop_npc_phantoms") -- enemy audit F10
		if phantoms then phantoms.install(P, function() return host_on and P.host_with_clients() end, applied) end
		for _, s in ipairs({ { "ai_rework", wrap_ai_rework }, { "night_mutants", wrap_night_mutants },
			{ "peace_zone", wrap_peace_zone }, { "loot", wrap_loot },
			{ "squads", wrap_squads }, { "smart_respawn", wrap_smart_respawn }, { "helis", wrap_helis },
			{ "body_release", wrap_body_release }, { "mounted_guns", wrap_mounted_guns } }) do
			local ok, err = pcall(s[2])
			if not ok then report("install " .. s[1], err) end
		end
	end
	P.on(EV_STAT, client_on_stat, "client", TAG)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end

function _set_host_on(v) host_on = v end
function _applied() return applied end
