local function count_plain(s, needle)
	local n, at = 0, 1
	while true do
		local i = s:find(needle, at, true)
		if not i then return n end
		n = n + 1
		at = i + #needle
	end
end

local function replace_plain(s, from, to)
	local i = s:find(from, 1, true)
	return s:sub(1, i - 1) .. to .. s:sub(i + #from)
end

-- Pure part, testable: applies every pair once, in order; nil + reason if any `from` is not there exactly once. A pair
-- with all = true replaces every occurrence (at least one).
function rewrite_text(src, pairs_list)
	local newline = src:find("\r\n", 1, true) and "\r\n" or "\n"
	for i, pr in ipairs(pairs_list) do
		local from, to = pr[1]:gsub("\r?\n", newline), pr[2]:gsub("\r?\n", newline)
		local n = count_plain(src, from)
		if n ~= 1 and not (pr.all and n > 0) then return nil, string.format("pair %d found %d times", i, n) end
		for _ = 1, n do src = replace_plain(src, from, to) end
	end
	return src
end

local function read_script(name, archive)
	local fs = getFS and getFS()
	if not fs then return nil end
	local ok, path = pcall(fs.update_path, fs, "$game_scripts$", name .. ".script")
	if not (ok and type(path) == "string") then return nil end
	local fh = io.open(path, "rb")
	if not fh then
		-- The stock crow script lives in .db archives on the stand. This
		-- existing engine reader uses VFS (including overrides); opt in per patch,
		-- leaving the historical loose-only rewrites' installation unchanged.
		if archive and type(r_file_as_string) == "function" then
			local read_ok, src = pcall(r_file_as_string, path)
			if read_ok and type(src) == "string" then return src, path end
		end
		return nil
	end
	local src = fh:read("*a")
	fh:close()
	return src, path
end

-- A rewrite runs the script a second time inside its own module. A script that wraps another module at load
-- (`TraderUpdate = trade_manager.update`, then `function trade_manager.update`) would capture its own wrapper the
-- second time, and that wrapper calls itself: stack overflow in TraderUpdate. The original
-- goes back before the second run.
local BEFORE_RERUN = {
	trader_autoinject = function(m)
		local tm = coop_util.module("trade_manager")
		local original = rawget(m, "TraderUpdate")
		if tm and type(original) == "function" then
			tm.update = original
		end
	end,
}

-- Runs rewritten source in the module's own environment, as the engine runs a script: the module table, `this`,
-- script_name(). Returns ok, error.
local function rerun(name, m, src, path)
	local header = "local this = ... local function script_name() return \"" .. name .. "\" end "
	local chunk, err = loadstring(header .. src, "@" .. path)
	if not chunk then
		return false, err
	end
	setfenv(chunk, m)
	if BEFORE_RERUN[name] then
		BEFORE_RERUN[name](m)
	end
	return pcall(chunk, m)
end

-- The squad death is a world callback. A reported death already carries the killer's ALife record.
function civil_war_killer(killer)
	if not coop_mode.decides_world() then return end
	local character = coop_credit.who(killer)
	if character == nil then return end
	local body = character == 0 and P.own_actor() or level.object_by_id(character)
	if body then return character, body:character_community() end
	if type(killer.community) == "function" then return character, killer:community() end
end

local function apply_civil_war_reward(actor, _, params)
	local delta = params and tonumber(params[1])
	if actor and (delta == 75 or delta == 100) then actor:change_character_reputation(delta) end
end

function credit_civil_war(victim, character, delta)
	if not coop_credit.once(victim, CIVIL_WAR_REWARD) then return end
	if character == 0 then
		local actor = P.own_actor()
		if actor then actor:change_character_reputation(delta) end
	else
		-- ZCP uses the direct reputation delta. The stock statistic helper also applies an arena veto and a cap.
		coop_tasks.with_character(character, coop_tasks_rewards.send_personal,
			{ k = "fx", f = CIVIL_WAR_REWARD, p1 = tostring(delta) })
	end
end

local function apply_rewrite(name, list)
	local m = coop_util.module(name)
	if not m then return end -- mod absent
	local src, path = read_script(name)
	if not src then
		log("rewrite %s skipped: not a loose file", name)
		return
	end
	local out, why = rewrite_text(src, list)
	if not out then
		log("rewrite %s skipped (another version of the script): %s", name, why)
		return
	end
	local ok, rerr = rerun(name, m, out, path)
	if not ok then
		report("rewrite " .. name, rerr)
		return
	end
	if name == "smr_civil_war" then
		xr_effects[CIVIL_WAR_REWARD] = apply_civil_war_reward
		coop_tasks_rewards.forward_allow(CIVIL_WAR_REWARD)
	end
	applied[#applied + 1] = "rewrite:" .. name
	log("rewrite %s applied (%d change(s))", name, #list)
end

function _rerun(name, m, src, path) return rerun(name, m, src, path) end
function _rewrites() return REWRITES end

-- A method rewrite: one function of a class module, compiled alone in the module's environment (at its own line numbers) and
-- put in the place of the original - on the class and in every wrapper that kept the original in an upvalue (Useful
-- Idiots keeps get_script_target as PATCH_get_script_target before any on_game_start). The whole module is not run again:
-- that would declare its luabind class anew and drop every other mod's patch of it. Like the rewrites above it applies
-- in and outside a session (on_game_start of a RayLink exe); outside one the fixed line answers what the author meant.
local METHOD_REWRITES = {
	-- An interrupted scene enters idle through the same transition as a completed scene.
	{ module = "sr_camp", class = "CCampManager", method = "unregister_npc", archive = true,
		header = "function CCampManager:unregister_npc(npc_id)",
		{ '\t\tself.active_state_time = 0\n\t\tself.director = nil\n\t\t\n\t\tself.active_state = "idle"',
[[		self.director = nil
		if coop_npc_players.active() then
			self:set_next_state("idle")
		else
			self.active_state_time = 0
			self.active_state = "idle"
		end]] },
	},
	-- G8-3 s39:7: keep the chosen path, random draw and successful-point cooldown.
	{ module = "sr_crow_spawner", class = "crowkiller", method = "check_for_spawn_new_crow", archive = true,
		header = "function crowkiller:check_for_spawn_new_crow()",
		{ "ptr:point(0):distance_to_sqr(db.actor:position())>10000",
		"coop_npc_compat.crow_spawn_clear(ptr:point(0))" },
	},
	-- G.A.M.M.A. sim_squad_scripted.script:139: the branch for a numeric target indexes the global `obj` (nil) instead of
	-- se_target. A numeric scripted_target (emission_guard_patch turns "123" into 123 at actor_on_first_update) ended
	-- the game: client reports RL-PMQ3-QJ23, RL-XK6N-8U4U, RL-M68Z-RV5K, RL-PVY5-ERKS (b40, split levels, l05_bar).
	{ module = "sim_squad_scripted", class = "sim_squad_scripted", method = "get_script_target",
		header = "function sim_squad_scripted:get_script_target()",
		{ "if se_target and (obj:clsid() == clsid.online_offline_group_s or obj:clsid() == clsid.smart_terrain) then",
		"if se_target and (se_target:clsid() == clsid.online_offline_group_s or se_target:clsid() == clsid.smart_terrain) then" },
	},
}

local function line_of(s, at)
	local n = 1
	for _ in s:sub(1, at - 1):gmatch("\n") do n = n + 1 end
	return n
end

-- Pure part, testable: the text of the function that starts with `header` (once in src) and ends at the first `end` at
-- the start of a line, and the line it starts at.
function method_text(src, header)
	if count_plain(src, header) ~= 1 then return nil, "header found " .. count_plain(src, header) .. " times" end
	local from = src:find(header, 1, true)
	local _, to = src:find("\nend[ \t]*\r?\n", from)
	if not to then _, to = src:find("\nend[ \t]*$", from) end
	if not to then return nil, "no end of the function" end
	return src:sub(from, to), line_of(src, from)
end

-- `file` is the script's file name: the engine's chunk name is its path (slashes of either kind), compared by the name.
local function is_original(f, file, line)
	if type(f) ~= "function" then return false end
	local info = debug.getinfo(f, "S")
	if not (info and info.linedefined == line and type(info.source) == "string") then return false end
	local s = info.source:lower():gsub("/", "\\")
	file = file:lower()
	return s == "@" .. file or s:sub(-(#file + 1)) == "\\" .. file
end

-- Every reference to the original reachable from `f` through upvalues (a wrapper of a wrapper ...) gets `fixed`.
local function swap_upvalues(f, file, line, fixed, seen, depth)
	if seen[f] or depth > 4 then return 0 end
	seen[f] = true
	local n, i = 0, 1
	while true do
		local name, v = debug.getupvalue(f, i)
		if not name then break end
		if is_original(v, file, line) then
			debug.setupvalue(f, i, fixed)
			n = n + 1
		elseif type(v) == "function" then
			n = n + swap_upvalues(v, file, line, fixed, seen, depth + 1)
		end
		i = i + 1
	end
	return n
end

local function apply_method_rewrite(r)
	local tag = r.module .. "." .. r.method
	local m = coop_util.module(r.module)
	local cls = m and m[r.class]
	if not cls then return end -- mod absent
	local src, path = read_script(r.module, r.archive)
	if not src then
		log("rewrite %s skipped: not a loose file", tag)
		return
	end
	local text, line = method_text(src, r.header)
	local out, why = text and rewrite_text(text, r)
	if not out then
		log("rewrite %s skipped (another version of the script): %s", tag, why or line)
		return
	end
	local current = cls[r.method]
	local chunk, err = loadstring(string.rep("\n", line - 1) .. "local " .. r.class .. " = {} " .. out ..
		" return " .. r.class .. "." .. r.method, "@" .. path)
	if not chunk then
		report("rewrite " .. tag, err)
		return
	end
	setfenv(chunk, m)
	local ok, fixed = pcall(chunk)
	if not (ok and type(fixed) == "function") then
		report("rewrite " .. tag, fixed)
		return
	end
	-- the original must have no upvalues: compiled alone, its free names are the module's globals as in the file
	local up = debug.getinfo(fixed, "u")
	if up and up.nups ~= 0 then
		log("rewrite %s skipped: the method keeps %d upvalue(s)", tag, up.nups)
		return
	end
	local file, swapped = r.module .. ".script", 0
	if is_original(current, file, line) then
		cls[r.method] = fixed
		swapped = 1
	elseif type(current) == "function" then
		swapped = swap_upvalues(current, file, line, fixed, {}, 0)
	end
	if swapped == 0 then
		log("rewrite %s skipped: the original method is not reachable from the class", tag)
		return
	end
	applied[#applied + 1] = "rewrite:" .. tag
	log("rewrite %s applied (%d change(s), %d place(s))", tag, #r, swapped)
end

function _method_rewrites() return METHOD_REWRITES end

-- A function rewrite: one module-level function of a script whose load-time state belongs to other mods too, so the script must
-- not run again (G.A.M.M.A.: momo_multihit_fix wraps grok_bo's handlers at load and keeps the originals in upvalues,
-- z_nta_compatibility adds Prometheus to grok_bo.invincible_npcs_sections at load). The function is compiled alone at its own
-- line numbers with the original's upvalues (the file's locals: tables, never reassigned) and put in the original's place: in the
-- module, or in every wrapper that kept it. Like the rewrites above it applies in and outside a session; outside one the
-- rewritten line answers exactly what the original did.
--
-- G.A.M.M.A.'s ballistics (grok_bo) computes a hit of db.actor itself (ammo, bone armour, distance, barrel), writes the health
-- directly (past the engine's invulnerable) and leaves the engine a power of 0.0001; any other hit returns at its first line. By
-- the route rules (checked with the pack's own route files) that chain runs on the host only, never on a client's machine. On
-- the host a client's hit comes from his proxy, not from db.actor: grok would return at once, the hit would go the engine's
-- stock way and an NPC whose job logic says invulnerable (traders, base commanders, guards) would take nothing.
-- The machine that applies hits (the host or a map server) counts every player's hit as it counts its own actor's.
-- The multihit fix uses this machine's last bullet. A client's bullets do not fly on the host, so that wrapper could
-- cancel the client's next shot at the same target as a duplicate. Remote hits skip the wrapper and use the bullet
-- number in the hit (bullet_again). The host's own on-hit artefact perks are for the
-- host's hits (its before-hit and death perks are skipped by coop_mods_perks).
local FUNCTION_REWRITES = {
	-- Both camera filters count living players here; the independent
	-- mutant/anomaly radius and the mod's registry/invalidation cadence stay intact.
	{ module = "aaaa_script_fixes_mp", name = "anomaly_restrictor_update", header = "function anomaly_restrictor_update()",
		{ "if dist_to_cam_sqr < (max_dist_limit * max_dist_limit) then",
		"if coop_npc_compat.camera_player_near(new_pos, max_dist_limit * max_dist_limit, dist_to_cam_sqr) then" },
		{ "if pos:distance_to_sqr(cache_cam_pos) < cache_cam_limit_sqr then",
		"if coop_npc_compat.camera_player_near(pos, cache_cam_limit_sqr, pos:distance_to_sqr(cache_cam_pos)) then" },
	},
	{ module = "grok_bo", name = "npc_on_before_hit", header = "function npc_on_before_hit(npc,shit,bone_id)", past = "momo_multihit_fix",
		{ "if shit.draftsman:id() ~= db.actor:id() then",
		"if not (coop_npc_applies_hits() and coop_npc_is_player_id(shit.draftsman:id())) then" },
		-- a hit without a weapon: the host names the proxy as its weapon (coop_requests.cpp host_hit)
		{ "if wpn == nil then", "if wpn == nil or wpn:id() == shit.draftsman:id() then" },
		{ "\tPBA_ohc(npc, shit.power, shit.direction, shit.draftsman, bone_id)",
		"\tif shit.draftsman:id() == db.actor:id() then PBA_ohc(npc, shit.power, shit.direction, shit.draftsman, bone_id) end" },
	},
	{ module = "grok_bo", name = "monster_on_before_hit", header = "function monster_on_before_hit(monster,shit,bone_id)",
		past = "momo_multihit_fix",
		{ "if shit.draftsman:id() ~= db.actor:id() then",
		"if not (coop_npc_applies_hits() and coop_npc_is_player_id(shit.draftsman:id())) then" },
		{ "if wpn == nil then", "if wpn == nil or wpn:id() == shit.draftsman:id() then" },
	},
}

-- The original reachable from f: f itself or a function f keeps in an upvalue (a wrapper of a wrapper ...).
local function find_original(f, file, line, seen, depth)
	if type(f) ~= "function" or seen[f] or depth > 4 then return nil end
	seen[f] = true
	if is_original(f, file, line) then return f end
	for i = 1, 255 do
		local name, v = debug.getupvalue(f, i)
		if not name then break end
		local found = find_original(v, file, line, seen, depth + 1)
		if found then return found end
	end
	return nil
end

local function defined_in(f, file)
	local info = type(f) == "function" and debug.getinfo(f, "S")
	if not (info and type(info.source) == "string") then return false end
	local s = info.source:lower():gsub("/", "\\")
	file = file:lower()
	return s == "@" .. file or s:sub(-(#file + 1)) == "\\" .. file
end

-- A hit this machine applies for another player (his proxy is the draftsman): the host or a map server, never a client.
local function remote_player_hit(h)
	if P.is_client() then return false end
	local ok, id = pcall(function() return h.draftsman:id() end)
	return ok and type(id) == "number" and id ~= 0 and P.is_player_id(id)
end

-- The multihit fix's rule for a remote player's hit, by the hit's own bullet. That fix drops a second bullet wound of one bullet
-- on one target, judged by the last bullet that hit something on THIS machine: a client's bullets do not fly here and the fix
-- does not run on his machine, so one bullet of his through two bones of an NPC took health twice (the host's once). His hit
-- carries the bullet's number from his machine (shit.bullet_id: SHit::BulletID, on the wire with every hit; every pellet of a
-- shell has its own, so shot needs no exception). The same number on the same target within BULLET_AGAIN_MS is that bullet
-- again; later it is another bullet (his game started again and counts from 0).
local BULLET_AGAIN_MS, NO_BULLET, BULLET_TARGETS = 1000, 4294967295, 64
local last_bullet = {} -- [the player's character id] = { n = targets kept, [target id] = { bullet id, time } }

local function bullet_again(obj, h, flags)
	local ok, again = pcall(function()
		local id = h.bullet_id
		if type(id) ~= "number" or id < 0 or id >= NO_BULLET or h.type ~= hit.fire_wound then return false end
		local who, target, now = h.draftsman:id(), obj:id(), time_global()
		local t = last_bullet[who]
		if not t or t.n >= BULLET_TARGETS then
			t = { n = 0 }
			last_bullet[who] = t
		end
		local e = t[target]
		if e and e[1] == id and now - e[2] <= BULLET_AGAIN_MS then return true end
		if not e then t.n = t.n + 1 end
		t[target] = { id, now }
		return false
	end)
	if not (ok and again) then return false end
	if type(flags) == "table" then flags.ret_value = false end -- the engine ignores the hit, as the fix asks it to
	pcall(function() h.power = 0 end)
	return true
end

local function apply_function_rewrite(r)
	local tag = r.module .. "." .. r.name
	local m = coop_util.module(r.module)
	if not m then return end -- mod absent
	local src, path = read_script(r.module, r.archive)
	if not src then
		log("rewrite %s skipped: not a loose file", tag)
		return
	end
	local text, line = method_text(src, r.header)
	local out, why = text and rewrite_text(text, r)
	if not out then
		log("rewrite %s skipped (another version of the script): %s", tag, why or line)
		return
	end
	local file, head = r.module .. ".script", "function " .. r.name
	local current = rawget(m, r.name)
	local original = find_original(current, file, line, {}, 0)
	if not original or out:sub(1, #head) ~= head then
		log("rewrite %s skipped: the original function is not reachable from the module", tag)
		return
	end
	-- the original's upvalues are the file's locals it uses: the same names, local here, then the same values
	local names, values = {}, {}
	for i = 1, 255 do
		local name, v = debug.getupvalue(original, i)
		if not name then break end
		names[#names + 1] = name
		values[name] = { v }
	end
	local decl = #names > 0 and ("local " .. table.concat(names, ", ") .. "; ") or ""
	local chunk, err = loadstring(string.rep("\n", line - 1) .. "local __rewritten = {} " .. decl .. "function __rewritten." ..
		out:sub(#"function " + 1) .. "\nreturn __rewritten." .. r.name, "@" .. path)
	if not chunk then
		report("rewrite " .. tag, err)
		return
	end
	setfenv(chunk, m)
	local ok, fixed = pcall(chunk)
	if not (ok and type(fixed) == "function") then
		report("rewrite " .. tag, fixed)
		return
	end
	for i = 1, 255 do
		local name = debug.getupvalue(fixed, i)
		if not name then break end
		if not values[name] then
			log("rewrite %s skipped: the rewritten function needs %s, the original has no such upvalue", tag, name)
			return
		end
		debug.setupvalue(fixed, i, values[name][1])
	end
	local places, past = 0, nil
	if current == original then
		m[r.name] = fixed
		places = 1
	else
		places = swap_upvalues(current, file, line, fixed, {}, 0)
		if places > 0 and r.past and defined_in(current, r.past .. ".script") then
			local wrapper = current
			m[r.name] = function(obj, h, ...)
				if remote_player_hit(h) then
					local _, flags = ...
					if bullet_again(obj, h, flags) then return end
					return fixed(obj, h, ...)
				end
				return wrapper(obj, h, ...)
			end
			past = r.past
		end
	end
	if places == 0 then
		log("rewrite %s skipped: the original function is not reachable from the module", tag)
		return
	end
	applied[#applied + 1] = "rewrite:" .. tag
	log("rewrite %s applied (%d change(s), %d place(s)%s)", tag, #r, places, past and (", a remote player's hit goes past " .. past) or "")
end

function _function_rewrites() return FUNCTION_REWRITES end

-------------------------------------------------------------------------------
-- Wrappers
-------------------------------------------------------------------------------
local function wrap_ai_rework()
	local m = coop_util.module("schemes_ai_gamma")
	if not m then return end
	for _, name in ipairs({ "scheme_camper", "scheme_cover" }) do
		local f = m[name]
		-- A zero-argument stub (another mod disabled it) answers a constant: nothing to do.
		local nparams = type(f) == "function" and debug.getinfo(f, "u").nparams -- nil on LuaJIT 2.0
		if type(f) == "function" and (nparams == nil or nparams > 0) and not orig[name] then
			orig[name] = f
			m[name] = function(enemy, npc, actor, ...)
				if not (P.host_on() and enemy and P.is_proxy(enemy)) then return f(enemy, npc, actor, ...) end
				local ok, r = pcall(P.with_identity, enemy, f, enemy, npc, actor, ...)
				if not ok then
					report(name, r)
					return false
				end
				return r
			end
			applied[#applied + 1] = "ai_rework." .. name
		end
	end
end

local NIGHT_RADIUS = 75 -- night_mutants: safe_radius

local function wrap_night_mutants()
	local m = coop_util.module("night_mutants")
	local f = m and m.se_obj_outside_spawn_radius
	if type(f) ~= "function" or orig.night then return end
	orig.night = f
	m.se_obj_outside_spawn_radius = function(se_obj, ...)
		if not f(se_obj, ...) then return false end -- too close to the host's player
		if not (P.host_on() and se_obj) then return true end
		for _, p in ipairs(P.others()) do
			local ok, outside = pcall(P.with_identity, p, f, se_obj, ...)
			if not ok then
				report("night_mutants radius", outside)
			elseif not outside then
				return false
			end
		end
		-- a player on another level has his record: the spawn is the world server's, on every level
		local qc = coop_quests_core
		local who, _, d = qc.nearest_body(se_obj, true)
		if who and who.far and d <= NIGHT_RADIUS * NIGHT_RADIUS then return false end
		return true
	end
	applied[#applied + 1] = "night_mutants"
end

-- NPCs do not loot a corpse or pick up an item within the loot distance of the HOST's actor (xr_corpse_detection /
-- xr_gather_items near_actor), so they would loot a client's kills right in front of him. Any player
-- within that distance counts. The module calls near_actor through its own table: the wrapper is seen at once.
local function wrap_loot()
	for _, name in ipairs({ "xr_corpse_detection", "xr_gather_items" }) do
		local m = coop_util.module(name)
		local f = m and m.near_actor
		if type(f) == "function" and not orig["loot_" .. name] then
			orig["loot_" .. name] = f
			m.near_actor = function(obj)
				local r = f(obj)
				if r or not (P.host_on() and obj) then return r end -- single player: the stock answer as it is
				local dist = tonumber(ui_options.get("gameplay/general/npc_loot_distance"))
				return dist ~= nil and dist > 0 and coop_npc_any_player_within(obj, dist) == true
			end
			applied[#applied + 1] = "loot:" .. name
		end
	end
end

-- A squad may not come online within excl_dist (75 m) of the player - the HOST's player, so squads would pop into view
-- next to a far client. The stock rule runs again as each other player (with_identity); any
-- "no" stands. On a map server db.actor is its ghost, nobody: the players of its level are all that counts.
local function wrap_squads()
	local m = coop_util.module("sim_squad_scripted")
	local cls = m and m.sim_squad_scripted
	local f = cls and cls.check_online_status
	if type(f) ~= "function" or orig.squad_online then return end
	orig.squad_online = f
	cls.check_online_status = function(self, ...)
		local first = P.host_on() and coop_mode.leads_for_world_elsewhere() and P.others()[1] or nil
		if first then
			P.with_identity(first, f, self, ...)
		else
			f(self, ...)
		end
		if self.forced_online_status ~= nil or self.online or not P.host_on() then return end
		for _, p in ipairs(P.others()) do
			local ok, err = pcall(P.with_identity, p, f, self, ...)
			if not ok then
				report("squad online exclusion", err)
			elseif self.forced_online_status == false then
				return
			end
		end
	end
	applied[#applied + 1] = "squad_exclusion"
	-- A squad sent at "the actor" (a bounty, a task) goes to id 0: on a map server that is its ghost. It goes to a player of the level.
	local actor = coop_util.module("se_actor")
	local ca = actor and actor.se_actor
	local function player_here()
		return P.host_on() and coop_mode.leads_for_world_elsewhere() and P.others()[1] or nil
	end
	local where, task = ca and ca.get_location, ca and ca.get_alife_task
	if type(where) == "function" then
		ca.get_location = function(self, ...)
			local p = player_here()
			if p then return p:position(), p:level_vertex_id(), p:game_vertex_id() end
			return where(self, ...)
		end
	end
	if type(task) == "function" then
		ca.get_alife_task = function(self, ...)
			local p = player_here()
			if p then return CALifeSmartTerrainTask(p:game_vertex_id(), p:level_vertex_id()) end
			return task(self, ...)
		end
	end
end

-- A smart terrain does not respawn within its respawn_radius of the HOST's player only; any player counts. The world
-- server alone respawns (a map server's try_respawn returns, coop_main): for a player on a map server's level it has no object, only
-- the record of his body, and "the actor is on this level" holds for him too (respawn_only_level).
local function player_near_record(self, r)
	local gg = game_graph()
	local lid = gg:vertex(self.m_game_vertex_id):level_id()
	local on_level = false
	for _, p in ipairs(coop_util.players()) do
		local se = not p.is_self and type(p.avatar_id) == "number" and alife_object(p.avatar_id) or nil
		if se and gg:vertex(se.m_game_vertex_id):level_id() == lid then
			on_level = true
			if se.position:distance_to_sqr(self.position) <= r * r then return true, true end
		end
	end
	return false, on_level
end

-- These answers concern presence, never the process's role. everyone()
-- already excludes a server's actor and only returns live bodies on this map.
function camera_player_near(pos, limit_sqr, original_distance_sqr)
	if not P.active() then return original_distance_sqr < limit_sqr end
	for _, o in ipairs(P.everyone()) do
		if pos:distance_to_sqr(o:position()) < limit_sqr then return true end
	end
	return false
end

function crow_spawn_clear(pos)
	if not P.active() then return pos:distance_to_sqr(db.actor:position()) > 10000 end
	return not P.any_within(pos, 100)
end

local function same_presence_level(self, gvid)
	local gg = game_graph()
	return gg:vertex(self.m_game_vertex_id):level_id() == gg:vertex(gvid):level_id()
end

local function record_is_alive(se)
	-- A downed player is still present. Use the body's life, not standing().
	local ok, alive = pcall(se.alive, se)
	return not ok or alive ~= false -- same record fallback as coop_quests_core's far body
end

local function escort_distance_sqr(squad)
	local companions = coop_mods_core.mod("coop_npc_companions")
	local commander = squad.commander_id and alife_object(squad:commander_id())
	local owner = commander and companions and companions.owner_character and companions.owner_character(commander)
	-- The stock companion owner defaults to seat 0. A server has no player in that seat.
	if owner == 0 and not coop_mode.seat_plays(0) then owner = nil end
	local best = math.huge
	for _, o in ipairs(P.everyone()) do
		if (owner == nil or owner == o:id()) and same_presence_level(squad, o:game_vertex_id()) then
			best = math.min(best, squad.position:distance_to_sqr(o:position()))
		end
	end
	for _, p in ipairs(coop_util.players()) do
		local id = p.avatar_id
		local se = not p.is_self and type(id) == "number" and not level.object_by_id(id) and alife_object(id)
		if se and (owner == nil or owner == id) and record_is_alive(se) and same_presence_level(squad, se.m_game_vertex_id) then
			best = math.min(best, squad.position:distance_to_sqr(se.position))
		end
	end
	return best
end

local function wrap_faction_target()
	if not coop_mods_core.mod("tasks_faction_control") then return end
	coop_mods_core.wrap(task_functor, "simulation_task_target", "npc.faction_target", function(f)
		return function(task_id, field, p, tsk, ...)
			if not P.active() or not db.actor or not tsk or tsk.stage == 0 then return f(task_id, field, p, tsk, ...) end
			local squad = get_story_squad("hostage_companion_task_1")
			if not (squad and squad:clsid() == clsid.online_offline_group_s) then return f(task_id, field, p, tsk, ...) end
			local target = f(task_id, field, p, tsk, ...)
			if target ~= squad.id and target ~= tsk.task_giver_id then return target end
			if escort_distance_sqr(squad) > 2500 then return squad.id end
			if tsk.stage >= 1 or db.actor:has_info("hostage_companion_task_1_hostage_rescued") then return tsk.task_giver_id or squad.id end
			return squad.id
		end
	end)
end

local function wrap_smart_respawn()
	local m = coop_util.module("smart_terrain")
	local cls = m and m.se_smart_terrain
	local f = cls and cls.try_respawn
	if type(f) ~= "function" or orig.smart_respawn then return end
	orig.smart_respawn = f
	cls.try_respawn = function(self, ...)
		if not (P.host_on() and self.position) then return f(self, ...) end
		local r = tonumber(self.respawn_radius) or 150
		if P.any_within(self.position, r) then return end -- a player is near: nothing spawns in his view
		local near_one, on_level = player_near_record(self, r)
		if near_one then return end
		if self.is_on_actor_level or not on_level then return f(self, ...) end
		self.is_on_actor_level = true
		local ok, err = pcall(f, self, ...)
		self.is_on_actor_level = nil
		if not ok then error(err, 0) end
	end
	applied[#applied + 1] = "smart_respawn"
end

-- Helicopters (heli_combat / heli_fire, stock scripts in the archives: class methods are wrapped) know the HOST's actor
-- as "the actor" and every other player's character as an ordinary NPC, so a heli set on the player (actor_always_enemy,
-- combat_enemy = actor, heli_fire enemy = actor) would never turn on a client. A player's
-- character counts as the actor: the actor's enemy rule (his own heli flag - set on his character when he shot the
-- heli - or actor_always_enemy), and "the actor" as a target is the nearest player.
-- heli_fire with enemy = actor picks once and keeps it, and a player who is down is alive for the engine: a mission's heli
-- would fire at the host alone, even dead. It works through the players it sees, on their feet, in turns.
-- Skyfall sets its heli on db.actor at every status check, past all of this (tasks_skyfall set_player_enemy ->
-- heli_combat:set_enemy): that one call goes through the same turns; a heli that sees nobody looks for the players it knows of.
local HELI_TURN_MS = 10000 -- how long one player has its attention
local HELI_LOOK_MS = 1000 -- how often it looks while it has nobody

local function heli_next_player(self, heli, anywhere)
	local seen = {}
	for _, o in ipairs(P.everyone()) do
		if P.standing(o) and (anywhere or heli:isVisible(o)) then seen[#seen + 1] = o end
	end
	if #seen == 0 then return nil end
	table.sort(seen, function(a, b) return a:id() < b:id() end)
	self.coop_turn = (self.coop_turn or 0) % #seen + 1
	return seen[self.coop_turn]
end

local function wrap_helis()
	local hc = coop_util.module("heli_combat")
	local cls = hc and hc.heli_combat
	local is_enemy = cls and cls.is_enemy
	if type(is_enemy) == "function" and not orig.heli_is_enemy then
		orig.heli_is_enemy = is_enemy
		cls.is_enemy = function(self, obj)
			if P.host_on() and obj and P.is_player_id(obj:id()) and not P.standing(obj) then return false end
			if not (P.host_on() and obj and P.is_proxy(obj)) then return is_enemy(self, obj) end
			-- the stock's checks for anybody, then its rule for the actor (heli_combat.script is_enemy)
			if not obj:alive() or IsWounded(obj) then return false end
			if xr_combat_ignore.ignore_enemy_by_overrides(self.object, obj) then return false end
			local se_obj = alife_object(self.object:id())
			if not (se_obj and se_obj.community) then return false end
			if string.find(character_community(obj), se_obj.community, 1, true) then return false end
			local st = db.storage[obj:id()]
			if st and st.heli_enemy_flag == true then return true end
			return self.actor_always_enemy or false
		end
		applied[#applied + 1] = "heli:enemy"
	end
	local from_data = cls and cls.set_enemy_from_custom_data
	if type(from_data) == "function" and not orig.heli_from_data then
		orig.heli_from_data = from_data
		cls.set_enemy_from_custom_data = function(self, combat_enemy, ...)
			local r = from_data(self, combat_enemy, ...)
			if P.host_on() and combat_enemy == "actor" and self.st and self.st.enemy_id == AC_ID and self.object then
				local near = P.nearest(self.object:position())
				if near and P.is_proxy(near) then self.st.enemy_id = near:id() end
			end
			return r
		end
		applied[#applied + 1] = "heli:combat_enemy"
	end
	local hf = coop_util.module("heli_fire")
	local fcls = hf and hf.heli_fire
	local set_enemy = fcls and fcls.set_enemy
	if type(set_enemy) == "function" and not orig.heli_fire then
		orig.heli_fire = set_enemy
		fcls.set_enemy = function(self, ...)
			if not (P.host_on() and self.enemy_ == "actor" and self.obj) then return set_enemy(self, ...) end
			local ok, heli = pcall(self.obj.get_helicopter, self.obj)
			if not (ok and heli) then return set_enemy(self, ...) end
			local now = time_global()
			local st = self.enemy_id and db.storage[self.enemy_id]
			local lost = self.enemy_id ~= nil and not (st and st.object and P.standing(st.object))
			local wait = (self.enemy_id and not self.flag_by_enemy) and HELI_TURN_MS or HELI_LOOK_MS
			if lost or now - (self.coop_picked or -wait) >= wait then
				self.coop_picked = now
				local target = heli_next_player(self, heli)
				self.enemy_id = target and target:id() or nil
				self.flag_by_enemy = target ~= nil
				if not target then heli:ClearEnemy() end
			end
			-- the stock would take the host's actor for an empty target
			if self.enemy_id == nil then return end
			return set_enemy(self, ...)
		end
		applied[#applied + 1] = "heli:fire"
	end
	local sky = coop_util.module("tasks_skyfall")
	local aim = sky and sky.set_player_enemy
	if type(aim) == "function" and not orig.heli_skyfall then
		orig.heli_skyfall = aim
		sky.set_player_enemy = function(...)
			if not (P.active() and (coop_mode.decides_world() or coop_mode.leads_here())) then return aim(...) end
			local go = sky.get_dynamic_heli()
			local bound = go and go:binded_object()
			local combat = bound and bound.st and bound.st.combat
			if not combat then return end
			local now = time_global()
			local cur = combat.st.enemy_id
			if cur and P.is_player_id(cur) and P.standing(cur) and now < (combat.coop_until or 0) then return end
			local heli = go:get_helicopter()
			local target = heli_next_player(combat, heli) or heli_next_player(combat, heli, true)
			if target then
				combat.coop_until = now + HELI_TURN_MS
				combat:set_enemy(target)
			elseif cur then
				combat:forget_enemy()
			end
		end
		applied[#applied + 1] = "heli:skyfall"
	end
end

-- An old corpse is released when there are more than five and it lies 75 m from the HOST's actor (release_body_manager
-- Crelease_body:clear), so a body next to a client would go while he came to loot it. A body
-- within that distance of any other player stays in the queue but is not offered to the stock pass this time. The stock's
-- clear(all) at a level change would take every body of a level the others stay on: with a player here it does nothing.
local RELEASE_DIST_SQR = 5625 -- release_body_manager MIN_RELEASE_DISTANCE (75 m, squared)
local function release_dist_sqr(dist)
	if tonumber(dist) then return tonumber(dist) end
	local o = coop_util.module("ui_options")
	local ok, v = pcall(function() return o and o.get("gameplay/general/corpse_min_dist") end)
	v = ok and tonumber(v)
	return v and v * v or RELEASE_DIST_SQR -- the stock keeps the option in a local of its own
end

local function wrap_body_release()
	local m = coop_util.module("release_body_manager")
	local cls = m and m.Crelease_body
	local f = cls and cls.clear
	if type(f) ~= "function" or orig.body_release then return end
	orig.body_release = f
	cls.clear = function(self, all, dist, ...)
		local queue = self and self.release_objects_table
		if not P.host_on() or type(queue) ~= "table" then return f(self, all, dist, ...) end
		if all then
			if not coop_mode.group_travels() and P.others()[1] then return end
			return f(self, all, dist, ...)
		end
		local sim = alife()
		local near = release_dist_sqr(dist)
		local kept = {}
		for id, v in pairs(queue) do
			local se = sim and sim:object(id)
			if se and se.position then
				for _, p in ipairs(P.others()) do
					if p:position():distance_to_sqr(se.position) < near then
						kept[id] = v
						break
					end
				end
			end
		end
		if next(kept) == nil then return f(self, all, dist, ...) end
		for id in pairs(kept) do queue[id] = nil end
		local ok, err = pcall(f, self, all, dist, ...)
		for id, v in pairs(kept) do queue[id] = v end
		if not ok then report("body release", err) end
	end
	applied[#applied + 1] = "body_release"
end

-- A mounted gun (ph_minigun) aims at a target's feet + 0.1 m; only the host's actor gets the chest
-- point (+1 m, the stock "FAKE" aim), so a client, a proxy on the host, was shot at the ground. rot_to_firepoint receives the
-- point the aim has just computed: for a player's proxy, when the point is on his spot (xz), it moves to his chest.
local CHEST_HEIGHT = 1 -- the stock chest aim of the actor
local AIM_XZ_SQR = 0.0025 -- 5 cm: the stock jitter is 1 cm

local function wrap_mounted_guns()
	local m = coop_util.module("ph_minigun")
	local cls = m and m.action_mgun
	local f = cls and cls.rot_to_firepoint
	if type(f) ~= "function" or orig.mgun_aim then return end
	orig.mgun_aim = f
	cls.rot_to_firepoint = function(self, pt, ...)
		local tid = P.host_on() and pt and self.st and self.st.target_id
		if tid and P.is_proxy(tid) then
			local st = db.storage[tid]
			local target = st and st.object
			local ok, tp = pcall(function() return target:position() end)
			if ok and tp then
				local dx, dz = pt.x - tp.x, pt.z - tp.z
				if dx * dx + dz * dz <= AIM_XZ_SQR then pt.y = tp.y + CHEST_HEIGHT + (math.random(-1, 1) / 100) end
			end
		end
		return f(self, pt, ...)
	end
	applied[#applied + 1] = "mounted_guns"
end

-- Rostok peace zone: crimes per player.
local crime = {} -- proxy id -> true

local function wrap_peace_zone()
	local m = coop_util.module("gameplay_peace_zone")
	if not (m and type(m.npcs_friendly_to_community) == "function" and type(m.level_is_bar) == "function") then return end
	if orig.peace then return end
	local friendly = m.npcs_friendly_to_community
	orig.peace = friendly
	-- Both call sites pass the player second: false for a proxy keeps the mod's single crime bit off it.
	m.npcs_friendly_to_community = function(a, b, com, ...)
		if P.host_on() and b and P.is_proxy(b) then return false end
		return friendly(a, b, com, ...)
	end
	local function pair(npc, who)
		if character_community(npc) == "arena_enemy" then return false end
		return friendly(npc, who, "dolg") and true or false
	end
	RegisterScriptCallback("npc_on_before_hit", function(npc, s_hit)
		local who = s_hit and s_hit.draftsman
		if not (P.host_on() and who and P.is_proxy(who)) then return end
		if m.level_is_bar() and pair(npc, who) then crime[who:id()] = true end
	end)
	RegisterScriptCallback("on_enemy_eval", function(npc, ene, flags)
		if not (P.host_on() and ene and P.is_proxy(ene)) or crime[ene:id()] then return end
		if m.level_is_bar() and IsStalker(npc) and pair(npc, ene) then
			flags.override = true
			flags.result = false
		end
	end)
	RegisterScriptCallback("save_state", function(m_data) m_data.coop_npc_peace_crime = crime end)
	RegisterScriptCallback("load_state", function(m_data)
		crime = type(m_data.coop_npc_peace_crime) == "table" and m_data.coop_npc_peace_crime or {}
	end)
	RegisterScriptCallback("on_level_changing", function() crime = {} end)
	applied[#applied + 1] = "peace_zone"
end

-- Called by coop_npc_world after a client's silent kill.
function credit_silent_kill(proxy)
	if not coop_util.module("stealth_kill_detection") then return end
	local peer = P.peer_of(proxy)
	if peer then P.send(EV_STAT, { k = "silent_kills" }, peer) end
end

local function client_on_stat(t)
	if t.k ~= "silent_kills" or not game_statistics then return end
	local s = game_statistics.actor_statistics
	if type(s) == "table" and s.silent_kills == nil then s.silent_kills = { count = 0, rank = 5, rept = 0 } end
	pcall(game_statistics.increment_statistic, "silent_kills")
end

local jacket_multiplier = { o_medium = 2, o_sci = 2, o_light = 1.35, o_heavy = 4.5 }
local outfit_coefficients = {} -- outfit section -> GAMMA coefficients from the local system ini

local function outfit_of(who)
	local outfit = who and who:item_in_slot(7)
	if not outfit then return 1, 0 end
	local section = outfit:section()
	local coeff = outfit_coefficients[section]
	if not coeff then
		local kind = ini_sys:r_string_ex(section, "kind")
		local camo = ini_sys:line_exist(section, "npc_blindness_koeff") and ini_sys:r_float(section, "npc_blindness_koeff")
		coeff = { jacket_multiplier[kind] or 1, camo or 0 }
		outfit_coefficients[section] = coeff
	end
	return coeff[1], coeff[2]
end

-- The engine asks get_visible_value for every object every NPC sees, on every visibility update: the wrapper allocates
-- nothing. The three upvalues of the formula are its own, so a call keeps the values it replaced on its stack.
local function wrap_stealth_visibility(C, visual, facts)
	local holders, indexes, env = {}, {}, nil
	for i, key in ipairs({ "jacketmult", "get_camo_k", "pewpewmult" }) do
		local value, holder, index = C.find_local(visual, key)
		if type(value) ~= "number" or not holder then return end
		env = env or getfenv(holder)
		if env ~= getfenv(holder) then return end
		holders[i], indexes[i] = holder, index
	end
	if type(env.IsMoveState) ~= "function" then return end
	local jacket_at, jacket_i = holders[1], indexes[1]
	local camo_at, camo_i = holders[2], indexes[2]
	local shot_at, shot_i = holders[3], indexes[3]

	-- The formula's IsMoveState for the call in progress: the observed player's movement state when the formula asks
	-- without a compare_state; a nested call keeps the query of the outer one and restores both after it.
	local cur_move, cur_query = nil, nil
	local function move_state(state, compare_state)
		if compare_state == nil then compare_state = cur_move end
		return cur_query(state, compare_state)
	end

	local function restore(previous, outer_move, outer_query, jacket, camo, shot, ok, ...)
		rawset(env, "IsMoveState", previous)
		cur_move, cur_query = outer_move, outer_query
		debug.setupvalue(jacket_at, jacket_i, jacket)
		debug.setupvalue(camo_at, camo_i, camo)
		debug.setupvalue(shot_at, shot_i, shot)
		if not ok then error((...), 0) end
		return ...
	end

	C.wrap(visual, "get_visible_value", "npc.stealth_facts", function(old)
		return function(npc, who, ...)
			if not (who and coop_mode.leads_here() and coop_util.active()) then return old(npc, who, ...) end
			local id = who:id()
			local peer = P.peer_of(id)
			local player = peer ~= nil and (id ~= 0 or coop_mode.actor_is_player()) and coop_mode.where(peer) == "here"
			local jacket, camo = outfit_of(player and who)
			local move, shot = facts.get(player and who)
			local _, was_jacket = debug.getupvalue(jacket_at, jacket_i)
			local _, was_camo = debug.getupvalue(camo_at, camo_i)
			local _, was_shot = debug.getupvalue(shot_at, shot_i)
			debug.setupvalue(jacket_at, jacket_i, jacket)
			debug.setupvalue(camo_at, camo_i, camo)
			debug.setupvalue(shot_at, shot_i, shot)
			-- Keep only the original formula in this scope. Its IsMoveState calls
			-- take an explicit compare_state even after the native identity swap.
			local previous = rawget(env, "IsMoveState")
			local outer_move, outer_query = cur_move, cur_query
			if previous ~= move_state then cur_query = env.IsMoveState end
			cur_move = move
			rawset(env, "IsMoveState", move_state)
			if player then
				return restore(previous, outer_move, outer_query, was_jacket, was_camo, was_shot,
					pcall(P.with_identity, who, old, npc, who, ...))
			end
			return restore(previous, outer_move, outer_query, was_jacket, was_camo, was_shot, pcall(old, npc, who, ...))
		end
	end)
end

local pending_wct_facts

local function wrap_weapon_cover_tilt(facts)
	local C = coop_mods_core
	-- Run after every script's startup so the existing meet proxy condition is
	-- inside this wrapper, including its stock safemode and active-item fallback.
	C.wrap(C.mod("xr_conditions"), "actor_is_safemode", "npc.wct_safemode", function(old)
		return function(actor, npc, ...)
			local safe = old(actor, npc, ...)
			if not safe and actor and actor:id() ~= 0 and C.active() and coop_mode.leads_here() then
				local _, _, manual = facts.get(actor)
				if manual then return true end
			end
			return safe
		end
	end)
end

local function install_stealth_facts()
	local C = coop_mods_core
	local facts = C and C.mod("coop_npc_stealth_facts")
	if not facts then return end
	local visual = C.mod("stealth_mcm") and C.mod("visual_memory_manager")
	local wct = C.mod("weapon_cover_tilt")
	local ok, err = pcall(facts.install, visual ~= nil, wct)
	if not ok then report("install stealth facts", err) end
	if wct then pending_wct_facts = facts end
	if visual then
		ok, err = pcall(wrap_stealth_visibility, C, visual, facts)
		if not ok then report("install stealth visibility", err) end
	end
end

-------------------------------------------------------------------------------
-- A player's hit on this machine's actor
-------------------------------------------------------------------------------
-- CActor::Hit (engine Actor.cpp) plays a hit's hurt sound, hit marks and camera kick first and only then asks the stock
-- _G.CActor__BeforeHitCallback (_g.script), whose clause "the draftsman is a stalker friendly to db.actor" drops the hit:
-- a friendly NPC's stray bullet does no damage. A player's character is a stalker as well (his proxy where his level is
-- led, his avatar on another player's machine), and a teammate's hit reaches an actor only by the session's friendly fire
-- rule (coop_requests.cpp host_hit, host_actor_hit_dropped, stalker_hit; xrCoop/coop_hits.h). That clause would drop it:
-- the player would hear and see the hit without taking damage. In a session, the IsStalker used by that clause
-- excludes teammates. The global IsStalker, NPC hits, and single-player hits keep the stock rules. Apply this where
-- a human plays the local actor (the Co-op host and player clients in either mode).
local function wrap_actor_friend_hit()
	local f = rawget(_G, "CActor__BeforeHitCallback")
	if type(f) ~= "function" or orig.actor_hit then return end
	if not defined_in(f, "_g.script") or getfenv(f) ~= _G then
		log("player hits on the actor: CActor__BeforeHitCallback is not the stock one, left as it is")
		return
	end
	orig.actor_hit = f
	setfenv(f, setmetatable({
		IsStalker = function(obj, ...)
			if obj ~= nil and P.active() and P.is_proxy(obj) then return false end
			return _G.IsStalker(obj, ...)
		end,
	}, { __index = _G, __newindex = _G }))
	applied[#applied + 1] = "actor_friend_hit"
end

-------------------------------------------------------------------------------
-- Install
-------------------------------------------------------------------------------
local next_tick = 0

local function actor_on_update()
	if pending_wct_facts then
		local facts = pending_wct_facts
		pending_wct_facts = nil
		local ok, err = pcall(wrap_weapon_cover_tilt, facts)
		if not ok then report("install WCT safemode", err) end
	end
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + 250
	-- whether the wrappers run where the actor is a ghost: once per game, no line per frame
	if not host_on_told and P.host_on() and not coop_mode.actor_is_player() then
		host_on_told = true
		log("host_on: on, the wrappers run for the players here; this process's own actor is no player")
	end
end

function print_status()
	log("installed %s | active: %s | errors %d", tostring(installed),
		#applied > 0 and table.concat(applied, ", ") or "nothing (no supported mod found)", P.error_count(TAG))
end

function on_game_start()
	coop_util.add_status("coop_npc_compat", 190)
	P = coop_npc_players
	if not rawget(_G, "coop") then return end
	if not installed then
		installed = true
		-- for rewritten mod code: this machine is a client (its monster puppets have no AI, so no enemy)
		_G.coop_npc_on_client = function() return P.client_live() end
		-- for rewritten damage code: this machine applies hits (single player, the host, a map server). The scripts that ask run
		-- on the host by the route rules; were one given to the owner (coop_requests.cpp client_hit_perks runs the owner's
		-- handlers on a client before his hit is sent), the client's machine leaves the hit to the host.
		_G.coop_npc_applies_hits = function() return not P.is_client() end
		local _ = coop_quests_core -- the far view is in place before a rewrite loads a task script (tasks_chimera_scan keeps it in a local)
		for name, list in pairs(REWRITES) do
			local ok, err = pcall(apply_rewrite, name, list)
			if not ok then report("rewrite " .. name, err) end
		end
		for _, r in ipairs(METHOD_REWRITES) do
			local ok, err = pcall(apply_method_rewrite, r)
			if not ok then report("rewrite " .. r.module .. "." .. r.method, err) end
		end
		for _, r in ipairs(FUNCTION_REWRITES) do
			local ok, err = pcall(apply_function_rewrite, r)
			if not ok then report("rewrite " .. r.module .. "." .. r.name, err) end
		end
		local ok, err = pcall(install_stealth_facts)
		if not ok then report("install stealth facts", err) end
		local adapters = coop_util.module("coop_npc_adapters")
		if adapters then adapters.install(P, applied) end
		local phantoms = coop_util.module("coop_npc_phantoms")
		if phantoms then phantoms.install(P, applied) end
		for _, s in ipairs({ { "ai_rework", wrap_ai_rework }, { "night_mutants", wrap_night_mutants },
			{ "faction_target", wrap_faction_target },
			{ "peace_zone", wrap_peace_zone }, { "loot", wrap_loot },
			{ "squads", wrap_squads }, { "smart_respawn", wrap_smart_respawn }, { "helis", wrap_helis },
			{ "body_release", wrap_body_release }, { "mounted_guns", wrap_mounted_guns },
			{ "actor_friend_hit", wrap_actor_friend_hit } }) do
			local ok, err = pcall(s[2])
			if not ok then report("install " .. s[1], err) end
		end
	end
	P.on(EV_STAT, client_on_stat, "client", TAG)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end

function _applied() return applied end
