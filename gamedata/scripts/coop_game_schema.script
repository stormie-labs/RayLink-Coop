	note = TEXT .. "applies_new_levels", mcm = "drx_da" })

-- Tab 4. Difficulty and economy: the presets are chosen once (stock lists, stock strings); the 26 factors (g| / e|) are
-- edited on an existing game with the steps of the stock pages gameplay_diff / economy_diff, they are not listed here
add("difficulty", "w|difficulty", "list", { v = { 1, 2, 3 }, def = 1, when = "create", applies = "create",
	texts = { "st_diff_1", "st_diff_2", "st_diff_3" } })
add("difficulty", "w|economy", "list", { v = { 1, 2, 3 }, def = 1, when = "create", applies = "create",
	texts = { "st_econ_1", "st_econ_2", "st_econ_3" } })

-- Tab 5. Saves
c_item("saves", "coop_autosave_interval", "list", { v = { 5, 10, 15, 20, 30, 60, 0 }, tail = 0, unit = "min" })
c_item("saves", "coop_autosave_count", "list", { v = { 3, 5, 10, 20, 50 } })

-- Tab 6. Other: no items, the snapshot of the machine's other options (coop_game_record.take_machine)

-------------------------------------------------------------------------------
-- Reading a raw value
-------------------------------------------------------------------------------
-- Typed value for a raw one, nil = invalid. Second result true = a valid value that is not in the list (extra).
local function parse_value(item, raw)
	local vt = item.vt
	if vt == "bool" then
		return to_bool(raw), false
	elseif vt == "num" then
		local n = to_number(raw)
		if n == nil then return nil end
		if item.int and abs(n - floor(n + 0.5)) > 1e-6 then return nil end
		for _, e in ipairs(item.values) do
			if abs(e[1] - n) <= EPS then return e[1], false end
		end
		local r = item.range
		if not r then return nil end
		if item.int then n = floor(n + 0.5) else n = floor(n * 10000 + 0.5) / 10000 end
		if n < r[1] - EPS or n > r[2] + EPS then return nil end
		return max(r[1], min(r[2], n)), true
	elseif vt == "str" then
		if type(raw) ~= "string" then return nil end
		local s = lower(trim(raw))
		if item.aliases and item.aliases[s] then s = item.aliases[s] end
		for _, e in ipairs(item.values) do
			if e[1] == s then return s, false end
		end
		return nil
	elseif vt == "name" then
		-- a character / faction name as the protocol checks it (char_name_valid)
		if type(raw) ~= "string" then return nil end
		local s = trim(raw)
		if s == "" or #s > 64 or s:find("[^%w_%.%-]") then return nil end
		return s, false
	end
	return nil
end

local function add_extra(item, v)
	if item.vt ~= "num" then return end
	local at = #item.values + 1
	for i, e in ipairs(item.values) do
		if e.tail or e[1] > v then
			at = i
			break
		end
	end
	tinsert(item.values, at, { v, nil, extra = true })
end

-------------------------------------------------------------------------------
-- Interface
-------------------------------------------------------------------------------
-- Items of a tab in display order (a new array, the items are shared). An unknown tab has none.
function items(tab)
	local out = {}
	for i, it in ipairs(BY_TAB[tab] or {}) do out[i] = it end
	return out
end

function item(key)
	return ITEM[key]
end

-- Every catalog key, tab by tab.
function keys()
	local out = {}
	for _, tab in ipairs(TABS) do
		for _, it in ipairs(BY_TAB[tab]) do out[#out + 1] = it.key end
	end
	return out
end

-- Can the key be changed? existing = the game exists already (its type is fixed). The factors g| e| s| are not in the
-- catalog: they are set by the presets at creation and edited on an existing game. Any other key is not edited here.
function editable(key, existing)
	local it = ITEM[key]
	if it then return not (existing and it.when == "create") end
	if existing and type(key) == "string" then
		local src = key:match("^(%a)|")
		return src == "g" or src == "e" or src == "s"
	end
	return false
end

function default(key)
	local it = ITEM[key]
	if not it then return nil end
	return it.def
end

-- Typed value for a raw one (a string from the file or the console, or already typed). A value in the list comes back as
-- the list's own; a valid value outside the list is kept: it is added to the item as an extra entry so that nothing is
-- changed silently. nil = unknown key or invalid value (out of range, wrong type, not a token of the list).
function normalize(key, raw)
	local it = ITEM[key]
	if not it then return nil end
	local v, extra = parse_value(it, raw)
	if v == nil then return nil end
	if extra then add_extra(it, v) end
	return v
end

-- The form the record keeps for a typed value: a string; nil when the value is invalid for the key.
function to_raw(key, v)
	local it = ITEM[key]
	if not it then return nil end
	local val = parse_value(it, v)
	if val == nil then return nil end
	if it.vt == "bool" then
		if it.src == "c" then return val and "1" or "0" end
		return val and "true" or "false"
	end
	if it.vt == "num" then return num_str(val) end
	return val
end

-- Canonical raw string of a raw value of the key ("0.300000" -> "0.3", "ON" -> "1" for a console flag); a value that is
-- not valid for the key, or a key outside the catalog, comes back trimmed and unchanged. Nothing is added to the catalog.
function canon(key, raw)
	local s = to_raw(key, raw)
	if s ~= nil then return s end
	if type(raw) == "string" then return trim(raw) end
	return tostring(raw)
end

-- "o|a/b" -> "o", "a/b"; a key without a source ("faction") -> nil
function parse_key(key)
	if type(key) ~= "string" then return nil end
	local src, path = key:match("^(%a)|(.+)$")
	return src, path
end

-- Drops the extra entries normalize added (a new screen starts from the catalog again).
function reset_extras()
	for _, it in pairs(ITEM) do
		for i = #it.values, 1, -1 do
			if it.values[i].extra then table.remove(it.values, i) end
		end
	end
end

-- Ids the string table st_coop_game.xml has to define for the catalog (sorted): tabs, items, values, hints. The stock
-- strings (st_diff_N, st_econ_N) are not in it.
function text_ids()
	local seen, out = {}, {}
	local function put(id)
		if id and id:find("^" .. TEXT) and not seen[id] then
			seen[id] = true
			out[#out + 1] = id
		end
	end
	for _, tab in ipairs(TABS) do
		put(TEXT .. "tab_" .. tab)
		for _, it in ipairs(BY_TAB[tab]) do
			put(it.text)
			put(it.note)
			for _, e in ipairs(it.values) do put(e[2]) end
		end
	end
	tsort(out)
	return out
end
