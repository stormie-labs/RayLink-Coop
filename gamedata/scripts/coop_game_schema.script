	def = "kill_at_vortex" })
add("world", "o|alife/event/psi_storm_warning", "list", { v = { "siren", "no_warning" }, def = "siren" })
-- Dynamic Anomalies Overhaul (MCM addon drx_da); what is already placed stays, new anomalies follow the setting
add("world", "m|drx_da/anomaly_amount_modifier", "list", { v = { 0, 0.5, 1, 1.5, 2, 3 }, def = 1, range = { 0, 3 },
	applies = "next", note = TEXT .. "applies_new_levels", mcm = "drx_da" })
add("world", "m|drx_da/artefacts_spawn_chance", "list", { v = { 0, 5, 10, 15, 25 }, def = 15, range = { 0, 25 },
	applies = "next", note = TEXT .. "applies_new_levels", mcm = "drx_da", unit = "pct" })
