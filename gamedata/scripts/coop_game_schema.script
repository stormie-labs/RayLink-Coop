--[[
	Anomaly Coop - game settings catalog (gamedata\scripts\coop_game_schema.script)

	Which host settings belong to a game (docs\GAME_SETTINGS.md section 3.6), their lists of values, defaults, when they
	can be changed and when they start to act. Pure data and rules: no engine call, no global state of the game, every
	outside value is a parameter. The record built on this catalog is coop_game_record.script.

	Keys. A key is "<source>|<path>", the source says where the value lives (the wire format of coop_settings):
		c|<name>        console variable of the engine (CVARS below, 17 of them)
		o|<path>        [options] of axr_options.ltx (stock options, "coop/coop_session/<id>" rules)
		m|<path>        [mcm] of axr_options.ltx (mod settings)
		w|<flag>        world creation flag: story, routes, difficulty, economy (record.world)
		g|<id> e|<id>   difficulty / economy factors, s|<id> other values of the save (not in the catalog: the factors
		                are taken from the stock pages at run time, section 3.6 tab 4)
		faction         the world's faction (record.faction)

	Typed values. A catalog value is typed: a number, a boolean, or a string from the list. The record keeps the raw
	form (a string for c / o / m): normalize(key, raw) -> typed value, to_raw(key, typed) -> the string the record keeps.
	A boolean is "1" / "0" for a console variable and "true" / "false" for o / m.

	Item (items(tab), item(key)):
		key, tab, id            id = last path segment without a leading "coop_" ("c|coop_death_mode" -> "death_mode")
		kind                    "list" | "check"
		values                  { {v, text_id}, ... } in display order; a check has { {true, "st_coop_game_on"},
		                        {false, "st_coop_game_off"} }. normalize adds a machine value that is not in the list
		                        as { v, nil, extra = true }: no text, show tostring(v) with item.unit
		def                     default (typed); nil for "faction" (the stock screen owns the list)
		when                    "create" (set once, the world's type) | "session" (changes between sessions)
		applies                 when a changed value starts to act: "create" | "load" | "live" | "next" (with the next
		                        event: emission, new levels, respawn)
		note                    string id of the "next" hint, or nil: st_coop_game_applies_{next_emission,new_levels}
		text                    "st_coop_game_<id>"; a value's text is "st_coop_game_<id>_<token>", token = the string
		                        or the number with "." as "_" (0.25 -> "0_25"); difficulty and economy use the stock
		                        st_diff_N / st_econ_N
		cvar                    console variable name or nil; needs_mcm = MCM addon id or nil (hide the item without it)
		unit                    "s" | "min" | "m" | "h" | "pct" | "frac" (a fraction shown as percent) | nil
		shown_if                { key = <key>, any = { values } } or nil: show the item only while that item holds one
		                        of the values (death share with drop / lose, new kit with hardcore)
		range, int              { min, max } the values that are accepted outside the list; int = whole numbers only
]]

local floor, abs, huge, max, min = math.floor, math.abs, math.huge, math.max, math.min
local lower = string.lower
local tonumber, tostring, type, pairs, ipairs = tonumber, tostring, type, pairs, ipairs
local tinsert, tsort = table.insert, table.sort
local string_format = string.format

TABS = { "death", "party", "world", "difficulty", "saves", "other" }

-------------------------------------------------------------------------------
-- Console variables of the engine (docs\GAME_SETTINGS.md 1.2, the engine's CMD registrations)
-------------------------------------------------------------------------------
CVARS = {} -- the 17 names, in the order of the table in 1.2
CVAR = {} -- name -> { name, kind = "int" | "float" | "token", min, max, def, tokens, aliases }

local function cvar(name, kind, lo, hi, def, tokens, aliases)
	CVARS[#CVARS + 1] = name
	CVAR[name] = { name = name, kind = kind, min = lo, max = hi, def = def, tokens = tokens, aliases = aliases }
end

cvar("coop_friendly_fire", "int", 0, 1, 1)
cvar("coop_max_new_characters", "int", 1, 64, 8)
cvar("coop_share_rewards", "int", 0, 1, 0)
-- respawn / respawn_keep: old user.ltx files, the engine reads them as checkpoint
cvar("coop_death_mode", "token", nil, nil, "checkpoint", { "checkpoint", "hardcore" },
	{ respawn = "checkpoint", respawn_keep = "checkpoint" })
cvar("coop_death_drop", "token", nil, nil, "drop", { "drop", "corpse", "lose", "keep" })
cvar("coop_bleedout", "float", 10, 600, 60)
cvar("coop_revive_health", "float", 0.05, 1, 0.3)
cvar("coop_respawn_delay", "float", 0, 300, 30)
cvar("coop_contusion", "float", 0, 60, 10)
cvar("coop_death_money", "float", 0, 100, 10)
cvar("coop_death_wear", "float", 0, 100, 10)
cvar("coop_death_rank", "float", 0, 100, 0)
cvar("coop_hardcore_new_kit", "int", 0, 1, 0)
cvar("coop_checkpoints_group", "int", 0, 1, 1)
cvar("coop_autosave_interval", "int", 0, 120, 10)
cvar("coop_autosave_count", "int", 1, 50, 10)
cvar("coop_death_share", "float", 0, 200, 100)

-------------------------------------------------------------------------------
-- Values: parsing and formatting
-------------------------------------------------------------------------------
local TEXT = "st_coop_game_"
local EPS = 1e-4 -- two numbers closer than this are one value (the engine prints floats with 5-6 digits)

local function trim(s)
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- finite number from a number or a decimal string, else nil
local function to_number(raw)
	local n
	if type(raw) == "number" then
		n = raw
	elseif type(raw) == "string" then
		local s = trim(raw)
		if s == "" or s:find("^[%+%-]?0[xX]") then return nil end
		n = tonumber(s)
	end
	if n == nil or n ~= n or n == huge or n == -huge then return nil end
	return n
end

local function to_bool(raw)
	if type(raw) == "boolean" then return raw end
	local s = type(raw) == "number" and tostring(raw) or (type(raw) == "string" and lower(trim(raw)) or nil)
	if s == "1" or s == "true" or s == "on" or s == "yes" then return true end
	if s == "0" or s == "false" or s == "off" or s == "no" then return false end
	return nil
end

-- "15", "0.3", "1000000": whole numbers without a point, others to 6 digits without trailing zeros
local function num_str(n)
	if n == floor(n) and abs(n) < 1e15 then return string_format("%.0f", n) end
	return (string_format("%.6f", n):gsub("0+$", ""):gsub("%.$", ""))
end

local function token(v)
	if type(v) == "number" then return (num_str(v):gsub("%.", "_")) end
	return tostring(v)
end

-------------------------------------------------------------------------------
-- Catalog
-------------------------------------------------------------------------------
local ITEM = {} -- key -> item
local BY_TAB = {} -- tab -> { item, ... }
for _, tab in ipairs(TABS) do BY_TAB[tab] = {} end

-- o: tab, key, kind and fields (see the header): v = the values, texts = their text ids when not generated,
-- def, when, applies, note, unit, mcm, shown_if, range, int, vt ("name" = a free name), tail = a value that stays last
local function add(tab, key, kind, o)
	o = o or {}
	local cv = o.cvar and CVAR[o.cvar] or nil
	local id = key:match("([^|/]+)$"):gsub("^coop_", "")
	local vt -- "bool" | "num" | "str" | "name" (a free name checked by pattern)
	if kind == "check" then
		vt = "bool"
	elseif o.vt then
		vt = o.vt
	elseif type(o.v[1]) == "number" then
		vt = "num"
	else
		vt = "str"
	end
	local item = {
		key = key, tab = tab, kind = kind, id = id, src = key:match("^(%a)|"), vt = vt,
		values = {}, when = o.when or "session", applies = o.applies or "live",
		text = TEXT .. id, note = o.note, unit = o.unit, needs_mcm = o.mcm, cvar = o.cvar, shown_if = o.shown_if,
		aliases = cv and cv.aliases or nil,
		range = o.range, int = o.int,
	}
	if cv then
		if cv.min ~= nil then item.range = { cv.min, cv.max } end
		item.int = cv.kind == "int"
	end
	if o.def ~= nil then
		item.def = o.def
	elseif cv then
		if vt == "bool" then item.def = cv.def ~= 0 else item.def = cv.def end
	end
	if kind == "check" then
		item.values = { { true, TEXT .. "on" }, { false, TEXT .. "off" } }
	else
		for i, v in ipairs(o.v or {}) do
			local e = { v, o.texts and o.texts[i] or (TEXT .. id .. "_" .. token(v)) }
			if o.tail ~= nil and o.tail == v then e.tail = true end
			item.values[i] = e
		end
	end
	ITEM[key] = item
	tinsert(BY_TAB[tab], item)
	return item
end

local function c_item(tab, name, kind, o)
	o = o or {}
	o.cvar = name
	return add(tab, "c|" .. name, kind, o)
end

local RULE = "o|coop/coop_session/"

-- Tab 1. Death and help
c_item("death", "coop_death_mode", "list", { v = { "checkpoint", "hardcore" }, when = "create" })
c_item("death", "coop_death_drop", "list", { v = { "drop", "corpse", "lose", "keep" } })
c_item("death", "coop_death_share", "list", { v = { 50, 100, 150, 200 }, unit = "pct",
	shown_if = { key = "c|coop_death_drop", any = { "drop", "lose" } } })
c_item("death", "coop_respawn_delay", "list", { v = { 0, 15, 30, 60, 120, 300 }, unit = "s" })
c_item("death", "coop_contusion", "list", { v = { 0, 5, 10, 20, 30, 60 }, unit = "min" })
c_item("death", "coop_death_money", "list", { v = { 0, 5, 10, 20, 30, 50 }, unit = "pct" })
c_item("death", "coop_death_wear", "list", { v = { 0, 5, 10, 20, 30, 50 }, unit = "pct" })
c_item("death", "coop_death_rank", "list", { v = { 0, 5, 10, 20 }, unit = "pct" })
c_item("death", "coop_hardcore_new_kit", "check", { shown_if = { key = "c|coop_death_mode", any = { "hardcore" } } })
c_item("death", "coop_bleedout", "list", { v = { 30, 60, 90, 120, 180, 300 }, unit = "s" })
c_item("death", "coop_revive_health", "list", { v = { 0.1, 0.2, 0.3, 0.5, 0.75, 1 }, unit = "frac" })
c_item("death", "coop_checkpoints_group", "check")

-- Tab 2. Group and economy
c_item("party", "coop_friendly_fire", "check")
c_item("party", "coop_share_rewards", "check")
c_item("party", "coop_max_new_characters", "list", { v = { 1, 2, 4, 8, 16, 32, 64 } })
add("party", RULE .. "join_spawn", "list", { v = { "host", "faction_start" }, def = "host" })
add("party", RULE .. "party_fast_travel", "check", { def = true })
add("party", RULE .. "gather_radius", "list", { v = { 10, 20, 30, 50, 100 }, def = 20, range = { 5, 100 }, unit = "m" })
add("party", RULE .. "travel_time", "check", { def = true })
add("party", RULE .. "teleport_radius", "list", { v = { 0, 25, 50, 100, 200 }, def = 50, range = { 0, 200 }, unit = "m" })
add("party", RULE .. "sleep_rule", "list", { v = { "vote", "safe_or_vote", "gather", "host" }, def = "vote" })
add("party", RULE .. "sleep_radius", "list", { v = { 3, 6, 10, 20, 30 }, def = 6, range = { 2, 30 }, unit = "m" })
add("party", RULE .. "vote_timeout", "list", { v = { 15, 30, 60, 120 }, def = 30, range = { 10, 120 }, unit = "s" })
add("party", RULE .. "max_skip_hours", "list", { v = { 12, 24, 48, 72, 168 }, def = 48, range = { 1, 168 }, unit = "h" })
add("party", RULE .. "money_transfer", "check", { def = true })
add("party", RULE .. "max_money_transfer", "list", { v = { 10000, 100000, 1000000, 10000000, 100000000 },
	def = 1000000, range = { 0, 100000000 }, int = true })
add("party", RULE .. "give_radius", "list", { v = { 2, 5, 10, 20 }, def = 5, range = { 1, 20 }, unit = "m" })

-- Tab 3. World. faction, story and routes are the stock controls of the new game screen (created, never changed)
add("world", "faction", "list", { vt = "name", when = "create", applies = "create" })
add("world", "w|story", "check", { def = true, when = "create", applies = "create" })
add("world", "w|routes", "check", { def = false, when = "create", applies = "create" })
add("world", "o|alife/general/alife_stalker_pop", "list", { v = { 0.25, 0.5, 0.75, 1 }, def = 0.5,
	range = { 0, 1 }, applies = "next", unit = "frac" }) -- the start population is made once, later it is the respawn rate
add("world", "o|alife/general/alife_mutant_pop", "list", { v = { 0.25, 0.5, 0.75, 1 }, def = 0.75,
	range = { 0, 1 }, applies = "next", unit = "frac" })
add("world", "o|alife/general/offline_combat", "list", { v = { "full", "on_smarts_only", "off" }, def = "full" })
add("world", "o|alife/general/excl_dist", "list", { v = { 0, 25, 50, 75, 100 }, def = 75, range = { 0, 100 },
	applies = "load", unit = "m" })
