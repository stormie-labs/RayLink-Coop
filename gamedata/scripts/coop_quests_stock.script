-- Ядро: без проверок режима (docs/MODES.md)
-- Stock Top-10 and smart capture functors. The task manager's world authority
-- owns the ranking and task state. The mode facade supplies player placement.

local TAG = "quests_stock"
local TOP = "snitch_top_10_task"
local TOP_COUNT = 10
local RANK_REQ, RANK_REPLY = "quest_stock_rank_req", "quest_stock_rank"
local REQUEST_MS, REPLY_MS = 2000, 5000
local SNITCH = "bar_informator_mlr"
local reply, next_request, next_probe
local installed


local function start_step(what, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then printf("! [coop_quests_stock] %s: %s", what, tostring(err)) end
end

local function player(peer)
	local players = coop_util.module("coop_npc_players")
	return players and players.player(peer)
end

local function stalker(id)
	local se = alife_object(id)
	return se and IsStalker(nil, se:clsid()) and se:alive() and se or nil
end

local function player_target(id, se)
	return id == 0 or coop_npc_players.is_player_id(id) or
		(se and se:section_name() == "coop_player_avatar")
end

local function read_rankings(p)
	p.calculate_rankings()
	local padding = p.get_rankings_array_size and p.get_rankings_array_size() + 1
	return p.get_coc_ranking_list() or {}, padding
end

local function rankings()
	local p = coop_util.module("pda")
	if not (p and p.calculate_rankings and p.get_coc_ranking_list) then return {} end
	-- A give can be inside the claimant's map view, where ALife substitutes
	-- its actor. Offers and gives both need the world ranking.
	local quests = coop_util.module("coop_quests_core")
	if quests and quests.at_home then return quests.at_home(read_rankings, p) end
	return read_rankings(p)
end

local function rank_place(character)
	local list, padding = rankings()
	local actor_plays = coop_mode.actor_is_player()
	local place, overwritten_place = 0, nil
	for i, id in ipairs(list) do
		if id == 0 and i == padding then
			-- The PDA forces an own-actor row into the slot after the visible list.
			overwritten_place = place + 1
		elseif id ~= 0 or actor_plays then
			place = place + 1
			if id == character then return place end
		end
	end
	-- A ranked character missing from a full list occupied that overwritten slot.
	if overwritten_place then
		if character == 0 then return overwritten_place end
		local se = stalker(character)
		if se and se:community() ~= "trader" and se:community() ~= "zombied" and
			not (story_objects and story_objects.story_id_by_object_id[character]) then
			return overwritten_place
		end
	end
end

local function claimant_place(peer)
	if not coop_mode.seat_plays(peer) then return end
	local where = coop_mode.where(peer)
	local claimant = player(peer)
	local map = claimant and claimant.level
	if where == "here" and peer == coop_mods_core.self_peer() and coop_mode.actor_is_player() then
		return rank_place(0), map
	end
	if where ~= "here" and not (where == "away" and map ~= nil and coop_mode.decider(peer) == "other") then
		return
	end
	local character = claimant and claimant.character
	if type(character) ~= "number" or character < 1 or character >= 65535 or character % 1 ~= 0 then return end
	return rank_place(character), map
end

local function eligible(place)
	return place ~= nil and place > TOP_COUNT
end

local function may_take(peer)
	local place = claimant_place(peer)
	if peer == coop_mods_core.self_peer() and coop_mode.actor_is_player() then return eligible(place) end
	return coop_trust.pass("task_top_10_take", eligible(place), "peer %s, place %s",
		tostring(peer), tostring(place))
end

-- The request carries no player, rank or level. Read all three on the authority.
local function on_rank_req(_, from)
	if not coop_mode.decides_world() then return end
	local place, map = claimant_place(from)
	if not coop_trust.pass("task_top_10_offer", place ~= nil, "peer %s: no ranked character in place", tostring(from)) then
		return
	end
	coop_mods_core.to_peer(from, RANK_REPLY, { place = place or 0, map = map })
end

local function on_rank(t)
	if not coop_mode.is_player_mirror() then return end
	local place, map = t.place, t.map
	if type(place) ~= "number" or place < 0 or place > 65535 or place % 1 ~= 0 then return end
	if map ~= nil and (type(map) ~= "number" or map < 0 or map > 65535 or map % 1 ~= 0) then return end
	reply = { place = place, map = map, at = time_global() }
end

local function request_rank()
	local now = time_global()
	local me = player(coop_mods_core.self_peer())
	local map = me and me.level
	if reply and (reply.map ~= map or now < reply.at) then
		reply, next_request = nil, nil
	end
	if not next_request or now >= next_request then
		next_request = now + REQUEST_MS
		coop_mods_core.to_host(RANK_REQ, {})
	end
	return reply ~= nil and now - reply.at <= REPLY_MS and eligible(reply.place)
end

local function dialog_eligible()
	if coop_mode.is_player_mirror() then return request_rank() end
	return coop_mode.leads_here() and coop_mode.actor_is_player() and eligible(claimant_place(coop_mods_core.self_peer()))
end

-- The dialog can build its first menu before a request from its precondition
-- has returned. Ask while the player is approaching the stock giver.
local function prefetch_rank()
	if not (coop_util.active() and coop_mode.is_player_mirror() and db.actor) then return end
	local now = time_global()
	if next_probe and now < next_probe then return end
	next_probe = now + 500
	if has_alife_info("top_10_task_started") then return end
	local id = get_story_object_id(SNITCH)
	local npc = id and id ~= 65535 and level.object_by_id(id)
	if npc and db.actor:position():distance_to_sqr(npc:position()) <= 25 * 25 then
		request_rank()
	end
end

local function setup_top(actor, npc, params)
	if not (coop_mode.decides_world() and db.actor and params and type(params[1]) == "string") then return end
	local list = rankings()
	local targets, picked = {}, {}
	for _, id in ipairs(list) do
		local se = id ~= 0 and stalker(id)
		if se and not picked[id] and not player_target(id, se) then
			targets[#targets + 1], picked[id] = id, true
			local squad = se.group_id and se.group_id ~= 65535 and alife_object(se.group_id)
			if squad then sim_offline_combat.task_squads[squad.id] = true end
			if #targets == TOP_COUNT then break end
		end
	end
	save_var(db.actor, params[1], targets)
end

local function skip_saved_player_targets(id)
	local targets = db.actor and load_var(db.actor, id)
	if type(targets) ~= "table" then return end
	-- Only the uncompleted tail is saved. Removing an invalid entry lets stock
	-- advance it just like a target that no longer exists.
	local count = 0
	for _, target in ipairs(targets) do
		if not player_target(target, alife_object(target)) then
			count = count + 1
			targets[count] = target
		end
	end
	if count < #targets then
		for i = #targets, count + 1, -1 do targets[i] = nil end
		save_var(db.actor, id, targets)
	end
end

local function install_issue_gate()
	local tasks = coop_util.module("coop_tasks")
	local manager = coop_util.module("task_manager")
	-- The Lua give sets exec_peer; the native give passes its transport peer
	-- to host_note. Read that short-lived scope before the manager consumes it.
	local requests = tasks and coop_mods_core.upvalue(tasks.host_note, "host")
	if not (manager and type(requests) == "table" and type(requests.taker_note) == "table") then
		coop_mods_core.log(TAG, "! task issue scope unavailable")
		return
	end
	local function gate(orig)
		return function(self, id, ...)
			if id == TOP and coop_util.active() and coop_mode.decides_world() then
				local peer = requests.exec_peer or requests.taker_note[id]
				if peer == nil and coop_mode.leads_here() and coop_mode.actor_is_player() then
					peer = coop_mods_core.self_peer()
				end
				if peer ~= nil and not may_take(peer) then
					requests.taker_note[id] = nil -- a refused engine request must not tag the next give
					return
				end
			end
			return orig(self, id, ...)
		end
	end
	local label = TAG .. ".top_10_take"
	local ok, wrapped = pcall(coop_mods_core.wrap, manager.CRandomTask, "give_task", label, gate)
	if ok and wrapped then return end
	if not coop_mods_core.wrap(manager.get_task_manager(), "give_task", label, gate) then
		coop_mods_core.log(TAG, "! task issue gate unavailable")
	end
end

local function install_top_10()
	local top = coop_util.module("tasks_top_10")
	if not top then return end
	coop_mods_core.wrap(coop_util.module("xr_effects"), "setup_top_10_task", TAG .. ".setup_top_10_task", function(orig)
		return function(...)
			if not coop_util.active() then return orig(...) end
			return setup_top(...)
		end
	end)
	coop_mods_core.wrap(coop_util.module("task_status_functor"), "top_10_task_status_functor", TAG .. ".top_10_status", function(orig)
		return function(tsk, id, ...)
			if coop_util.active() and coop_mode.decides_world() then skip_saved_player_targets(id) end
			return orig(tsk, id, ...)
		end
	end)
	coop_mods_core.wrap(top, "actor_is_not_top_10", TAG .. ".actor_is_not_top_10", function(orig)
		return function(...)
			if not coop_util.active() then return orig(...) end
			return dialog_eligible()
		end
	end)
	start_step("task issue", install_issue_gate)
	coop_mods_core.set_limit(RANK_REQ, 2, 0.5)
	coop_mods_core.on(RANK_REQ, on_rank_req, "world")
	coop_mods_core.on(RANK_REPLY, on_rank, "player")
	RegisterScriptCallback("actor_on_update", prefetch_rank)
end

local function normalize(side)
	return type(side) == "string" and side ~= "" and (side:gsub("^actor_", "")) or nil
end

local function owner_side(id)
	local tasks = coop_util.module("coop_tasks")
	local owner = tasks and tasks.taker_character(id)
	local faction = coop_util.module("coop_faction")
	return owner ~= nil and faction and faction.faction_of_character(owner) or nil
end

local function smart_control_side(id)
	local ini = task_manager and task_manager.task_ini
	local explicit = ini and normalize(ini:r_string_ex(id, "capture_faction"))
	return explicit or owner_side(id)
end

local function assault_side(id)
	if coop_mode.leads_here() and coop_mode.actor_is_player() then
		local faction = coop_util.module("coop_faction")
		return faction and faction.group_faction()
	end
	return owner_side(id)
end

local function wrap_capture(module_name, functor, side_of)
	local module = coop_util.module(module_name)
	if not module then return end
	coop_mods_core.wrap(coop_util.module("task_status_functor"), functor, TAG .. "." .. functor, function(orig)
		return function(task, id, ...)
			if not coop_util.active() or not (coop_mode.decides_world() or coop_mode.leads_here()) then
				return orig(task, id, ...)
			end
			local prior, stock_community = rawget(module, "character_community"), module.character_community
			rawset(module, "character_community", function(obj, ...)
				if rawequal(obj, db.actor) then
					local side = normalize(side_of(id))
					-- Stock strips actor_ and applies its faction allowlist. An
					-- unknown owner yields no capture, with stock stage logic intact.
					return side and "actor_" .. side or ""
				end
				return stock_community(obj, ...)
			end)
			local ok, result = pcall(orig, task, id, ...)
			rawset(module, "character_community", prior)
			if not ok then error(result, 0) end
			return result
		end
	end)
end

local function reset_dialog()
	reply, next_request, next_probe = nil, nil, nil
end

local function install()
	if installed then return end
	installed = true
	start_step("top 10", install_top_10)
	start_step("smart control", wrap_capture, "tasks_smart_control", "smart_control_task_status_functor", smart_control_side)
	start_step("assault", wrap_capture, "tasks_assault", "assault_task_status_functor", assault_side)
end

function on_game_start()
	if not rawget(_G, "coop") then return end
	-- Stock/module rewrites made in on_game_start are installed before these wrappers.
	start_step("register", RegisterScriptCallback, "actor_on_first_update", install)
	start_step("reset dialog", RegisterScriptCallback, "on_game_load", reset_dialog)
end
