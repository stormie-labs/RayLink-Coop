--[[
	Anomaly Coop - object binders on a co-op CLIENT, Lua half (gamedata\scripts\coop_client_binders.script; W10, F2 T11)

	Background. The engine suspends only the binders of remote CREATURES (C++ coop_remote::suspend_binder, update only).
	Every other object binder (a Lua class derived from object_binder) runs on a client exactly as in single player, and
	the callback router of coop_route covers callbacks (RegisterScriptCallback / AddUniqueCall / CreateTimeEvent), not
	binder methods. A binder that does world work then runs on the client against a frozen ALife mirror: alife():create /
	alife_create_item / SIMBOARD:create_squad answer nil there (the host creates world objects) and the stock code
	indexes the answer -> a Lua error inside a binder method is FATAL (live case 2026-10-20: smart_terrain_binder:update
	-> create_squad, patched in coop_main).

	F2 T11 moved the methods THE ENGINE CALLS to the engine: CScriptBinder (script_binder.cpp) asks the binder router
	(coop_router.cpp) before every call, keyed by the object's script_binding, and the rules are
	configs\coop_route_binders.ltx [binder_host] (a client does not call the method: faction, camp and heli update) and
	[binder_keep] (a Lua error in the method is logged once per binder and method and the binder stays: the update of 15
	binders). Nothing about those is here any more.

	What stays here is what the engine cannot see, the same configs\coop_route_binders.ltx, Lua sections, `script.class =
	method, method` (client only; nothing on the host, in single player or on an exe without co-op - the patches are
	installed from coop_main.install_client_patches and every wrapper asks coop.is_client() again):
		[binder_lua_skip]   the method returns at once on a client: methods other Lua code calls
		                    (anomaly_zone_binder:spawn_artefact_randomly / turn_off - artefact spawn and release;
		                    xr_box ph_item_box:spawn_items - box loot, called from generic_physics_binder death).
		[binder_lua_fix]    a preparation built in below (FIXES) runs first, then the stock method:
		                    crow_binder:update does not try to release a dead crow (the host does).
		[binder_lua_guard]  the method runs in pcall: a Lua error is logged and counted (coop_status) instead of FATAL, like
		                    owner/view callbacks (R-11.4). The death, hit and use callbacks of the creature binders: the
		                    engine reaches them through set_callback, not through the binder, and does not catch their
		                    errors in Release (script_callback_ex.h process_error is empty without XRAY_EXCEPTIONS).
	Left alone (verdicts in the vault note W10 client binders): smart_terrain_binder (coop_main), restrictor_binder logic
	(coop_npc_logic), campfires and anomaly fields (coop_objects ZoneState + coop_npc_world), creature binders (C++
	suspend), visual/local ones (lights, doors, bridge, flare, dynamo, level changer, smart cover).

	luabind facts the patches rely on (engine/src/3rd party/luabind, read, not run in game):
	  - `cls.update = f` writes the class table (lua_settable_dispatcher); the engine calls a method by name in the
	    class table at call time (do_call_member_selection) -> existing instances use the new function.
	  - `class "d" (base)` COPIES the base class table when d is declared (create_class::stage2): a subclass declared
	    before a patch keeps the old methods. No stock class derives from a binder class; for a mod that does, list
	    the subclass itself in the ltx.

	Extension point: the Lua sections of configs\coop_route_binders.ltx for binder classes of mods (a mod's engine-called
	methods go to [binder_host] / [binder_keep] of its coop_compat_<mod>.ltx instead). Absent scripts/classes are skipped
	silently (listed in coop_status).

	API: install() -> number of patches, idempotent, client only; print_status() (hooked into coop_main's
	coop_status by install(); STATUS_MODULES would also do, the lines are printed once). The engine's half is in
	coop_status too: the `[coop] binders` lines.
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local tostring, type, pairs, ipairs, pcall = tostring, type, pairs, ipairs, pcall

local INI = "coop_route_binders.ltx"

local function log(fmt, ...)
	local ok, line = pcall(string.format, fmt, ...)
	printf("[coop-binders] %s", ok and line or tostring(fmt))
end

local function on_client()
	return api ~= nil and api.is_client()
end

-------------------------------------------------------------------------------
-- Policy: the Lua sections of the ltx
-------------------------------------------------------------------------------
-- section of the ltx -> kind of the patch
--   noop    the method returns at once on a client
--   pre     FIXES[label](self) runs first on a client, then the stock method
--   guard   the stock method runs in pcall on a client
local SECTIONS = {
	{ "binder_lua_skip", "noop" },
	{ "binder_lua_fix", "pre" },
	{ "binder_lua_guard", "guard" },
}

-- The preparations a [binder_lua_fix] line can name, by "script.class:method".
local FIXES = {
	-- a dead crow is released by the host, not retried on every update
	["bind_crow.crow_binder:update"] = function(self) self.body_timer = 0 end,
}

-------------------------------------------------------------------------------
-- State
-------------------------------------------------------------------------------
local installed = false
local status_hooked = false
local applied = {} -- { label, kind }
local absent = {} -- "script.class" of classes that are not there (mods) or have no such method
local absent_seen = {}
local skipped = {} -- label -> client calls that did not reach the stock method
local errors = {} -- label -> Lua errors caught by a guard
local total_errors = 0
local in_status_hook, printed_in_hook = false, false

local function note_error(label, err)
	local n = (errors[label] or 0) + 1
	errors[label] = n
	total_errors = total_errors + 1
	if n <= 3 or n % 100 == 0 then
		local text = tostring(err)
		if #text > 400 then text = text:sub(1, 400) .. "..." end
		log("! lua error in %s (#%d), the session continues: %s", label, n, text)
	end
end

-------------------------------------------------------------------------------
-- Wrappers (each asks coop.is_client() at call time: a session that ended leaves the stock behaviour)
-------------------------------------------------------------------------------
local function make_noop(label)
	return function(orig)
		return function(self, ...)
			if on_client() then
				skipped[label] = (skipped[label] or 0) + 1
				return
			end
			return orig(self, ...)
		end
	end
end

local function make_pre(_, entry)
	local pre = entry.pre
	return function(orig)
		return function(self, ...)
			if on_client() then pre(self) end
			return orig(self, ...)
		end
	end
end

local function make_guard(label)
	return function(orig)
		return function(self, ...)
			if not on_client() then return orig(self, ...) end
			local ok, err = pcall(orig, self, ...)
			if not ok then note_error(label, err) end
		end
	end
end

local MAKERS = {
	noop = make_noop,
	pre = make_pre,
	guard = make_guard,
}

-------------------------------------------------------------------------------
-- Lookup (a missing script answers nil silently: the engine's auto-load is process_file_if_exists)
-------------------------------------------------------------------------------
local function module_of(name)
	local m = rawget(_G, name)
	if m == nil then
		local ok, r = pcall(function() return _G[name] end)
		m = ok and r or nil
	end
	local t = type(m)
	if t == "table" or t == "userdata" then return m end
	return nil
end

-- A luabind class is userdata, a stub class is a table.
local function class_of(script, class)
	local m = module_of(script)
	if not m then return nil end
	local ok, c = pcall(function() return m[class] end)
	if not ok then return nil end
	local t = type(c)
	if t == "table" or t == "userdata" then return c end
	return nil
end

local function method_of(cls, name)
	local ok, f = pcall(function() return cls[name] end)
	if ok and type(f) == "function" then return f end
	return nil
end

local function note_absent(what)
	if not absent_seen[what] then
		absent_seen[what] = true
		absent[#absent + 1] = what
	end
end

local function apply(entry)
	local label = entry.script .. "." .. entry.class .. ":" .. entry.method
	local ref = entry.script .. "." .. entry.class
	local cls = class_of(entry.script, entry.class)
	if not cls then
		note_absent(ref)
		return false
	end
	local orig = method_of(cls, entry.method)
	if not orig then
		note_absent(ref .. ":" .. entry.method)
		return false
	end
	local make = MAKERS[entry.kind]
	local wrapper = make and make(label, entry)(orig)
	if type(wrapper) ~= "function" then return false end
	local ok, err = pcall(function() cls[entry.method] = wrapper end)
	if not ok then
		log("! %s: cannot replace the method: %s", label, tostring(err))
		return false
	end
	if method_of(cls, entry.method) ~= wrapper then
		log("! %s: the replaced method did not stick (the class answers another function)", label)
	end
	applied[#applied + 1] = { label = label, kind = entry.kind }
	return true
end

-------------------------------------------------------------------------------
-- configs\coop_route_binders.ltx: the Lua sections
-------------------------------------------------------------------------------
local function trim(s) return (tostring(s):gsub("^%s+", ""):gsub("%s+$", "")) end

-- Calls visit(script, class, methods) for every `script.class = method, method` line of the section.
local function each_line(ini, section, visit)
	if not ini:section_exist(section) then return end
	for i = 0, ini:line_count(section) - 1 do
		local _, key, value = ini:r_line(section, i, "", "")
		if type(key) == "string" then
			local script, class = trim(key):match("^([%w_]+)%.([%w_]+)$")
			local methods = {}
			for m in (type(value) == "string" and value or ""):gmatch("[%w_]+") do methods[#methods + 1] = m end
			if not script then
				log("! configs\\%s [%s]: '%s' is not script.class", INI, section, trim(key))
			elseif #methods == 0 then
				log("! configs\\%s [%s]: %s.%s has no methods", INI, section, script, class)
			else
				visit(script, class, methods)
			end
		end
	end
end

local function ltx_entries(entries)
	local ok, ini = pcall(ini_file, INI)
	if not (ok and ini) then
		log("! configs\\%s not read, no Lua patch: %s", INI, tostring(ini))
		return
	end
	local ok2, err = pcall(function()
		for _, s in ipairs(SECTIONS) do
			local section, kind = s[1], s[2]
			each_line(ini, section, function(script, class, methods)
				for _, m in ipairs(methods) do
					local entry = { script = script, class = class, method = m, kind = kind }
					if kind == "pre" then
						entry.pre = FIXES[script .. "." .. class .. ":" .. m]
						if not entry.pre then
							log("! configs\\%s [%s]: no built-in fix for %s.%s:%s", INI, section, script, class, m)
							entry = nil
						end
					end
					if entry then entries[#entries + 1] = entry end
				end
			end)
		end
	end)
	if not ok2 then log("! configs\\%s not read completely: %s", INI, tostring(err)) end
end

-------------------------------------------------------------------------------
-- Status (coop_status)
-------------------------------------------------------------------------------
function print_status()
	if in_status_hook then printed_in_hook = true end
	local role = not api and "no engine API" or api.is_host() and "host" or api.is_client() and "client" or "off"
	local counts = {}
	for _, a in ipairs(applied) do counts[a.kind] = (counts[a.kind] or 0) + 1 end
	local total_skipped = 0
	for _, n in pairs(skipped) do total_skipped = total_skipped + n end
	log("role %s, installed %s | Lua patches %d (skipped methods %d, pre %d, guarded %d; the engine routes the binder updates, see [coop] binders) | client calls skipped %d, Lua errors caught %d",
		role, tostring(installed), #applied, counts.noop or 0, counts.pre or 0, counts.guard or 0,
		total_skipped, total_errors)
	for _, a in ipairs(applied) do
		if a.kind ~= "guard" or errors[a.label] then
			log("  %-6s %-52s skipped %6d errors %4d", a.kind, a.label, skipped[a.label] or 0, errors[a.label] or 0)
		end
	end
	if #absent > 0 then log("  not present (mods absent or no such method): %s", table.concat(absent, ", ")) end
end

-- coop_main.print_status lists fixed modules: add this one without touching that file (printed once).
local function hook_status()
	if status_hooked then return end
	local cm = module_of("coop_main")
	local prev = cm and cm.print_status
	if type(prev) ~= "function" then return end
	status_hooked = true
	cm.print_status = function(...)
		in_status_hook, printed_in_hook = true, false
		local ok, err = pcall(prev, ...)
		in_status_hook = false
		if not printed_in_hook then pcall(print_status) end
		if not ok then error(err, 0) end
	end
end

-------------------------------------------------------------------------------
-- Install
-------------------------------------------------------------------------------
function install()
	if installed then return #applied end
	if not on_client() then return 0 end -- host, single player, exe without co-op: stock behaviour
	installed = true

	local entries, seen = {}, {}
	ltx_entries(entries)

	for _, e in ipairs(entries) do
		local key = e.script .. "." .. e.class .. ":" .. e.method .. "|" .. e.kind
		if not seen[key] then
			seen[key] = true
			local ok, err = pcall(apply, e)
			if not ok then log("! %s.%s:%s: %s", e.script, e.class, e.method, tostring(err)) end
		end
	end
	hook_status()
	log("client: %d binder patch(es) installed, %d class(es)/method(s) not present", #applied, #absent)
	return #applied
end

-- Tests and diagnostics.
function _state()
	return { applied = applied, absent = absent, skipped = skipped, errors = errors, installed = installed }
end
