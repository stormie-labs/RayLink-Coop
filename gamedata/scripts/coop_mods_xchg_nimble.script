-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - Darkasleif's Nimble Upgrades Guns: an upgrade is one exchange, its money held by the keeper of the
	world's money, its guns swapped by the decider of the player's map, the money given back on any refusal
	(gamedata\scripts\coop_mods_xchg_nimble.script).

	The mod: Nimble's dialog (dialogs_zaton.xml) runs NimbleTrade.<kind>_requested(first_speaker, second_speaker)
	(NimbleTrade.script :2360-2990). It checks the money (player_has_<kind>_money: db.actor:money() >= <Cost>), takes the
	first source gun of the upgrade the actor carries, checks its parts (good_gun: item_parts, part_val) and then calls
	three independent relocations (:2369-2371): the gun to the trader, the price to the trader, the upgraded gun to the
	actor. The dialog runs on the speaker's machine; in a session each relocation is a request of its own (an ownership
	move, a ReqMoney, a create) that the decider may refuse alone: a refused gun move still pays and still gives the
	upgrade (the old gun kept), a refused create leaves the money and the old gun gone.

	Here, in a session, on a process with a player of its own, every <kind>_requested runs the mod dry (its three
	relocations recorded, none done: the mod's own money, gun and parts conditions decide whether there is an upgrade)
	and turns what it would do into one operation in two steps, one code path for both modes:
	  1. the money: mods.nim_hold to the keeper of the world's money (core.on "world": the co-op host, the world
	     server). It checks the balance and takes the price at once (the hold).
	  2. the guns: coop_mods_xchg kind "nimble" to the decider of his map ("host": the co-op host, the map server of his
	     level). It checks the concrete gun (his, a source gun of that upgrade, the mod's good_gun on it), the hold and the
	     price, makes the upgraded gun in his character, removes the old one and tells the keeper of the money the result:
	     commit (the hold is spent) or refund (the price goes back).
	  Co-op: both steps run in the host's process (its own player calls them directly with its own peer, a client's
	  come over the wire). Server: step 1 on the world server, step 2 on the map server of his level; the world server
	  tells the map servers the hold (mods.nim_held, only when it leads no map), the map server tells the world server
	  the result (mods.nim_done, only when it keeps no money). The Core asks coop_mode only: decides_world() (the money
	  is here), leads_here() (the map step is here), actor_is_player(), seat_plays(peer) (a hold's sender plays),
	  from_level(peer) and hook("levels.bridge_of_player") (a result's sender is the map server of that player's map).

	The keeper and the map retain open holds until a decision. The player repeats a pending request with the same
	number, and the map repeats its outcome until the keeper acknowledges it. Terminal replies and open holds go
	in coop_ops_done. The map also checks the concrete gun and the trader before performing the upgrade.
	Every hold ends with a word that does not hang on the player's memory: the map step's commit or refund
	(nim_done, or in Server also the gun step's Done entry, which names its hold); and, when no player of the session plays
	the hold's character any more, the keeper gives it back to the character (coop.money_grant_to) and closes it. A commit
	that comes after a hold went back takes its price again.

	Outside a session (single player) and on a process whose actor plays nobody every wrapper calls the mod unchanged;
	installed only when NimbleTrade is there. An action that does something this file does not know (another version of
	the mod) is left to the mod (logged).
	Differences from the mod in a session: the upgraded gun is always made new (the mod hands over the trader's own copy
	when he has one), and the old gun is removed, not given to the trader (a move to him can be refused: his weight,
	Inventory.cpp :1321).
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local type, pairs, ipairs, pcall, tostring, tonumber, next, rawget, rawset, error =
	type, pairs, ipairs, pcall, tostring, tonumber, next, rawget, rawset, error
local math_floor, string_sub = math.floor, string.sub

local MOD = "NimbleTrade"
local KIND = "nimble" -- the exchange of coop_mods_xchg (the gun step)
local V_HOLD, V_HOLD_R, V_HELD, V_DONE = "nim_hold", "nim_hold_r", "nim_held", "nim_done"
local V_DONE_R = "nim_done_r"
local RETRY_MS, WHY_MAX = 2000, 32
local MAX_PRICE = 10000000
local MAX_OPEN = 3       -- holds of one player waiting for their map step
local MAX_KNOWN = 512    -- holds the keeper announced, for every player
local REACH_M = 15
local PART_VAL = 60      -- the mod's part_val (NimbleTrade.script :24) when its local cannot be read

-- The mod's upgrades (NimbleTrade.script :8-21, :62-130, :2360-2990): <kind>_requested takes the first gun of `from` the
-- actor carries (in this order), the price is the mod's global `cost`, the actor gets `to`.
-- tests\lua\test_mods_xchg_nimble.lua compares this list with the mod's file.
UPGRADES = {
	{ kind = "coonan", cost = "CoonanCost", to = "wpn_colt1911_camo", from = { "wpn_colt1911", "wpn_colt1911_alt",
		"wpn_colt1911_duty", "wpn_colt1911_merc", "wpn_colt1911_modern", "wpn_colt1911_n", "wpn_colt1911_new",
		"wpn_colt1911_kimber" } },
	{ kind = "voigt", cost = "StrayerVoigtCost", to = "wpn_colt1911_custom", from = { "wpn_colt1911", "wpn_colt1911_alt",
		"wpn_colt1911_duty", "wpn_colt1911_merc", "wpn_colt1911_modern", "wpn_colt1911_n", "wpn_colt1911_new",
		"wpn_colt1911_kimber" } },
	{ kind = "deagle", cost = "DeagleCost", to = "wpn_desert_eagle_nimble", from = { "wpn_desert_eagle",
		"wpn_desert_eagle_custom", "wpn_desert_eagle_modern" } },
	{ kind = "usp", cost = "USPCost", to = "wpn_usp_nimble", from = { "wpn_usp", "wpn_usp_custom", "wpn_usp_match" } },
	{ kind = "protecta", cost = "ProtectaCost", to = "wpn_protecta_nimble", from = { "wpn_protecta", "wpn_protecta_aim",
		"wpn_protecta_camo", "wpn_protecta_custom" } },
	{ kind = "spas12", cost = "SPAS12Cost", to = "wpn_spas12_nimble", from = { "wpn_spas12", "wpn_spas12_custom" } },
	{ kind = "toz34", cost = "TOZ34Cost", to = "wpn_toz34_mark4_23", from = { "wpn_toz34", "wpn_toz34_custom",
		"wpn_toz34_decor", "wpn_toz34_mark4" } },
	{ kind = "mp5", cost = "MP5Cost", to = "wpn_mp5_nimble", from = { "wpn_mp5", "wpn_mp5_alt", "wpn_mp5_custom" } },
	{ kind = "g36", cost = "G36Cost", to = "wpn_g36nimble_rwap", from = { "wpn_g36", "wpn_g36_camo", "wpn_g36k",
		"wpn_g36ka4_rwap", "wpn_g36v_rwap" } },
	{ kind = "groza", cost = "GrozaCost", to = "wpn_groza_nimble", from = { "wpn_groza" } },
	{ kind = "pkm", cost = "PKMCost", to = "wpn_pkm_zenit_siber", from = { "wpn_pkm_siber" } },
	{ kind = "dvl10u", cost = "UrbanaCost", to = "wpn_dvl10_m1", from = { "wpn_dvl10" } },
	{ kind = "dvl10s", cost = "SaboteurCost", to = "wpn_dvl10", from = { "wpn_dvl10_m1" } },
	{ kind = "svu", cost = "SVUCost", to = "wpn_svu_nimble", from = { "wpn_svu", "wpn_svu_alt" } },
}

local BY_KIND = {} -- kind -> { cost, to, from = { section = true } }
for _, u in ipairs(UPGRADES) do
	local set = {}
	for _, s in ipairs(u.from) do set[s] = true end
	BY_KIND[u.kind] = { cost = u.cost, to = u.to, from = set }
end

stats = { asked = 0, done = 0, told = 0, timeouts = 0, ignored = 0, foreign = 0, late = 0, -- the player's machine
	held = 0, refused = 0, repeats = 0, poor = 0, committed = 0, refunded = 0, -- the keeper
	unknown = 0, dropped = 0, retaken = 0, orphaned = 0,
	applied = 0, apply_refused = 0, unpaid = 0 } -- the decider of the map

local core = coop_mods_core
local xchg = coop_mods_xchg
local function log(fmt, ...) core.log("xchg_nimble", fmt, ...) end

local function trust_pass(name, ok, fmt, ...)
	local found, t = pcall(function() return coop_trust end)
	if not (found and type(t) == "table" and type(t.pass) == "function") then return true end
	local good, res = pcall(t.pass, name, ok, fmt, ...)
	return not good or res ~= false
end

local function trust_guard(name, ok, fmt, ...)
	local found, t = pcall(function() return coop_trust end)
	if not (found and type(t) == "table" and type(t.guard) == "function") then return ok == true end
	local good, res = pcall(t.guard, name, ok, fmt, ...)
	if not good then return ok == true end
	return res == true
end

local function whole(v, lo, hi)
	return type(v) == "number" and v == v and v >= lo and v <= hi and v == math_floor(v)
end

local function valid_op(op) return coop_ops_done.wire_sequence(op) ~= nil end

local function hold_number(peer, op, claimed)
	return coop_ops_done.identify(peer, coop_ops_done.wire_sequence(op), claimed)
end

local function hold_key(origin, op)
	return tostring(origin) .. "|" .. op
end

local function upgrade(kind)
	return type(kind) == "string" and BY_KIND[kind] or nil
end

-- a short word for a reason: letters, digits and _ only, at most WHY_MAX characters
local function word(v, default)
	if type(v) ~= "string" or v == "" then return default end
	v = string_sub(v, 1, WHY_MAX)
	if not v:match("^[%w_]+$") then return default end
	return v
end

local function mod() return core.mod(MOD) end

-- The price of an upgrade in this process's copy of the mod: a whole number 1..MAX_PRICE, else nil.
local function price_of(kind)
	local u, m = upgrade(kind), mod()
	if not (u and m) then return nil end
	local ok, v = pcall(function() return m[u.cost] end)
	if ok and whole(v, 1, MAX_PRICE) then return v end
	return nil
end

-- A player's balance in the ledger of the world's money (coop.money_of), nil when it does not answer.
local function balance(peer)
	local f = api and api.money_of
	if type(f) ~= "function" then return nil end
	local ok, v = pcall(f, peer)
	v = ok and tonumber(v) or nil
	if v and v == v and v >= 0 then return v end
	return nil
end

-- Money to (delta > 0) or from (delta < 0) a player's character through the ledger (coop.money_grant): true when done.
local function grant(peer, delta)
	local f = api and api.money_grant
	if type(f) ~= "function" then return false end
	local ok, done = pcall(f, peer, delta)
	return ok and done == true
end

-- Money to a character whether a player plays him or not (coop.money_grant_to, the keeper's): true when done.
local function grant_to(character, amount)
	local f = api and api.money_grant_to
	if type(f) ~= "function" then return false end
	local ok, added = pcall(f, character, amount)
	return ok and type(added) == "number"
end

-------------------------------------------------------------------------------
-- The keeper of the world's money: the holds
-------------------------------------------------------------------------------
local holds = {} -- active payment holds, keyed by character and operation
local known = {} -- keeper authorizations: known | claimed | used | closed
local known_floor = {} -- highest evicted terminal hold per character
local outgoing = {} -- settlement reports awaiting acknowledgement
local publish_hold

local function open_holds(origin)
	local n = 0
	for _, h in pairs(holds) do
		if h.origin == origin then n = n + 1 end
	end
	return n
end

local function peer_for(origin, peer)
	if coop_ops_done.origin(peer) == origin then return peer end
	for _, row in ipairs(core.players()) do
		if coop_ops_done.origin(row.id) == origin then return row.id end
	end
end

-- The keeper's recorded answer of a hold (coop_ops_done), where a refund is marked: nil when there is none.
local function hold_record(origin, op)
	local seq = coop_ops_done.wire_sequence(op)
	if origin == nil or seq == nil then return nil end
	local saved = coop_ops_done.get({ origin = origin, seq = seq })
	if type(saved) == "table" and saved.nimble_hold == true and saved.o == op then return saved end
	return nil
end

-- A commit for a hold that went back already: the upgrade is his, so is the price, taken again from his balance.
local function commit_after_refund(peer, origin, saved)
	saved.refunded = nil
	local player = peer_for(origin, peer)
	if player ~= nil and grant(player, -saved.m) then
		stats.retaken = stats.retaken + 1
		log("a commit came after the hold of character %d went back: its price is taken again", origin)
	else
		log("! a commit came after the hold of character %d went back: its price could not be taken again", origin)
	end
end

local function settle(peer, op, commit, origin)
	if origin == nil then return false end
	local key = hold_key(origin, op)
	local h = holds[key]
	if not h then
		local saved = commit and hold_record(origin, op)
		if saved and saved.refunded == true and whole(saved.m, 1, MAX_PRICE) then
			commit_after_refund(peer, origin, saved)
			return true
		end
		stats.unknown = stats.unknown + 1
		return true -- duplicate settlements are acknowledged again
	end
	if commit then
		stats.committed = stats.committed + 1
	else
		-- to the player who plays his character, else to the character (he left: a hold is given back without him)
		local player = peer_for(origin, peer)
		if player ~= nil then
			if not grant(player, h.price) then return false end
		elseif not grant_to(origin, h.price) then
			return false
		end
		stats.refunded = stats.refunded + 1
		local saved = hold_record(origin, op)
		if saved then saved.refunded = true end
	end
	holds[key] = nil
	return true
end

local function note_held(peer, op, kind, price, claimed)
	local number = hold_number(peer, op, claimed)
	if not number or number.seq <= (known_floor[number.origin] or 0) then return end
	local key = hold_key(number.origin, op)
	if known[key] then return end
	local count, victim
	count = 0
	for k, h in pairs(known) do
		count = count + 1
		if (h.state == "used" or h.state == "closed") and not outgoing[k]
			and (not victim or h.seq < known[victim].seq) then victim = k end
	end
	if count >= MAX_KNOWN then
		if not victim then return end -- the keeper continues announcing the authorization
		local old = known[victim]
		known_floor[old.origin] = math.max(known_floor[old.origin] or 0, old.seq)
		known[victim] = nil
	end
	known[key] = { kind = kind, price = price, state = "known", origin = number.origin, seq = number.seq }
end

local function send_done(t)
	if coop_mode.decides_world() then return settle(t.p, t.h, t.c == 1, t.a) end
	core.publish(V_DONE, t)
end

local function report(peer, origin, op, commit)
	local key = hold_key(origin, op)
	local t = { p = peer, a = origin, h = op, c = commit and 1 or 0 }
	outgoing[key] = t
	if send_done(t) then outgoing[key] = nil end
end

local function close(token, commit)
	if token.closed then return end
	token.closed = true
	local k = known[token.hold]
	if k then k.state = commit and "used" or "closed" end
	if commit then
		stats.applied = stats.applied + 1
	else
		stats.apply_refused = stats.apply_refused + 1
	end
	report(token.peer, token.origin, token.h, commit)
end

-- Removes an object (alife_release_id, _g.script): true when the release was made (it returns true) or the server
-- object is gone. An online object goes a moment later (alife():release sends GE_DESTROY, alife_simulator_script.cpp
-- :425-437): coop_mods_xchg keeps a spent gun reserved until it is gone.
local function remove(id)
	local f = rawget(_G, "alife_release_id")
	local r = nil
	if type(f) == "function" then
		r = f(id)
	else
		local se = alife_object(id)
		if se then
			alife():release(se, true)
			r = true
		end
	end
	return r == true or alife_object(id) == nil
end

local orig = {} -- kind -> the mod's <kind>_requested

-- The mod's good_gun on that gun (its locals good_gun, gun_val, part_val read from its action); without them its
-- global has_bad_part with part_val 60.
local function parts_ok(kind, gun)
	local f = orig[kind]
	local good = f and core.upvalue(f, "good_gun")
	if type(good) == "function" then
		local gv = core.upvalue(f, "gun_val")
		local pv = core.upvalue(f, "part_val")
		local ok, r = pcall(good, gv, tonumber(pv) or PART_VAL, gun)
		return ok and r == true
	end
	local m = mod()
	local bad = m and core.fn(m, "has_bad_part")
	if bad then
		local ok, r = pcall(bad, PART_VAL, gun)
		return ok and not r
	end
	return true
end

local function near(who, npc)
	if not (who and npc) then return false end
	local ok, d = pcall(function()
		if npc.alive and not npc:alive() then return nil end
		return who:position():distance_to(npc:position())
	end)
	return ok and type(d) == "number" and d <= REACH_M
end

-- coop_mods_xchg "nimble": t = { h = hold op, g = kind, w = gun, n = NPC } from the player `from`, `who` his character here.
local function reserve(t, from, who)
	local op, kind = t.h, t.g
	local u = upgrade(kind)
	if not trust_guard("nimble_apply_shape", valid_op(op) and u ~= nil, "player #%d: an upgrade without a hold or a kind", from) then
		return nil, "bad"
	end
	local number = hold_number(from, op)
	if not number then return nil, "bad" end
	local key = hold_key(number.origin, op)
	local k = known[key]
	if not k then
		stats.unpaid = stats.unpaid + 1
		if not coop_mode.decides_world() and number.seq > (known_floor[number.origin] or 0) then
			return nil, "pending" -- the map is still waiting for the keeper's authorization
		end
		return nil, "unpaid"
	end
	if k.state ~= "known" then
		stats.unpaid = stats.unpaid + 1
		return nil, "unpaid" -- applied, refused or being applied: its op settles it
	end
	k.state = "claimed"
	local token = { peer = from, origin = number.origin, h = op, hold = key, price = k.price, to = u.to }
	local function refuse(why)
		close(token, false)
		return nil, why
	end
	if k.kind ~= kind or price_of(kind) ~= k.price then return refuse("price") end
	if not trust_guard("nimble_result", ini_sys:section_exist(u.to) == true, "the upgrade %s has no section here", kind) then
		return refuse("make")
	end
	if not who then return refuse("away") end
	local wid = core.wire_id(t.w)
	local gun = wid and level.object_by_id(wid) or nil
	local section = gun and gun:section()
	local his = gun ~= nil and core.root_of(wid) == who:id() and u.from[section] == true and coop_mode.writes(wid)
	if not trust_guard("nimble_weapon", his, "player #%d, op %s: the gun is not his or not one this upgrade takes", from, op) then
		return refuse("weapon")
	end
	if not trust_pass("nimble_parts", parts_ok(kind, gun), "player #%d, op %s: the parts of the gun are worn", from, op) then
		return refuse("parts")
	end
	local nid = t.n ~= nil and core.wire_id(t.n) or nil
	local npc = nid and level.object_by_id(nid) or nil
	if not trust_pass("nimble_trader", near(who, npc), "player #%d, op %s: no trader near him", from, op) then
		return refuse("far")
	end
	token.w, token.ids, token.spent = wid, { wid }, { wid }
	return token
end

local function commit(t, from, who, token)
	local made_ok, se = pcall(alife_create_item, token.to, who)
	local made = made_ok and se and tonumber(se.id) or nil
	if not made then return false, "make" end
	token.made = made
	local gone_ok, gone = pcall(remove, token.w)
	if not (gone_ok and gone) then
		pcall(remove, made)
		token.made = nil
		return false, "take"
	end
	token.made = nil -- the upgraded gun is his
	close(token, true)
	-- nh: the hold, so the Done entry of this gun step (Server: it goes up with the effect) carries the commit too
	return true, { s = token.to, m = token.price, nh = token.h }
end

local function rollback(t, from, who, token)
	if type(token) ~= "table" or not token.hold then return end
	if token.made then
		pcall(remove, token.made)
		token.made = nil
	end
	close(token, false)
end

local SPEC = { reserve = reserve, commit = commit, rollback = rollback }

-------------------------------------------------------------------------------
-- The keeper of the money: step 1, its wire
-------------------------------------------------------------------------------
local function answer(op, ok, why, price)
	if ok then return { o = op, ok = true, m = price } end
	return { o = op, ok = false, why = why }
end

-- One hold request t = { o, g } from the player `from`; reply(answer) delivers the answer. The same function for a
-- request from the wire and for the co-op host's own player.
local function hold(t, from, reply)
	if type(t) ~= "table" or not whole(from, 0, 65535) then return end
	local op = t.o
	if not trust_guard("nimble_hold_op", valid_op(op), "player #%d: a hold without a valid operation id", from) then
		stats.dropped = stats.dropped + 1
		return
	end
	local number = hold_number(from, op, t.a)
	if not number then return end
	local key = hold_key(number.origin, op)
	local h = holds[key]
	local saved, retired = coop_ops_done.get(number)
	if h or (saved and saved.nimble_hold == true and saved.o == op) then
		stats.repeats = stats.repeats + 1
		if h then
			h.peer = from
			publish_hold(h)
			return reply(h.answer)
		end
		return reply(answer(saved.o, saved.ok, saved.why, saved.m))
	end
	if saved or retired then return reply(answer(op, false, "operation")) end
	local kind = upgrade(t.g) and t.g or nil
	local price = kind and price_of(kind) or nil
	local ans
	if not trust_guard("nimble_kind", price ~= nil, "player #%d, op %s: no such upgrade here", from, op) then
		ans = answer(op, false, "kind")
	elseif open_holds(number.origin) >= MAX_OPEN then
		ans = answer(op, false, "busy")
	else
		local have = balance(from)
		if have == nil then
			ans = answer(op, false, "nochar")
		elseif have < price then
			stats.poor = stats.poor + 1
			ans = answer(op, false, "poor")
		elseif not grant(from, -price) then
			ans = answer(op, false, "money")
		else
			ans = answer(op, true, nil, price)
		end
	end
	ans.nimble_hold = true
	if ans.ok then
		stats.held = stats.held + 1
		h = { peer = from, origin = number.origin, op = op, kind = kind, price = price, answer = ans }
		holds[key] = h
		publish_hold(h)
	else
		stats.refused = stats.refused + 1
	end
	coop_ops_done.record(number, ans)
	ans.nimble_hold = nil -- ledger metadata is separate from the hold's wire reply
	return reply(ans)
end

local function hold_from_wire(t, from)
	if not trust_guard("nimble_hold_sender", coop_mode.seat_plays(from), "peer %s asked for a hold, it plays nobody",
		tostring(from)) then
		stats.dropped = stats.dropped + 1
		return
	end
	hold(t, from, function(ans) core.to_peer(from, V_HOLD_R, ans) end)
end

-- The bridge of the map server that leads player `peer`'s map, as this process knows it (the srv layer's hook
-- levels.bridge_of_player); nil: none, or no layer answers it (the co-op).
local function bridge_of(peer)
	local f = coop_mode.hook("levels.bridge_of_player")
	if not f then return nil end
	local ok, v = pcall(f, peer)
	v = ok and tonumber(v) or nil
	return whole(v, 1, 65535) and v or nil
end

function publish_hold(h)
	local player = peer_for(h.origin, h.peer)
	if player == nil then return end
	h.peer = player
	if coop_mode.leads_here() then
		note_held(h.peer, h.op, h.kind, h.price, h.origin)
	else
		local bridge = bridge_of(h.peer)
		if bridge and core.to_peer(bridge, V_HELD, { p = h.peer, a = h.origin, h = h.op, g = h.kind, m = h.price }) then
			h.bridges = h.bridges or {}
			h.bridges[bridge] = true
		end
	end
end

-- The keeper: a hold's gun step comes only from the machine of the player who asked, whose pending upgrade lives in its
-- memory (pend below). When no player of the session plays the hold's character (he left, his machine stopped, a save was
-- loaded without him) that step never comes: the hold goes back to his character and is closed. Where the map step is here
-- too (the co-op host) its authorization closes with it, so a later gun step of that hold is refused "unpaid". A commit
-- that still comes from a map server afterwards takes the price again (settle). A closed hold whose money the character
-- could not take back (orphan, saved with the hold) is given back at every sweep until it goes, to him once he plays again.
local function close_orphans()
	for key, h in pairs(holds) do
		if not h.orphan and peer_for(h.origin, h.peer) == nil then
			local k = coop_mode.leads_here() and known[key] or nil
			if k == nil or k.state == "known" or k.state == "closed" then
				h.orphan = true
				if coop_mode.leads_here() then
					known[key] = k or { kind = h.kind, price = h.price, origin = h.origin,
						seq = coop_ops_done.wire_sequence(h.op) }
					known[key].state = "closed"
				end
			end
		end
		if h.orphan and settle(nil, h.op, false, h.origin) then
			stats.orphaned = stats.orphaned + 1
			log("a hold of character %d had no player left to finish it: given back", h.origin)
		end
	end
end

-- coop_ops_done.heard: a record another process made (Server: the world applies a map server's Done entry, which goes up
-- with the effect). A committed Nimble gun step names its hold (commit: nh): the keeper takes it as that hold's commit, so a
-- map server that stopped before its nim_done was acknowledged leaves no hold open.
local function done_heard(op, ans)
	if not coop_mode.decides_world() or type(op) ~= "table" or type(ans) ~= "table" then return end
	if ans.exchange ~= true or ans.ok ~= true or not valid_op(ans["r.nh"]) then return end
	if not whole(op.origin, 0, 65534) then return end
	local hold_op = ans["r.nh"]
	local saved = hold_record(op.origin, hold_op)
	-- the usual case, its nim_done came first: nothing to settle, nothing counted
	if holds[hold_key(op.origin, hold_op)] or (saved and saved.refunded == true) then settle(nil, hold_op, true, op.origin) end
end

-- Only a bridge that was authorized for this hold can settle its payment.
local function done_from_wire(t, from)
	local leader = whole(from, 1, 65535) and coop_mode.from_level(from)
	if not trust_guard("nimble_done_sender", leader, "peer %s sent the result of an upgrade, it leads no map", tostring(from)) then
		stats.dropped = stats.dropped + 1
		return
	end
	if not coop_mode.decides_world() then return end
	local ok = type(t) == "table" and whole(t.p, 0, 65535) and valid_op(t.h) and (t.c == 0 or t.c == 1)
	if not trust_guard("nimble_done_shape", ok, "peer %s sent the result of an upgrade with bad fields", tostring(from)) then
		return
	end
	local origin = t.a or coop_ops_done.origin(t.p)
	if not whole(origin, 0, 65534) then return end
	local number = { origin = origin, seq = coop_ops_done.wire_sequence(t.h) }
	local h = holds[hold_key(origin, t.h)]
	local saved = coop_ops_done.get(number)
	local authorized = h and h.bridges and h.bridges[from]
	local settled = not h and saved and saved.nimble_hold == true and saved.o == t.h
		and (saved.settlement_bridge == from or bridge_of(t.p) == from)
	if not trust_guard("nimble_done_level", authorized == true or settled == true,
		"peer %s sent the result of an upgrade of player #%d, it leads another map", tostring(from), t.p) then
		stats.dropped = stats.dropped + 1
		return
	end
	if settle(t.p, t.h, t.c == 1, origin) then
		if h and saved then saved.settlement_bridge = from end
		core.to_peer(from, V_DONE_R, t)
	end
end

local function done_answer(t)
	if not (type(t) == "table" and valid_op(t.h)) then return end
	local origin = t.a or coop_ops_done.origin(t.p)
	if not whole(origin, 0, 65534) then return end
	local key = hold_key(origin, t.h)
	local sent = outgoing[key]
	if sent and sent.c == t.c then outgoing[key] = nil end
end

-- mods.nim_held, side "client" (from the keeper of the money, peer 0): a hold the map step may apply.
local function held_from_wire(t, from)
	if not coop_mode.leads_here() then return end -- a player's machine: the map step is not its
	local ok = whole(t.p, 0, 65535) and valid_op(t.h) and upgrade(t.g) ~= nil and whole(t.m, 1, MAX_PRICE)
	if not trust_guard("nimble_held_shape", ok, "a hold from the keeper of the money with bad fields") then return end
	note_held(t.p, t.h, t.g, t.m, t.a)
end

-------------------------------------------------------------------------------
-- The player's machine
-------------------------------------------------------------------------------
local pend = {} -- operations waiting for a payment or gun step reply

local function new_op()
	local seq = coop_ops_done.new_sequence()
	if seq == nil then return end
	local e = 0
	if api and api.world_epoch then
		local ok, v = pcall(api.world_epoch)
		v = ok and tonumber(v) or nil
		if whole(v, 0, 2147483647) then e = v end
	end
	return string.format("%.0f:%.0f:%.0f", core.self_peer(), e, seq)
end

local TEXT = {
	poor = { "st_coop_trade_no_money", "Trade failed: not enough money" },
	far = { "st_coop_trade_too_far", "Trade failed: you are too far from the trader" },
}
local FAILED = { "st_coop_trade_failed", "Trade failed: the goods are no longer available" }

local function tell(why)
	local t = TEXT[why] or FAILED
	stats.told = stats.told + 1
	log("an upgrade was not made: %s", word(why, "refused"))
	core.hud(t[1], t[2])
end

-- What the mod's relocations would have told (itms_manager.relocate_item_*, dialogs.relocate_money_from_actor).
local function news(p)
	local nm = core.mod("news_manager")
	if not (nm and db.actor) then return end
	pcall(nm.relocate_item, db.actor, "out", p.from, 1)
	pcall(nm.relocate_money, db.actor, "out", p.price)
	pcall(nm.relocate_item, db.actor, "in", p.to, 1)
end

local function applied(p, ok, r, why)
	if ok then
		stats.done = stats.done + 1
		return news(p)
	end
	tell(why)
end

-- The hold's answer (from the wire, or from hold() directly): on ok, the gun step.
local function on_hold_answer(t)
	if type(t) ~= "table" or type(t.o) ~= "string" then return end
	local p = pend[t.o]
	if not p then
		stats.late = stats.late + 1
		return
	end
	if p.applying then return end
	if t.ok ~= true then
		pend[t.o] = nil
		return tell(word(t.why, "refused"))
	end
	p.applying = true
	if whole(t.m, 1, MAX_PRICE) then p.price = t.m end
	local req = { h = p.op, g = p.kind, w = core.hid(p.w) }
	if p.n then req.n = core.hid(p.n) end
	if not xchg.ask(KIND, req, function(ok, r, why)
		pend[t.o] = nil
		applied(p, ok, r, why)
	end) then p.applying = nil end
end

local RELOCATIONS = { "relocate_item_section_from_actor", "relocate_money_from_actor", "relocate_item_section_to_actor" }

-- Runs the mod's action with its three relocations recorded instead of done: ok, error, the calls { { n, arg } }.
local function dry_run(f, first, second)
	local d = core.mod("dialogs")
	if not d then return false, "no dialogs.script", {} end
	local calls, saved = {}, {}
	for i, name in ipairs(RELOCATIONS) do
		saved[i] = rawget(d, name)
		rawset(d, name, function(_, _, arg) calls[#calls + 1] = { i, arg } end)
	end
	local ok, e = pcall(f, first, second)
	for i, name in ipairs(RELOCATIONS) do rawset(d, name, saved[i]) end
	return ok, e, calls
end

-- The upgrade the dry run describes, when it is exactly the one this file knows: { from, to, price }.
local function plan_of(kind, calls)
	local u = upgrade(kind)
	if not (u and #calls == 3 and calls[1][1] == 1 and calls[2][1] == 2 and calls[3][1] == 3) then return nil end
	local from, price, to = calls[1][2], calls[2][2], calls[3][2]
	if type(from) ~= "string" or not u.from[from] or to ~= u.to or price ~= price_of(kind) then return nil end
	return { from = from, to = to, price = price }
end

-- The gun the mod checked (its global obj, input_function), else the first of that section the actor carries.
local function gun_of(section)
	local m = mod()
	local ok, mine = pcall(function()
		local o = m and m.obj
		if not (o and o:section() == section) then return nil end
		local parent = o:parent()
		return parent and parent:id() == db.actor:id() and o or nil
	end)
	if ok and mine then return mine end
	local ok2, o = pcall(function() return db.actor:object(section) end)
	return ok2 and o or nil
end

local function npc_of(first, second)
	local me = db.actor and db.actor:id()
	local ok1, id1 = pcall(function() return first:id() end)
	if ok1 and type(id1) == "number" and id1 ~= me then return first end
	local ok2, id2 = pcall(function() return second:id() end)
	if ok2 and type(id2) == "number" and id2 ~= me then return second end
	return nil
end

local function busy()
	return next(pend) ~= nil or xchg.busy(KIND)
end

local function start(kind, f, first, second)
	if busy() then
		stats.ignored = stats.ignored + 1
		if stats.ignored <= 3 or stats.ignored % 50 == 0 then
			log("an upgrade while another one is on its way: ignored (#%d)", stats.ignored)
		end
		return
	end
	local ok, e, calls = dry_run(f, first, second)
	if not ok then error(e, 0) end
	if #calls == 0 then return end -- the mod would do nothing: no money, no gun of the kind, worn parts
	local plan = plan_of(kind, calls)
	if not plan then
		stats.foreign = stats.foreign + 1
		log("! NimbleTrade.%s_requested does what this file does not know: left to the mod", kind)
		return f(first, second)
	end
	local gun = gun_of(plan.from)
	if not gun then return end
	local npc = npc_of(first, second)
	local op, origin = new_op(), coop_ops_done.origin(core.self_peer())
	if not op or origin == nil then return end
	local req = { o = op, a = origin, g = kind }
	pend[op] = { op = op, kind = kind, from = plan.from, to = plan.to, price = plan.price, w = gun:id(),
		n = npc and npc:id() or nil, req = req, next_at = time_global() + RETRY_MS }
	stats.asked = stats.asked + 1
	if coop_mode.decides_world() and coop_mode.actor_is_player() then
		-- the co-op host's own player: this process keeps the money and decides his map, the same functions, no wire
		return hold(req, core.self_peer(), on_hold_answer)
	end
	core.to_host(V_HOLD, req)
end

local function guard_action(kind, f)
	return function(first, second, ...)
		if not (core.active() and coop_mode.actor_is_player()) then return f(first, second, ...) end
		local ok, e = pcall(start, kind, f, first, second)
		if not ok then core.report("xchg_nimble", kind .. "_requested", e) end
	end
end

local installed = 0

local function install()
	local m = mod()
	if not m then return end
	for _, u in ipairs(UPGRADES) do
		local key = u.kind .. "_requested"
		if not orig[u.kind] then
			local ok, f = core.wrap(m, key, MOD .. "." .. key, function(fn) return guard_action(u.kind, fn) end)
			if ok then
				orig[u.kind] = f
				installed = installed + 1
			end
		end
	end
end

-------------------------------------------------------------------------------
-- Time, status, start
-------------------------------------------------------------------------------
local next_sweep = 0

local function actor_on_update()
	if not core.active() then return end
	local now = time_global()
	local me = core.self_peer()
	local origin = coop_ops_done.origin(me)
	if next(pend) and coop_mode.actor_is_player() then
		for _, p in pairs(pend) do
			if not p.applying and now >= p.next_at and p.req.a == origin then
				p.next_at = now + RETRY_MS
				stats.timeouts = stats.timeouts + 1
				if coop_mode.decides_world() then hold(p.req, me, on_hold_answer)
				else core.to_host(V_HOLD, p.req) end
			end
		end
	end
	if now < next_sweep then return end
	next_sweep = now + RETRY_MS
	if coop_mode.decides_world() then close_orphans() end
	if coop_mode.decides_world() and not coop_mode.leads_here() then
		for _, h in pairs(holds) do publish_hold(h) end
	end
	if coop_mode.leads_here() or coop_mode.decides_world() then
		for key, h in pairs(known) do
			local id = core.lid(h.origin)
			if h.state == "known" and id and not coop_mode.writes(id) then known[key] = nil end
		end
		for key, t in pairs(outgoing) do
			if send_done(t) then outgoing[key] = nil end
		end
	end
end

local function save_holds()
	return { holds = holds, known = known, floor = known_floor, outgoing = outgoing }
end

local function load_holds(t)
	holds, known, known_floor, outgoing = t.holds or {}, t.known or {}, t.floor or {}, t.outgoing or {}
end

local function status()
	local p, held, k = 0, 0, 0
	for _ in pairs(pend) do p = p + 1 end
	for _ in pairs(holds) do held = held + 1 end
	for _, v in pairs(known) do
		if v.state == "known" then k = k + 1 end
	end
	return string.format("upgrades asked %d (done %d, told a refusal %d, retries %d, presses ignored %d, left to the mod %d, "
		.. "late answers %d, pending %d) | holds %d (repeats %d, refused %d, poor %d, committed %d, refunded %d, "
		.. "duplicate or unknown results %d, dropped %d, given back with no player %d, taken again after a refund %d, "
		.. "open %d) | map step: applied %d, refused %d, without a hold %d, "
		.. "waiting %d | actions wrapped %d", stats.asked, stats.done, stats.told, stats.timeouts, stats.ignored,
		stats.foreign, stats.late, p, stats.held, stats.repeats, stats.refused, stats.poor, stats.committed, stats.refunded,
		stats.unknown, stats.dropped, stats.orphaned, stats.retaken, held, stats.applied, stats.apply_refused,
		stats.unpaid, k, installed)
end

-- on_game_start must not throw (axr_main runs every script's on_game_start in one unprotected loop)
function on_game_start()
	if not api then return end
	local ok_mod, has = pcall(function() return mod() ~= nil end)
	if not (ok_mod and has) then return end -- the mod is not installed: nothing to do
	local steps = {
		-- mods.nim_held is the world's word only; a relay must not make another process's copy look like it
		function()
			coop_world_events.reserve("mods." .. V_HELD)
			coop_world_events.reserve("mods." .. V_DONE_R)
		end,
		function() core.on(V_HOLD, hold_from_wire, "world") end,
		function() core.on(V_HOLD_R, function(t) on_hold_answer(t) end, "player") end,
		function() core.on(V_HELD, held_from_wire, "client") end,
		function() core.on(V_DONE, done_from_wire, "world") end,
		function() core.on(V_DONE_R, done_answer, "client") end,
		function() coop_ops_done.bind_state("nimble", save_holds, load_holds) end,
		function() coop_ops_done.listen("nimble", done_heard) end,
		function() core.set_limit(V_HOLD, 6, 1) end,
		function() core.set_limit(V_DONE, 60, 30) end,
		function() xchg.serve(KIND, SPEC) end,
		function() install() end,
		function() RegisterScriptCallback("actor_on_update", actor_on_update) end,
		function() core.status_line("xchg_nimble", status) end,
	}
	for i, step in ipairs(steps) do core.install("xchg_nimble", "start step " .. i, step) end
end
