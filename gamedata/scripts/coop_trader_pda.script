-- Personal and group numbers in the existing faction-goodwill cells; below the matrix the formula of the session rule
-- trader_rep and the nicks of the counted players; with "best", pointing at a group value shows whose value it is.
local api = rawget(_G, "coop")
local installed = false

local LEGEND = {
	best = "You / Grp: best player in game. Counted %d: %s",
	mean_online = "You / Grp: mean of the players in game. Counted %d: %s",
	mean_recent = "You / Grp: mean of the last 72 game hours. Counted %d: %s",
}

local function translated(id, fallback)
	local text = game.translate_string(id)
	if text == id then return fallback end
	return text
end

-- "a, b, c" within about 48 bytes, the rest as "+N" (the footer is one line of the 600-wide box)
local function name_list(names)
	if #names == 0 then return "-" end
	local out, used = {}, 0
	for i, name in ipairs(names) do
		if i > 1 and used + #name + 2 > 48 then
			return table.concat(out, ", ") .. " +" .. (#names - i + 1)
		end
		out[#out + 1] = name
		used = used + #name + 2
	end
	return table.concat(out, ", ")
end

-- The mark of the best player for the group cell under the cursor (mode best), or nil.
local function hover_text(window)
	local info = window.coop_goodwill_info
	if not (api and api.is_active() and info and info.mode == "best") then return nil end
	local pos = GetCursorPosition()
	for i, faction in ipairs(window.list or {}) do
		local cell = window.relations and window.relations[i] and window.relations[i][0]
		local who = info.top and info.top[faction]
		if cell and who then
			local rect = Frect():set(0, 0, 0, 0)
			cell:GetAbsoluteRect(rect)
			if utils_data.pos_in_rect(pos, rect) then
				return string.format(translated("st_coop_trader_pda_best", "Best value: %s"), who)
			end
		end
	end
end

function apply(window)
	local active = api and api.is_active()
	if window.coop_goodwill_note then window.coop_goodwill_note:Show(active == true) end
	if not active then return end
	local reputation = coop_trader_reputation
	reputation.refresh()
	if window.tab and not window.coop_goodwill_note then
		local note = CUITextWnd()
		note:SetWndPos(vector2():set(115, 437))
		note:SetWndSize(vector2():set(600, 18))
		note:SetFont(GetFontLetterica16Russian())
		note:SetTextColor(GetARGB(255, 170, 170, 170))
		window.tab:AttachChild(note)
		window.coop_goodwill_note = note
	end
	local participants = 0
	local players = rawget(_G, "coop_npc_players")
	local actor = players and players.own_actor and players.own_actor() or db.actor
	local actor_id = actor and actor:id() or AC_ID
	local routing = rawget(_G, "coop_reputation")
	local goodwill = routing and routing.goodwill_of or relation_registry.community_goodwill
	for i, faction in ipairs(window.list or {}) do
		local cell = window.relations and window.relations[i] and window.relations[i][0]
		if cell then
			local position = cell:GetWndPos()
			cell:SetWndPos(vector2():set(position.x, position.y + (cell:GetHeight() - 34) / 2))
			cell:SetWndSize(vector2():set(75, 34))
			cell:SetTextComplexMode(true)
			cell:SetFont(GetFontLetterica16Russian())
			local personal = goodwill(faction, actor_id)
			local color = personal >= 2000 and window.clr_green or personal >= 500 and window.clr_yellow or window.clr_red
			if color then cell:SetTextColor(color) end
			local value, count = reputation.average(faction)
			participants = count
			local average = "-"
			if type(value) == "number" and value == value and math.abs(value) < math.huge then
				-- The same integer units as personal goodwill; do not round up across a trader tier.
				average = string.format("%d", math.floor(value))
			end
			local text = game.translate_string("st_coop_trader_pda_value")
			if text == "st_coop_trader_pda_value" then text = "You %d\\nGrp %s" end
			cell:SetText(string.format(text, personal, average, count))
		end
		-- Stock autoupdate refreshes companions only. World relations can change while
		-- the matrix is open; refresh its text and color from the same current value.
		for k, community in ipairs(window.list or {}) do
			local world_cell = window.relations and window.relations[i] and window.relations[i][k]
			if world_cell and game_relations and relation_registry.community_relation then
				local value = relation_registry.community_relation(community, faction)
				local label, color = "st_goodwill_indifferent", window.clr_yellow
				if value >= game_relations.FRIENDS then label, color = "st_goodwill_friendly", window.clr_green
				elseif value <= game_relations.ENEMIES then label, color = "st_goodwill_enemy", window.clr_red end
				if color then world_cell:SetTextColor(color) end
				world_cell:SetText(window.to_text and game.translate_string(label) or tostring(value))
			end
		end
	end
	local info = reputation.info and reputation.info()
	window.coop_goodwill_info = info
	if window.coop_goodwill_note then
		local mode = info and LEGEND[info.mode] and info.mode or "best"
		local text = translated("st_coop_trader_pda_legend_" .. mode, LEGEND[mode])
		window.coop_goodwill_note:SetText(string.format(text, participants, name_list(info and info.names or {})))
	end
end

function on_game_start()
	if not api or installed then return end
	local ok, module = pcall(function() return ui_pda_relations_tab end)
	local class = ok and module and module.pda_relations_tab
	if not class then return end
	installed = true
	-- the stock Update hides the hint unless a companion icon is under the cursor: lend it the best player's mark
	local update = class.Update
	if type(update) == "function" then
		class.Update = function(self, ...)
			local ok, text = pcall(hover_text, self)
			local hint = self.hint_wnd
			if not (ok and text and hint) then return update(self, ...) end
			self.hint_wnd = setmetatable({ Update = function(_, txt) return hint:Update(txt or text) end }, { __index = hint })
			local result = { pcall(update, self, ...) }
			self.hint_wnd = hint
			if not result[1] then error(result[2], 0) end
			return unpack(result, 2)
		end
	end
	for _, name in ipairs({ "Reset", "autoupdate" }) do
		local original = class[name]
		if type(original) == "function" then
			class[name] = function(self, ...)
				original(self, ...)
				apply(self)
			end
		end
	end
end
