--[[
	Anomaly Coop - quests group core (gamedata\scripts\coop_quests_core.script), W4 "quests".

	Helpers shared by coop_tasks.script and the coop_quests_* scripts:
	  - roles and logging;
	  - ser()/des(): a safe codec for nested tables of strings, numbers and booleans (event payloads,
	    PDA infos, task offers). No code is ever loaded from the network;
	  - send()/on(): flat event payloads through coop_main.encode/decode, handlers wrapped in pcall;
	  - the group's characters on this machine and distances to them;
	  - host actions: a client asks the host to run a whitelisted world change for it (world spawns,
	    quest items taken from the group). The host runs it as that player (coop_tasks.run_as);
	  - condlist depth: true while xr_logic.pick_section_from_condlist runs (an effect fired by a
	    condlist, as opposed to a dialog action or a script call);
	  - with_actor(): per-call overrides of db.actor's methods. luabind looks into an object's own
	    Lua table before its class, so db.actor.position = f changes db.actor:position() for that
	    object only; the previous value is put back afterwards.
	Nothing here changes the game outside a co-op session.
--]]

local api = rawget(_G, "coop") -- engine namespace (nil on an exe without co-op)

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next
local string_format, table_concat = string.format, table.concat
local unpack = unpack

EVENT_PREFIX = "quests."
MAX_BLOB = 12000 -- characters of one serialized value inside an event (payload limit is 16 KiB)

-------------------------------------------------------------------------------
-- Roles, logging
-------------------------------------------------------------------------------
function engine() return api end

function active()
	if not api then return false end
	local ok, v = pcall(api.is_active)
	return ok and v == true
end
function is_host() return active() and api.is_host() == true end
-- F3a: a map server is no player: its logic is its level's (the stock effects run there), it asks nobody for them
function is_map_server() return active() and api.is_map_server ~= nil and api.is_map_server() == true end
function is_client() return active() and api.is_client() == true and not is_map_server() end
function client_live() return is_client() and api.is_live() == true end
-- This process's own actor is nobody (owner 2026-11-13): a world server whose seat plays no character (-coop_dedicated) and a map
-- server stand a ghost actor in their ALife. It is not listed, ranked, named or counted, and earns nothing. An ordinary host's actor is
-- the host player's character. Same rule as coop_npc_players.actor_is_nobody.
function actor_is_nobody()
	if not active() then return false end
	if is_map_server() then return true end
	local ok, yes = pcall(function() return api.is_dedicated ~= nil and api.is_dedicated() == true end)
	return ok and yes == true
end

function self_peer()
	if not api then return 0 end
	local ok, v = pcall(api.self_id)
	return ok and tonumber(v) or 0
end

function players()
	if not api then return {} end
	local ok, list = pcall(api.players)
	return ok and type(list) == "table" and list or {}
end

-- Nick of a player by peer (0 = the host), "#<peer>" when the engine does not list him (docs\MESSAGES.md).
function nick_of(peer)
	peer = tonumber(peer)
	if peer == nil then return nil end
	for _, p in ipairs(players()) do
		if p.id == peer and type(p.nick) == "string" and p.nick ~= "" then return p.nick end
	end
	return "#" .. tostring(peer)
end

-- The process that leads a level, with at least one other player connected: a map server's logic pays and takes as the host's does.
function host_party()
	if not (is_host() or is_map_server()) then return false end
	for _, p in ipairs(players()) do
		if not p.is_self then return true end
	end
	return false
end

function to_host_id(id)
	if not (api and api.to_host_id and type(id) == "number") then return id end
	return api.to_host_id(id) or id
end
function to_local_id(id)
	if not (api and api.to_local_id and type(id) == "number") then return id end
	return api.to_local_id(id) or id
end

local errors = 0
function log(tag, fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-quests][%s] %s", tostring(tag), ok and line or tostring(fmt))
end

function report(tag, what, err)
	errors = errors + 1
	if errors <= 20 or errors % 100 == 0 then
		log(tag, "! %s: %s", tostring(what), tostring(err))
	end
end

function error_count() return errors end

-- A script module by name; through _G so the engine loads a script not loaded yet (nil if absent).
function mod(name)
	local m = rawget(_G, name)
	if m == nil then
		local ok, v = pcall(function() return _G[name] end)
		m = ok and v or nil
	end
	return type(m) == "table" and m or nil
end

-------------------------------------------------------------------------------
-- Nested codec: s<len>:<bytes> | n<number>; | T | F | { key value ... }
-------------------------------------------------------------------------------
local MAX_DEPTH = 8

local function ser_into(v, out, depth)
	local tv = type(v)
	if tv == "string" then
		out[#out + 1] = "s" .. #v .. ":" .. v
	elseif tv == "number" then
		if v ~= v or v == math.huge or v == -math.huge then return false end
		out[#out + 1] = "n" .. string_format("%.17g", v) .. ";"
	elseif tv == "boolean" then
		out[#out + 1] = v and "T" or "F"
	elseif tv == "table" then
		if depth >= MAX_DEPTH then return false end
		out[#out + 1] = "{"
		for k, x in pairs(v) do
			local tk = type(k)
			if tk == "string" or tk == "number" then
				local mark = #out
				if not (ser_into(k, out, depth + 1) and ser_into(x, out, depth + 1)) then
					for i = #out, mark + 1, -1 do out[i] = nil end -- unsupported entry: dropped
				end
			end
		end
		out[#out + 1] = "}"
	else
		return false
	end
	return true
end

-- Value -> string, nil if the value itself cannot be encoded (functions, userdata). Table entries
-- holding unsupported values are left out.
function ser(v)
	local out = {}
	if not ser_into(v, out, 0) then return nil end
	return table_concat(out)
end

local function des_at(s, i, depth)
	local tag = s:sub(i, i)
	if tag == "s" then
		local colon = s:find(":", i + 1, true)
		if not colon then return nil end
		local len = tonumber(s:sub(i + 1, colon - 1))
		if not len or len < 0 or len % 1 ~= 0 or colon + len > #s then return nil end
		return s:sub(colon + 1, colon + len), colon + len + 1
	elseif tag == "n" then
		local semi = s:find(";", i + 1, true)
		if not semi then return nil end
		local n = tonumber(s:sub(i + 1, semi - 1))
		if not n or n ~= n then return nil end
		return n, semi + 1
	elseif tag == "T" then
		return true, i + 1
	elseif tag == "F" then
		return false, i + 1
	elseif tag == "{" then
		if depth >= MAX_DEPTH then return nil end
		local t = {}
		local j = i + 1
		while true do
			if j > #s then return nil end
			if s:sub(j, j) == "}" then return t, j + 1 end
			local k, nj = des_at(s, j, depth + 1)
			if k == nil or (type(k) ~= "string" and type(k) ~= "number") then return nil end
			local v, nj2 = des_at(s, nj, depth + 1)
			if v == nil then return nil end
			t[k] = v
			j = nj2
		end
	end
	return nil
end

-- String -> value, nil if malformed (network input). limit: the longest it takes.
function des(s, limit)
	if type(s) ~= "string" or s == "" or #s > (limit or 65536) then return nil end
	local ok, v, j = pcall(des_at, s, 1, 0)
	if not ok or v == nil or j ~= #s + 1 then return nil end
	return v
end

-------------------------------------------------------------------------------
-- Events
-------------------------------------------------------------------------------
local function cm() return rawget(_G, "coop_main") or coop_main end

function encode(t)
	local m = cm()
	return m and m.encode and m.encode(t) or ""
end

function decode(s)
	local m = cm()
	if not (m and m.decode) then return {} end
	local ok, t = pcall(m.decode, s)
	return ok and type(t) == "table" and t or {}
end

-- Flat table to a peer (0 host, -1/nil everybody). Returns true if it went out.
function send(name, t, target)
	if not api then return false end
	local payload = encode(t or {})
	if #payload > 15800 then
		report("core", "send " .. tostring(name), "payload too long (" .. #payload .. ")")
		return false
	end
	local ok, sent = pcall(api.send_event, EVENT_PREFIX .. name, payload, target)
	return ok and sent == true
end

-- fn(table, from_peer, raw_payload); errors are logged, never thrown into the network layer.
function on(name, fn, tag)
	local m = cm()
	if not (m and m.add_event_handler) then
		log("core", "! coop_main.add_event_handler not found: %s is not handled", name)
		return false
	end
	return m.add_event_handler(EVENT_PREFIX .. name, function(payload, from)
		local ok, err = pcall(fn, decode(payload), tonumber(from), payload)
		if not ok then report(tag or "event", name, err) end
	end)
end

-- What a player asks of the level he stands on: fn runs on its authority (coop_main.add_level_handler), from = he.
function on_level(name, fn, tag)
	local m = cm()
	if not (m and m.add_level_handler) then return on(name, fn, tag) end
	return m.add_level_handler(EVENT_PREFIX .. name, function(payload, from)
		local ok, err = pcall(fn, decode(payload), tonumber(from), payload)
		if not ok then report(tag or "event", name, err) end
	end)
end

-------------------------------------------------------------------------------
-- The group's characters on this machine
-------------------------------------------------------------------------------
-- { {obj, peer, self, id}, ... }: own actor first, then the other connected players' characters.
function characters()
	local out = {}
	local ghost = api and ((api.is_dedicated and api.is_dedicated()) or is_map_server()) -- the actor of a dedicated host or a map server is nobody's
	-- in a far view the actor of this machine stands elsewhere: coordinates of two levels mean nothing to each other
	if db and db.actor and not ghost and not far_seen() then out[1] = { obj = db.actor, peer = self_peer(), self = true, id = db.actor:id() } end
	if not active() then return out end
	for _, p in ipairs(players()) do
		if not p.is_self and p.avatar_id then
			local o = level.object_by_id(p.avatar_id)
			if o then out[#out + 1] = { obj = o, peer = p.id, id = p.avatar_id } end
		end
	end
	return out
end

-- A player on another level has no game object here. On the world server (and on every machine, each keeps the same registry) his
-- record stands for him: the map server of his level reports his place every second and every item that changes hands. far_body is
-- what the task code asks of a character, asked of those records. It also is a place for the stock create_item: { pos, lvid, gvid, id }.
local far_item_class = {}
far_item_class.__index = far_item_class
function far_item_class:id() return self.item_id end
function far_item_class:section() return self.item_section end
function far_item_class:condition() return self.item_condition end
function far_item_class:get_remaining_uses() return tonumber(ini_sys:r_float_ex(self.item_section, "max_uses")) or 1 end -- no record has them

-- What a record has no answer to goes where a stand-in of an NPC goes: coop_quests_far, a method nobody needed yet is logged once.
local far_body_class = {}
far_body_class.__index = function(_, k)
	local m = rawget(far_body_class, k)
	if m ~= nil then return m end
	local far = rawget(_G, "coop_quests_far") or coop_quests_far
	return far and far.fallback and far.fallback(k) or nil
end
function far_body_class:id() return self[4] end
function far_body_class:position() return self[1] end
function far_body_class:level_vertex_id() return self[2] end
function far_body_class:game_vertex_id() return self[3] end
function far_body_class:clsid() return clsid.script_stalker end -- the stock IsStalker and character_community ask this first
function far_body_class:character_community() return alife_object(self[4]):community() end
function far_body_class:character_rank() return alife_object(self[4]):rank() end
function far_body_class:alive()
	local se = alife_object(self[4])
	if not se then return false end
	local ok, v = pcall(se.alive, se)
	return not ok or v ~= false
end
function far_body_class:iterate_inventory(f, x)
	for _, it in ipairs(api.levels.carried(self[4])) do
		local item = setmetatable({ item_id = it.id, item_section = it.section, item_condition = it.condition }, far_item_class)
		if f(x, item) == true then return end
	end
end
function far_body_class:object(section)
	local found
	self:iterate_inventory(function(_, item)
		if item:section() == section then
			found = item
			return true
		end
	end, nil)
	return found
end
-- The record goes and a new item is made at the other end: this machine has no object of it to hand over.
function far_body_class:transfer_item(item, to)
	alife_release_id(item:id())
	-- as worn as the one that went: the stock pays a fetch task by the item's condition (tasks_fetch: cost * con^2), and a new
	-- whole item was paid as a new one (the quest audit, 2026-11-13)
	local cond = item:condition()
	itms_manager.create_item(item:section(), to, type(cond) == "number" and cond < 1 and { cond = cond } or nil)
end

function far_body(peer, avatar_id)
	local l = api and api.levels
	if not (l and l.split and l.split() == true and l.carried and type(avatar_id) == "number") then return nil end
	local mine, his = l.my_level(), l.level_of_player(peer)
	if mine == nil or his == nil or mine == his then return nil end
	local se = alife_object(avatar_id)
	if not se then return nil end
	return setmetatable({ se.position, se.m_level_vertex_id, se.m_game_vertex_id, avatar_id, far = true }, far_body_class)
end

-- A saved character still owns its rewards and goodwill when its player is disconnected.
function body_for_character(id)
	local se = alife_object(id)
	if not se then return nil end
	return setmetatable({ se.position, se.m_level_vertex_id, se.m_game_vertex_id, id, far = true }, far_body_class)
end

-- Every player's character wherever he stands: characters(), and a far_body for those on other levels.
function bodies()
	local out = characters()
	if not active() then return out end
	local seen = {}
	for _, c in ipairs(out) do seen[c.id] = true end
	for _, p in ipairs(players()) do
		if not p.is_self and p.avatar_id and not seen[p.avatar_id] then
			local far = far_body(p.id, p.avatar_id)
			if far then out[#out + 1] = { obj = far, peer = p.id, id = p.avatar_id } end
		end
	end
	return out
end

-- Object id -> true for every player character on this machine (own actor included).
function character_ids()
	local set = {}
	for _, c in ipairs(characters()) do set[c.id] = c end
	return set
end

function is_character_id(id)
	if type(id) ~= "number" then return false end
	if db and db.actor and id == db.actor:id() then return true end
	if not active() then return false end
	for _, p in ipairs(players()) do
		if p.avatar_id == id then return true end
	end
	return false
end

local function alive(o)
	local ok, v = pcall(function() return o:alive() end)
	return not ok or v ~= false
end

-- The living character nearest to pos: obj, peer, squared distance (flat = ignore height).
function nearest_character(pos, flat)
	if not pos then return nil end
	local best, best_peer, best_d
	for _, c in ipairs(characters()) do
		if alive(c.obj) then
			local p = c.obj:position()
			local dx, dz = p.x - pos.x, p.z - pos.z
			local d = dx * dx + dz * dz
			if not flat then
				local dy = p.y - pos.y
				d = d + dy * dy
			end
			if not best_d or d < best_d then best, best_peer, best_d = c.obj, c.peer, d end
		end
	end
	return best, best_peer, best_d
end

function min_dist_sqr(pos, flat)
	local _, _, d = nearest_character(pos, flat)
	return d
end

-- The player nearest to server object `se` among those on ITS level, wherever this machine stands: what nearest_character is with split
-- levels off. obj (a far_body for a player on another level), peer, squared distance; nil when nobody is on that level.
function nearest_body(se, flat)
	if not (se and se.position) then return nil end
	local l = api and api.levels
	if not (l and l.split and l.split() == true and se.m_game_vertex_id) then return nearest_character(se.position, flat) end
	local gg = game_graph()
	local lid = gg:vertex(se.m_game_vertex_id):level_id()
	local best, best_peer, best_d
	for _, c in ipairs(bodies()) do
		local ok, v = pcall(function() return gg:vertex(c.obj:game_vertex_id()):level_id() end)
		if ok and v == lid and alive(c.obj) then
			local p, pos = c.obj:position(), se.position
			local dx, dy, dz = p.x - pos.x, flat and 0 or p.y - pos.y, p.z - pos.z
			local d = dx * dx + dy * dy + dz * dz
			if not best_d or d < best_d then best, best_peer, best_d = c.obj, c.peer, d end
		end
	end
	return best, best_peer, best_d
end

-- Host: the online character of a peer (0 / own peer = db.actor).
function avatar_obj(peer)
	peer = tonumber(peer)
	if peer == nil then return nil end
	if peer == 0 or peer == self_peer() then return db.actor end
	if not api then return nil end
	local ok, id = pcall(api.avatar_of, peer)
	return ok and id and level.object_by_id(id) or nil
end

-------------------------------------------------------------------------------
-- The far view (coop_quests_far): what the stock reads of the level it stands on, for one call
-------------------------------------------------------------------------------
-- Installed when this script loads: before tasks_* do, one of them keeps level.object_by_id in a local. Out of a scope they are the stock's.
local far_view = nil
function set_far_view(view) far_view = view end
function far_seen() return far_view ~= nil end

-- A player who stands on another level than this process.
function is_far_peer(peer)
	local l = api and api.levels
	if not (l and l.split and l.split() == true and type(peer) == "number") then return false end
	local mine, his = l.my_level(), l.level_of_player(peer)
	return mine ~= nil and his ~= nil and mine ~= his
end

local function install_level_view()
	local lv = rawget(_G, "level")
	if type(lv) ~= "table" or rawget(lv, "_coop_far_view") then return end
	rawset(lv, "_coop_far_view", true)
	local object_by_id, name = lv.object_by_id, lv.name
	if type(object_by_id) == "function" then
		lv.object_by_id = function(id)
			if far_view then return far_view.object_by_id(id, object_by_id) end
			return object_by_id(id)
		end
	end
	if type(name) == "function" then
		lv.name = function()
			if far_view then return far_view.name end
			return name()
		end
	end
	local d = rawget(_G, "db")
	if d == nil then
		local ok, m = pcall(function() return _G.db end)
		d = ok and m or nil
	end
	if type(d) ~= "table" then return end
	if type(d.storage) == "table" and getmetatable(d.storage) == nil then
		setmetatable(d.storage, { __index = function(_, id)
			if far_view then return far_view.storage(id) end
			return nil
		end })
	end
	if type(d.zone_by_name) == "table" and getmetatable(d.zone_by_name) == nil then
		setmetatable(d.zone_by_name, { __index = function(_, zone)
			if far_view then return far_view.zone(zone) end
			return nil
		end })
	end
end

-- simulation_objects loads late: this one from on_game_start.
local function install_sim_view()
	local so = rawget(_G, "simulation_objects") or simulation_objects
	if type(so) ~= "table" or type(so.is_on_the_actor_level) ~= "function" or so._coop_far_view then return end
	so._coop_far_view = true
	local on_level = so.is_on_the_actor_level
	so.is_on_the_actor_level = function(se, ...)
		if far_view then return far_view.on_actor_level(se) end
		return on_level(se, ...)
	end
end

local function far_mod() return rawget(_G, "coop_quests_far") or coop_quests_far end

-- fn on the level of a player (coop_quests_far.with_level_of); the world server's own level, or no split levels: fn as it is.
function with_level_of(peer, fn, ...)
	local far = far_mod()
	if not far then return fn(...) end
	return far.with_level_of(peer, fn, ...)
end

-- fn on the level of a target, for a player who stands there; nobody there: on the level of peer.
function with_target(id, peer, what, fn, ...)
	local far = far_mod()
	if not far then return fn(...) end
	return far.with_target(id, peer, what, fn, ...)
end

function at_home(fn, ...)
	local far = far_mod()
	if not far then return fn(...) end
	return far.at_home(fn, ...)
end

-- A squad a map server holds: with split levels off nothing is.
function held_there(se)
	local l = api and api.levels
	if not (se and se.online and se.m_game_vertex_id and l and l.split and l.split() == true) then return false end
	return game_graph():vertex(se.m_game_vertex_id):level_id() ~= l.my_level()
end

-- The smart's field, seen from where the far view stands (a rewrite of the task scripts' `smart.online`).
function online_of(se)
	if not se then return false end
	if far_view then return far_view.online(se) end
	return se.online
end

-------------------------------------------------------------------------------
-- db.actor method overrides for one call
-------------------------------------------------------------------------------
-- fields: { method_name = function(self, ...) }. Returns ok, results of fn.
function with_actor(fields, fn, ...)
	local a = db and db.actor
	if not a then return pcall(fn, ...) end
	local saved = {}
	for k, f in pairs(fields) do
		saved[k] = a[k]
		a[k] = f
	end
	local res = { pcall(fn, ...) }
	for k in pairs(fields) do a[k] = saved[k] end
	return unpack(res)
end

-------------------------------------------------------------------------------
-- Condlist depth
-------------------------------------------------------------------------------
local condlist_depth = 0
local holding_infos = false
function in_condlist() return condlist_depth > 0 end

-- Client, a condlist that runs a host-only world effect (a squad, a spawn) the client cannot make: the
-- info portions it gives are kept on this machine (its own latch, so it does not fire again) and not
-- sent to the host, whose own run of the same logic must still find its gate open and make the world
-- change (xrRazom xrr_suppress_condlist_info_sync). Needs the engine side (coop.story_hold_infos);
-- without it nothing changes. Decided when the outermost condlist starts (a "+info" may come before the
-- effect), released when it returns.
local hold_effects = {}
function add_hold_effects(names)
	for _, n in ipairs(names or {}) do hold_effects[n] = true end
end

-- condlist = parse_condlist() result: { {section, checks, sets}, ... }, sets = { {name, kind, params} }
local function wants_hold(condlist)
	if type(condlist) ~= "table" then return false end
	for i = 1, #condlist do
		local sets = type(condlist[i]) == "table" and condlist[i][3]
		if type(sets) == "table" then
			for j = 1, #sets do
				local s = sets[j]
				if type(s) == "table" and (s[2] == 3 or s[2] == 4) and hold_effects[s[1]] then return true end
			end
		end
	end
	return false
end

local function install_condlist_tracker()
	local xl = rawget(_G, "xr_logic") or xr_logic
	if not (xl and type(xl.pick_section_from_condlist) == "function") then
		log("core", "! xr_logic.pick_section_from_condlist not found: condlist effects are not told apart")
		return
	end
	local orig = xl.pick_section_from_condlist
	-- hot path (every condlist of every NPC on the host): fixed signature, no table per call; the stock
	-- function returns one value (W5)
	xl.pick_section_from_condlist = function(obj, npc, condlist, ...)
		if not active() then return orig(obj, npc, condlist, ...) end
		if condlist_depth == 0 and not holding_infos and api.story_hold_infos and is_client()
			and wants_hold(condlist) then
			local okh, held = pcall(api.story_hold_infos, true)
			holding_infos = okh and held == true
		end
		condlist_depth = condlist_depth + 1
		local ok, r = pcall(orig, obj, npc, condlist, ...)
		condlist_depth = condlist_depth - 1
		if condlist_depth == 0 and holding_infos then
			holding_infos = false
			pcall(api.story_hold_infos, false)
		end
		if not ok then
			-- live 2026-11-01: the task list opened on a client, a mod's condition asked for the host's simulation. What a client
			-- reads here decides nothing: it is no reason to end his game.
			if not is_client() then error(r, 0) end
			report("core", "a condlist on a client", r)
			return nil
		end
		return r
	end
end

-------------------------------------------------------------------------------
-- Host actions
-------------------------------------------------------------------------------
local actions = {} -- name -> fn(from_peer, table)
local action_stats = { out = 0, in_ = 0, refused = 0 }

-- Host side: fn(from, t) runs inside coop_tasks.run_as(from) (task gives / turn-ins are that player's).
function register_host_action(name, fn)
	if type(name) == "string" and type(fn) == "function" then actions[name] = fn end
end

-- Client side: t is a flat table of scalars (field "a" is reserved).
function request_host_action(name, t)
	t = t or {}
	t.a = name
	local ok = send("act", t, 0)
	if ok then action_stats.out = action_stats.out + 1 end
	return ok
end

-- What touches a live NPC or a box of the player's level: its authority runs these (split levels). The rest stays here under the far view:
-- their data is the save's (xr_bribe, the guide, the stash tables). trade: the stock of an ordinary stalker comes into the NPC there.
local LEVEL_ACTIONS = { box = true, trade = true }

local function host_on_action(t, from)
	if is_map_server() and from == 0 then
		from = tonumber(t._peer)
		t._peer = nil
	elseif not is_host() or type(from) ~= "number" or from == 0 then
		return
	elseif LEVEL_ACTIONS[t.a] then
		local l = api.levels
		local bridge = l and l.split and l.split() == true and l.bridge_of_player and l.bridge_of_player(from)
		if bridge then
			t._peer = from
			send("act", t, bridge)
			return
		end
	end
	if not from then return end
	local fn = type(t.a) == "string" and actions[t.a]
	if not fn then
		action_stats.refused = action_stats.refused + 1
		log("core", "! unknown host action from #%s: %s", tostring(from), tostring(t.a))
		return
	end
	action_stats.in_ = action_stats.in_ + 1
	local ct = rawget(_G, "coop_tasks") or coop_tasks
	local ok, err
	-- what a player on another level asks of the world server runs here, on his level as the far view shows it
	if ct and ct.run_as then
		ok, err = pcall(with_level_of, from, ct.run_as, from, fn, from, t)
	else
		ok, err = pcall(with_level_of, from, fn, from, t)
	end
	if not ok then report("core", "host action " .. tostring(t.a), err) end
end

-------------------------------------------------------------------------------
-- Status, start
-------------------------------------------------------------------------------
function print_status()
	local n = 0
	for _ in pairs(actions) do n = n + 1 end
	log("core", "host actions: %d registered, sent %d, run %d, refused %d | lua errors %d",
		n, action_stats.out, action_stats.in_, action_stats.refused, errors)
	for _, name in ipairs({ "coop_quests_offer", "coop_quests_party", "coop_quests_story", "coop_quests_missions", "coop_quests_pda", "coop_quests_news", "coop_quests_far" }) do
		local m = rawget(_G, name)
		if type(m) == "table" and type(m.print_status) == "function" then
			local ok, err = pcall(m.print_status)
			if not ok then report("core", name .. ".print_status", err) end
		end
	end
end

local started = false
-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included (W5).
local function start_step(what, f)
	local ok, err = pcall(f)
	if not ok then printf("! [coop_quests_core] %s failed: %s", what, tostring(err)) end
end

if api then
	local ok, err = pcall(install_level_view)
	if not ok then printf("! [coop_quests_core] the far view: %s", tostring(err)) end
end

function on_game_start()
	if not api or started then return end
	started = true
	start_step("install_condlist_tracker", install_condlist_tracker)
	start_step("install_sim_view", install_sim_view)
	on("act", host_on_action, "core")
end
