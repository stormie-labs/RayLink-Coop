--[[
	Anomaly Coop - per-player m_data of third-party mods (gamedata\scripts\coop_mods_pdata.script).

	A client never saves (R-9.2) and loads the HOST's save, so a mod that keeps the player's progress in the
	script storage (XP, skills, worn devices, wheel layout, perk cooldowns ...) would show the host's progress on
	every client and forget the client's own. For the keys registered here:

	  Host:   keeps every player's values in its own save, m_data.coop_mods_pdata["<character id>"] =
	          { t = token, d = { [key] = value }, progress_checked = keeper snapshot }, written on mods.pd (chunked).
	          The host answers with mods.pd_ack { t = token }. For each clamped key it first sends
	          mods.pd_fix { k = key, v = serialized value }, or mods.prg_pd_fix_big for a chunked correction.
	          The host's own values stay where the mod keeps them.
	  Client: right after the save is read (alife_storage_manager.on_before_load_state, before any load_state
	          callback) the registered keys are replaced with this player's values: the session stash
	          (coop.stash, newer, survives level changes) when it builds on the host's record, otherwise the
	          record from the save, otherwise nothing (a new player starts the mod fresh). Then every 15 s the
	          client asks the listed modules to refresh their keys (module.save_state, if they have one) and
	          sends the keys to the host when they changed.
	  Keys with `subs` travel only partly (the rest of the table is world state and stays the host's).
	  Everything a client has comes through a transition exactly as in a usual game. The 15 s report alone leaves a window:
	  what changed in the seconds before a level change would come back as it was at the last report. The engine says when a load that continues this world starts, while the old world is still up
	  (coop_main.on_world_leaving -> keep_for_load): the keys go into the stash as they are that moment, under the
	  token "@load:<epoch of the new world>", and the load reads them back in that world whatever token the host's
	  record has. Nothing is sent then: the host is saving already.

	Single player and the host's own data are untouched.

	API (call from on_game_start, before the save is read):
	  coop_mods_pdata.register(key, { subs = {..} | nil, prime = { "module", ... } | nil, get = function | nil })
	  coop_mods_pdata.owns(key) -> true when this file carries the key (other per-player channels skip it)
--]]

local api = rawget(_G, "coop")

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local STORE = "coop_mods_pdata" -- host m_data key
local STASH = "coop_mods_pdata" -- client session stash key
local REPORT_MS = 15000
local LOAD_TOKEN = "@load:" -- the stash token of a state kept for one load: "@load:<epoch>|<data>"
local KEPT_MS = 180000 -- a state kept for a load whose world never came (a transition called off): the reports go on after this
local AVATAR_SECTION = "coop_player_avatar"

local keys = {} -- key -> { subs = list|nil, prime = list|nil }
local order = {}

local st = { token = nil, last = nil, next_report = 0, applied = 0, sent = 0, acks = 0, stored = 0, refused = 0,
	kept = false, kept_at = 0, keeps = 0, -- kept: the stash holds the state a load starts with, nothing may replace it in this world
	foreign = false } -- the restore of this world failed: the registered keys are still the HOST's, never to be reported as mine

local core = coop_mods_core

local function log(fmt, ...) core.log("pdata", fmt, ...) end

function register(key, opts)
	if type(key) ~= "string" or key == "" or key == STORE then return false end
	opts = type(opts) == "table" and opts or {}
	if not keys[key] then order[#order + 1] = key end
	keys[key] = {
		subs = type(opts.subs) == "table" and opts.subs or nil,
		prime = type(opts.prime) == "table" and opts.prime or nil,
		get = type(opts.get) == "function" and opts.get or nil, -- current value when the mod keeps it elsewhere
	}
	return true
end

function owns(key)
	return keys[key] ~= nil
end

-- Registers every top-level key a module's save_state writes, found by running it on a scratch table at
-- start (for mods that keep only the player's own records and whose key names are not known here).
function register_module(name)
	local M = core.mod(name)
	local f = M and core.fn(M, "save_state")
	if not f then return 0 end
	local scratch = {}
	local ok = pcall(f, scratch)
	if not ok then return 0 end
	local n = 0
	for k in pairs(scratch) do
		if type(k) == "string" and register(k, { prime = { name } }) then n = n + 1 end
	end
	return n
end

function registered()
	return order
end

-------------------------------------------------------------------------------
-- Client: restore at load, report on change
-------------------------------------------------------------------------------
local function world_epoch()
	if not (api and api.world_epoch) then return nil end
	local ok, e = pcall(api.world_epoch)
	return ok and tonumber(e) or nil
end

-- The session stash, when it is this player's newer state: the data, and "load" when it was kept at the start of this load.
local function stash_data(saved_token)
	if not api then return nil end
	local ok, s = pcall(api.stash_get, STASH)
	if not (ok and type(s) == "string") then return nil end
	local tok, body = s:match("^([^|]*)|(.*)$")
	if not tok then return nil end
	local kept_for = tok:match("^@load:(%d+)$")
	if kept_for then
		-- kept by keep_for_load: the player's state the moment he left the old world. It is read in the world it was kept
		-- for and nowhere else (the host loaded a save meanwhile: that world does not continue the one he left).
		local d = tonumber(kept_for) == world_epoch() and core.deser(body) or nil
		if type(d) ~= "table" then
			pcall(api.stash_set, STASH, nil)
			return nil
		end
		pcall(api.stash_set, STASH, (saved_token or "") .. "|" .. body) -- from now on it builds on the save's record
		return d, "load"
	end
	if tok ~= (saved_token or "") then return nil end
	local d = core.deser(body)
	return type(d) == "table" and d or nil
end

-- m = the client's freshly read script storage (the host's save).
function apply_loaded(m)
	if type(m) ~= "table" or #order == 0 then
		if type(m) == "table" then m[STORE] = nil end
		return
	end
	local my = core.hid(0)
	if type(my) ~= "number" or my == 0 then
		log("! own character id unknown: per-player mod data not restored")
		m[STORE] = nil
		-- The keys stay the host's then, and a report (or a state kept for a load) would write the
		-- host's values into this player's record. Nothing of this world is reported.
		st.foreign = true
		return
	end
	st.foreign = false
	local store = type(m[STORE]) == "table" and m[STORE] or {}
	local rec = store[tostring(my)]
	local saved_token = type(rec) == "table" and type(rec.t) == "string" and rec.t or nil
	local data = type(rec) == "table" and type(rec.d) == "table" and rec.d or {}
	local fresher, kept = stash_data(saved_token)
	local src = fresher and (kept and "this load (kept as he left)" or "session") or (rec and "host save" or "none (new player)")
	data = fresher or data
	for _, key in ipairs(order) do
		local spec, v = keys[key], data[key]
		if spec.subs then
			local live = m[key]
			if type(live) ~= "table" then
				live = {}
				m[key] = live
			end
			local from = type(v) == "table" and v or {}
			for _, sk in ipairs(spec.subs) do live[sk] = from[sk] end
		else
			m[key] = v
		end
	end
	m[STORE] = nil -- other players' records are the host's business
	st.token = saved_token
	st.kept = false -- a new world: the reports go on
	-- and its first report goes even when it equals the last one sent: that one may have been dropped (b57i Server
	-- allymark: sent the moment before the trip, the world had the peer joining again), and the world's record would miss it.
	st.last = nil
	st.applied = st.applied + 1
	log("restored %d key(s) for character %d from %s", #order, my, src)
end

local function collect()
	local m = alife_storage_manager.get_state()
	local primed = {}
	for _, key in ipairs(order) do
		for _, name in ipairs(keys[key].prime or {}) do
			if not primed[name] then
				primed[name] = true
				local M = core.mod(name)
				local f = M and core.fn(M, "save_state")
				if f then
					local ok, e = pcall(f, m)
					if not ok then core.report("pdata", name .. ".save_state", e) end
				end
			end
		end
	end
	for _, key in ipairs(order) do
		local get = keys[key].get
		if get then
			local ok, v = pcall(get)
			if ok and v ~= nil then m[key] = v end
		end
	end
	local d = {}
	for _, key in ipairs(order) do
		local v, subs = m[key], keys[key].subs
		if subs and type(v) == "table" then
			local t = {}
			for _, sk in ipairs(subs) do t[sk] = v[sk] end
			v = t
		end
		d[key] = v
	end
	return d
end

local function client_report(force)
	if #order == 0 or st.foreign or not core.live_client() then return end
	if st.kept then
		if time_global() - st.kept_at < KEPT_MS then return end
		st.kept = false -- the load it was kept for never came: this world goes on, and so do its reports
	end
	local tg = time_global()
	if not force and tg < st.next_report then return end
	st.next_report = tg + REPORT_MS
	local s, why = core.ser(collect())
	if not s then
		core.report("pdata", "serialize", why)
		return
	end
	if s == st.last then return end
	if core.send_big("pd", s, 0) then
		st.last = s
		st.sent = st.sent + 1
	end
	pcall(api.stash_set, STASH, (st.token or "") .. "|" .. s)
end

-- Client: report now, when a mod's values just changed and must survive a level change in the next seconds (Body Health
-- System, coop_mods_misc). The same report as every 15 s: sent only when it differs, into the session stash too.
function report_now()
	client_report(true)
end

-- Client, the engine's word that a load continuing this world starts (coop_main.on_world_leaving; the old world and the
-- actor are still up): the keys as they are now, kept for the world of `epoch`. Not sent: the host is saving already, and
-- its record is not what this load reads.
function keep_for_load(epoch)
	epoch = tonumber(epoch)
	if #order == 0 or not epoch or st.foreign or not core.live_client() then return false end
	local s, why = core.ser(collect())
	if not s then
		core.report("pdata", "serialize", why)
		return false
	end
	local ok, done = pcall(api.stash_set, STASH, LOAD_TOKEN .. string.format("%d", epoch) .. "|" .. s)
	if not (ok and done) then
		log("! the state for the load was not kept (the stash refused %d bytes): the last report is used", #s)
		return false
	end
	st.kept = true
	st.kept_at = time_global()
	st.keeps = st.keeps + 1
	log("kept %d key(s) for the load into the world of epoch %d (%d bytes)", #order, epoch, #s)
	return true
end

local function on_ack(t, from)
	if type(t.t) ~= "string" or #t.t > 64 then return end
	st.token = t.t
	st.acks = st.acks + 1
	if st.kept then return end -- the stash holds the state the load starts with: an older report must not replace it
	if st.last then pcall(api.stash_set, STASH, t.t .. "|" .. st.last) end
end

local function patch_report(s, key, value)
	local data = s and core.deser(s)
	if type(data) ~= "table" then return nil end
	data[key] = value
	return core.ser(data)
end

local function tracker_local_id(id, names)
	if type(id) ~= "number" or id < 0 or id >= 65535 or id ~= math.floor(id) then return nil end
	local lid = core.lid(id)
	local obj = lid and level.object_by_id(lid)
	if obj and (type(names) ~= "table" or names[id] ~= obj:name()) then return nil end
	return lid
end

local function fix_tracker(value)
	local tracker = core.mod("ish_kill_tracker")
	local load = core.fn(tracker, "load_state")
	if not load then return end
	local data = type(value) == "table" and value or {}
	local meta = type(data._coop_pda_ids) == "table" and data._coop_pda_ids or {}
	local bodies = {}
	if type(data.tracked_bodies) == "table" then
		for id, row in pairs(data.tracked_bodies) do
			local lid = tracker_local_id(id, meta.body)
			if lid and type(row) == "table" then
				local local_row = {}
				for k, v in pairs(row) do local_row[k] = v end
				local_row.id = lid
				local_row.killer_id = tracker_local_id(row.killer_id, meta.killer)
				bodies[lid] = local_row
			end
		end
	end
	-- The tracker loader merges rows. A correction replaces the history,
	-- including when it clears every row. Leave the PDA's other live keys alone.
	local previous = tracker.tracked_bodies
	tracker.tracked_bodies = {}
	if not pcall(load, { milpda = { tracked_bodies = bodies } }) then
		tracker.tracked_bodies = previous
		log("! progress correction could not load the kill tracker")
	end
end

local function apply_fix(t, from)
	if from ~= 0 or st.foreign or not coop_mode.is_player_mirror() then return end
	local key = t.k
	local spec = type(key) == "string" and keys[key]
	if not spec or type(t.v) ~= "string" then return end
	local value, why = core.deser(t.v)
	if why then return end

	local m = alife_storage_manager.get_state()
	if spec.subs then
		local live = type(m[key]) == "table" and m[key] or {}
		local corrected = type(value) == "table" and value or {}
		for _, sub in ipairs(spec.subs) do live[sub] = corrected[sub] end
		m[key] = live
	else
		m[key] = value
	end
	if key == "milpda" then
		fix_tracker(value)
	else
		for _, name in ipairs(spec.prime or {}) do
			local mod = core.mod(name)
			local load = core.fn(mod, "load_state")
			if load and not pcall(load, m) then log("! progress correction could not load the mod") end
			if name == "haru_skills" then
				-- The load path sets skills_levels; on_game_load also rebuilds the live bonuses and defaults.
				local rebuild = core.fn(mod, "on_game_load")
				if rebuild and not pcall(rebuild) then log("! progress correction could not rebuild Haru bonuses") end
			end
		end
	end

	-- Patch the sent snapshot and also the stash, which may hold a newer
	-- snapshot kept for an imminent load. Keep that snapshot's own token.
	st.last = patch_report(st.last, key, value) or st.last
	local ok, saved = pcall(api.stash_get, STASH)
	local token, body
	if ok and type(saved) == "string" then token, body = saved:match("^([^|]*)|(.*)$") end
	local corrected = patch_report(body, key, value)
	if corrected then
		pcall(api.stash_set, STASH, token .. "|" .. corrected)
	elseif not st.kept then
		local encoded = st.last or core.ser({ [key] = value })
		if encoded then pcall(api.stash_set, STASH, (st.token or "") .. "|" .. encoded) end
	end
end

local function apply_big_fix(s, from)
	if from ~= 0 then return end
	local t = core.deser(s)
	if type(t) == "table" then apply_fix(t, from) end
end

-------------------------------------------------------------------------------
-- Host: store reports in the save
-------------------------------------------------------------------------------
local function send_fix(peer, fix)
	local encoded = core.ser(fix.v)
	if not encoded then return end
	local t = { k = fix.k, v = encoded }
	-- A flat event codec may triple the bytes; send bigger values in chunks.
	if #encoded <= 4800 then
		core.to_peer(peer, "pd_fix", t)
	else
		local big = core.ser(t)
		if big then core.send_big("prg_pd_fix_big", big, peer) end
	end
end

local function host_store(s, from)
	local pid = api.avatar_of(from)
	local d = core.deser(s)
	local valid = type(pid) == "number" and pid > 0 and pid < 65535 and pid == math.floor(pid)
		and type(d) == "table"
	if not coop_trust.pass("progress_pdata", valid, "invalid pdata envelope or character") or not valid then
		st.refused = st.refused + 1
		return
	end
	local clean = {}
	for k, v in pairs(d) do
		if keys[k] then clean[k] = v end
	end
	local m = alife_storage_manager.get_state()
	if type(m[STORE]) ~= "table" then m[STORE] = {} end
	local previous = m[STORE][tostring(pid)]
	local progress = coop_progress_check
	local fixes
	clean, fixes = progress.filter(pid, from, clean, type(previous) == "table" and previous or nil)
	local tok = string.format("%x%x", math.random(1, 0x7fffffff), time_global() % 0x10000)
	m[STORE][tostring(pid)] = { t = tok, d = clean, progress_checked = progress.snapshot(pid) }
	st.stored = st.stored + 1
	for _, fix in ipairs(fixes) do send_fix(from, fix) end
	core.to_peer(from, "pd_ack", { t = tok })
end

-- Refresh progress at save time: observations may have arrived since the last pdata report.
local function host_save_state(m)
	if not (core.active() and coop_mode.decides_world() and type(m) == "table" and type(m[STORE]) == "table") then return end
	for k, record in pairs(m[STORE]) do
		local id = tonumber(k)
		local se = id and id < 65535 and alife_object(id)
		if not (se and se:section_name() == AVATAR_SECTION) then
			m[STORE][k] = nil
		elseif type(record) == "table" then
			record.progress_checked = coop_progress_check.snapshot(id) or record.progress_checked
		end
	end
end

-------------------------------------------------------------------------------
-- Wiring
-------------------------------------------------------------------------------
local function actor_on_update()
	if core.is_client() then client_report(false) end
end

local function install_load_hook()
	local asm = core.mod("alife_storage_manager")
	return core.wrap(asm, "on_before_load_state", "alife_storage_manager.on_before_load_state", function(orig)
		return function(...)
			local r = orig(...)
			if core.world_client() then
				local ok, e = pcall(apply_loaded, alife_storage_manager.get_state())
				if not ok then core.report("pdata", "restore", e) end
			end
			return r
		end
	end)
end

function status()
	return string.format("%d key(s) [%s] | client: restored %d, reports %d, acks %d, kept for a load %d, token %s | host: stored %d, refused %d, repeated progress audits %d",
		#order, table.concat(order, " "), st.applied, st.sent, st.acks, st.keeps, tostring(st.token), st.stored, st.refused,
		coop_progress_check.repeated_log_audits())
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included.
function on_game_start()
	if not api then return end
	core.install("pdata", "install_load_hook", install_load_hook)
	core.on_big("pd", host_store, "world")
	core.on("pd_ack", on_ack, "client")
	core.install("pdata", "pd_fix", function() core.on("pd_fix", apply_fix, "player") end)
	core.install("pdata", "prg_pd_fix_big", function() core.on_big("prg_pd_fix_big", apply_big_fix, "player") end)
	core.set_limit("pd", 70, 8)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("save_state", host_save_state)
	core.status_line("pdata", status)
end
