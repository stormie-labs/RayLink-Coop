-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - combat perks of third-party mods (gamedata\scripts\coop_mods_perks.script).

	Perk-Based Artefacts (perk_based_artefacts) and Haru's Skill System (haru_skills) read the belt and the skills
	of `db.actor`, the player of THIS machine. In a session a client's shot is applied on the host, where db.actor is
	the host's character, so without this file the host's artefacts and skills would boost a client's damage and the
	host would gain skill experience for it.

	Host:   a hit whose draftsman is another player's character, and a death caused by one, skip the host's own perk
	        and skill handlers (the shooter's perks belong to the shooter's machine, see Requests: the client should
	        raise its own before-hit handlers before it forwards a hit). A client's death perks ask for their world
	        part (loot and meat next to the corpse, the corpse removed or blown up) with mods.pba_corpse; the host
	        checks that this player killed the creature, that it is the first request for it and that every
	        section is one the perk tables name.
	Client: death perks of a creature this player killed run here with this player's belt. World spawns and the
	        corpse release they make are collected instead of being refused by the engine, and sent to the host.
	Per player: perk_based_artefacts_cooldowns, skills_levels (coop_mods_pdata).
--]]

local api = rawget(_G, "coop")

local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

local core = coop_mods_core
local pdata = coop_mods_pdata
local function log(fmt, ...) core.log("perks", fmt, ...) end

local MAX_SECTIONS = 25
local EXTRA_SECTIONS = { "ied_new_blow" } -- created by a perk's code, not named in its tables

local st = { skipped_hits = 0, skipped_deaths = 0, corpse_out = 0, corpse_in = 0, corpse_refused = 0 }
local installed = {}

local function remote_drafts(s_hit)
	local ok, id = pcall(function() return s_hit.draftsman:id() end)
	return ok and core.is_remote_player(id)
end

local function remote_who(who)
	local ok, id = pcall(function() return who:id() end)
	return ok and core.is_remote_player(id)
end

local function own_who(who)
	local ok, id = pcall(function() return who:id() end)
	return ok and id == 0
end

-------------------------------------------------------------------------------
-- Haru's skills
-------------------------------------------------------------------------------
local skills_orig, skills_wrapper = nil, nil

local function install_skills()
	local hs = core.mod("haru_skills")
	if not hs then return end
	pdata.register("skills_levels", { prime = { "haru_skills" } })
	local ok, orig = core.wrap(hs, "creature_on_before_hit", "haru_skills.creature_on_before_hit", function(orig)
		return function(npc, s_hit, ...)
			if core.active() and coop_mode.leads_here() and s_hit and remote_drafts(s_hit) then
				st.skipped_hits = st.skipped_hits + 1
				return
			end
			return orig(npc, s_hit, ...)
		end
	end)
	if ok then
		skills_orig, skills_wrapper = orig, hs.creature_on_before_hit
		installed[#installed + 1] = "haru_skills"
	end
end

-- After every on_game_start: the mod may have registered the original by value.
local function rebind_skills()
	if not skills_wrapper then return end
	for _, name in ipairs({ "npc_on_before_hit", "monster_on_before_hit" }) do
		core.swap_callback(name, skills_orig, skills_wrapper)
	end
end

-------------------------------------------------------------------------------
-- Perk-Based Artefacts
-------------------------------------------------------------------------------
local allowed = nil -- host: sections a death perk may ask for

local function collect_sections(t, out, depth)
	if depth > 4 then return end
	for _, v in pairs(t) do
		if type(v) == "string" then
			if #v < 128 and ini_sys:section_exist(v) then out[v] = true end
		elseif type(v) == "table" then
			collect_sections(v, out, depth + 1)
		end
	end
end

local function allowed_sections()
	if allowed then return allowed end
	allowed = {}
	local pba = core.mod("perk_based_artefacts")
	if pba and type(pba.artefact_props) == "table" then
		local ok, e = pcall(collect_sections, pba.artefact_props, allowed, 0)
		if not ok then core.report("perks", "section list", e) end
	end
	for _, s in ipairs(EXTRA_SECTIONS) do
		if ini_sys:section_exist(s) then allowed[s] = true end
	end
	return allowed
end

local function is_before_hit(pba, tbl)
	return tbl ~= nil and (tbl == pba.artefact_on_npc_before_hit_functions or tbl == pba.artefact_on_monster_before_hit_functions)
end

local function is_death(pba, tbl)
	return tbl ~= nil and (tbl == pba.artefact_on_npc_death_functions or tbl == pba.artefact_on_monster_death_functions)
end

-- Compile ONLY the affected function, preserving its environment and captured values. Rerunning PBA or Momopate
-- would repeat their load-time patches of other mods. Unknown versions keep the original and are reported.
-- Outside a session (and on the decider) the wrapper calls that original unchanged.
local function death_rewrite(tbl, key, label, changes)
	local orig = core.fn(tbl, key)
	local info = orig and debug.getinfo(orig, "S")
	local file = info and info.source:match("([^/\\@]+%.script)$")
	if file ~= "perk_based_artefacts.script" and file ~= "momopate_pba_tweaks.script" then return end
	local fs = getFS()
	local path = fs:update_path("$game_scripts$", file)
	local fh = path and io.open(path, "rb")
	if not fh then log("rewrite %s skipped: no loose source", label); return end
	local lines, n = {}, 0
	for line in fh:lines() do
		n = n + 1
		if n >= info.linedefined and n <= info.lastlinedefined then lines[#lines + 1] = line:gsub("\r$", "") end
		if n >= info.lastlinedefined then break end
	end
	fh:close()
	local text = table.concat(lines, "\n")
	local first = text:find("function%s*%(")
	if not first then log("rewrite %s skipped: no function body", label); return end
	text = text:sub(first):gsub(",%s*$", "")
	for _, change in ipairs(changes) do
		local a, b = text:find(change[1], 1, true)
		if not a or text:find(change[1], b + 1, true) then
			log("rewrite %s skipped: changed mod function", label)
			return
		end
		text = text:sub(1, a - 1) .. change[2] .. text:sub(b + 1)
	end
	local names, values = {}, {}
	for i = 1, 255 do
		local name, value = debug.getupvalue(orig, i)
		if not name then break end
		names[#names + 1], values[name] = name, { value }
	end
	local decl = #names > 0 and ("local " .. table.concat(names, ",") .. "; ") or ""
	local chunk, err = loadstring(string.rep("\n", info.linedefined - 1) .. decl .. "return " .. text, info.source)
	if not chunk then core.report("perks", label, err); return end
	setfenv(chunk, getfenv(orig))
	local fixed = chunk()
	for i = 1, 255 do
		local name = debug.getupvalue(fixed, i)
		if not name then break end
		if values[name] then debug.setupvalue(fixed, i, values[name][1]) end
	end
	core.wrap(tbl, key, label, function(original)
		return function(...)
			if core.active() and coop_mode.is_player_mirror() then return fixed(...) end
			return original(...)
		end
	end)
end

local function install_death_rewrites(pba)
	local props = pba.artefact_props or {}
	death_rewrite(props.af_kogot, "on_death", "pba.claw_death", {
		{ "sim:release(sim:object(monster_id))", "alife_release_id(monster_id)" },
	})
	death_rewrite(props.af_dragon_eye, "on_death", "pba.dragon_death", {
		{ "CreateTimeEvent(explode_obj.id, explode_obj.id, 0, explode, explode_obj.id)",
		  "if explode_obj then CreateTimeEvent(explode_obj.id, explode_obj.id, 0, explode, explode_obj.id) else alife_release_id(npc_id) end" },
	})
	death_rewrite(pba.artefact_on_npc_death_functions, "af_skull_miser", "pba.money_death", {
		{ "CreateTimeEvent(money_item.id, money_item.id, 0, money_fountain, money_item.id)",
		  "if money_item then CreateTimeEvent(money_item.id, money_item.id, 0, money_fountain, money_item.id) end" },
	})
end

-- Client: a perk's world part is collected while the death handlers run.
local function client_death(orig, tbl, victim, who, ...)
	local cap = { spawn = {}, release = false }
	local vid = victim:id()
	local real_create, real_release, real_release_id = _G.alife_create, _G.alife_release, _G.alife_release_id
	local real_create_item = _G.alife_create_item
	_G.alife_create_item = function(sec, owner, ...)
		-- GAMMA ItemProcessor uses sim:create directly. A location tuple without a parent is a world spawn;
		-- an actor/server-object destination or a tuple with a parent remains the original inventory operation.
		if type(sec) == "string" and type(owner) == "table" and owner[1] ~= nil
			and (owner[4] == nil or owner[4] == 65535) then
			if #cap.spawn < MAX_SECTIONS then cap.spawn[#cap.spawn + 1] = sec end
			return nil -- no invented client id: the rewritten death functions defer their world work
		end
		return real_create_item(sec, owner, ...)
	end
	_G.alife_create = function(sec, pos, lv, gv, id, state)
		if lv ~= true and id == nil and type(sec) == "string" then
			if #cap.spawn < MAX_SECTIONS then cap.spawn[#cap.spawn + 1] = sec end
			return nil
		end
		return real_create(sec, pos, lv, gv, id, state)
	end
	_G.alife_release = function(se, ...)
		local ok, id = pcall(function() return type(se.id) == "function" and se:id() or se.id end)
		if ok and id == vid then
			cap.release = true
			return
		end
		return real_release(se, ...)
	end
	_G.alife_release_id = function(id, ...)
		if id == vid then
			cap.release = true
			return
		end
		return real_release_id(id, ...)
	end
	local ok, e = pcall(orig, tbl, victim, who, ...)
	_G.alife_create, _G.alife_release, _G.alife_release_id = real_create, real_release, real_release_id
	_G.alife_create_item = real_create_item
	if not ok then core.report("perks", "death perks", e) end
	if #cap.spawn == 0 and not cap.release then return end
	local n = math.min(#cap.spawn, MAX_SECTIONS)
	local s = table.concat(cap.spawn, "|", 1, n)
	if core.to_host("pba_corpse", { v = core.hid(vid), s = s, r = cap.release }) then st.corpse_out = st.corpse_out + 1 end
end

-- Host: the world part of a client's death perks.
local served = setmetatable({}, { __mode = "k" }) -- binder storage belongs to one creature even when its id is reused

local function spawn_near(sec, victim)
	local pos = victim:position()
	local a = math.random() * 2 * math.pi
	local r = 0.3 + math.random() * 0.4
	local p = vector():set(pos.x + math.cos(a) * r, pos.y + 0.5, pos.z + math.sin(a) * r)
	return alife_create(sec, p, victim:level_vertex_id(), victim:game_vertex_id())
end

local function host_corpse(t, from)
	local wire = tonumber(t.v)
	local bounded = wire and wire > 0 and wire < 65535 and wire == math.floor(wire)
	local id = bounded and core.lid(wire)
	bounded = bounded and type(id) == "number" and id > 0 and id < 65535 and id == math.floor(id)
	local accept_id = coop_trust.pass("pba_corpse_id", bounded, "corpse id from #%s is outside object bounds", tostring(from))
	if not accept_id or not bounded then st.corpse_refused = st.corpse_refused + 1; return end
	local victim = level.object_by_id(id)
	local who = core.avatar(from)
	local present = victim and who and (IsStalker(victim) or IsMonster(victim)) and not victim:alive()
	local accept_body = coop_trust.pass("pba_corpse_body", present, "corpse %s from #%s is not an available dead creature", tostring(id), tostring(from))
	if not accept_body or not present then st.corpse_refused = st.corpse_refused + 1; return end
	local body = db.storage[id]
	local killer = body and body.death_by_id == who:id()
	local accept_killer = coop_trust.pass("pba_corpse_killer", killer, "corpse %s was not killed by requester #%s", tostring(id), tostring(from))
	-- Retain the existing ownership and section gates; trust adds diagnostics, not permission to take another kill.
	if not accept_killer or not killer or served[body] then
		st.corpse_refused = st.corpse_refused + 1
		return
	end
	local sections_ok = t.s == nil or (type(t.s) == "string" and #t.s <= MAX_SECTIONS * 128)
	local release_ok = t.r == nil or type(t.r) == "boolean"
	if not coop_trust.pass("pba_corpse_payload", sections_ok and release_ok,
		"invalid corpse payload from #%s", tostring(from)) then
		st.corpse_refused = st.corpse_refused + 1
		return
	end
	local sections = sections_ok and t.s or ""
	local release = t.r == true
	if sections == "" and not release then return end
	served[body] = true
	st.corpse_in = st.corpse_in + 1
	local ok_list = allowed_sections()
	local pba = core.mod("perk_based_artefacts")
	local skull = pba and pba.artefact_props and pba.artefact_props.af_skull_miser
	local money_items = skull and skull.money_items or {}
	local explode = nil
	local n = 0
	for sec in sections:gmatch("[^|]+") do
		n = n + 1
		local accept_count = coop_trust.pass("pba_corpse_count", n <= MAX_SECTIONS, "too many loot sections from #%s", tostring(from))
		if not accept_count or n > MAX_SECTIONS then break end
		local accept_section = coop_trust.pass("pba_corpse_section", ok_list[sec], "unlisted loot section #%d from #%s", n, tostring(from))
		if accept_section and ok_list[sec] then
			local se = spawn_near(sec, victim)
			local cls = se and ini_sys:r_string_ex(sec, "class") or ""
			if se and cls:find("EXPLO", 1, true) then explode = se end
			if se then
				for _, money in ipairs(money_items) do
					if sec == money then
						-- PBA's money_fountain timer needs an online object, on the machine that owns its physics.
						core.when_online(se.id, sec, function(obj)
							local force = 125 + math.random() * 200
							obj:get_physics_shell():apply_force(force, force * 5, force)
						end, 5000)
						break
					end
				end
			end
		end
	end
	if explode then
		core.when_online(explode.id, explode:section_name(), function(obj)
			if release then pcall(alife_release_id, id) end
			obj:explode(0)
		end, 5000)
	elseif release then
		pcall(alife_release_id, id)
	end
end

local pba_installed = false
local death_seen = setmetatable({}, { __mode = "k" })
local stalker_hits = setmetatable({}, { __mode = "k" })

local function body_key(victim)
	return db.storage[victim:id()] or victim
end

-- GAMMA's ballistics records hit details only where it applies damage. The owner's before-hit
-- callback carries those details before the shot is sent, and several victims can be in flight.
local function remember_stalker_hit(victim, s_hit, bone)
	if core.active() and coop_mode.is_player_mirror() and s_hit and s_hit.draftsman and own_who(s_hit.draftsman) then
		stalker_hits[body_key(victim)] = { hit = hit(s_hit), bone = bone }
	end
end

-- Grok's authoritative before-hit callback did not roll these perks for this belt. Use the
-- mod's death-roll ranges for this confirmed kill without changing damage or the next mutant's roll.
local function run_stalker_death(tbl, victim, who, orig, pba, last)
	local props = pba.artefact_props or {}
	local belt = core.upvalue(orig, "artefacts")
	local eye = (not belt or belt.af_dragon_eye) and props.af_dragon_eye
	local claw = (not belt or belt.af_kogot) and props.af_kogot
	local eye_roll, claw_roll = eye and eye.dice_roll, claw and claw.dice_roll
	if eye then eye.dice_roll = last and math.random() * 100 or math.huge end
	if claw then
		claw.dice_roll = last and claw.valid_hits[last.hit.type] and math.random() or math.huge
	end
	local ok, err = pcall(orig, tbl, victim, who, last and last.hit, last and last.bone)
	if eye then eye.dice_roll = eye_roll end
	if claw then claw.dice_roll = claw_roll end
	if not ok then error(err, 0) end
end

-- The replica's death callback is raised after the confirmed EntityDied was applied. GAMMA's grok_bo replaces
-- PBA's stalker callback with an empty function and calls its table only from its authoritative ballistics.
local function confirmed_stalker_death(victim, who)
	if not (core.active() and coop_mode.is_player_mirror() and victim and who and own_who(who)
		and IsStalker(victim) and not victim:alive()) then return end
	local pba = core.mod("perk_based_artefacts")
	if pba then
		pba.process_artefacts(pba.artefact_on_npc_death_functions, victim, who)
	end
end

local function install_pba()
	if pba_installed then return end
	local pba = core.mod("perk_based_artefacts")
	if not pba then return end
	local gamma_ballistics = core.mod("grok_bo") ~= nil
	install_death_rewrites(pba)
	pdata.register("perk_based_artefacts_cooldowns", { prime = { "perk_based_artefacts" } })
	-- Everything a client has comes through a transition exactly as in a usual game: the mod's save_state writes five keys
	-- and load_state reads five, and all five are a player's own. With only the cooldowns his, after every load a client
	-- would run the HOST's timed effects (his infinite sprint, his food heal), statuses (Lucifer overcharge, Moss
	-- invisibility), virtual artefacts (Sandstone) and Lucifer condition, and lose his own. The same save_state fills them
	-- (the functions of an effect travel as the dumped strings the mod itself saves).
	for _, key in ipairs({ "perk_based_artefacts_effects", "perk_based_artefacts_status_effects",
		"perk_based_artefacts_virtual_artefacts", "perk_based_artefacts_lucifer_condition" }) do
		pdata.register(key, { prime = { "perk_based_artefacts" } })
	end
	local ok = core.wrap(pba, "process_artefacts", "perk_based_artefacts.process_artefacts", function(orig)
		return function(tbl, ...)
			if not core.active() then return orig(tbl, ...) end
			if is_death(pba, tbl) and not coop_mode.actor_is_player() then
				st.skipped_deaths = st.skipped_deaths + 1
				return
			end
			if coop_mode.leads_here() then
				if is_before_hit(pba, tbl) then
					local _, s_hit = ...
					if s_hit and remote_drafts(s_hit) then
						st.skipped_hits = st.skipped_hits + 1
						return
					end
				elseif is_death(pba, tbl) then
					local _, who = ...
					if who and remote_who(who) then
						st.skipped_deaths = st.skipped_deaths + 1
						return
					end
				end
			elseif coop_mode.is_player_mirror() and is_death(pba, tbl) then
				local victim, who = ...
				if not (victim and who and own_who(who)) then return end
				local body = body_key(victim)
				if death_seen[body] then return end
				death_seen[body] = true -- always on, even when a foreign perk throws
				if tbl == pba.artefact_on_npc_death_functions then
					local last = stalker_hits[body]
					stalker_hits[body] = nil
					local _, _, supplied_hit = ...
					if gamma_ballistics and not supplied_hit then
						return client_death(run_stalker_death, tbl, victim, who, orig, pba, last)
					end
					if last then return client_death(orig, tbl, victim, who, last.hit, last.bone) end
				end
				return client_death(orig, tbl, ...)
			end
			return orig(tbl, ...)
		end
	end)
	if ok then
		pba_installed = true
		core.on("pba_corpse", host_corpse, "host")
		core.set_limit("pba_corpse", 10, 2)
		RegisterScriptCallback("npc_on_before_hit", remember_stalker_hit)
		RegisterScriptCallback("npc_on_death_callback", confirmed_stalker_death)
		installed[#installed + 1] = "perk_based_artefacts"
	end
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
-- One job at the first update: the handler goes once it is done.
local function actor_on_update()
	UnregisterScriptCallback("actor_on_update", actor_on_update)
	core.install("perks", "rebind skills", rebind_skills)
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included.
function on_game_start()
	if not api then return end
	core.install("perks", "install_skills", install_skills)
	core.install("perks", "install_pba", install_pba)
	if #installed == 0 then return end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	core.status_line("perks", function()
		return string.format("%s | host: skipped hits %d, deaths %d, corpse requests %d (refused %d) | client: corpse requests %d",
			table.concat(installed, ", "), st.skipped_hits, st.skipped_deaths, st.corpse_in, st.corpse_refused, st.corpse_out)
	end)
end
