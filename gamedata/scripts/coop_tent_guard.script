--[[
	Anomaly Coop - stop-gap for tents and sleeping bags on a co-op client (gamedata\scripts\coop_tent_guard.script), F3 hotfix.
	Research: docs\research\2026-10-22-f3-saves-sleep-recon.md, B.3 and Z2 / Z6 / Z7 / Z8.

	Why. A client cannot create a world object: the engine returns nil for alife_create without a parent (the host
	does not take such a request). The stock item_tent then reads se_obj.id of that nil:
	  - itm_tent_func runs as a level.add_call functor (no pcall): a Lua error there is FATAL in a release build;
	  - the sleeping bag branch of the local actor_on_item_use fails the same way, the item is lost;
	  - packing a tent / bag up releases the host's object, which a client may not do: the item is handed out twice.
	Until F3 lets the host place the tent on a client's request, a client only gets a message.

	What. On a co-op CLIENT the entry points of the item_tent module table are replaced (assigned at load time, so
	that everything that looks them up by name later finds the wrapper, including the local actor_on_item_use of the stock
	file, which calls start_timer and use_compression_bag through the module table):
	  func_use_tent, func_use_bag   use1_action_functor of the items (stock itm_tent, GAMMA itm_sleepbag too): the item is
	                                not touched, the stock function (which would free it) is not called;
	  start_timer                   the use callback of an item the engine has already eaten (itm_tent, itm_tent_bag
	                                next to a tent): the item is handed back, no timer functor is queued;
	  use_compression_bag           the same for a compression bag;
	  itm_tent_func, itm_tent_bag_func   the timer functors themselves, in case one gets queued anyway.
	The client sees a message (string st_coop_tent_blocked); nothing is spawned or released.
	On the host and in single player every wrapper calls the stock function with the same arguments.

	Not covered: the sleeping bag branch of the local use callback for an item the engine eats (stock Anomaly, itm_sleepbag
	without use1_action_functor): the callback cannot be wrapped from outside, the error stays in the callback's pcall.
	GAMMA does not take that path for itm_sleepbag (func_use_bag).

	Loaded by axr_main like any script that has on_game_start; nothing is added to coop_main or the domain tables
	(the name falls under coop_* = view, and the wrappers are not registered callbacks).
--]]

local api = rawget(_G, "coop") -- engine namespace (nil on an exe without co-op)

local TEXT_ID = "st_coop_tent_blocked"
local TEXT_FALLBACK = "Tents and sleeping bags cannot be used from a co-op client yet. The item stays in your inventory."

stats = { blocked = 0, returned = 0, return_failed = 0 }

local function log(fmt, ...)
	local ok, line = pcall(string.format, fmt, ...)
	printf("[coop-tent-guard] %s", ok and line or tostring(fmt))
end

-- A client of a co-op session; the answer is taken at every call (the role is not known when the script loads).
local function is_client()
	if not api then return false end
	local ok, active = pcall(api.is_active)
	if not (ok and active == true) then return false end
	local ok_client, client = pcall(api.is_client)
	return ok_client and client == true
end

local function say()
	local text = TEXT_FALLBACK
	local ok, s = pcall(game.translate_string, TEXT_ID)
	if ok and type(s) == "string" and s ~= "" and s ~= TEXT_ID then text = s end
	local am = rawget(_G, "actor_menu")
	if am and am.set_msg then pcall(am.set_msg, 1, text, 4) end
end

local function section_of(obj)
	if obj == nil then return nil end
	local ok, sec = pcall(function() return obj:section() end)
	return ok and type(sec) == "string" and sec or nil
end

-- The engine has eaten the item before the use callback ran: put one back in the inventory (the parent is the actor, so
-- the client's request is forwarded and accepted).
local function give_back(section)
	local actor = db.actor
	if not (section and actor) then return end
	local ok, err = pcall(alife_create_item, section, actor)
	if ok then
		stats.returned = stats.returned + 1
	else
		stats.return_failed = stats.return_failed + 1
		log("! could not return %s: %s", section, tostring(err))
	end
end

local function refuse(what, give_section)
	stats.blocked = stats.blocked + 1
	log("%s is not available on a client", what)
	say()
	give_back(give_section)
end

-- ------------------------------------------------------------------ wrappers: name -> make(orig) -> wrapper
local function make_use_functor(name)
	return function(orig)
		return function(obj, ...)
			if obj ~= nil and is_client() then return refuse(name) end
			return orig(obj, ...)
		end
	end
end

local function make_timer_functor(name)
	return function(orig)
		return function(...)
			if is_client() then return refuse(name) end
			return orig(...)
		end
	end
end

local MAKERS = {
	{ "func_use_tent", make_use_functor("func_use_tent") },
	{ "func_use_bag", make_use_functor("func_use_bag") },
	{ "itm_tent_func", make_timer_functor("itm_tent_func") },
	{ "itm_tent_bag_func", make_timer_functor("itm_tent_bag_func") },
	{ "start_timer", function(orig)
		return function(obj, ...)
			if is_client() then
				local sec = section_of(obj)
				if sec == "itm_tent" or sec == "itm_tent_bag" then return refuse("start_timer(" .. sec .. ")", sec) end
			end
			return orig(obj, ...)
		end
	end },
	{ "use_compression_bag", function(orig)
		return function(obj, ...)
			if is_client() then
				local sec = section_of(obj)
				return refuse("use_compression_bag", sec == "compression_bag" and sec or nil)
			end
			return orig(obj, ...)
		end
	end },
}

local wrapped = {} -- entry name -> true once the wrapper is in the module table

local function install()
	if not api then return end
	local ok, mod = pcall(function() return rawget(_G, "item_tent") or _G.item_tent end) -- loads the stock script if needed
	if not (ok and type(mod) == "table") then return end
	for _, entry in ipairs(MAKERS) do
		local name, make = entry[1], entry[2]
		local orig = mod[name]
		if not wrapped[name] and type(orig) == "function" then
			local wrapper = make(orig)
			if type(wrapper) == "function" then
				mod[name] = wrapper
				wrapped[name] = true
			end
		end
	end
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included.
function on_game_start()
	local ok, err = pcall(install)
	if not ok then log("! install failed: %s", tostring(err)) end
end

-- Load time (before any on_game_start): the wrappers are in place before anybody looks the functions up.
do
	local ok, err = pcall(install)
	if not ok then printf("[coop-tent-guard] ! install at load failed: %s", tostring(err)) end
end
