--[[
	Anomaly Coop - stop-gap for tents and sleeping bags on a co-op client (gamedata\scripts\coop_tent_guard.script), F3 hotfix.
	Research: docs\research\2026-10-22-f3-saves-sleep-recon.md, B.3 and Z2 / Z6 / Z7 / Z8.

	Why. A client cannot create a world object: the engine returns nil for alife_create without a parent (the host
	does not take such a request). The stock item_tent then reads se_obj.id of that nil:
	  - itm_tent_func runs as a level.add_call functor (no pcall): a Lua error there is FATAL in a release build;
	  - the sleeping bag branch of the local actor_on_item_use fails the same way, the item is lost;
	  - packing a tent / bag up releases the host's object, which a client may not do: the item is handed out twice.
	Until F3 lets the host place the tent on a client's request, a client only gets a message.

	What. On a co-op CLIENT the entry points of the item_tent module table are replaced (assigned at load time, so
	that everything that looks them up by name later finds the wrapper, including the local actor_on_item_use of the stock
	file, which calls start_timer and use_compression_bag through the module table):
	  func_use_tent, func_use_bag   use1_action_functor of the items (stock itm_tent, GAMMA itm_sleepbag too): the item is
	                                not touched, the stock function (which would free it) is not called;
	  start_timer                   the use callback of an item the engine may have eaten (itm_tent, itm_tent_bag next to a
	                                tent): no timer functor is queued;
	  use_compression_bag           the same for a compression bag; the message appears only when a placed sleeping bag
	                                is in reach (without one the stock function does nothing);
	  itm_tent_func, itm_tent_bag_func   the timer functors themselves, in case one gets queued anyway;
	  on_game_start                 after the stock one has registered its local use callback, that callback is replaced
	                                by a guard: on a client it refuses the placeable sleeping bag branch (stock itm_sleepbag,
	                                the engine eats the item) and hands everything else to the stock callback unchanged.
	The client sees a message (string st_coop_tent_blocked, the inventory window is closed first, as itms_manager does);
	nothing is spawned or released.
	An item is handed back only when the engine really took it: CInventory::Eat deletes it when remove_after_use is true
	(default) and max_uses is 1. itm_tent and itm_sleepbag are given back; itm_tent_bag and compression_bag
	(remove_after_use = false) stay in the inventory, a second copy would be a duplicate.
	On the host and in single player every wrapper calls the stock function with the same arguments.

	Accepted: the give-back is an alife_create_item whose result on a client is nil, so the client's item processor may log a
	false "refused" error for it, and stats.returned counts the request, not the arrival.

	Loaded by axr_main like any script that has on_game_start; nothing is added to coop_main or the domain tables
	(the name falls under coop_* = view; the use guard is a view callback, pcall-protected on a client like the stock one).
--]]

local api = rawget(_G, "coop") -- engine namespace (nil on an exe without co-op)

local TEXT_ID = "st_coop_tent_blocked"
local TEXT_FALLBACK = "Tents and sleeping bags cannot be used from a co-op client yet. The item stays in your inventory."
local USE_CALLBACK = "actor_on_item_use"

stats = { blocked = 0, returned = 0, return_failed = 0 }

local function log(fmt, ...)
	local ok, line = pcall(string.format, fmt, ...)
	printf("[coop-tent-guard] %s", ok and line or tostring(fmt))
end

-- A client of a co-op session; the answer is taken at every call (the role is not known when the script loads).
local function is_client()
	if not api then return false end
	local ok, active = pcall(api.is_active)
	if not (ok and active == true) then return false end
	local ok_client, client = pcall(api.is_client)
	return ok_client and client == true
end

local function say()
	local text = TEXT_FALLBACK
	local ok, s = pcall(game.translate_string, TEXT_ID)
	if ok and type(s) == "string" and s ~= "" and s ~= TEXT_ID then text = s end
	-- The message is drawn behind the inventory window: close it first (itms_manager does the same before its set_msg).
	pcall(function() utils_xml.hide_menu() end)
	local am = rawget(_G, "actor_menu")
	if am and am.set_msg then pcall(am.set_msg, 1, text, 4) end
end

local function section_of(obj)
	if obj == nil then return nil end
	local ok, sec = pcall(function() return obj:section() end)
	return ok and type(sec) == "string" and sec or nil
end

local function upvalue(f, name)
	if type(f) ~= "function" then return nil end
	for i = 1, 255 do
		local n, v = debug.getupvalue(f, i)
		if n == nil then return nil end
		if n == name then return v end
	end
	return nil
end

-- Did the engine take the item for this use? CInventory::Eat deletes it only when remove_after_use is true (default) and
-- no use is left (max_uses, default 1). An unreadable section counts as "not taken": no give-back, no duplicate.
local function eaten_for_good(section)
	local ok, r = pcall(function()
		-- no default argument for r_float_ex: the non-memoizing variant of _g.script ignores it and returns nil
		return ini_sys:r_bool_ex(section, "remove_after_use", true) and (ini_sys:r_float_ex(section, "max_uses") or 1) <= 1
	end)
	return ok and r == true
end

-- Put one back in the inventory (the parent is the actor, so the client's request is forwarded and accepted).
local function give_back(section)
	local actor = db.actor
	if not (section and actor and eaten_for_good(section)) then return end
	local ok, err = pcall(alife_create_item, section, actor)
	if ok then
		stats.returned = stats.returned + 1
	else
		stats.return_failed = stats.return_failed + 1
		log("! could not return %s: %s", section, tostring(err))
	end
end

local function refuse(what, give_section)
	stats.blocked = stats.blocked + 1
	log("%s is not available on a client", what)
	say()
	give_back(give_section)
end

-- A placed sleeping bag within `dist` of the actor, the way the stock use_compression_bag looks for one: only then the stock
-- function would do something (and release the host's object).
local function placed_sleepbag_near(mod, dist)
	local ok, found = pcall(function()
		local reach = tonumber(dist) or 1.5
		local here = db.actor:position()
		for id, v in pairs(mod.get_spawned_sleepbags()) do
			local obj = level.object_by_id(id)
			if obj and v == true and obj:section() == "ph_sleepbag" and obj:position():distance_to(here) < reach then
				return true
			end
		end
		return false
	end)
	return ok and found == true
end

-- ------------------------------------------------------------------ the use callback of the stock file
local stock_use = nil -- the file local actor_on_item_use of item_tent (an upvalue of func_use_tent / func_use_bag)
local use_guard = nil -- what replaces it in the callback list

-- The branch of the stock callback that places a ph_sleepbag: SleepBagEnable and SleepBagSections[sec] and SleepBagPlaceable
-- (the stock file locals, read as upvalues at call time).
local function sleepbag_branch(sec)
	local sections = upvalue(stock_use, "SleepBagSections")
	return upvalue(stock_use, "SleepBagEnable") and upvalue(stock_use, "SleepBagPlaceable")
		and type(sections) == "table" and sections[sec] ~= nil
end

local function swap_use_callback()
	local old = stock_use
	if type(old) ~= "function" then return end
	local cm = rawget(_G, "coop_main")
	local reg = cm and cm.callback_registered and cm.callback_registered(USE_CALLBACK, old)
	if reg == false then return end -- the stock callback is not registered: nothing to guard
	if not use_guard then
		use_guard = function(obj, ...)
			if is_client() then
				local sec = section_of(obj)
				if sec and sleepbag_branch(sec) then return refuse(USE_CALLBACK .. "(" .. sec .. ")", sec) end
			end
			return old(obj, ...)
		end
	end
	pcall(UnregisterScriptCallback, USE_CALLBACK, old)
	RegisterScriptCallback(USE_CALLBACK, use_guard)
end

-- ------------------------------------------------------------------ wrappers: name -> make(orig, mod) -> wrapper
local function make_use_functor(name)
	return function(orig)
		return function(obj, ...)
			if obj ~= nil and is_client() then return refuse(name) end
			return orig(obj, ...)
		end
	end
end

local function make_timer_functor(name)
	return function(orig)
		return function(...)
			if is_client() then return refuse(name) end
			return orig(...)
		end
	end
end

local MAKERS = {
	{ "func_use_tent", make_use_functor("func_use_tent") },
	{ "func_use_bag", make_use_functor("func_use_bag") },
	{ "itm_tent_func", make_timer_functor("itm_tent_func") },
	{ "itm_tent_bag_func", make_timer_functor("itm_tent_bag_func") },
	{ "start_timer", function(orig)
		return function(obj, ...)
			if is_client() then
				local sec = section_of(obj)
				if sec == "itm_tent" or sec == "itm_tent_bag" then return refuse("start_timer(" .. sec .. ")", sec) end
			end
			return orig(obj, ...)
		end
	end },
	{ "use_compression_bag", function(orig, mod)
		return function(obj, dist, ...)
			if is_client() then
				if placed_sleepbag_near(mod, dist) then
					local sec = section_of(obj)
					refuse("use_compression_bag", sec == "compression_bag" and sec or nil)
				end
				return
			end
			return orig(obj, dist, ...)
		end
	end },
	{ "on_game_start", function(orig)
		return function(...)
			orig(...)
			local ok, err = pcall(swap_use_callback)
			if not ok then log("! use callback swap failed: %s", tostring(err)) end
		end
	end },
}

local wrappers = {} -- entry name -> the wrapper this script put in the module table

local function install()
	if not api then return end
	local ok, mod = pcall(function() return rawget(_G, "item_tent") or _G.item_tent end) -- loads the stock script if needed
	if not (ok and type(mod) == "table") then return end
	for _, entry in ipairs(MAKERS) do
		local name, make = entry[1], entry[2]
		local cur = mod[name]
		-- A mod that overwrote the function after us is wrapped again (the guard must not go silent).
		if type(cur) == "function" and cur ~= wrappers[name] then
			if stock_use == nil and (name == "func_use_tent" or name == "func_use_bag") then
				stock_use = upvalue(cur, "actor_on_item_use") -- the file local both functors call
			end
			local wrapper = make(cur, mod)
			if type(wrapper) == "function" then
				mod[name] = wrapper
				wrappers[name] = wrapper
			end
		end
	end
	if stock_use == nil then
		log("! the stock use callback of item_tent was not found: the sleeping bag branch stays unguarded")
	end
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included.
function on_game_start()
	local ok, err = pcall(install)
	if not ok then log("! install failed: %s", tostring(err)) end
	-- item_tent.on_game_start may have run already (its callback is registered): swap now, otherwise its wrapper does it.
	local cm = rawget(_G, "coop_main")
	if stock_use and cm and cm.callback_registered and cm.callback_registered(USE_CALLBACK, stock_use) == true then
		local ok_swap, err_swap = pcall(swap_use_callback)
		if not ok_swap then log("! use callback swap failed: %s", tostring(err_swap)) end
	end
end

-- Load time (before any on_game_start): the wrappers are in place before anybody looks the functions up.
do
	local ok, err = pcall(install)
	if not ok then printf("[coop-tent-guard] ! install at load failed: %s", tostring(err)) end
end
