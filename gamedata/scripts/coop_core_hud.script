--[[
	Anomaly Coop - core group: who is where (gamedata\scripts\coop_core_hud.script); the team panel is described in
	docs\HUD_V2.md. Layout configs\ui\ui_coop_core.xml (party_card), textures
	configs\ui\textures_descr\ui_coop_hud.xml. Colours and state rules: coop_allies.script. Map markers:
	coop_allies_map.script (+ modxml_coop_allies.script). The compass bar, its marker data and the ping: coop_hud_*.script.

	1. Status: every player sends its own health, state, community, portrait and bleed-out time to the others
	   ("core.status", about once a second, more often on a change). Proxies are not harmed on the other machines,
	   so their engine health tells nothing; this is the only source of a teammate's health. The engine's
	   survival state (coop.life_of) wins over the reported state when it exists.
	2. Team panel on the HUD ("Visor"): one row per other
	   player, top left (coop_hud_layout team_x / team_top), sorted by peer id (host on top), rows straight under each other
	   58 px apart at 1080 (no stair), the whole panel one root moved by coop_hud_depth.offset("near") (rows never move
	   against each other). A row for every other player of the session (the co-op 7, a server 15); more than 7
	   rows close up (row_pitch). Own sizes: the constants V (px at 1080). Full brightness always. A row: a "[" in his
	   colour (coop_h3_bracket_l), nick white (coop_hud3_fonts "nick") with a 1 px shadow, host star, the metres ("small",
	   tabular digits) ending at 222 px and an arrow to him turned relative to the camera (every frame); under the nick his
	   health in 4 segments of 25 % (white, red under 30 %, the empty part white at 0.18). No state words - badge and colour;
	   only a dying row moves:
	   - down: the segments are the bleed-out timer (red, melting), "0:42" in red and the ally_down badge at 1 Hz, and the
	     heart beats over the segments at an uneven rhythm (coop_h3_pulse_0..7 frames on a 2.6 s sweep);
	   - being revived (set_revive): the red fills in the reviver's colour, ally_revive, the timer steady, no beats;
	   - dead / returning: grey segments and bracket, ally_dead; the engine's respawn countdown (coop.respawn_left) fills
	     them back in white with "0:21"; spectating (hardcore): ally_spectator; status stopped coming: ally_offline, the
	     nick dimmed; resting / sleeping (coop.rest): the sleep badge; the camp badge for 10 s after his
	     checkpoint changed.
	   If the Visor atlas (ui_coop_hud3) or font is missing, use the ui_coop_hud textures (plain bracket, no beats)
	   and the XML font.
	   Hidden with the main HUD (inventory, PDA, scope) at once and outside a session.
	3. Minimap / PDA markers of other players: coop_allies_map (arrow in the player's colour turning with his
	   heading, edge pointer, "needs help" overlay, grey marker when dead), updated 5 times a second.

	For other scripts:
		coop_core_hud.status_of(peer) -> { h = 0..1, s = state, f = community, i = icon, b = bleed s | nil, at } | nil
		coop_core_hud.views() -> list of other players { peer, slot, nick, host, state, bleed, hp, avatar, dist, icon,
			pos = {x, y, z} of his avatar | nil, far = true for one on another map with a record in this world, far_id,
			loading = true while his character is not in this world (no hp, no dist; the panel says "loading") }
		coop_core_hud.shared_views(tg) -> the list the team panel shows now (made at its refresh, or when PANEL_MS old)
		coop_core_hud.distance_text(peer) -> the panel's metres from me to him ("29 m"), nil when it shows none (the
			transition board's rows show exactly this)
		coop_core_hud.set_party_enabled(bool) / set_spots_enabled(bool)
		coop_core_hud.set_revive(peer, frac | nil, by_peer)   his red segments fill in the reviver's colour
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local string_format = string.format
local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall
local math_max, math_min, math_floor = math.max, math.min, math.floor

local K = coop_hud_kit
local argb, el, put, show, color, metrics, hud_visible = K.argb, K.el, K.put, K.show, K.color, K.metrics, K.hud_visible
local players = coop_util.players

local EV_STATUS = "core.status"
local STATUS_COORD_MAX = 1000000 -- same world coordinate bound as coop_main's environment reports
local STATUS_MS = 1000 -- check own status this often
local STATUS_KEEPALIVE_MS = 5000 -- resend an unchanged status
local PANEL_MS = 500 -- party panel refresh (2 Hz)
local SPOTS_MS = 200 -- map markers (5 Hz)
-- The panel has a row for every other player the session can have (coop_allies.others_max: the co-op 7, a server 15). Up
-- to ROWS_FULL rows keep the pitch of team_row; more rows close up to the height of one row (compact_pitch).
local ROWS_FULL = 7
local XML_FILE = "ui_coop_core.xml"

local log = coop_util.logger("[coop-hud]")

-- The HUD, the team panel, the markers and the own status belong to a PLAYER in the world - the host player (the host
-- process is the world server and a client of it) or a live remote client - so the question is the role (coop.is_player()),
-- not "am I the host". The host is live as soon as its world is up (coop.is_live()). A world server with no player has no
-- actor to report. A build without coop.is_player() has only players in a session.
local function live()
	if not (api ~= nil and api.is_active()) then return false end
	if type(api.is_player) == "function" then
		local ok, yes = pcall(api.is_player)
		if not (ok and yes == true) then return false end
	end
	return api.is_live() == true
end

-- the host's star: the engine's is_host (the playing host, or the operator of a world server); a row without the field is
-- the host when it is peer 0
local function host_badge(p)
	if p.is_host ~= nil then return p.is_host == true end
	return p.id == 0
end

local function codec()
	return rawget(_G, "coop_main") or coop_main
end

local function allies()
	return rawget(_G, "coop_allies") or coop_allies
end

local function amap()
	return rawget(_G, "coop_allies_map") or coop_allies_map
end

-- coop_allies / coop_allies_map ship with this file; if one of them failed to load, say so once and keep quiet.
local missing_logged = false
local function modules_ok()
	if allies() and amap() then return true end
	if not missing_logged then
		missing_logged = true
		printf("[coop-hud] ! coop_allies.script or coop_allies_map.script is missing: no party panel, no markers")
	end
	return false
end

local function map_call(name, ...)
	local m = amap()
	local f = m and m[name]
	if not f then return false end
	return pcall(f, ...)
end

local party_enabled, spots_enabled = true, true
local stats = { status_out = 0, status_in = 0, status_bad = 0 }

-------------------------------------------------------------------------------
-- Status
-------------------------------------------------------------------------------
local status = {} -- peer id -> { h, s, f, i, b, at }
local sent = { payload = nil, at = 0 }

local function own_state(actor)
	local s = allies().engine_state(0) -- engine survival state, when present
	if s then return s end
	if not actor:alive() then return "dead" end
	return actor.health <= 0.011 and "down" or "alive" -- a player who is down is pinned at 1% health
end

local function send_status(tg)
	local actor = db.actor
	if not actor then return end
	local icon = actor:character_icon()
	local t = {
		h = math_floor(math_max(0, math_min(1, actor.health)) * 100 + 0.5) / 100,
		s = own_state(actor),
		f = tostring(actor:character_community() or ""),
		i = type(icon) == "string" and icon or "",
	}
	if t.s == "down" then
		local b = allies().engine_bleed(0)
		if b then t.b = math_min(b, 3600) end
	end
	-- When the world seat is away, mirrors need the player's reported position to move his offline record.
	if coop_mode.where(0) == "away" then
		local pos = actor:position()
		t.x, t.y, t.z = math_floor(pos.x + 0.5), math_floor(pos.y + 0.5), math_floor(pos.z + 0.5)
		t.l, t.g = actor:level_vertex_id(), actor:game_vertex_id()
	end
	local payload = codec().encode(t)
	if payload == sent.payload and tg - sent.at < STATUS_KEEPALIVE_MS then return end
	if api.send_event(EV_STATUS, payload, -1) then
		sent.payload, sent.at = payload, tg
		stats.status_out = stats.status_out + 1
	end
end

local function audit_status_refusal(from, why)
	if coop_trust then coop_trust.pass(EV_STATUS, false, "peer %s: %s", tostring(from), why) end
end

local function status_number(value, min, max)
	local n = tonumber(value)
	if n and n >= min and n <= max then return n end
end

local function status_text(value, limit, pattern, from, why)
	if value == nil then return "" end
	if type(value) == "string" and #value <= limit and value:match(pattern) then return value end
	audit_status_refusal(from, why)
	return ""
end

local function on_status(payload, from)
	if not (type(from) == "number" and from >= 0 and from <= coop_util.MAX_PEER and from == math_floor(from)) then
		return audit_status_refusal(from, "invalid sender")
	end
	if not allies() then return end
	if type(payload) ~= "string" then return audit_status_refusal(from, "invalid payload") end
	local t = codec().decode(payload)
	local h = status_number(t.h, 0, 1)
	local s = t.s
	if not (h and allies().is_wire_state(s)) then
		stats.status_bad = stats.status_bad + 1
		return audit_status_refusal(from, "invalid health or state")
	end
	local f = status_text(t.f, 40, "^[%w_]*$", from, "invalid community")
	local i = status_text(t.i, 96, "^[%w_\\/%.]*$", from, "invalid portrait")
	local b
	if t.b ~= nil then
		local bleed = s == "down" and status_number(t.b, 0, 3600)
		if bleed then b = math_floor(bleed) else audit_status_refusal(from, "invalid bleed timer") end
	end
	local st = { h = h, s = s, f = f, i = i, b = b, at = time_global() }
	-- A position is optional, but all five fields are needed to move the offline record.
	if t.x ~= nil or t.y ~= nil or t.z ~= nil or t.l ~= nil or t.g ~= nil then
		local x = status_number(t.x, -STATUS_COORD_MAX, STATUS_COORD_MAX)
		local y = status_number(t.y, -STATUS_COORD_MAX, STATUS_COORD_MAX)
		local z = status_number(t.z, -STATUS_COORD_MAX, STATUS_COORD_MAX)
		local lv, gv = status_number(t.l, 0, 0xffffffff), status_number(t.g, 0, 0xfffe)
		if x and y and z and lv and lv == math_floor(lv) and gv and gv == math_floor(gv) then
			st.x, st.y, st.z, st.l, st.g = x, y, z, lv, gv
		else
			audit_status_refusal(from, "invalid position or vertex")
		end
	end
	status[from] = st
	stats.status_in = stats.status_in + 1
end

function status_of(peer)
	return status[peer]
end

-------------------------------------------------------------------------------
-- Other players as the UI sees them
-------------------------------------------------------------------------------
local function avatar_of(p)
	local id = p.avatar_id
	if type(id) ~= "number" or id <= 0 or id >= 65535 then return nil, nil end
	local obj = level.object_by_id(id)
	return obj, obj and id or nil
end

-- Split levels: his record in this world's ALife, for one with no object here: the PDA map shows a spot on it on his level.
local function far_avatar(p)
	local id = p.avatar_id
	if type(id) ~= "number" or id <= 0 or id >= 65535 then return nil end
	local record = rawget(_G, "alife_object")
	return record and record(id) and id or nil
end

-- "On another map: <name>" for a player the mode layer says is away.
local function elsewhere_of(peer)
	local read = coop_mode.hook("levels.elsewhere_text")
	local text = read and read(peer)
	return text and text ~= "" and text or nil
end

-- states the engine knows of a character that is in the world (his body lies or stands here, or he watches)
local LIFE_KNOWN = { down = true, dead = true, spec = true, respawn = true }

function views(tg)
	tg = tg or time_global()
	local A = allies()
	local list, by_avatar = {}, {}
	local actor = db.actor
	for _, p in ipairs(players()) do
		if not p.is_self and type(p.id) == "number" then
			local st = status[p.id]
			local state, bleed = A.state_of(p, st, tg)
			local fresh = st and (tg - st.at) <= A.STATUS_STALE_MS
			local obj, id = avatar_of(p)
			local away = coop_mode.where(p.id) == "away"
			local far_id = not obj and away and far_avatar(p) or nil
			-- his character is not in this world (he loads it, or chooses a character). The engine keeps a player's
			-- character out of the world exactly while its player is not in it (coop_alife.cpp switch_vote; coop_join.cpp
			-- host_on_world_loaded brings it in), the fact the transition board's "loading" is made of (coop_transition.h
			-- Mark::Loading). No health and no metres then: "loading", the board's word.
			local loading = not obj and not away and not LIFE_KNOWN[state] or nil
			local icon = st and st.i ~= "" and st.i or nil
			if not icon and obj then
				local ok, ic = pcall(obj.character_icon, obj)
				icon = ok and type(ic) == "string" and ic ~= "" and ic or nil
			end
			local v = {
				peer = p.id, slot = A.slot(p.id), nick = tostring(p.nick or "?"), host = host_badge(p),
				state = state, bleed = bleed, hp = fresh and not loading and st.h or nil, avatar = id, icon = icon,
				dist = (obj and actor) and obj:position():distance_to(actor:position()) or nil,
				elsewhere = away and elsewhere_of(p.id) or nil, far = far_id and true or nil, far_id = far_id, loading = loading,
			}
			if obj then
				local ok, pos = pcall(obj.position, obj)
				if ok and pos then v.pos = { x = pos.x, y = pos.y, z = pos.z } end
			end
			list[#list + 1] = v
			if id or far_id then by_avatar[id or far_id] = v end
		end
	end
	table.sort(list, function(a, b) return a.peer < b.peer end)
	return list, by_avatar
end

-- One view of the other players for every window that shows them. The team panel makes it at its refresh (fresh), the
-- transition board (coop_hud_transition, every frame) reads that one, so a player has the same metres and the same "loading"
-- in both windows in the same frame: two lists made apart differ by what a runner covers between them. Without the panel's
-- refresh it is made anew when it is PANEL_MS old.
local shared = { at = nil, list = nil, by_avatar = nil }

function shared_views(tg, fresh)
	tg = tg or time_global()
	local at = shared.at
	if fresh or not shared.list or not at or tg < at or tg - at >= PANEL_MS then
		shared.list, shared.by_avatar = views(tg)
		shared.at = tg
	end
	return shared.list, shared.by_avatar
end

local function loading_text()
	local ok, s = pcall(function() return game.translate_string("st_coop_transition_row_loading") end)
	if ok and type(s) == "string" and s ~= "" and s ~= "st_coop_transition_row_loading" then return s end
	return "loading"
end

-- What the panel shows right of his nick: the map he is on, "loading", or the metres from me to him; nil when nothing.
local function place_text(v)
	if v.elsewhere then return v.elsewhere end
	if v.loading then return loading_text() end
	local M = amap()
	return M and M.format_distance and M.format_distance(v.dist) or nil
end

-- The metres from me to player `peer` in the panel's words (the panel's view of this frame), nil when the panel has no metres
-- for him (no character here, on another map, no panel row). The transition board's rows show exactly this.
function distance_text(peer, tg)
	peer = tonumber(peer)
	if not peer then return nil end
	for _, v in ipairs((shared_views(tg))) do
		if v.peer == peer then
			if v.elsewhere or v.loading then return nil end
			return place_text(v)
		end
	end
	return nil
end

-- The records of the players on other maps follow what they said of themselves (the world server's move by the map servers' word).
local far_placed = {}

function place_far(list)
	local place = coop_mode.hook("levels.far_place")
	if not place then return end
	for _, v in ipairs(list) do
		local st = v.far_id and status[v.peer]
		if st and st.g and far_placed[v.peer] ~= st then
			far_placed[v.peer] = st
			pcall(place, v.far_id, st.x, st.y, st.z, st.l, st.g)
		end
	end
end

-------------------------------------------------------------------------------
-- Team panel
-------------------------------------------------------------------------------
-- Why main_hud_shown() says no (status line only): the parts of the stock check (_g.script).
local function hidden_why()
	if not party_enabled then return "disabled by the player" end
	local why = {}
	local function add(cond, text) if cond then why[#why + 1] = text end end
	pcall(function()
		add(rawget(_G, "_HUD_STATE") == false, "HUD indicators off")
		local am = rawget(_G, "actor_menu")
		add(am and am.last_mode ~= 0, "actor menu open")
		local pda_m = rawget(_G, "pda")
		add(pda_m and pda_m.dialog_closed ~= true, "talk dialog open")
		local guis = rawget(_G, "_GUIs")
		if type(guis) == "table" then
			for name in pairs(guis) do why[#why + 1] = "UI " .. tostring(name) .. " registered" end
		end
		local gcc = rawget(_G, "get_console_cmd")
		add(gcc and gcc(1, "hud_draw") == false, "hud_draw 0")
		local ax = rawget(_G, "axr_main")
		add(ax and (ax.binoc_is_zoomed or ax.scoped_weapon_is_zoomed), "zoomed")
	end)
	return #why > 0 and table.concat(why, ", ") or "?"
end

-- "Visor" panel: only a dying row moves. Sizes: px at 1080 high, units = px * U down and px * U * kx across. Own numbers,
-- not coop_hud_layout: that table gives only where the panel stands (team_x, team_top / team_bottom).
local U = 768 / 1080
local V = {
	pitch = 58, -- row to row, straight down (no stair)
	pitch_compact = 46, -- more than ROWS_FULL rows (a server's 8..15): one row's own height (the bracket) and a gap
	brk_w = 8, brk_h = 42, brk_line = 2, -- the "[" in his colour; brk_line: a plain bar while the Visor atlas is missing
	nick_x = 14, nick_y = 1, nick_h = 18, nick_max = 130,
	star_gap = 5, star = 12, star_y = 4,
	dist_r = 222, dist_y = 2, dist_h = 16, dist_gap = 8, -- the metres end at 222 px
	arrow_cx = 236, arrow_cy = 10, arrow = 14,
	seg_x = 14, seg_y = 33, seg_w = 38, seg_gap = 4, seg_h = 3, -- 4 x 38 px, 4 apart: 164 px
	pulse_w = 23, pulse_h = 21, pulse_base = 15, lane = 0.5, -- a beat frame: its baseline 15 px from the top, 0.5 px over the segments
	head_w = 2, -- the white cursor running ahead of the beats
	timer_x = 190, timer_y = 26, timer_h = 16,
	icon_cx = 240, icon_cy = 31, icon = 16,
	right = 248, -- the row's right edge (bounds)
}
local SWEEP_MS = 2600 -- the dying heart's beats run over the segments in 2.6 s
local PULSES = 8 -- beat statics per row (an uneven beat every 0.32..1.27 s, each fades over one sweep)
local PULSE_FRAMES = 8 -- coop_h3_pulse_0..7: the beat drawn from 1/8 to whole
local PULSE_TEX = {} -- frame -> its texture id
for i = 0, PULSE_FRAMES - 1 do PULSE_TEX[i] = "coop_h3_pulse_" .. i end
local EMPTY_A = 0.18 -- the empty part of the segments

local CLR = {
	white = { 244, 245, 246 }, -- segments
	nick = { 247, 244, 236 }, -- #F7F4EC
	ink = { 241, 236, 223 }, -- #F1ECDF: the metres, the arrow
	dim = { 168, 163, 152 }, -- #A8A398: the nick of a dead / spectating / silent player
	dim_text = { 185, 180, 168 }, -- #B9B4A8: his returning timer, the spectator's eye
	brk_dim = { 142, 138, 128 }, -- #8E8A80: bracket and badge of a dead / spectating / silent player
	amber = { 224, 164, 60 }, -- #E0A43C: no signal, "loading"
	grey = { 120, 120, 120 }, -- segments of a dead / spectating player
	camp = { 146, 190, 154 }, -- sage #92BE9A: sleeping, a new checkpoint
}
local A_SHADOW = 0.75
local LOW_HP = 0.3
local SEGS = 4 -- 4 segments of 25 %
local GREYED = { dead = true, spec = true, respawn = true }
local RESTING = { resting = true, sleeping = true }

-- The Visor atlas (ui_coop_hud3) and its id -> the older ui_coop_hud id while it is missing (nil: the static is skipped).
local H3_FILES = { { "$game_textures$", "ui\\coop\\ui_coop_hud3.dds" } } -- the file coop_hud_compass looks for too
local TEX_OLD = {
	bracket_l = "coop_hud_white", host_star = "coop_hud_star", needle = "coop_hud_arrow",
	ally_down = "coop_hud_cross", ally_revive = "coop_hud_cross", ally_dead = "coop_hud_skull",
	ally_spectator = "coop_hud_eye", ally_offline = "coop_hud_warn", sleep = "coop_hud_z", camp = "coop_hud_tent",
}
local h3_present -- nil: not looked yet

-- Is the Visor atlas there (looked once per Lua state)? set_atlas3(bool | nil) tells it (tests), nil looks again.
function atlas3()
	if h3_present == nil then
		local ok, yes = pcall(function()
			local fs = rawget(_G, "getFS")()
			for _, f in ipairs(H3_FILES) do
				local found = fs:exist(f[1], f[2])
				if found == nil or found == false then return false end
			end
			return true
		end)
		h3_present = ok and yes == true
	end
	return h3_present
end

function set_atlas3(on)
	h3_present = on
end

local function tex3(name)
	if atlas3() then return "coop_h3_" .. name end
	return TEX_OLD[name]
end

-- The Visor font of a role ("nick" | "small"), nil: keep the xml's font.
local function font3(role)
	local F = rawget(_G, "coop_hud3_fonts")
	if not (F and type(F.font) == "function") then return nil end
	local ok, f = pcall(F.font, role)
	return ok and f or nil
end

local function compass()
	return rawget(_G, "coop_hud_compass")
end

local function markers()
	return rawget(_G, "coop_hud_markers")
end

-- Seconds before a dead player stands up again, when the engine tells (coop.respawn_left, ms); nil otherwise.
local function respawn_left(avatar)
	if not (api and api.respawn_left and type(avatar) == "number") then return nil end
	local ok, ms = pcall(api.respawn_left, avatar)
	ms = ok and tonumber(ms) or nil
	if not ms or ms <= 0 then return nil end
	return ms / 1000
end

local function rest_state(avatar)
	local r = api and api.rest
	if not (type(r) == "table" and type(r.state_of) == "function" and type(avatar) == "number") then return nil end
	local ok, s = pcall(r.state_of, avatar)
	return ok and s or nil
end

-- The seam of the row while player `peer` is being revived by `by_peer`: frac 0..1 fills his red segments in the reviver's
-- colour; frac nil ends it. coop_hud_revive feeds it while the local player holds USE on a downed ally.
local reviving = {} -- peer -> { frac, by }
function set_revive(peer, frac, by_peer)
	if type(peer) ~= "number" then return end
	frac = tonumber(frac)
	if frac then
		reviving[peer] = { frac = math_max(0, math_min(1, frac)), by = tonumber(by_peer) }
	else
		reviving[peer] = nil
	end
end

local function text_color(t, c)
	if t.tc ~= c then
		t.tc = c
		t.e:SetTextColor(c)
	end
end

local function set_tex(t, tex)
	if tex and t.tex ~= tex then
		t.tex = tex
		t.e:InitTexture(tex)
		t.e:SetStretchTexture(true)
	end
end

local function ux(m, v) return v * U * m.kx end
local function uy(v) return v * U end

local function set_font(w, f)
	if f then pcall(function() w:SetFont(f) end) end
end

-- Park-Miller: the dying heart's uneven rhythm, per row (no math.random: other scripts share it)
local function rnd(r)
	r.rng = (r.rng * 16807) % 2147483647
	return r.rng / 2147483647
end

class "UICoopParty" (CUIScriptWnd)

function UICoopParty:__init() super()
	self.team_panel = true -- how status lines and tests tell this window from the chat feed (which has rows too)
	self.next_at = 0
	self.rows = {}
	self.shown = {} -- rows in use since the last refresh
	self.track = {} -- peer -> what the row remembers between refreshes (the down / respawn totals)
	self.width_cache = {}
	self:InitControls()
end

function UICoopParty:__finalize()
end

function UICoopParty:InitControls()
	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)
	self.xml = xml
	-- one root for the whole panel; the depth spring moves only it, the rows never move against each other
	self.root = el(xml:InitStatic("team_row", self), 0, 0, 0, 0) -- where the xml puts it
	self:AddRows(allies().others_max())
	self:Relayout()
end

-- Rows up to `want` (the session's other players); a row made later is laid out at once. Every static of a row is
-- made here (a pool): nothing is created in a frame.
function UICoopParty:AddRows(want)
	local xml = self.xml
	local root = self.root.e
	for i = #self.rows + 1, want do
		local r = {}
		r.base = el(xml:InitStatic("team_row", root))
		local b = r.base.e
		r.bracket = el(xml:InitStatic("team_row:bracket", b)) -- the "[" in his colour
		r.segs = {}
		for k = 1, SEGS do
			r.segs[k] = {
				bg = el(xml:InitStatic("team_row:bar", b)),
				fill = el(xml:InitStatic("team_row:bar", b)),
				over = el(xml:InitStatic("team_row:bar", b)), -- revive / respawn fill over the base fill
			}
		end
		r.pulses = {}
		for k = 1, PULSES do r.pulses[k] = el(xml:InitStatic("team_row:pulse", b)) end
		r.head = el(xml:InitStatic("team_row:bar", b))
		r.name_sh = el(xml:InitTextWnd("team_row:label", b))
		r.name = el(xml:InitTextWnd("team_row:label", b))
		r.host = el(xml:InitStatic("team_row:icon", b))
		r.dist_sh = el(xml:InitTextWnd("team_row:label", b))
		r.dist = el(xml:InitTextWnd("team_row:label", b))
		r.arrow = el(xml:InitStatic("team_row:arrow", b))
		r.icon = el(xml:InitStatic("team_row:icon", b))
		r.timer_sh = el(xml:InitTextWnd("team_row:label", b))
		r.timer = el(xml:InitTextWnd("team_row:label", b))
		r.measure = xml:InitTextWnd("team_row:label", b) -- widths in the nick font
		r.measure_s = xml:InitTextWnd("team_row:label", b) -- widths in the small font
		r.measure:Show(false)
		r.measure_s:Show(false)
		for _, p in ipairs(r.pulses) do p.e:Show(false) end
		r.head.e:Show(false)
		r.beats = {}
		pcall(function() r.arrow.e:EnableHeading(true) end)
		pcall(function() r.name.e:SetEllipsis(true) end)
		pcall(function() r.name_sh.e:SetEllipsis(true) end)
		b:Show(false)
		self.rows[i] = r
		if self.m then self:LayoutRow(r) end
	end
end

-- Sizes of everything that does not depend on the texts; the atlas and the fonts are looked up here.
function UICoopParty:Relayout()
	self.m, self.L = metrics(), coop_hud_layout.get()
	self.width_cache = {}
	self.h3 = atlas3()
	self.fonts = { nick = font3("nick"), small = font3("small") }
	self.fonts_wait = rawget(_G, "coop_hud3_fonts") == nil -- the fonts module may come later: look again at a refresh
	for _, r in ipairs(self.rows) do self:LayoutRow(r) end
end

local function forget(t)
	t.x, t.y, t.w, t.h = nil, nil, nil, nil
end

function UICoopParty:LayoutRow(r)
	local m = self.m
	for _, t in pairs(r) do
		if type(t) == "table" and t.e then forget(t) end
	end
	for _, s in ipairs(r.segs) do for _, t in pairs(s) do forget(t) end end
	for _, t in ipairs(r.pulses) do forget(t) end
	put(r.base, 0, 0, 1, 1)
	local brk = tex3("bracket_l")
	set_tex(r.bracket, brk)
	show(r.bracket, brk ~= nil)
	put(r.bracket, 0, 0, ux(m, self.h3 and V.brk_w or V.brk_line), uy(V.brk_h))
	local sw = ux(m, V.seg_w)
	for k = 1, SEGS do
		local s = r.segs[k]
		local x = ux(m, V.seg_x + (k - 1) * (V.seg_w + V.seg_gap))
		put(s.bg, x, uy(V.seg_y), sw, uy(V.seg_h))
		put(s.fill, x, uy(V.seg_y), sw, uy(V.seg_h))
		put(s.over, x, uy(V.seg_y), sw, uy(V.seg_h))
		color(s.bg, argb(255 * EMPTY_A, CLR.white))
	end
	r.seg_x0 = ux(m, V.seg_x)
	r.seg_span = ux(m, SEGS * V.seg_w + (SEGS - 1) * V.seg_gap)
	put(r.head, r.seg_x0, uy(V.seg_y - 1.5), ux(m, V.head_w), uy(V.seg_h + 3))
	put(r.icon, ux(m, V.icon_cx - V.icon / 2), uy(V.icon_cy - V.icon / 2), ux(m, V.icon), uy(V.icon))
	-- turned (heading): the box stays square in units, the engine squeezes it across
	put(r.arrow, 0, 0, uy(V.arrow), uy(V.arrow))
	put(r.host, 0, uy(V.star_y), ux(m, V.star), uy(V.star))
	local star, needle = tex3("host_star"), tex3("needle")
	if star then set_tex(r.host, star) end
	if needle then set_tex(r.arrow, needle) end
	local F = self.fonts
	for _, t in ipairs({ r.name.e, r.name_sh.e, r.measure }) do set_font(t, F.nick) end
	for _, t in ipairs({ r.dist.e, r.dist_sh.e, r.timer.e, r.timer_sh.e, r.measure_s }) do set_font(t, F.small) end
	r.beating = nil
	r._nick, r._nick_sh, r._dist, r._timer = nil, nil, nil, nil
end

-- Width (units) of a text in the nick font (small: the small font), measured once per text.
function UICoopParty:TextWidth(r, text, small)
	local key = (small and "s|" or "n|") .. text
	local w = self.width_cache[key]
	if w then return w end
	local ms = small and r.measure_s or r.measure
	ms:SetText(text)
	local ok = pcall(function() ms:AdjustWidthToText() end)
	w = ok and ms:GetWidth() or (#text * 6 * self.m.kx)
	self.width_cache[key] = w
	return w
end

-- The compact pitch, for more than ROWS_FULL rows (a server's 8..15 other players): one row's own height (the
-- bracket, 42 px) and a gap. 15 rows from team_top end well above the own HUD.
function compact_pitch(L)
	return V.pitch_compact * U
end

-- From one row to the next, straight down (no stair): 58 px at 1080 for up to ROWS_FULL rows, else the compact pitch.
function row_pitch(L, n)
	if n > ROWS_FULL then return compact_pitch(L) end
	return V.pitch * U
end

-- Top of row i of n, the host on top: down from team_top, or (team_top < 0) hanging from team_bottom upwards.
local function row_top(L, i, n)
	local pitch = row_pitch(L, n)
	if L.team_top >= 0 then return L.team_top + (i - 1) * pitch end
	return L.team_bottom - uy(V.brk_h) - (n - i) * pitch
end

function UICoopParty:Place(r, i, n)
	local L = self.L
	local top = row_top(L, i, n)
	put(r.base, L.team_x * self.m.kx, top)
	r.top = top
end

function UICoopParty:Bounds(n)
	if n == 0 then return nil end
	local L, m = self.L, self.m
	local l = L.team_x * m.kx
	return { l = l, r = l + ux(m, V.right), t = row_top(L, 1, n), b = row_top(L, n, n) + uy(V.brk_h) }
end

local function set_text(t, text, field_owner, field)
	if field_owner[field] ~= text then
		field_owner[field] = text
		t.e:SetText(text)
	end
end

-- Texts and their places (2 Hz): nick, host star, distance, arrow place.
function UICoopParty:Fill(r, v, tg)
	local A = allies()
	local m = self.m
	local tr_ = self.track[v.peer]
	if not tr_ then
		tr_ = {}
		self.track[v.peer] = tr_
	end
	if v.state == "down" then
		if tr_.state ~= "down" then tr_.down_total = nil end
		if v.bleed then tr_.down_total = math_max(tr_.down_total or 0, v.bleed) end
	end
	local left = (v.state == "dead" or v.state == "respawn") and respawn_left(v.avatar) or nil
	if left then
		if not GREYED[tr_.state] then tr_.resp_total = nil end
		tr_.resp_total = math_max(tr_.resp_total or 0, left)
	end
	tr_.state = v.state
	r.view, r.at, r.track, r.left = v, tg, tr_, left
	-- lying down for the shared sleep; his checkpoint changed < 10 s ago
	r.rest = v.state == "alive" and RESTING[rest_state(v.avatar) or ""] or false
	r.camp = v.state == "alive" and A.checkpoint_mark(v.avatar) ~= nil
	r.color = { A.color(v.peer) }
	r.red = { A.state_color("down") } -- the bleed-out segments, a low health, the beats
	-- nick (white, shadow), host star
	local nx, ny, nh = ux(m, V.nick_x), uy(V.nick_y), uy(V.nick_h)
	local nw = math_min(self:TextWidth(r, v.nick), ux(m, V.nick_max))
	set_text(r.name, v.nick, r, "_nick")
	set_text(r.name_sh, v.nick, r, "_nick_sh")
	put(r.name, nx, ny, nw, nh)
	put(r.name_sh, nx + m.px, ny + m.py, nw, nh)
	local x = nx + nw
	show(r.host, v.host and r.host.tex ~= nil)
	if v.host then
		put(r.host, x + ux(m, V.star_gap), uy(V.star_y))
		x = x + ux(m, V.star_gap + V.star)
	end
	-- the metres end at 222 px (tabular digits), never over the nick; a long text (a map, "loading") pushes the arrow on
	local dist = place_text(v) or ""
	local dw = dist ~= "" and self:TextWidth(r, dist, true) or 0
	if r._dist ~= dist then
		r._dist = dist
		r.dist.e:SetText(dist)
		r.dist_sh.e:SetText(dist)
	end
	local dx = math_max(ux(m, V.dist_r) - dw, x + ux(m, V.dist_gap))
	local dy, dh = uy(V.dist_y), uy(V.dist_h)
	put(r.dist, dx, dy, dw, dh)
	put(r.dist_sh, dx + m.px, dy + m.py, dw, dh)
	show(r.dist, dist ~= "")
	show(r.dist_sh, dist ~= "")
	local acx = math_max(ux(m, V.arrow_cx), dx + dw + ux(m, V.arrow / 2 + 2))
	put(r.arrow, acx - uy(V.arrow) / 2, uy(V.arrow_cy - V.arrow / 2))
	r.pos = v.pos
end

-- Fill of segment k (1..4) for a share 0..1 of the whole bar.
local function seg_share(frac, k)
	return math_max(0, math_min(1, frac * SEGS - (k - 1)))
end

-- The dying heart (only that he is dying, no other animation): beats at an uneven rhythm where a
-- 2.6 s sweep stands on the segments, each a coop_h3_pulse_* frame drawn in as the sweep passes and fading over one sweep;
-- a white cursor runs ahead. No Visor atlas: no beats (the statics stay hidden).
function UICoopParty:Beat(r, tg, on)
	local ps = r.pulses
	if not (on and self.h3) then
		if r.beating ~= false then
			r.beating = false
			for _, p in ipairs(ps) do show(p, false) end
			show(r.head, false)
		end
		return
	end
	local m = self.m
	local span, x0 = r.seg_span, r.seg_x0
	if not r.beating then
		r.beating = true
		r.beats, r.beat_i = {}, 0
		r.next_beat = tg
		r.rng = ((r.view and r.view.peer or 0) + 1) * 7919 + 17
	end
	if tg - r.next_beat > SWEEP_MS then r.next_beat = tg end -- a long pause (menu): no burst of old beats
	local pw = ux(m, V.pulse_w)
	while r.next_beat <= tg do
		local at = r.next_beat
		local per, amp = 320 + rnd(r) * 950, 0.35 + rnd(r) * 0.75
		r.next_beat = at + per
		local bx = ((at % SWEEP_MS) / SWEEP_MS) * span
		if bx + pw * 0.6 <= span then
			local i = r.beat_i % PULSES + 1
			r.beat_i = i
			r.beats[i] = { at = at, x = bx, a = amp }
			put(ps[i], x0 + bx, uy(V.seg_y - V.lane - V.pulse_base * amp), pw, uy(V.pulse_h * amp))
		end
	end
	local red = r.red
	for i = 1, PULSES do
		local b, p = r.beats[i], ps[i]
		local age = b and (tg - b.at) or SWEEP_MS
		if age < 0 or age > SWEEP_MS * 0.97 then
			show(p, false)
		else
			local drawn = age * span / SWEEP_MS
			local frame = math_min(PULSE_FRAMES - 1, math_floor(drawn / pw * PULSE_FRAMES))
			set_tex(p, PULSE_TEX[frame])
			color(p, argb(255 * (1 - age / SWEEP_MS) ^ 1.25, red))
			show(p, true)
		end
	end
	local head = ((tg % SWEEP_MS) / SWEEP_MS) * span
	put(r.head, x0 + head - ux(m, V.head_w) / 2, r.head.y)
	color(r.head, argb(230, CLR.white))
	show(r.head, true)
end

-- Everything that changes between refreshes (every frame): segments, the state badge, the timer, the beats, the arrow.
-- Full brightness always; only a dying row moves.
function UICoopParty:Animate(r, tg, heading, cam)
	local v, tr_ = r.view, r.track
	local A, M = allies(), amap()
	local m = self.m
	local seg_w = ux(m, V.seg_w)
	local nick_c, nick_a, brk_c = CLR.nick, 1, r.color
	local fill_frac, fill_c = 0, CLR.white
	local over_frac, over_c = 0, nil
	local icon, icon_c, icon_a = nil, nil, 1
	local timer, timer_c, timer_a = nil, nil, 1
	local dying = false
	local since = (tg - (r.at or tg)) / 1000
	if v.loading then
		nick_a = 0.5 -- not in this world yet: no health to show, "loading" in amber where the metres stand
	elseif v.state == "down" then
		local left = v.bleed and math_max(0, v.bleed - since) or nil
		local total = tr_.down_total
		fill_frac = (left and total and total > 0) and math_min(1, left / total) or 1 -- the segments melt as his timer
		fill_c = r.red
		if left then timer, timer_c = M.format_time(math.ceil(left)), fill_c end
		local rv = reviving[v.peer]
		if rv then
			over_frac = rv.frac * fill_frac
			over_c = rv.by and { A.color(rv.by) } or CLR.white
			icon, icon_c = "ally_revive", r.color
		else
			dying = true
			icon, icon_c = "ally_down", r.color
			local p = 0.7 + 0.3 * (0.5 + 0.5 * math.sin(tg * 2 * math.pi / 1000)) -- the timer and the badge at 1 Hz
			icon_a, timer_a = p, p
		end
	elseif GREYED[v.state] then
		fill_frac, fill_c = 1, CLR.grey
		nick_c, brk_c = CLR.dim, CLR.brk_dim
		if v.state == "spec" then
			icon, icon_c = "ally_spectator", CLR.dim_text
		else
			icon, icon_c = "ally_dead", CLR.brk_dim
			local left = r.left and math_max(0, r.left - since) or nil
			if left and tr_.resp_total and tr_.resp_total > 0 then
				over_frac, over_c = 1 - left / tr_.resp_total, CLR.white -- coming back: white fills the grey bar
				timer, timer_c = M.format_time(math.ceil(left)), CLR.dim_text
			end
		end
	elseif v.state == "unknown" then
		icon, icon_c = "ally_offline", CLR.amber
		nick_c, nick_a, brk_c = CLR.dim, 0.5, CLR.brk_dim
		fill_frac = v.hp or 0
	else
		fill_frac = v.hp or 0
		if fill_frac < LOW_HP then fill_c = r.red end
		if r.rest then
			icon, icon_c = "sleep", CLR.camp
		elseif r.camp then
			icon, icon_c = "camp", CLR.camp
		end
	end
	-- bracket, nick, distance, star
	color(r.bracket, argb(255, brk_c))
	text_color(r.name, argb(255 * nick_a, nick_c))
	text_color(r.name_sh, GetARGB(math_floor(255 * A_SHADOW * nick_a), 0, 0, 0))
	text_color(r.dist, argb(255, v.loading and CLR.amber or CLR.ink))
	text_color(r.dist_sh, GetARGB(math_floor(255 * A_SHADOW), 0, 0, 0))
	if v.host then color(r.host, argb(255, GREYED[v.state] and CLR.brk_dim or r.color)) end -- the host's star in his colour
	-- segments
	for k = 1, SEGS do
		local s = r.segs[k]
		local f = seg_share(fill_frac, k)
		put(s.fill, s.fill.x, s.fill.y, seg_w * f, s.fill.h)
		color(s.fill, argb(255, fill_c))
		show(s.fill, f > 0)
		local o = over_c and seg_share(over_frac, k) or 0
		show(s.over, o > 0)
		if o > 0 then
			put(s.over, s.over.x, s.over.y, seg_w * o, s.over.h)
			color(s.over, argb(255, over_c))
		end
	end
	self:Beat(r, tg, dying)
	-- state badge, timer
	local itex = icon and tex3(icon)
	show(r.icon, itex ~= nil)
	if itex then
		set_tex(r.icon, itex)
		color(r.icon, argb(255 * icon_a, icon_c))
	end
	show(r.timer, timer ~= nil)
	show(r.timer_sh, timer ~= nil)
	if timer then
		local tw = self:TextWidth(r, timer, true)
		local tx, ty, th = ux(m, V.timer_x), uy(V.timer_y), uy(V.timer_h)
		if r._timer ~= timer then
			r._timer = timer
			r.timer.e:SetText(timer)
			r.timer_sh.e:SetText(timer)
		end
		put(r.timer, tx, ty, tw, th)
		put(r.timer_sh, tx + m.px, ty + m.py, tw, th)
		text_color(r.timer, argb(255 * timer_a, timer_c))
		text_color(r.timer_sh, GetARGB(math_floor(255 * A_SHADOW * timer_a), 0, 0, 0))
	end
	-- arrow: relative to the camera
	local on = false
	local C = compass()
	if heading and cam and r.pos and C and r.arrow.tex then
		local b = C.bearing(cam, r.pos)
		if b then
			r.arrow.e:SetHeading(-math.rad(C.rel_angle(b, heading)))
			color(r.arrow, argb(255, GREYED[v.state] and CLR.dim or CLR.ink))
			on = true
		end
	end
	show(r.arrow, on)
end

-- The whole panel on the near depth layer (coop_hud_depth, units of 1024x768), in whole screen pixels; no module: 0.
function UICoopParty:Depth()
	local dx, dy = 0, 0
	local D = rawget(_G, "coop_hud_depth")
	if D and type(D.offset) == "function" then
		local ok, x, y = pcall(D.offset, "near")
		if ok then dx, dy = tonumber(x) or 0, tonumber(y) or 0 end
	end
	local m = self.m
	if m then
		dx = math_floor(dx / m.px + 0.5) * m.px
		dy = math_floor(dy / m.py + 0.5) * m.py
	end
	put(self.root, dx, dy)
end

function UICoopParty:Refresh(tg)
	local list = {}
	self.vis = party_enabled and hud_visible()
	if self.vis and live() then
		list = shared_views(tg, true) -- the list the transition board reads too
	end
	local m = metrics()
	if not self.m or m.W ~= self.m.W or m.H ~= self.m.H or coop_hud_layout.get() ~= self.L
		or (self.fonts_wait and rawget(_G, "coop_hud3_fonts") ~= nil) then
		self:Relayout()
	end
	local most = allies().others_max() -- the session's other players (a Welcome after the panel was made can say more)
	if most > #self.rows then self:AddRows(most) end
	local n = math_min(#list, most)
	self.shown = {}
	local seen = {}
	for i = 1, #self.rows do
		local r, v = self.rows[i], list[i]
		if v and i <= n then
			self:Fill(r, v, tg)
			self:Place(r, i, n)
			show(r.base, true)
			self.shown[#self.shown + 1] = r
			seen[v.peer] = true
		else
			show(r.base, false)
			r.pos, r.view = nil, nil
		end
	end
	for peer in pairs(self.track) do
		if not seen[peer] then self.track[peer] = nil end
	end
	self.bounds = self:Bounds(n)
end

function UICoopParty:Frame(tg)
	self:Depth()
	local C = compass()
	local dev = device()
	local dir, cam = dev.cam_dir, dev.cam_pos
	local heading = (C and dir and C.heading_of) and C.heading_of(dir) or nil
	for _, r in ipairs(self.shown) do self:Animate(r, tg, heading, cam) end
end

function UICoopParty:Update()
	CUIScriptWnd.Update(self)
	local tg = time_global()
	local Mk = markers()
	local pf = Mk and Mk.perf_start and Mk.perf_start("panel")
	-- inventory / PDA / scope opened or closed: hide or show at once, not at the next 2 Hz refresh
	if (party_enabled and hud_visible()) ~= self.vis then self.next_at = 0 end
	if tg >= self.next_at then
		self.next_at = tg + PANEL_MS
		local ok, err = pcall(self.Refresh, self, tg)
		if not ok then
			self.next_at = tg + 5000
			log("! party panel refresh failed: %s", tostring(err))
		end
	end
	if self.shown[1] then
		local ok, err = pcall(self.Frame, self, tg)
		if not ok and not self.frame_err then
			self.frame_err = true
			log("! party panel frame failed: %s", tostring(err))
		end
	end
	if pf then Mk.perf_stop(pf) end
end

local PARTY -- HUD dialog, while this Lua state lives

local function party_on()
	if PARTY then return end
	local ok, err = pcall(function()
		PARTY = UICoopParty()
		get_hud():AddDialogToRender(PARTY)
	end)
	if not ok then
		PARTY = nil
		log("! party panel failed: %s", tostring(err))
	end
end

local function party_off()
	if not PARTY then return end
	pcall(function() get_hud():RemoveDialogToRender(PARTY) end)
	PARTY = nil
end

function set_party_enabled(on)
	party_enabled = on and true or false
	if PARTY then PARTY.next_at = 0 end
end

function set_spots_enabled(on)
	spots_enabled = on and true or false
end

-------------------------------------------------------------------------------
-- Update, callbacks
-------------------------------------------------------------------------------
local next_status, next_spots = 0, 0
local spots_down = false -- somebody is down: the overlay pulses every frame

local function update_spots(tg)
	local list, by_avatar = views(tg)
	place_far(list)
	local M = amap()
	M.sync(by_avatar, spots_enabled)
	spots_down = false
	for _, v in pairs(by_avatar) do
		if v.state == "down" then spots_down = true end
	end
	spots_down = spots_down and M.is_ready()
end

local function actor_on_update()
	if not api then return end
	local tg = time_global()
	if live() then
		if not modules_ok() then return end
		party_on()
		if tg >= next_status then
			next_status = tg + STATUS_MS
			local ok, err = pcall(send_status, tg)
			if not ok then log("! status not sent: %s", tostring(err)) end
		end
		if tg >= next_spots then
			next_spots = tg + SPOTS_MS
			local ok, err = pcall(update_spots, tg)
			if not ok then
				next_spots = tg + 10000
				log("! player markers: %s", tostring(err))
			end
		end
		if spots_down then
			local ok = map_call("pulse", tg)
			if not ok then spots_down = false end
		end
	elseif not api.is_active() then
		map_call("clear")
		spots_down = false
		if next(status) then status = {} end
		sent.payload = nil
		party_off()
	end
end

local function actor_on_net_destroy()
	map_call("clear")
	spots_down = false
	party_off()
end

function print_status()
	local n = 0
	for _ in pairs(status) do n = n + 1 end
	log("hud: status out %d, in %d (bad %d), players with status %d | party panel %s, %s",
		stats.status_out, stats.status_in, stats.status_bad, n, PARTY and "on" or "off",
		party_enabled and "enabled" or "disabled by the player")
	-- every other player as the panel sees him: one line answers "why is there no card for X"
	local ok, list = pcall(views)
	if ok and type(list) == "table" then
		local parts = {}
		for _, v in ipairs(list) do
			local st = status[v.peer]
			parts[#parts + 1] = string_format("#%d %s %s%s, %s, status %s", v.peer, tostring(v.nick), v.state,
				v.host and " (host)" or "", v.dist and string_format("%.0f m", v.dist) or "no avatar",
				st and string_format("%.0f s ago", (time_global() - st.at) / 1000) or "never")
		end
		log("hud: panel %s, %d other player(s)%s%s", PARTY and (PARTY.vis and "visible" or ("hidden: " .. hidden_why()))
			or "off", #list, #parts > 0 and ": " or "", table.concat(parts, "; "))
	end
	local A = allies()
	if A then pcall(A.print_status) end
	map_call("print_status")
	-- frame time and marker sources, the compass, the ping, the Tactical Compass adapter
	for _, name in ipairs({ "coop_hud_markers", "coop_hud_compass", "coop_hud_ping", "coop_hud_tc", "coop_hud_revive" }) do
		local m = rawget(_G, name)
		if m and m.print_status then
			local ok, err = pcall(m.print_status)
			if not ok then log("! %s.print_status: %s", name, tostring(err)) end
		end
	end
end

-- A resolution change brings the minimap back although video/hud/show_minimap is off: the engine
-- rebuilds the game UI then (CHUDManager::OnScreenResolutionChanged: UnLoad + Load), the new main window shows the
-- minimap, and the game applies the option on the first update only (actor_effects.actor_on_first_update).
local function on_screen_resolution_changed()
	local ok, err = pcall(function()
		local main = ActorMenu and ActorMenu.get_maingame()
		if not (main and main.UIZoneMap and ui_options) then return end
		local on = ui_options.get("video/hud/show_minimap") and true or false
		main.UIZoneMap.disabled = not on
		if main.UIMotionIcon then main.UIMotionIcon:Show(on) end
	end)
	if not ok then log("! the minimap option after a resolution change: %s", tostring(err)) end
end

function on_game_start()
	coop_util.add_status("coop_core_hud", 50)
	if not api then return end -- an exe without co-op: nothing of this runs
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("on_screen_resolution_changed", on_screen_resolution_changed)
	local cm = codec()
	if cm and cm.add_event_handler then cm.add_event_handler(EV_STATUS, on_status) end
end
