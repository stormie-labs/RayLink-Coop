--[[
	Anomaly Coop - core group: who is where (gamedata\scripts\coop_core_hud.script). W4 core, reworked by W6 (allies UI).
	Layout configs\ui\ui_coop_core.xml (party, party_row) + the stock companion slot of ui_hud.xml.
	Colours and state rules: coop_allies.script. Map markers: coop_allies_map.script (+ modxml_coop_allies.script).

	1. Status: every player sends its own health, state, community, portrait and bleed-out time to the others
	   ("core.status", about once a second, more often on a change). Proxies are not harmed on the other machines,
	   so their engine health tells nothing; this is the only source of a teammate's health. The engine's
	   survival state (coop.life_of, W5 C1) wins over the reported state when it exists.
	2. Party panel on the HUD, top right: one entry per other player, sorted by peer id (host first), in the
	   player's colour (tab, nick, host star). Up to 4 players: portrait cards like the stock companion slot
	   (distance or state plate, red pulsing medic badge while down, grey portrait when dead/spectating, health bar;
	   W8: an eye badge while spectating, an amber warning while the player's status stopped coming);
	   5..7 players, or 4 on a screen too low for the cards (720p, 768p): compact rows. Scaled with the screen
	   height (1080p and below = stock pixel size), hidden with the main HUD (inventory, PDA, scope) at once.
	   The stock companion column moves left of the panel only while the two would overlap.
	3. Minimap / PDA markers of other players: coop_allies_map (arrow in the player's colour turning with his
	   heading, edge pointer, "needs help" overlay, grey marker when dead), updated 5 times a second.

	For other scripts:
		coop_core_hud.status_of(peer) -> { h = 0..1, s = state, f = community, i = icon, b = bleed s | nil, at } | nil
		coop_core_hud.views() -> list of other players { peer, slot, nick, host, state, bleed, hp, avatar, dist, icon }
		coop_core_hud.set_party_enabled(bool) / set_spots_enabled(bool)
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local string_format = string.format
local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall
local math_max, math_min, math_floor = math.max, math.min, math.floor

local EV_STATUS = "core.status"
local STATUS_MS = 1000 -- check own status this often
local STATUS_KEEPALIVE_MS = 5000 -- resend an unchanged status
local PANEL_MS = 500 -- party panel refresh (2 Hz)
local SPOTS_MS = 200 -- map markers (5 Hz)
local MAX_ENTRIES = 7 -- host + 7 clients
local FULL_MAX = 4 -- up to this many: portrait cards, more: compact rows
local XML_FILE = "ui_coop_core.xml"
local NO_ICON = "ui\\ui_noise"
local TOP_UNITS = 74 -- panel top in the 1024x768 space: below the stock hud_timer (0..66)
local BOTTOM_UNITS = 340 -- portrait cards must end above this: stock warning icons (icons_scroll_view) start at 350
local EDGE_PX = 10 -- panel to the right screen edge, px at 1080p
local GAP_UNITS = 6 -- panel to the companion column

-- px at 1080p of one entry (the XML coordinates are in the same pixels)
local CARD = { w = 90, h = 67, gap = 10 }
local ROW = { w = 160, h = 26, gap = 4 }

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-hud] %s", ok and line or tostring(fmt))
end

local function live()
	return api ~= nil and api.is_active() and (api.is_host() or api.is_live())
end

local function players()
	if not api then return {} end
	local ok, list = pcall(api.players)
	return ok and type(list) == "table" and list or {}
end

local function codec()
	return rawget(_G, "coop_main") or coop_main
end

local function allies()
	return rawget(_G, "coop_allies") or coop_allies
end

local function amap()
	return rawget(_G, "coop_allies_map") or coop_allies_map
end

-- coop_allies / coop_allies_map ship with this file; if one of them failed to load, say so once and keep quiet.
local missing_logged = false
local function modules_ok()
	if allies() and amap() then return true end
	if not missing_logged then
		missing_logged = true
		printf("[coop-hud] ! coop_allies.script or coop_allies_map.script is missing: no party panel, no markers")
	end
	return false
end

local function map_call(name, ...)
	local m = amap()
	local f = m and m[name]
	if not f then return false end
	return pcall(f, ...)
end

local party_enabled, spots_enabled = true, true
local stats = { status_out = 0, status_in = 0, status_bad = 0 }

-------------------------------------------------------------------------------
-- Status
-------------------------------------------------------------------------------
local status = {} -- peer id -> { h, s, f, i, b, at }
local sent = { payload = nil, at = 0 }

local function own_state(actor)
	local s = allies().engine_state(0) -- engine survival state (W5 C1), when present
	if s then return s end
	if not actor:alive() then return "dead" end
	return actor.health <= 0.011 and "down" or "alive" -- a player who is down is pinned at 1% health
end

local function send_status(tg)
	local actor = db.actor
	if not actor then return end
	local icon = actor:character_icon()
	local t = {
		h = math_floor(math_max(0, math_min(1, actor.health)) * 100 + 0.5) / 100,
		s = own_state(actor),
		f = tostring(actor:character_community() or ""),
		i = type(icon) == "string" and icon or "",
	}
	if t.s == "down" then
		local b = allies().engine_bleed(0)
		if b then t.b = math_min(b, 3600) end
	end
	local payload = codec().encode(t)
	if payload == sent.payload and tg - sent.at < STATUS_KEEPALIVE_MS then return end
	if api.send_event(EV_STATUS, payload, -1) then
		sent.payload, sent.at = payload, tg
		stats.status_out = stats.status_out + 1
	end
end

local function on_status(payload, from)
	if type(from) ~= "number" or not allies() then return end
	local t = codec().decode(payload)
	local h = tonumber(t.h)
	local s = t.s
	if not (h and h >= 0 and h <= 1 and allies().is_wire_state(s)) then
		stats.status_bad = stats.status_bad + 1
		return
	end
	local f = type(t.f) == "string" and #t.f <= 40 and t.f:match("^[%w_]*$") and t.f or ""
	local i = type(t.i) == "string" and #t.i <= 96 and t.i:match("^[%w_\\/%.]*$") and t.i or ""
	local b = tonumber(t.b)
	b = (s == "down" and b and b >= 0 and b <= 3600) and math_floor(b) or nil
	status[from] = { h = h, s = s, f = f, i = i, b = b, at = time_global() }
	stats.status_in = stats.status_in + 1
end

function status_of(peer)
	return status[peer]
end

-------------------------------------------------------------------------------
-- Other players as the UI sees them
-------------------------------------------------------------------------------
local function avatar_of(p)
	local id = p.avatar_id
	if type(id) ~= "number" or id <= 0 or id >= 65535 then return nil, nil end
	local obj = level.object_by_id(id)
	return obj, obj and id or nil
end

function views(tg)
	tg = tg or time_global()
	local A = allies()
	local list, by_avatar = {}, {}
	local actor = db.actor
	for _, p in ipairs(players()) do
		if not p.is_self and type(p.id) == "number" then
			local st = status[p.id]
			local state, bleed = A.state_of(p, st, tg)
			local fresh = st and (tg - st.at) <= A.STATUS_STALE_MS
			local obj, id = avatar_of(p)
			local icon = st and st.i ~= "" and st.i or nil
			if not icon and obj then
				local ok, ic = pcall(obj.character_icon, obj)
				icon = ok and type(ic) == "string" and ic ~= "" and ic or nil
			end
			local v = {
				peer = p.id, slot = A.slot(p.id), nick = tostring(p.nick or "?"), host = p.id == 0,
				state = state, bleed = bleed, hp = fresh and st.h or nil, avatar = id, icon = icon,
				dist = (obj and actor) and obj:position():distance_to(actor:position()) or nil,
			}
			list[#list + 1] = v
			if id then by_avatar[id] = v end
		end
	end
	table.sort(list, function(a, b) return a.peer < b.peer end)
	return list, by_avatar
end

-------------------------------------------------------------------------------
-- Party panel
-------------------------------------------------------------------------------
local function hud_visible()
	local f = rawget(_G, "main_hud_shown")
	if not f then return true end
	local ok, v = pcall(f)
	return not ok or v == true
end

-- Why main_hud_shown() says no (status line only): the parts of the stock check (_g.script).
local function hidden_why()
	if not party_enabled then return "disabled by the player" end
	local why = {}
	local function add(cond, text) if cond then why[#why + 1] = text end end
	pcall(function()
		add(rawget(_G, "_HUD_STATE") == false, "HUD indicators off")
		local am = rawget(_G, "actor_menu")
		add(am and am.last_mode ~= 0, "actor menu open")
		local pda_m = rawget(_G, "pda")
		add(pda_m and pda_m.dialog_closed ~= true, "talk dialog open")
		local guis = rawget(_G, "_GUIs")
		if type(guis) == "table" then
			for name in pairs(guis) do why[#why + 1] = "UI " .. tostring(name) .. " registered" end
		end
		local gcc = rawget(_G, "get_console_cmd")
		add(gcc and gcc(1, "hud_draw") == false, "hud_draw 0")
		local ax = rawget(_G, "axr_main")
		add(ax and (ax.binoc_is_zoomed or ax.scoped_weapon_is_zoomed), "zoomed")
	end)
	return #why > 0 and table.concat(why, ", ") or "?"
end

local function argb(a, rgb)
	return GetARGB(a, rgb[1], rgb[2], rgb[3])
end

local CLR = {
	text = { 215, 215, 215 }, grey = { 150, 150, 150 },
	portrait = { alive = { 255, 255, 255 }, down = { 255, 165, 155 }, dead = { 105, 105, 105 },
		spec = { 105, 105, 105 }, respawn = { 105, 105, 105 }, unknown = { 170, 170, 170 } },
}
local GREYED = { dead = true, spec = true, respawn = true, unknown = true }
-- Badge in the middle of a card's portrait / before a row's state text (W8 icons: ui_coop_icons.xml).
-- rgb = texture tint; nil keeps the icon's own colours ("down" pulses in Pulse()).
local BADGE = {
	down = { tex = "coop_ally_badge_48" },
	spec = { tex = "coop_icon_eye_48", rgb = { 175, 175, 175 } },
	unknown = { tex = "coop_icon_alert_48" },
}

local function set_badge(entry, state)
	local bd = BADGE[state]
	entry.badge.e:Show(bd ~= nil)
	if not bd then return nil end
	if entry._badge ~= bd.tex then
		entry.badge.e:InitTexture(bd.tex)
		entry.badge.e:SetStretchTexture(true)
		entry._badge = bd.tex
	end
	if state ~= "down" then
		local c = bd.rgb or { 255, 255, 255 }
		entry.badge.e:SetTextureColor(GetARGB(255, c[1], c[2], c[3]))
	end
	return bd
end

-- Screen metrics: s = entry scale (1 at 1080p and below), k = px@1080 -> 1024x768 units.
local function metrics()
	local dev = device()
	local W, H = dev.width, dev.height
	local s = math_max(1, H / 1080)
	return { W = W, H = H, s = s, kx = s * 1024 / W, ky = s * 768 / H }
end

-- An XML element whose coordinates are px@1080, relative to its entry; the originals are kept for a relayout.
local function el(e)
	local p = e:GetWndPos()
	return { e = e, x = p.x, y = p.y, w = e:GetWidth(), h = e:GetHeight() }
end

local function fit(t, m)
	t.e:SetWndPos(vector2():set(t.x * m.kx, t.y * m.ky))
	t.e:SetWndSize(vector2():set(t.w * m.kx, t.h * m.ky))
end

-- Width (units) of the text now in a CUITextWnd; the window keeps the given size.
local function text_width(wnd, w_u, h_u)
	local ok = pcall(function() wnd:AdjustWidthToText() end)
	local tw = ok and wnd:GetWidth() or 0
	wnd:SetWndSize(vector2():set(w_u, h_u))
	return tw
end

class "UICoopParty" (CUIScriptWnd)

function UICoopParty:__init() super()
	self.next_at = 0
	self.cards, self.rows = {}, {}
	self.shown = {} -- entries in use this refresh (for the per-frame pulse)
	self:InitControls()
end

function UICoopParty:__finalize()
end

function UICoopParty:InitControls()
	local hud = utils_xml.get_hud_xml()
	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)
	for i = 1, FULL_MAX do
		local c = {}
		c.base = el(hud:InitStatic("companion_list:slot", self))
		local b = c.base.e
		c.background = el(hud:InitStatic("companion_list:slot:background", b))
		c.icon = el(hud:InitStatic("companion_list:slot:icon", b))
		c.hp = el(hud:InitProgressBar("companion_list:slot:health", b))
		c.strip = el(xml:InitStatic("party:strip", b))
		c.info_bg = el(xml:InitStatic("party:info_bg", b))
		c.info = el(xml:InitTextWnd("party:info", b))
		c.badge = el(xml:InitStatic("party:badge", b))
		c.name_bg = el(xml:InitStatic("party:name_bg", b))
		c.name = el(xml:InitTextWnd("party:name", b))
		c.host = el(xml:InitStatic("party:host", b))
		b:Show(false)
		self.cards[i] = c
	end
	for i = 1, MAX_ENTRIES do
		local r = {}
		r.base = el(xml:InitStatic("party_row", self))
		local b = r.base.e
		r.bg = el(xml:InitStatic("party_row:bg", b))
		r.strip = el(xml:InitStatic("party_row:strip", b))
		r.host = el(xml:InitStatic("party_row:host", b))
		r.name = el(xml:InitTextWnd("party_row:name", b))
		r.badge = el(xml:InitStatic("party_row:badge", b))
		r.info = el(xml:InitTextWnd("party_row:info", b))
		r.hp = el(xml:InitProgressBar("party_row:health", b))
		b:Show(false)
		self.rows[i] = r
	end
	self:Relayout()
end

function UICoopParty:Relayout()
	local m = metrics()
	self.m = m
	for _, set in ipairs({ self.cards, self.rows }) do
		for _, entry in ipairs(set) do
			for k, t in pairs(entry) do
				if k ~= "base" then fit(t, m) end
			end
			local b = entry.base
			b.e:SetWndSize(vector2():set(b.w * m.kx, b.h * m.ky))
			-- the bar's own textures keep their XML size: the progress strip follows the bar (scissored anyway)
			pcall(function() entry.hp.e:GetProgressStatic():SetWndSize(vector2():set(entry.hp.w * m.kx, entry.hp.h * m.ky)) end)
		end
	end
	for _, c in ipairs(self.cards) do pcall(function() c.name.e:SetEllipsis(true) end) end
	for _, r in ipairs(self.rows) do pcall(function() r.name.e:SetEllipsis(true) end) end
end

-- Entry i (1-based) of a layout: position in 1024x768 units, top right, downwards.
function UICoopParty:Place(entry, i, L)
	local m = self.m
	local x_px = m.W - EDGE_PX * m.s - L.w * m.s
	local y_px = TOP_UNITS * m.H / 768 + (i - 1) * (L.h + L.gap) * m.s
	entry.base.e:SetWndPos(vector2():set(x_px * 1024 / m.W, y_px * 768 / m.H))
end

function UICoopParty:Bounds(n, L)
	if n == 0 then return nil end
	local m = self.m
	local w_u = L.w * m.s * 1024 / m.W
	local r = 1024 - EDGE_PX * m.s * 1024 / m.W
	local t = TOP_UNITS
	local b = t + (n * (L.h + L.gap) - L.gap) * m.s * 768 / m.H
	return { l = r - w_u, r = r, t = t, b = b }
end

-- The stock companion column (right edge, bottom up) moves left of the panel only while they would overlap.
function UICoopParty:PlaceCompanions(rect)
	local mod = rawget(_G, "axr_companions")
	local chud = mod and mod.HUD
	if self.comp_hud and self.comp_hud ~= chud then
		self.comp_hud, self.comp_x = nil, nil -- recreated by its owner: nothing to restore
	end
	if not (chud and chud.dialog) then return end
	local cpos = chud.dialog:GetWndPos()
	local need = false
	if rect then
		local base_x = self.comp_x or cpos.x
		for _, info in pairs(chud.companion_info or {}) do
			local b = type(info) == "table" and info.base
			if b and b:IsShown() then
				local top = cpos.y + b:GetWndPos().y
				local bottom = top + b:GetHeight()
				local left, right = base_x + b:GetWndPos().x, base_x + b:GetWndPos().x + b:GetWidth()
				if top < rect.b + GAP_UNITS and bottom > rect.t and left < rect.r and right > rect.l then
					need = true
					self.comp_w = b:GetWidth()
					break
				end
			end
		end
	end
	if need and not self.comp_hud then
		self.comp_hud, self.comp_x = chud, cpos.x
		chud.dialog:SetWndPos(vector2():set(rect.l - (self.comp_w or 0) - GAP_UNITS, cpos.y))
	elseif not need and self.comp_hud then
		chud.dialog:SetWndPos(vector2():set(self.comp_x, cpos.y))
		self.comp_hud, self.comp_x = nil, nil
	end
end

local function info_text(v)
	local M = amap()
	if v.state == "alive" then return M.format_distance(v.dist) or "", CLR.text end
	local label = M.state_text(v.state) or ""
	if v.state == "down" then
		if v.bleed then label = label .. " " .. M.format_time(v.bleed) end
		return label, { allies().state_color("down") }
	end
	return label, CLR.grey
end

function UICoopParty:FillCard(c, v)
	local A = allies()
	local rgb = { A.color(v.peer) }
	local greyed = GREYED[v.state]
	local icon = v.icon or NO_ICON
	if c._icon ~= icon then
		c.icon.e:InitTexture(icon)
		c._icon = icon
	end
	c.icon.e:SetTextureColor(argb(255, CLR.portrait[v.state] or CLR.portrait.alive))
	c.strip.e:SetTextureColor(argb(greyed and 110 or 255, rgb))
	-- the nick runs to the card's right edge, or to the host star
	local nw = v.host and c.name.w or (c.name.w + c.host.w)
	c.name.e:SetWndSize(vector2():set(nw * self.m.kx, c.name.h * self.m.ky))
	c.name.e:SetText(v.nick)
	c.name.e:SetTextColor(argb(255, greyed and CLR.grey or rgb))
	c.host.e:Show(v.host)
	c.host.e:SetTextureColor(argb(greyed and 140 or 255, rgb))
	local text, clr = info_text(v)
	c.info.e:SetText(text)
	c.info.e:SetTextColor(argb(255, clr))
	-- the plate hugs the text (2 px padding), never wider than the portrait
	local m = self.m
	local tw = text ~= "" and text_width(c.info.e, c.info.w * m.kx, c.info.h * m.ky) or 0
	c.info_bg.e:Show(text ~= "")
	c.info_bg.e:SetWndSize(vector2():set(math_min(tw + 4 * m.kx, 80 * m.kx), c.info_bg.h * m.ky))
	set_badge(c, v.state)
	c.hp.e:Show(v.hp ~= nil and not greyed)
	if v.hp then c.hp.e:SetProgressPos(v.hp) end
end

function UICoopParty:FillRow(r, v)
	local A = allies()
	local rgb = { A.color(v.peer) }
	local greyed = GREYED[v.state]
	local m = self.m
	r.strip.e:SetTextureColor(argb(greyed and 110 or 255, rgb))
	r.host.e:Show(v.host)
	r.host.e:SetTextureColor(argb(greyed and 140 or 255, rgb))
	-- right part first: distance / state (down: medic badge + countdown)
	local text, clr
	if v.state == "down" then
		text, clr = v.bleed and amap().format_time(v.bleed) or "", { A.state_color("down") }
	else
		text, clr = info_text(v)
	end
	r.info.e:SetText(text)
	r.info.e:SetTextColor(argb(255, clr))
	local tw = text ~= "" and text_width(r.info.e, r.info.w * m.kx, r.info.h * m.ky) or 0
	local right = (r.info.x + r.info.w) * m.kx
	local used = tw
	if set_badge(r, v.state) then
		r.badge.e:SetWndPos(vector2():set(right - tw - (r.badge.w + 2) * m.kx, r.badge.y * m.ky))
		used = tw + (r.badge.w + 2) * m.kx
	end
	-- the nick: after the host star, up to 4 px before the right part (long nicks end with an ellipsis)
	local nx = (v.host and (r.name.x + 12) or r.name.x) * m.kx
	r.name.e:SetWndPos(vector2():set(nx, r.name.y * m.ky))
	r.name.e:SetWndSize(vector2():set(math_max(10 * m.kx, right - used - 4 * m.kx - nx), r.name.h * m.ky))
	r.name.e:SetText(v.nick)
	r.name.e:SetTextColor(argb(255, greyed and CLR.grey or rgb))
	r.bg.e:SetTextureColor(GetARGB(160, 0, 0, 0))
	r.hp.e:Show(v.hp ~= nil and not greyed)
	if v.hp then r.hp.e:SetProgressPos(v.hp) end
end

function UICoopParty:Refresh(tg)
	local list = {}
	self.vis = party_enabled and hud_visible()
	if self.vis and live() then
		list = views(tg)
	end
	local m = metrics()
	if not self.m or m.W ~= self.m.W or m.H ~= self.m.H then self:Relayout() end
	local n = math_min(#list, MAX_ENTRIES)
	-- portrait cards for a few players while they fit above the warning icons (small screens: rows earlier)
	local full = n <= FULL_MAX and (n == 0 or self:Bounds(n, CARD).b <= BOTTOM_UNITS)
	self.shown = {}
	for i = 1, FULL_MAX do
		local c, v = self.cards[i], full and list[i] or nil
		if v then
			self:FillCard(c, v)
			self:Place(c, i, CARD)
			c.base.e:Show(true)
			self.shown[#self.shown + 1] = { kind = "card", entry = c, down = v.state == "down" }
		else
			c.base.e:Show(false)
		end
	end
	for i = 1, MAX_ENTRIES do
		local r, v = self.rows[i], (not full) and list[i] or nil
		if v then
			self:FillRow(r, v)
			self:Place(r, i, ROW)
			r.base.e:Show(true)
			self.shown[#self.shown + 1] = { kind = "row", entry = r, down = v.state == "down" }
		else
			r.base.e:Show(false)
		end
	end
	self.bounds = self:Bounds(n, full and CARD or ROW)
	self:PlaceCompanions(self.bounds)
end

-- Every frame: the "needs help" badge (and the compact row behind it) breathes.
function UICoopParty:Pulse(tg)
	local k = 0.5 + 0.5 * math.sin(tg * 0.0057)
	for _, s in ipairs(self.shown) do
		if s.down then
			s.entry.badge.e:SetTextureColor(GetARGB(math_floor(150 + 105 * k), 255, 255, 255))
			if s.kind == "row" then
				s.entry.bg.e:SetTextureColor(GetARGB(math_floor(160 + 40 * k), math_floor(40 + 90 * k), 8, 6))
			end
		end
	end
end

function UICoopParty:Update()
	CUIScriptWnd.Update(self)
	local tg = time_global()
	-- inventory / PDA / scope opened or closed: hide or show at once, not at the next 2 Hz refresh
	if (party_enabled and hud_visible()) ~= self.vis then self.next_at = 0 end
	if tg >= self.next_at then
		self.next_at = tg + PANEL_MS
		local ok, err = pcall(self.Refresh, self, tg)
		if not ok then
			self.next_at = tg + 5000
			log("! party panel refresh failed: %s", tostring(err))
		end
	end
	if self.shown[1] then pcall(self.Pulse, self, tg) end
end

local PARTY -- HUD dialog, while this Lua state lives

local function party_on()
	if PARTY then return end
	local ok, err = pcall(function()
		PARTY = UICoopParty()
		get_hud():AddDialogToRender(PARTY)
	end)
	if not ok then
		PARTY = nil
		log("! party panel failed: %s", tostring(err))
	end
end

local function party_off()
	if not PARTY then return end
	pcall(PARTY.PlaceCompanions, PARTY, nil)
	pcall(function() get_hud():RemoveDialogToRender(PARTY) end)
	PARTY = nil
end

function set_party_enabled(on)
	party_enabled = on and true or false
	if PARTY then PARTY.next_at = 0 end
end

function set_spots_enabled(on)
	spots_enabled = on and true or false
end

-------------------------------------------------------------------------------
-- Update, callbacks
-------------------------------------------------------------------------------
local next_status, next_spots = 0, 0
local spots_down = false -- somebody is down: the overlay pulses every frame

local function update_spots(tg)
	local _, by_avatar = views(tg)
	local M = amap()
	M.sync(by_avatar, spots_enabled)
	spots_down = false
	for _, v in pairs(by_avatar) do
		if v.state == "down" then spots_down = true end
	end
	spots_down = spots_down and M.is_ready()
end

local function actor_on_update()
	if not api then return end
	local tg = time_global()
	if live() then
		if not modules_ok() then return end
		party_on()
		if tg >= next_status then
			next_status = tg + STATUS_MS
			local ok, err = pcall(send_status, tg)
			if not ok then log("! status not sent: %s", tostring(err)) end
		end
		if tg >= next_spots then
			next_spots = tg + SPOTS_MS
			local ok, err = pcall(update_spots, tg)
			if not ok then
				next_spots = tg + 10000
				log("! player markers: %s", tostring(err))
			end
		end
		if spots_down then
			local ok = map_call("pulse", tg)
			if not ok then spots_down = false end
		end
	elseif not api.is_active() then
		map_call("clear")
		spots_down = false
		if next(status) then status = {} end
		sent.payload = nil
		party_off()
	end
end

local function actor_on_net_destroy()
	map_call("clear")
	spots_down = false
	party_off()
end

function print_status()
	local n = 0
	for _ in pairs(status) do n = n + 1 end
	log("hud: status out %d, in %d (bad %d), players with status %d | party panel %s, %s",
		stats.status_out, stats.status_in, stats.status_bad, n, PARTY and "on" or "off",
		party_enabled and "enabled" or "disabled by the player")
	-- every other player as the panel sees him: one line answers "why is there no card for X"
	local ok, list = pcall(views)
	if ok and type(list) == "table" then
		local parts = {}
		for _, v in ipairs(list) do
			local st = status[v.peer]
			parts[#parts + 1] = string_format("#%d %s %s%s, %s, status %s", v.peer, tostring(v.nick), v.state,
				v.host and " (host)" or "", v.dist and string_format("%.0f m", v.dist) or "no avatar",
				st and string_format("%.0f s ago", (time_global() - st.at) / 1000) or "never")
		end
		log("hud: panel %s, %d other player(s)%s%s", PARTY and (PARTY.vis and "visible" or ("hidden: " .. hidden_why()))
			or "off", #list, #parts > 0 and ": " or "", table.concat(parts, "; "))
	end
	local A = allies()
	if A then pcall(A.print_status) end
	map_call("print_status")
end

function on_game_start()
	if not api then return end -- an exe without co-op: nothing of this runs
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	local cm = codec()
	if cm and cm.add_event_handler then cm.add_event_handler(EV_STATUS, on_status) end
end
