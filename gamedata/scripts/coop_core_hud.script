--[[
	Anomaly Coop - core group: who is where (gamedata\scripts\coop_core_hud.script). W4 core, reworked by W6 (allies UI)
	and by HUD v2 (docs\HUD_V2.md: the team panel). Layout configs\ui\ui_coop_core.xml (party_card), textures
	configs\ui\textures_descr\ui_coop_hud.xml. Colours and state rules: coop_allies.script. Map markers:
	coop_allies_map.script (+ modxml_coop_allies.script). The compass bar, its marker data and the ping: coop_hud_*.script.

	1. Status: every player sends its own health, state, community, portrait and bleed-out time to the others
	   ("core.status", about once a second, more often on a change). Proxies are not harmed on the other machines,
	   so their engine health tells nothing; this is the only source of a teammate's health. The engine's
	   survival state (coop.life_of, W5 C1) wins over the reported state when it exists.
	2. Team panel on the HUD (HUD v2, variant B - the owner's pick 2026-10-23): one row per other player, bottom left
	   above the own HUD, the block growing upwards (host on top), sorted by peer id. Every size: coop_hud_layout team_*
	   (one line per value in [coop_hud_layout] of mod_system_coop.ltx), px at 768 high, never stretched.
	   A row: a 2 px bar in his colour; nick in white with a 1 px shadow, host star, distance and an arrow to him turned
	   relative to the camera (every frame); under the nick his health in 4 segments of 25 % (white, red under 30 %, the
	   empty part white at ~0.18). No state words - icon, colour and motion:
	   - down: the segments are the bleed-out timer (red, melting right to left), a cross in a ring that melts with
	     it and "0:42" right of them, the row breathes at 1 Hz; while somebody revives him (part 2, set_revive) the
	     red fills in the reviver's colour; back on his feet: the bar flashes white;
	   - dead / returning: grey segments and a skull; the engine's respawn countdown (coop.respawn_left, not in the
	     engine yet) fills them back in white with "0:21";
	   - healed: the gain flashes white for 0.4 s; resting / sleeping (coop.rest): "z", the segments breathe 0.5..0.8
	     over 3 s; spectating (hardcore): eye, grey; status stopped coming: amber "!", the nick dimmed (W8);
	   - F3 T13: a sage tent for 10 s after his checkpoint changed.
	   Hidden with the main HUD (inventory, PDA, scope) at once and outside a session.
	3. Minimap / PDA markers of other players: coop_allies_map (arrow in the player's colour turning with his
	   heading, edge pointer, "needs help" overlay, grey marker when dead), updated 5 times a second.

	For other scripts:
		coop_core_hud.status_of(peer) -> { h = 0..1, s = state, f = community, i = icon, b = bleed s | nil, at } | nil
		coop_core_hud.views() -> list of other players { peer, slot, nick, host, state, bleed, hp, avatar, dist, icon,
			pos = {x, y, z} of his avatar | nil }
		coop_core_hud.set_party_enabled(bool) / set_spots_enabled(bool)
		coop_core_hud.set_revive(peer, frac | nil, by_peer)   revive part 2: his red segments fill in the reviver's colour
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local string_format = string.format
local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall
local math_max, math_min, math_floor = math.max, math.min, math.floor

local EV_STATUS = "core.status"
local STATUS_MS = 1000 -- check own status this often
local STATUS_KEEPALIVE_MS = 5000 -- resend an unchanged status
local PANEL_MS = 500 -- party panel refresh (2 Hz)
local SPOTS_MS = 200 -- map markers (5 Hz)
local MAX_ENTRIES = 7 -- host + 7 clients
local XML_FILE = "ui_coop_core.xml"

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-hud] %s", ok and line or tostring(fmt))
end

local function live()
	return api ~= nil and api.is_active() and (api.is_host() or api.is_live())
end

local function players()
	if not api then return {} end
	local ok, list = pcall(api.players)
	return ok and type(list) == "table" and list or {}
end

local function codec()
	return rawget(_G, "coop_main") or coop_main
end

local function allies()
	return rawget(_G, "coop_allies") or coop_allies
end

local function amap()
	return rawget(_G, "coop_allies_map") or coop_allies_map
end

-- coop_allies / coop_allies_map ship with this file; if one of them failed to load, say so once and keep quiet.
local missing_logged = false
local function modules_ok()
	if allies() and amap() then return true end
	if not missing_logged then
		missing_logged = true
		printf("[coop-hud] ! coop_allies.script or coop_allies_map.script is missing: no party panel, no markers")
	end
	return false
end

local function map_call(name, ...)
	local m = amap()
	local f = m and m[name]
	if not f then return false end
	return pcall(f, ...)
end

local party_enabled, spots_enabled = true, true
local stats = { status_out = 0, status_in = 0, status_bad = 0 }

-------------------------------------------------------------------------------
-- Status
-------------------------------------------------------------------------------
local status = {} -- peer id -> { h, s, f, i, b, at }
local sent = { payload = nil, at = 0 }

local function own_state(actor)
	local s = allies().engine_state(0) -- engine survival state (W5 C1), when present
	if s then return s end
	if not actor:alive() then return "dead" end
	return actor.health <= 0.011 and "down" or "alive" -- a player who is down is pinned at 1% health
end

local function send_status(tg)
	local actor = db.actor
	if not actor then return end
	local icon = actor:character_icon()
	local t = {
		h = math_floor(math_max(0, math_min(1, actor.health)) * 100 + 0.5) / 100,
		s = own_state(actor),
		f = tostring(actor:character_community() or ""),
		i = type(icon) == "string" and icon or "",
	}
	if t.s == "down" then
		local b = allies().engine_bleed(0)
		if b then t.b = math_min(b, 3600) end
	end
	local payload = codec().encode(t)
	if payload == sent.payload and tg - sent.at < STATUS_KEEPALIVE_MS then return end
	if api.send_event(EV_STATUS, payload, -1) then
		sent.payload, sent.at = payload, tg
		stats.status_out = stats.status_out + 1
	end
end

local function on_status(payload, from)
	if type(from) ~= "number" or not allies() then return end
	local t = codec().decode(payload)
	local h = tonumber(t.h)
	local s = t.s
	if not (h and h >= 0 and h <= 1 and allies().is_wire_state(s)) then
		stats.status_bad = stats.status_bad + 1
		return
	end
	local f = type(t.f) == "string" and #t.f <= 40 and t.f:match("^[%w_]*$") and t.f or ""
	local i = type(t.i) == "string" and #t.i <= 96 and t.i:match("^[%w_\\/%.]*$") and t.i or ""
	local b = tonumber(t.b)
	b = (s == "down" and b and b >= 0 and b <= 3600) and math_floor(b) or nil
	status[from] = { h = h, s = s, f = f, i = i, b = b, at = time_global() }
	stats.status_in = stats.status_in + 1
end

function status_of(peer)
	return status[peer]
end

-------------------------------------------------------------------------------
-- Other players as the UI sees them
-------------------------------------------------------------------------------
local function avatar_of(p)
	local id = p.avatar_id
	if type(id) ~= "number" or id <= 0 or id >= 65535 then return nil, nil end
	local obj = level.object_by_id(id)
	return obj, obj and id or nil
end

function views(tg)
	tg = tg or time_global()
	local A = allies()
	local list, by_avatar = {}, {}
	local actor = db.actor
	for _, p in ipairs(players()) do
		if not p.is_self and type(p.id) == "number" then
			local st = status[p.id]
			local state, bleed = A.state_of(p, st, tg)
			local fresh = st and (tg - st.at) <= A.STATUS_STALE_MS
			local obj, id = avatar_of(p)
			local icon = st and st.i ~= "" and st.i or nil
			if not icon and obj then
				local ok, ic = pcall(obj.character_icon, obj)
				icon = ok and type(ic) == "string" and ic ~= "" and ic or nil
			end
			local v = {
				peer = p.id, slot = A.slot(p.id), nick = tostring(p.nick or "?"), host = p.id == 0,
				state = state, bleed = bleed, hp = fresh and st.h or nil, avatar = id, icon = icon,
				dist = (obj and actor) and obj:position():distance_to(actor:position()) or nil,
			}
			if obj then
				local okp, p = pcall(obj.position, obj)
				if okp and p then v.pos = { x = p.x, y = p.y, z = p.z } end
			end
			list[#list + 1] = v
			if id then by_avatar[id] = v end
		end
	end
	table.sort(list, function(a, b) return a.peer < b.peer end)
	return list, by_avatar
end

-------------------------------------------------------------------------------
-- Team panel (HUD v2, variant B)
-------------------------------------------------------------------------------
local function hud_visible()
	local f = rawget(_G, "main_hud_shown")
	if not f then return true end
	local ok, v = pcall(f)
	return not ok or v == true
end

-- Why main_hud_shown() says no (status line only): the parts of the stock check (_g.script).
local function hidden_why()
	if not party_enabled then return "disabled by the player" end
	local why = {}
	local function add(cond, text) if cond then why[#why + 1] = text end end
	pcall(function()
		add(rawget(_G, "_HUD_STATE") == false, "HUD indicators off")
		local am = rawget(_G, "actor_menu")
		add(am and am.last_mode ~= 0, "actor menu open")
		local pda_m = rawget(_G, "pda")
		add(pda_m and pda_m.dialog_closed ~= true, "talk dialog open")
		local guis = rawget(_G, "_GUIs")
		if type(guis) == "table" then
			for name in pairs(guis) do why[#why + 1] = "UI " .. tostring(name) .. " registered" end
		end
		local gcc = rawget(_G, "get_console_cmd")
		add(gcc and gcc(1, "hud_draw") == false, "hud_draw 0")
		local ax = rawget(_G, "axr_main")
		add(ax and (ax.binoc_is_zoomed or ax.scoped_weapon_is_zoomed), "zoomed")
	end)
	return #why > 0 and table.concat(why, ", ") or "?"
end

local function argb(a, rgb)
	return GetARGB(math_max(0, math_min(255, math_floor(a + 0.5))), rgb[1], rgb[2], rgb[3])
end

local CLR = {
	white = { 244, 245, 246 }, -- #F4F5F6
	dist = { 200, 200, 200 },
	amber = { 232, 163, 58 }, -- "no signal" (W8)
	grey = { 120, 120, 120 }, -- segments of a dead / spectating player
	eye = { 175, 175, 175 },
	camp = { 146, 190, 154 }, -- sage #92BE9A, as the camp marker of the compass
}
local A_FILL, A_DIST, A_SHADOW = 230, 200, 0.75
local LOW_HP = 0.3
local FLASH_MS = 400 -- health gained, a revive done: the segments flash white
local BREATH_MS = 3000 -- a sleeping player's segments breathe 0.5 <-> 0.8
local SEGS, ARCS = 4, 8 -- 4 segments of 25 %, the melting ring of a downed player in 8 arcs of 45 deg
local GREYED = { dead = true, spec = true, respawn = true }
local RESTING = { resting = true, sleeping = true }

local function compass()
	return rawget(_G, "coop_hud_compass")
end

local function markers()
	return rawget(_G, "coop_hud_markers")
end

local function layout()
	local m = rawget(_G, "coop_hud_layout") or coop_hud_layout
	return m.get()
end

-- Seconds before a dead player stands up again, when the engine tells (coop.respawn_left, ms); nil otherwise.
local function respawn_left(avatar)
	if not (api and api.respawn_left and type(avatar) == "number") then return nil end
	local ok, ms = pcall(api.respawn_left, avatar)
	ms = ok and tonumber(ms) or nil
	if not ms or ms <= 0 then return nil end
	return ms / 1000
end

local function rest_state(avatar)
	local r = api and api.rest
	if not (type(r) == "table" and type(r.state_of) == "function" and type(avatar) == "number") then return nil end
	local ok, s = pcall(r.state_of, avatar)
	return ok and s or nil
end

-- Revive part 2 (docs\HUD_V2.md, "Поднятие союзника"), the seam of the row: while player `peer` is being revived by
-- `by_peer`, frac 0..1 fills his red segments in the reviver's colour; frac nil ends it. Nothing calls it yet (the
-- engine export coop.revive_progress comes with part 2).
local reviving = {} -- peer -> { frac, by }
function set_revive(peer, frac, by_peer)
	if type(peer) ~= "number" then return end
	frac = tonumber(frac)
	if frac then
		reviving[peer] = { frac = math_max(0, math_min(1, frac)), by = tonumber(by_peer) }
	else
		reviving[peer] = nil
	end
end

-- Screen metrics: kx = px at 768 high -> units across; px / py = one screen pixel in units.
local function metrics()
	local dev = device()
	local W, H = dev.width, dev.height
	return { W = W, H = H, kx = 1024 * H / (768 * W), px = 1024 / W, py = 768 / H }
end

local function vec2(x, y)
	return vector2():set(x, y)
end

-- A window and where the script put it (tests and relayout read it as .e / .x / .y / .w / .h).
local function el(e)
	return { e = e, x = 0, y = 0, w = 0, h = 0 }
end

local function put(t, x, y, w, h)
	if t.x ~= x or t.y ~= y then
		t.e:SetWndPos(vec2(x, y))
		t.x, t.y = x, y
	end
	if w and (t.w ~= w or t.h ~= h) then
		t.e:SetWndSize(vec2(w, h))
		t.w, t.h = w, h
	end
end

local function show(t, on)
	if t.e:IsShown() ~= on then t.e:Show(on) end
end

local function tint(t, c)
	if t.c ~= c then
		t.c = c
		t.e:SetTextureColor(c)
	end
end

local function text_color(t, c)
	if t.tc ~= c then
		t.tc = c
		t.e:SetTextColor(c)
	end
end

local function set_tex(t, tex)
	if t.tex ~= tex then
		t.tex = tex
		t.e:InitTexture(tex)
		t.e:SetStretchTexture(true)
	end
end

class "UICoopParty" (CUIScriptWnd)

function UICoopParty:__init() super()
	self.team_panel = true -- how status lines and tests tell this window from the chat feed (which has rows too)
	self.next_at = 0
	self.rows = {}
	self.cards = self.rows -- the panel's entries (older name, kept for status lines and tests)
	self.shown = {} -- rows in use since the last refresh: { row, view, at }
	self.track = {} -- peer -> what the row remembers between refreshes (health before, flash, the down / respawn totals)
	self.width_cache = {}
	self:InitControls()
end

function UICoopParty:__finalize()
end

function UICoopParty:InitControls()
	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)
	for i = 1, MAX_ENTRIES do
		local r = {}
		r.base = el(xml:InitStatic("team_row", self))
		local b = r.base.e
		r.strip = el(xml:InitStatic("team_row:bar", b))
		r.segs = {}
		for k = 1, SEGS do
			r.segs[k] = {
				bg = el(xml:InitStatic("team_row:bar", b)),
				fill = el(xml:InitStatic("team_row:bar", b)),
				over = el(xml:InitStatic("team_row:bar", b)), -- revive / respawn fill over the base fill
				flash = el(xml:InitStatic("team_row:bar", b)),
			}
		end
		r.name_sh = el(xml:InitTextWnd("team_row:text", b))
		r.name = el(xml:InitTextWnd("team_row:text", b))
		r.host = el(xml:InitStatic("team_row:icon", b))
		r.dist_sh = el(xml:InitTextWnd("team_row:text", b))
		r.dist = el(xml:InitTextWnd("team_row:text", b))
		r.arrow = el(xml:InitStatic("team_row:arrow", b))
		r.arcs = {}
		for k = 1, ARCS do r.arcs[k] = el(xml:InitStatic("team_row:arc", b)) end
		r.icon = el(xml:InitStatic("team_row:icon", b))
		r.timer_sh = el(xml:InitTextWnd("team_row:text", b))
		r.timer = el(xml:InitTextWnd("team_row:text", b))
		r.measure = xml:InitTextWnd("team_row:text", b)
		r.measure:Show(false)
		set_tex(r.host, "coop_hud_star")
		for k = 1, ARCS do
			set_tex(r.arcs[k], "coop_hud_arc8")
			pcall(function() r.arcs[k].e:EnableHeading(true) end)
			r.arcs[k].e:SetHeading(-math.rad((k - 1) * 360 / ARCS))
		end
		pcall(function() r.arrow.e:EnableHeading(true) end)
		pcall(function() r.name.e:SetEllipsis(true) end)
		pcall(function() r.name_sh.e:SetEllipsis(true) end)
		b:Show(false)
		self.rows[i] = r
	end
	self:Relayout()
end

-- Sizes of everything that does not depend on the texts (layout table team_*: units down, px * kx across).
function UICoopParty:Relayout()
	local m = metrics()
	local L = layout()
	self.m, self.L = m, L
	self.width_cache = {}
	local kx = m.kx
	for _, r in ipairs(self.rows) do
		for _, t in pairs(r) do
			if type(t) == "table" and t.e then t.x, t.y, t.w, t.h = nil, nil, nil, nil end
		end
		put(r.base, 0, 0, 1, 1)
		put(r.strip, 0, 0, L.team_strip_w * kx, L.team_strip_h)
		local sx = L.team_seg_x * kx
		for k = 1, SEGS do
			local s = r.segs[k]
			for _, t in pairs(s) do t.x, t.y, t.w, t.h = nil, nil, nil, nil end
			local x = sx + (k - 1) * (L.team_seg_w + L.team_seg_gap) * kx
			put(s.bg, x, L.team_seg_y, L.team_seg_w * kx, L.team_seg_h)
			put(s.fill, x, L.team_seg_y, L.team_seg_w * kx, L.team_seg_h)
			put(s.over, x, L.team_seg_y, L.team_seg_w * kx, L.team_seg_h)
			put(s.flash, x, L.team_seg_y - m.py, L.team_seg_w * kx, L.team_seg_h + 2 * m.py)
			tint(s.bg, argb(255 * L.team_seg_empty_alpha, CLR.white))
		end
		r.seg_end = sx + (SEGS * L.team_seg_w + (SEGS - 1) * L.team_seg_gap) * kx
		local icx = r.seg_end + L.team_status_gap * kx
		local icy = L.team_seg_y + L.team_seg_h / 2
		r.icon_cx, r.icon_cy = icx, icy
		put(r.icon, icx - L.team_status * kx / 2, icy - L.team_status / 2, L.team_status * kx, L.team_status)
		for k = 1, ARCS do
			-- turned (heading): the box stays square in units, the engine squeezes it across
			put(r.arcs[k], icx - L.team_status / 2, icy - L.team_status / 2, L.team_status, L.team_status)
		end
		put(r.arrow, 0, 0, L.team_arrow, L.team_arrow)
		put(r.host, 0, 0, L.team_star * kx, L.team_star)
		r._nick, r._dist, r._timer = nil, nil, nil
	end
end

-- Width (units) of a text, measured once per text.
function UICoopParty:TextWidth(r, text)
	local w = self.width_cache[text]
	if w then return w end
	r.measure:SetText(text)
	local ok = pcall(function() r.measure:AdjustWidthToText() end)
	w = ok and r.measure:GetWidth() or (#text * 6 * self.m.kx)
	self.width_cache[text] = w
	return w
end

-- Row i of n: the block hangs from team_bottom upwards, the host on top.
function UICoopParty:Place(r, i, n)
	local L = self.L
	local top = L.team_bottom - L.team_strip_h - (n - i) * L.team_row
	put(r.base, L.team_x * self.m.kx, top)
	r.top = top
end

function UICoopParty:Bounds(n)
	if n == 0 then return nil end
	local L, m = self.L, self.m
	local l = L.team_x * m.kx
	return { l = l, r = l + 200 * m.kx, t = L.team_bottom - L.team_strip_h - (n - 1) * L.team_row, b = L.team_bottom }
end

local function set_text(t, text, field_owner, field)
	if field_owner[field] ~= text then
		field_owner[field] = text
		t.e:SetText(text)
	end
end

-- Texts and their places (2 Hz): nick, host star, distance, arrow place.
function UICoopParty:Fill(r, v, tg)
	local A, M = allies(), amap()
	local L, m = self.L, self.m
	local kx = m.kx
	-- what the row remembers about him
	local tr_ = self.track[v.peer]
	if not tr_ then
		tr_ = {}
		self.track[v.peer] = tr_
	end
	if v.state == "down" then
		if tr_.state ~= "down" then tr_.down_total = nil end
		if v.bleed then tr_.down_total = math_max(tr_.down_total or 0, v.bleed) end
	elseif tr_.state == "down" and v.state == "alive" then
		tr_.flash_from, tr_.flash_to, tr_.flash_at = 0, 1, tg -- back on his feet: the whole bar flashes
	end
	local left = (v.state == "dead" or v.state == "respawn") and respawn_left(v.avatar) or nil
	if left then
		if not GREYED[tr_.state] then tr_.resp_total = nil end
		tr_.resp_total = math_max(tr_.resp_total or 0, left)
	end
	if v.state == "alive" and v.hp and tr_.hp and v.hp > tr_.hp + 0.01 then
		tr_.flash_from, tr_.flash_to, tr_.flash_at = tr_.hp, v.hp, tg -- healed: the gain flashes
	end
	tr_.state, tr_.hp = v.state, v.hp or tr_.hp
	r.view, r.at, r.track, r.left = v, tg, tr_, left
	-- F3 T14: lying down for the shared sleep -> "z"; F3 T13: his checkpoint changed < 10 s ago -> a tent for 10 s
	r.rest = v.state == "alive" and RESTING[rest_state(v.avatar) or ""] or false
	r.camp = v.state == "alive" and A.checkpoint_mark(v.avatar) ~= nil
	-- strip in his colour
	r.color = { A.color(v.peer) }
	-- nick (white, shadow), host star, distance, arrow
	local nx = L.team_name_x * kx
	local nw = math_min(self:TextWidth(r, v.nick), L.team_name_max * kx)
	set_text(r.name, v.nick, r, "_nick")
	r.name_sh.e:SetText(v.nick)
	put(r.name, nx, L.team_name_y, nw, L.team_name_h)
	put(r.name_sh, nx + m.px, L.team_name_y + m.py, nw, L.team_name_h)
	local x = nx + nw
	show(r.host, v.host)
	if v.host then
		put(r.host, x + 4 * kx, L.team_name_y + (L.team_name_h - L.team_star) / 2)
		x = x + 4 * kx + L.team_star * kx
	end
	local dist = M.format_distance(v.dist) or ""
	local dw = dist ~= "" and self:TextWidth(r, dist) or 0
	if r._dist ~= dist then
		r._dist = dist
		r.dist.e:SetText(dist)
		r.dist_sh.e:SetText(dist)
	end
	local dx = x + L.team_dist_gap * kx
	put(r.dist, dx, L.team_dist_y, dw, L.team_dist_h)
	put(r.dist_sh, dx + m.px, L.team_dist_y + m.py, dw, L.team_dist_h)
	show(r.dist, dist ~= "")
	show(r.dist_sh, dist ~= "")
	r.arrow_cx = dx + dw + 4 * kx + L.team_arrow * kx / 2
	put(r.arrow, r.arrow_cx - L.team_arrow / 2, L.team_arrow_y - L.team_arrow / 2)
	r.pos = v.pos
end

-- Fill of segment k (1..4) for a share 0..1 of the whole bar.
local function seg_share(frac, k)
	return math_max(0, math_min(1, frac * SEGS - (k - 1)))
end

-- Everything that moves (every frame): segments, the state icon, the melting ring, the timer, pulses, the arrow.
function UICoopParty:Animate(r, tg, heading, cam)
	local v, tr_ = r.view, r.track
	local A, M = allies(), amap()
	local L, m = self.L, self.m
	local kx = m.kx
	local seg_w = L.team_seg_w * kx
	local wave = 0.5 + 0.5 * math.sin(tg * 2 * math.pi / 1000)
	local row_a = 1 -- the whole row (a downed player's row breathes at 1 Hz)
	local nick_a = 1
	local fill_frac, fill_c, fill_a = 0, CLR.white, A_FILL
	local over_frac, over_c = 0, nil
	local seg_mul = 1
	local grey = false
	local icon, icon_c = nil, nil
	local ring_frac -- 0..1: the arcs left of the melting ring
	local timer, timer_c = nil, nil
	local since = (tg - (r.at or tg)) / 1000
	if v.state == "down" then
		row_a = 0.75 + 0.25 * wave
		local left = v.bleed and math_max(0, v.bleed - since) or nil
		local total = tr_.down_total
		fill_frac = (left and total and total > 0) and math_min(1, left / total) or 1
		fill_c = { A.state_color("down") }
		ring_frac = fill_frac
		icon, icon_c = "coop_hud_cross", fill_c
		if left then timer, timer_c = M.format_time(math.ceil(left)), fill_c end
		local rv = reviving[v.peer]
		if rv then
			over_frac = rv.frac * fill_frac
			over_c = rv.by and { A.color(rv.by) } or CLR.white
		end
	elseif GREYED[v.state] then
		grey = true
		fill_frac, fill_c = 1, CLR.grey
		if v.state == "spec" then
			icon, icon_c = "coop_hud_eye", CLR.eye
		else
			icon, icon_c = "coop_hud_skull", CLR.eye
			local left = r.left and math_max(0, r.left - since) or nil
			if left and tr_.resp_total and tr_.resp_total > 0 then
				over_frac, over_c = 1 - left / tr_.resp_total, CLR.white -- coming back: white fills the grey bar
				timer, timer_c = M.format_time(math.ceil(left)), CLR.white
			end
		end
	elseif v.state == "unknown" then
		icon, icon_c = "coop_hud_warn", CLR.amber
		nick_a = 0.5
		fill_frac = v.hp or 0
	else
		fill_frac = v.hp or 0
		if fill_frac < LOW_HP then fill_c = { A.state_color("down") } end
		if r.rest then
			icon, icon_c = "coop_hud_z", CLR.white
			seg_mul = 0.65 + 0.15 * math.sin(tg * 2 * math.pi / BREATH_MS) -- 0.5 <-> 0.8
		elseif r.camp then
			icon, icon_c = "coop_hud_tent", CLR.camp
		end
	end
	-- strip, nick, distance
	tint(r.strip, argb(255 * row_a * (grey and 0.45 or 1), r.color))
	text_color(r.name, argb(255 * row_a * nick_a, grey and CLR.eye or CLR.white))
	text_color(r.name_sh, GetARGB(math_floor(255 * A_SHADOW * row_a * nick_a), 0, 0, 0))
	text_color(r.dist, argb(A_DIST * row_a, CLR.dist))
	text_color(r.dist_sh, GetARGB(math_floor(A_DIST * A_SHADOW * row_a), 0, 0, 0))
	if v.host then tint(r.host, argb(230 * row_a, grey and CLR.eye or r.color)) end -- the host's star in his colour
	-- segments
	local flash_a = 0
	if tr_.flash_at then
		local age = tg - tr_.flash_at
		if age >= 0 and age < FLASH_MS then flash_a = 1 - age / FLASH_MS else tr_.flash_at = nil end
	end
	for k = 1, SEGS do
		local s = r.segs[k]
		local f = seg_share(fill_frac, k)
		put(s.fill, s.fill.x, s.fill.y, seg_w * f, s.fill.h)
		tint(s.fill, argb(fill_a * row_a * seg_mul, fill_c))
		show(s.fill, f > 0)
		tint(s.bg, argb(255 * L.team_seg_empty_alpha * row_a, CLR.white))
		local o = over_c and seg_share(over_frac, k) or 0
		show(s.over, o > 0)
		if o > 0 then
			put(s.over, s.over.x, s.over.y, seg_w * o, s.over.h)
			tint(s.over, argb(A_FILL * row_a, over_c))
		end
		local fl = 0
		if flash_a > 0 then
			local a0, a1 = tr_.flash_from * SEGS - (k - 1), tr_.flash_to * SEGS - (k - 1)
			a0, a1 = math_max(0, math_min(1, a0)), math_max(0, math_min(1, a1))
			if a1 > a0 then
				fl = a1 - a0
				put(s.flash, s.bg.x + seg_w * a0, s.flash.y, seg_w * fl, s.flash.h)
				tint(s.flash, argb(255 * flash_a, CLR.white))
			end
		end
		show(s.flash, fl > 0)
	end
	-- state icon, the melting ring, the timer
	show(r.icon, icon ~= nil)
	if icon then
		set_tex(r.icon, icon)
		tint(r.icon, argb(255 * row_a, icon_c))
	end
	local arcs_on = ring_frac and math.ceil(ring_frac * ARCS - 1e-6) or 0
	for k = 1, ARCS do
		local on = k <= arcs_on
		show(r.arcs[k], on)
		if on then tint(r.arcs[k], argb(255 * row_a, icon_c)) end
	end
	show(r.timer, timer ~= nil)
	show(r.timer_sh, timer ~= nil)
	if timer then
		local tw = self:TextWidth(r, timer)
		local tx = r.icon_cx + L.team_status * kx / 2 + 4 * kx
		local ty = r.icon_cy - L.team_timer_h / 2
		if r._timer ~= timer then
			r._timer = timer
			r.timer.e:SetText(timer)
			r.timer_sh.e:SetText(timer)
		end
		put(r.timer, tx, ty, tw, L.team_timer_h)
		put(r.timer_sh, tx + m.px, ty + m.py, tw, L.team_timer_h)
		text_color(r.timer, argb(255 * row_a, timer_c))
		text_color(r.timer_sh, GetARGB(math_floor(255 * A_SHADOW * row_a), 0, 0, 0))
	end
	-- arrow: relative to the camera
	local on = false
	local C = compass()
	if heading and cam and r.pos and C then
		local b = C.bearing(cam, r.pos)
		if b then
			r.arrow.e:SetHeading(-math.rad(C.rel_angle(b, heading)))
			tint(r.arrow, argb(220 * row_a, CLR.white))
			on = true
		end
	end
	show(r.arrow, on)
end

function UICoopParty:Refresh(tg)
	local list = {}
	self.vis = party_enabled and hud_visible()
	if self.vis and live() then
		list = views(tg)
	end
	local m = metrics()
	if not self.m or m.W ~= self.m.W or m.H ~= self.m.H or layout() ~= self.L then self:Relayout() end
	local n = math_min(#list, MAX_ENTRIES)
	self.shown = {}
	local seen = {}
	for i = 1, MAX_ENTRIES do
		local r, v = self.rows[i], list[i]
		if v and i <= n then
			self:Fill(r, v, tg)
			self:Place(r, i, n)
			show(r.base, true)
			self.shown[#self.shown + 1] = r
			seen[v.peer] = true
		else
			show(r.base, false)
			r.pos, r.view = nil, nil
		end
	end
	for peer in pairs(self.track) do
		if not seen[peer] then self.track[peer] = nil end
	end
	self.bounds = self:Bounds(n)
end

function UICoopParty:Frame(tg)
	local C = compass()
	local dev = device()
	local dir, cam = dev.cam_dir, dev.cam_pos
	local heading = (C and dir and C.heading_of) and C.heading_of(dir) or nil
	for _, r in ipairs(self.shown) do self:Animate(r, tg, heading, cam) end
end

function UICoopParty:Update()
	CUIScriptWnd.Update(self)
	local tg = time_global()
	local Mk = markers()
	local pf = Mk and Mk.perf_start and Mk.perf_start("panel")
	-- inventory / PDA / scope opened or closed: hide or show at once, not at the next 2 Hz refresh
	if (party_enabled and hud_visible()) ~= self.vis then self.next_at = 0 end
	if tg >= self.next_at then
		self.next_at = tg + PANEL_MS
		local ok, err = pcall(self.Refresh, self, tg)
		if not ok then
			self.next_at = tg + 5000
			log("! party panel refresh failed: %s", tostring(err))
		end
	end
	if self.shown[1] then
		local ok, err = pcall(self.Frame, self, tg)
		if not ok and not self.frame_err then
			self.frame_err = true
			log("! party panel frame failed: %s", tostring(err))
		end
	end
	if pf then Mk.perf_stop(pf) end
end

local PARTY -- HUD dialog, while this Lua state lives

local function party_on()
	if PARTY then return end
	local ok, err = pcall(function()
		PARTY = UICoopParty()
		get_hud():AddDialogToRender(PARTY)
	end)
	if not ok then
		PARTY = nil
		log("! party panel failed: %s", tostring(err))
	end
end

local function party_off()
	if not PARTY then return end
	pcall(function() get_hud():RemoveDialogToRender(PARTY) end)
	PARTY = nil
end

function set_party_enabled(on)
	party_enabled = on and true or false
	if PARTY then PARTY.next_at = 0 end
end

function set_spots_enabled(on)
	spots_enabled = on and true or false
end

-------------------------------------------------------------------------------
-- Update, callbacks
-------------------------------------------------------------------------------
local next_status, next_spots = 0, 0
local spots_down = false -- somebody is down: the overlay pulses every frame

local function update_spots(tg)
	local _, by_avatar = views(tg)
	local M = amap()
	M.sync(by_avatar, spots_enabled)
	spots_down = false
	for _, v in pairs(by_avatar) do
		if v.state == "down" then spots_down = true end
	end
	spots_down = spots_down and M.is_ready()
end

local function actor_on_update()
	if not api then return end
	local tg = time_global()
	if live() then
		if not modules_ok() then return end
		party_on()
		if tg >= next_status then
			next_status = tg + STATUS_MS
			local ok, err = pcall(send_status, tg)
			if not ok then log("! status not sent: %s", tostring(err)) end
		end
		if tg >= next_spots then
			next_spots = tg + SPOTS_MS
			local ok, err = pcall(update_spots, tg)
			if not ok then
				next_spots = tg + 10000
				log("! player markers: %s", tostring(err))
			end
		end
		if spots_down then
			local ok = map_call("pulse", tg)
			if not ok then spots_down = false end
		end
	elseif not api.is_active() then
		map_call("clear")
		spots_down = false
		if next(status) then status = {} end
		sent.payload = nil
		party_off()
	end
end

local function actor_on_net_destroy()
	map_call("clear")
	spots_down = false
	party_off()
end

function print_status()
	local n = 0
	for _ in pairs(status) do n = n + 1 end
	log("hud: status out %d, in %d (bad %d), players with status %d | party panel %s, %s",
		stats.status_out, stats.status_in, stats.status_bad, n, PARTY and "on" or "off",
		party_enabled and "enabled" or "disabled by the player")
	-- every other player as the panel sees him: one line answers "why is there no card for X"
	local ok, list = pcall(views)
	if ok and type(list) == "table" then
		local parts = {}
		for _, v in ipairs(list) do
			local st = status[v.peer]
			parts[#parts + 1] = string_format("#%d %s %s%s, %s, status %s", v.peer, tostring(v.nick), v.state,
				v.host and " (host)" or "", v.dist and string_format("%.0f m", v.dist) or "no avatar",
				st and string_format("%.0f s ago", (time_global() - st.at) / 1000) or "never")
		end
		log("hud: panel %s, %d other player(s)%s%s", PARTY and (PARTY.vis and "visible" or ("hidden: " .. hidden_why()))
			or "off", #list, #parts > 0 and ": " or "", table.concat(parts, "; "))
	end
	local A = allies()
	if A then pcall(A.print_status) end
	map_call("print_status")
	-- HUD v2: frame time and marker sources, the compass, the ping, the Tactical Compass adapter
	for _, name in ipairs({ "coop_hud_markers", "coop_hud_compass", "coop_hud_ping", "coop_hud_tc" }) do
		local m = rawget(_G, name)
		if m and m.print_status then
			local ok, err = pcall(m.print_status)
			if not ok then log("! %s.print_status: %s", name, tostring(err)) end
		end
	end
end

function on_game_start()
	if not api then return end -- an exe without co-op: nothing of this runs
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	local cm = codec()
	if cm and cm.add_event_handler then cm.add_event_handler(EV_STATUS, on_status) end
end
