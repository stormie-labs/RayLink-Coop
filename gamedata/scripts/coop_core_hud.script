--[[
	Anomaly Coop - core group: who is where (gamedata\scripts\coop_core_hud.script)
	Layout configs\ui\ui_coop_core.xml (party) + the stock companion slot of ui_hud.xml.

	1. Status: every player sends its own health, state (alive / down / dead), community and portrait to the
	   others ("core.status", about once a second, more often on a change). Proxies are not harmed on the
	   other machines, so their engine health tells nothing; this is the only source of a teammate's health.
	2. Party panel on the HUD (right edge, the stock companion column moves left while it is shown): one slot
	   per other player with portrait, nick, health bar, distance and state; the host has the leader marker,
	   the marker colour is the player's community. Hidden with the main HUD.
	3. PDA and minimap markers for other players: spot type "coop_player_location" (added to map_spots.xml
	   below), an arrow that turns with the player, with an edge pointer on the minimap so a teammate out of
	   sight can be followed. The map spot hook of coop_story replicates every non-local spot type, so the
	   markers are placed only when the engine reports this type as local (coop.spot_is_local, see Requests in
	   the W4 core report); otherwise they stay off and a log line says why. Name tags over heads are drawn by
	   the engine (coop_presence, console coop_nametags).

	For other scripts:
		coop_core_hud.status_of(peer) -> { h = 0..1, s = "alive"|"down"|"dead", f = community, i = icon, at } | nil
		coop_core_hud.set_party_enabled(bool) / set_spots_enabled(bool)
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local string_format = string.format
local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall

local EV_STATUS = "core.status"
local STATUS_MS = 1000 -- check own status this often
local STATUS_KEEPALIVE_MS = 5000 -- resend an unchanged status
local STATUS_STALE_MS = 15000 -- no status for this long: shown as unknown
local REFRESH_MS = 400 -- party panel
local SPOTS_MS = 1000
local MAX_SLOTS = 4
local EDGE_GAP_PX = 10 -- panel to the right screen edge, pixels
local COMP_GAP_PX = 8 -- panel to the stock companion column, pixels
local XML_FILE = "ui_coop_core.xml"
local SPOT = "coop_player_location"
local NO_ICON = "ui\\ui_noise"

local SPOT_XML = [[
<coop_player_location hint="">
	<level_map spot="coop_player_level_spot" pointer="quest_pointer"/>
	<mini_map spot="coop_player_mini_spot" pointer="quest_pointer"/>
</coop_player_location>
<coop_player_level_spot width="22" height="22" heading="1" stretch="1" alignment="c" location_level="5">
	<texture r="90" g="200" b="255">ui_icons_newPDA_manArrow</texture>
</coop_player_level_spot>
<coop_player_mini_spot width="9" height="18" heading="1" stretch="1" alignment="c" location_level="10">
	<texture r="90" g="200" b="255">ui_hud_map_arrow</texture>
</coop_player_mini_spot>
]]
local SPOT_FILES = {
	[ [[ui\map_spots.xml]] ] = true,
	[ [[ui\map_spots_16.xml]] ] = true,
	[ [[ui\map_spots_21.xml]] ] = true,
}

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-hud] %s", ok and line or tostring(fmt))
end

local function tr(id, fallback)
	local ok, s = pcall(game.translate_string, id)
	if not ok or type(s) ~= "string" or s == id then return fallback or id end
	return s
end

local function live()
	return api ~= nil and api.is_active() and (api.is_host() or api.is_live())
end

local function players()
	if not api then return {} end
	local ok, list = pcall(api.players)
	return ok and type(list) == "table" and list or {}
end

local function codec()
	return rawget(_G, "coop_main") or coop_main
end

local party_enabled, spots_enabled = true, true
local stats = { status_out = 0, status_in = 0, status_bad = 0, spots_added = 0, spots_removed = 0 }

-------------------------------------------------------------------------------
-- Status
-------------------------------------------------------------------------------
local status = {} -- peer id -> { h, s, f, i, at }
local sent = { payload = nil, at = 0 }

local LIFE = { alive = "alive", wounded = "down", dead = "dead", spectating = "dead", respawning = "dead" }

local function own_state(actor)
	if api.life_of then -- engine survival state (Request), when present
		local ok, s = pcall(api.life_of, 0)
		if ok and LIFE[s] then return LIFE[s] end
	end
	if not actor:alive() then return "dead" end
	return actor.health <= 0.011 and "down" or "alive" -- a player who is down is pinned at 1% health
end

local function send_status(tg)
	local actor = db.actor
	if not actor then return end
	local icon = actor:character_icon()
	local t = {
		h = math.floor(math.max(0, math.min(1, actor.health)) * 100 + 0.5) / 100,
		s = own_state(actor),
		f = tostring(actor:character_community() or ""),
		i = type(icon) == "string" and icon or "",
	}
	local payload = codec().encode(t)
	if payload == sent.payload and tg - sent.at < STATUS_KEEPALIVE_MS then return end
	if api.send_event(EV_STATUS, payload, -1) then
		sent.payload, sent.at = payload, tg
		stats.status_out = stats.status_out + 1
	end
end

local function on_status(payload, from)
	if type(from) ~= "number" then return end
	local t = codec().decode(payload)
	local h = tonumber(t.h)
	local s = t.s
	if not (h and h >= 0 and h <= 1 and (s == "alive" or s == "down" or s == "dead")) then
		stats.status_bad = stats.status_bad + 1
		return
	end
	local f = type(t.f) == "string" and #t.f <= 40 and t.f:match("^[%w_]*$") and t.f or ""
	local i = type(t.i) == "string" and #t.i <= 96 and t.i:match("^[%w_\\/%.]*$") and t.i or ""
	status[from] = { h = h, s = s, f = f, i = i, at = time_global() }
	stats.status_in = stats.status_in + 1
end

function status_of(peer)
	return status[peer]
end

-------------------------------------------------------------------------------
-- Party panel
-------------------------------------------------------------------------------
local function hud_visible()
	local f = rawget(_G, "main_hud_shown")
	if not f then return true end
	local ok, v = pcall(f)
	return not ok or v == true
end

local function slot_width(s)
	local w = 0
	for _, e in pairs(s) do
		local r = e:GetWndPos().x + e:GetWidth()
		if r > w then w = r end
	end
	return w
end

class "UICoopParty" (CUIScriptWnd)

function UICoopParty:__init() super()
	self.slots = {}
	self.next_at = 0
	self.clr = {
		def = GetARGB(255, 255, 255, 255),
		stalker = GetARGB(255, 255, 255, 100),
		bandit = GetARGB(255, 120, 201, 79),
		ecolog = GetARGB(255, 255, 128, 100),
		csky = GetARGB(255, 100, 200, 255),
		dolg = GetARGB(255, 255, 100, 100),
		freedom = GetARGB(255, 100, 255, 100),
		killer = GetARGB(255, 100, 100, 255),
		army = GetARGB(255, 100, 128, 255),
		monolith = GetARGB(255, 120, 201, 79),
	}
	self.state_clr = {
		alive = { icon = GetARGB(255, 255, 255, 255), name = GetARGB(255, 230, 230, 230) },
		down = { icon = GetARGB(255, 255, 80, 80), name = GetARGB(255, 255, 95, 95) },
		dead = { icon = GetARGB(255, 110, 110, 110), name = GetARGB(255, 135, 135, 135) },
		unknown = { icon = GetARGB(255, 170, 170, 170), name = GetARGB(255, 175, 175, 175) },
	}
	self:InitControls()
end

function UICoopParty:__finalize()
end

function UICoopParty:InitControls()
	local hud = utils_xml.get_hud_xml()
	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)
	self.dialog = hud:InitStatic("companion_list", self)
	for i = 1, MAX_SLOTS do
		local s = {}
		s.base = hud:InitStatic("companion_list:slot", self.dialog)
		s.background = hud:InitStatic("companion_list:slot:background", s.base)
		s.icon = hud:InitStatic("companion_list:slot:icon", s.base)
		s.hp = hud:InitProgressBar("companion_list:slot:health", s.base)
		s.name_bg = xml:InitStatic("party:name_bg", s.base)
		s.name = xml:InitTextWnd("party:name", s.base)
		s.dist = xml:InitTextWnd("party:dist", s.base)
		s.role_shadow = hud:InitStatic("companion_list:slot:team_role", s.base) -- first: drawn behind
		s.role = hud:InitStatic("companion_list:slot:team_role", s.base)
		for _, e in pairs(s) do utils_xml.correct_ratio(e) end
		s.name:SetFont(GetFontSmall())
		s.dist:SetFont(GetFontSmall())
		local rp = s.role:GetWndPos()
		s.role_shadow:SetWndPos(vector2():set(rp.x + 1, rp.y + 2))
		s.role_shadow:SetTextureColor(GetARGB(255, 0, 0, 0))
		local h = s.background:GetHeight()
		s.base:SetWndPos(vector2():set(0, (8 - i) * (h + 10))) -- the companion column's bottom-up rows
		s.base:Show(false)
		self.slots[i] = s
	end
	-- Slots are pixel sized after correct_ratio, the container x is in 1024 space: anchor at the right edge.
	local ratio_w = 1024 / device().width
	local pos = self.dialog:GetWndPos()
	self.col_w = slot_width(self.slots[1])
	self.dialog:SetWndPos(vector2():set(1024 - self.col_w - EDGE_GAP_PX * ratio_w, pos.y))
end

-- While the panel shows somebody, the stock companion column moves left of it.
function UICoopParty:PlaceCompanions(on)
	local mod = rawget(_G, "axr_companions")
	local chud = mod and mod.HUD
	if self.comp_hud and self.comp_hud ~= chud then
		self.comp_hud, self.comp_x = nil, nil -- recreated by its owner: nothing to restore
	end
	if not (chud and chud.dialog) then return end
	if on and not self.comp_hud then
		local cpos = chud.dialog:GetWndPos()
		self.comp_hud, self.comp_x = chud, cpos.x
		local my = self.dialog:GetWndPos()
		chud.dialog:SetWndPos(vector2():set(my.x - self.col_w - COMP_GAP_PX * (1024 / device().width), cpos.y))
	elseif not on and self.comp_hud then
		local cpos = chud.dialog:GetWndPos()
		chud.dialog:SetWndPos(vector2():set(self.comp_x, cpos.y))
		self.comp_hud, self.comp_x = nil, nil
	end
end

function UICoopParty:Fill(s, p, tg)
	local st = status[p.id]
	if st and tg - st.at > STATUS_STALE_MS then st = nil end
	local obj = p.avatar_id and level.object_by_id(p.avatar_id) or nil
	local state = st and st.s or "unknown"

	local icon = st and st.i ~= "" and st.i or (obj and obj:character_icon()) or NO_ICON
	if type(icon) ~= "string" or icon == "" then icon = NO_ICON end
	if s._icon ~= icon then
		s.icon:InitTexture(icon)
		s._icon = icon
	end
	local sc = self.state_clr[state] or self.state_clr.unknown
	s.icon:SetTextureColor(sc.icon)
	s.name:SetTextColor(sc.name)
	s.name:SetText(tostring(p.nick or "?"))
	s.hp:SetProgressPos(st and st.h or 0)

	local dist = ""
	if state == "down" then
		dist = tr("st_coop_core_state_down", "DOWN")
	elseif state == "dead" then
		dist = tr("st_coop_core_state_dead", "DEAD")
	elseif obj and db.actor then
		dist = string_format("%.0f m", obj:position():distance_to(db.actor:position()))
	end
	s.dist:SetText(dist)

	local mark = p.id == 0 and "ui_minimap_squad_leader" or "ui_minimap_point"
	if s._mark ~= mark then
		s.role:InitTexture(mark)
		s.role_shadow:InitTexture(mark)
		s._mark = mark
	end
	local comm = st and st.f or (obj and obj:character_community()) or ""
	comm = tostring(comm):gsub("^actor_", "")
	s.role:SetTextureColor(self.clr[comm] or self.clr.def)
end

function UICoopParty:Refresh(tg)
	local others = {}
	if party_enabled and live() and hud_visible() then
		for _, p in ipairs(players()) do
			if not p.is_self then others[#others + 1] = p end
		end
		table.sort(others, function(a, b) return (tonumber(a.id) or 0) < (tonumber(b.id) or 0) end)
	end
	self:PlaceCompanions(#others > 0)
	for i = 1, MAX_SLOTS do
		local s, p = self.slots[i], others[i]
		if p then
			self:Fill(s, p, tg)
			s.base:Show(true)
		else
			s.base:Show(false)
		end
	end
end

function UICoopParty:Update()
	CUIScriptWnd.Update(self)
	local tg = time_global()
	if tg < self.next_at then return end
	self.next_at = tg + REFRESH_MS
	local ok, err = pcall(self.Refresh, self, tg)
	if not ok then
		self.next_at = tg + 5000
		log("! party panel refresh failed: %s", tostring(err))
	end
end

local PARTY -- HUD dialog, while this Lua state lives

local function party_on()
	if PARTY then return end
	local ok, err = pcall(function()
		PARTY = UICoopParty()
		get_hud():AddDialogToRender(PARTY)
	end)
	if not ok then
		PARTY = nil
		log("! party panel failed: %s", tostring(err))
	end
end

local function party_off()
	if not PARTY then return end
	pcall(PARTY.PlaceCompanions, PARTY, false)
	pcall(function() get_hud():RemoveDialogToRender(PARTY) end)
	PARTY = nil
end

function set_party_enabled(on)
	party_enabled = on and true or false
end

-------------------------------------------------------------------------------
-- PDA / minimap markers
-------------------------------------------------------------------------------
local spot_ready -- nil: not checked in this Lua state
local placed = {} -- local object id -> hint text (markers placed by this machine)

local function spots_allowed()
	if spot_ready ~= nil then return spot_ready end
	spot_ready = false
	if not (api and api.spot_is_local) then
		log("player markers on the PDA map are off: coop.spot_is_local is missing (engine request, W4 core)")
		return false
	end
	local ok, is_local = pcall(api.spot_is_local, SPOT)
	if not (ok and is_local == true) then
		log("player markers on the PDA map are off: the engine replicates spot type '%s'", SPOT)
		return false
	end
	-- AddMapLocation asserts on a type that map_spots.xml lacks: check that the injection works here.
	local okx, has = pcall(function()
		local x = CScriptXmlInit()
		x:ParseFile("map_spots.xml")
		return x:NodeExist(SPOT, 0)
	end)
	spot_ready = okx and has == true
	if not spot_ready then log("! spot type '%s' is not in map_spots.xml (DXML on_xml_read did not run)", SPOT) end
	return spot_ready
end

local function spot_hint(p)
	local st = status[p.id]
	local text = tostring(p.nick or "?")
	if st and st.s == "down" then
		text = text .. " - " .. tr("st_coop_core_state_down", "DOWN")
	elseif st and st.s == "dead" then
		text = text .. " - " .. tr("st_coop_core_state_dead", "DEAD")
	end
	return text
end

local function remove_spot(id)
	if level.map_has_object_spot(id, SPOT) ~= 0 then
		level.map_remove_object_spot(id, SPOT)
		stats.spots_removed = stats.spots_removed + 1
	end
	placed[id] = nil
end

local function update_spots()
	local want = {}
	if spots_enabled and live() and level.present() and spots_allowed() then
		for _, p in ipairs(players()) do
			local id = p.avatar_id
			if not p.is_self and type(id) == "number" and id > 0 and id < 65535 and level.object_by_id(id) then
				want[id] = p
			end
		end
	end
	for id in pairs(placed) do
		if not want[id] then remove_spot(id) end
	end
	for id, p in pairs(want) do
		local hint = spot_hint(p)
		if level.map_has_object_spot(id, SPOT) == 0 then
			level.map_add_object_spot(id, SPOT, hint)
			stats.spots_added = stats.spots_added + 1
			placed[id] = hint
		elseif placed[id] ~= hint then
			level.map_change_spot_hint(id, SPOT, hint)
			placed[id] = hint
		end
	end
end

local function clear_spots()
	for id in pairs(placed) do pcall(remove_spot, id) end
	placed = {}
end

function set_spots_enabled(on)
	spots_enabled = on and true or false
end

local function on_xml_read(xml_file_name, xml_obj)
	if not SPOT_FILES[xml_file_name] then return end
	local ok, err = pcall(function()
		if #xml_obj:query(SPOT) > 0 then return end
		xml_obj:insertFromXMLString(SPOT_XML)
	end)
	if not ok then log("! map spot type not added to %s: %s", tostring(xml_file_name), tostring(err)) end
end

-------------------------------------------------------------------------------
-- Update, callbacks
-------------------------------------------------------------------------------
local next_status, next_spots = 0, 0

local function actor_on_update()
	if not api then return end
	local tg = time_global()
	if live() then
		party_on()
		if tg >= next_status then
			next_status = tg + STATUS_MS
			local ok, err = pcall(send_status, tg)
			if not ok then log("! status not sent: %s", tostring(err)) end
		end
		if tg >= next_spots then
			next_spots = tg + SPOTS_MS
			local ok, err = pcall(update_spots)
			if not ok then
				next_spots = tg + 10000
				log("! player markers: %s", tostring(err))
			end
		end
	elseif not api.is_active() then
		if next(placed) then clear_spots() end
		if next(status) then status = {} end
		sent.payload = nil
		party_off()
	end
end

local function actor_on_net_destroy()
	clear_spots()
	party_off()
end

function print_status()
	local n = 0
	for _ in pairs(status) do n = n + 1 end
	local m = 0
	for _ in pairs(placed) do m = m + 1 end
	log("hud: status out %d, in %d (bad %d), players with status %d | party panel %s | markers %s, placed %d (added %d, removed %d)",
		stats.status_out, stats.status_in, stats.status_bad, n, PARTY and "on" or "off",
		spot_ready == nil and "not checked" or (spot_ready and "on" or "off"), m, stats.spots_added, stats.spots_removed)
end

function on_game_start()
	if not api then return end -- an exe without co-op: nothing of this runs
	RegisterScriptCallback("on_xml_read", on_xml_read)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	local cm = codec()
	if cm and cm.add_event_handler then cm.add_event_handler(EV_STATUS, on_status) end
end
