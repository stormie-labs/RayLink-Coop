--[[
	Anomaly Coop - NPC group (W4 "npc"): meeting and talking to NPCs for every player.
	Port of the behaviour of xrRazom 1.4 xrr_patch_meet, xrr_patch_wounded and the NPC side of
	xrr_wounded (own code, our event API). The talk lock itself (one talker per NPC) is coop_dialog (C++);
	a player's own down/revive state is coop_survival (C++).

	Host (stock xr_meet only ever looks at db.actor):
	  - Greetings, hello/bye lines, "stop/hide your weapon" warnings and the close/far animations of the meet
	    scheme react to the clients' proxies as well; the NPC faces the nearest player it is meeting.
	  - "Get out of my way" (a player standing on an NPC for 4 s) and the squad's commander threat count
	    every player.
	  - xr_conditions.actor_is_safemode answers for a proxy (weapon not in hands = safe).
	  - Per client, for the NPCs near that client's character: may this player talk to it, trade with it,
	    which use-tip and which start dialog does it show (npc.talk, sent on change and every 15 s). Answered
	    for that player: its relation and faction, its distance, the wounded rules, task givers of the group.
	    A client's NPCs are puppets whose own meet logic never runs, so without this a client could only talk
	    to NPCs that were talkable at the moment it joined.
	  - Wounded state of the NPCs near a client (npc.wnd): the help-wounded dialogs and IsWounded() read it.
	Client:
	  - Applies npc.talk / npc.wnd to the puppets.
	  - Help-wounded dialog actions (dialogs.transfer_medkit, transfer_medkit_to_hip, transfer_bandage) run
	    as stock here (the item and the relation go to the host through the engine) and ask the host to let
	    the NPC use the medkit (npc.heal), which only the host's wound manager can do.
	Both: xr_meet.process_npc_usability skips an NPC whose storage is gone (level change race).

	Events (ids in host numbering):
	  npc.talk  host -> client  { i = npc, t = talk, r = trade, x = tip text, d = start dialog | "" }
	  npc.wnd   host -> client  { i = npc, s = wounded state | "nil", f = wounded_fight | "nil" }
	  npc.heal  client -> host  { i = npc, k = "medkit" | "bandage" }
	Stock functions wrapped: xr_meet.Cmeet_manager.update, update_state, set_start_distance;
	xr_meet.evaluator_contact.evaluate; xr_meet.action_meet_wait.execute; xr_meet.process_npc_usability;
	xr_conditions.actor_is_safemode; dialogs.transfer_medkit, transfer_medkit_to_hip, transfer_bandage.
--]]

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next

local TAG = "meet"
local P -- coop_npc_players

local function log(fmt, ...) P.log(TAG, fmt, ...) end
local function report(what, err) P.report(TAG, what, err) end

local EV_TALK, EV_WND, EV_HEAL = "npc.talk", "npc.wnd", "npc.heal"
local TALK_RADIUS = 30 -- metres: flags are kept for NPCs this close to a client's character
local REFRESH_MS = 15000

-- Stock non-enemy defaults of init_meet (a client of another faction than the host gets these).
local DEF_USE = "{=is_wounded} false, {!is_squad_commander} false, {=actor_enemy} false, {=has_enemy} false, {=dist_to_actor_le(3)} true, false"
local DEF_TRADE = "true"

local installed = false
local host_on = false
local orig = {}
local stats = { talk_out = 0, talk_in = 0, wnd_out = 0, wnd_in = 0, heal_out = 0, heal_in = 0, greet = 0 }

local function pick(who, npc, condlist)
	if not condlist then return nil end
	return xr_logic.pick_section_from_condlist(who, npc, condlist)
end

local function pick_num(who, npc, condlist, def)
	return tonumber(pick(who, npc, condlist)) or def
end

-------------------------------------------------------------------------------
-- Host: the meet manager meets the proxies too
-------------------------------------------------------------------------------
local function play(npc, who, condlist)
	local snd = pick(who, npc, condlist)
	if snd and snd ~= "nil" and snd ~= "" then
		xr_sound.set_sound_play(npc:id(), snd)
		stats.greet = stats.greet + 1
	end
end

local function mm_update(self)
	if not host_on then
		self.coop_focus = nil
		return orig.mm_update(self)
	end
	local tg = time_global()
	if self.__stimer and tg < self.__stimer then return end -- the stock 500 ms throttle
	orig.mm_update(self) -- the host's own player, stock

	local npc = self.npc
	local proxies = P.others()
	local focus_id, focus_state, focus_dist = nil, self.current_distance, math.huge
	if focus_state and db.actor then
		focus_id = 0
		focus_dist = db.actor:position():distance_to(npc:position())
	end
	if #proxies == 0 then
		self.coop_focus = focus_id
		return
	end
	self.coop_flags = self.coop_flags or {}
	local in_combat = state_mgr.is_npc_in_combat(npc)
	local npc_pos = npc:position()
	for _, p in ipairs(proxies) do
		local pid = p:id()
		local fl = self.coop_flags[pid]
		if not fl then
			fl = {}
			self.coop_flags[pid] = fl
		end
		local dist = npc_pos:distance_to(p:position())
		local visible = npc:see(p)
		if visible then
			if dist <= pick_num(p, npc, self.a.close_snd_distance, 0) then
				if not fl.hello then
					fl.hello = true
					if not in_combat then play(npc, p, self.a.close_snd_hello) end
				end
			elseif dist <= pick_num(p, npc, self.a.far_snd_distance, 0) then
				if fl.hello and not fl.bye then
					fl.bye = true
					if not in_combat then play(npc, p, self.a.close_snd_bye) end
				end
			end
		end
		local is_close = visible and dist <= pick_num(p, npc, self.a.close_distance, 3)
		local is_far = visible and dist <= pick_num(p, npc, self.a.far_distance, 5)
		if is_close then
			if focus_state ~= "close" or dist < focus_dist then
				focus_id, focus_state, focus_dist = pid, "close", dist
			end
		elseif is_far then
			if not focus_state or (focus_state == "far" and dist < focus_dist) then
				focus_id, focus_state, focus_dist = pid, "far", dist
			end
		elseif dist > (self.a.reset_distance or 30) then
			fl.hello, fl.bye = false, false
		end
	end
	self.current_distance = focus_state
	self.coop_focus = focus_id
end

local function mm_update_state(self)
	local fid = self.coop_focus
	if not (host_on and fid and fid ~= 0) then return orig.mm_update_state(self) end
	local focus = level.object_by_id(fid)
	if not (focus and focus:alive()) then
		self.coop_focus = nil
		return orig.mm_update_state(self)
	end
	local npc = self.npc
	local close = self.current_distance == "close"
	local state = pick(focus, npc, close and self.a.close_anim or self.a.far_anim)
	if state and state ~= "nil" and state ~= "" then
		local victim_str = pick(focus, npc, close and self.a.close_victim or self.a.far_victim)
		-- "actor" in a meet profile is the player being met: here the proxy.
		local victim = victim_str == "actor" and focus or get_story_object(victim_str)
		state_mgr.set_state(npc, state, nil, nil, { look_object = victim })
	end
	play(npc, focus, self.a.far_snd)
end

-- Stock "already in range when the scheme starts: no greeting", per proxy.
local function mm_set_start_distance(self)
	orig.mm_set_start(self)
	if not (host_on and self.npc:alive()) then return end
	local npc = self.npc
	local npc_pos = npc:position()
	self.coop_flags = self.coop_flags or {}
	for _, p in ipairs(P.others()) do
		local pid = p:id()
		local fl = self.coop_flags[pid] or {}
		self.coop_flags[pid] = fl
		local dist = npc_pos:distance_to(p:position())
		local visible = npc:see(p)
		if visible and dist <= pick_num(p, npc, self.a.close_distance, 3) then
			fl.hello = true
		elseif visible and dist <= pick_num(p, npc, self.a.far_distance, 5) then
			fl.bye = true
		elseif dist > (self.a.reset_distance or 30) then
			fl.hello, fl.bye = false, false
		end
	end
end

local function any_player_seen_or_near(npc, d2)
	local pos = npc:position()
	for _, p in ipairs(P.everyone()) do
		if npc:see(p) or p:position():distance_to_sqr(pos) <= d2 then return true end
	end
	return false
end

-- Stock evaluator with "the actor" = any player for gtfo and the commander threat.
local function eva_evaluate(self)
	if not host_on then return orig.eva_evaluate(self) end
	local obj = self.object
	if not obj:alive() or self.a.meet_set ~= true then return false end
	if not (db.actor and db.actor:alive()) then return false end
	self.a.meet_manager:update()
	local st = db.storage[obj:id()]
	if st and st.victim_surrender == 0 then return true end
	if xr_wounded.is_wounded(obj) then return false end
	if obj:best_enemy() ~= nil then return false end
	local state = state_mgr.get_state(obj)
	if state == "search_corpse" or state == "pickup_crouch" then return false end
	if (obj:has_info("npcx_is_companion") or not get_object_story_id(obj:id())) and not obj:is_talking() then
		if self.a.gtfo == true then return true end
		local animpoint = utils_obj.get_current_action_id(obj) == xr_actions_id.animpoint_action + 1
		if P.nearest_dist_sqr(obj:position()) < 1.5 and not animpoint then
			self.a.dtimer = self.a.dtimer or (time_global() + 4000)
			if time_global() > self.a.dtimer then
				self.a.dtimer = nil
				self.a.gtfo = true
				return true
			end
		end
	end
	local squad = get_object_squad(obj)
	local commander = squad and squad:commander_id() ~= obj:id() and level.object_by_id(squad:commander_id())
	if commander and state_mgr.get_state(commander) == "threat_na"
		and utils_obj.get_current_action_id(commander) == xr_actions_id.stohe_meet_base + 1 then
		if any_player_seen_or_near(obj, 225) then
			self.a.commander_threat = true
			return true
		end
	else
		self.a.commander_threat = nil
	end
	return self.a.meet_manager.current_distance ~= nil
end

-- Stock action; the gtfo distance and the commander threat target are the nearest player.
local function act_execute(self)
	if not host_on then return orig.act_execute(self) end
	local npc = self.object
	if self.a.gtfo and self.a.can_gtfo == "true" then
		action_base.execute(self)
		if npc:is_talking() or P.nearest_dist_sqr(npc:position()) > 4 then
			utils_obj.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id())
			self.a.gtfo, self.a.vertex_id, self.a.stage = nil, nil, 0
			return
		end
		if self.a.stage == 0 then
			self.a.vertex_id = utils_obj.try_go_backward(npc, 5, self.a.vertex_id)
			if self.a.vertex_id then
				npc:set_desired_direction()
				state_mgr.set_state(npc, "patrol")
				self.a.stage = 1
				self.a.dtimer = time_global() + 4000
			end
		elseif self.a.stage == 1 then
			if npc:level_vertex_id() == self.a.vertex_id or time_global() > self.a.dtimer then
				self.a.gtfo, self.a.vertex_id, self.a.stage = nil, nil, 0
				return
			end
			utils_obj.send_to_nearest_accessible_vertex(npc, self.a.vertex_id)
		end
		return
	elseif self.a.commander_threat then
		-- The stock rush-and-threat sequence needs the target; outside of it the stock action is right.
		local target = P.nearest(npc:position()) or db.actor
		if target and target:id() ~= 0 then
			return P.with_identity(target, orig.act_execute, self)
		end
	end
	return orig.act_execute(self)
end

-------------------------------------------------------------------------------
-- Host: talk / trade flags per client, wounded state
-------------------------------------------------------------------------------
local cond_cache = {} -- npc id -> { ini, ms, use, trade, explicit_use, explicit_trade, text }

local function meet_condlists(npc, st, a)
	local ms = a.meet_section or "nil"
	local ini = st.ini
	if not ini or ms == "nil" or ms == "no_meet" then return nil end
	local id = npc:id()
	local c = cond_cache[id]
	if not (c and c.ms == ms and rawequal(c.ini, ini)) then
		local ok, built = pcall(function()
			return {
				ms = ms, ini = ini,
				use = ini:r_string_to_condlist(ms, "use", DEF_USE),
				trade = ini:r_string_to_condlist(ms, "trade_enable", DEF_TRADE),
				explicit_use = ini:r_string_ex(ms, "use") ~= nil,
				explicit_trade = ini:r_string_ex(ms, "trade_enable") ~= nil,
			}
		end)
		c = ok and built or { ms = ms, ini = ini }
		cond_cache[id] = c
	end
	return c
end

local function player_comm(who)
	local c = who:character_community() or ""
	if c:sub(1, 6) == "actor_" then c = c:sub(7) end
	return c ~= "" and c or "stalker"
end

local function enemy_for(npc, who)
	local ok, r = pcall(function()
		return game_relations.is_factions_enemies(player_comm(who), character_community(npc))
			or npc:relation(who) == game_object.enemy
	end)
	return ok and r or false
end

local function task_target(npc)
	local id = npc:id()
	local tm = task_manager and task_manager.get_task_manager and task_manager.get_task_manager()
	if not (tm and tm.task_info) then return false end
	for k, v in pairs(tm.task_info) do
		if v.task_giver_id == id then return true end
		if tasks_delivery and tasks_delivery.is_delivery_task and tasks_delivery.is_delivery_task(k) then
			local var = load_var(db.actor, k)
			if var and var.target_id == id then return true end
		end
	end
	return false
end

-- Stock process_npc_usability + trade/tip of the meet manager, for player `who`. nil = leave as is.
local function talk_state(npc, who)
	local st = db.storage[npc:id()]
	if not st then return nil end
	if character_community(npc) == "zombied" then return { t = false, r = false, x = "" } end
	if IsWounded(npc) then
		local talk = false
		if not (npc:relation(who) >= game_object.enemy and st.victim_surrender ~= who:id()) then
			talk = st.wounded and st.wounded.enable_talk and true or false
		end
		return { t = talk, r = false, x = talk and "character_use" or "" }
	end
	if npc:section() == "mar_smart_terrain_doc_doctor" then return { t = true, r = true, x = "character_use" } end
	local mm = st.meet and st.meet.meet_manager
	if not (mm and mm.a) then return nil end
	local a = mm.a
	local c = meet_condlists(npc, st, a)
	local enemy = enemy_for(npc, who)
	local use
	if c and c.explicit_use then
		use = pick(who, npc, c.use)
	elseif enemy then
		use = "false"
	else
		use = pick(who, npc, c and c.use or a.use)
	end
	if mm.npc_is_camp_director == true then use = "false" end
	if load_var(db.actor, "force_all_talk", false) then use = "true" end
	local talk
	if use == "true" then
		talk = not (xr_corpse_detection.is_under_corpse_detection(npc) or xr_help_wounded.is_under_help_wounded(npc))
	elseif use == "self" then
		talk = true
	elseif task_target(npc) then
		talk = true
	elseif use == "false" then
		talk = false
	else
		talk = npc:is_talk_enabled()
	end
	local trade
	if c and c.explicit_trade then
		trade = pick(who, npc, c.trade) == "true"
	else
		trade = not enemy and pick(who, npc, c and c.trade or a.trade_enable) == "true"
	end
	local text = pick(who, npc, a.use_text)
	if not (text and text ~= "" and text ~= "nil") then text = talk and "character_use" or "" end
	local d = mm.startdialog
	return { t = talk, r = trade, x = text, d = (type(d) == "string" and d ~= "nil") and d or "" }
end

local sent_talk = {} -- npc id -> peer -> { sig, at }
local sent_wnd = {} -- npc id -> peer -> sig
local next_npc = {} -- npc id -> time of its next check

local function push_npc(npc)
	local id = npc:id()
	local tg = time_global()
	if next_npc[id] and tg < next_npc[id] then return end
	next_npc[id] = tg + 500
	local pos = npc:position()
	local r2 = TALK_RADIUS * TALK_RADIUS
	for _, p in ipairs(P.others()) do
		if p:position():distance_to_sqr(pos) <= r2 then
			local peer = P.peer_of(p)
			if peer then
				-- A modded condlist choking on a proxy must not break the NPC's update: errors are counted.
				local ok, s = pcall(talk_state, npc, p)
				if not ok then
					report("talk state " .. npc:name(), s)
				elseif s then
					local sig = string.format("%s|%s|%s|%s", tostring(s.t), tostring(s.r), tostring(s.x), tostring(s.d))
					sent_talk[id] = sent_talk[id] or {}
					local last = sent_talk[id][peer]
					if not last or last.sig ~= sig or tg - last.at > REFRESH_MS then
						if P.send(EV_TALK, { i = id, t = s.t, r = s.r, x = s.x, d = s.d }, peer) then
							sent_talk[id][peer] = { sig = sig, at = tg }
							stats.talk_out = stats.talk_out + 1
						end
					end
				end
				local wst = tostring(load_var(npc, "wounded_state"))
				local wf = tostring(load_var(npc, "wounded_fight"))
				local wsig = wst .. "|" .. wf
				sent_wnd[id] = sent_wnd[id] or {}
				if sent_wnd[id][peer] ~= wsig then
					if P.send(EV_WND, { i = id, s = wst, f = wf }, peer) then
						sent_wnd[id][peer] = wsig
						stats.wnd_out = stats.wnd_out + 1
					end
				end
			end
		end
	end
end

local function process_npc_usability(npc)
	if not (npc and db.storage[npc:id()]) then
		if P.active() then return end -- storage torn down by a level change: the stock code would crash
	end
	orig.usability(npc)
	if host_on and npc:alive() then push_npc(npc) end
end

local function patched_safemode(actor, npc)
	if host_on and actor and actor:id() ~= 0 and P.is_proxy(actor) then
		-- the player's own "weapon lowered" state (C1.9, W5); nil = unknown (older sender): the weapon in hands
		local api = rawget(_G, "coop")
		if api and api.player_safemode and api.peer_of_avatar then
			local ok, peer = pcall(api.peer_of_avatar, actor:id())
			if ok and peer then
				local ok2, safe = pcall(api.player_safemode, peer)
				if ok2 and safe ~= nil then return safe == true end
			end
		end
		local item = actor:active_item()
		return not (item and IsWeapon(item))
	end
	return orig.safemode(actor, npc)
end

-------------------------------------------------------------------------------
-- Client: apply the host's flags; help-wounded goes to the host
-------------------------------------------------------------------------------
local function client_on_talk(t)
	if type(t.i) ~= "number" then return end
	local npc = level.object_by_id(P.to_local(t.i))
	if not (npc and npc:alive()) then return end
	stats.talk_in = stats.talk_in + 1
	if t.t == true then npc:enable_talk() elseif t.t == false then npc:disable_talk() end
	if t.r == true then npc:enable_trade() elseif t.r == false then npc:disable_trade() end
	if type(t.x) == "string" then npc:set_tip_text(t.x) end
	if type(t.d) == "string" then
		local st = db.storage[npc:id()]
		local mm = st and st.meet and st.meet.meet_manager
		local cur = mm and mm.coop_dialog
		if cur ~= t.d and not npc:is_talking() then
			if t.d == "" then npc:restore_default_start_dialog() else npc:set_start_dialog(t.d) end
			if mm then mm.coop_dialog = t.d end
		end
	end
end

local function client_on_wnd(t)
	if type(t.i) ~= "number" or type(t.s) ~= "string" then return end
	local npc = level.object_by_id(P.to_local(t.i))
	if not npc then return end
	stats.wnd_in = stats.wnd_in + 1
	save_var(npc, "wounded_state", t.s ~= "nil" and t.s or nil)
	save_var(npc, "wounded_fight", (type(t.f) == "string" and t.f ~= "nil") and t.f or nil)
	local st = db.storage[npc:id()]
	local wm = st and st.wounded and st.wounded.wound_manager
	if wm then wm.state = t.s end
end

local function patch_help_wounded()
	local d = _G["dialogs"]
	if not d then return end
	local function wrap(name, kind)
		local f = d[name]
		if type(f) ~= "function" or orig["d_" .. name] then return end
		orig["d_" .. name] = f
		d[name] = function(first_speaker, second_speaker, ...)
			local r = f(first_speaker, second_speaker, ...)
			if P.client_live() then
				local npc = d.who_is_npc and d.who_is_npc(first_speaker, second_speaker) or second_speaker
				if npc and npc:id() ~= 0 and P.send(EV_HEAL, { i = P.to_host(npc:id()), k = kind }, 0) then
					stats.heal_out = stats.heal_out + 1
				end
			end
			return r
		end
	end
	wrap("transfer_medkit", "medkit")
	wrap("transfer_medkit_to_hip", "medkit")
	wrap("transfer_bandage", "bandage")
end

local function host_on_heal(t, from)
	if type(t.i) ~= "number" then return end
	local npc = level.object_by_id(t.i)
	local who = P.object_of_peer(from)
	if not (npc and npc:alive() and who) then return end
	if npc:position():distance_to_sqr(who:position()) > 100 then return end -- 10 m: the talker stands by
	stats.heal_in = stats.heal_in + 1
	if t.k == "medkit" then xr_wounded.unlock_medkit(npc) end
end

-------------------------------------------------------------------------------
-- Install, update, events
-------------------------------------------------------------------------------
local function install()
	local m = _G["xr_meet"]
	if m and m.Cmeet_manager and m.evaluator_contact and m.action_meet_wait then
		local cm = m.Cmeet_manager
		orig.mm_update, orig.mm_update_state, orig.mm_set_start = cm.update, cm.update_state, cm.set_start_distance
		cm.update, cm.update_state, cm.set_start_distance = mm_update, mm_update_state, mm_set_start_distance
		orig.eva_evaluate = m.evaluator_contact.evaluate
		m.evaluator_contact.evaluate = eva_evaluate
		orig.act_execute = m.action_meet_wait.execute
		m.action_meet_wait.execute = act_execute
		if type(m.process_npc_usability) == "function" then
			orig.usability = m.process_npc_usability
			m.process_npc_usability = process_npc_usability
		end
	else
		log("! xr_meet classes not found: meetings stay single-player")
	end
	if xr_conditions and type(xr_conditions.actor_is_safemode) == "function" then
		orig.safemode = xr_conditions.actor_is_safemode
		xr_conditions.actor_is_safemode = patched_safemode
	end
	local ok, err = pcall(patch_help_wounded)
	if not ok then report("install help-wounded", err) end
	installed = true
end

local next_tick, next_clean = 0, 0

local function actor_on_update()
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + 250
	local was = host_on
	host_on = installed and P.host_with_clients()
	if was and not host_on then sent_talk, sent_wnd = {}, {} end
	if now >= next_clean then
		next_clean = now + 60000
		for id in pairs(next_npc) do
			if not level.object_by_id(id) then
				next_npc[id], sent_talk[id], sent_wnd[id], cond_cache[id] = nil, nil, nil, nil
			end
		end
	end
end

function print_status()
	log("installed %s | greetings for proxies %d | talk flags out %d in %d, wounded out %d in %d, help-wounded out %d in %d | errors %d",
		tostring(installed), stats.greet, stats.talk_out, stats.talk_in, stats.wnd_out, stats.wnd_in, stats.heal_out,
		stats.heal_in, P.error_count(TAG))
end

function on_game_start()
	P = coop_npc_players
	if not rawget(_G, "coop") then return end
	if not installed then
		local ok, err = pcall(install)
		if not ok then report("install", err) end
	end
	P.on(EV_TALK, client_on_talk, "client", TAG)
	P.on(EV_WND, client_on_wnd, "client", TAG)
	P.on(EV_HEAL, host_on_heal, "host", TAG)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end

function _set_host_on(v) host_on = v end
function _stats() return stats end
function _talk_state(npc, who) return talk_state(npc, who) end
