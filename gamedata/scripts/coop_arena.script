--[[
	Anomaly Coop - the Bar arena and the totalizator in a session (gamedata\scripts\coop_arena.script).

	Stock knows one actor (xr_effects.bar_arena_teleport, bar_arena_teleport_2, bar_arena_weapon_slot,
	teleport_for_totaliz_out, dialogs_mlr.teleport_for_totaliz; the trigger bar_arena_triger.ltx and its
	sr_cutscene@fight_N): his whole inventory goes into the story box bar_arena_inventory_box, he gets the fight's kit; on the
	way out what he has goes into bar_arena_inventory_box_2 and the first box comes back to him.
	In a session that broke three ways (a player's report of 2026-11-07, vanilla Anomaly: "one player loses his weapons,
	armour and helmet, the other drops out of sync and walks the map naked and unseen"):
	  - the trigger is a world restrictor nobody walks into: its actor effects went to every player, and its cutscene (a section
	    scheme, run by every machine that takes the host's section) took everybody on the Bar into the arena;
	  - a client's own moves into and out of a story box are requests the host checks for reach (15 m) while the cutscene
	    carries him away, rate limited item by item; the host's own way back took the whole box, other players' gear with it;
	  - the arena zone counts a client's character (a stalker on the host) as an arena item: its purge took him out of the world.
	Here the arena is one player's fight:
	  - The taker: the player who talked to the arena manager (story id bar_arena_manager) last (the engine's talk locks,
	    coop.talk_recent), else the one nearest to him; picked by the authority of the Bar (the host, or the map server of the
	    Bar) when the fight is taken. Group entry (owner 2026-11-07): with other players on the Bar the trigger waits in
	    sr_idle@wait_N (its 1 s timer held, nobody's UI taken) while they gather at Arnie (GATHER_RADIUS): they are invited (a tip
	    and a map spot on Arnie); whoever stands at Arnie has one button: alone "start alone", with others but not everybody
	    "start without the others" (a vote among those at Arnie: coop_economy_group.propose, its box and "Time to vote", silence
	    = no). Everybody on the Bar at Arnie: it starts by itself; nobody else on the Bar: at once, as stock. Everyone at Arnie at
	    the start fights (the taker first). The trigger's actor effects (disable_ui, enable_ui) go to the fighters (coop_npc_logic
	    audience rule). Its cutscene plays on the fighters' machines alone, each put at a spot of his own; anywhere else the
	    section stands still, and on the authority it ends when theirs end (arena.cut), or after CUT_WAIT_MS. One who falls is out;
	    the fight goes on while a fighter is left.
	  - His gear: the authority moves it, and keeps a ledger per player (the ids; the ids of the kit his machine made; saved with
	    the host's world, and with split levels carried through the world server, coop_levels_share "arena_ledger"):
	      in   his whole inventory into box 1;
	      out  into box 2 what the arena gave him: everything he holds when the fight or the bet just ended or he stands in the
	           arena (stock), else (a respawn elsewhere, a rejoin, a late answer) only his kit; the arena's purge (not while
	           another player's fight runs); the ids of his ledger from box 1 back to him. No box 1 here: the ledger waits.
	    Then his own machine runs the stock call for the rest (the kit, the screen, the way in or out), with both story boxes
	    hidden (get_story_object answers nil for them) and the purge left out: the boxes are the authority's. The way in waits
	    until the moved gear has left his machine (IN_WAIT_MS). Mods that wrap these functions (GAMMA: kits, magazines, Powered
	    Exos) run there as in single player; what they make is the kit (arena.kit). Our wrappers are kept the outermost (a mod
	    that wraps later is wrapped again).
	  - A bet at the totalizator is the same: in from the dialog (the bettor asks, arena.bet; refused while his gear is in a box
	    already), out from the totalizator's restrictor, for every bettor of the ledger. Stock moves the bettor inside its box
	    branch: that move is made here.
	  - A fighter who falls gets his gear back when he respawns (coop_respawned), or when he is back on the Bar after a rejoin
	    and no fight runs (actor_on_first_update): he asks (arena.out), the authority gives it back and answers with the way out.
	    An ask that never came (sent before his game was live, lost with a crash): the authority gives back by itself a ledger
	    older than HEAL_GRACE_MS whose player stands on the Bar with nothing of his running (his fight, a totalizator battle).
	    His flag (coop_arena_gear) is a per-player key: the host keeps it for his character, a client never saves.
	  - The arena zone never counts a player: xr_zones.arena_zone_binder:purge_items leaves players out.
	  - Arnie's prizes (dialogs_bar.new_arena_give_reward, and arena_give_reward of the monster fight) are the authority's: anybody
	    may collect one (it opens the next fight), the money goes to the fight's fighters (split by the setting
	    coop_share_rewards), the arena battle counts on each fighter's machine, and a fight that runs meanwhile keeps
	    bar_arena_fight and bar_arena_fight_begin (stock takes them off: in single player the prize always comes after the fight).
	    A player's kill is counted by his own machine, whose stock game_statistics.increment_reputation spares him while
	    bar_arena_fight is on: a prize collected during his fight cost him the reputation (live 2026-11-07). A reputation change
	    during a fight goes into the player's log with its source.
	  - Arnie's monster fight (the old arena: bar_arena_start, restrictors bar_arena_sr and bar_arena_spam; the player walks in,
	    no gear moves) speaks through effects the host runs: the introduction, "the fight begins", the countdown 10-90 s, "time
	    is up", "victory", "you are afraid", "dead". Their lines (news_manager.send_tip) go to its fighter alone (arena.go "tip"),
	    the infos they give stay the world's. The fighter: of a running fight (bar_arena_fight_N) its fighter; else the one
	    picked when he walks into bar_arena_waiter (among those who walked in), kept until "victory", "dead" or "you are afraid".
	    Its death: in a session nobody dies for the engine and bar_arena_sr's {=actor_dead} read the host; asked by bar_arena_sr it
	    now means "no player alive or down in its zone for PIT_GONE_MS" (the fighter seen there is the fight's, also after a load,
	    and kept in the host's save), and the branch's dead end sr_idle@nil is put back to the arena's start (pit_reset_tick).
	Single player and an exe without co-op: stock, untouched.

	Events (coop_npc_players):
	  arena.go   authority -> player   { f = "in" | "out" | "slot" | "bet_in" | "bet_out" | "none" | "tip" | "stat", a = argument }
	             (tip: a = the line's string id; to, s, st, sid = the rest of news_manager.send_tip)
	  arena.bet  bettor -> authority   { }
	  arena.out  player -> authority   { }  his gear back
	  arena.cut  fighter -> authority  { }  his cutscene ended
	  arena.kit  player -> authority   { i = "id,id,..." }  what his stock call made (the kit)
	  arena.prize player -> authority  { k = "new" | "old" }  he collects a prize at Arnie
	  arena.start player -> authority  { }  his button at Arnie ("start alone" / "start without the others")
	  arena.go "gather": a = "invite" | "solo" | "vote" | "off" (n = the fight, w = the taker's nick, c / t = at Arnie / on the Bar);
	           "ui_off": stock disable_ui on his machine (the group's start); "in": k = his spot in the pit
	Status: coop_status line "arena".
--]]

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next

local TAG = "arena"
local ARENA_LEVEL = "l05_bar"
local BOX_IN, BOX_OUT = "bar_arena_inventory_box", "bar_arena_inventory_box_2"
local MANAGER = "bar_arena_manager"
local GATHER_RADIUS = 12 -- m around Arnie: the players there at the start go into the fight
local SPOT_STEP = 1.5 -- m between the fighters' spots in the pit (sideways from the cutscene's point)
local SPOT_TYPE = "secondary_task_location" -- the invitation's map spot on Arnie (stock map_spots.xml)
local TRIGGER = "bar_arena_triger"
local ZONE = "bar_arena"
local FIGHTS = 8
local CUT_WAIT_MS = 30000
local IN_WAIT_MS = 3000
local HEAL_GRACE_MS = 15000 -- a ledger older than this whose player stands here with nothing of his running: given back
local TICK_MS = 1000
local TALK_WINDOWS = { 2000, 5000, 15000, 60000 } -- coop.talk_recent takes up to 60 s
-- dialogs_mlr.teleport_for_totaliz moves the bettor inside its box branch (stock dialogs_mlr.script:1438-1439, GAMMA's
-- Lottery Rebalance the same): with the box hidden that move is ours.
local BET_POS = { 139.61517333984, -13.390427589417, 100.86038208008 }
local BET_LV, BET_GV = 37564, 1710

local P -- coop_npc_players
local function C() return coop_mods_core end

local ledger = {} -- authority: avatar id -> { kind = "fight" | "bet", items = { id, ... }, kit = { id, ... }, at = time }
local fight = nil -- authority: { id = the taker's avatar id, n = the fight, ids = the fighters (the taker first; nil while held),
--   hold = the group gathers at Arnie, modes = { [id] = the last gather mode sent }, vote = a vote runs, cuts = { [id] = his cutscene ended } }
local pit = nil -- authority: { id = the fighter's avatar id } of Arnie's monster fight (the old arena: its lines are his)
local cut_done = false -- authority: the fighter's cutscene ended
local fighters_of = {} -- authority: fight n -> { avatar id, ... } of its fighters (its prize is theirs)
local pit_won = nil -- authority: the avatar id of the fighter of the last won monster fight (its bet prize is his)
local paying = false -- authority: a prize's stock call runs (wrappers under ours let it through)
local mine = false -- this player: false | "fight" | "bet" - his gear waits in the box
local fighting = false -- this player fights the running fight: its cutscene plays here
local spot_k = 0 -- this player: his place among the fighters (0: the cutscene's point, then sideways)
local invite_spot = nil -- this player: the id of Arnie with the invitation's map spot
local gather_box = nil -- this player: the open button box at Arnie
local passing = false -- the stock chain runs for this machine's own player: our wrappers let it through
local arena_zone = nil -- the binder of the arena zone here (xr_zones.arena_zone_binder): its object answers inside()
local got_down = false -- the map server of the Bar: the world server's copy of the ledger came (split levels)
local world_copy = nil -- the world server: the ledger of the Bar's map server, kept in its save (split levels)
local OURS = {} -- our wrapper functions
local stats = { stowed = 0, returned = 0, to_box2 = 0, missing = 0, players_kept = 0, still_cuts = 0, rewrapped = 0, errors = 0,
	tips = 0, tip_wraps = 0, prizes = 0, prize_asks = 0, rep_lines = 0 }

local function log(fmt, ...) P.log(TAG, fmt, ...) end
local function report(what, err)
	stats.errors = stats.errors + 1
	P.report(TAG, what, err)
end

local function session() return P ~= nil and P.active() end
-- The process whose world holds the arena: the host, or the map server of the Bar (what a player asks goes to the one
-- that leads his level).
local function authority() return P.is_host() end

-------------------------------------------------------------------------------
-- The fight and its fighter (authority)
-------------------------------------------------------------------------------
local function fight_running()
	for n = 1, FIGHTS do
		if has_alife_info("bar_arena_fight_" .. n) and not has_alife_info("bar_arena_fight_" .. n .. "_done") then return n end
	end
	return nil
end

local function id_of(o)
	local ok, id = pcall(o.id, o)
	return ok and id or nil
end

local go -- to the player whose character is `id` (below)

local function own_id() return db.actor and id_of(db.actor) or nil end

local function obj_of(id)
	if id == nil then return nil end
	if id == own_id() then return db.actor end
	return level.object_by_id(id)
end

local function manager()
	local id = get_story_object_id and get_story_object_id(MANAGER)
	return id and level.object_by_id(id) or nil
end

-- The player who talked to the arena manager last; with no talk to go by (an exe without it, two at once), the nearest.
-- `among` ({ [id] = true }, optional): only these players, when any of them is here.
local function pick(near, among)
	local list = P.everyone()
	if among then
		local only = {}
		for _, o in ipairs(list) do
			if among[id_of(o)] then only[#only + 1] = o end
		end
		if #only > 0 then list = only end
	end
	if #list == 0 then return nil end
	local man = manager()
	local api = rawget(_G, "coop")
	local recent = man and api and api.talk_recent
	if recent then
		local man_id = id_of(man)
		for _, ms in ipairs(TALK_WINDOWS) do
			local found, n = nil, 0
			for _, o in ipairs(list) do
				local peer = P.peer_of(o)
				local ok, r = pcall(recent, peer, man_id, ms)
				if peer ~= nil and ok and r == true then found, n = o, n + 1 end
			end
			if n == 1 then return found end
			if n > 1 then break end
		end
	end
	local pos = man and man:position() or (near and near:position())
	if not pos then return list[1] end
	local best, bd = nil, math.huge
	for _, o in ipairs(list) do
		local d = o:position():distance_to_sqr(pos)
		if d < bd then best, bd = o, d end
	end
	return best
end

-- The running fight's record; a fight that starts gets its fighter now.
-- The running fight's fighters, the taker first ({ taker } while the group gathers).
local function fighters()
	if not fight then return {} end
	return fight.ids or { fight.id }
end

local function is_fighter(id)
	if id == nil then return false end
	for _, f in ipairs(fighters()) do
		if f == id then return true end
	end
	return false
end

-- The players on the Bar (ids): `at` those within GATHER_RADIUS of Arnie, the taker first (he took it: he is in), `all` everybody.
local function gathered(taker)
	local man = manager()
	local mp = man and man:position()
	local at, all = { taker }, {}
	for _, o in ipairs(P.everyone()) do
		local id = id_of(o)
		if id ~= nil then
			all[#all + 1] = id
			if id ~= taker and mp and o:position():distance_to_sqr(mp) <= GATHER_RADIUS * GATHER_RADIUS then at[#at + 1] = id end
		end
	end
	local taker_here = false
	for _, id in ipairs(all) do if id == taker then taker_here = true end end
	if not taker_here then all[#all + 1] = taker end
	return at, all
end

local gather_tick -- the group gathers (below)

local function current(near)
	local n = fight_running()
	if n and not (fight and fight.n == n) then
		local o = pick(near)
		if not o then return fight end
		fight = { id = id_of(o), n = n }
		cut_done = false
		local at, all = gathered(fight.id)
		if #all <= 1 or #at >= #all then
			fight.ids = at -- nobody else on the Bar, or everybody at Arnie: at once, as stock
		else
			fight.hold, fight.modes = true, {}
		end
		fighters_of[n] = fight.ids or { fight.id }
		log("fight %d: taken by %s (peer %s), %s", n, tostring(o:name()), tostring(P.peer_of(o)),
			fight.hold and string.format("the group gathers (%d of %d at Arnie)", #at, #all) or (#at .. " fighter(s)"))
		if fight.hold then gather_tick() end
	end
	return fight
end

function fight_over()
	if fight and fight.modes then
		for id in pairs(fight.modes) do go(id, "gather", "off") end
	end
	fight, cut_done = nil, false
end

local function is_trigger(obj)
	if not obj then return false end
	local ok, name = pcall(obj.name, obj)
	if ok and name == TRIGGER then return true end
	local id = id_of(obj)
	local st = id and db.storage[id]
	if not (st and st.ini) then return false end
	local okx, has = pcall(st.ini.section_exist, st.ini, "sr_cutscene@fight_1")
	return okx and has == true
end

-- coop_npc_logic: the trigger's actor effects are the fighter's.
local function audience_rule(npc)
	if not (session() and authority() and is_trigger(npc)) then return nil end
	local f = current(npc)
	if not f then return nil end
	local set = {}
	if f.hold then return set end -- the group gathers: nobody's UI goes (the taker presses and walks)
	for _, id in ipairs(fighters()) do set[id] = true end
	return set
end

-------------------------------------------------------------------------------
-- The gear (authority)
-------------------------------------------------------------------------------
local function parent_id(item)
	local ok, p = pcall(item.parent, item)
	return ok and p and id_of(p) or nil
end

local function items_of(o)
	local list = {}
	o:inventory_for_each(function(item) list[#list + 1] = item end)
	return list
end

-- His whole inventory into box 1, the ids into his ledger. -> the ids moved now ("1,2,3"), nil: there is no box here, he
-- keeps his gear.
local function stow(o, kind)
	local box = get_story_object(BOX_IN)
	if not box then
		log("! %s is not here: %s keeps his gear", BOX_IN, tostring(o:name()))
		return nil
	end
	local id = id_of(o)
	local rec = ledger[id] or { items = {}, kit = {} }
	rec.kind, rec.at = kind, time_global()
	local moved = {}
	for _, item in ipairs(items_of(o)) do
		o:transfer_item(item, box)
		moved[#moved + 1] = id_of(item)
		rec.items[#rec.items + 1] = moved[#moved]
		stats.stowed = stats.stowed + 1
	end
	ledger[id] = rec
	return table.concat(moved, ",")
end

-- The arena's leftovers go, unless another player's fight runs there now (its opponents are in the zone too).
local function purge(for_id)
	if fight and not is_fighter(for_id) and fight_running() then return end
	local xz = C().mod("xr_zones")
	if xz and xz.purge_arena_items then
		local ok, err = pcall(xz.purge_arena_items, ZONE)
		if not ok then report("purge", err) end
	end
end

-- Stands in the arena zone; nil: the zone is not known here.
local function in_arena(o)
	local z = arena_zone and arena_zone.object
	if not z then return nil end
	local ok, r = pcall(z.inside, z, o:position())
	return ok and r == true
end

-- What the arena gave him into box 2, the purge, his ledger back to him. `all`: the fight or the bet just ended, or he stands in
-- the arena: everything he holds is the arena's (stock); else (after a respawn elsewhere, a rejoin, a late answer) only the kit
-- his own machine made for him: what he found since stays his. Nothing of his is moved without a ledger: a player whose gear
-- never went in keeps what he has. False: he is not in this world now.
local function give_back(id, all)
	local o = obj_of(id)
	if not o then return false end
	local rec = ledger[id]
	if not rec then return true end
	local box = get_story_object(BOX_IN)
	if not box then return false end -- box 1 is not online here: his ledger waits
	if not all and in_arena(o) then all = true end
	local kit = {}
	for _, k in ipairs(rec.kit or {}) do kit[k] = true end
	local box2 = get_story_object(BOX_OUT)
	if box2 then
		for _, item in ipairs(items_of(o)) do
			if all or kit[id_of(item)] then
				o:transfer_item(item, box2)
				stats.to_box2 = stats.to_box2 + 1
			end
		end
	end
	purge(id)
	local box_id = id_of(box)
	for _, iid in ipairs(rec.items) do
		local item = level.object_by_id(iid)
		local at = item and parent_id(item)
		if item and box_id and at == box_id then
			box:transfer_item(item, o)
			stats.returned = stats.returned + 1
		elseif not (item and at == id) then
			stats.missing = stats.missing + 1
			log("! item %s of %s is not in %s: not given back", tostring(iid), tostring(o:name()), BOX_IN)
		end
	end
	ledger[id] = nil
	return true
end

-------------------------------------------------------------------------------
-- The player's own machine
-------------------------------------------------------------------------------
local function set_mine(v)
	mine = v
	local em = C().mod("coop_economy_mdata")
	if em and em.send_player_keys then em.send_player_keys() end
end

-- The current chain (our wrapper outermost) for this machine's own player: both story boxes hidden, the purge left out.
-- -> ok, the ids of what it made (the kit, a mod's magazines, the binoculars of a bet)
local function run_local(tbl, key, ...)
	local f = tbl and tbl[key]
	if type(f) ~= "function" then return false, {} end
	local made, seen = {}, {}
	local function catch(g)
		if type(g) ~= "function" then return g end
		return function(...)
			local se = g(...)
			local ok, id = pcall(function() return se and se.id end)
			if ok and type(id) == "number" and not seen[id] then
				seen[id] = true
				made[#made + 1] = P.to_host(id)
			end
			return se
		end
	end
	local ac, aci = _G.alife_create, _G.alife_create_item
	local w_ac, w_aci = catch(ac), catch(aci)
	_G.alife_create, _G.alife_create_item = w_ac, w_aci
	local gso = _G.get_story_object
	local function hidden(sid, ...)
		if sid == BOX_IN or sid == BOX_OUT then return nil end
		if type(gso) == "function" then return gso(sid, ...) end
		return nil
	end
	local xz = C().mod("xr_zones")
	local purge_f = xz and xz.purge_arena_items
	_G.get_story_object = hidden
	if purge_f then xz.purge_arena_items = function() end end
	passing = true
	local ok, err = pcall(f, ...)
	passing = false
	if _G.get_story_object == hidden then _G.get_story_object = gso end
	if _G.alife_create == w_ac then _G.alife_create = ac end
	if _G.alife_create_item == w_aci then _G.alife_create_item = aci end
	if purge_f and xz.purge_arena_items ~= purge_f then xz.purge_arena_items = purge_f end
	if not ok then report("stock " .. key, err) end
	return ok, made
end

-- The authority learns what the arena gave this player (the kit goes back to box 2 even when he comes out elsewhere).
local add_kit -- defined with the authority's functions below

local function report_kit(made)
	if #made == 0 then return end
	if authority() and not P.is_map_server() then return add_kit(own_id(), made) end
	P.send("arena.kit", { i = table.concat(made, ",") }, 0)
end

local function bet_teleport()
	if not db.actor or level.name() ~= ARENA_LEVEL then return end
	level.add_pp_effector("fade_in.ppe", 200, false)
	db.actor:set_actor_position(vector():set(BET_POS[1], BET_POS[2], BET_POS[3]), BET_LV, BET_GV)
end

-- The way in waits until the gear the authority moved has left this machine's inventory (its moves come by another road than
-- arena.go): a mod's follow-up (GAMMA's magazines equip "the" outfit a frame later, Powered Exos charge "the" exo) must see
-- the kit alone, as in single player.
local waiting_in = nil -- { ids = { id, ... }, since = time }

local function still_mine(ids)
	local me = own_id()
	for _, id in ipairs(ids) do
		local item = level.object_by_id(P.to_local(id))
		if item and parent_id(item) == me then return true end
	end
	return false
end

local function way_in()
	waiting_in = nil
	local _, made = run_local(C().mod("xr_effects"), "bar_arena_teleport", db.actor, nil)
	report_kit(made)
end

local function wait_tick()
	if not waiting_in then return end
	if not still_mine(waiting_in.ids) then return way_in() end
	if time_global() - waiting_in.since >= IN_WAIT_MS then
		log("! the way in after %d ms: %d moved item(s) still here", IN_WAIT_MS, #waiting_in.ids)
		way_in()
	end
end

local function id_list(s)
	local ids = {}
	for v in tostring(s or ""):gmatch("%d+") do ids[#ids + 1] = tonumber(v) end
	return ids
end

local PLAY = {
	["in"] = function(a, t)
		fighting = true
		spot_k = tonumber(t and t.k) or 0
		set_mine("fight")
		waiting_in = { ids = id_list(a), since = time_global() }
		wait_tick()
	end,
	out = function()
		fighting, waiting_in, spot_k = false, nil, 0
		set_mine(false)
		-- the way out reads the arena's paths: on another map he only has his gear back
		if level.name() == ARENA_LEVEL then run_local(C().mod("xr_effects"), "bar_arena_teleport_2", db.actor, nil) end
	end,
	slot = function(a) run_local(C().mod("xr_effects"), "bar_arena_weapon_slot", db.actor, nil, { a }) end,
	bet_in = function(a)
		set_mine("bet")
		local _, made = run_local(C().mod("dialogs_mlr"), "teleport_for_totaliz", db.actor, nil)
		report_kit(made)
		if tostring(a) ~= "0" then bet_teleport() end
	end,
	bet_out = function()
		set_mine(false)
		if level.name() == ARENA_LEVEL then run_local(C().mod("xr_effects"), "teleport_for_totaliz_out", db.actor, nil) end
	end,
	none = function()
		fighting, waiting_in, spot_k = false, nil, 0
		set_mine(false)
	end,
	-- a line of the monster fight (a = its string id): on this screen, with the stock sender (sound, icon, PDA)
	tip = function(a, t)
		if type(a) ~= "string" or a:sub(1, 10) ~= "bar_arena_" then return end
		local nm = C().mod("news_manager")
		local send = nm and C().fn(nm, "send_tip")
		if not send then return end
		t = t or {}
		send(db.actor, a, tonumber(t.to), type(t.s) == "string" and t.s or nil, tonumber(t.st),
			type(t.sid) == "string" and t.sid or nil)
	end,
	-- a won fight's battle counts here (stock: game_statistics.increment_statistic in the prize's dialog)
	stat = function(a)
		if a ~= "arena_battles" then return end
		local gs = C().mod("game_statistics")
		local f = gs and C().fn(gs, "increment_statistic")
		if f then f(a) end
	end,
}

-- `t`: the whole message (what a play needs besides `a`).
local function play(what, a, t)
	local f = PLAY[what]
	if not (f and db.actor) then return end
	local ok, err = pcall(f, a, t)
	if not ok then report("play " .. tostring(what), err) end
end

-- To the player whose character is `id` here: his own machine plays it. `more`: fields besides f and a.
go = function(id, what, a, more)
	if id == own_id() and not P.is_map_server() then return play(what, a, more) end
	local peer = P.peer_of(id)
	if peer == nil then
		log("! %s for character %s: he is not in the session", what, tostring(id))
		return
	end
	local t = { f = what, a = a }
	for k, v in pairs(more or {}) do t[k] = v end
	P.send("arena.go", t, peer)
end

-- The authority: this player's gear back, and his way out (after a respawn, a rejoin, a lost answer: not the fight's end).
local function out_of(id)
	local rec = ledger[id]
	if fight and is_fighter(id) then
		local left = {}
		for _, f in ipairs(fighters()) do if f ~= id then left[#left + 1] = f end end
		if #left == 0 then
			fight_over()
		else
			fight.ids, fight.id = left, left[1] -- the others fight on
			log("fight %d: character %s is out, %d fighter(s) left", fight.n, tostring(id), #left)
		end
	end
	if not rec then return go(id, "none") end
	local what = rec.kind == "bet" and "bet_out" or "out"
	if give_back(id) then go(id, what) end
end

add_kit = function(id, made)
	local rec = ledger[id]
	if not (rec and type(made) == "table") then return end
	rec.kit = rec.kit or {}
	for _, k in ipairs(made) do rec.kit[#rec.kit + 1] = k end
end

-- The authority, every tick: a ledger whose player stands here and has nothing of his running (his fight, a totalizator
-- battle) is given back even when his own ask never came (sent before his game was live, lost with a crash).
local function heal_tick(now)
	if level.name() ~= ARENA_LEVEL then return end
	for id, rec in pairs(ledger) do
		if now - (rec.at or 0) >= HEAL_GRACE_MS then
			local busy = (rec.kind == "fight" and is_fighter(id))
				or (rec.kind == "bet" and has_alife_info("begin_the_battle"))
			if not busy and obj_of(id) and P.standing(id) then
				log("the gear of character %s waited: given back", tostring(id))
				return out_of(id) -- one a tick: out_of changes the ledger
			end
		end
	end
end

-- This player: his gear waits in the box and no fight holds him.
local function ask_out()
	if not (mine and session() and db.actor and level.name() == ARENA_LEVEL) then return end
	if authority() and not P.is_map_server() then return out_of(own_id()) end
	P.send("arena.out", {}, 0)
end

-------------------------------------------------------------------------------
-- The stock functions
-------------------------------------------------------------------------------
-- The trigger's way in (sr_idle@wait_N): the authority.
local function route_in(_, npc)
	if not authority() then return end
	local f = current(npc)
	if f and f.hold then -- the trigger went on by another road: the taker alone
		gather_tick(true)
	end
	local any = false
	for k, id in ipairs(fighters()) do
		local o = obj_of(id)
		if o then
			any = true
			go(id, "in", stow(o, "fight") or "", { k = k - 1 })
		end
	end
	if not any then log("! fight %s starts with no fighter here", tostring(fight_running())) end
end

-- The trigger's weapon slot (sr_idle@fight): the fighter's.
local function route_slot(_, _, p)
	if not (authority() and fight) then return end
	for _, id in ipairs(fighters()) do go(id, "slot", type(p) == "table" and p[1] or nil) end
end

-- The commentator's way out (a won fight): the fighter's. With no record of the fight (it was lost: a world whose record did not
-- come back), every fighter of the ledger who is here.
local function route_out()
	if not authority() then return end
	local ids = {}
	if fight then
		ids = fighters()
	else
		for id, rec in pairs(ledger) do
			if rec.kind == "fight" then ids[#ids + 1] = id end
		end
	end
	fight_over()
	for _, id in ipairs(ids) do
		if give_back(id, true) then go(id, "out") end
	end
end

-- A bet takes the gear of a player whose gear is in no box already and who fights no fight.
local function bet_of(id, o)
	if ledger[id] or is_fighter(id) then
		log("! a bet of character %s refused: his gear is in the box already", tostring(id))
		return
	end
	go(id, "bet_in", stow(o, "bet") and 1 or 0)
end

-- The bet (a dialog action on the bettor's machine).
local function route_bet()
	if P.is_client() then
		P.send("arena.bet", {}, 0)
		return
	end
	local id = own_id()
	if id ~= nil then bet_of(id, db.actor) end
end

-- The totalizator's end (its restrictor): every bettor who is here.
local function route_bet_out()
	if not authority() then return end
	local ids = {}
	for id, rec in pairs(ledger) do
		if rec.kind == "bet" and obj_of(id) then ids[#ids + 1] = id end
	end
	if #ids == 0 then purge() end -- stock: the arena's leftovers go
	for _, id in ipairs(ids) do
		if give_back(id, true) then go(id, "bet_out") end
	end
end

-------------------------------------------------------------------------------
-- Arnie's monster fight: its lines are the fighter's (authority)
-------------------------------------------------------------------------------
-- The old arena (dialog bar_arena_manager_game gives bar_arena_start; restrictor bar_arena_sr lets the fighter in through the
-- zone bar_arena_waiter, bar_arena_spam counts the time) shows its lines with news_manager.send_tip from these effects
-- (xr_effects.script:5888-5975), run by the host's restrictors. The infos they give (bar_arena_actor_lose, _victory,
-- bar_arena_start_introduce) are the world's: the stock call runs here, only its lines go to the fighter (arena.go "tip").
-- The host's own fight shows them here, and coop_core_world keeps "bar_arena_*" lines off the others (PERSONAL_IDS).
local TIPS = { "bar_arena_introduce", "bar_arena_fight_begin", "bar_arena_check_lose", "bar_arena_after_fight",
	"bar_arena_actor_afraid", "bar_arena_actor_dead" }
for n = 10, 90, 10 do TIPS[#TIPS + 1] = "bar_arena_fight_" .. n end
-- These end a fight: its fighter is forgotten after them.
local TIP_ENDS = { bar_arena_after_fight = true, bar_arena_actor_dead = true, bar_arena_actor_afraid = true }

local function plain(v)
	local tv = type(v)
	return (tv == "string" or tv == "number" or tv == "boolean") and v or nil
end

-- The players a restrictor's condlist is for (coop_npc_logic), nil: it names none.
local function logic_audience(npc)
	local L = C().mod("coop_npc_logic")
	local f = L and C().fn(L, "audience_of")
	if not (f and npc) then return nil end
	local ok, aud = pcall(f, npc)
	return ok and type(aud) == "table" and next(aud) ~= nil and aud or nil
end

-- The players standing in the arena zone, nil: none, or the zone is not known here.
local function in_arena_set()
	local set = nil
	for _, o in ipairs(P.everyone()) do
		if in_arena(o) then
			set = set or {}
			set[id_of(o)] = true
		end
	end
	return set
end

-- Whose line it is: the fighter of a running fight (bar_arena_fight_N), else the monster fight's. That one is picked when he
-- walks in (bar_arena_introduce: among the players who walked in), else when a line finds none (a load in the middle: among the
-- players in the arena). "You are afraid" ends a fight nobody walked into: the one who talked to Arnie last.
local function tip_fighter(name, npc)
	if fight_running() then
		local f = current(npc)
		if f then return f.id end
	end
	if name == "bar_arena_introduce" or name == "bar_arena_actor_afraid" or not pit then
		local among = nil
		if name == "bar_arena_introduce" then
			among = logic_audience(npc)
		elseif name ~= "bar_arena_actor_afraid" then
			among = in_arena_set()
		end
		local o = pick(npc, among)
		pit = o and { id = id_of(o) } or nil
		if o then log("monster fight: the fighter is %s (peer %s)", tostring(o:name()), tostring(P.peer_of(o))) end
	end
	return pit and pit.id or nil
end

-- The stock call with its arena lines going to the player whose character is `id` (his own machine shows them); any other
-- line goes on as it would.
local function lines_to(id, cur, ...)
	local nm = C().mod("news_manager")
	local send = nm and C().fn(nm, "send_tip")
	if not send then return cur(...) end
	local function catch(actor, news_id, timeout, sender, showtime, sender_id, ...)
		if type(news_id) ~= "string" or news_id:sub(1, 10) ~= "bar_arena_" then
			return send(actor, news_id, timeout, sender, showtime, sender_id, ...)
		end
		go(id, "tip", news_id, { to = plain(timeout), s = type(sender) == "string" and sender or nil, st = plain(showtime),
			sid = plain(sender_id) })
		stats.tips = stats.tips + 1
		return true
	end
	nm.send_tip = catch
	local ok, r = pcall(cur, ...)
	if nm.send_tip == catch then nm.send_tip = send end
	if not ok then error(r, 0) end
	return r
end

local function route_tip(name, cur, actor, npc, ...)
	if not authority() then return cur(actor, npc, ...) end
	local id = tip_fighter(name, npc)
	local r
	if id == nil or (id == own_id() and not P.is_map_server()) then
		r = cur(actor, npc, ...)
	else
		r = lines_to(id, cur, actor, npc, ...)
	end
	if name == "bar_arena_after_fight" and id ~= nil and has_alife_info("bar_arena_actor_victory") then pit_won = id end
	if TIP_ENDS[name] then pit = nil end
	return r
end

-- Our wrappers outermost, as ensure_outer does for the gear.
local function ensure_tips()
	local xe = C().mod("xr_effects")
	if not xe then return end
	for _, name in ipairs(TIPS) do
		local cur = C().fn(xe, name)
		if cur and not OURS[cur] then
			local w = function(...)
				if passing or not session() then return cur(...) end
				return route_tip(name, cur, ...)
			end
			OURS[w] = true
			xe[name] = w
			stats.tip_wraps = stats.tip_wraps + 1
		end
	end
end

local ROUTES = {
	{ "xr_effects", "bar_arena_teleport", route_in },
	{ "xr_effects", "bar_arena_teleport_2", route_out },
	{ "xr_effects", "bar_arena_weapon_slot", route_slot },
	{ "xr_effects", "teleport_for_totaliz_out", route_bet_out },
	{ "dialogs_mlr", "teleport_for_totaliz", route_bet },
}

-------------------------------------------------------------------------------
-- Arnie's monster fight: its fighter's death (authority)
-------------------------------------------------------------------------------
-- bar_arena_sr in sr_idle@fight: on_info2 = {=actor_dead} sr_idle@nil %=bar_arena_actor_dead +bar_arena_actor_dead
-- +bar_arena_start_introduce%. xr_conditions.actor_dead reads db.actor, the host's own character, and in a session nobody dies
-- for the engine (a fallen player stays alive at 1 % health, coop_survival): no fighter's death ever ended the fight, and the
-- branch would end in sr_idle@nil for good (single player reloads after a death). Asked by bar_arena_sr in a session: dead =
-- no player alive or down has stood in the zone bar_arena_sr (where the fight starts, on_actor_in_zone) for PIT_GONE_MS: a
-- death, leaving the session, a respawn elsewhere (a teleport or a load is shorter). The host falling anywhere else is nobody's
-- business. The player seen there is the fight's (its lines are his, after a load too). After the branch the arena is back at
-- its start: the monster released, bar_old_arena_reset given and the fight's infos taken off (PIT_INFOS), bar_arena_sr at
-- sr_idle@idle and bar_arena_spam's logic at sr_idle@introduce (it waits in sr_idle@notiming for a monster's death that will
-- not come). A world saved with the arena stuck that way (before this) is put back the same way.
local PIT_ZONE = "bar_arena_sr"
local PIT_GONE_MS = 5000
local PIT_MONSTERS = { "pseudodog", "snork", "bloodsucker", "burer", "savage" }
-- The infos of a fight, as info_portions.script's bar_old_arena_reset lists them (dialogs_bar.arena_give_reward takes them off
-- one by one too: "doesn't seem to be working"), with bar_arena_4000_r (a bet stock never takes back) and bar_arena_state_1.
local PIT_INFOS = { "bar_arena_start", "bar_arena_1000_r", "bar_arena_2000_r", "bar_arena_3000_r", "bar_arena_4000_r",
	"bar_arena_5000_r", "bar_arena_20_p", "bar_arena_50_p", "bar_arena_100_p", "bar_arena_start_introduce",
	"bar_arena_spawn_monstr", "bar_arena_monstr_ready", "bar_arena_monstr_dead", "bar_arena_actor_victory", "bar_arena_actor_lose",
	"bar_arena_actor_afraid", "bar_arena_actor_dead", "bar_arena_state_1" }
for n = 10, 90, 10 do PIT_INFOS[#PIT_INFOS + 1] = "bar_arena_fight_" .. n end
for _, m in ipairs(PIT_MONSTERS) do PIT_INFOS[#PIT_INFOS + 1] = "bar_arena_" .. m .. "_choosen" end
-- when a fighter was last seen in the zone; the section's activation it counts for; true: count from the next ask (a load, a reset)
local pit_seen, pit_act, pit_fresh = 0, nil, true

local function has_section(obj, section)
	local id = obj and id_of(obj)
	local st = id and db.storage[id]
	if not (st and st.ini) then return false end
	local ok, has = pcall(st.ini.section_exist, st.ini, section)
	return ok and has == true
end

local function is_pit_logic(npc)
	if not npc then return false end
	local ok, name = pcall(npc.name, npc)
	return (ok and name == PIT_ZONE) or has_section(npc, "sr_idle@wait_actor")
end

-- In the fight: alive or down (a teammate may still lift him). Without the engine's answer: alive.
local function fighting_life(id)
	local api = rawget(_G, "coop")
	if not (api and api.life_of) then return true end
	local ok, l = pcall(api.life_of, id)
	if not (ok and type(l) == "string") then return true end
	return l == "alive" or l == "wounded"
end

local function pit_fighter(zone)
	for _, o in ipairs(P.everyone()) do
		local ok, inside = pcall(zone.inside, zone, o:position())
		if ok and inside and fighting_life(id_of(o)) then return o end
	end
	return nil
end

local function pit_dead(npc)
	local zone = db.zone_by_name and db.zone_by_name[PIT_ZONE] or npc
	local now = time_global()
	local st = db.storage[id_of(npc)]
	local act = st and st.activation_time
	if pit_fresh or act ~= pit_act then pit_seen, pit_act, pit_fresh = now, act, false end -- a new entry into sr_idle@fight
	local o = pit_fighter(zone)
	if o then
		pit_seen = now
		if not pit then pit = { id = id_of(o) } end
		return false
	end
	return now - pit_seen >= PIT_GONE_MS
end

-- The monster fight's logics: bar_arena_sr and the one of bar_arena_spam.ltx (on another restrictor: found by its section).
local function pit_logics()
	local sr, spam = nil, nil
	for name, z in pairs(db.zone_by_name or {}) do
		if name == PIT_ZONE then sr = z elseif has_section(z, "sr_idle@notiming") then spam = z end
	end
	return sr, spam
end

local function pit_reset_tick()
	if not has_alife_info("bar_arena_actor_dead") then return end
	local sr, spam = pit_logics()
	local st = sr and db.storage[id_of(sr)]
	if not (st and st.active_section == "sr_idle@nil") then return end
	for _, m in ipairs(PIT_MONSTERS) do
		local id = get_story_object_id("bar_arena_" .. m)
		if id and alife_object(id) then alife_release_id(id) end
	end
	give_info("bar_old_arena_reset")
	for _, info in ipairs(PIT_INFOS) do disable_info(info) end
	xr_logic.switch_to_section(sr, st.ini, "sr_idle@idle")
	local sp = spam and db.storage[id_of(spam)]
	if sp and sp.ini then xr_logic.switch_to_section(spam, sp.ini, "sr_idle@introduce") end
	pit, pit_fresh = nil, true
	log("monster fight: its fighter died, the arena is back at its start")
end

local function route_dead(cur, actor, npc, ...)
	if session() and authority() and is_pit_logic(npc) then return pit_dead(npc) end
	return cur(actor, npc, ...)
end

local function ensure_pit()
	local xc = C().mod("xr_conditions")
	local cur = xc and C().fn(xc, "actor_dead")
	if cur and not OURS[cur] then
		local w = function(...) return route_dead(cur, ...) end
		OURS[w] = true
		xc.actor_dead = w
		stats.rewrapped = stats.rewrapped + 1
	end
end

-------------------------------------------------------------------------------
-- Group entry: the players gather at Arnie (authority), the button and the invitation (every player's machine)
-------------------------------------------------------------------------------
-- The fight starts: the gathering ends, everyone at Arnie (`ids`, the taker first) fights. The invitations and buttons go,
-- the fighters lose their UI (stock disable_ui of sr_idle@wait_N, which nobody got while the group gathered), and the trigger
-- goes on (its 1 s timer is long over: the cutscene at once).
local function begin(ids, why)
	if not fight then return end
	local modes = fight.modes
	fight.hold, fight.modes, fight.vote = nil, nil, nil
	fight.ids, fight.id = ids, ids[1]
	fighters_of[fight.n] = ids
	for id in pairs(modes or {}) do go(id, "gather", "off") end
	if modes then
		for _, id in ipairs(ids) do go(id, "ui_off") end
	end
	log("fight %d: %d fighter(s) go in (%s)", fight.n, #ids, tostring(why))
end

local function nick_of(id)
	local peer = P.peer_of(id)
	local p = peer ~= nil and P.player(peer)
	return p and p.nick or "?"
end

-- The authority, every tick while the group gathers (and when a fight is taken): everybody on the Bar at Arnie starts it, the
-- others are told what they can do (only when that changes). `force`: the taker alone, now.
gather_tick = function(force)
	if not (fight and fight.hold) then return end
	if force then return begin({ fight.id }, "the trigger went on") end
	if not fight_running() then return fight_over() end
	local at, all = gathered(fight.id)
	if #all <= 1 or #at >= #all then return begin(at, #all <= 1 and "nobody else on the Bar" or "everybody at Arnie") end
	local near = {}
	for _, id in ipairs(at) do near[id] = true end
	local by = nick_of(fight.id)
	for _, id in ipairs(all) do
		local mode = near[id] and (#at == 1 and "solo" or "vote") or "invite"
		if fight.modes[id] ~= mode then
			fight.modes[id] = mode
			go(id, "gather", mode, { n = fight.n, w = by, c = #at, t = #all })
		end
	end
end

-- The authority: the button of the player whose character is `id`. Alone at Arnie: he starts; with others: a vote of those at
-- Arnie (coop_economy_group.propose), whose yes starts it with whoever is at Arnie then. Not the host (a map server of the
-- Bar has no vote): it starts.
local function start_ask(id)
	if not (fight and fight.hold) then return end
	local at = gathered(fight.id)
	local here = false
	for _, v in ipairs(at) do
		if v == id then here = true end
	end
	if not here then return end
	if #at == 1 then return begin(at, "alone") end
	if fight.vote then return end
	local voters = {}
	for _, v in ipairs(at) do
		local peer = v ~= id and P.peer_of(v)
		if peer ~= nil and peer ~= false then voters[peer] = true end
	end
	local eg = C().mod("coop_economy_group")
	local propose = eg and C().fn(eg, "propose")
	local n = fight.n
	fight.vote = true
	local asked = propose and propose("arena", P.peer_of(id), voters, function(ok)
		if not (fight and fight.n == n and fight.hold) then return end
		fight.vote = nil
		if ok then begin((gathered(fight.id)), "the vote") end
	end, tostring(n))
	if not asked then
		fight.vote = nil
		begin(at, "no vote here")
	end
end

-- This player's button: to the authority.
local function ask_start()
	if authority() and not P.is_map_server() then return start_ask(own_id()) end
	P.send("arena.start", {}, 0)
end

local function tr(id, fallback)
	local g = rawget(_G, "game")
	if g and g.translate_string then
		local ok, s = pcall(g.translate_string, id)
		if ok and type(s) == "string" and s ~= id then return s end
	end
	return fallback
end

local function fmt(id, fallback, ...)
	local ok, s = pcall(string.format, tr(id, fallback), ...)
	return ok and s or fallback
end

local function close_box()
	local b = gather_box
	gather_box = nil
	if b then pcall(function() b.message_box:HideDialog() end) end
end

local function drop_invite()
	if invite_spot and level.map_remove_object_spot then pcall(level.map_remove_object_spot, invite_spot, SPOT_TYPE) end
	invite_spot = nil
end

-- What the authority says to this player while the group gathers.
PLAY.gather = function(a, t)
	t = t or {}
	close_box()
	if a ~= "invite" then drop_invite() end
	local n = tostring(t.n or "?")
	if a == "invite" then
		local man_id = get_story_object_id and get_story_object_id(MANAGER)
		if man_id and not invite_spot and level.map_add_object_spot then
			if pcall(level.map_add_object_spot, man_id, SPOT_TYPE, tr("st_coop_arena_spot", "Arnie: the arena fight")) then invite_spot = man_id end
		end
		local nm = C().mod("news_manager")
		local send = nm and C().fn(nm, "send_tip")
		local text = fmt("st_coop_arena_invite", "%s invites you to the arena: fight %s. Come to Arnie.", tostring(t.w or "?"), n)
		if send then pcall(send, db.actor, text, nil, "arena", 10000) end
		return
	end
	if a ~= "solo" and a ~= "vote" then return end
	local text = a == "solo"
		and fmt("st_coop_arena_solo", "Arena fight %s: the others on the Bar are invited. Start alone?", n)
		or fmt("st_coop_arena_without", "Arena fight %s: %s of %s players at Arnie. Start without the others?", n, tostring(t.c or "?"),
			tostring(t.t or "?"))
	local box = C().mod("ui_dyn_msg_box")
	local f = box and C().fn(box, "msg_box_ui")
	if not f then return end
	local ok, b = pcall(f, "message_box_yes_no", true, text, function()
		gather_box = nil
		ask_start()
	end, function() gather_box = nil end)
	if ok then gather_box = b end
end

-- The group's start: this player's UI off, as the trigger's sr_idle@wait_N does in stock.
PLAY.ui_off = function()
	local xe = C().mod("xr_effects")
	local f = xe and C().fn(xe, "disable_ui")
	if f then f(db.actor, nil) end
end

-- This player's spot in the pit: the cutscene's point, the others sideways from it (1, -1, 2, -2 ... steps).
local function own_spot()
	if spot_k <= 0 or not db.actor then return end
	local pos = db.actor:position()
	local side = (spot_k % 2 == 1) and 1 or -1
	local step = math.ceil(spot_k / 2) * SPOT_STEP * side
	db.actor:set_actor_position(vector():set(pos.x + step, pos.y, pos.z))
end

-- The trigger's sr_idle@wait_N holds while the group gathers: its on_timer 1000 is not looked at.
local function patch_idle()
	local si = C().mod("sr_idle")
	local cls = si and si.action_idle
	local upd = cls and cls.update
	if type(upd) ~= "function" or OURS[upd] then return end
	local w = function(self, ...)
		if fight and fight.hold and session() and authority() and self and is_trigger(self.object) then return end
		return upd(self, ...)
	end
	OURS[w] = true
	cls.update = w
end

-- The vote's lines (coop_economy_group: its box, on every machine).
local function vote_lines()
	local eg = C().mod("coop_economy_group")
	local f = eg and C().fn(eg, "subject")
	if not f then return end
	f("arena", {
		ask = { "st_coop_arena_vote_ask", "%s wants to start arena fight %s without the others. Agree?" },
		no = { "st_coop_arena_vote_no", "%s does not want to start the arena fight yet." },
		timeout = { "st_coop_arena_vote_timeout", "The arena fight waits: no answer from %s." },
		left = { "st_coop_arena_vote_left", "The arena vote was cancelled (%s left)." },
	})
end

-------------------------------------------------------------------------------
-- The rank gate after fights 3 and 6 (authority)
-------------------------------------------------------------------------------
-- Stock: restrictor bar_arena_rank_checker gives bar_arena_rank_false (Arnie offers no next fight) with
-- {!bar_actor_rank_stalker ... +bar_arena_fight_3_done} and {!bar_actor_rank_veteran ... +bar_arena_fight_6_done};
-- xr_conditions.bar_actor_rank_stalker / _veteran read db.actor, the host's character (> 1499, > 2999). In a session they read
-- the player who takes the fight: the one who talks to Arnie now (coop.talk_holder), else the one nearest to him.
local RANKS = { bar_actor_rank_stalker = 1499, bar_actor_rank_veteran = 2999 }

local function rank_player()
	local man = manager()
	local api = rawget(_G, "coop")
	if man and api and type(api.talk_holder) == "function" then
		local ok, peer = pcall(api.talk_holder, id_of(man))
		local o = ok and type(peer) == "number" and P.object_of_peer(peer)
		if o then return o end
	end
	local mp = man and man:position()
	if not mp then return nil end
	local best, bd = nil, math.huge
	for _, o in ipairs(P.everyone()) do
		local d = o:position():distance_to_sqr(mp)
		if d < bd then best, bd = o, d end
	end
	return best
end

local function route_rank(cur, need, actor, npc, ...)
	if not (session() and authority()) then return cur(actor, npc, ...) end
	local o = rank_player()
	if not o or id_of(o) == own_id() and not P.is_map_server() then return cur(actor, npc, ...) end -- the host himself: stock
	local ok, r = pcall(o.character_rank, o)
	if not (ok and tonumber(r)) then return cur(actor, npc, ...) end
	return tonumber(r) > need
end

local function ensure_rank()
	local xc = C().mod("xr_conditions")
	if not xc then return end
	for name, need in pairs(RANKS) do
		local cur = C().fn(xc, name)
		if cur and not OURS[cur] then
			local w = function(...) return route_rank(cur, need, ...) end
			OURS[w] = true
			xc[name] = w
			stats.rewrapped = stats.rewrapped + 1
		end
	end
end

-------------------------------------------------------------------------------
-- Arnie's prizes (authority) and the reputation of a fight (every player's machine)
-------------------------------------------------------------------------------
-- The prize of fight n (bar_arena_fight_n_reward, given by the trigger after a win) is collected in a dialog with Arnie on the
-- machine of whoever talks: stock pays the talker (dialogs.relocate_money_to_actor), counts his arena battle and takes off
-- bar_arena_fight and bar_arena_fight_begin. Here the talker's machine asks the authority (arena.prize), which runs the stock
-- call (a mod's version with it) with the money and the battle going to the fight's fighters; a fight that runs meanwhile
-- keeps its two infos (they spare its fighters' reputation, game_statistics.increment_reputation, on their own machines).
local PRIZES = { new = "new_arena_give_reward", old = "arena_give_reward" }
local prize_cur = {} -- kind -> the function our wrapper wraps (the stock call, a mod's version)

local function share_mode()
	local ok, v = pcall(function() return get_console():get_integer("coop_share_rewards") end)
	return ok and tonumber(v) or 0
end

-- { { id, amount }, ... }: n RU of a prize won by `fighters`, collected by `taker` (coop_share_rewards, coop_reward_group):
-- 0 to the one who collects it if he fought, else to the first fighter; 1 and 2 split among the fighters, the remainder to
-- that one; 3 to each in full.
local function prize_plan(n, fighters, taker)
	local main = fighters[1]
	for _, id in ipairs(fighters) do
		if id == taker then main = id end
	end
	local mode = share_mode()
	if #fighters <= 1 or mode == 0 then return { { main, n } } end
	local plan = {}
	if mode == 3 then
		for _, id in ipairs(fighters) do plan[#plan + 1] = { id, n } end
		return plan
	end
	local part = math.floor(n / #fighters)
	local rest = n - part * #fighters
	for _, id in ipairs(fighters) do
		local m = part + (id == main and rest or 0)
		if m > 0 then plan[#plan + 1] = { id, m } end
	end
	return plan
end

-- n RU for the player whose character is `id`: this machine's own player the stock way (`reloc`: the money line too), a client
-- through the host ledger (coop.money_grant) with his money line (coop_tasks.money_line).
local function pay(id, n, reloc, first, second)
	if not (n and n > 0) then return end
	if id == own_id() and not P.is_map_server() then return reloc(first, second, n) end
	local peer = P.peer_of(id)
	local api = rawget(_G, "coop")
	local grant = api and api.money_grant
	if peer == nil or type(grant) ~= "function" then
		log("! a prize of %d RU for character %s: %s", n, tostring(id), peer == nil and "he is not in the session" or "no coop.money_grant")
		return
	end
	local ok, granted = pcall(grant, peer, math.floor(n))
	if not (ok and granted) then
		log("! a prize of %d RU for peer %s refused: %s", n, tostring(peer), tostring(granted))
		return
	end
	local tasks = C().mod("coop_tasks")
	local line = tasks and C().fn(tasks, "money_line")
	if line then pcall(line, peer, math.floor(n)) end
end

-- The prize of the first waiting fight (stock picks it the same way), nil: none.
local function waiting_prize()
	for n = 1, FIGHTS do
		if has_alife_info("bar_arena_fight_" .. n .. "_reward") then return n end
	end
	return nil
end

-- The authority: the stock call of the prize `kind`, collected by the player whose character is `taker`.
local function prize(kind, taker, first, second)
	local cur = prize_cur[kind]
	if not cur then return end
	local n = kind == "new" and waiting_prize() or nil
	local fighters = (kind == "new" and n and fighters_of[n]) or (kind == "old" and pit_won and { pit_won }) or nil
	if not (fighters and #fighters > 0) then fighters = { taker } end -- no record (a fight from before): stock, the talker
	local running = fight_running() ~= nil
	local had = { bar_arena_fight = has_alife_info("bar_arena_fight"), bar_arena_fight_begin = has_alife_info("bar_arena_fight_begin") }
	local d, gs = C().mod("dialogs"), C().mod("game_statistics")
	local reloc = d and C().fn(d, "relocate_money_to_actor")
	local count = gs and C().fn(gs, "increment_statistic")
	local function money(f, s, m)
		for _, e in ipairs(prize_plan(tonumber(m) or 0, fighters, taker)) do pay(e[1], e[2], reloc, f, s) end
	end
	local function battle(name, ...)
		if name ~= "arena_battles" then return count(name, ...) end
		for _, id in ipairs(fighters) do
			if id == own_id() and not P.is_map_server() then count(name, ...) else go(id, "stat", name) end
		end
	end
	if reloc then d.relocate_money_to_actor = money end
	if count then gs.increment_statistic = battle end
	paying = true
	local ok, err = pcall(cur, first, second)
	paying = false
	if reloc and d.relocate_money_to_actor == money then d.relocate_money_to_actor = reloc end
	if count and gs.increment_statistic == battle then gs.increment_statistic = count end
	if running then
		for info, on in pairs(had) do
			if on and not has_alife_info(info) then give_info(info) end
		end
	end
	if kind == "new" and n then fighters_of[n] = nil elseif kind == "old" then pit_won = nil end
	stats.prizes = stats.prizes + 1
	log("prize %s%s collected by %s: for %d fighter(s)%s", kind, n and (" of fight " .. n) or "", tostring(taker), #fighters,
		running and ", the running fight keeps bar_arena_fight" or "")
	if not ok then report("prize " .. kind, err) end
end

local function route_prize(kind, cur, first, second, ...)
	if paying or not session() then return cur(first, second, ...) end
	if not authority() or P.is_map_server() then
		stats.prize_asks = stats.prize_asks + 1
		P.send("arena.prize", { k = kind }, 0)
		return
	end
	return prize(kind, own_id(), first, second)
end

local function ensure_prizes()
	local tbl = C().mod("dialogs_bar")
	if not tbl then return end
	for _, kind in ipairs({ "new", "old" }) do
		local cur = C().fn(tbl, PRIZES[kind])
		if cur and not OURS[cur] then
			prize_cur[kind] = cur
			local w = function(...) return route_prize(kind, cur, ...) end
			OURS[w] = true
			tbl[PRIZES[kind]] = w
			stats.rewrapped = stats.rewrapped + 1
		end
	end
end

-- Every player's machine: his own reputation while a fight of the new arena runs or his gear waits for one (one line each
-- change, with its source), so a live run tells where a change came from.
local rep_seen = nil

local function watching() return session() and db.actor ~= nil and (fight_running() ~= nil or mine == "fight") end

local function reputation()
	local ok, v = pcall(db.actor.character_reputation, db.actor)
	return ok and tonumber(v) or nil
end

local function route_rep_line(cur, value, ...)
	if not (watching() and tonumber(value) and tonumber(value) ~= 0) then return cur(value, ...) end
	local before = reputation()
	local r = cur(value, ...)
	local after = reputation()
	stats.rep_lines = stats.rep_lines + 1
	log("reputation in fight %s: game_statistics.increment_reputation(%s), bar_arena_fight %s: %s -> %s", tostring(fight_running()),
		tostring(value), has_alife_info("bar_arena_fight") and "on" or "off", tostring(before), tostring(after))
	rep_seen = after
	return r
end

local function rep_tick()
	if not watching() then
		rep_seen = nil
		return
	end
	local v = reputation()
	if v and rep_seen and v ~= rep_seen then
		stats.rep_lines = stats.rep_lines + 1
		log("reputation in fight %s: %d -> %d (%+d), not game_statistics (the engine: an attack counted by the host, RelReputationDelta)",
			tostring(fight_running()), rep_seen, v, v - rep_seen)
	end
	rep_seen = v
end

local function ensure_rep_line()
	local gs = C().mod("game_statistics")
	local cur = gs and C().fn(gs, "increment_reputation")
	if cur and not OURS[cur] then
		local w = function(...) return route_rep_line(cur, ...) end
		OURS[w] = true
		gs.increment_reputation = w
		stats.rewrapped = stats.rewrapped + 1
	end
end

-- Our wrapper outermost: a mod that wrapped after us is wrapped again. In a session the outermost one routes; under it
-- (passing: this machine's own player) every layer, ours and the mods', runs on.
local function ensure_outer()
	for _, r in ipairs(ROUTES) do
		local tbl = C().mod(r[1])
		local cur = tbl and C().fn(tbl, r[2])
		if cur and not OURS[cur] then
			local route = r[3]
			local w = function(...)
				if passing or not session() then return cur(...) end
				return route(...)
			end
			OURS[w] = true
			tbl[r[2]] = w
			stats.rewrapped = stats.rewrapped + 1
		end
	end
	ensure_tips()
	ensure_pit()
	ensure_prizes()
	ensure_rep_line()
	ensure_rank()
end

-- The cutscene of the trigger plays on the fighter's machine alone.
local function patch_cutscene()
	local sc = C().mod("sr_cutscene")
	local cls = sc and sc.action_cutscene
	if not cls then return end
	local zone_enter, update, callback = cls.zone_enter, cls.update, cls.cutscene_callback
	if type(zone_enter) ~= "function" or OURS[zone_enter] or type(update) ~= "function" or type(callback) ~= "function" then return end
	local function enter(self, ...)
		self.coop_still, self.coop_tell = nil, nil
		if session() and is_trigger(self.object) then
			if authority() then current(self.object) end
			local me = fighting
			if authority() and fight then me = is_fighter(own_id()) and not P.is_map_server() end
			if not me then
				self.state = "run"
				self.coop_still = time_global()
				stats.still_cuts = stats.still_cuts + 1
				return
			end
			self.coop_tell = P.is_client() or nil
			local r = zone_enter(self, ...)
			own_spot()
			return r
		end
		return zone_enter(self, ...)
	end
	local function upd(self, ...)
		if self.coop_still then
			if authority() and (cut_done or time_global() - self.coop_still >= CUT_WAIT_MS) then
				self.st.signals = self.st.signals or {}
				self.st.signals["cameff_end"] = true
			end
			xr_logic.try_switch_to_another_section(self.object, self.st, db.actor)
			return
		end
		return update(self, ...)
	end
	local function cb(self, ...)
		local r = callback(self, ...)
		local sig = self.coop_tell and self.st and self.st.signals
		if sig and sig["cameff_end"] then
			self.coop_tell = nil
			P.send("arena.cut", {}, 0)
		end
		return r
	end
	OURS[enter] = true
	cls.zone_enter, cls.update, cls.cutscene_callback = enter, upd, cb
end

-- The arena zone counts what walks into it, a client's character too (a stalker on the host): a player is never purged. Its
-- binder is kept (net_spawn) to tell who stands in the arena.
local function patch_zone()
	local xz = C().mod("xr_zones")
	local cls = xz and xz.arena_zone_binder
	local f = cls and cls.purge_items
	if type(f) ~= "function" or OURS[f] then return end
	local ns = cls.net_spawn
	if type(ns) == "function" then
		local wn = function(self, ...)
			arena_zone = self
			return ns(self, ...)
		end
		OURS[wn] = true
		cls.net_spawn = wn
	end
	local w = function(self, ...)
		arena_zone = arena_zone or self
		if session() and type(self.saved_obj) == "table" then
			for id in pairs(self.saved_obj) do
				if P.is_player_id(id) then
					self.saved_obj[id] = nil
					stats.players_kept = stats.players_kept + 1
				end
			end
		end
		return f(self, ...)
	end
	OURS[w] = true
	cls.purge_items = w
end

-------------------------------------------------------------------------------
-- Events, saves, ticks
-------------------------------------------------------------------------------
local function avatar_of(from)
	local id = P.avatar_of_peer(from)
	return id ~= nil and obj_of(id) and id or nil
end

local function register_events()
	P.on("arena.go", function(t)
		if type(t.f) == "string" then play(t.f, t.a, t) end
	end, "client", TAG)
	P.on("arena.bet", function(_, from)
		local id = avatar_of(from)
		if id then bet_of(id, obj_of(id)) end
	end, "host", TAG)
	P.on("arena.kit", function(t, from)
		local id = P.avatar_of_peer(from)
		local made = {}
		for v in tostring(t.i or ""):gmatch("%d+") do made[#made + 1] = tonumber(v) end
		if id ~= nil then add_kit(id, made) end
	end, "host", TAG)
	P.on("arena.out", function(_, from)
		local id = P.avatar_of_peer(from)
		if id ~= nil then out_of(id) end
	end, "host", TAG)
	P.on("arena.cut", function(_, from)
		local id = P.avatar_of_peer(from)
		if not (fight and is_fighter(id)) then return end
		fight.cuts = fight.cuts or {}
		fight.cuts[id] = true
		for _, f in ipairs(fighters()) do
			if not fight.cuts[f] and not (f == own_id() and not P.is_map_server()) then return end
		end
		cut_done = true
	end, "host", TAG)
	P.on("arena.start", function(_, from)
		local id = P.avatar_of_peer(from)
		if id ~= nil then start_ask(id) end
	end, "host", TAG)
	P.on("arena.prize", function(t, from)
		local id = avatar_of(from)
		if id and PRIZES[t.k] then prize(t.k, id, db.actor, manager()) end
	end, "host", TAG)
end

local function ledger_list()
	local list = {}
	for id, rec in pairs(ledger) do list[#list + 1] = { id = id, kind = rec.kind, items = rec.items, kit = rec.kit or {} } end
	return list
end

local function numbers(t)
	local out = {}
	if type(t) == "table" then
		for _, v in ipairs(t) do
			if type(v) == "number" then out[#out + 1] = v end
		end
	end
	return out
end

-- Records from a save or from another process; `only_new`: what is here already stays.
local function take_list(list, only_new)
	for _, r in ipairs(type(list) == "table" and list or {}) do
		if type(r) == "table" and type(r.id) == "number" and type(r.items) == "table" and not (only_new and ledger[r.id]) then
			ledger[r.id] = { kind = r.kind == "bet" and "bet" or "fight", items = numbers(r.items), kit = numbers(r.kit), at = time_global() }
		end
	end
end

local function save_state(m_data)
	m_data.coop_arena_gear = (mine == "fight" and true) or mine or nil
	if P.is_client() then return end
	local prizes = {}
	for n, ids in pairs(fighters_of) do prizes[#prizes + 1] = { n = n, ids = ids } end
	local keep = next(ledger) or fight or pit or (world_copy and #world_copy > 0) or #prizes > 0 or pit_won
	local fsave = fight and { id = fight.id, n = fight.n, ids = fight.ids } or nil
	m_data.coop_arena = keep and { ledger = ledger_list(), fight = fsave, split = world_copy, pit = pit, prizes = prizes,
		pit_won = pit_won } or nil
end

local function load_state(m_data)
	local g = m_data.coop_arena_gear
	mine = (g == true and "fight") or (g == "bet" and "bet") or false
	local a = m_data.coop_arena
	ledger, fight, cut_done, world_copy, pit, fighters_of, pit_won = {}, nil, false, nil, nil, {}, nil
	pit_fresh = true
	-- the ledger is the world's: a client loads the host's world, it is not his
	if type(a) ~= "table" or P.is_client() then return end
	take_list(a.ledger)
	if type(a.fight) == "table" and type(a.fight.id) == "number" then
		fight = { id = a.fight.id, n = a.fight.n }
		local ids = numbers(a.fight.ids)
		if #ids > 0 then fight.ids = ids end -- a fight held at load starts with its taker alone
	end
	if type(a.split) == "table" then world_copy = a.split end
	if type(a.pit) == "table" and type(a.pit.id) == "number" then pit = { id = a.pit.id } end
	for _, r in ipairs(type(a.prizes) == "table" and a.prizes or {}) do
		if type(r) == "table" and type(r.n) == "number" then fighters_of[r.n] = numbers(r.ids) end
	end
	if type(a.pit_won) == "number" then pit_won = a.pit_won end
end

-- Split levels: a map server leads the Bar, writes nothing into the save and stops when its level is empty. Its ledger goes up to
-- the world server (kept in its save) and comes down to the next map server of the Bar, which takes the records it has none of.
local function share_ledger()
	local share = C().mod("coop_levels_share")
	if not (share and share.up and share.down) then return end
	share.up("arena_ledger", function()
		if level.name() ~= ARENA_LEVEL or not (got_down or next(ledger)) then return nil end
		return { list = ledger_list(), based = got_down }
	end, function(t)
		if type(t) ~= "table" or type(t.list) ~= "table" then return end
		if t.based then
			world_copy = t.list
			return
		end
		-- a map server that has not heard the world's copy yet: its records join it
		local by, list = {}, {}
		for _, r in ipairs(world_copy or {}) do if type(r) == "table" and r.id then by[r.id] = r end end
		for _, r in ipairs(t.list) do if type(r) == "table" and r.id then by[r.id] = r end end
		for _, r in pairs(by) do list[#list + 1] = r end
		world_copy = list
	end)
	share.down("arena_ledger", function()
		return world_copy and { list = world_copy } or nil
	end, function(t)
		if got_down or level.name() ~= ARENA_LEVEL or type(t) ~= "table" then return end
		got_down = true
		take_list(t.list, true)
	end)
end

local next_tick = 0

local function actor_on_update()
	if waiting_in then wait_tick() end
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + TICK_MS
	ensure_outer()
	rep_tick()
	if fighting and not fight_running() then fighting = false end
	if session() and authority() then
		if fight and fight.hold then
			local okg, errg = pcall(gather_tick)
			if not okg then report("gather", errg) end
		end
		local ok, err = pcall(heal_tick, now)
		if not ok then report("heal", err) end
		ok, err = pcall(pit_reset_tick)
		if not ok then report("monster fight reset", err) end
	end
end

-- A rejoin, or a walk back to the Bar: the fight ended without him, nothing else gives his gear back.
local function actor_on_first_update()
	ensure_outer()
	if not fight_running() then ask_out() end
end

function print_status()
	local n = 0
	for _ in pairs(ledger) do n = n + 1 end
	return string.format("ledger %d, fight %s, stowed %d, returned %d, to box 2 %d, missing %d, players kept %d, still cutscenes %d, rewrapped %d, lines to a fighter %d, prizes %d (asked %d), reputation lines %d, errors %d",
		n, fight and tostring(fight.n) or "-", stats.stowed, stats.returned, stats.to_box2, stats.missing, stats.players_kept,
		stats.still_cuts, stats.rewrapped, stats.tips, stats.prizes, stats.prize_asks, stats.rep_lines, stats.errors)
end

-- Tests and diagnostics.
function _state()
	return { ledger = ledger, fight = fight, mine = mine, fighting = fighting, stats = stats, cut_done = cut_done, world_copy = world_copy,
		got_down = got_down, pit = pit, prizes = fighters_of, pit_won = pit_won }
end

function on_game_start()
	P = coop_npc_players
	if not rawget(_G, "coop") then return end -- exe without co-op: stock
	local em = C().mod("coop_economy_mdata")
	if em and em.register_player_key then
		em.register_player_key("coop_arena_gear", function() return (mine == "fight" and true) or mine or nil, true end)
	end
	for _, s in ipairs({ { "routes", ensure_outer }, { "cutscene", patch_cutscene }, { "zone", patch_zone }, { "idle", patch_idle },
		{ "vote", vote_lines } }) do
		local ok, err = pcall(s[2])
		if not ok then report("install " .. s[1], err) end
	end
	local logic = C().mod("coop_npc_logic")
	if logic and logic.add_audience_rule then logic.add_audience_rule(audience_rule) end
	local ok, err = pcall(share_ledger)
	if not ok then report("share", err) end
	register_events()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("coop_respawned", ask_out)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	C().status_line(TAG, print_status)
end
