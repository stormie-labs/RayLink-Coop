-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - coop.sync in the world's save, gamedata\scripts\coop_sync.script

	coop.sync (the engine: coop_sync_api.cpp; for modders docs\COOP_API.md) keeps the scopes world, player and object
	in memory. The process that decides the world keeps them in its save: save_state puts coop.sync.export() into
	m_data.coop_sync (the .scoc of the save), load_state gives it back with coop.sync.import(). A world without that key (a
	new game, a save without it) starts empty: on_game_start clears what the previous world left, since a new game has no
	load_state. The session scope is not saved; it lives while the session does.
	The same goes for a single player game (no session): a mod that uses coop.sync keeps its data in the save there.
	Any other process of a session keeps only what the decider sends it: it neither saves nor loads coop.sync. The world
	save written for a joining player (coop.saving_for_join()) holds no coop.sync: the player gets his own copy from the
	engine.
--]]

local function api()
	return coop and coop.sync
end

-- In a session another process decides the world and keeps coop.sync in its save.
local function kept_elsewhere()
	return coop_util.active() and not coop_mode.decides_world()
end

local function saving_for_join()
	return coop and coop.saving_for_join and coop.saving_for_join() or false
end

function save_state(m_data)
	local sync = api()
	if not sync or kept_elsewhere() then
		return
	end
	-- The world save for a joining player goes to him whole; coop.sync stays out of it (other players' scopes; he gets his
	-- own copy from the engine). m_data lives between saves (alife_storage_manager): the key of the last normal save is
	-- cleared, not just left alone. The next normal save writes it again.
	if saving_for_join() then
		m_data.coop_sync = nil
		return
	end
	m_data.coop_sync = sync.export()
end

function load_state(m_data)
	local sync = api()
	if not sync or kept_elsewhere() then
		return
	end
	local ok, why = sync.import(m_data.coop_sync)
	if not ok then
		printf("! coop_sync: the saved coop.sync data was not taken (%s): the world starts without it", tostring(why))
	end
end

function on_game_start()
	local sync = api()
	if not sync then
		return
	end
	if not kept_elsewhere() then
		sync.import(nil) -- a new world: nothing of the previous one; load_state brings the save's
	end
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end
