--[[
	Anomaly Coop - Lua layer (gamedata\scripts\coop_main.script)

	Engine API (namespace `coop`, nil on an exe without co-op):
		coop.is_active() coop.is_host() coop.is_client() coop.is_live() coop.self_id()
		coop.players()            -> { {id, nick, avatar_id (local id or nil), rtt, is_self}, ... }
		coop.avatar_of(peer)      -> local object id of that player's character, or nil
		coop.peer_of_avatar(id)   -> peer id, or nil
		coop.owners_known()       -> true once avatar_id is known for every player in the world (a client: after
		                             the host's first owners table since it joined)
		coop.to_host_id(id) coop.to_local_id(id)
		coop.send_event(name, payload, target) -> true | false, reason   (target: -1/nil all, 0 host, N peer)
		coop.send_chat(text)

	Called by the engine:
		coop_main.on_event(name, payload, from)   a Msg::ScriptEvent arrived
		coop_main.on_chat(nick, text)             a chat line (ours included) -> coop_core_chat
		coop_main.on_transition_vote(nick)        host: a player at a level exit asks to move the group
		                                          (requested from the engine, W4 core) -> coop_core_player
		coop_main.print_status()                  part of the coop_status console command

	For addons:
		coop_main.add_event_handler(name, func)  -- func(payload, from, name)
		coop_main.remove_event_handler(name, func)
		coop_main.encode(flat_table) / coop_main.decode(string)   -- safe flat key/value payloads
		RegisterScriptCallback("coop_on_event", func(name, payload, from))
		RegisterScriptCallback("coop_on_chat", func(nick, text))

	Callback routes (F2 T10, docs\MOD_LAYER.md 2.2), on every machine with the engine API: this script installs
	the router shim (scripts\coop_route.script) when it loads. Every function registered through
	RegisterScriptCallback, AddUniqueCall or CreateTimeEvent gets its domain from the engine (coop.route,
	configs\coop_route*.ltx), by its callback and its script; host handlers are skipped on a client, none
	handlers everywhere in a session, and a client runs the others inside pcall (R-11.4).

	What this script does on a co-op CLIENT (nothing of it runs on the host or in single player):
	1. (moved: the client domain filter is the engine's callback router now, see above)
	2. Restrictions: save/load UI paths answer "host only" (R-9.2; the engine gates the console
	   commands too), a quicksave is asked from the host instead (coop_core_player); debug spawner /
	   debug menu are disabled (R-6.6).
	3. Emission and psi-storm (R-10.1): the client's own managers never start by themselves. The host
	   sends the phase (started, elapsed game seconds, time factor) and its cover verdict for this
	   player; the client runs the stock update() with that phase to get the same visuals and sounds,
	   with NPC killing, task giving and the final kill switched off. The final kill comes from the host
	   as an event when the player's character is outside a shelter at the host's kill moment.
	4. Chat lines from the engine go to coop_core_chat (PDA news if it is missing).
	The core group's other scripts (W4): coop_core_hud (status, party panel, PDA markers),
	coop_core_player (own Lua state kept by the host, join/leave notices, quicksave, level moves),
	coop_core_world (host news, mutant loot, stashes, trader profiles).
--]]

local api = rawget(_G, "coop") -- engine namespace

local string_format = string.format
local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

-------------------------------------------------------------------------------
-- Logging and counters
-------------------------------------------------------------------------------
local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-lua] %s", ok and line or tostring(fmt))
end

local stats = {
	errors = 0, -- Lua errors caught by this script: event handlers, chat, patches (R-11.4)
	events_in = 0,
	event_errors = 0,
	chat = 0,
}

-- script name -> Lua errors caught (the log says the first three, then every 100th)
local seen = {}

local function report_error(script, what, err)
	local n = (seen[script] or 0) + 1
	seen[script] = n
	stats.errors = stats.errors + 1
	if n <= 3 or n % 100 == 0 then
		log("! lua error in %s (%s), #%d, the session continues: %s", tostring(script), tostring(what), n, tostring(err))
	end
end

-------------------------------------------------------------------------------
-- Public helpers
-------------------------------------------------------------------------------
function is_active() return api ~= nil and api.is_active() end
function is_host() return api ~= nil and api.is_host() end
function is_client() return api ~= nil and api.is_client() end

local function esc(s)
	return (tostring(s):gsub("[%%;=]", function(c) return string_format("%%%02X", c:byte()) end))
end

local function unesc(s)
	return (s:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end))
end

-- Flat table of string/number/boolean values -> "k=v;k=v". No code, no nesting: safe for network input.
function encode(t)
	local keys = {}
	for k in pairs(t) do keys[#keys + 1] = tostring(k) end
	table.sort(keys)
	local out = {}
	for i = 1, #keys do
		local k = keys[i]
		local v = t[k]
		local tv = type(v)
		local s
		if tv == "number" then
			s = "n" .. tostring(v)
		elseif tv == "boolean" then
			s = v and "b1" or "b0"
		else
			s = "s" .. tostring(v)
		end
		out[#out + 1] = esc(k) .. "=" .. esc(s)
	end
	return table.concat(out, ";")
end

function decode(str)
	local t = {}
	if type(str) ~= "string" then return t end
	for pair in str:gmatch("[^;]+") do
		local k, v = pair:match("^([^=]*)=(.*)$")
		if k and v then
			k, v = unesc(k), unesc(v)
			local tag, body = v:sub(1, 1), v:sub(2)
			if tag == "n" then
				t[k] = tonumber(body)
			elseif tag == "b" then
				t[k] = (body == "1")
			else
				t[k] = body
			end
		end
	end
	return t
end

-------------------------------------------------------------------------------
-- Callback routes (F2 T10, docs\MOD_LAYER.md 2.2). The domain filter that lived here is the engine's router now
-- (coop_router.cpp, configs\coop_route*.ltx); scripts\coop_route.script wraps the handlers on every machine.
-------------------------------------------------------------------------------
local client_mode = false -- true while this machine is a co-op client; refreshed every frame

-- The router shim (coop_route.script), nil where it cannot load (a test harness without it).
local function shim()
	local ok, m = pcall(function() return coop_route end)
	return ok and type(m) == "table" and m or nil
end

-- Script key of the file that defines f (coop.route.of), "?" if unknown. For error lines.
local function script_of(f)
	local r = shim()
	if not (r and r.script_of) then return "?" end
	local ok, s = pcall(r.script_of, f)
	return ok and s or "?"
end

-- axr_main's local callback table (found by the shim), nil if not reachable.
local function get_intercepts()
	local r = shim()
	if not (r and r.intercepts) then return nil end
	local ok, t = pcall(r.intercepts)
	return ok and type(t) == "table" and t or nil
end

-------------------------------------------------------------------------------
-- Messages on screen
-------------------------------------------------------------------------------
local function hud_msg(text)
	local am = rawget(_G, "actor_menu")
	local shown = false
	if am and am.set_msg then
		shown = pcall(am.set_msg, 1, text, 4)
	end
	log("%s", text)
	return shown
end

-------------------------------------------------------------------------------
-- Script events
-------------------------------------------------------------------------------
local handlers = {} -- name -> { [func] = true }

function add_event_handler(name, func)
	if type(name) ~= "string" or type(func) ~= "function" then return false end
	handlers[name] = handlers[name] or {}
	handlers[name][func] = true
	return true
end

-- Split levels: a player's request to the logic of his level (a body to cut up, a trader, a cache). The world server passes it to the
-- authority of his level with his peer; func gets it as if it came from him. A client knows no other process.
function add_level_handler(name, func)
	return add_event_handler(name, function(payload, from)
		if not api then return end
		if api.is_map_server ~= nil and api.is_map_server() == true then
			local t = decode(payload)
			local peer = tonumber(t._peer)
			if from ~= 0 or not peer then return end
			t._peer = nil
			return func(encode(t), peer)
		end
		local l = api.levels
		local bridge = api.is_host() and type(from) == "number" and from ~= 0 and l ~= nil and l.split ~= nil and l.split() == true and
			l.bridge_of_player and l.bridge_of_player(from)
		if bridge then
			local t = decode(payload)
			t._peer = from
			api.send_event(name, encode(t), bridge)
			return
		end
		return func(payload, from)
	end)
end

function remove_event_handler(name, func)
	if handlers[name] then handlers[name][func] = nil end
end

-- Is f registered for the callback `name` (itself, or the router shim's wrapper of it)? nil = unknown.
function callback_registered(name, f)
	local t = get_intercepts()
	if type(t) ~= "table" or type(t[name]) ~= "table" or f == nil then return nil end
	if t[name][f] then return true end
	local r = shim()
	local w = r and r.wrapper_of and r.wrapper_of(name, f)
	return w ~= nil and t[name][w] ~= nil
end

local function callback_exists(name)
	local t = get_intercepts()
	return t ~= nil and t[name] ~= nil
end

local function ensure_callback(name)
	if callback_exists(name) then return end
	if type(rawget(_G, "AddScriptCallback")) == "function" then
		pcall(AddScriptCallback, name)
	end
end

-- Engine entry: a Msg::ScriptEvent for this machine. `from` is the sender's peer id (0 = host).
function on_event(name, payload, from)
	stats.events_in = stats.events_in + 1
	local hs = handlers[name]
	if hs then
		for f in pairs(hs) do
			local ok, err = pcall(f, payload, from, name)
			if not ok then
				stats.event_errors = stats.event_errors + 1
				report_error(script_of(f), "event " .. tostring(name), err)
			end
		end
	end
	if callback_exists("coop_on_event") then
		local ok, err = pcall(SendScriptCallback, "coop_on_event", name, payload, from)
		if not ok then report_error("coop_on_event", tostring(name), err) end
	end
end

-- Engine entry: a chat line (R-1.7), ours included. Shown in the chat (coop_core_chat: window, HUD feed,
-- history); a PDA news line if that script is missing.
-- `from`: the sender's peer id (0 = the host or the world server); nil from an engine that does not name it.
function on_chat(nick, text, from)
	stats.chat = stats.chat + 1
	nick, text = tostring(nick), tostring(text)
	if type(from) ~= "number" then from = nil end
	local shown = false
	local chat = rawget(_G, "coop_core_chat")
	if chat and chat.on_line then
		local ok, r = pcall(chat.on_line, nick, text, from)
		if ok then
			shown = r == true
		else
			report_error("coop_core_chat", "chat line", r)
		end
	end
	local actor = db and db.actor
	if actor and not shown then
		shown = pcall(function()
			actor:give_game_news("Co-op: " .. nick, text, "ui_iconsTotal_grouping", 0, 7000)
		end)
		local snd = rawget(_G, "xr_sound")
		if shown and snd and snd.set_sound_play then
			pcall(snd.set_sound_play, AC_ID, "pda_tips")
		end
	end
	if not shown then log("<%s> %s", nick, text) end
	if callback_exists("coop_on_chat") then
		pcall(SendScriptCallback, "coop_on_chat", nick, text, from)
	end
end

-- Lua side of coop_main.say: same as the coop_chat console command.
function say(text)
	if api and type(text) == "string" and text ~= "" then return api.send_chat(text) end
	return false
end

-- Engine entry (host, requested from coop_join: host_on_transition_vote): a player stands at a level exit and
-- asks the group to move. coop_core_player shows it and arms /go.
function on_transition_vote(nick)
	local pl = rawget(_G, "coop_core_player")
	if pl and pl.on_transition_vote then
		local ok, err = pcall(pl.on_transition_vote, tostring(nick))
		if ok then return end
		report_error("coop_core_player", "transition vote", err)
	end
	hud_msg("Co-op: " .. tostring(nick) .. " wants to move the group (console: coop_accept_transition)")
end

-------------------------------------------------------------------------------
-- Emission and psi-storm (R-10.1)
-------------------------------------------------------------------------------
local surge_cls_patched, host_hooks = false, false
local env_host = { sig = nil, next_send = 0, serial = 0, kill_sent = {}, cover_rep = {}, npc_kill_at = {} }
local env_cl = { have = false, s = false, sg = 0, p = false, pg = 0, tf = nil, cover = true, at = 0,
	next_tick = 0, req_at = 0, mirror_errors = 0, cover_at = 0 }

local function surge_mgr()
	local mod = rawget(_G, "surge_manager") or surge_manager
	return mod and mod.get_surge_manager and mod.get_surge_manager()
end

local function psi_mgr()
	local mod = rawget(_G, "psi_storm_manager") or psi_storm_manager
	return mod and mod.get_psi_storm_manager and mod.get_psi_storm_manager()
end

-- Started?, game seconds since the start.
local function env_phase(m)
	if not (m and m.started == true and m.inited_time) then return false, 0 end
	local ok, gs = pcall(function() return game.get_game_time():diffSec(m.inited_time) end)
	return true, (ok and gs) or 0
end

-- Audit 2026-10-24 (E1): a remote player's shelter is his own. His machine knows it (the stock covers, its underground
-- flag, G.A.M.M.A.'s ray-cast cover and coordinate safe zones) and reports it with coop_env_cover; a fresh report
-- decides. Without one, the surge script's static covers (misc\surge_manager.ltx) at his character. The host's own
-- underground flag never decides for him (it spared every client while the host sat in a cellar).
local COVER_FRESH_MS = 3000
local function player_in_cover(peer, obj)
	local rep = env_host.cover_rep[peer]
	if rep and time_global() - rep.at <= COVER_FRESH_MS then return rep.c end
	local sm = surge_mgr()
	if not sm then return true end
	if sm.init_surge_covers then sm:init_surge_covers() end
	return sm:pos_in_cover(obj:position()) == true
end

-- A player on a map server's level has no object here: what his own machine last reported, nil when that is old or there is none.
local function reported_cover(peer)
	local rep = env_host.cover_rep[peer]
	if rep and time_global() - rep.at <= COVER_FRESH_MS then return rep.c end
	return nil
end

local function players()
	if not api then return {} end
	local ok, list = pcall(api.players)
	return ok and list or {}
end

-------------------------------------------------------------------------------
-- The emission on every level (docs\SPLIT_LEVELS.md 7b). One schedule, the world server's; the phase goes to every map server and
-- every client. A map server is the authority of its level: there the stock runs for real, with the kills on, and the verdict on
-- the players of that level is its own. A level the stock emission does not reach plays nothing.
-------------------------------------------------------------------------------
local function split_on()
	local l = api and api.levels
	return l ~= nil and l.split ~= nil and l.split() == true
end

local function map_server()
	return api ~= nil and api.is_map_server ~= nil and api.is_map_server() == true
end

-- The stock's two levels no emission reaches on top of its valid_levels (surge_manager.script start): its source, and a level with
-- nowhere to hide.
local NO_EMISSION = { l13_generators = true, l11_hospital = true }
local function level_open(name)
	local lw = rawget(_G, "level_weathers") or level_weathers
	return name ~= nil and lw ~= nil and lw.valid_levels ~= nil and lw.valid_levels[name] == true and not NO_EMISSION[name]
end

-- The world server: an open level somebody stands on, the host's own first.
local function open_level_of_a_player()
	local here = level.name()
	if level_open(here) then return here end
	local l = api.levels
	for _, p in ipairs(players()) do
		local name = not p.is_self and l.level_of_player and l.level_name and l.level_name(l.level_of_player(p.id))
		if name and level_open(name) then return name end
	end
	return nil
end

-- The world server: this event of player `peer` goes to the authority of his level. -> it went
local function to_his_map_server(name, t, peer)
	local l = api.levels
	local bridge = split_on() and l.bridge_of_player and l.bridge_of_player(peer)
	if not bridge then return false end
	t.peer = peer
	api.send_event(name, encode(t), bridge)
	return true
end

-- Host: the stock surge decided to kill unsheltered people now (2nd wave or the end). Same verdict for
-- every remote player's character, once per emission. The wave position is not used for proxies.
-- A remote player sleeping through the emission on an anabiotic (coop_npc_effects keeps it per player, W5).
-- The stock survive condition ({+anabiotic_in_process}) is the HOST actor's and no longer spares everybody.
local function anabiotic(peer)
	local fx = rawget(_G, "coop_npc_effects")
	if not (fx and fx.is_anabiotic) then return false end
	local ok, r = pcall(fx.is_anabiotic, peer)
	return ok and r == true
end

local function host_surge_kill_check(m)
	if not (api and (api.is_host() or map_server())) then return end
	-- audit E3: the host's story immunity (surge_immuned) is his own; a client's is checked on his machine (coop_env_kill)
	for _, p in ipairs(players()) do
		if not p.is_self and env_host.kill_sent[p.id] ~= env_host.serial and anabiotic(p.id) then
			-- spared at this kill moment only: one who wakes before the next one is judged then
			log("emission: %s (#%d) sleeps on an anabiotic, spared", tostring(p.nick), p.id)
		elseif not p.is_self and env_host.kill_sent[p.id] ~= env_host.serial then
			local obj = p.avatar_id and level.object_by_id(p.avatar_id)
			local exposed
			if obj then exposed = obj:alive() and not player_in_cover(p.id, obj)
			else exposed = reported_cover(p.id) == false end -- his machine checks that he is alive
			if exposed then
				env_host.kill_sent[p.id] = env_host.serial
				api.send_event("coop_env_kill", encode({ kind = "surge" }), p.id)
				log("emission: %s (#%d) is outside a shelter, kill sent", tostring(p.nick), p.id)
			end
		end
	end
end

-- The stock's level checks read level.name() of this process. With split levels the emission is the world's: fn sees `name`.
local function with_level_name(name, fn, ...)
	local own = level.name
	level.name = function() return name end
	local res = { pcall(fn, ...) }
	level.name = own
	if not res[1] then report_error("coop_main", "emission schedule", res[2]) end
	return unpack(res, 2)
end

-- The world server, with split levels: a host under ground does not stop the world's emission, and he plays nothing of it there.
-- `field`: the manager's length; `finish`: how the stock ends it.
local function schedule_around(cls, field, finish)
	local start, update = cls.start, cls.update
	cls.start = function(self, ...)
		if not split_on() then return start(self, ...) end
		local name = open_level_of_a_player()
		if not name or name == level.name() then return start(self, ...) end
		log("emission schedule: the host is on a closed level, %s is open", name)
		return with_level_name(name, start, self, ...)
	end
	cls.update = function(self, ...)
		if not (split_on() and self.started == true and not level_open(level.name())) then return update(self, ...) end
		local ok, sec = pcall(function() return game.get_game_time():diffSec(self.inited_time) / level.get_time_factor() end)
		if ok and sec >= (self[field] or 0) then self[finish](self) end
	end
end

function install_env_schedule()
	local sm_mod = rawget(_G, "surge_manager") or surge_manager
	local pm_mod = rawget(_G, "psi_storm_manager") or psi_storm_manager
	if sm_mod and sm_mod.CSurgeManager then schedule_around(sm_mod.CSurgeManager, "surge_time", "end_surge") end
	if pm_mod and pm_mod.CPsiStormManager then schedule_around(pm_mod.CPsiStormManager, "psi_storm_duration", "finish") end
end

local function install_host_hooks()
	host_hooks = true
	local mod = rawget(_G, "surge_manager") or surge_manager
	local cls = mod and mod.CSurgeManager
	if not cls then
		log("! surge_manager.CSurgeManager not found, emission kills are not sent to clients")
		return
	end
	for _, fname in ipairs({ "kill_actor_at_pos", "kill_all_unhided" }) do
		local ok, orig = pcall(function() return cls[fname] end)
		if ok and type(orig) == "function" then
			cls[fname] = function(self, ...)
				-- the end of an emission that runs elsewhere reaches nobody on a level it does not reach
				if split_on() and not level_open(level.name()) then return end
				local r = orig(self, ...)
				local okc, err = pcall(host_surge_kill_check, self)
				if not okc then report_error("coop_main", "surge kill check", err) end
				return r
			end
		end
	end
	if api.is_host() then install_env_schedule() end
end

local function host_env_tick()
	local s_on, s_gs = env_phase(surge_mgr())
	local p_on, p_gs = env_phase(psi_mgr())
	local sig = (s_on and "s" or "-") .. (p_on and "p" or "-")
	local tg = time_global()
	if sig ~= env_host.sig then
		if s_on and not (env_host.sig or ""):find("s", 1, true) then
			env_host.serial = env_host.serial + 1 -- a new emission: everybody can be caught again
		end
		env_host.sig = sig
		env_host.next_send = 0
	end
	if tg < env_host.next_send then return end
	local active = s_on or p_on
	env_host.next_send = tg + (active and 1000 or 10000)
	local tf = level.get_time_factor()
	local split = split_on()
	for _, p in ipairs(players()) do
		if not p.is_self then
			-- with split levels a player elsewhere has no object here: his machine judges his shelter, the authority of his level his fate
			local own = split and api.levels.on_host_level ~= nil and not api.levels.on_host_level(p.id)
			local cover = true
			if active and not own then
				local obj = p.avatar_id and level.object_by_id(p.avatar_id)
				if obj then cover = player_in_cover(p.id, obj)
				else cover = reported_cover(p.id) ~= false end
			end
			api.send_event("coop_env", encode({ s = s_on, sg = s_gs, p = p_on, pg = p_gs, tf = tf, c = cover, own = own or nil }), p.id)
		end
	end
	if split and api.levels.map_servers then
		for _, ms in ipairs(api.levels.map_servers()) do
			api.send_event("coop_env", encode({ s = s_on, sg = s_gs, p = p_on, pg = p_gs, tf = tf, c = true }), ms.bridge)
		end
	end
end

-- Audit E2 (2026-10-24), client: the stock kill of the people a wave / vortex reaches (kill_objects_at_pos) goes to the
-- host with where it is (surge: the wave's z, false = everybody unhidden; psi storm: the vortex). Once a second for
-- the wave (the stock calls it every 5 game seconds), every vortex.
local NPC_KILL_WAVE_MS = 1000
local npc_kill_cl = { wave_at = -NPC_KILL_WAVE_MS }
local function forward_npc_kill(cls, kind)
	if not cls then return 0 end
	local ok, orig = pcall(function() return cls.kill_objects_at_pos end)
	if not (ok and type(orig) == "function") then return 0 end
	cls.kill_objects_at_pos = function(self, pos)
		if not (api and api.is_client()) then return end
		local t = { k = kind }
		if kind == "p" then
			if type(pos) ~= "userdata" and type(pos) ~= "table" then return end
			t.x, t.y, t.z = pos.x, pos.y, pos.z
		else
			local tg = time_global()
			if tg - npc_kill_cl.wave_at < NPC_KILL_WAVE_MS then return end
			npc_kill_cl.wave_at = tg
			t.z = tonumber(pos) -- nil: everybody unhidden around him
		end
		api.send_event("coop_env_npc_kill", encode(t), 0)
	end
	return 1
end

-- Audit E2, client: the hide task is this player's own. Its id is made personal (coop_tasks.set_local_task: never
-- sent to the host, never mirrored), then the stock gives it here; its condition ({=surge_complete}) reads the
-- mirrored phase, so it is done when the host's emission ends here.
local function personal_hide_task(cls, fname, field, default_id)
	if not cls then return 0 end
	local ok, orig = pcall(function() return cls[fname] end)
	if not (ok and type(orig) == "function") then return 0 end
	cls[fname] = function(self, ...)
		local sect = self[field]
		if sect == "empty" then return end
		local id = (sect == nil or sect == "") and default_id or sect
		local ct = rawget(_G, "coop_tasks")
		if not (ct and type(ct.set_local_task) == "function" and ct.set_local_task(id)) then
			log("! hide task '%s' cannot be personal here: not given", tostring(id))
			return
		end
		return orig(self, ...)
	end
	return 1
end

-- Client: stop the parts of the stock managers that change the world or decide the actor's death.
local function patch_env_classes_for_client()
	if surge_cls_patched then return end
	surge_cls_patched = true
	local function neutralize(cls, names)
		if not cls then return 0 end
		local n = 0
		for _, fname in ipairs(names) do
			local ok, f = pcall(function() return cls[fname] end)
			if ok and type(f) == "function" then
				cls[fname] = function() end
				n = n + 1
			end
		end
		return n
	end
	local sm_mod = rawget(_G, "surge_manager") or surge_manager
	local pm_mod = rawget(_G, "psi_storm_manager") or psi_storm_manager
	if map_server() then
		-- the authority of its level: every consequence runs here, what nobody plays does not
		local n = neutralize(sm_mod and sm_mod.CSurgeManager, { "give_surge_hide_task", "displayIndicators" })
		n = n + neutralize(pm_mod and pm_mod.CPsiStormManager, { "give_psi_storm_hide_task", "displayIndicators" })
		install_host_hooks()
		log("emission/psi-storm: the phases are the world server's, the consequences this map server's (%d hud method(s) off)", n)
		return
	end
	-- R5 I2: launch_rockets (signal lights) is the host's too: the psi storm calls it unconditionally
	local n = neutralize(sm_mod and sm_mod.CSurgeManager, { "kill_crows_at_pos",
		"turn_to_zombie", "explode", "kill_actor_at_pos", "kill_all_unhided", "launch_rockets" })
	n = n + neutralize(pm_mod and pm_mod.CPsiStormManager, { "kill_crows_at_pos", "launch_rockets" })
	-- Audit E2: the people this player's wave / vortex reaches die on the host (the stock kill there, kept to his
	-- area); his hide task is his own (a personal task, finished when the host's phase ends here).
	local f = 0
	f = f + forward_npc_kill(sm_mod and sm_mod.CSurgeManager, "s")
	f = f + forward_npc_kill(pm_mod and pm_mod.CPsiStormManager, "p")
	f = f + personal_hide_task(sm_mod and sm_mod.CSurgeManager, "give_surge_hide_task", "surge_task_sect", "hide_from_surge")
	f = f + personal_hide_task(pm_mod and pm_mod.CPsiStormManager, "give_psi_storm_hide_task", "psi_storm_task_sect",
		"hide_from_psi_storm")
	log("emission/psi-storm: %d world-changing method(s) disabled, %d routed (kills to the host, personal hide tasks), "
		.. "phases follow the host", n, f)
end

-- R5 I2: a client never ends an emission / psi storm by itself. The stock update() ends it when the elapsed
-- seconds reach surge_time (psi storm: psi_storm_duration); the mirror's clock is extrapolated and can get there
-- before the host's "ended" state arrives, and client_env_tick would then start a fresh mirror: repeated start/end
-- events and +rank per cycle. On a client both limits are "never"; only the host's phase ends the mirror
-- (client_env_tick -> end_surge / finish). initialize() resets the stock value, so it is set again after it and
-- before every update.
local NEVER_ENDS = 1e9

local function set_inited(m, game_sec)
	local now = game.get_game_time()
	local d = game.CTime()
	d:setHMSms(0, 0, math.max(0, math.floor(game_sec)), 0)
	now:sub(d)
	m.inited_time = now
end

-- Runs fn with the host's cover verdict as this actor's "current_safe_cover".
local function with_cover(cover, fn, what)
	local saved = GetEvent("current_safe_cover")
	SetEvent("current_safe_cover", cover and true or false)
	local ok, err = pcall(fn)
	SetEvent("current_safe_cover", saved)
	if not ok then
		env_cl.mirror_errors = env_cl.mirror_errors + 1
		report_error("coop_main", what, err)
	end
end

local function mirror_start_surge(m)
	if not m._state_loaded then
		m:initialize()
		m._state_loaded = true
	end
	m.surge_time = NEVER_ENDS -- R5 I2
	m.game_time_factor = level.get_time_factor()
	if m.finalize then m:finalize() end
	m.started, m.finished = true, false
	-- false: the stock neither starts nor fades these, quake_step plays them
	m.blowout_waves, m.objects_to_kill, m.body_tears = {}, {}, {}
	m.stages = { quake20 = false, quake40 = false, quake60 = false, quake80 = false, quake100 = false }
	m.hitFactor, m.zombie_count = 0, 0
	m.effector_set, m.second_message_given, m.ui_disabled = false, false, false
	m.task_given = false -- audit E2: the stock update gives this player's personal hide task at its moment
	m.blowout_sound, m.wave_sound = false, false
	env_host.serial = env_host.serial + 1 -- a map server: a new emission, everybody on its level can be caught again
	pcall(SendScriptCallback, "actor_on_interaction", "anomalies", nil, "emission_start")
	log("emission started by the host")
end

local function mirror_start_psi(m)
	surge_mgr() -- psi initialize() reads surge_manager.SurgeManager.ini
	if not m._state_loaded then
		m:initialize()
		m._state_loaded = true
	end
	m.psi_storm_duration = NEVER_ENDS -- R5 I2
	m.game_time_factor = level.get_time_factor()
	if m.finalize then m:finalize() end
	m.started, m.finished = true, false
	m.hitFactor = 0
	m.stages, m.vortexes, m.humanParticles = {}, {}, {}
	m.next_vortex_at = nil
	m.task_given = false -- audit E2: a personal hide task, given by the stock update
	pcall(SendScriptCallback, "actor_on_interaction", "anomalies", nil, "psi_storm_start")
	log("psi-storm started by the host")
end

local function mirror_update(m, game_sec, what, limit_field)
	m.first_update = true -- the host already validated level and options
	m[limit_field] = NEVER_ENDS -- R5 I2: only the host ends the emission / psi storm
	set_inited(m, game_sec)
	with_cover(env_cl.cover, function() m:update() end, what)
end

-- A mirror that starts late (the player joined during it): the stock update plays every stage that is due at once. A
-- stage is over this many stock seconds in. The rumble is not listed: it is on now, and it ends later.
local SURGE_STAGES_OVER = { beginning = 5, siren = 30, impact = 52,
	["1stwavesnd"] = 120, ["1stwave"] = 124, ["2ndwavesnd"] = 168, ["2ndwave"] = 172 }
local PSI_STAGES_OVER = { beginning = 5, siren = 15 }

-- The quake on a client (live 2026-11-01: the emission ran and nothing shook, the cause not found by reading): the stock's ladder
-- of surge_manager.update, played here from the host's clock with an effector id of its own, each step in the log. A mirror that
-- starts late comes in on the step of that moment. Stock seconds; the last row of each pair of lines is the fade.
local QUAKE_CAM = 39571 -- free in the stock, next to the contusion's 39570
local QUAKE = { { 80, "earthquake_20" }, { 100, "earthquake_40" }, { 102, "earthquake_60" }, { 104, "earthquake_80" },
	{ 106, "earthquake" }, { 200, "earthquake_80" }, { 202, "earthquake_60" }, { 206, "earthquake_40" }, { 209, "earthquake_20" } }
local quake_on = nil

local function quake_stop()
	if not quake_on then return end
	quake_on = nil
	pcall(level.remove_cam_effector, QUAKE_CAM)
end

local function quake_step(sec)
	local name = nil
	for _, row in ipairs(QUAKE) do
		if sec >= row[1] then name = row[2] end
	end
	if not name or name == quake_on then return end
	quake_stop()
	local ok, res = pcall(level.add_cam_effector, "camera_effects\\" .. name .. ".anm", QUAKE_CAM, true, "", 0, false)
	quake_on = name
	log("emission quake: %s at %d s, %s", name, sec, ok and ("runs " .. tostring(res) .. " s") or tostring(res))
end

local function skip_stages_over(m, over, game_sec)
	local sec = game_sec / (env_cl.tf or level.get_time_factor())
	for stage, at in pairs(over) do
		if sec >= at then m.stages[stage] = true end
	end
end

-- Live 2026-11-08 (Banan4ik, client): after a psi storm the client kept the storm's HUD for good (G.A.M.M.A.'s cover bar).
-- The stock writes its "running" flags only inside update(): psi_storm_manager.script L278 SetEvent("psi_storm", "state",
-- self.started), L351 / L367 "vortex"; surge_manager.script L571 SetEvent("surge", "state", self.started) (G.A.M.M.A.: L297,
-- L370 / L386, L606). finish() and end_surge() never write them. The host and single player call update() every second after
-- the end as well (surge_manager main_loop), so their next call writes "state" false. A client calls update() only in the mirror
-- while the host's phase runs (the stock loop is host, coop_route.ltx), so the flags stayed as its last update left them: on.
-- Their readers run on a client: dynamic_emission_cover_mcm (the cover bar), item_device (NVG / PDA glitch), item_radio,
-- ui_dosimeter, level_environment (light flicker). So the local state follows the host's phase as a level, every tick: "not
-- running here" (the host's end, or a level the world's emission does not reach) ends whatever of it is on and writes the flags
-- as the stock's next update would. A flag left on with nothing running (a load or a level change mid-storm, an end that
-- raised) is a disagreement with the host: corrected, one log line.
local ENV_LOCAL = {
	surge = { name = "emission", stop = function(m) m:end_surge() end },
	psi_storm = { name = "psi-storm", stop = function(m) m:finish() end, vortex = true },
}

local function have_events()
	return type(rawget(_G, "GetEvent")) == "function" and type(rawget(_G, "SetEvent")) == "function"
end

-- What of a stock manager's run is on here; nil: nothing.
local function env_left_on(m, key)
	local on = {}
	if m.started == true then on[#on + 1] = "running" end
	if have_events() then
		if GetEvent(key, "state") then on[#on + 1] = "hud flag" end
		if ENV_LOCAL[key].vortex and GetEvent(key, "vortex") then on[#on + 1] = "vortex flag" end
	end
	return on[1] and table.concat(on, ", ") or nil
end

-- Client: the host's phase is "not running" here. `why`: nil for the host's end, else why it is not running here.
local function env_off_here(m, key, why)
	if not m then return end
	local e = ENV_LOCAL[key]
	if key == "surge" then quake_stop() end
	local left = env_left_on(m, key)
	if not left then return end
	if m.started == true then
		with_cover(true, function() e.stop(m) end, e.name .. " end")
		if why then log("%s ended here: %s", e.name, why) else log("%s ended by the host", e.name) end
	else
		log("%s: my local state (%s) disagrees with the host's (not running%s), corrected", e.name, left,
			why and (", " .. why) or "")
	end
	if not have_events() then return end
	SetEvent(key, "state", false) -- the stock's next update after its end
	if e.vortex then
		SetEvent(key, "vortex", false)
		-- the vortex hit's psi_fade.ppe / electro_fade.ppe (psi_storm_manager vortex_actor_hit)
		pcall(level.remove_pp_effector, 666)
		pcall(level.remove_pp_effector, 667)
	end
end

local function client_env_tick()
	if not env_cl.have or not db.actor then return end
	local tg = time_global()
	if tg < env_cl.next_tick then return end
	env_cl.next_tick = tg + 1000
	if tg - env_cl.at > 15000 then return end -- the host is silent: hold the current phase
	if split_on() and not level_open(level.name()) then
		-- under ground the emission of the world is not felt: nothing of it stays on here either
		env_off_here(surge_mgr(), "surge", "this level is not reached by the world's emission")
		env_off_here(psi_mgr(), "psi_storm", "this level is not reached by the world's emission")
		return
	end
	local dt = (tg - env_cl.at) / 1000 * (env_cl.tf or level.get_time_factor())
	if env_cl.own then
		local ok, c = pcall(env_own_cover)
		env_cl.cover = ok and c == true
	end
	local ghost = map_server()

	local sm = surge_mgr()
	if sm then
		if env_cl.s then
			if not sm.started then
				mirror_start_surge(sm)
				skip_stages_over(sm, SURGE_STAGES_OVER, env_cl.sg + dt)
			end
			mirror_update(sm, env_cl.sg + dt, "emission mirror", "surge_time")
			if not ghost then quake_step((env_cl.sg + dt) / (env_cl.tf or level.get_time_factor())) end
		else
			env_off_here(sm, "surge")
		end
	end
	local pm = psi_mgr()
	if pm then
		if env_cl.p then
			if not pm.started then
				mirror_start_psi(pm)
				skip_stages_over(pm, PSI_STAGES_OVER, env_cl.pg + dt)
			end
			mirror_update(pm, env_cl.pg + dt, "psi-storm mirror", "psi_storm_duration")
		else
			env_off_here(pm, "psi_storm")
		end
	end

	-- After start/stop (they remember the factor to restore), follow the host's time factor.
	local tf = env_cl.tf
	if tf and tf > 0 and math.abs(level.get_time_factor() - tf) > 0.001 then
		level.set_time_factor(tf)
	end
end

add_event_handler("coop_env", function(payload, from)
	if from ~= 0 or not (api and api.is_client()) then return end
	local t = decode(payload)
	local s, p = t.s == true, t.p == true
	if s ~= env_cl.s or p ~= env_cl.p or not env_cl.have then
		env_cl.next_tick = 0 -- a phase change is applied on the next frame, not after the 1 s step
	end
	env_cl.s, env_cl.sg = s, tonumber(t.sg) or 0
	env_cl.p, env_cl.pg = p, tonumber(t.pg) or 0
	env_cl.tf = tonumber(t.tf)
	env_cl.cover = t.c ~= false
	env_cl.own = t.own == true -- split levels: he stands where the world server has no object of him
	env_cl.at = time_global()
	env_cl.have = true
end)

add_event_handler("coop_env_req", function(payload, from)
	if api and api.is_host() then env_host.next_send = 0 end
end)

-- Host: a client's own shelter, reported while an emission or a psi storm runs (player_in_cover).
-- Audit E2, host: a client's wave / vortex reached the people around him. The stock kill runs here (the host's online
-- NPCs), for the psi storm at that vortex (near his character), for the emission only among the NPCs within
-- NPC_KILL_RADIUS of his character (the wave is a plane across the level from where each player stands: his must not
-- reach the host's people before the host's own wave does). Only while that phase runs here; a few per second.
local NPC_KILL_RADIUS = 250
local NPC_KILL_MIN_MS = 200
local function dist_xz(a, b)
	local dx, dz = a.x - b.x, a.z - b.z
	return math.sqrt(dx * dx + dz * dz)
end

local function avatar_of(peer)
	for _, p in ipairs(players()) do
		if p.id == peer and not p.is_self then return p.avatar_id and level.object_by_id(p.avatar_id) end
	end
end

-- Runs fn with db.OnlineStalkers holding only the NPCs within radius of pos (the stock kill walks that list).
local function with_online_near(pos, radius, fn)
	local all = db.OnlineStalkers or {}
	local near = {}
	for i = 1, #all do
		local id = all[i]
		local npc = db.storage and db.storage[id] and db.storage[id].object or level.object_by_id(id)
		local ok, p = pcall(function() return npc and npc:position() end)
		if ok and p and dist_xz(p, pos) <= radius then near[#near + 1] = id end
	end
	db.OnlineStalkers = near
	local ok, err = pcall(fn)
	db.OnlineStalkers = all
	if not ok then report_error("coop_main", "emission kill near a player", err) end
end

local function option(name, def)
	local uo = rawget(_G, "ui_options")
	local ok, v = pcall(function() return uo and uo.get(name) end)
	if ok and v ~= nil then return v end
	return def
end

add_event_handler("coop_env_npc_kill", function(payload, from)
	local ms = map_server()
	if not (api and (api.is_host() or ms)) or type(from) ~= "number" then return end
	local t = decode(payload)
	if ms then
		from = tonumber(t.peer) -- the world server passes on what a player of this level reported
		if not from then return end
	elseif from == 0 or to_his_map_server("coop_env_npc_kill", t, from) then
		return
	end
	local tg = time_global()
	if tg - (env_host.npc_kill_at[from] or -NPC_KILL_MIN_MS) < NPC_KILL_MIN_MS then return end
	local obj = avatar_of(from)
	if not obj then return end
	local apos = obj:position()
	if t.k == "p" then
		local pm = psi_mgr()
		local x, y, z = tonumber(t.x), tonumber(t.y), tonumber(t.z)
		if not (pm and pm.started == true and x and y and z) then return end
		if dist_xz({ x = x, z = z }, apos) > NPC_KILL_RADIUS then return end
		env_host.npc_kill_at[from] = tg
		local pos = vector():set(x, y, z)
		local okc, err = pcall(pm.kill_crows_at_pos, pm, pos)
		if not okc then report_error("coop_main", "psi-storm crows near a player", err) end
		local fate = option("alife/event/psi_storm_fate", "kill_at_vortex")
		if fate ~= "unhurt" then
			local okk, errk = pcall(pm.kill_objects_at_pos, pm, pos, fate)
			if not okk then report_error("coop_main", "psi-storm kill near a player", errk) end
		end
	elseif t.k == "s" then
		local sm = surge_mgr()
		if not (sm and sm.started == true) then return end
		env_host.npc_kill_at[from] = tg
		local z = tonumber(t.z)
		local fate = option("alife/event/emission_fate", "kill_at_wave")
		with_online_near(apos, NPC_KILL_RADIUS, function() sm:kill_objects_at_pos(z or false, fate) end)
	end
end)

add_event_handler("coop_env_cover", function(payload, from)
	local ms = map_server()
	if not (api and (api.is_host() or ms)) or type(from) ~= "number" then return end
	local t = decode(payload)
	if ms then
		from = tonumber(t.peer)
		if not from then return end
	elseif from == 0 or to_his_map_server("coop_env_cover", t, from) then
		return
	end
	env_host.cover_rep[from] = { c = t.c == true, at = time_global() }
end)

-- Client: this machine's view of its shelter. Any of: the underground flag, the cover this machine's scripts keep in
-- "current_safe_cover" (G.A.M.M.A.'s dynamic cover; with_cover only lends it the host's verdict while the mirror runs
-- and gives it back), the static covers of the surge script.
local function own_cover()
	if GetEvent and GetEvent("underground") then return true end
	if GetEvent and GetEvent("current_safe_cover") == true then return true end
	local sm, actor = surge_mgr(), db.actor
	if not (sm and actor) then return false end
	if sm.init_surge_covers then sm:init_surge_covers() end
	return sm:pos_in_cover(actor:position()) == true
end
env_own_cover = own_cover

add_event_handler("coop_env_kill", function(payload, from)
	if from ~= 0 or not (api and api.is_client()) then return end
	local actor = db.actor
	if not (actor and actor:alive()) then return end
	if load_var and load_var(actor, "surge_immuned", false) == true then return end
	local fx = rawget(_G, "coop_npc_effects")
	if fx and fx.anabiotic_self then
		local ok, sleeping = pcall(fx.anabiotic_self)
		if ok and sleeping then
			log("emission kill ignored: this player sleeps on an anabiotic")
			return
		end
	end
	log("caught outside a shelter by the emission (host decision)")
	actor:kill(actor)
end)

-------------------------------------------------------------------------------
-- Client restrictions (R-9.2 saves, R-6.6 debug tools)
-------------------------------------------------------------------------------
local client_patched = false

local function on_before_save_input(flags, typ, text)
	if client_mode and type(flags) == "table" then
		flags.ret = true
		-- A quicksave (type 2: F5, the menu's quicksave) is asked from the host (coop_core_player).
		local pl = rawget(_G, "coop_core_player")
		if typ == 2 and pl and pl.request_quicksave then
			local ok, asked = pcall(pl.request_quicksave)
			if ok and asked then return end
		end
		hud_msg("Co-op: only the host saves the game")
	end
end

local function on_before_load_input(dik, bind, flags)
	if client_mode and type(flags) == "table" then
		flags.ret = true
		hud_msg("Co-op: loading is disabled while connected (coop_disconnect first)")
	end
end

local function patch_main_menu()
	local mod = rawget(_G, "ui_main_menu") or ui_main_menu
	local cls = mod and mod.main_menu
	if not cls then return end
	local texts = {
		OnButton_save_clicked = "Co-op: only the host saves the game",
		OnButton_load_clicked = "Co-op: loading is disabled while connected (coop_disconnect first)",
		OnButton_last_save = "Co-op: loading is disabled while connected (coop_disconnect first)",
	}
	for fname, text in pairs(texts) do
		local ok, orig = pcall(function() return cls[fname] end)
		if ok and type(orig) == "function" then
			cls[fname] = function(self, ...)
				if client_mode then
					hud_msg(text)
					return
				end
				return orig(self, ...)
			end
		end
	end
end

-- [route_none_functions] of configs\coop_route*.ltx (was [blocked_functions]), read by the engine.
local function none_functions()
	local r = api and api.route
	if not (r and type(r.none_functions) == "function") then return {} end
	local ok, list = pcall(r.none_functions)
	return ok and type(list) == "table" and list or {}
end

local function session_on()
	if not api then return false end
	local ok, on = pcall(api.is_active)
	return ok and on == true
end

-- DEBUG_DESIGN B.8: in any session, the host's too, the stock debug tools never run: every debug action goes through the
-- server (F7 is the co-op window, coop_debug_ui). Outside a session the stock function runs. Installed once per Lua state.
local stubs_installed = false
local function stub_blocked_functions()
	if stubs_installed then return end
	stubs_installed = true
	local n = 0
	for _, full in ipairs(none_functions()) do
		local modname, fname = full:match("^([%w_]+)%.([%w_]+)$")
		if modname then
			local ok, mod = pcall(function() return _G[modname] end)
			if ok and type(mod) == "table" and type(mod[fname]) == "function" then
				local orig = mod[fname]
				mod[fname] = function(...)
					if session_on() then
						hud_msg("Co-op: in a session the debug window is F7, the server carries out its actions")
						return
					end
					return orig(...)
				end
				n = n + 1
			end
		end
	end
	if n > 0 then log("%d stock debug tool entry point(s) disabled while a session is on", n) end
end

-- R-6.6 on every machine (DEBUG_DESIGN B.8): while a session is on, DEV_DEBUG and DEV_DEBUG_DEV are off, the host's too: under
-- them stock code acts locally (fast travel to any mark, debug map marks, debug_mode_flag_on). The values before the session
-- come back when it ends. Checked at load and on every update tick: a session can start or end in this Lua state.
local dev_debug_kept = nil -- { d, dd } while a session holds them off

function debug_gate_tick()
	local on = session_on()
	if on and not dev_debug_kept then
		dev_debug_kept = { d = rawget(_G, "DEV_DEBUG"), dd = rawget(_G, "DEV_DEBUG_DEV") }
		if dev_debug_kept.d or dev_debug_kept.dd then
			_G.DEV_DEBUG = false
			_G.DEV_DEBUG_DEV = false
			log("debug mode (-dbg) is off while a co-op session is on; the server decides debugging (F7)")
		end
	elseif not on and dev_debug_kept then
		local kept = dev_debug_kept
		dev_debug_kept = nil
		if kept.d or kept.dd then
			_G.DEV_DEBUG = kept.d
			_G.DEV_DEBUG_DEV = kept.dd
			log("the co-op session is over: debug mode is back as it was")
		end
	end
end

-- Smart terrains: the online binder runs the server object's update every tick (jobs, respawn ->
-- SIMBOARD:create_squad). That is world simulation, the host's job: on a client alife():create is refused
-- (nil) and the stock sim_board.create_squad indexes the result -> FATAL in a binder update. Binders are
-- object classes, not callbacks, so the domain filter does not cover them.
-- F3a (docs\SPLIT_LEVELS.md section 4): a map server runs the jobs of its level's smarts, the NPCs there are its own; who respawns
-- where stays the world server's: its offline world creates the squads, and they come over through the transfers.
local function leads_level()
	return api ~= nil and api.is_client() and api.is_mirror ~= nil and not api.is_mirror()
end

local function patch_smart_terrain_binder()
	local m = bind_smart_terrain
	local cls = m and m.smart_terrain_binder
	if not (cls and type(cls.update) == "function") then return end
	local orig = cls.update
	cls.update = function(self, delta)
		if api and api.is_client() and not leads_level() then
			object_binder.update(self, delta)
			return
		end
		return orig(self, delta)
	end
	local se = smart_terrain and smart_terrain.se_smart_terrain
	if se and type(se.try_respawn) == "function" then
		local orig_respawn = se.try_respawn
		se.try_respawn = function(self, ...)
			if leads_level() then return end
			return orig_respawn(self, ...)
		end
	end
	log("smart terrain binder: the world update (jobs, respawn) runs on the host only")
end

local function install_client_patches()
	if client_patched then return end
	client_patched = true
	local ok_st, err_st = pcall(patch_smart_terrain_binder)
	if not ok_st then report_error("coop_main", "smart terrain patch", err_st) end
	local ok_cb, err_cb = pcall(function() return coop_client_binders.install() end) if not ok_cb then report_error("coop_main", "client binders patch", err_cb) end -- W10: the other object binders
	local ok, err = pcall(patch_env_classes_for_client)
	if not ok then report_error("coop_main", "emission patch", err) end
	ok, err = pcall(patch_main_menu)
	if not ok then report_error("coop_main", "main menu patch", err) end
	ok, err = pcall(stub_blocked_functions)
	if not ok then report_error("coop_main", "debug tools patch", err) end
end

-------------------------------------------------------------------------------
-- Update
-------------------------------------------------------------------------------
-- The launcher's error reports read the last of these lines from the log: no nicks, no ids of players, no addresses.
local CONTEXT_MS = 60000
local CONTEXT_QUESTS = 8
local context_next, context_last = 0, nil

function context_line(t)
	local quests = {}
	for i = 1, math.min(CONTEXT_QUESTS, #t.quests) do quests[i] = t.quests[i] end
	return string_format("[coop] context: role=%s level=%s players=%d split=%d protocol=%d quests=%s", tostring(t.role), tostring(t.level),
		tonumber(t.players) or 0, t.split and 1 or 0, tonumber(t.protocol) or 0, table.concat(quests, ","))
end

local function context_now()
	local list = {}
	local ms = map_server()
	if not ms then -- a map server has a copy of the tasks at most
		local tm = rawget(_G, "task_manager") or task_manager
		local mgr = tm and tm.get_task_manager and tm.get_task_manager()
		if mgr and type(mgr.task_info) == "table" then
			for id in pairs(mgr.task_info) do list[#list + 1] = tostring(id) end
			table.sort(list)
		end
	end
	local l = api.levels
	return { role = ms and "mapserver" or api.is_host() and "host" or "client", level = level.name(), players = #(api.players() or {}),
		split = l ~= nil and l.split ~= nil and l.split() == true, protocol = api.protocol and api.protocol() or 0, quests = list }
end

local function context_tick(tg)
	if tg < context_next or not api.is_active() then return end
	context_next = tg + CONTEXT_MS
	local ok, t = pcall(context_now)
	if not ok then return end
	local line = context_line(t)
	if line ~= context_last then
		context_last = line
		printf("%s", line)
	end
end

local next_tick = 0

local function actor_on_update()
	if not api then return end
	client_mode = api.is_client()
	local tg = time_global()
	context_tick(tg)
	if tg < next_tick then return end
	next_tick = tg + 250
	debug_gate_tick()
	if api.is_host() then
		if not host_hooks then install_host_hooks() end
		host_env_tick()
	elseif api.is_client() and api.is_live() then
		if not client_patched then install_client_patches() end
		if not env_cl.have and tg >= env_cl.req_at then
			env_cl.req_at = tg + 15000
			api.send_event("coop_env_req", "", 0)
		end
		client_env_tick()
		if not map_server() and (env_cl.s or env_cl.p) and tg >= env_cl.cover_at then
			env_cl.cover_at = tg + 1000
			local ok, c = pcall(own_cover)
			api.send_event("coop_env_cover", encode({ c = ok and c == true }), 0)
		end
	end
end

-------------------------------------------------------------------------------
-- Diagnostics (coop_status)
-------------------------------------------------------------------------------
STATUS_MODULES = {
	"coop_route",
	"coop_core_chat", "coop_core_hud", "coop_core_player", "coop_core_world",
	"coop_world_weather", "coop_world_fx", "coop_world_fight", "coop_world_compat",
	"coop_economy_core",
	"coop_npc_logic", "coop_npc_effects", "coop_npc_meet", "coop_npc_companions", "coop_npc_disguise",
	"coop_npc_world", "coop_npc_compat",
	"coop_tasks",
	"coop_loot_claim",
	"coop_mods_core",
}

function print_status()
	local role = not api and "no engine API" or api.is_host() and "host" or api.is_client() and "client" or "off"
	-- the callback router's counters are the engine's ([coop] routes lines), the shim's own line is coop_route's
	log("role %s, client mode %s | caught lua errors %d, events in %d (%d handler errors), chat %d",
		role, tostring(client_mode), stats.errors, stats.events_in, stats.event_errors, stats.chat)
	if api and api.is_host() then
		log("emission sync: phase '%s', emission #%d", tostring(env_host.sig), env_host.serial)
	elseif env_cl.have then
		log("emission mirror: emission %s (%.0f game s), psi-storm %s (%.0f game s), cover %s, last state %d ms ago, errors %d",
			tostring(env_cl.s), env_cl.sg, tostring(env_cl.p), env_cl.pg, tostring(env_cl.cover),
			time_global() - env_cl.at, env_cl.mirror_errors)
	end
	-- every group's own lines (W5): core, economy (all its modules), npc, quests (coop_tasks -> coop_quests_*),
	-- mods (all families). coop_settings is printed by the engine itself.
	for _, name in ipairs(STATUS_MODULES) do
		local m = rawget(_G, name)
		if m and m.print_status then
			local ok, err = pcall(m.print_status)
			if not ok then log("! %s.print_status: %s", name, tostring(err)) end
		end
	end
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
function on_game_start()
	if not api then return end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_before_save_input", on_before_save_input)
	RegisterScriptCallback("on_before_load_input", on_before_load_input)
	if client_mode then install_client_patches() end
	-- every machine: the stubs check the session when they are called (single player keeps the stock tools)
	local ok, err = pcall(stub_blocked_functions)
	if not ok then report_error("coop_main", "debug tools patch", err) end
end

-- Loaded by axr_main.on_game_start() before any script's on_game_start runs, so the router shim sees
-- (almost) every registration; earlier ones it routes in place. The Lua state is recreated for every
-- loaded world, and on a client that happens while the engine is in the "loading the host's world" phase.

-- Created at load time (like dxml_core does) so addons can register in their own on_game_start.
ensure_callback("coop_on_event")
ensure_callback("coop_on_chat")
-- Fired by the engine (W5), subscribed by coop_npc_effects / coop_mods_core:
--   coop_actor_revived(reviver_peer, medkit_section)   revived player's machine (C1.6)
--   coop_on_container_opened(peer, container_id)       host, a client opened a box or a corpse (C1.8)
--   coop_avatar_step(avatar_id, material, power, move_state)   any machine, a player's proxy stepped (C2.2)
ensure_callback("coop_actor_revived")
ensure_callback("coop_on_container_opened")
ensure_callback("coop_avatar_step")
ensure_callback("coop_respawned") -- coop_death adds it at its own start: a subscriber that starts earlier would be lost
-- Fired by the engine (parity audit D10) when a queue of events dropped some on this machine: coop_events_lost(count).
-- Events are for effects, state goes over coop.sync; a script with a resync of its own asks for it here (coop_tasks).
ensure_callback("coop_events_lost")
-- Fired by the engine (xrCoop/coop_soft_move.h) on who stays in his world through the host's move, a player or a map server: the world
-- server is away, the world server is back. On the world server: _back, its new Lua is up and its connections open again.
ensure_callback("coop_world_away")
ensure_callback("coop_world_back")
-- Fired by the engine (coop::debug, docs\DEBUG_DESIGN.md B.2) on every machine when the server's debug state changes:
-- coop_debug_changed(on, source). Subscribers: coop_debug_server (marks the world), the F7 window.
ensure_callback("coop_debug_changed")

-- The callback router's Lua half on every machine with the engine API, the host and single player too: a session
-- can start in this Lua state, and none holds on the host as well (F2 T10).
if api then
	local ok, err = pcall(function() return coop_route.install() end)
	if not ok then log("! callback router shim failed to install: %s", tostring(err)) end
end

if api and api.is_client() then
	client_mode = true
end
-- Debug mode is a cheat menu in Anomaly (spawner, teleports): off in a session on every machine, the host's too (R-6.6,
-- DEBUG_DESIGN B.8). Now, before the stock scripts' on_game_start reads it, and on every update after.
debug_gate_tick()
