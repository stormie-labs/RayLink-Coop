-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - the event bus of the Lua layer (gamedata\scripts\coop_main.script)

	Engine API (namespace `coop`, nil on an exe without co-op):
		coop.is_active() coop.is_live() coop.self_id()
		coop.players()            -> { {id, nick, avatar_id (local id or nil), rtt, is_self}, ... }
		coop.avatar_of(peer)      -> local object id of that player's character, or nil
		coop.peer_of_avatar(id)   -> peer id, or nil
		coop.owners_known()       -> true once avatar_id is known for every player in the world (a client: after
		                             the host's first owners table since it joined)
		coop.to_host_id(id) coop.to_local_id(id)
		coop.send_event(name, payload, target) -> true | false, reason   (target: -1/nil all, 0 host, N peer)
		coop.send_chat(text)

	Called by the engine:
		coop_main.on_event(name, payload, from)   a Msg::ScriptEvent arrived
		coop_main.on_chat(nick, text, from)       a chat line (ours included) -> coop_core_chat
		coop_main.on_world_leaving(epoch)         a client: the load that starts now continues this world
		coop_main.print_status()                  part of the coop_status console command

	For addons:
		coop_main.add_event_handler(name, func)  -- func(payload, from, name)
		coop_main.add_level_handler(name, func)  -- func(payload, from): a request to the logic of the player's map
		coop_main.remove_event_handler(name, func)
		coop_main.encode(flat_table) / coop_main.decode(string)   -- safe flat key/value payloads
		coop_main.callback_registered(name, f)   -- is f registered for that callback (itself or its router wrapper)
		coop_main.report_error(script, what, err) -- a Lua error caught on behalf of `script`, counted in coop_status
		RegisterScriptCallback("coop_on_event", func(name, payload, from))
		RegisterScriptCallback("coop_on_chat", func(nick, text, from))

	Callback routes (docs\MOD_LAYER.md 2.2), on every machine with the engine API: this script installs the router
	(scripts\coop_route.script) when it loads. Every function registered through RegisterScriptCallback, AddUniqueCall or
	CreateTimeEvent gets its domain from the engine (coop.route, configs\coop_route*.ltx), by its callback and its script.

	Restrictions, in a session on every machine: the stock debug tools never run and debug mode (-dbg) is off. A process
	whose world is decided elsewhere also gets the binder patches of coop_client_binders. Saving and loading by hand are
	refused by coop_saves alone (one gate, one hint).

	The launcher's error reports read the context line this script writes to the log once a minute.

	The emission and the psi storm are coop_env's; the script events only the world sends, coop_world_events'.
--]]

local api = rawget(_G, "coop") -- engine namespace

local route = coop_route -- the callback router, loaded with this script

local log = coop_util.logger("[coop-lua]")

local string_format = string.format
local tostring, tonumber, type, pairs, ipairs, pcall = tostring, tonumber, type, pairs, ipairs, pcall

-------------------------------------------------------------------------------
-- Errors and counters
-------------------------------------------------------------------------------
local stats = {
	errors = 0, -- Lua errors caught on behalf of a script: event handlers, chat, patches
	events_in = 0,
	event_errors = 0,
	chat = 0,
}

-- script name -> Lua errors caught (the log says the first three, then every 100th)
local seen = {}

function report_error(script, what, err)
	local n = (seen[script] or 0) + 1
	seen[script] = n
	stats.errors = stats.errors + 1
	if n <= 3 or n % 100 == 0 then
		log("! lua error in %s (%s), #%d, the session continues: %s", tostring(script), tostring(what), n, tostring(err))
	end
end

local function try(what, f)
	local ok, err = pcall(f)
	if not ok then report_error("coop_main", what, err) end
end

-------------------------------------------------------------------------------
-- Codec
-------------------------------------------------------------------------------
local function esc(s)
	return (tostring(s):gsub("[%%;=]", function(c) return string_format("%%%02X", c:byte()) end))
end

local function unesc(s)
	return (s:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end))
end

-- Flat table of string/number/boolean values -> "k=v;k=v". No code, no nesting: safe for network input.
function encode(t)
	local keys = {}
	for k in pairs(t) do keys[#keys + 1] = tostring(k) end
	table.sort(keys)
	local out = {}
	for i = 1, #keys do
		local k = keys[i]
		local v = t[k]
		local tv = type(v)
		local s
		if tv == "number" then
			s = "n" .. tostring(v)
		elseif tv == "boolean" then
			s = v and "b1" or "b0"
		else
			s = "s" .. tostring(v)
		end
		out[#out + 1] = esc(k) .. "=" .. esc(s)
	end
	return table.concat(out, ";")
end

function decode(str)
	local t = {}
	if type(str) ~= "string" then return t end
	for pair in str:gmatch("[^;]+") do
		local k, v = pair:match("^([^=]*)=(.*)$")
		if k and v then
			k, v = unesc(k), unesc(v)
			local tag, body = v:sub(1, 1), v:sub(2)
			if tag == "n" then
				t[k] = tonumber(body)
			elseif tag == "b" then
				t[k] = (body == "1")
			else
				t[k] = body
			end
		end
	end
	return t
end

-------------------------------------------------------------------------------
-- Messages on screen
-------------------------------------------------------------------------------
local function hud_msg(text)
	local am = rawget(_G, "actor_menu")
	local shown = false
	if am and am.set_msg then
		shown = pcall(am.set_msg, 1, text, 4)
	end
	log("%s", text)
	return shown
end

-------------------------------------------------------------------------------
-- Script events
-------------------------------------------------------------------------------
local handlers = {} -- name -> { [func] = true }

function add_event_handler(name, func)
	if type(name) ~= "string" or type(func) ~= "function" then return false end
	handlers[name] = handlers[name] or {}
	handlers[name][func] = true
	return true
end

-- A request to the logic of the player's map. The handler gets the original two arguments (payload, from), not the
-- facade's third one.
function add_level_handler(name, func)
	if type(func) ~= "function" then return false end
	local function run(payload, from)
		return func(payload, from)
	end
	if coop_mode then return coop_mode.on_level_request(name, run) end
	-- Standalone addons and test harnesses can use the event bus without the mode facade.
	return add_event_handler(name, run)
end

function remove_event_handler(name, func)
	if handlers[name] then handlers[name][func] = nil end
end

-- Is f registered for the callback `name` (itself, or the router's wrapper of it)? nil = unknown.
function callback_registered(name, f)
	local t = route.intercepts()
	if type(t) ~= "table" or type(t[name]) ~= "table" or f == nil then return nil end
	if t[name][f] then return true end
	local w = route.wrapper_of(name, f)
	return w ~= nil and t[name][w] ~= nil
end

local function callback_exists(name)
	local t = route.intercepts()
	return t ~= nil and t[name] ~= nil
end

-- Engine entry: a Msg::ScriptEvent for this machine. `from` is the sender's peer id (0 = host). The transport calls this
-- with the original peer, before any relay changes the origin to zero.
function on_event(name, payload, from)
	stats.events_in = stats.events_in + 1
	if not coop_world_events.allows(name, from) then return end
	local hs = handlers[name]
	if hs then
		for f in pairs(hs) do
			local ok, err = pcall(f, payload, from, name)
			if not ok then
				stats.event_errors = stats.event_errors + 1
				report_error(route.script_of(f), "event " .. tostring(name), err)
			end
		end
	end
	if callback_exists("coop_on_event") then
		local ok, err = pcall(SendScriptCallback, "coop_on_event", name, payload, from)
		if not ok then report_error("coop_on_event", tostring(name), err) end
	end
end

-- Engine entry: a chat line, ours included. Shown in the chat (coop_core_chat: window, HUD feed, history); a PDA news line
-- if that script is missing.
-- `from`: the sender's peer id (0 = the host or the world server); nil from an engine that does not name it.
function on_chat(nick, text, from)
	stats.chat = stats.chat + 1
	nick, text = tostring(nick), tostring(text)
	if type(from) ~= "number" then from = nil end
	local shown = false
	local chat = rawget(_G, "coop_core_chat")
	if chat and chat.on_line then
		local ok, r = pcall(chat.on_line, nick, text, from)
		if ok then
			shown = r == true
		else
			report_error("coop_core_chat", "chat line", r)
		end
	end
	local actor = db and db.actor
	if actor and not shown then
		shown = pcall(function()
			actor:give_game_news("Co-op: " .. nick, text, "ui_iconsTotal_grouping", 0, 7000)
		end)
		local snd = rawget(_G, "xr_sound")
		if shown and snd and snd.set_sound_play then
			pcall(snd.set_sound_play, AC_ID, "pda_tips")
		end
	end
	if not shown then log("<%s> %s", nick, text) end
	if callback_exists("coop_on_chat") then
		pcall(SendScriptCallback, "coop_on_chat", nick, text, from)
	end
end

-- Engine entry (a client, coop_join.cpp world_leaving): the load that starts now continues this world (a transition's
-- save), and the old world is still up. What a script carries per player goes with him as it is this moment, the way a
-- single player's save has it at a level change: whoever keeps such state hears coop_on_world_leaving(epoch of the world
-- that comes) and may bring its keys up to date, then coop_mods_pdata keeps the registered keys for this load.
function on_world_leaving(epoch)
	if callback_exists("coop_on_world_leaving") then
		local ok, err = pcall(SendScriptCallback, "coop_on_world_leaving", epoch)
		if not ok then report_error("coop_on_world_leaving", tostring(epoch), err) end
	end
	local pd = rawget(_G, "coop_mods_pdata")
	if pd and pd.keep_for_load then
		local ok, err = pcall(pd.keep_for_load, epoch)
		if not ok then report_error("coop_mods_pdata", "keep for the load", err) end
	end
end

-------------------------------------------------------------------------------
-- Restrictions: the stock debug tools, the binders of a process whose world is decided elsewhere. Saving and loading by
-- hand are refused by coop_saves alone, on every machine: a second gate here would show the player a second hint for the
-- same key.
-------------------------------------------------------------------------------
local client_patched = false

-- [route_none_functions] of configs\coop_route*.ltx, read by the engine.
local function none_functions()
	local r = api and api.route
	if not (r and type(r.none_functions) == "function") then return {} end
	local ok, list = pcall(r.none_functions)
	return ok and type(list) == "table" and list or {}
end

-- In any session, the host's too, the stock debug tools never run: every debug action goes through the server (F7 is
-- the co-op window, coop_debug_ui; docs\DEBUG_DESIGN.md B.8). Outside a session the stock function runs. Installed once
-- per Lua state.
local stubs_installed = false
local function stub_blocked_functions()
	if stubs_installed then return end
	stubs_installed = true
	local n = 0
	for _, full in ipairs(none_functions()) do
		local modname, fname = full:match("^([%w_]+)%.([%w_]+)$")
		if modname then
			local ok, mod = pcall(function() return _G[modname] end)
			if ok and type(mod) == "table" and type(mod[fname]) == "function" then
				local orig = mod[fname]
				mod[fname] = function(...)
					if coop_util.active() then
						hud_msg("Co-op: in a session the debug window is F7, the server carries out its actions")
						return
					end
					return orig(...)
				end
				n = n + 1
			end
		end
	end
	if n > 0 then log("%d stock debug tool entry point(s) disabled while a session is on", n) end
end

-- While a session is on, DEV_DEBUG and DEV_DEBUG_DEV are off on every machine, the host's too (docs\DEBUG_DESIGN.md B.8):
-- under them stock code acts locally (fast travel to any mark, debug map marks, debug_mode_flag_on). The values before the
-- session come back when it ends. Checked at load and on every update tick: a session can start or end in this Lua state.
local dev_debug_kept = nil -- { d, dd } while a session holds them off

local function debug_gate_tick()
	local on = coop_util.active()
	if on and not dev_debug_kept then
		dev_debug_kept = { d = rawget(_G, "DEV_DEBUG"), dd = rawget(_G, "DEV_DEBUG_DEV") }
		if dev_debug_kept.d or dev_debug_kept.dd then
			_G.DEV_DEBUG = false
			_G.DEV_DEBUG_DEV = false
			log("debug mode (-dbg) is off while a co-op session is on; the server decides debugging (F7)")
		end
	elseif not on and dev_debug_kept then
		local kept = dev_debug_kept
		dev_debug_kept = nil
		if kept.d or kept.dd then
			_G.DEV_DEBUG = kept.d
			_G.DEV_DEBUG_DEV = kept.dd
			log("the co-op session is over: debug mode is back as it was")
		end
	end
end

-- For a process whose world another process decides (coop_util.follows_world).
local function install_client_patches()
	if client_patched then return end
	client_patched = true
	try("client binders patch", function() return coop_client_binders.install() end)
	try("debug tools patch", stub_blocked_functions)
end

-------------------------------------------------------------------------------
-- Context line
-------------------------------------------------------------------------------
-- The launcher's error reports read the last of these lines from the log: no nicks, no ids of players, no addresses.
local CONTEXT_MS = 60000
local CONTEXT_QUESTS = 8
local context_next, context_last = 0, nil

function context_line(t)
	local quests = {}
	for i = 1, math.min(CONTEXT_QUESTS, #t.quests) do quests[i] = t.quests[i] end
	return string_format("[coop] context: role=%s level=%s players=%d split=%d protocol=%d quests=%s", tostring(t.role), tostring(t.level),
		tonumber(t.players) or 0, t.split and 1 or 0, tonumber(t.protocol) or 0, table.concat(quests, ","))
end

local function context_now()
	local answer = coop_mode.hook("context")
	local mode_context = answer and answer()
	local role = mode_context and mode_context.role or (coop_mode.decides_world() and "host" or "client")
	local list = {}
	if not coop_mode.leads_for_world_elsewhere() then -- the map only has copies
		local tm = rawget(_G, "task_manager") or task_manager
		local mgr = tm and tm.get_task_manager and tm.get_task_manager()
		if mgr and type(mgr.task_info) == "table" then
			for id in pairs(mgr.task_info) do list[#list + 1] = tostring(id) end
			table.sort(list)
		end
	end
	return { role = role, level = level.name(), players = #coop_util.players(), split = mode_context and mode_context.split,
		protocol = api.protocol and api.protocol() or 0, quests = list }
end

local function context_tick(tg)
	if tg < context_next or not api.is_active() then return end
	context_next = tg + CONTEXT_MS
	local ok, t = pcall(context_now)
	if not ok then return end
	local line = context_line(t)
	if line ~= context_last then
		context_last = line
		printf("%s", line)
	end
end

-------------------------------------------------------------------------------
-- Update
-------------------------------------------------------------------------------
local next_tick = 0

local function actor_on_update()
	local tg = time_global()
	context_tick(tg)
	if tg < next_tick then return end
	next_tick = tg + 250
	debug_gate_tick()
	-- All scripts have registered their answers by the first live tick.
	if not client_patched and coop_util.follows_world() and api.is_live() then install_client_patches() end
end

-------------------------------------------------------------------------------
-- Diagnostics (coop_status)
-------------------------------------------------------------------------------
-- This script's line, then the lines of every module that registered itself (coop_util.add_status), each at the place it
-- named. coop_settings is printed by the engine itself.
function print_status()
	local decides = api ~= nil and api.is_active() and coop_mode.decides_world()
	local role = not api and "no engine API" or decides and "host" or api.is_active() and "client" or "off"
	-- the callback router's counters are the engine's ([coop] routes lines), the router's own line is coop_route's
	log("role %s, client mode %s | caught lua errors %d, events in %d (%d handler errors), chat %d",
		role, tostring(role == "client"), stats.errors, stats.events_in, stats.event_errors, stats.chat)
	coop_util.print_statuses(log)
end

-------------------------------------------------------------------------------
-- Start
-------------------------------------------------------------------------------
function on_game_start()
	if not api then return end
	RegisterScriptCallback("actor_on_update", actor_on_update)
	-- Now, before the level's objects exist: a binder must find its patch at its first update. A world server asked here in
	-- its session, before its layer is in the facade, gets them too (coop_util.follows_world): each asks again when called.
	if coop_util.follows_world() then install_client_patches() end
	-- every machine: the stubs check the session when they are called (single player keeps the stock tools)
	try("debug tools patch", stub_blocked_functions)
end

-- Loaded by axr_main.on_game_start() before any script's on_game_start runs, so the router sees (almost) every
-- registration; earlier ones it routes in place. The Lua state is recreated for every loaded world, and on a client that
-- happens while the engine is in the "loading the host's world" phase.

-- The callbacks exist on any exe, one without co-op too: a script that registers for one of them must find it there.
-- Created at load time (like dxml_core does) so addons can register in their own on_game_start.
route.declare("coop_on_event")
route.declare("coop_on_chat")
-- Fired by the engine, subscribed by coop_npc_effects / coop_mods_core:
--   coop_actor_revived(reviver_peer, medkit_section)   revived player's machine
--   coop_on_container_opened(peer, container_id)       host, a client opened a box or a corpse
--   coop_avatar_step(avatar_id, material, power, move_state)   any machine, a player's proxy stepped
route.declare("coop_actor_revived")
route.declare("coop_on_container_opened")
route.declare("coop_avatar_step")
route.declare("coop_respawned") -- coop_death adds it at its own start: a subscriber that starts earlier would be lost
-- Fired by the engine when a queue of events dropped some on this machine: coop_events_lost(count). Events are for
-- effects, state goes over coop.sync; a script with a resync of its own asks for it here (coop_tasks).
route.declare("coop_events_lost")
-- Fired by the engine (xrCoop/coop_soft_move.h) on who stays in his world through the host's move, a player or a map
-- server: the world server is away, the world server is back. On the world server: _back, its new Lua is up and its
-- connections open again. Fired by on_world_leaving on a client when a load that continues this world starts: (epoch).
route.declare("coop_on_world_leaving")
route.declare("coop_world_away")
route.declare("coop_world_back")
-- Fired by the engine (coop::debug, docs\DEBUG_DESIGN.md B.2) on every machine when the server's debug state changes:
-- coop_debug_changed(on, source). Subscribers: coop_debug_server (marks the world), the F7 window.
route.declare("coop_debug_changed")

if api then
	-- The callback router's Lua half on every machine with the engine API, the host and single player too: a session can
	-- start in this Lua state, and none holds on the host as well. Protected: this script must load whatever the router
	-- does.
	local ok, err = pcall(route.install)
	if not ok then log("! callback router shim failed to install: %s", tostring(err)) end

	-- Debug mode is a cheat menu in Anomaly (spawner, teleports): off in a session on every machine, the host's too. Now,
	-- before the stock scripts' on_game_start reads it, and on every update after.
	debug_gate_tick()
end
