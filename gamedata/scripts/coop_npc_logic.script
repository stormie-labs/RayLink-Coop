--[[
	Anomaly Coop - NPC group: xr_logic for several players (restrictors, actor conditions, actor effects).

	Stock xr_logic reacts to ONE actor. In a session:
	Host (runs the world logic):
	  - Switch conditions that name the actor (on_actor_dist_le/ge[_nvis], on_actor_in_zone/not_in_zone,
	    on_actor_inside/outside) are evaluated against every player: the host's actor and the clients' proxies.
	    This applies to restrictors, NPCs, monsters and physic objects alike (a local restrictor excepted).
	  - xr_conditions dist_to_actor_le/ge, actor_see_npc, actor_near_smart, actor_in_zone, actor_out_zone
	    answer for the nearest / any player when asked about the host's actor.
	  - A restrictor whose condlists change more than this machine (infos, spawns, any effect except the
	    UI/tutorial ones) is "replicated": the host is the only one that switches it and broadcasts every
	    section change (npc.logic). One whose effects never leave the machine (tutorial hints, UI) is "local"
	    and runs vanilla on every machine for its own player.
	  - Effects that act on "the actor" (disable_ui, kill_actor, teleport_actor, run_tutorial, ...) fired
	    by a replicated restrictor's condlist go to its audience: the players that walked in (or stood within
	    the trigger distance), plus, for scenes (an arrival that disables the UI or teleports), everybody
	    within [coop_npc] scene_radius of them. The host runs the effect only if its own player is in the
	    audience; the others get it as npc.fx and run it on their own actor. enable_ui/enable_imput also
	    clean up a host player's local scheme locks. A routed stop_tutorial may stop only its own local sequence.
	  - A companion with a leader (coop_npc_companions.follows) switches for him: try_switch runs under his identity, the infos of its
	    condlists stay the world's (pick_for_leader), dist_to_actor_* under an identity reads that player.
	  - A physics object (ph_idle, ph_button: lifts, valves, switches) remembers who used it (generic_physics_binder
	    use_callback): its actor effects, the delayed sections of on_timer / on_game_timer included, go to that player, and
	    a logic that teleports takes the players within scene_radius of him along. Nobody used it: stock, the host's.
	  - A use whose window is the player's own never opens it on the host: a code pad (ph_code) and an AWR vise go back to
	    the client who pressed. The code he types comes to the host, which checks the reach and runs OnNumberReceive.
	Client:
	  - Never evaluates a replicated restrictor (no switch, no condlist, no on_value of sr_timer): it takes
	    the host's section (npc.logic), so the section schemes (no-weapon zones, psy antenna, postprocess,
	    cutscenes) run for this client's own player. It asks for every section once it is live
	    (npc.logic_req -> npc.logic_all).
	  - Crow spawner and fake-monster restrictor schemes never run on a client (they create world objects,
	    which a client would forward to the host as duplicates).
	Both: logic heal (sessions only) - a join save written before an object's first logic update keeps its
	loaded logic state instead of writing a blank one, and a loaded "nil" section that no condlist can
	produce is re-derived.

	Events (ids in host numbering):
	  npc.logic      host -> all     { i = object, s = section | "nil" }
	  npc.logic_req  client -> host  { } (all sections) | { i = object }
	  npc.logic_all  host -> client  { n, i1, s1, i2, s2, ... } (chunks of <= 150)
	  npc.fx         host -> one     { i = object | -1, f = effect name, a = args "p1:p2" }  (actor effects)
	  npc.pad        host -> one     { i = pad }  (open the numpad)
	  npc.pad_code   client -> host  { i = pad, t = digits }
	  npc.vise       host -> one     { i = vise }  (open the workshop)
	API: deliver(name, npc, p), audience_of(npc), is_replicated(id), register_actor_effect(name, always), user_of(npc),
	press_spares_host(npc), relay_to_all(name, args, except_peer), add_audience_rule(rule) (rule(npc, st) -> audience or nil:
	coop_arena gives the arena trigger's effects to its fighter alone)
	Stock functions wrapped: xr_logic.try_switch_to_another_section, determine_section_to_activate,
	initialize_obj, switch_to_section, pick_section_from_condlist, save_obj; sr_timer.action_timer.update;
	sr_crow_spawner.crowkiller.update; sr_monster.fake_monster.update; xr_conditions.dist_to_actor_le,
	dist_to_actor_ge, dist_to_task_target_anomaly_le, actor_see_npc, actor_near_smart, actor_in_zone, actor_out_zone, actor_inside_zone,
	has_active_tutorial; xr_effects.<actor effects>; bind_physic_object.generic_physics_binder.use_callback;
	ph_code.codepad.use_callback.

	A cutscene's participants are taken before activation. npc.logic carries the run, roster and optional stop signal
	on switches and re-issues. Only an invited machine runs the camera and reports completion (mods.npc_scene_end). The
	actor of local scheme transitions is kept for story|actor remarks. The owner's NPC use and remote USE
	(mods.npc_abuse_use) both judge irritation on the map that runs the NPC; the punch lands as coop_quests_punch says.
--]]

local tostring, tonumber, type, pairs, ipairs, pcall, next = tostring, tonumber, type, pairs, ipairs, pcall, next
local string_format, table_concat = string.format, table.concat

local TAG = "logic"
local P -- coop_npc_players

local function log(fmt, ...) P.log(TAG, fmt, ...) end
local function report(what, err) P.report(TAG, what, err) end

local EV_SECTION, EV_REQ, EV_ALL, EV_FX = "npc.logic", "npc.logic_req", "npc.logic_all", "npc.fx"
local EV_PAD, EV_PAD_CODE, EV_VISE = "npc.pad", "npc.pad_code", "npc.vise"
local SCENE_END, ABUSE_USE = "npc_scene_end", "npc_abuse_use" -- mods.*
local CUT_TIMEOUT = 300000 -- allow the long multi-camera scenes to finish before releasing a missing participant
local USE_REACH_SQR = 36 -- 6 m between bodies, as for the talk lock
local USE_RAY_M = 2
local MAX_OBJECT_ID, MAX_SCENE_RUN = 65534, 2147483647
local MAX_SCENE_AUDIENCE = 16
local cut_run = 0
local transition_user, meet_user
local CHUNK = 150
local PENDING_TTL = 120000
local KILL_RELAY_MS = 500
local PAD_MAX_TEXT = 13 -- ui_numpad.UINumpad:AddNumber stops there
local LIFT_BLACK = 3009 -- id of the black effector of pri_b306_ph_button.ltx and lx8_lift_button.ltx

-- Condition names are the original xr_logic.try_switch_to_another_section LTX contract.
-- Switch conditions that name the actor; the first four can be an arrival (a player comes in).
local ACTOR_CONDS = {
	on_actor_dist_le = true, on_actor_dist_le_nvis = true, on_actor_dist_ge = true, on_actor_dist_ge_nvis = true,
	on_actor_in_zone = true, on_actor_not_in_zone = true, on_actor_inside = true, on_actor_outside = true,
}
local ARRIVAL_CONDS = {
	on_actor_dist_le = true, on_actor_dist_le_nvis = true, on_actor_in_zone = true, on_actor_inside = true,
}
-- Effects that only touch the machine they run on (its UI or tutorial): a restrictor with nothing else is local.
local MACHINE_EFFECTS = {
	run_tutorial = true, stop_tutorial = true, disable_ui = true, disable_ui_only = true, enable_ui = true,
}
-- Effects that take a player out of play: an arrival that fires one is a scene.
local GATHERS = { disable_ui = true, disable_ui_only = true, teleport_actor = true }
-- Effects on db.actor: true = audience only, "always" = also on the host whatever the audience.
-- sr_teleport (ui_sr_teleport: the route / level-exit restrictors of sr_teleport_sections.ltx, cfg sr_teleport_logic.ltx,
-- on_actor_inside = %=sr_teleport%) moves db.actor 3 s later: for the player who walked in only. Left out, it would run on
-- the host for ANY player's arrival and put the host's character at the exit's drop point. It is no scene (GATHERS): the
-- others stay where they are and walk up.
-- The Bar arena's effects (bar_arena_teleport, _2, bar_arena_weapon_slot) are not here: they are one fighter's, coop_arena
-- routes them; its audience rule gives the trigger's disable_ui / enable_ui to him alone.
local ACTOR_FX = {
	disable_ui = true, disable_ui_only = true, run_tutorial = true, kill_actor = true, hit_actor = true,
	save_actor_position = true, restore_actor_position = true, teleport_actor = true, sr_teleport = true,
	jup_teleport_actor = true,
	enable_ui = "always", enable_imput = "always", stop_tutorial = true,
}
local TUTORIAL_FX = { run_tutorial = true, stop_tutorial = true }
-- Effects on this player's own UI: never on a server (its actor is a ghost). The ones that start something also wait for
-- a ready HUD; an unlock never waits: the lock it ends may have come while the HUD was ready.
local UI_FX = {
	run_tutorial = true, stop_tutorial = true, disable_ui = true, disable_ui_only = true, enable_ui = true,
	enable_imput = true,
}
local UNLOCK_FX = { enable_ui = true, enable_imput = true }
-- The host sees a moved player late and repeats the effect: on a client it counts only while he still stands in this zone.
local FX_ZONES = { jup_teleport_actor = "jup_b16_teleport" }
-- A kill that spares whoever holds the item (judged on each player's machine).
local KILL_GATES = { x16_timer_restrictor = "good_psy_helmet" }

local STYPE_RESTRICTOR = 4
local installed = false
local applying = false -- client: applying a host section
local leading = false -- host: a companion's logic is switching under its leader's identity
local replaying = false -- client: running a relayed effect
local routed_tutorial -- the local sequence started by a specific restrictor or switch
local ctx = {} -- host: stack of replicated restrictors whose condlist is being evaluated

local orig = {}
local stats = { switched_team = 0, sections_out = 0, sections_in = 0, fx_out = 0, fx_in = 0, healed = 0, refused = 0 }

-------------------------------------------------------------------------------
-- Classification
-------------------------------------------------------------------------------
local function block_is_shared(bare)
	for kind, name in bare:gmatch("([=+%-!])([%w_%.]+)") do
		if kind ~= "=" or not MACHINE_EFFECTS[name] then return true end
	end
	return false
end

local function block_gathers(bare)
	for name in bare:gmatch("=([%w_%.]+)") do
		if GATHERS[name] then return true end
	end
	return false
end

-- Walks every line of an ini. visit(section, key, value) returns true to stop. False if the ini cannot be read.
local function each_line(ini, visit)
	local stop = false
	local function on_section(sec)
		for i = 0, ini:line_count(sec) - 1 do
			local _, key, value = ini:r_line(sec, i, "", "")
			if visit(sec, key, value) then return true end
		end
		return false
	end
	-- The engine functor must get a boolean back and must never see a Lua error.
	local ok = pcall(ini.section_for_each, ini, function(sec)
		if stop then return true end
		local okv, r = pcall(on_section, sec)
		stop = (not okv) or r == true
		return stop
	end)
	return ok
end

local function is_cutscene(section)
	return type(section) == "string" and (section == "sr_cutscene" or section:sub(1, 12) == "sr_cutscene@")
end

-- shared: some effect leaves the machine or a scheme runs a camera; positional: a switch waits for a player;
-- gathers: some effect takes the player out of play.
function scan_ini(ini)
	local shared, positional, gathers = false, false, false
	if not ini then return true, false, false end
	local ok = each_line(ini, function(section, key, value)
		if is_cutscene(section) then shared = true end
		if type(key) == "string" and ARRIVAL_CONDS[(key:gsub("%d+$", ""))] then positional = true end
		if type(value) == "string" and value:find("%", 1, true) then
			for block in value:gmatch("%%([^%%]*)%%") do
				local bare = block:gsub("%b()", "")
				if not shared and block_is_shared(bare) then shared = true end
				if not gathers and block_gathers(bare) then gathers = true end
			end
		end
		return shared and positional and gathers
	end)
	if not ok then shared = true end -- unreadable: host-authoritative
	return shared, positional, gathers
end

local function classify(st, ini)
	if st.coop_local ~= nil then return end
	local shared, positional, gathers = scan_ini(ini or st.ini)
	st.coop_local = not shared
	st.coop_positional = positional
	st.coop_scene = positional and gathers
end

local function id_of(npc)
	local id = npc.id
	if type(id) == "function" then return npc:id() end
	return id
end

local function storage_of(obj)
	if not obj then return nil end
	local id = obj.id
	if type(id) == "function" then id = obj:id() end
	return type(id) == "number" and db.storage[id] or nil
end

local function restrictor_st(obj)
	local st = storage_of(obj)
	if st and st.stype == STYPE_RESTRICTOR then
		if st.coop_local == nil and st.ini then classify(st) end
		return st
	end
	return nil
end

-- True when this logic's actor effects are routed here: a replicated restrictor, or a pressed physics object while the host
-- has company (coop_economy_travel then leaves its teleport to us).
function is_replicated(id)
	local st = db.storage[id]
	if st == nil then return false end
	return (st.stype == STYPE_RESTRICTOR and st.coop_local == false) or (P.host_on() and st.coop_press ~= nil)
end

local function is_local_restrictor(obj)
	local st = restrictor_st(obj)
	return st ~= nil and st.coop_local == true
end

-------------------------------------------------------------------------------
-- Audience (host)
-------------------------------------------------------------------------------
local function add_inside(zone, aud)
	for _, p in ipairs(P.everyone()) do
		if zone:inside(p:position()) then aud[p:id()] = true end
	end
end

local function add_within(pos, r2, aud)
	for _, p in ipairs(P.everyone()) do
		if p:position():distance_to_sqr(pos) <= r2 then aud[p:id()] = true end
	end
end

-- Scene: whoever stands within scene_radius of a player that walked in (of the trigger when nobody did).
local function add_nearby(from, aud)
	local r = P.setting("scene_radius", 30)
	local r2 = r > 0 and r * r or math.huge
	local centres = {}
	for id in pairs(aud) do
		local o = level.object_by_id(id)
		if o then centres[#centres + 1] = o:position() end
	end
	if #centres == 0 then centres[1] = from:position() end
	for _, p in ipairs(P.everyone()) do
		local pp = p:position()
		for _, c in ipairs(centres) do
			if pp:distance_to_sqr(c) <= r2 then
				aud[p:id()] = true
				break
			end
		end
	end
end

-- c = the arrival condition that fired: the players it matched start the audience.
local function restart_audience(npc, st, c)
	local aud = {}
	st.coop_aud = aud
	local zone = c.name == "on_actor_in_zone" and db.zone_by_name[c.v1] or nil
	st.coop_trigger_zone = zone
	if c.name == "on_actor_dist_le" or c.name == "on_actor_dist_le_nvis" then
		local d = tonumber(c.v1) or 0
		add_within(npc:position(), d * d, aud)
	else
		add_inside(zone or npc, aud)
	end
	if st.coop_scene then add_nearby(zone or npc, aud) end
end

-- Other scripts may name the audience of a restrictor themselves: rule(npc, st) -> { [player id] = true } or nil (no say).
local audience_rules = {}

function add_audience_rule(rule)
	if type(rule) == "function" then audience_rules[#audience_rules + 1] = rule end
end

local function audience(npc, st)
	for _, rule in ipairs(audience_rules) do
		local ok, aud = pcall(rule, npc, st)
		if not ok then report("audience rule", aud) elseif type(aud) == "table" then return aud end
	end
	if st.coop_arrival then
		restart_audience(npc, st, st.coop_arrival)
		st.coop_arrival = nil
	end
	local aud = st.coop_aud
	if not aud then
		aud = {}
		st.coop_aud = aud
	end
	if st.coop_scene then return aud end -- a scene keeps who its arrival gathered
	add_inside(st.coop_trigger_zone or npc, aud)
	-- Nobody inside and nobody recorded, in a restrictor no player walks into: a story trigger.
	if not st.coop_positional and next(aud) == nil then
		for _, p in ipairs(P.everyone()) do aud[p:id()] = true end
	end
	return aud
end

-- The restrictor whose condlist the host is evaluating for the group right now, or nil.
local function current(npc)
	local top = ctx[#ctx]
	if not (top and P.host_on()) then return nil end
	if npc and top.npc_id ~= (type(npc.id) == "function" and npc:id() or npc.id) then return nil end
	return top.st, top
end

-- A logic that teleports whoever uses it is a scene (the Pripyat and X-8 lifts). A valve or a switch is the presser's alone.
local function press_moves(st)
	if st.coop_press_moves == nil then
		local moves = false
		if st.ini then
			each_line(st.ini, function(_, _, value)
				moves = type(value) == "string" and value:find("=teleport_actor", 1, true) ~= nil
				return moves
			end)
		end
		st.coop_press_moves = moves
	end
	return st.coop_press_moves
end

local function press_audience(st, obj, id)
	local aud = { [id] = true }
	if press_moves(st) then add_nearby(obj, aud) end
	return aud
end

-- The players the last press of this physics object is for; nil = nobody pressed it, or the host is alone.
local function press_of(npc)
	if not P.host_on() then return nil end
	local st = storage_of(npc)
	return st and st.coop_press or nil
end

-- nil = neither a replicated restrictor's condlist nor a pressed physics object on a host with clients.
function audience_of(npc)
	local state, frame = current(npc)
	if state == nil then return press_of(npc) end
	return frame.cut_audience or audience(npc, state)
end

-- The object id of the player who used this object or triggered its scene, nil = nobody did.
function user_of(npc)
	local st = storage_of(npc)
	return st and (st.coop_user or st.coop_scene_user) or nil
end

-- True when the press belongs to other players: what it shows is not for the host's screen (coop_npc_effects).
function press_spares_host(npc)
	local aud = press_of(npc)
	return aud ~= nil and db.actor ~= nil and aud[db.actor:id()] ~= true
end

-------------------------------------------------------------------------------
-- Actor effects
-------------------------------------------------------------------------------
-- This process plays the actor's own character: a server's actor is a ghost without a player's UI.
local function own_player(actor)
	if not (actor and db.actor and coop_mode.actor_is_player()) then return false end
	local own = P.own_actor()
	return own ~= nil and own:id() == actor:id() and own:id() == db.actor:id()
end

local function local_player_ui(actor)
	if not own_player(actor) then return false end
	if game.player_hud_ready then return game.player_hud_ready() end
	if type(device) == "function" and device().precache_frame ~= 0 then return false end
	return not ActorMenu or ActorMenu.get_maingame() ~= nil
end

-- GAMMA's modxml_tutorial_hooks prints its prompts into UIStaticTutorials, a child of the main game window. A HUD rebuild
-- deletes it; coop_hud_lifecycle builds it again (the rule for every HUD window a script keeps).
-- Its stop and start functions index that window: before the mod's first update it is nil.
local function tutorial_monitor_built()
	local hooks = rawget(_G, "modxml_tutorial_hooks")
	return not hooks or hooks.UIStaticTutorials ~= nil
end

local function run_routed_tutorial(name, source, f, actor, npc, p, ready)
	if not (source and game.active_tutorial_id) then return end
	local active = game.active_tutorial_id()
	local owned = routed_tutorial and routed_tutorial.id == active and routed_tutorial or nil
	routed_tutorial = owned
	if name == "stop_tutorial" then
		if not (owned and owned.source == source) then return end
		ready = ready and tutorial_monitor_built()
		owned.stop_pending = not ready
		if not ready then return end
		f(actor, npc, p)
		if routed_tutorial == owned and game.active_tutorial_id() ~= active then routed_tutorial = nil end
		return
	end
	if owned and owned.source == source then
		owned.stop_pending = nil -- its start came after the stop it deferred: the prompt it still shows stays
		return
	end
	if not (ready and npc and p and type(p[1]) == "string" and p[1] ~= "") then return end
	if not tutorial_monitor_built() then return end
	f(actor, npc, p)
	local started = game.active_tutorial_id()
	if started ~= 0 and started ~= active then routed_tutorial = { source = source, id = started } end
end

local function args_of(p)
	if type(p) ~= "table" then return "" end
	local t = {}
	for i = 1, #p do t[i] = tostring(p[i]) end
	return table_concat(t, ":")
end

local function relay(aud, npc_id, name, args)
	local host_actor = db.actor and db.actor:id()
	for id in pairs(aud) do
		if id ~= host_actor then
			local peer = P.peer_of(id)
			if peer and P.send(EV_FX, { i = npc_id, f = name, a = args }, peer) then
				stats.fx_out = stats.fx_out + 1
			end
		end
	end
end

-- A lift drops its riders inside a level exit and stock changes the level at once, so its logic never lifts the black
-- screen and the UI lock there (the next level's button does). Here the exit's board waits for the others: nobody waits blind
-- and frozen. Stepping out of the zone later runs the stock end of the chain.
local function end_ride(npc)
	if not own_player(db.actor) then return end
	xr_effects.stop_postprocess(db.actor, npc, { LIFT_BLACK })
	xr_effects.enable_ui(db.actor, npc, {})
end

-- true = run the effect on this machine, false = skip it, nil = stock: not a replicated restrictor's condlist, no press.
function deliver(name, npc, p)
	if replaying then return true end
	if not installed or not P.active() then return nil end
	local st = restrictor_st(npc)
	if not (st and st.coop_local == false) then
		local aud = press_of(npc)
		if not aud then return nil end
		relay(aud, id_of(npc), name, args_of(p))
		if name == "teleport_actor" then end_ride(npc) end
		return aud[db.actor:id()] == true or ACTOR_FX[name] == "always", true
	end
	if P.is_client() then return true end -- a scheme's own call (sr_cutscene): this player's
	local _, frame = current(npc)
	if not frame then return true end -- scheme-internal on the host: vanilla
	local aud = frame.cut_audience or audience(npc, st)
	local mine = db.actor ~= nil and aud[db.actor:id()] == true
	if name == "kill_actor" then
		-- A gated kill fires every tick until it is done: relay at most twice a second.
		local now = time_global()
		if now >= (st.coop_kill_at or 0) then
			st.coop_kill_at = now + KILL_RELAY_MS
			relay(aud, npc:id(), name, "")
		end
		local gate = KILL_GATES[npc:name()]
		return mine and not (gate and db.actor:object(gate))
	end
	relay(aud, npc:id(), name, args_of(p))
	return mine or (not frame.cut_audience and ACTOR_FX[name] == "always"), true
end

local function wrap_effect(name)
	local f = xr_effects and xr_effects[name]
	if type(f) ~= "function" or orig["fx_" .. name] then return end
	orig["fx_" .. name] = f
	xr_effects[name] = function(actor, npc, p)
		local here, routed = deliver(name, npc, p)
		if here == false then return end
		if UI_FX[name] then
			local in_session = P.active()
			local ready
			if not in_session then
				ready = coop_mode.actor_is_player()
			elseif UNLOCK_FX[name] then
				ready = own_player(actor or db.actor)
			else
				ready = local_player_ui(actor or db.actor)
			end
			if TUTORIAL_FX[name] and routed then
				return run_routed_tutorial(name, id_of(npc), f, actor, npc, p, ready)
			end
			if not ready then return end
			if TUTORIAL_FX[name] and in_session and not replaying and not tutorial_monitor_built() then return end
		end
		return f(actor, npc, p)
	end
end

-- For other scripts: an actor effect on every other player's own character, when no object names an audience (a dialog).
function relay_to_all(name, args, except_peer)
	if not (installed and P.active() and (coop_mode.decides_world() or coop_mode.leads_here()) and ACTOR_FX[name]) then return end
	local aud = {}
	for _, o in ipairs(P.others()) do
		if P.peer_of(o) ~= except_peer then aud[o:id()] = true end
	end
	relay(aud, -1, name, args or "")
end

-- For other scripts (mods group): an effect that acts on db.actor joins the audience routing.
function register_actor_effect(name, always)
	if type(name) ~= "string" then return end
	ACTOR_FX[name] = always and "always" or true
	if installed then wrap_effect(name) end
end

-------------------------------------------------------------------------------
-- Host: switching against every player
-------------------------------------------------------------------------------
local function sees_player(npc, pos, r2)
	if not npc:alive() then return false end
	for _, p in ipairs(P.everyone()) do
		if npc:see(p) and (not r2 or p:position():distance_to_sqr(pos) <= r2) then return true end
	end
	return false
end

local function zone_has_player(zone)
	if not zone then return false end
	-- a zone of a map server's level in the far view (coop_srv_quests_far): its map server says who stands in it, the players there are
	-- records here
	if zone.far then return zone:anyone_inside() == true end
	for _, p in ipairs(P.everyone()) do
		if zone:inside(p:position()) then return true end
	end
	return false
end

-- st.logic is rebuilt on every scheme switch: the verdict keys on its identity.
local function has_actor_conds(st, l)
	if st.coop_logic_seen ~= l then
		local found = false
		for _, c in pairs(l) do
			if ACTOR_CONDS[c.name] then
				found = true
				break
			end
		end
		st.coop_logic_seen, st.coop_actor_conds = l, found
	end
	return st.coop_actor_conds
end

-- The conditions a logic section switches on (the set of stock xr_logic.try_switch_to_another_section), each a test of
-- (here, condition): the actor's are read against every alive player, the others as stock reads them.
local function radius_sqr(c)
	local r = tonumber(c.v1) or 0
	return r * r
end
-- The record a test reads (team_try_switch): npc, st, ost; the position and the nearest player's squared distance are read
-- once, on the first test that needs them.
local function here_pos(x)
	if x.pos == nil then x.pos = x.npc:position() end
	return x.pos
end
local function here_near(x)
	if x.nearest == nil then x.nearest = P.nearest_dist_sqr(here_pos(x)) end
	return x.nearest
end
local SWITCH_TESTS = {
	on_actor_dist_le = function(x, c) return sees_player(x.npc, here_pos(x), radius_sqr(c)) end,
	on_actor_dist_le_nvis = function(x, c) return here_near(x) <= radius_sqr(c) end,
	on_actor_dist_ge = function(x, c) return here_near(x) > radius_sqr(c) and sees_player(x.npc) end,
	on_actor_dist_ge_nvis = function(x, c) return here_near(x) > radius_sqr(c) end,
	on_signal = function(x, c)
		local signals = x.st.signals
		return signals ~= nil and signals[c.v1]
	end,
	on_info = function() return true end,
	on_timer = function(x, c) return time_global() >= (x.ost.activation_time or 0) + c.v1 end,
	on_game_timer = function(x, c)
		local since = x.ost.activation_game_time
		-- a nil CTime into the luabind diffSec is a native crash, not a Lua error
		return since ~= nil and game.get_game_time():diffSec(since) >= c.v1
	end,
	on_actor_in_zone = function(_, c) return zone_has_player(db.zone_by_name[c.v1]) end,
	on_actor_not_in_zone = function(_, c) return not zone_has_player(db.zone_by_name[c.v1]) end,
	on_npc_in_zone = function(_, c) return utils_obj.npc_in_zone(level.object_by_id(c.npc_id), db.zone_by_name[c.v2]) end,
	on_npc_not_in_zone = function(_, c) return not utils_obj.npc_in_zone(level.object_by_id(c.npc_id), db.zone_by_name[c.v2]) end,
	on_actor_inside = function(x) return zone_has_player(x.npc) end,
	on_actor_outside = function(x) return not zone_has_player(x.npc) end,
}

local function bounded_int(n, min, max)
	return type(n) == "number" and n >= min and n <= max and n % 1 == 0
end

local function own_actor()
	-- The engine's actor id is local. A mod can temporarily point db.actor at a client's proxy.
	if coop_mods_core.identity_obj() then return level.object_by_id(AC_ID or 0) end
	return P.own_actor()
end

local function player_here(peer)
	if peer == nil or coop_mode.where(peer) ~= "here" then return nil end
	local actor
	if peer == P.self_peer() then
		actor = coop_mode.actor_is_player() and own_actor()
	else
		actor = P.object_of_peer(peer)
	end
	if actor and actor:alive() and P.standing(actor) then return actor end
end

local function player_by_id(id)
	local actor = id and player_here(P.peer_of(id))
	if actor and actor:id() == id then return actor end
end

local function players_matching(npc, test)
	local matches, nearest, best = {}, nil, math.huge
	local pos = npc:position()
	local function visit(peer)
		local p = player_here(peer)
		if p and (not test or test(p)) then
			matches[p:id()] = true
			local d = p:position():distance_to_sqr(pos)
			if not nearest or d < best or (d == best and p:id() < nearest:id()) then nearest, best = p, d end
		end
	end
	visit(P.self_peer())
	for _, row in ipairs(coop_util.players()) do
		if not row.is_self then visit(row.id) end
	end
	return matches, nearest
end

local function arrival_players(npc, c)
	if c.name == "on_actor_dist_le" or c.name == "on_actor_dist_le_nvis" then
		return players_matching(npc, function(p)
			return p:position():distance_to_sqr(npc:position()) <= radius_sqr(c)
				and (c.name ~= "on_actor_dist_le" or npc:see(p))
		end)
	end
	local zone = c.name == "on_actor_in_zone" and db.zone_by_name[c.v1] or npc
	return players_matching(npc, function(p) return zone and zone:inside(p:position()) end)
end

local function transition_for(npc, actor, audience, f, ...)
	local old = transition_user
	transition_user = { npc = npc:id(), actor = actor:id(), audience = audience }
	local ok, result = pcall(f, ...)
	transition_user = old
	if not ok then error(result, 0) end
	return result
end

local function pick_and_switch(npc, st, actor, c)
	return xr_logic.switch_to_section(npc, st.ini, xr_logic.pick_section_from_condlist(actor, npc, c.condlist))
end

-- Records for team_try_switch that no call uses now. A condlist's effects can run a nested team_try_switch (another
-- object's logic) while the outer loop still reads its record, so each call takes its own and gives it back at the end;
-- a call that raises leaves its record to the collector.
local free_records = {}

local function take_record(npc, st, ost)
	local n = #free_records
	local x = free_records[n]
	if x then
		free_records[n] = nil
	else
		x = {}
	end
	x.npc, x.st, x.ost, x.pos, x.nearest = npc, st, ost, nil, nil
	return x
end

local function give_back(x)
	x.npc, x.st, x.ost, x.pos, x.nearest = nil, nil, nil, nil, nil
	free_records[#free_records + 1] = x
end

-- Vanilla's loop with the actor conditions read against every alive player.
local function team_try_switch(npc, st, actor, l)
	local npc_id = npc:id()
	local ost = db.storage[npc_id] or {}
	local replicated = ost.stype == STYPE_RESTRICTOR and ost.coop_local == false
	local here = take_record(npc, st, ost)
	local switched = false
	for _, c in pairs(l) do
		local name = c.name
		local test = SWITCH_TESTS[name]
		local fire = false
		if test ~= nil then
			fire = test(here, c)
		else
			printf("WARNING: object '%s': try_switch_to_another_section: unknown condition '%s' encountered", npc:name(), tostring(name))
		end
		if fire then
			-- An arrival restarts the audience only once its condlist delivers an effect or switches.
			local arrival = replicated and ARRIVAL_CONDS[name]
			if arrival then ost.coop_arrival = c end
			local matches, initiator
			if coop_mode.leads_here() and ARRIVAL_CONDS[name] then
				matches, initiator = arrival_players(npc, c)
			end
			if initiator then
				switched = transition_for(npc, initiator, matches, pick_and_switch, npc, st, actor, c)
			else
				switched = pick_and_switch(npc, st, actor, c)
			end
			if arrival and ost.coop_arrival then
				if switched == true and ost.active_section then restart_audience(npc, ost, c) end
				ost.coop_arrival = nil
			end
		end
		if switched == true then break end
	end
	give_back(here)
	if switched then stats.switched_team = stats.switched_team + 1 end
	return switched
end

-- Whom this NPC takes for "the actor": a companion's leader (coop_npc_companions.follows).
local function followed(npc)
	local c = rawget(_G, "coop_npc_companions")
	return c and c.follows and c.follows(npc) or nil
end

-- A companion's logic runs for its leader: distances, sight and the functors of its condlists read him. The infos of those condlists stay
-- the world's (pick_section), and [meet] stays with the nearest player: it does not pass here.
local function switch_for_leader(lead, npc, st)
	leading = true
	local ok, r = pcall(P.with_identity, lead, orig.try_switch, npc, st, lead)
	leading = false
	if not ok then error(r, 0) end
	return r
end

local function try_switch(npc, st, actor)
	if installed and npc and P.active() then
		if P.host_on() then
			local lead = actor and followed(npc)
			if lead then return switch_for_leader(lead, npc, st) end
			local l = st and st.logic
			if actor and l and has_actor_conds(st, l) and not is_local_restrictor(npc) then
				return team_try_switch(npc, st, actor, l)
			end
		elseif P.is_client() then
			local ost = restrictor_st(npc)
			if ost and ost.coop_local == false then return false end
		end
		-- almost every call is for this process's own actor: the stock path, without a player lookup
		if actor and coop_mode.leads_here() then
			local own, id = own_actor(), actor:id()
			if not (own and id == own:id()) then
				local player = player_by_id(id)
				if player then return transition_for(npc, player, nil, orig.try_switch, npc, st, actor) end
			end
		end
	end
	return orig.try_switch(npc, st, actor)
end

-------------------------------------------------------------------------------
-- Sections: host broadcasts, client applies
-------------------------------------------------------------------------------
local pending = {} -- client: local id -> { s = section, t = received, cut = scene run or nil }
local try_apply

-- The arena already owns its fighter slots, cameras and completion handshake.
local function managed_cutscene(npc, st, section)
	return is_cutscene(section) and npc:name() ~= "bar_arena_triger"
		and not (st.ini and st.ini:section_exist("sr_cutscene@fight_1"))
end

local function cutscene_audience(npc, st, actor, entry)
	if entry and entry.audience then return entry.audience end
	if actor then return { [actor:id()] = true } end
	if st.coop_cutscene then return st.coop_cutscene.aud end
	if st.coop_scene_arrival then return st.coop_scene_arrival end
	local participants, nearest = players_matching(npc, function(p) return npc:inside(p:position()) end)
	if not nearest then
		_, nearest = players_matching(npc)
		if nearest then participants[nearest:id()] = true end
	end
	return participants
end

local function transition_actor(npc)
	local entry = transition_user
	if entry and entry.npc == npc:id() then return player_by_id(entry.actor), entry end
	local obj = P.in_identity() and db.actor or coop_mods_core.identity_obj()
	return obj and player_by_id(obj:id())
end

local function stop_cutscene(st)
	local action = st.sr_cutscene and st.sr_cutscene.cutscene_action
	if not (action and action.coop_playing) then return end
	action.coop_playing = nil
	if action.motion then
		level.remove_cam_effector(210408)
		action.motion = nil
	end
	if action.postprocess then
		level.remove_complex_effector(1999)
		action.postprocess = false
	end
	if action.st.pp_effector and action.st.pp_effector ~= "nil.ppe" then level.remove_pp_effector(234) end
	if action.ui_disabled then
		local actor = own_actor()
		if actor then P.with_identity(actor, xr_effects.enable_ui, actor, nil) end
		action.ui_disabled = false
	end
end

local function remember_transition(npc, st, section)
	local actor, entry = transition_actor(npc)
	if section == "nil" then
		st.coop_scene_user, st.coop_scene_arrival = nil, nil
	elseif actor then
		st.coop_scene_user = actor:id()
	end
	if st.stype ~= STYPE_RESTRICTOR then return end
	if managed_cutscene(npc, st, section) then
		actor = actor or player_by_id(st.coop_user)
		local now = time_global()
		cut_run = math.max(cut_run, now % MAX_SCENE_RUN) % MAX_SCENE_RUN + 1
		st.coop_cutscene = { s = section, q = cut_run, aud = cutscene_audience(npc, st, actor, entry), done = {}, started = now }
		st.coop_scene_arrival = nil
	else
		st.coop_cutscene = nil
		if actor then st.coop_scene_arrival = entry and entry.audience or { [actor:id()] = true } end
	end
end

local function section_packet(id, section, cut)
	local t = { i = id, s = section or "nil" }
	if cut and cut.s == section then
		local ids = {}
		for actor in pairs(cut.aud) do
			if not cut.done[actor] then
				local hid = coop_mods_core.hid(actor)
				if bounded_int(hid, 0, MAX_OBJECT_ID) then ids[#ids + 1] = hid end
			end
		end
		table.sort(ids)
		t.i, t.q, t.a = coop_mods_core.hid(id), cut.q, table_concat(ids, ",")
		t.k = cut.stop
	end
	return t
end

local function read_cutscene(section, run, ids, stop)
	if not (is_cutscene(section) and bounded_int(run, 1, MAX_SCENE_RUN) and type(ids) == "string"
		and #ids <= MAX_SCENE_AUDIENCE * 6) then return nil end
	local audience, count = {}, 0
	for id in ids:gmatch("[^,]+") do
		local n = tonumber(id)
		count = count + 1
		if count > MAX_SCENE_AUDIENCE or not bounded_int(n, 0, MAX_OBJECT_ID) then return nil end
		audience[n] = true
	end
	return { s = section, q = run, aud = audience, stop = stop == true }
end

local function broadcast_section(id, section)
	local st = db.storage[id]
	if is_cutscene(section) and coop_mode and not coop_mode.leads_here() then return end
	if P.send(EV_SECTION, section_packet(id, section, st and st.coop_cutscene), -1) then
		stats.sections_out = stats.sections_out + 1
	end
end

local function switch_to_section(npc, ini, section)
	local st = installed and npc and P.active() and restrictor_st(npc)
	if not (st and st.coop_local == false) then
		return orig.switch(npc, ini, section)
	end
	if P.is_client() then
		if not applying then
			stats.refused = stats.refused + 1
			return false
		end
		return orig.switch(npc, ini, section)
	end
	local switched = orig.switch(npc, ini, section)
	if switched then
		if not st.active_section then st.coop_aud, st.coop_trigger_zone = nil, nil end
		if P.host_on() or st.coop_cutscene then broadcast_section(npc:id(), st.active_section) end
	end
	return switched
end

local function client_request(id)
	P.send(EV_REQ, id and { i = P.to_host(id) } or {}, 0)
end

-- A client never runs the active= pick of a replicated restrictor: it takes the host's section.
local function determine_section(npc, ini, section_logic, actor)
	if installed and P.is_client() then
		local st = db.storage[npc:id()]
		if st and st.stype == STYPE_RESTRICTOR then
			classify(st, ini)
			if st.coop_local == false then
				local p = pending[npc:id()]
				pending[npc:id()] = nil
				if p and (p.s == "nil" or ini:section_exist(p.s)) then
					st.coop_cutscene = p.cut
					return p.s
				end
				client_request(npc:id())
				return "nil"
			end
		end
	end
	return orig.determine(npc, ini, section_logic, actor)
end

-- Original xr_logic.initialize_obj supports [logic] cfg in spawn_ini: these keys are engine data.
-- custom_data caps at 4 KiB, so real logic often lives in the cfg-linked ltx.
local function resolve_logic_ini(obj)
	local ini = obj:spawn_ini()
	if ini == nil or not ini:section_exist("logic") then return ini end
	local linked_name = ini:r_string_ex("logic", "cfg")
	if linked_name == nil or linked_name == "" then return ini end
	local loaded, linked = pcall(ini_file, linked_name)
	if loaded and linked ~= nil and linked:section_exist("logic") then return linked end
	return ini
end

-- A saved "nil" is a real deactivation only if some condlist can produce it (unreadable: trust the save).
local function can_reach_nil(ini)
	local reach = false
	local ok = each_line(ini, function(_, _, value)
		if type(value) == "string" and value:find("%f[%w]nil%f[%W]") then reach = true end
		return reach
	end)
	return reach or not ok
end

local function initialize(obj, st, loaded, actor, stype)
	if installed and loaded and P.active() and st and st.loaded_active_section == "nil" then
		if st.loaded_section_logic == nil then
			loaded = false -- saved before its first logic update: derive it again
		else
			local ini = resolve_logic_ini(obj)
			if ini and ini:section_exist("logic") and ini:line_exist("logic", "active") and not can_reach_nil(ini) then
				loaded = false
			end
		end
		if not loaded then
			stats.healed = stats.healed + 1
			log("logic heal: %s had a blank saved section, derived again", obj:name())
		end
	end
	orig.initialize(obj, st, loaded, actor, stype)
	if not (installed and stype == STYPE_RESTRICTOR and st and P.active()) then return end
	classify(st)
	if st.coop_local ~= false then return end
	if P.host_on() or (st.coop_cutscene and coop_mode.leads_here()) then
		broadcast_section(obj:id(), st.active_section)
	elseif P.is_client() then
		local p = pending[obj:id()]
		if p and try_apply(obj:id(), p.s, p.cut) then pending[obj:id()] = nil end
	end
end

-- A map server's look at what a binder would save (xrCoop/coop_levels_logic.h): the first update stamps every object it initializes, with
-- logic or without. One with none says nothing, or every restrictor of a level would count as changed and go into the host's save. None
-- also means a [logic] that starts at nil: an empty custom_data gets default_custom_data.ltx, active = nil.
local function says_nothing(st)
	local levels = coop and coop.levels
	if not (levels and levels.logic_look and levels.logic_look()) then return false end
	if st.active_section ~= nil then return false end
	local loaded = st.loaded_active_section
	if loaded ~= nil and loaded ~= "nil" then return false end
	local ini, logic = st.ini, st.section_logic or "logic"
	if not (ini and ini:section_exist(logic)) then return true end
	local active = ini:r_string_ex(logic, "active")
	return active == nil or active == "nil"
end

-- Saved before initialize_obj ran: the loaded state still sits in loaded_*, write that, not a blank one.
local function save_obj(obj, packet)
	local st = installed and obj and db.storage[obj:id()]
	if st and says_nothing(st) then return end
	st = st and P.active() and st
	if st and st.section_logic == nil and st.loaded_active_section ~= nil then
		local keep = { st.ini_filename, st.section_logic, st.active_section, st.gulag_name }
		st.ini_filename = st.loaded_ini_filename
		st.section_logic = st.loaded_section_logic
		st.active_section = st.loaded_active_section ~= "nil" and st.loaded_active_section or nil
		st.gulag_name = st.loaded_gulag_name ~= "" and st.loaded_gulag_name or nil
		local ok, err = pcall(orig.save_obj, obj, packet)
		st.ini_filename, st.section_logic, st.active_section, st.gulag_name = keep[1], keep[2], keep[3], keep[4]
		if not ok then error(err, 0) end
		return
	end
	return orig.save_obj(obj, packet)
end

-- Returns true when done (applied, refused or not ours), false to retry later.
try_apply = function(id, section, cut)
	local st = db.storage[id]
	if not (st and st.stype == STYPE_RESTRICTOR and st.ini) then return false end
	classify(st)
	if st.coop_local then return true end
	if section ~= "nil" and not st.ini:section_exist(section) then
		log("! section %s of %s is unknown here, refused", tostring(section), tostring(id))
		return true
	end
	local target = section ~= "nil" and section or nil
	local obj = level.object_by_id(id)
	if not obj then return false end
	if st.active_section == target then
		if cut and (not st.coop_cutscene or st.coop_cutscene.q ~= cut.q) then
			stop_cutscene(st)
			st.coop_cutscene = cut
			local action = st.sr_cutscene and st.sr_cutscene.cutscene_action
			if action then action:reset_scheme() end
		elseif cut and cut.stop then
			st.coop_cutscene.stop = true
		end
		return true
	end
	st.coop_cutscene = cut
	applying = true
	local ok, err = pcall(orig.switch, obj, st.ini, section)
	applying = false
	if not ok then report("apply section " .. tostring(section), err) end
	stats.sections_in = stats.sections_in + 1
	return true
end

local function client_on_section(host_id, section, run, participants, stop)
	if type(host_id) ~= "number" or type(section) ~= "string" or section == "" then return end
	local id = P.to_local(host_id)
	local cut = read_cutscene(section, run, participants, stop)
	if try_apply(id, section, cut) then
		pending[id] = nil
	else
		pending[id] = { s = section, cut = cut, t = time_global() }
	end
end

local function client_retry_pending()
	local now = time_global()
	for id, p in pairs(pending) do
		if try_apply(id, p.s, p.cut) or now - p.t > PENDING_TTL then pending[id] = nil end
	end
end

local function host_send_all(peer)
	local t, n = {}, 0
	local function flush()
		if n > 0 then
			t.n = n
			P.send(EV_ALL, t, peer)
		end
		t, n = {}, 0
	end
	for _, zone in pairs(db.zone_by_name or {}) do
		local ok, id = pcall(zone.id, zone)
		local st = ok and db.storage[id]
		if st and st.stype == STYPE_RESTRICTOR and st.ini then
			classify(st)
			if st.coop_cutscene then
				P.send(EV_SECTION, section_packet(id, st.active_section, st.coop_cutscene), peer)
			elseif st.coop_local == false then
				n = n + 1
				t["i" .. n] = id
				t["s" .. n] = st.active_section or "nil"
				if n >= CHUNK then flush() end
			end
		end
	end
	flush()
end

-------------------------------------------------------------------------------
-- Effects relayed to this client
-------------------------------------------------------------------------------
local function client_on_fx(t)
	local name = t.f
	if type(name) ~= "string" or not ACTOR_FX[name] or not db.actor then return end
	local ready = not UI_FX[name]
		or (P.client_live() and (UNLOCK_FX[name] and own_player(db.actor) or local_player_ui(db.actor)))
	if not ready and not TUTORIAL_FX[name] then return end -- run_routed_tutorial defers a stop, a start only cancels it
	local f = xr_effects and xr_effects[name]
	if type(f) ~= "function" then return end
	local npc_id = bounded_int(t.i, 0, MAX_OBJECT_ID) and t.i or nil
	local npc = ready and npc_id and level.object_by_id(P.to_local(npc_id)) or nil
	if name == "sr_teleport" and not npc then return end -- he left the level before it came: the stock's box needs the restrictor
	if name == "kill_actor" and npc then
		local gate = KILL_GATES[npc:name()]
		if gate and db.actor:object(gate) then return end
	end
	local zone = db.zone_by_name[FX_ZONES[name]]
	if zone and not zone:inside(db.actor:position()) then return end
	local args = type(t.a) == "string" and t.a or ""
	local p = args ~= "" and xr_logic.parse_func_params(args) or {}
	stats.fx_in = stats.fx_in + 1
	replaying = true
	local ok, err
	if TUTORIAL_FX[name] then
		-- Keep host numbering here. The source object can be gone when its stop arrives.
		ok, err = pcall(run_routed_tutorial, name, npc_id, f, db.actor, npc, p, ready)
	else
		ok, err = pcall(f, db.actor, npc, p)
	end
	replaying = false
	if not ok then report("relayed effect " .. name, err) end
end

-------------------------------------------------------------------------------
-- Host: actor conditions for every player
-------------------------------------------------------------------------------
-- Only when asked about the host's own actor: combat condlists pass the enemy as `actor`.
local function team_actor(actor, npc)
	local rep = rawget(_G, "coop_reputation")
	if rep and rep.in_personal_check() then return false end
	return P.host_on() and actor ~= nil and actor:id() == 0 and not is_local_restrictor(npc)
end

local function patch_conditions()
	local xc = xr_conditions
	if not xc then return end
	local function wrap(name, make)
		local f = xc[name]
		if type(f) ~= "function" or orig["c_" .. name] then return end
		orig["c_" .. name] = f
		xc[name] = make(f)
	end
	wrap("dist_to_actor_le", function(f) return function(actor, npc, p)
		if team_actor(actor, npc) and p and p[1] ~= nil and npc then
			if P.in_identity() then return f(db.actor, npc, p) end -- to the leader of a companion
			return P.nearest_dist_sqr(npc:position()) <= tonumber(p[1]) ^ 2
		end
		return f(actor, npc, p)
	end end)
	wrap("dist_to_actor_ge", function(f) return function(actor, npc, p)
		if team_actor(actor, npc) and p and p[1] ~= nil and npc then
			if P.in_identity() then return f(db.actor, npc, p) end
			return P.nearest_dist_sqr(npc:position()) >= tonumber(p[1]) ^ 2
		end
		return f(actor, npc, p)
	end end)
	-- reads a var of the actor, which a proxy has not
	wrap("dist_to_task_target_anomaly_le", function(f) return function(actor, npc, p)
		if P.in_identity() then return P.with_identity(P.own_actor(), f, actor, npc, p) end
		return f(actor, npc, p)
	end end)
	-- A proxy has no vision of its own (a puppet): "the player sees it" = it sees the player.
	wrap("actor_see_npc", function(f) return function(actor, npc, p)
		local r = f(actor, npc, p)
		if r or not team_actor(actor, npc) or not npc or not npc:alive() then return r end
		for _, o in ipairs(P.others()) do
			if npc:see(o) then return true end
		end
		return r
	end end)
	wrap("actor_near_smart", function(f) return function(actor, npc, p)
		if not (P.host_on() and db.actor and p and p[1]) then return f(actor, npc, p) end
		local smart = SIMBOARD and SIMBOARD.smarts_by_names[p[1]]
		if not (smart and smart.online) then return false end
		local dist = p[2] and tonumber(p[2]) or 50
		return P.nearest_dist_sqr(smart.position) < dist * dist
	end end)
	wrap("actor_in_zone", function(f) return function(actor, npc, p)
		if not (team_actor(actor, npc) and p) then return f(actor, npc, p) end
		for i = 1, #p do
			if zone_has_player(db.zone_by_name[p[i]]) then return true end
		end
		return false
	end end)
	wrap("actor_out_zone", function(f) return function(actor, npc, p)
		if not (team_actor(actor, npc) and p and p[1]) then return f(actor, npc, p) end
		local zone = db.zone_by_name[p[1]]
		if not zone then return f(actor, npc, p) end
		return not zone_has_player(zone)
	end end)
	-- Stock reads db.actor_inside_zones, which only the host's actor feeds (bind_restrictor on_enter).
	wrap("actor_inside_zone", function(f) return function(actor, npc, p)
		local r = f(actor, npc, p)
		if r or not (team_actor(actor, npc) and p) then return r end
		for i = 1, #p do
			if zone_has_player(db.zone_by_name[p[i]]) then return true end
		end
		return false
	end end)
	-- A client's tutorial runs on his machine, and a hint of these zones lasts until he presses its key or walks out. Stock
	-- reads "none" on the host, falls back and fires run_tutorial again on every pass (sr_sleep.ltx, pri_b306_sr_generator.ltx).
	wrap("has_active_tutorial", function(f) return function(actor, npc, p)
		local r = f(actor, npc, p)
		local st = not r and npc and current(npc)
		if not st then return r end
		local aud = audience(npc, st)
		for _, o in ipairs(P.others()) do
			if aud[o:id()] and npc:inside(o:position()) then return true end
		end
		return false
	end end)
end

-------------------------------------------------------------------------------
-- Host: condlist context of replicated restrictors
-------------------------------------------------------------------------------
-- A condlist under a leader's identity: the stock reads and gives "the actor's" infos on db.actor, and a proxy holds none of the world's
-- (the engine's story knows the actor alone). They are read and given here, on this process's own actor; the rest goes to the stock line by
-- line: cond = { section, { checks }, { effects } }, kind 1 + 2 -, [3] set for an NPC's own flag (xr_logic.extract_conditions).
local function pick_for_leader(obj, npc, condlist)
	local actor = P.own_actor()
	for i = 1, #condlist do
		local cond = condlist[i]
		local met, checks = true, {}
		for _, c in ipairs(cond[2] or {}) do
			if (c[2] == 1 or c[2] == 2) and not c[3] then
				if actor:has_info(c[1]) ~= (c[2] == 1) then
					met = false
					break
				end
			else
				checks[#checks + 1] = c
			end
		end
		if met then
			local sets, infos = {}, {}
			for _, s in ipairs(cond[3] or {}) do
				if (s[2] == 1 or s[2] == 2) and not s[3] then infos[#infos + 1] = s else sets[#sets + 1] = s end
			end
			local section = orig.pick(obj, npc, { { cond[1], checks, sets } })
			if section ~= nil then
				for _, s in ipairs(infos) do
					local has = actor:has_info(s[1])
					if s[2] == 1 and not has then actor:give_info_portion(s[1]) elseif s[2] == 2 and has then actor:disable_info_portion(s[1]) end
				end
				return section
			end
		end
	end
	return nil
end

local function pick_scene_line(obj, npc, condlist, frame)
	local st, cut = frame.st, frame.st.coop_cutscene
	if not (coop_mode and coop_mode.leads_here()) then return orig.pick(obj, npc, condlist) end
	if cut then
		frame.cut_audience = cut.aud
		return orig.pick(obj, npc, condlist)
	end
	if type(condlist) == "table" then
		for _, line in ipairs(condlist) do
			if type(line) == "table" and managed_cutscene(npc, st, line[1]) then
				-- The effects of the chosen branch run before switch_to_section, including disable_ui in Zaton.
				for _, candidate in ipairs(condlist) do
					frame.cut_audience = nil
					if managed_cutscene(npc, st, candidate[1]) then
						local actor, entry = transition_actor(npc)
						frame.cut_audience = cutscene_audience(npc, st, actor or player_by_id(st.coop_user), entry)
					end
					local section = orig.pick(obj, npc, { candidate })
					if section ~= nil then return section end
				end
				return nil
			end
		end
	end
	return orig.pick(obj, npc, condlist)
end

local function pick_section(obj, npc, condlist)
	local rep = rawget(_G, "coop_reputation")
	if rep and P.host_on() then
		local handled, section = rep.pick_offence(obj, npc, condlist, pick_for_leader)
		if handled then return section end
	end
	if leading and condlist and P.in_identity() then return pick_for_leader(obj, npc, condlist) end
	if not P.host_on() or npc == nil then return orig.pick(obj, npc, condlist) end
	local ok_id, id = pcall(id_of, npc) -- npc can be a game object, a server object or a squad
	local st = ok_id and type(id) == "number" and db.storage[id]
	if not (st and st.stype == STYPE_RESTRICTOR and st.coop_local == false) then
		return orig.pick(obj, npc, condlist)
	end
	local frame = { st = st, npc_id = id }
	ctx[#ctx + 1] = frame
	local ok, r = pcall(pick_scene_line, obj, npc, condlist, frame)
	ctx[#ctx] = nil
	if not ok then error(r, 0) end
	return r
end

-------------------------------------------------------------------------------
-- Physics objects: who used them; uses whose window is the player's own
-------------------------------------------------------------------------------
local pad_offers = {} -- host: peer -> the pad he may answer
local pad_tries = {} -- host: peer -> time of his last code
local PAD_TRY_MS = 1000
local pad_owner = {} -- client: the owner of the stock numpad window

-- Client: Close() of the window answers "" and that means nothing. OK keeps it open: every try goes to the host.
function pad_owner:OnNumberReceive(text)
	if self.id and type(text) == "string" and text ~= "" then P.send(EV_PAD_CODE, { i = self.id, t = text }, 0) end
end

local function client_on_pad(t)
	local ui = _G["ui_numpad"]
	if type(t.i) ~= "number" or not (ui and db.actor) then return end
	pad_owner.id = t.i
	-- stock keeps the first window with its first owner for good
	if ui.GUI then ui.GUI.owner = pad_owner end
	ui.start(pad_owner)
end

-- The stock pad checks the code, here, at the object's own scheme. C++ checked the reach of the press (host_on_use).
local function host_on_pad_code(t, from)
	local id, text = t.i, t.t
	if type(id) ~= "number" or pad_offers[from] ~= id then return end
	if type(text) ~= "string" or #text > PAD_MAX_TEXT or not text:find("^%d+$") then return end
	local now = time_global()
	if pad_tries[from] and now - pad_tries[from] < PAD_TRY_MS then return end
	pad_tries[from] = now
	local obj, who, st = level.object_by_id(id), P.object_of_peer(from), db.storage[id]
	if not (obj and who and st and st.active_scheme == "ph_code") then return end
	local reach = P.setting("pad_reach", 6)
	if who:position():distance_to_sqr(obj:position()) > reach * reach then
		log("! code from #%s refused: too far from %s", tostring(from), obj:name())
		return
	end
	xr_logic.issue_event(obj, st[st.active_scheme], "OnNumberReceive", text)
end

-- The window of bind_awr.physic_object_on_use_callback, on the presser's machine. full_access ran on the host only, so the
-- host's answer is the one that counts; the 1.5 m of the handler is then measured from his own actor.
local function client_on_vise(t)
	local awr = _G["bind_awr"]
	local obj = type(t.i) == "number" and level.object_by_id(P.to_local(t.i))
	if not (awr and obj and db.actor) then return end
	local access = awr.access
	awr.access = function() return true end
	local ok, err = pcall(awr.physic_object_on_use_callback, obj, db.actor)
	awr.access = access
	if not ok then error(err, 0) end
end

local function host_vise_use(obj, who)
	local awr = _G["bind_awr"]
	-- it indexes its table by the object's name: a vise of a mod it does not list must not cost the host the session
	local ok, yes = pcall(awr.access, obj)
	if ok and yes then P.send(EV_VISE, { i = obj:id() }, P.peer_of(who)) end
end

-- Host, every use of a physics object with logic. True = done: the use belongs to the client's machine.
local function on_use(obj, who)
	local st = db.storage[obj:id()]
	local id = who:id()
	local player = P.is_player_id(id)
	if st then
		st.coop_user = player and id or nil
		st.coop_press = P.host_on() and player and press_audience(st, obj, id) or nil
	end
	if P.is_proxy(id) and obj:name():find("awr_tiski", 1, true) then
		host_vise_use(obj, who)
		return true
	end
	return false
end

local function patch_uses()
	local pb = _G["bind_physic_object"] and bind_physic_object.generic_physics_binder
	local use = pb and pb.use_callback
	-- the binder hands this method to set_callback on every update: existing objects get it too
	if type(use) == "function" and not orig.ph_use then
		orig.ph_use = use
		pb.use_callback = function(self, obj, who)
			if installed and who and P.active() and (coop_mode.decides_world() or coop_mode.leads_here()) and on_use(self.object, who) then return end
			return use(self, obj, who)
		end
	end
	local pad = _G["ph_code"] and ph_code.codepad
	local pad_use = pad and pad.use_callback
	if type(pad_use) == "function" and not orig.pad_use then
		orig.pad_use = pad_use
		pad.use_callback = function(self, obj, who)
			if not (installed and who and P.active() and (coop_mode.decides_world() or coop_mode.leads_here()) and P.is_proxy(who)) then
				-- in a session too the second pad of a level must not answer to the first (see client_on_pad)
				local ui = P.active() and _G["ui_numpad"]
				if ui and ui.GUI then ui.GUI.owner = self end
				return pad_use(self, obj, who)
			end
			local id, peer = self.object:id(), P.peer_of(who)
			pad_offers[peer] = id
			P.send(EV_PAD, { i = id }, peer)
		end
	end
end

-------------------------------------------------------------------------------
-- Scene cameras, remark targets and NPC use
-------------------------------------------------------------------------------
local function mark_scene_end(cut, id)
	if cut and cut.aud[id] and not cut.done[id] then cut.done[id] = true end
end

local function scene_end(t, from)
	local valid = bounded_int(t.i, 0, MAX_OBJECT_ID) and bounded_int(t.q, 1, MAX_SCENE_RUN)
	if not coop_trust.pass("npc_scene_end_shape", valid, "peer %s: invalid cutscene completion", tostring(from)) then return end
	if not valid then return end
	local id = coop_mods_core.lid(t.i)
	local st = id and db.storage[id]
	local cut = st and st.coop_cutscene
	local actor = coop_mode.decider(from) == "this" and player_here(from)
	local who = actor and actor:id()
	local invited = cut and cut.done and cut.q == t.q and cut.s == st.active_section and cut.aud[who] == true
	if not coop_trust.pass("npc_scene_end_member", invited, "peer %s: cutscene %d run %d has no such participant",
		tostring(from), t.i, t.q) then return end
	if invited then mark_scene_end(cut, who) end -- completion is a one-shot for the assigned participant
end

local function camera_finished(cut)
	if time_global() - cut.started >= CUT_TIMEOUT then return true end
	for id in pairs(cut.aud) do
		if not cut.done[id] and player_by_id(id) then return false end
	end
	return true
end

local function patch_scene_transitions()
	coop_mods_core.wrap(xr_logic, "activate_by_section", "npc_logic:scene_activate", function(stock)
		return function(npc, ini, section, ...)
			local st = P.active() and storage_of(npc)
			if st then
				if st.active_section ~= section then stop_cutscene(st) end
				if coop_mode.leads_here() then remember_transition(npc, st, section) end
			end
			return stock(npc, ini, section, ...)
		end
	end)
	coop_mods_core.wrap(xr_logic, "issue_event", "npc_logic:scene_use", function(stock)
		return function(npc, st, event, ...)
			if event == "use_callback" and npc and P.active() and coop_mode.leads_here() then
				local _, who = ...
				local actor = who and player_by_id(who:id())
				if actor then return transition_for(npc, actor, nil, stock, npc, st, event, ...) end
			end
			return stock(npc, st, event, ...)
		end
	end)
end

local function patch_cutscenes()
	local mod = coop_mods_core.mod("sr_cutscene")
	local action = mod and mod.action_cutscene
	if not action then return end
	coop_mods_core.wrap(action, "zone_enter", "npc_logic:cutscene_enter", function(stock)
		return function(self, ...)
			local st = P.active() and storage_of(self.object)
			if not (st and managed_cutscene(self.object, st, st.active_section)) then return stock(self, ...) end
			local cut, actor = st.coop_cutscene, own_actor()
			if not (cut and cut.s == st.active_section and actor and coop_mode.actor_is_player()
				and actor:alive() and P.standing(actor)) then return end
			local id = cut.done and actor:id() or coop_mods_core.hid(actor:id())
			if not cut.aud[id] or cut.presented then return end
			cut.presented, self.coop_playing = true, cut.q
			return P.with_identity(actor, stock, self, ...)
		end
	end)
	coop_mods_core.wrap(action, "cutscene_callback", "npc_logic:cutscene_end", function(stock)
		return function(self, ...)
			local st = P.active() and storage_of(self.object)
			if not (st and managed_cutscene(self.object, st, st.active_section)) then return stock(self, ...) end
			local cut = st.coop_cutscene
			if not (cut and self.motion and self.coop_playing == cut.q) then return end
			local result = stock(self, ...)
			if self.st.signals and self.st.signals.cameff_end then
				self.coop_playing = nil
				self.st.signals.cameff_end = nil
				if cut.done then
					local actor = own_actor()
					if actor then mark_scene_end(cut, actor:id()) end
				else
					local id = coop_mods_core.hid(self.object:id())
					if id then coop_mods_core.to_host(SCENE_END, { i = id, q = cut.q }) end
				end
			end
			return result
		end
	end)
	coop_mods_core.wrap(action, "update", "npc_logic:cutscene_update", function(stock)
		return function(self, ...)
			local st = P.active() and storage_of(self.object)
			if not (st and managed_cutscene(self.object, st, st.active_section)) then return stock(self, ...) end
			local cut = st.coop_cutscene
			if cut and cut.done and camera_finished(cut) then
				self.st.signals = self.st.signals or {}
				self.st.signals.cameff_end = true
			end
			if cut and cut.stop and self.coop_playing then self.st.signals.cam_effector_stop = true end
			if coop_mode.leads_here() or self.coop_playing then return stock(self, ...) end
		end
	end)
	coop_mods_core.wrap(coop_mods_core.mod("xr_effects"), "stop_sr_cutscene", "npc_logic:cutscene_stop", function(stock)
		return function(actor, npc, ...)
			local st = P.active() and storage_of(npc)
			if not (st and managed_cutscene(npc, st, st.active_section)) then return stock(actor, npc, ...) end
			local cut = st.coop_cutscene
			if cut and cut.done and not cut.stop then
				cut.stop = true
				broadcast_section(npc:id(), cut.s)
			end
		end
	end)
end

local function remark_actor(npc)
	local st = storage_of(npc)
	local actor = st and player_by_id(st.coop_scene_user)
	if not actor then
		local _, nearest = players_matching(npc)
		actor = nearest
	end
	return actor
end

local function actor_target(target)
	if type(target) ~= "string" then return false end
	local name = target:match("^%s*story%s*|%s*([^,]+)")
	return name ~= nil and name:gsub("%s+$", "") == "actor"
end

local function patch_remarks()
	local mod = coop_mods_core.mod("xr_remark")
	if not mod then return end
	coop_mods_core.wrap(mod, "init_target", "npc_logic:remark_init", function(stock)
		return function(npc, target, ...)
			if not (P.active() and actor_target(target)) then return stock(npc, target, ...) end
			local actor = remark_actor(npc)
			return nil, actor and actor:id(), actor ~= nil
		end
	end)
	-- Some scheme copies captured init_target before the module was wrapped.
	coop_mods_core.wrap(mod.action_remark_activity, "get_target", "npc_logic:remark_target", function(stock)
		return function(self, ...)
			if not (P.active() and actor_target(self.st.target)) then return stock(self, ...) end
			local actor = remark_actor(self.object)
			self.st.target_position, self.st.target_id, self.st.target_init = nil, actor and actor:id(), actor ~= nil
			return actor and { look_object = actor } or nil
		end
	end)
end

local function abuse_rules(npc, actor, meet)
	local use, abuse = meet.use, meet.abuse_mode
	if meet.a and meet.a.use then use = xr_logic.pick_section_from_condlist(actor, npc, meet.a.use) end
	if meet.a and meet.a.abuse then abuse = xr_logic.pick_section_from_condlist(actor, npc, meet.a.abuse) end
	if meet.npc_is_camp_director then use = "false" end
	if load_var and load_var(actor, "force_all_talk", false) then use = "true" end
	return use == "false" and abuse == "true" and game_relations.get_npcs_relation(npc, actor) == game_object.friend
end

local function abuse_use(t, from, add)
	local actor = coop_mode.decider(from) == "this" and player_here(from)
	if not actor then return end
	local valid = bounded_int(t.i, 1, MAX_OBJECT_ID)
	if not coop_trust.pass("npc_abuse_shape", valid, "peer %s: invalid NPC use id", tostring(from)) then return end
	if not valid then return end
	local id = coop_mods_core.lid(t.i)
	local npc = id and level.object_by_id(id)
	local reach = npc and actor:position():distance_to_sqr(npc:position()) <= USE_REACH_SQR
	if not coop_trust.pass("npc_abuse_reach", reach, "peer %s: NPC %d is out of use reach", tostring(from), t.i) then return end
	local st = npc and storage_of(npc)
	local meet = st and st.meet and st.meet.meet_manager
	local ab = st and st.abuse
	local manager = ab and ab.abuse_manager
	-- A client asks at every USE of a living NPC stalker in reach (ask_abuse): it cannot see the NPC's [meet], which lives
	-- on the map that runs the NPC. Only a target that is no NPC stalker is a request no honest client sends. Whether this
	-- use irritates (a dead NPC, no [meet], a talk, abuse off, no friend) is the NPC's own answer, and stock
	-- xr_meet.notify_on_use answers it with no effect: so does this use (stand b57h: a talk to the Marsh barman).
	local target = npc and IsStalker(npc) and P.peer_of(id) == nil
	if not coop_trust.pass("npc_abuse_target", target, "peer %s: object %d is no NPC stalker", tostring(from), t.i) then
		return
	end
	if not target then return end
	if not (npc:alive() and meet and manager and P.with_identity(actor, abuse_rules, npc, actor, meet)) then return end
	-- The cached enable bit is set by [meet] for the player its update was evaluating. This use has its own player.
	local enabled, before = manager.enable, manager.abuse_value
	manager.enable = true
	local ok, err = pcall(add, npc, 1)
	manager.enable = enabled
	if not ok then error(err, 0) end
	if manager.abuse_value > before and (not ab.coop_abuser or before < (manager.abuse_threshold or 5)) then
		ab.coop_abuser = actor:id()
	end
end

local function ask_abuse(key)
	if not (P.active() and coop_mode.is_player_mirror() and coop_mode.actor_is_player()) then return end
	if dik_to_bind(key) ~= key_bindings.kUSE or (_GUIs and next(_GUIs)) then return end
	local actor = db.actor
	if not (actor and actor:alive() and P.standing(actor)) then return end
	if not game.hud_motion_allowed() or game.only_movekeys_allowed() then return end
	local npc = level.get_target_obj()
	if not (npc and IsStalker(npc) and npc:alive() and P.peer_of(npc:id()) == nil) then return end
	local distance = level.get_target_dist()
	if type(distance) ~= "number" or distance <= 0 or distance > USE_RAY_M then return end
	local id = coop_mods_core.hid(npc:id())
	if id then coop_mods_core.to_host(ABUSE_USE, { i = id }) end
end

local function patch_abuse()
	local mod, meet = coop_mods_core.mod("xr_abuse"), coop_mods_core.mod("xr_meet")
	local add = mod and coop_mods_core.fn(mod, "add_abuse")
	if not (add and meet) then return end
	coop_mods_core.wrap(meet, "notify_on_use", "npc_logic:abuse_notify", function(stock)
		return function(npc, who, ...)
			local actor = P.active() and coop_mode.leads_here() and coop_mode.actor_is_player() and own_actor()
			if not (npc and who and actor and who:id() == actor:id()) then return stock(npc, who, ...) end
			local old = meet_user
			meet_user = npc:id()
			local ok, result = pcall(stock, npc, who, ...)
			meet_user = old
			if not ok then error(result, 0) end
			return result
		end
	end)
	coop_mods_core.wrap(mod, "add_abuse", "npc_logic:abuse_add", function(stock)
		return function(npc, value, ...)
			if meet_user and npc:id() == meet_user and value == 1 then
				return abuse_use({ i = coop_mods_core.hid(meet_user) }, P.self_peer(), stock)
			end
			return stock(npc, value, ...)
		end
	end)
	coop_mods_core.wrap(mod.action_abuse_hit, "initialize", "npc_logic:abuse_hit", function(stock)
		return function(self, ...)
			if P.active() and coop_mode.leads_here() then
				local st = storage_of(self.object)
				local id = st and st.abuse and st.abuse.coop_abuser
				if id then
					local actor = player_by_id(id)
					if not actor then return end
					local punch = coop_mods_core.mod("coop_quests_punch")
					if punch then punch.punch(id, self.object:id(), "keep") end
					return P.with_identity(actor, stock, self, ...)
				end
			end
			return stock(self, ...)
		end
	end)
	coop_mods_core.set_limit(ABUSE_USE, 6, 4)
	coop_mods_core.on(ABUSE_USE, function(t, from) abuse_use(t, from, add) end, "host")
	RegisterScriptCallback("on_key_press", ask_abuse)
end

-------------------------------------------------------------------------------
-- Client: restrictor schemes that must not run here
-------------------------------------------------------------------------------
local function patch_schemes()
	-- on_value picks run their %effects% before any switch could be refused.
	local timer = _G["sr_timer"] and sr_timer.action_timer
	local tu = timer and timer.update
	if type(tu) == "function" and not orig.timer then
		orig.timer = tu
		timer.update = function(self, delta)
			local st = installed and P.is_client() and restrictor_st(self.object)
			if st and st.coop_local == false and self.st then
				local on_value = self.st.on_value
				self.st.on_value = {}
				local ok, err = pcall(tu, self, delta)
				self.st.on_value = on_value
				if not ok then error(err, 0) end
				return
			end
			return tu(self, delta)
		end
	end
	-- They create and release world objects: only the host's copies run.
	local function host_only(mod, cls)
		local m = _G[mod]
		local c = m and m[cls]
		local u = c and c.update
		if type(u) ~= "function" or orig[mod] then return end
		orig[mod] = u
		c.update = function(self, ...)
			if installed and P.is_client() then return end
			return u(self, ...)
		end
	end
	host_only("sr_crow_spawner", "crowkiller")
	host_only("sr_monster", "fake_monster")
end

-------------------------------------------------------------------------------
-- Install, update, events
-------------------------------------------------------------------------------
local function install()
	if installed then return end
	if not (xr_logic and xr_logic.try_switch_to_another_section) then
		log("! xr_logic not found: restrictor logic is single-player only")
		return
	end
	STYPE_RESTRICTOR = modules and modules.stype_restrictor or STYPE_RESTRICTOR
	-- stock xr_logic function, our name for the original, our replacement
	for _, o in ipairs({
		{ "try_switch_to_another_section", "try_switch", try_switch },
		{ "determine_section_to_activate", "determine", determine_section },
		{ "initialize_obj", "initialize", initialize },
		{ "switch_to_section", "switch", switch_to_section },
		{ "pick_section_from_condlist", "pick", pick_section },
		{ "save_obj", "save_obj", save_obj },
	}) do
		orig[o[2]] = xr_logic[o[1]]
		xr_logic[o[1]] = o[3]
	end
	installed = true
	for name in pairs(ACTOR_FX) do wrap_effect(name) end
	local steps = { { "conditions", patch_conditions }, { "schemes", patch_schemes }, { "uses", patch_uses } }
	if coop_mode and coop_mods_core then
		steps[#steps + 1] = { "scene transitions", patch_scene_transitions }
		steps[#steps + 1] = { "cutscenes", patch_cutscenes }
		steps[#steps + 1] = { "remarks", patch_remarks }
		steps[#steps + 1] = { "abuse", patch_abuse }
		steps[#steps + 1] = { "camera completion", function()
			coop_mods_core.set_limit(SCENE_END, 8, 2)
			coop_mods_core.on(SCENE_END, scene_end, "host")
		end }
	end
	for _, s in ipairs(steps) do
		local ok, err = pcall(s[2])
		if not ok then report("install " .. s[1], err) end
	end
end

local next_tick, asked_at = 0, -1

local function actor_on_update()
	local now = time_global()
	if now < next_tick then return end
	next_tick = now + 250
	if not installed then return end
	if routed_tutorial and routed_tutorial.stop_pending and local_player_ui(db.actor)
		and (not coop_mode.is_player_mirror() or P.client_live()) then
		run_routed_tutorial("stop_tutorial", routed_tutorial.source, xr_effects.stop_tutorial, db.actor, nil, {}, true)
	end
	if P.client_live() then
		if asked_at < 0 or (now - asked_at > 60000 and next(pending) ~= nil) then
			asked_at = now
			client_request(nil)
		end
		if next(pending) ~= nil then client_retry_pending() end
	elseif not P.active() then
		asked_at = -1
		pending = {}
	end
end

local function reply_sections(t, from)
	if t.i == nil then
		host_send_all(from)
		return
	end
	local id = coop_mods_core and coop_mods_core.lid(t.i) or t.i
	local st = id and db.storage[id]
	if st and st.stype == STYPE_RESTRICTOR and st.coop_local == false then
		P.send(EV_SECTION, section_packet(id, st.active_section, st.coop_cutscene), from)
	end
end

local function register_events()
	P.on(EV_SECTION, function(t) client_on_section(t.i, t.s, t.q, t.a, t.k) end, "client", TAG)
	P.on(EV_ALL, function(t)
		local n = tonumber(t.n) or 0
		for k = 1, math.min(n, CHUNK) do client_on_section(t["i" .. k], t["s" .. k]) end
	end, "client", TAG)
	P.on(EV_FX, client_on_fx, "client", TAG)
	P.on(EV_PAD, client_on_pad, "client", TAG)
	P.on(EV_PAD_CODE, host_on_pad_code, "host", TAG)
	P.on(EV_VISE, client_on_vise, "client", TAG)
	if coop_mode and coop_trust then
		-- Existing npc.logic_req wire name. Use the same transport identity and map delivery as the new verbs.
		coop_mode.on_level_request(EV_REQ, function(payload, from)
			local t = P.decode(payload)
			local valid = t.i == nil or bounded_int(t.i, 0, MAX_OBJECT_ID)
			if not coop_trust.pass("npc_logic_req_shape", valid, "peer %s: invalid logic state request", tostring(from)) then return end
			local here = coop_mode.decider(from) == "this"
			if not coop_trust.pass("npc_logic_req_map", here, "peer %s: logic state requested on another map", tostring(from)) then return end
			if valid and here then reply_sections(t, from) end
		end, function(_, from)
			local valid = type(from) == "number" and from > 0
			return coop_trust.pass("npc_logic_req_sender", valid, "peer %s: invalid logic request sender", tostring(from)) and valid
		end)
	else
		P.on(EV_REQ, reply_sections, "host", TAG)
	end
end

function print_status()
	local n_rep, n_loc = 0, 0
	for _, st in pairs(db.storage or {}) do
		if type(st) == "table" and st.stype == STYPE_RESTRICTOR then
			if st.coop_local == false then n_rep = n_rep + 1 elseif st.coop_local then n_loc = n_loc + 1 end
		end
	end
	local n_pend = 0
	for _ in pairs(pending) do n_pend = n_pend + 1 end
	log("installed %s, restrictors replicated %d local %d | team switches %d, sections out %d in %d pending %d, refused %d | effects out %d in %d | healed %d | errors %d",
		tostring(installed), n_rep, n_loc, stats.switched_team, stats.sections_out, stats.sections_in, n_pend,
		stats.refused, stats.fx_out, stats.fx_in, stats.healed, P.error_count(TAG))
end

function on_game_start()
	coop_util.add_status("coop_npc_logic", 130)
	P = coop_npc_players
	if not rawget(_G, "coop") then return end -- exe without co-op: nothing to do
	local ok, err = pcall(install)
	if not ok then report("install", err) end
	register_events()
	RegisterScriptCallback("actor_on_update", actor_on_update)
end

-- Tests and diagnostics.
function _state() return { pending = pending, stats = stats, ctx = ctx } end
