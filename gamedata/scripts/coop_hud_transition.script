--[[
	Anomaly Coop - the waiting point of a level change (gamedata\scripts\coop_hud_transition.script). Picture:
	docs\hud\transition_wait_mockup.png (the HUD's style: white, flat, 1 px shadow, the players' palette colours). Layout:
	configs\ui\ui_coop_transition.xml (+ _16: textures and fonts only), strings st_coop_transition_*; every size is in DEFAULTS
	below (px at 768 high, never stretched; a [coop_hud_transition] <key> = <number> line in any ltx wins).

	The whole group changes level together. A player who stands in the zone of an exit (or in a
	route restrictor that leads into it, scripts\coop_transition_route.script) is ready for it; the group goes the moment every
	player who is in the world and alive is ready for the same exit, however long that takes (no waiting
	timer); a player who is still loading holds it for a minute at most. A player who is NOT at the exit may hold the use key:
	he goes with the group from where he is. The rules and the host's board are the engine's (engine\src\xrCoop\
	coop_transition.h, coop_join.cpp); this script only shows them and darkens the screen at the go:

	  coop.transition() -> nil | { state "waiting" | "going", kind "exit" | "guide", level (stock name), changer, ready,
	    total, load_ms (left of the loaders' minute), rows = { { peer, mark "ready" | "away" | "loading" | "down" |
	    "elsewhere", dist (m), other (true: on another map), consent (true: he comes along from afar) }, ... },
	    me = { peer, host, in_zone, ready, dist, confirm, consent }, pos = { x, y, z } }
	  polled every frame; nil when nobody waits.

	1. The board (me at the exit, coming along, a guide trip, or the go): top centre under the compass: the small caps head,
	   the level's name, the count "2 / 3" on the right, the status line, a segment per player the count counts (white: ready;
	   not one for a player who is not waited for), a row per player (a 2 px stripe and the nick in his palette colour,
	   bright when ready, dimmer when not; on the right "here" / "comes along" / the team panel's metres from me to him (
	   coop_core_hud.distance_text, the same words in the same frame; my own row: my metres to the exit) / "loading . 42 s" /
	   "not waited for" / "at another exit"), and the hint of the
	   key under a thin bar that fills while the key is held (1 s): coming along "hold [F] - cancel", a guide trip I have not
	   answered "hold [F] - agree", agreed "hold [F] - cancel". At the exit there is no key: he withdraws by stepping out.
	2. The reminder (somebody waits at an exit and I am not there): his nick in his colour, under it "waits for you at the
	   exit to <level> . N m", and the key: "hold [F] - go with the group". The commands: coop_transition_consent /
	   coop_transition_cancel / coop_transition_confirm (coop_console.cpp).
	3. The go (state "going", every player's board, the host player's too): "Everyone is here - moving" and the screen
	   darkens once (sleep_fade.ppe, the stock id of the route teleport and of ChangeLevel); the engine's load follows a second
	   later (transition::kGoFadeMs).
	4. The feed (the chat's system lines): "<nick> waits at the exit to <level>", "<nick> goes with the group to <level>".
	5. The compass: a source of coop_hud_markers ("transition"): the exit as a gate mark in the waiting player's colour,
	   labelled with his nick, above the allies' marks.
	Pools of statics made once with the window; nothing is created in a frame.

	For other scripts:
		coop_hud_transition.current() -> the last coop.transition() table, nil when nobody waits
		coop_hud_transition.get_window() -> the overlay while it is on the HUD
		coop_hud_transition.layout() -> the sizes in force

	With somebody on another map his row says the map, nobody can say yes from afar (the hint says who and where, the
	key does nothing), the group waits for him as long as it takes; the host's board is what decides, this only shows it.

	A yes from afar has a fare (scripts\coop_transition_fare.script, the world's rule transition_fare): the hint
	of "go with the group" / "agree" names the price, a player without the money cannot send the key's command, and the fare is
	taken at the go. This script asks that one for the hint's text, before the command and every frame; without it nothing changes.
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall
local math_floor, math_ceil, math_max, math_min = math.floor, math.ceil, math.max, math.min
local string_format = string.format

local K = coop_hud_kit
local el, put, show, tint, new_text, text_set, text_place, text_show = K.el, K.put, K.show, K.tint, K.new_text, K.text_set,
	K.text_place, K.text_show
local alpha_step, metrics, live, hud_visible, my_peer = K.alpha_step, K.metrics, K.live, K.hud_visible, K.my_peer
local is_use_key = coop_hud_hold.is_use_key
local tr = coop_util.tr_nonempty
local nick_of = K.nick_labels(500) -- the session's nicks, read twice a second

XML_FILE = "ui_coop_transition.xml"
SECTION = "coop_hud_transition"
MAX_ROWS = 8 -- the session's players (kMaxPlayers)
CX = 512 -- the middle of the screen, in 1024x768 units
FEED_GAP_MS = 10000 -- a player who steps in and out is announced once in this time
HOLD_MS = { consent = 1000, cancel = 1000, confirm = 1000 }
-- A modpack may hand every key to on_before_key_press first (level_input.script) and a mod may take it there: then
-- on_key_press never comes ("the key is not held, it is pressed once"). The key's
-- hold events (on_key_hold, every frame while it is down) start and keep the hold as well; when they stop this long
-- (its release went to another script) the hold is over. A moment without the HUD under the held key (a window
-- flashing up) is not the end of it either: only this long.
HOLD_GAP_MS = 300
COMMANDS = { consent = "coop_transition_consent", cancel = "coop_transition_cancel", confirm = "coop_transition_confirm" }
MARK_PRIORITY = 35 -- on the compass: above the allies (30), under a wounded ally (40)
FADE_PPE = "sleep_fade.ppe" -- the go: the darkening of ui_sr_teleport and _g.ChangeLevel
FADE_ID = 1313 -- their effector id: one darkening, never two on top of each other

local C_WHITE = { 244, 245, 246 }
local C_DIM = { 175, 177, 175 } -- the head and the hint
local C_AMBER = { 240, 176, 76 } -- a player who is loading
local C_MUTED = { 150, 152, 146 }
local C_BG = { 12, 13, 10 } -- the compass bar's panel
local TONE = { ready = C_WHITE, dim = C_DIM, amber = C_AMBER, muted = C_MUTED }

-- Every size; configs\mod_system_*.ltx [coop_hud_transition] <key> = <number> wins (the same numbers).
DEFAULTS = {
	width = 300, top = 72, pad_x = 26, pad_y = 8, bg_alpha = 0.40,
	icon = 12, head_h = 12, head_x = 16, level_y = 13, level_h = 20, slot_w = 60, slot_y = 15,
	status_y = 37, status_h = 14, seg_y = 55, seg_w = 22, seg_h = 4, seg_gap = 4, seg_off_alpha = 0.18,
	rows_y = 66, row_h = 15, stripe_w = 2, stripe_h = 12, nick_x = 8, nick_w = 150, state_w = 150,
	bar_gap = 6, bar_h = 2, hint_gap = 3, hint_h = 12,
	remind_w = 420, remind_nick_h = 18, remind_line_h = 14, remind_pad_x = 40,
	dim_alpha = 0.75, text_dim_alpha = 0.85, track_alpha = 0.18,
	fade_in_ms = 150, fade_out_ms = 150,
}

local lay
local stats = { polled = 0, shown = 0, spoken = 0, holds = 0, errors = 0, fades = 0 }
local last_t -- the last coop.transition()
local WIN -- the overlay while it is on the HUD
local faded = false -- the screen darkened for the go that runs now
local fare_failed = false -- the fare's step failed: logged once
local feed_prev -- the board the feed lines were last made against
local feed_rate = { at = {}, now = 0 }

local log = coop_util.logger("[coop-hud]")

-- The use key held away from the exit, or in a guide trip (hold.kind: the hint it answers). A hold that ends before its
-- command went out goes to the log (the live tests read it: "it is pressed once").
local H = coop_hud_hold.new(HOLD_GAP_MS, function(hold, tg, why)
	log("transition: the use key hold (%s) ended after %d ms, nothing sent: %s", hold.kind, tg - hold.since, why)
end)

-------------------------------------------------------------------------------
-- Layout table
-------------------------------------------------------------------------------
local function read_number(ini, key)
	local ok, v = pcall(function()
		if ini:section_exist(SECTION) and ini:line_exist(SECTION, key) then return ini:r_string(SECTION, key) end
	end)
	if not (ok and type(v) == "string") then return nil end
	v = tonumber(v:match("^%s*([%-%d%.]+)"))
	if v and v == v and v > -1000 and v < 4000 then return v end
	return nil
end

function reload()
	local t = {}
	local ini = rawget(_G, "ini_sys")
	if not ini then
		local ok, sys = pcall(function() return system_ini() end)
		ini = ok and sys or nil
	end
	for k, def in pairs(DEFAULTS) do
		t[k] = ini and read_number(ini, k) or def
	end
	lay = t
	return t
end

function layout()
	return lay or reload()
end

-------------------------------------------------------------------------------
-- Engine glue
-------------------------------------------------------------------------------
local function poll()
	if not (api and api.transition) then return nil end
	local ok, t = pcall(api.transition)
	if not ok then
		stats.errors = stats.errors + 1
		return nil
	end
	stats.polled = stats.polled + 1
	if type(t) ~= "table" then return nil end
	return t
end

local function say(text)
	local chat = rawget(_G, "coop_core_chat")
	if chat and chat.system then pcall(chat.system, text) end
	stats.spoken = stats.spoken + 1
end

-------------------------------------------------------------------------------
-- Pure parts (the tests call them)
-------------------------------------------------------------------------------
-- The level's name: the string table has the stock names (st_levels.xml: "l01_escape" = Cordon); a mod's level shows its own.
function level_title(level)
	if type(level) ~= "string" or level == "" then return "?" end
	return tr(level, level)
end

function head_text(t)
	if t and t.kind == "guide" then return tr("st_coop_transition_head_guide", "TRANSITION . GUIDE") end
	return tr("st_coop_transition_head", "TRANSITION")
end

function count_text(t)
	return string_format("%d / %d", tonumber(t and t.ready) or 0, tonumber(t and t.total) or 0)
end

function status_text(t)
	if t and t.state == "going" then return tr("st_coop_transition_all_here", "Everyone is here - moving") end
	if t and t.kind == "guide" then return tr("st_coop_transition_waiting_guide", "Waiting for your allies' answer") end
	return tr("st_coop_transition_waiting", "Waiting for allies")
end

local function dist_text(d)
	d = tonumber(d)
	if not d or d ~= d or d < 0 then return "..." end
	return string_format(tr("st_coop_transition_row_dist", "%d m"), math_floor(d + 0.5))
end

-- The metres of a row are the team panel's: coop_core_hud.
-- distance_text, from me to him, from the panel's view of this frame and in its words, so the two windows never give two numbers
-- for one player (the engine's row metres are to the exit's shapes, as the host sees him). My own row (in the zone before the
-- board has me ready) has no row on the panel: my metres to the exit, this machine's (me.dist, the reminder line's). Without the
-- panel's script (an exe or a test without it) the engine's metres.
local function row_dist(r, t)
	local me = type(t) == "table" and type(t.me) == "table" and t.me or nil
	local peer = tonumber(r.peer)
	if me and peer and peer == tonumber(me.peer) then return dist_text(me.dist) end
	local H = rawget(_G, "coop_core_hud")
	if type(H) == "table" and type(H.distance_text) == "function" then
		local ok, s = pcall(H.distance_text, peer)
		if ok and type(s) == "string" and s ~= "" then return s end
		return "..."
	end
	return dist_text(r.dist)
end

-- The map names and gates available to this process.
local function levels_module()
	local read = coop_mode.hook("levels.module")
	if not read then return nil end
	local ok, v = pcall(read)
	return ok and type(v) == "table" and v or nil
end

local FARE = "coop_transition_fare" -- the fare of a yes from afar

-- text: the hint of "consent" / "confirm"; with a fare it names the price, or what the player lacks.
local function with_fare(kind, t, text)
	local F = coop_util.module(FARE)
	if not (F and F.hint) then return text end
	local ok, s = pcall(F.hint, kind, t, text)
	return ok and type(s) == "string" and s or text
end

-- The name of the map player `peer` stands on; nil if unknown.
local function map_of(peer)
	local L = levels_module()
	if not (L and L.map_of) then return nil end
	local ok, name = pcall(L.map_of, peer)
	return ok and name or nil
end

-- The row of somebody who stands on another map and is waited for, nil if nobody does: a dead one is not waited for.
local function away_row(t)
	for _, r in ipairs(t and t.rows or {}) do
		if type(r) == "table" and r.other == true and r.mark ~= "down" then return r end
	end
	return nil
end

-- What a row says on the right and how it is toned.
local function row_state(r, t)
	local mark = r.mark
	local guide = t and t.kind == "guide"
	if r.other == true and mark ~= "down" then
		local where = map_of(r.peer)
		if where then return string_format(tr("st_coop_transition_row_map", "on %s"), where), "dim" end
		return tr("st_coop_together_row_other", "on another map"), "dim"
	end
	if mark == "ready" then
		if guide then
			if tonumber(r.peer) == 0 then return tr("st_coop_transition_row_asked", "asked"), "ready" end
			return tr("st_coop_transition_row_agreed", "agreed"), "ready"
		end
		if r.consent == true then return tr("st_coop_transition_row_consent", "comes along"), "ready" end
		return tr("st_coop_transition_row_ready", "here"), "ready"
	elseif mark == "loading" then
		local left = tonumber(t and t.load_ms) or 0
		if left > 0 then
			return string_format(tr("st_coop_transition_row_loading_left", "loading . %d s"), math_ceil(left / 1000)), "amber"
		end
		return tr("st_coop_transition_row_loading", "loading"), "amber"
	elseif mark == "down" then
		return tr("st_coop_transition_row_down", "not waited for"), "muted"
	elseif mark == "elsewhere" then
		return tr("st_coop_transition_row_elsewhere", "at another exit"), "dim"
	end
	if guide then return tr("st_coop_transition_row_wait", "no answer yet"), "dim" end
	return row_dist(r, t), "dim"
end

-- The rows of the board: { peer, nick, rgb, text, tone, ready }, at most MAX_ROWS.
function row_texts(t)
	local out = {}
	for _, r in ipairs(t and t.rows or {}) do
		if #out >= MAX_ROWS then break end
		if type(r) == "table" and tonumber(r.peer) then
			local text, tone = row_state(r, t)
			out[#out + 1] = {
				peer = tonumber(r.peer), nick = nick_of(r.peer), rgb = K.peer_color(r.peer, C_WHITE),
				text = text, tone = tone, ready = r.mark == "ready",
			}
		end
	end
	return out
end

-- The board is for a player at the exit (or ready for it, or coming along), for everybody in a guide trip, which has no exit
-- to stand at, and for everybody when the group goes.
function shows_board(t)
	if type(t) ~= "table" then return false end
	if t.kind == "guide" or t.state == "going" then return true end
	local me = t.me
	return type(me) == "table" and (me.in_zone == true or me.ready == true or me.consent == true)
end

-- Who waits at the exit for me (the others who are ready), first by player id.
local function waiting_others(t)
	local out = {}
	local me = type(t) == "table" and t.me or nil
	local mine = me and tonumber(me.peer) or my_peer()
	for _, r in ipairs(t and t.rows or {}) do
		if type(r) == "table" and r.mark == "ready" and tonumber(r.peer) and tonumber(r.peer) ~= mine then out[#out + 1] = tonumber(r.peer) end
	end
	return out
end

-- The use key held (only by those who are NOT at the exit): "consent" (away from the exit somebody waits
-- at: go with the group), "cancel" (coming along, or agreed to a guide trip: not any more), "confirm" (a guide trip I have not
-- answered), "blocked" (the same two while somebody is on another map: nothing to hold, the hint says who and where), nil (at the
-- exit: he steps out to withdraw; the go; nobody waits).
function hint_kind(t)
	local me = type(t) == "table" and t.me or nil
	if type(me) ~= "table" or t.state == "going" then return nil end
	if t.kind == "guide" then
		if me.ready then return "cancel" end
		if me.confirm then return away_row(t) and "blocked" or "confirm" end
		return nil
	end
	if me.in_zone then return nil end
	if me.ready or me.consent then return "cancel" end
	if #waiting_others(t) > 0 then return away_row(t) and "blocked" or "consent" end
	return nil
end

function hold_ms(kind)
	return HOLD_MS[kind]
end

function hint_text(kind, t)
	if kind == "blocked" then
		local r = away_row(t)
		local where = r and map_of(r.peer) or tr("st_coop_together_row_other", "on another map")
		return string_format(tr("st_coop_transition_hint_blocked", "cannot agree yet: %s is on %s"), r and nick_of(r.peer) or "?", where)
	end
	if kind == "consent" then return with_fare(kind, t, tr("st_coop_transition_hint_consent", "hold [F] - go with the group")) end
	if kind == "cancel" then return tr("st_coop_transition_hint_cancel", "hold [F] - cancel") end
	if kind == "confirm" then return with_fare(kind, t, tr("st_coop_transition_hint_confirm", "hold [F] - agree")) end
	return ""
end

-- The reminder of a player who is not at the exit: { nick, rgb, text } or nil.
function reminder(t)
	if type(t) ~= "table" or t.kind ~= "exit" or shows_board(t) then return nil end
	local others = waiting_others(t)
	if #others == 0 then return nil end
	local nick = nick_of(others[1])
	if #others > 1 then nick = string_format(tr("st_coop_transition_remind_more", "%s and %d more"), nick, #others - 1) end
	local level = level_title(t.level)
	local d = tonumber(t.me and t.me.dist)
	local text
	local mine = type(t.me) == "table" and tonumber(t.me.peer) or nil
	local i_am_away = false
	for _, r in ipairs(t.rows or {}) do
		if type(r) == "table" and r.other == true and tonumber(r.peer) == mine then i_am_away = true end
	end
	if i_am_away then
		text = string_format(tr("st_coop_transition_remind_map", "waits for everybody on %s to go on to %s"), map_of(others[1]) or "?", level)
	elseif d and d == d and d >= 0 then
		text = string_format(tr("st_coop_transition_remind", "waits for you at the exit to %s . %d m"), level, math_floor(d + 0.5))
	else
		text = string_format(tr("st_coop_transition_remind_far", "waits for you at the exit to %s"), level)
	end
	return { nick = nick, rgb = K.peer_color(others[1], C_WHITE), text = text }
end

-- The feed lines this step makes: who got ready (at the exit, or coming along from afar). `rate` (the live feed): a player is
-- announced once in FEED_GAP_MS ({ at = { [peer] = ms }, now = ms }); without it every news is told. No countdown, so nothing
-- is ever cancelled: a player who steps back is simply waited for again (the rows say it). No news: one shared empty list
-- (read only).
local NO_LINES = {}

function feed_events(prev, cur, who, rate)
	local out = NO_LINES
	if type(cur) == "table" then
		local same = type(prev) == "table" and prev.level == cur.level and prev.kind == cur.kind
		for _, r in ipairs(cur.rows or {}) do
			if type(r) == "table" and r.mark == "ready" and tonumber(r.peer) and tonumber(r.peer) ~= tonumber(who) then
				local was = false
				if same then
					for _, p in ipairs(prev.rows or {}) do
						if type(p) == "table" and p.peer == r.peer and p.mark == "ready" then was = true end
					end
				end
				local peer = tonumber(r.peer)
				if not was and (not rate or not rate.at[peer] or rate.now - rate.at[peer] >= FEED_GAP_MS or rate.now < rate.at[peer]) then
					if rate then rate.at[peer] = rate.now end
					local id, fb = "st_coop_transition_feed_waits", "%s waits at the exit to %s"
					if cur.kind == "guide" then
						id, fb = "st_coop_transition_feed_guide", "%s suggests moving to %s (guide)"
					elseif r.consent == true then
						id, fb = "st_coop_transition_feed_consent", "%s goes with the group to %s"
					end
					if out == NO_LINES then out = {} end
					out[#out + 1] = string_format(tr(id, fb), nick_of(peer), level_title(cur.level))
				end
			end
		end
	end
	return out
end

-- The compass mark of the exit somebody waits at (coop_hud_markers' shape), as a list.
function marks(t)
	if type(t) ~= "table" or t.kind ~= "exit" or type(t.pos) ~= "table" or shows_board(t) then return {} end
	local others = waiting_others(t)
	if #others == 0 then return {} end
	local x, y, z = tonumber(t.pos.x), tonumber(t.pos.y), tonumber(t.pos.z)
	if not (x and y and z) then return {} end
	return { { key = "exit", kind = "transition", pos = { x = x, y = y, z = z }, color = K.peer_color(others[1], C_WHITE),
		label = nick_of(others[1]),
		state = "waiting", priority = MARK_PRIORITY, range = 0 } }
end

-------------------------------------------------------------------------------
-- The overlay
-------------------------------------------------------------------------------
-- How far the use key is held for the hint `kind`: 0..1 (0: not held, or its command went out already).
local function hold_fraction(tg, kind)
	local hold = H.hold
	if not (hold and hold.kind == kind) then return 0 end
	return H:fraction(tg, hold_ms(kind))
end

class "UICoopTransition" (CUIScriptWnd)

function UICoopTransition:__init() super()
	local xml = CScriptXmlInit()
	xml:ParseFile(XML_FILE)
	self.root = xml:InitStatic("coop_transition", self)
	self.g_board = xml:InitStatic("coop_transition:group", self.root)
	self.g_remind = xml:InitStatic("coop_transition:group", self.root)
	-- the board
	self.bg = el(xml:InitStatic("coop_transition:bg", self.g_board))
	self.icon = el(xml:InitStatic("coop_transition:icon", self.g_board))
	self.t_head = new_text(xml, self.g_board, "coop_transition:head")
	self.t_level = new_text(xml, self.g_board, "coop_transition:level")
	self.t_slot = new_text(xml, self.g_board, "coop_transition:slot")
	self.t_status = new_text(xml, self.g_board, "coop_transition:line")
	self.segs = {}
	for i = 1, MAX_ROWS do self.segs[i] = el(xml:InitStatic("coop_transition:seg", self.g_board)) end
	self.rows = {}
	for i = 1, MAX_ROWS do
		self.rows[i] = {
			stripe = el(xml:InitStatic("coop_transition:stripe", self.g_board)),
			nick = new_text(xml, self.g_board, "coop_transition:line"),
			state = new_text(xml, self.g_board, "coop_transition:line_r"),
		}
	end
	self.bar_track = el(xml:InitStatic("coop_transition:bar", self.g_board))
	self.bar_fill = el(xml:InitStatic("coop_transition:bar", self.g_board))
	self.t_hint = new_text(xml, self.g_board, "coop_transition:hint")
	-- the reminder
	self.rbg = el(xml:InitStatic("coop_transition:bg", self.g_remind))
	self.t_rnick = new_text(xml, self.g_remind, "coop_transition:remind_nick")
	self.t_rline = new_text(xml, self.g_remind, "coop_transition:remind_line")
	self.r_bar_track = el(xml:InitStatic("coop_transition:bar", self.g_remind))
	self.r_bar_fill = el(xml:InitStatic("coop_transition:bar", self.g_remind))
	self.t_rhint = new_text(xml, self.g_remind, "coop_transition:remind_hint")
	self.g_board:Show(false)
	self.g_remind:Show(false)
	self.shown_board, self.shown_remind = false, false
	self.a_board, self.a_remind = 0, 0
	self.bv, self.rv = nil, nil -- what the group shows (kept while it fades out)
end

function UICoopTransition:__finalize()
end

-- The board.
function UICoopTransition:FrameBoard(tg, dt, t, m, L)
	if t then self.bv = t end
	local bv = self.bv
	local a = alpha_step(self.a_board, t and 1 or 0, dt, L.fade_in_ms, L.fade_out_ms)
	self.a_board = a
	if a <= 0 or not bv then
		if self.shown_board then
			self.g_board:Show(false)
			self.shown_board = false
			if not t then self.bv = nil end
		end
		return
	end
	if not self.shown_board then
		self.g_board:Show(true)
		self.shown_board = true
	end
	local kx = m.kx
	local Wd = L.width * kx
	local x0 = CX - Wd / 2
	local x1 = x0 + Wd
	local top = L.top
	local rows = row_texts(bv)
	local n = #rows
	local kind = hint_kind(bv)
	local rows_bottom = top + L.rows_y + n * L.row_h
	local bar_y = rows_bottom + L.bar_gap
	local hint_y = bar_y + L.bar_h + L.hint_gap
	local bottom = kind and (hint_y + L.hint_h) or rows_bottom
	-- the soft panel
	put(self.bg, x0 - L.pad_x * kx, top - L.pad_y, Wd + 2 * L.pad_x * kx, bottom - top + 2 * L.pad_y)
	tint(self.bg, 255 * L.bg_alpha * a, C_BG)
	show(self.bg, true)
	-- the gate glyph and the head
	put(self.icon, x0, top, L.icon * kx, L.icon)
	tint(self.icon, 204 * a, C_WHITE)
	show(self.icon, true)
	text_place(self.t_head, x0 + L.head_x * kx, top, 240 * kx, L.head_h, m)
	text_set(self.t_head, head_text(bv), 217 * a, C_DIM)
	text_show(self.t_head, true)
	text_place(self.t_level, x0, top + L.level_y, 240 * kx, L.level_h, m)
	text_set(self.t_level, level_title(bv.level), 255 * a, C_WHITE)
	text_show(self.t_level, true)
	-- the count on the right (no countdown: the group goes the moment it is full)
	text_place(self.t_slot, x1 - L.slot_w * kx, top + L.slot_y, L.slot_w * kx, L.level_h, m)
	text_set(self.t_slot, count_text(bv), 255 * a, C_WHITE)
	text_show(self.t_slot, true)
	text_place(self.t_status, x0, top + L.status_y, 240 * kx, L.status_h, m)
	text_set(self.t_status, status_text(bv), 217 * a, C_WHITE)
	text_show(self.t_status, true)
	-- a segment per player the count counts (bv.total: the group waits for him), white when ready, dim when not: none for
	-- a dead player, whom the group does not wait for
	local total = math_min(MAX_ROWS, math_max(0, math_floor(tonumber(bv.total) or 0)))
	for i = 1, MAX_ROWS do
		local s = self.segs[i]
		if i <= total then
			put(s, x0 + (i - 1) * (L.seg_w + L.seg_gap) * kx, top + L.seg_y, L.seg_w * kx, L.seg_h)
			local on = i <= (tonumber(bv.ready) or 0)
			tint(s, 255 * a * (on and 1 or L.seg_off_alpha), C_WHITE)
			show(s, true)
		else
			show(s, false)
		end
	end
	-- the players
	for i = 1, MAX_ROWS do
		local r, row = rows[i], self.rows[i]
		if r then
			local y = top + L.rows_y + (i - 1) * L.row_h
			put(row.stripe, x0, y + 1, L.stripe_w * kx, L.stripe_h)
			local ra = r.ready and 1 or L.dim_alpha
			tint(row.stripe, 255 * a * ra, r.rgb)
			show(row.stripe, true)
			text_place(row.nick, x0 + L.nick_x * kx, y, L.nick_w * kx, L.row_h - 1, m)
			text_set(row.nick, r.nick, 255 * a * ra, r.rgb)
			text_show(row.nick, true)
			text_place(row.state, x1 - L.state_w * kx, y, L.state_w * kx, L.row_h - 1, m)
			text_set(row.state, r.text, 255 * a * (r.tone == "ready" and 1 or L.text_dim_alpha), TONE[r.tone] or C_DIM)
			text_show(row.state, true)
		else
			show(row.stripe, false)
			text_show(row.nick, false)
			text_show(row.state, false)
		end
	end
	-- the hold of the key: the hint and the bar over it
	if kind then
		put(self.bar_track, x0, bar_y, Wd, L.bar_h)
		tint(self.bar_track, 255 * a * L.track_alpha, C_WHITE)
		show(self.bar_track, true)
		local f = hold_fraction(tg, kind)
		if f > 0 then
			put(self.bar_fill, x0, bar_y, Wd * f, L.bar_h)
			tint(self.bar_fill, 255 * a, C_WHITE)
			show(self.bar_fill, true)
		else
			show(self.bar_fill, false)
		end
		text_place(self.t_hint, x0, hint_y, Wd, L.hint_h, m)
		text_set(self.t_hint, hint_text(kind, bv), 217 * a, C_DIM)
		text_show(self.t_hint, true)
	else
		show(self.bar_track, false)
		show(self.bar_fill, false)
		text_show(self.t_hint, false)
	end
end

-- The reminder.
function UICoopTransition:FrameRemind(tg, dt, rem, m, L)
	if rem then self.rv = rem end
	local rv = self.rv
	local a = alpha_step(self.a_remind, rem and 1 or 0, dt, L.fade_in_ms, L.fade_out_ms)
	self.a_remind = a
	if a <= 0 or not rv then
		if self.shown_remind then
			self.g_remind:Show(false)
			self.shown_remind = false
			if not rem then self.rv = nil end
		end
		return
	end
	if not self.shown_remind then
		self.g_remind:Show(true)
		self.shown_remind = true
	end
	local kx = m.kx
	local w = L.remind_w * kx
	local kind = rv.kind -- the key: hold to go with the group
	local bar_y = L.top + L.remind_nick_h + L.remind_line_h + L.bar_gap
	local hint_y = bar_y + L.bar_h + L.hint_gap
	local h = kind and (hint_y + L.hint_h - L.top) or (L.remind_nick_h + L.remind_line_h)
	put(self.rbg, CX - w / 2 - L.remind_pad_x * kx, L.top - L.pad_y, w + 2 * L.remind_pad_x * kx, h + 2 * L.pad_y)
	tint(self.rbg, 255 * L.bg_alpha * a, C_BG)
	show(self.rbg, true)
	text_place(self.t_rnick, CX - w / 2, L.top, w, L.remind_nick_h, m)
	text_set(self.t_rnick, rv.nick, 255 * a, rv.rgb)
	text_show(self.t_rnick, true)
	text_place(self.t_rline, CX - w / 2, L.top + L.remind_nick_h, w, L.remind_line_h, m)
	text_set(self.t_rline, rv.text, 217 * a, C_WHITE)
	text_show(self.t_rline, true)
	if kind then
		local bw = L.width * kx -- the board's column, centred
		put(self.r_bar_track, CX - bw / 2, bar_y, bw, L.bar_h)
		tint(self.r_bar_track, 255 * a * L.track_alpha, C_WHITE)
		show(self.r_bar_track, true)
		local f = hold_fraction(tg, kind)
		if f > 0 then
			put(self.r_bar_fill, CX - bw / 2, bar_y, bw * f, L.bar_h)
			tint(self.r_bar_fill, 255 * a, C_WHITE)
			show(self.r_bar_fill, true)
		else
			show(self.r_bar_fill, false)
		end
		text_place(self.t_rhint, CX - w / 2, hint_y, w, L.hint_h, m)
		text_set(self.t_rhint, hint_text(kind, rv.t), 217 * a, C_DIM)
		text_show(self.t_rhint, true)
	else
		show(self.r_bar_track, false)
		show(self.r_bar_fill, false)
		text_show(self.t_rhint, false)
	end
end

-- The use key held: the command goes out when the hold is over, once.
local function run_hold(tg, t)
	local hold = H.hold
	local kind = hint_kind(t)
	if kind ~= hold.kind then
		-- the board changed under the key (gone, I stepped in, the engine took it: the hint is another now)
		H:drop(tg, string_format("the hint is %s now", tostring(kind)))
		return
	end
	if H:due(tg, hold_ms(kind)) then
		stats.holds = stats.holds + 1
		-- a yes from afar has a fare: without the money the command does not go (the player is told there); a cancel forgets it
		local F = coop_util.module(FARE)
		if F and (kind == "consent" or kind == "confirm") and F.agree then
			local ok, go = pcall(F.agree, t)
			if ok and go == false then
				log("transition: the use key held %d ms: %s not sent, the fare is more than he has", tg - hold.since, COMMANDS[kind])
				return
			end
		elseif F and kind == "cancel" and F.withdraw then
			pcall(F.withdraw)
		end
		log("transition: the use key held %d ms: %s", tg - hold.since, COMMANDS[kind])
		pcall(exec_console_cmd, COMMANDS[kind])
	end
end

-- Every frame: the hold on the board itself (not on what the HUD shows this frame).
function step_hold(tg, raw)
	if not H:key_step(tg) then return end
	if not (raw and (shows_board(raw) or reminder(raw))) then
		H:drop(tg, "the placard is gone")
		return
	end
	if H:hidden_step(tg, hud_visible(), "the HUD is hidden (an inventory, a menu)") then return end
	run_hold(tg, raw)
end

-- The go: the screen darkens once (every moving player, the host player too: the board's Going state reaches all of them);
-- the engine's level change follows transition::kGoFadeMs later. The stock effector of the route teleport and ChangeLevel.
local function fade_for_the_go(trip)
	local lv = rawget(_G, "level")
	if not (lv and lv.add_pp_effector) then return end
	-- a trip left the stock callback out with its fade (coop_transition_route): the world server's scripts hear it now
	local send = rawget(_G, "SendScriptCallback")
	if trip and send and api and api.is_active() and coop_mode.decides_world() then
		pcall(send, "on_before_level_changing")
	end
	local ok, err = pcall(lv.add_pp_effector, FADE_PPE, FADE_ID, false)
	if ok then
		stats.fades = stats.fades + 1
	else
		stats.errors = stats.errors + 1
		log("! transition: the darkening of the go failed: %s", tostring(err))
	end
end

function UICoopTransition:Frame(tg)
	local m = metrics()
	local L = layout()
	local dt = self.last_tg and tg >= self.last_tg and tg - self.last_tg or 0
	self.last_tg = tg
	local raw = poll()
	last_t = raw
	-- the feed: what changed since the last board (whether or not the HUD is on top of it)
	feed_rate.now = tg
	for _, line in ipairs(feed_events(feed_prev, raw, my_peer(), feed_rate)) do say(line) end
	feed_prev = raw
	-- the fare of a yes from afar is taken at the go (and forgotten when nobody waits any more)
	local F = coop_util.module(FARE)
	if F and F.step then
		local ok, err = pcall(F.step, raw)
		if not ok and not fare_failed then
			fare_failed = true
			stats.errors = stats.errors + 1
			log("! transition: the fare's step failed: %s", tostring(err))
		end
	end
	-- the go darkens the screen whatever is open on top of the HUD (once a go)
	if raw and raw.state == "going" then
		if not faded then
			faded = true
			fade_for_the_go(raw.kind == "guide")
		end
	else
		faded = false
	end
	local t = raw
	if t and not hud_visible() then t = nil end -- the inventory, the PDA, a scope: no overlay on top
	local board = t and shows_board(t) and t or nil
	local rem = t and reminder(t) or nil
	if rem then rem.kind, rem.t = hint_kind(t), t end
	if board then stats.shown = stats.shown + 1 end
	step_hold(tg, raw)
	self:FrameBoard(tg, dt, board, m, L)
	self:FrameRemind(tg, dt, rem, m, L)
end

function UICoopTransition:Update()
	CUIScriptWnd.Update(self)
	local tg = time_global()
	if self.off_until and tg < self.off_until then return end
	local M = rawget(_G, "coop_hud_markers")
	local pf = M and M.perf_start and M.perf_start("transition")
	local ok, err = pcall(self.Frame, self, tg)
	if pf then M.perf_stop(pf) end
	if not ok then
		self.off_until = tg + 5000
		stats.errors = stats.errors + 1
		log("! transition overlay frame failed: %s", tostring(err))
	end
end

function get_window()
	return WIN
end

function current()
	return last_t
end

-- The key being held: { kind, fraction 0..1 } or nil (nothing held, or the command went out already).
function hold_state()
	local hold = H.hold
	if not hold or hold.fired then return nil end
	local ms = hold_ms(hold.kind)
	if not ms then return nil end
	return { kind = hold.kind, fraction = H:fraction(time_global(), ms) }
end

local function win_on()
	if WIN then return end
	local ok, err = pcall(function()
		WIN = UICoopTransition()
		get_hud():AddDialogToRender(WIN)
	end)
	if not ok then
		WIN = nil
		log("! transition overlay failed: %s", tostring(err))
	end
end

local function win_off()
	if not WIN then return end
	local w = WIN
	WIN = nil
	pcall(function() get_hud():RemoveDialogToRender(w) end)
	last_t, feed_prev, faded = nil, nil, false
	H:reset()
end

-------------------------------------------------------------------------------
-- Callbacks
-------------------------------------------------------------------------------
-- A hold starts with the key going down under a placard that names it (the HUD on: an inventory owns the key).
local function start_hold(tg, how)
	if not H:may_start() or not WIN or not last_t or not hud_visible() then return end
	if not (shows_board(last_t) or reminder(last_t)) then return end -- a key only with a placard that names it
	local kind = hint_kind(last_t)
	if not (kind and hold_ms(kind)) then return end
	H:start(tg, kind)
	log("transition: the use key held (%s, from its %s)", kind, how)
end

local function on_key_press(dik)
	if not is_use_key(dik) then return end
	local tg = time_global()
	H:press(tg)
	start_hold(tg, "press")
end

-- Every frame while the key is down: it keeps the key known as down, and starts the hold when its press went to
-- another script.
local function on_key_hold(dik)
	if not is_use_key(dik) then return end
	local tg = time_global()
	H:hold_event(tg)
	start_hold(tg, "hold events")
end

local function on_key_release(dik)
	if not is_use_key(dik) then return end
	local tg = time_global()
	local hold = H.hold
	H:release(tg, hold and string_format("let go after %d ms", tg - hold.since))
end

local function actor_on_update()
	if live() then
		win_on()
	elseif WIN then
		win_off()
	end
end

local function actor_on_net_destroy()
	win_off()
end

-- coop_hud_markers' source: the exit somebody waits at (a gate mark in his colour, labelled with his nick).
local function marker_source()
	return marks(poll())
end

function print_status()
	log("transition: overlay %s, polled %d, board shown %d frames, spoken %d, key holds %d, darkened %d, errors %d | now: %s",
		WIN and "on" or "off", stats.polled, stats.shown, stats.spoken, stats.holds, stats.fades, stats.errors,
		last_t and (last_t.state .. " at " .. tostring(last_t.level) .. " " .. tostring(last_t.ready) .. "/" .. tostring(last_t.total)) or "-")
end

function on_game_start()
	if not api then return end -- an exe without co-op: nothing of this runs
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("on_key_press", on_key_press)
	RegisterScriptCallback("on_key_release", on_key_release)
	RegisterScriptCallback("on_key_hold", on_key_hold)
	local M = coop_util.module("coop_hud_markers")
	if M and M.add_source then
		local ok, err = pcall(M.add_source, "transition", marker_source, 200)
		if not ok then log("! transition: no compass source: %s", tostring(err)) end
	end
end
