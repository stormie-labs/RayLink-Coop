}

-------------------------------------------------------------------------------
-- Resolving a theme over the defaults
-------------------------------------------------------------------------------
local function log(fmt, ...)
	local pf = rawget(_G, "printf")
	if not pf then return end
	local ok, line = pcall(string.format, fmt, ...)
	pcall(pf, "%s", "[coop-theme] " .. (ok and line or tostring(fmt)))
end

local function copy(v)
	if type(v) ~= "table" then return v end
	local out = {}
	for k, x in pairs(v) do out[k] = copy(x) end
	return out
end

local function is_color(v)
	if type(v) ~= "table" or (#v ~= 3 and #v ~= 4) then return false end
	for i = 1, 3 do
		if type(v[i]) ~= "number" or v[i] < 0 or v[i] > 255 then return false end
	end
	if v[4] ~= nil and (type(v[4]) ~= "number" or v[4] < 0 or v[4] > 1) then return false end
	return true
end

-- { 1, 2, 3 } of numbers: a colour, a curve, a size. Only another list of as many numbers can take its place.
local function is_number_list(t)
	return type(t) == "table" and #t > 0 and type(t[1]) == "number"
end

local function same_list(v, def)
	if type(v) ~= "table" or #v ~= #def then return false end
	for i = 1, #def do
		if type(v[i]) ~= "number" then return false end
	end
	return true
end

-- Keys a pack fills itself: anything of the right type comes through.
local OPEN = { levels = true, known = true, fallback = true, register = true, base = true, open = true, first = true, captions = true, subs = true,
	arts = true, shade_strips = true }

local function merge(def, user, path)
	local out = copy(def)
	if user == nil then return out end
	if type(user) ~= "table" then
		log("! %s is not a table: the default stays", path)
		return out
	end
	for k, dv in pairs(def) do
		local uv = user[k]
		local p = path .. "." .. tostring(k)
		if uv == nil then
			-- stays
		elseif OPEN[k] and type(dv) == "table" then
			if type(uv) == "table" then out[k] = copy(uv) else log("! %s: the default stays", p) end
		elseif is_number_list(dv) then
			if same_list(uv, dv) then out[k] = copy(uv) else log("! %s: the default stays", p) end
		elseif type(dv) == "table" then
			out[k] = merge(dv, uv, p)
		elseif type(uv) == type(dv) and (type(uv) ~= "number" or uv >= 0 or dv < 0) then
			out[k] = uv
		else
			log("! %s: the default stays", p)
		end
	end
	return out
end

local function merge_colors(def, user)
	local out = copy(def)
	if type(user) ~= "table" then return out end
	for role, v in pairs(user) do
		if is_color(v) then
			out[role] = copy(v)
		else
			log("! colors.%s: the default stays", tostring(role))
		end
	end
	return out
end

local function merge_fonts(def, user)
	local out = merge(def, user, "fonts")
	for role, d in pairs(def.roles) do
		local r = out.roles[role]
		if type(r.name) ~= "string" then r.name = d.name end
		if type(r.stock) ~= "string" then r.stock = d.stock end
	end
	local user_roles = type(user) == "table" and type(user.roles) == "table" and user.roles or {}
	for role, r in pairs(user_roles) do -- a role of the pack's own
		if out.roles[role] == nil and type(r) == "table" and type(r.name) == "string" then out.roles[role] = copy(r) end
	end
	return out
end

-- A style names a colour role and a font role that exist; what does not exist stays the default's.
local function merge_text(def, user, colors, fonts)
	local out = copy(def)
	if type(user) ~= "table" then return out end
	for name, st in pairs(user) do
		if type(st) == "table" and out[name] then
			if colors[st.color] then out[name].color = st.color elseif st.color ~= nil then log("! text.%s.color: the default stays", tostring(name)) end
			if fonts.roles[st.font] then out[name].font = st.font elseif st.font ~= nil then log("! text.%s.font: the default stays", tostring(name)) end
		end
	end
	return out
end

function resolve(user)
	if type(user) ~= "table" then user = {} end
	local d = DEFAULTS
	local t = merge(d, user, "theme")
	t.colors = merge_colors(d.colors, user.colors)
	t.fonts = merge_fonts(d.fonts, user.fonts)
	t.text = merge_text(d.text, user.text, t.colors, t.fonts)
	return t
end

-- The theme of this game: coop_menu_theme.theme of the highest layer that has the script.
function load()
	local ok, m = pcall(function()
		local mod = rawget(_G, "coop_menu_theme")
		if mod == nil then mod = _G["coop_menu_theme"] end
		return mod
	end)
	if not ok then
		log("! the theme script does not load: %s", tostring(m))
		return resolve(nil)
	end
	return resolve(type(m) == "table" and m.theme or nil)
end
