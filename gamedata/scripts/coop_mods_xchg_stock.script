-- Ядро: без проверок режима (docs/MODES.md)
-- The stock portable container requests a hidden_box from the authority of the player's map.
-- The playing host has both the inventory and the saved link. A map authority checks the same inventory,
-- and economy.se carries the box's entity data to the world owner and the other maps.

local BOX = "hidden_box"
local KIND = "stock_box"
local LINK = "coop_stock_container_item" -- m_data.se_object[box id], value in host numbering
local NO_PARENT = 65535
local OPEN_MS = 10000
local NEAR_SQ = 5 ^ 2 -- leave room within the engine's 15 m item-move reach
local installed = false
local latest

local core = coop_mods_core
local xchg = coop_mods_xchg

local function item_section(section)
	return ini_sys:r_string_ex(section, "use1_functor") == "bind_container.access_inventory"
		and ini_sys:r_string_ex(section, "script_binding") == "bind_container.bind"
end

local function hidden_box(id)
	if type(id) ~= "number" or id < 1 or id >= NO_PARENT or id % 1 ~= 0 then return nil end
	local se = alife_object(id)
	if se and se.parent_id == NO_PARENT and se:section_name() == BOX then return se end
end

local function target(t, from, who)
	local id = core.wire_id(t.i)
	local item = id and alife_object(id)
	if not (who and coop_mode.where(from) == "here" and who:alive() and item and core.root_of(id) == who:id()) then
		return nil, "stock_box_owner"
	end
	if not item_section(item:section_name()) then return nil, "stock_box_section" end

	-- The association lives on the ground box: economy.se accepts updates from a map authority,
	-- but a client cannot set arbitrary variables on a ground object, even one within reach.
	local data = alife_storage_manager.get_state()
	if type(data) ~= "table" or type(data.se_object) ~= "table" then return nil, "stock_box_save" end
	local box_id
	for other_id, vars in pairs(data.se_object) do
		if type(vars) == "table" and vars[LINK] == t.i then
			if box_id then return nil, "stock_box_link" end
			box_id = other_id
		end
	end
	if not box_id then
		-- Older saves contain the local box id in the authoritative stock item's binder packet.
		local legacy = bind_container.containers[id]
		box_id = legacy and legacy.id
	end
	if box_id then
		local box = hidden_box(box_id)
		local linked = box and se_load_var(box_id, nil, LINK)
		if not box or (linked ~= nil and linked ~= t.i) then return nil, "stock_box_link" end
		return { ids = { id, box_id }, item = id, box = box_id, linked = linked ~= nil }
	end
	return { ids = { id }, item = id }
end

local function level_at(graph, vertex)
	if graph:valid_vertex_id(vertex) then return graph:vertex(vertex):level_id() end
end

local function prepare_box(who, token)
	local sim = alife()
	local graph = game_graph()
	local gv, lv = who:game_vertex_id(), who:level_vertex_id()
	local here = level_at(graph, gv)
	if not here then return nil, "stock_box_vertex" end
	local pos = who:position()
	local buried = vector():set(pos.x, pos.y - 2, pos.z)
	local box
	if token.box then
		box = hidden_box(token.box)
		local there = box and level_at(graph, box.m_game_vertex_id)
		if not there then return nil, "stock_box_link" end
		-- Only relocate a box this process can update. Existing static-object traffic has no
		-- cross-authority handoff for a box and its children. Keep a remote box intact.
		if there ~= here and not coop_mode.decides_world() then return nil, "stock_box_away" end
		local obj = level.object_by_id(box.id)
		local at = obj and obj:position() or box.position
		if there ~= here or pos:distance_to_sqr(at) > NEAR_SQ then
			sim:teleport_object(box.id, gv, lv, buried)
			box = hidden_box(token.box)
			if not box or box.m_game_vertex_id ~= gv or pos:distance_to_sqr(box.position) > NEAR_SQ then
				return nil, "stock_box_move"
			end
		end
	else
		-- The stock hiding spot is outside the engine's transfer range. Use the player's
		-- authoritative vertices and put the box below the floor, within transfer range.
		local made = alife_create(BOX, buried, lv, gv)
		token.created = made and made.id
		box = hidden_box(token.created)
		if not box then return nil, "stock_box_create" end
	end
	sim:set_switch_online(box.id, true)
	sim:set_switch_offline(box.id, false)
	return box.id
end

local function remember(binder, item_id, box_id)
	binder.containers[item_id] = binder.containers[item_id] or {}
	binder.containers[item_id].id = box_id
end

local function complete(t, _, who, token)
	local box_id, why = prepare_box(who, token)
	if not box_id then return false, why end
	local wire_box = core.hid(box_id)
	if not wire_box then return false, "stock_box_id" end
	if not token.linked then
		se_save_var(box_id, nil, LINK, t.i)
		if se_load_var(box_id, nil, LINK) ~= t.i then return false, "stock_box_save" end
	end
	remember(bind_container, token.item, box_id)
	return true, { b = wire_box }
end

local function local_item(id, actor)
	local obj = level.object_by_id(id)
	local parent = obj and obj:parent()
	return parent and parent:id() == actor:id() and item_section(obj:section())
end

local function open_after_answer(binder, actor, item_id, opened, box_id)
	local deadline = time_global() + OPEN_MS
	CreateTimeEvent("coop_stock_box", "open", 0, function()
		if latest ~= opened or not core.active() or db.actor ~= actor or not local_item(item_id, actor)
			or time_global() >= deadline then
			if latest == opened then latest = nil end
			return true
		end
		local box = level.object_by_id(box_id)
		if not box or box:section() ~= BOX or actor:position():distance_to_sqr(box:position()) > NEAR_SQ then return false end
		remember(binder, item_id, box_id)
		binder.curBoxID = item_id
		latest = nil
		hide_hud_inventory()
		box:use(actor)
		return true
	end)
end

local function install()
	local binder = core.mod("bind_container")
	if not core.fn(binder, "access_inventory") or type(binder.containers) ~= "table" then return end
	if not xchg.serve(KIND, {
		check = function(t, from, who)
			local token, why = target(t, from, who)
			return token ~= nil, why
		end,
		reserve = target,
		commit = complete,
		rollback = function(_, _, _, token)
			if hidden_box(token.created) then alife_release_id(token.created) end
		end,
	}) then return end
	core.wrap(binder, "access_inventory", "xchg_stock.access_inventory", function(original)
		return function(obj, ...)
			if not core.active() then return original(obj, ...) end
			local actor, id = db.actor, obj and obj:id()
			if not (actor and id and local_item(id, actor)) then return end
			local wire_id = core.hid(id)
			if not wire_id or xchg.busy(KIND, wire_id) then return end
			local opened = {}
			latest = opened
			RemoveTimeEvent("coop_stock_box", "open")
			local op = xchg.ask(KIND, { i = wire_id, key = wire_id }, function(ok, result)
				if latest ~= opened then return end
				local box_id = ok and type(result) == "table" and core.wire_id(result.b)
				if box_id then open_after_answer(binder, actor, id, opened, box_id) else latest = nil end
			end)
			if not op and latest == opened then latest = nil end
		end
	end)
	installed = true
end

function on_game_start()
	if installed or not rawget(_G, "coop") then return end
	core.install("xchg_stock", "install", install)
end
