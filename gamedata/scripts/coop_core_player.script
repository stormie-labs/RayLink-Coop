-- Ядро: без проверок режима (docs/MODES.md)
--[[
	Anomaly Coop - core group: the player's own Lua state, who comes and goes, and level moves
	(gamedata\scripts\coop_core_player.script)

	1. Per-player Lua state. A client loads a copy of the host's save, and with it the HOST's Lua state. The engine
	   keeps the character's health/satiety/radiation (coop_equip vitals) and rank/reputation (coop_story); thirst,
	   sleepiness and psy health are carried by coop_economy_mdata / coop_mods_pdata. Left here:
	   - game_statistics: kills, stashes found, field dressings ..., visited levels and smarts, found artefacts,
	     anomaly maps, the rank/reputation baseline of the rank news. Achievements are NOT per player: the quests
	     group shares them with the whole group (coop_quests_pda), so the host's set from the save is right.
	   - the host's active boosters (drinks, drugs) that came with its save, instead of the player's own.
	   - the slot in the player's hands.
	   They go through the mods group's per-player channel (coop_mods_pdata: the host keeps every player's keys in
	   its save, a client gets its own back right after the save is read, before any load_state; a new player
	   starts fresh). Statistics: key "game_statistics" (its own save_state/load_state, without achievements).
	   Boosters: key "coop_core_boosters_v2" ("type,seconds,value|...", the seconds left and the value as the engine has
	   them), applied to the actor once it is live. The records of key "coop_core_boosters" hold the host's boosters as well
	   (an engine that kept them in a client's list) and are not read.
	   The rank news are re-baselined after a world load, so the restored rank does not pop "rank increased".
	2. Join/leave notices on every machine (PDA tip + chat line), the session start notice once per session.
	3. Level exits: the group waits at the exit (the waiting point of a level change: the engine's board, the placard and the
	   feed are scripts\coop_hud_transition.script; the rule is engine\src\xrCoop\coop_transition.h). Here only /go in the
	   chat = coop_accept_transition = the group goes now through the exit somebody waits at.
	Nobody saves by hand in a session, the host included (scripts\coop_saves.script); the host's engine writes the
	emergency autosaves.
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local string_format = string.format
local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall

local ROSTER_MS = 1000
local STASH_SEEN = "coop_core_session" -- coop.stash: the session-start notice was shown
local KEY_STATS = "game_statistics"
local KEY_BOOSTERS = "coop_core_boosters_v2"
local KEY_SLOT = "coop_core_slot" -- the slot in the player's hands, see own_slot
-- game_statistics parts that belong to the player (actor_achievements are the group's)
local STATS_SUBS = { "actor_statistics", "actor_visited_levels", "actor_visited_smarts", "actor_artefacts",
	"actor_anomaly_maps", "actor_miscellaneous" }
local MAX_BOOSTER_TYPE = 16 -- eBoostHpRestore..eBoostWoundImmunity; the engine hits NODEFAULT on anything else

local log = coop_util.logger("[coop-player]")
local tr = coop_util.tr

-- What this process is. The host process is the world server AND a player (the host player, a client of its own server
-- over the internal channel); a remote client is a player and a mirror of the host's world. `new_name` is the engine's role
-- function, `old_name` what an exe without it has (the old pair says the same); a name the exe lacks answers no.
local function role(new_name, old_name)
	if not (api and api.is_active()) then return false end
	local f = type(api[new_name]) == "function" and api[new_name] or api[old_name]
	if type(f) ~= "function" then return false end
	local ok, yes = pcall(f)
	return ok and yes == true
end

local function is_mirror() return role("is_mirror", "is_client") end -- the Lua state is a copy of the host's

-- A player is in the world: the host player (the host is live as soon as its world is up) or a live remote client. An exe
-- without coop.is_player() has only players in a session.
local function live()
	return api ~= nil and api.is_active() and role("is_player", "is_active") and api.is_live()
end

local function nick_of(peer)
	local p = coop_util.player_row(peer)
	if p then return tostring(p.nick) end
	return "#" .. tostring(peer)
end

-- Whose session this client joined: the playing host (peer 0); on a world server, whose seat plays no character, the player
-- with the host's badge (the operator) when that is somebody else, else "World".
local function session_owner()
	local link
	if type(api.server_link) == "function" then
		local ok, l = pcall(api.server_link)
		link = ok and type(l) == "table" and l or nil
	end
	if not (link and link.plays == false) then return nick_of(0) end
	for _, p in ipairs(coop_util.players()) do
		if p.is_host == true and not p.is_self then return tostring(p.nick) end
	end
	return tr("st_coop_core_chat_world", "World")
end

-- PDA tip + a chat line.
local function notice(text, icon)
	local chat = rawget(_G, "coop_core_chat")
	if chat and chat.system then pcall(chat.system, text) end
	local actor = db.actor
	if actor then
		pcall(function()
			actor:give_game_news(tr("st_coop_core_caption", "Co-op"), text, icon or "ui_iconsTotal_grouping", 0, 6000)
		end)
	end
	log("%s", text)
end

local stats = { boosters_applied = 0 }

-------------------------------------------------------------------------------
-- 1. Per-player Lua state (through coop_mods_pdata)
-------------------------------------------------------------------------------
local pdata_ok = false -- our keys are registered with the per-player channel
local after_load_done = false -- this Lua state: boosters applied, rank news re-baselined

local function actor_conditions()
	local actor = db.actor
	local a = actor and actor:cast_Actor()
	return a and a:conditions()
end

-- Current boosters of the local actor: "type,seconds,value|...": the seconds left and the value exactly as the engine has
-- them, as in a usual game. nil on a mirror until this player's own boosters are in: the list is the host's until then
-- (from his save), not this player's to report.
local function boosters_string()
	if is_mirror() and not after_load_done then return nil end
	local cond = actor_conditions()
	if not cond then return nil end
	local list = {}
	cond:BoosterForEach(function(btype, btime, bvalue)
		pcall(function()
			if btime and btime > 0 then
				list[#list + 1] = string_format("%d,%.3f,%.9g", btype, btime, bvalue)
			end
		end)
		return false -- the engine reads a bool: keep iterating
	end)
	return table.concat(list, "|")
end

-- The stock actor binder saves the slot in the player's hands with the save (m_data.game_object[0].actor_binder.active_slot)
-- and activates it at its first update. A client loads the HOST's save, so he would come out of every load holding the weapon
-- of the host's slot number. The slot the player holds now, as a per-player key (nil on a mirror until his own state is in:
-- until then it is the host's).
local function own_slot()
	if is_mirror() and not after_load_done then return nil end
	local actor = db.actor
	if not actor then return nil end
	local ok, slot = pcall(actor.active_slot, actor)
	return ok and tonumber(slot) or nil
end

-- A mirror's first update. The binder fires actor_on_first_update and only then activates the slot it loaded: the player's
-- own goes in here (no record: a new player, empty hands as a new game starts).
local function actor_on_first_update()
	if not (api and api.is_active() and is_mirror() and pdata_ok) then return end
	local binder = db.actor_binder
	if type(binder) ~= "table" and type(binder) ~= "userdata" then return end
	local m = alife_storage_manager.get_state()
	binder.loaded_active_slot = type(m) == "table" and tonumber(m[KEY_SLOT]) or 0
end

local function boosters_count(cond)
	local n = 0
	cond:BoosterForEach(function()
		n = n + 1
		return false
	end)
	return n
end

-- Replaces the actor's boosters (the host's, from its save) with this player's.
local function apply_boosters(s)
	local cond = actor_conditions()
	if not cond then return false end
	cond:ClearAllBoosters()
	-- An exe that subtracts the boosters' effects here and leaves them in the list subtracts each again when it runs out:
	-- the player's health restore, weight and protections stay negative.
	local left = boosters_count(cond)
	if left > 0 then
		log("! this engine did not take the host's boosters away (%d left in the list): they will count twice, the game needs build 56 or newer",
			left)
	end
	for entry in tostring(s or ""):gmatch("[^|]+") do
		local bt, btime, bval = entry:match("^(%d+),([%d%.]+),([%d%.eE%+%-]+)$")
		bt, btime, bval = tonumber(bt), tonumber(btime), tonumber(bval)
		if bt and btime and bval and bt <= MAX_BOOSTER_TYPE and btime > 0 and btime < 1000000
			and math.abs(bval) < 100000 then
			local b = SBooster()
			b.m_type = bt
			b.fBoostTime = btime
			b.fBoostValue = bval
			cond:ApplyBooster(b, "")
			stats.boosters_applied = stats.boosters_applied + 1
		end
	end
	return true
end

local function rebaseline_rank()
	local gs = rawget(_G, "game_statistics")
	if not (gs and db.actor) then return true end
	pcall(gs.create_relations_tables)
	pcall(gs.check_for_rank_change, true)
	pcall(gs.check_for_reputation_change, true)
	return true
end

local function register_pdata()
	local pd = rawget(_G, "coop_mods_pdata") or coop_mods_pdata
	if not (pd and type(pd.register) == "function") then
		log("! coop_mods_pdata not found: statistics and boosters of a client stay the host's")
		return
	end
	local ok1 = pd.register(KEY_STATS, { subs = STATS_SUBS, prime = { "game_statistics" } })
	local ok2 = pd.register(KEY_BOOSTERS, { get = boosters_string })
	local ok3 = pd.register(KEY_SLOT, { get = own_slot })
	pdata_ok = ok1 == true and ok2 == true and ok3 == true
	if not pdata_ok then log("! per-player keys not registered (%s, %s, %s)", tostring(ok1), tostring(ok2), tostring(ok3)) end
end

-- Mirror (a remote client), first live update of this Lua state: the restored keys are in m_data, the actor exists. The host
-- player's Lua state is its own (the save it loaded is its), so there is nothing to put back for it.
local function client_after_load()
	after_load_done = true
	-- In a load that continues his world (a group transition, the host going alone, his own exit) the engine holds the
	-- player's whole condition through it and puts it back with its own save/load: wounds, alcohol, boosters with the seconds
	-- they had. Then there is nothing to replace here; the list below is for a join, a rejoin and a rolled back world.
	local carried = false
	if api.condition_carried then
		local ok, yes = pcall(api.condition_carried)
		carried = ok and yes == true
	end
	if pdata_ok and not carried then
		local m = alife_storage_manager.get_state()
		local s = type(m) == "table" and m[KEY_BOOSTERS] or nil
		apply_boosters(type(s) == "string" and s or "") -- nothing stored: a new player has no boosters
	end
	rebaseline_rank()
	CreateTimeEvent("coop_core_player", "rank_rebaseline", 5, rebaseline_rank) -- the engine's rank lands later
end

-------------------------------------------------------------------------------
-- 2. Who comes and goes
-------------------------------------------------------------------------------
local roster = nil -- peer id -> { nick, joined }; nil until the first look in this Lua state
local roster_owners = false -- the last look knew who plays each character (coop.owners_known)
local next_roster = 0

-- A client knows who plays each character (avatar_id) from the host's first owners table, a moment after it is in the world:
-- the players already there must not show up as "joined" then. An engine without coop.owners_known: known.
local function owners_known()
	if not api.owners_known then return true end
	local ok, known = pcall(api.owners_known)
	return not ok or known ~= false
end

local function roster_tick()
	local now = {}
	for _, p in ipairs(coop_util.players()) do
		if not p.is_self and type(p.id) == "number" then
			now[p.id] = { nick = tostring(p.nick), joined = p.avatar_id ~= nil }
		end
	end
	local known = owners_known()
	-- the first table of owners is the baseline: who is in the world when it comes is no news
	local news = roster_owners
	roster_owners = known
	if roster == nil then -- first look: who is here already is no news
		roster = now
		if role("is_player", "is_active") and api.stash_get and api.stash_get(STASH_SEEN) ~= "1" then -- a dedicated host has no one to tell
			if api.stash_set then api.stash_set(STASH_SEEN, "1") end
			if coop_mode.decides_world() then
				notice(tr("st_coop_core_session_host", "You are hosting a co-op session."))
			else
				notice(string_format(tr("st_coop_core_session_client", "Connected to the co-op session of %s."),
					session_owner()))
			end
		end
		return
	end
	for id, p in pairs(now) do
		local old = roster[id]
		if not old then
			if not p.joined then
				notice(string_format(tr("st_coop_core_connecting", "%s is connecting..."), p.nick))
			elseif news then
				notice(string_format(tr("st_coop_core_joined", "%s joined the game."), p.nick))
			end
		elseif p.joined and not old.joined and news then
			notice(string_format(tr("st_coop_core_joined", "%s joined the game."), p.nick))
		end
	end
	for id, old in pairs(roster) do
		if not now[id] then
			notice(string_format(tr("st_coop_core_left", "%s left the game."), old.nick))
			local mloot = rawget(_G, "coop_core_world_mloot")
			if mloot and mloot.on_peer_left then pcall(mloot.on_peer_left, id) end
		end
	end
	roster = now
end

-------------------------------------------------------------------------------
-- 3. Level exits
-------------------------------------------------------------------------------
-- Host: /go in the chat: the group goes now through the exit somebody waits at (the engine's coop_accept_transition says
-- when nobody does).
function accept_transition()
	if not (api and api.is_active() and coop_mode.decides_world()) then return false end
	exec_console_cmd("coop_accept_transition")
	return true
end

-------------------------------------------------------------------------------
-- Update, callbacks
-------------------------------------------------------------------------------
local function actor_on_update()
	if not api then return end
	if not api.is_active() then
		roster = nil
		roster_owners = false
		return
	end
	if not live() and not coop_mode.decides_world() then return end -- a dedicated host plays nothing and still keeps the roster
	if not after_load_done and db.actor and is_mirror() then
		local ok, err = pcall(client_after_load)
		if not ok then log("! own state after the world load: %s", tostring(err)) end
	end
	local tg = time_global()
	if tg >= next_roster then
		next_roster = tg + ROSTER_MS
		local ok, err = pcall(roster_tick)
		if not ok then log("! roster: %s", tostring(err)) end
	end
end

function print_status()
	log("player: per-player keys %s, boosters applied %d",
		pdata_ok and "registered" or "not registered", stats.boosters_applied)
end

function on_game_start()
	if not api then return end -- an exe without co-op: nothing of this runs
	coop_util.add_status("coop_core_player", 60)
	coop_util.start_step("coop_core_player", "register_pdata", register_pdata) -- before the save is read
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_first_update", function()
		local ok, err = pcall(actor_on_first_update)
		if not ok then log("! the slot in hands after the world load: %s", tostring(err)) end
	end)
end
