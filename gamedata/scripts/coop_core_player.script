--[[
	Anomaly Coop - core group: the player's own Lua state, who comes and goes, and level moves
	(gamedata\scripts\coop_core_player.script)

	1. Per-player Lua state. A client loads a copy of the host's save, and with it the HOST's Lua state. The engine
	   keeps the character's health/satiety/radiation (coop_equip vitals) and rank/reputation (coop_story); thirst,
	   sleepiness and psy health are carried by coop_economy_mdata / coop_mods_pdata. Left here:
	   - game_statistics: kills, stashes found, field dressings ..., visited levels and smarts, found artefacts,
	     anomaly maps, the rank/reputation baseline of the rank news. Achievements are NOT per player: the quests
	     group shares them with the whole group (coop_quests_pda), so the host's set from the save is right.
	   - the host's active boosters (drinks, drugs) that came with its save, instead of the player's own.
	   Both go through the mods group's per-player channel (coop_mods_pdata: the host keeps every player's keys in
	   its save, a client gets its own back right after the save is read, before any load_state; a new player
	   starts fresh). Statistics: key "game_statistics" (its own save_state/load_state, without achievements).
	   Boosters: key "coop_core_boosters" ("type,seconds,value|..."), applied to the actor once it is live.
	   The rank news are re-baselined after a world load, so the restored rank does not pop "rank increased".
	2. Join/leave notices on every machine (PDA tip + chat line), the session start notice once per session.
	3. Level exits: the group waits at the exit (the waiting point of a level change: the engine's board, the placard and the
	   feed are scripts\coop_hud_transition.script; the rule is engine\src\xrCoop\coop_transition.h). Only the fallbacks stay
	   here: /go in the chat = coop_accept_transition = the group goes now through the exit somebody waits at; the older engine
	   notice (coop_main.on_transition_vote, no longer sent by the engine) and the fade of the clients before a move.
	F3 task 17: the client's quicksave request to the host is gone. Nobody saves by hand in a session, the host included
	(scripts\coop_saves.script); the host's engine writes the emergency autosaves.
--]]

local api = rawget(_G, "coop") -- engine namespace, nil on an exe without co-op

local string_format = string.format
local tostring, tonumber, type, ipairs, pairs, pcall = tostring, tonumber, type, ipairs, pairs, pcall

local EV_MOVING = "core.moving" -- host -> clients: the group moves to another level now

local ROSTER_MS = 1000
local STASH_SEEN = "coop_core_session" -- coop.stash: the session-start notice was shown
local KEY_STATS = "game_statistics"
local KEY_BOOSTERS = "coop_core_boosters"
-- game_statistics parts that belong to the player (actor_achievements are the group's)
local STATS_SUBS = { "actor_statistics", "actor_visited_levels", "actor_visited_smarts", "actor_artefacts",
	"actor_anomaly_maps", "actor_miscellaneous" }
local MAX_BOOSTER_TYPE = 16 -- eBoostHpRestore..eBoostWoundImmunity; the engine hits NODEFAULT on anything else

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	printf("[coop-player] %s", ok and line or tostring(fmt))
end

local function tr(id, fallback)
	local ok, s = pcall(game.translate_string, id)
	if not ok or type(s) ~= "string" or s == id then return fallback or id end
	return s
end

local function codec()
	return rawget(_G, "coop_main") or coop_main
end

local function live()
	return api ~= nil and api.is_active() and (api.is_host() or api.is_live())
end

local function players()
	if not api then return {} end
	local ok, list = pcall(api.players)
	return ok and type(list) == "table" and list or {}
end

local function nick_of(peer)
	for _, p in ipairs(players()) do
		if p.id == peer then return tostring(p.nick) end
	end
	return "#" .. tostring(peer)
end

-- PDA tip + a chat line.
local function notice(text, icon)
	local chat = rawget(_G, "coop_core_chat")
	if chat and chat.system then pcall(chat.system, text) end
	local actor = db.actor
	if actor then
		pcall(function()
			actor:give_game_news(tr("st_coop_core_caption", "Co-op"), text, icon or "ui_iconsTotal_grouping", 0, 6000)
		end)
	end
	log("%s", text)
end

local function hud_msg(text)
	local am = rawget(_G, "actor_menu")
	if am and am.set_msg then pcall(am.set_msg, 1, text, 4) end
	log("%s", text)
end

local stats = { boosters_applied = 0 }

-------------------------------------------------------------------------------
-- 1. Per-player Lua state (through coop_mods_pdata)
-------------------------------------------------------------------------------
local pdata_ok = false -- our keys are registered with the per-player channel
local after_load_done = false -- this Lua state: boosters applied, rank news re-baselined

local function actor_conditions()
	local actor = db.actor
	local a = actor and actor:cast_Actor()
	return a and a:conditions()
end

-- Current boosters of the local actor: "type,seconds,value|..." (seconds in 10 s steps).
local function boosters_string()
	local cond = actor_conditions()
	if not cond then return nil end
	local list = {}
	cond:BoosterForEach(function(btype, btime, bvalue)
		pcall(function()
			if btime and btime > 0 then
				list[#list + 1] = string_format("%d,%d,%.4f", btype, math.ceil(btime / 10) * 10, bvalue)
			end
		end)
		return false -- the engine reads a bool: keep iterating
	end)
	return table.concat(list, "|")
end

-- Replaces the actor's boosters (the host's, from its save) with this player's.
local function apply_boosters(s)
	local cond = actor_conditions()
	if not cond then return false end
	cond:ClearAllBoosters()
	for entry in tostring(s or ""):gmatch("[^|]+") do
		local bt, btime, bval = entry:match("^(%d+),([%d%.]+),(%-?[%d%.]+)$")
		bt, btime, bval = tonumber(bt), tonumber(btime), tonumber(bval)
		if bt and btime and bval and bt <= MAX_BOOSTER_TYPE and btime > 0 and btime < 1000000
			and math.abs(bval) < 100000 then
			local b = SBooster()
			b.m_type = bt
			b.fBoostTime = btime
			b.fBoostValue = bval
			cond:ApplyBooster(b, "")
			stats.boosters_applied = stats.boosters_applied + 1
		end
	end
	return true
end

local function rebaseline_rank()
	local gs = rawget(_G, "game_statistics")
	if not (gs and db.actor) then return true end
	pcall(gs.create_relations_tables)
	pcall(gs.check_for_rank_change, true)
	pcall(gs.check_for_reputation_change, true)
	return true
end

local function register_pdata()
	local pd = rawget(_G, "coop_mods_pdata") or coop_mods_pdata
	if not (pd and type(pd.register) == "function") then
		log("! coop_mods_pdata not found: statistics and boosters of a client stay the host's")
		return
	end
	local ok1 = pd.register(KEY_STATS, { subs = STATS_SUBS, prime = { "game_statistics" } })
	local ok2 = pd.register(KEY_BOOSTERS, { get = boosters_string })
	pdata_ok = ok1 == true and ok2 == true
	if not pdata_ok then log("! per-player keys not registered (%s, %s)", tostring(ok1), tostring(ok2)) end
end

-- Client, first live update of this Lua state: the restored keys are in m_data, the actor exists.
local function client_after_load()
	after_load_done = true
	if pdata_ok then
		local m = alife_storage_manager.get_state()
		local s = type(m) == "table" and m[KEY_BOOSTERS] or nil
		apply_boosters(type(s) == "string" and s or "") -- nothing stored: a new player has no boosters
	end
	rebaseline_rank()
	CreateTimeEvent("coop_core_player", "rank_rebaseline", 5, rebaseline_rank) -- the engine's rank lands later
end

-------------------------------------------------------------------------------
-- 2. Who comes and goes
-------------------------------------------------------------------------------
local roster = nil -- peer id -> { nick, joined }; nil until the first look in this Lua state
local roster_owners = false -- the last look knew who plays each character (coop.owners_known)
local next_roster = 0

-- F0 final review (task 8): a client knows who plays each character (avatar_id) from the host's first owners table,
-- a moment after it is in the world: the players already there must not show up as "joined" then. An engine
-- without coop.owners_known: known.
local function owners_known()
	if not api.owners_known then return true end
	local ok, known = pcall(api.owners_known)
	return not ok or known ~= false
end

local function roster_tick()
	local now = {}
	for _, p in ipairs(players()) do
		if not p.is_self and type(p.id) == "number" then
			now[p.id] = { nick = tostring(p.nick), joined = p.avatar_id ~= nil }
		end
	end
	local known = owners_known()
	-- the first table of owners is the baseline: who is in the world when it comes is no news
	local news = roster_owners
	roster_owners = known
	if roster == nil then -- first look: who is here already is no news
		roster = now
		if api.stash_get and api.stash_get(STASH_SEEN) ~= "1" then
			if api.stash_set then api.stash_set(STASH_SEEN, "1") end
			if api.is_host() then
				notice(tr("st_coop_core_session_host", "You are hosting a co-op session."))
			else
				notice(string_format(tr("st_coop_core_session_client", "Connected to the co-op session of %s."),
					nick_of(0)))
			end
		end
		return
	end
	for id, p in pairs(now) do
		local old = roster[id]
		if not old then
			if not p.joined then
				notice(string_format(tr("st_coop_core_connecting", "%s is connecting..."), p.nick))
			elseif news then
				notice(string_format(tr("st_coop_core_joined", "%s joined the game."), p.nick))
			end
		elseif p.joined and not old.joined and news then
			notice(string_format(tr("st_coop_core_joined", "%s joined the game."), p.nick))
		end
	end
	for id, old in pairs(roster) do
		if not now[id] then
			notice(string_format(tr("st_coop_core_left", "%s left the game."), old.nick))
			local world = rawget(_G, "coop_core_world")
			if world and world.on_peer_left then pcall(world.on_peer_left, id) end
		end
	end
	roster = now
end

-------------------------------------------------------------------------------
-- 3. Level exits
-------------------------------------------------------------------------------
local vote = nil -- host: { nick, at } of the last transition vote the engine reported

-- Host, coop_main.on_transition_vote: a player stands at a level exit. (The engine's waiting point does not call it any more:
-- every machine's placard and feed say it; kept for an older engine and for other scripts.)
function on_transition_vote(nick)
	vote = { nick = tostring(nick or "?"), at = time_global() }
	notice(string_format(tr("st_coop_core_vote", "%s stands at a level exit. Type /go in the chat to move the group."),
		vote.nick))
end

-- Host: /go in the chat: the group goes now through the exit somebody waits at (the engine's coop_accept_transition says
-- when nobody does).
function accept_transition()
	if not (api and api.is_host()) then return false end
	if vote and time_global() - vote.at < 600000 then
		api.send_event(EV_MOVING, codec().encode({ nick = vote.nick }), -1)
		vote = nil
		CreateTimeEvent("coop_core_player", "accept_transition", 0.6, function()
			exec_console_cmd("coop_accept_transition")
			return true
		end)
	else
		exec_console_cmd("coop_accept_transition") -- the engine knows whether one is pending (console answer)
	end
	return true
end

local function on_moving(payload, from)
	if from ~= 0 or not (api and api.is_client()) or not db.actor then return end
	hud_msg(tr("st_coop_core_moving", "The group moves to another level..."))
	pcall(level.add_pp_effector, "sleep_fade.ppe", 1313, false)
end

-------------------------------------------------------------------------------
-- Update, callbacks
-------------------------------------------------------------------------------
local function actor_on_update()
	if not api then return end
	if not api.is_active() then
		roster = nil
		roster_owners = false
		return
	end
	if not live() then return end
	if api.is_client() and not after_load_done and db.actor then
		local ok, err = pcall(client_after_load)
		if not ok then log("! own state after the world load: %s", tostring(err)) end
	end
	local tg = time_global()
	if tg >= next_roster then
		next_roster = tg + ROSTER_MS
		local ok, err = pcall(roster_tick)
		if not ok then log("! roster: %s", tostring(err)) end
	end
end

function print_status()
	log("player: per-player keys %s, boosters applied %d",
		pdata_ok and "registered" or "not registered", stats.boosters_applied)
end

-- on_game_start must not throw: axr_main runs every script's on_game_start in one unprotected loop, and an
-- error here would skip all the scripts after this one, single player included (W5).
local function start_step(what, f)
	local ok, err = pcall(f)
	if not ok then printf("! [coop_core_player] %s failed: %s", what, tostring(err)) end
end

function on_game_start()
	if not api then return end -- an exe without co-op: nothing of this runs
	start_step("register_pdata", register_pdata) -- before the save is read
	RegisterScriptCallback("actor_on_update", actor_on_update)
	local cm = codec()
	if not (cm and cm.add_event_handler) then
		log("! coop_main.add_event_handler not found: player events are not handled")
		return
	end
	cm.add_event_handler(EV_MOVING, on_moving)
end
