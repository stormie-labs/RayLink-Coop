-- Ядро: без проверок режима (docs/MODES.md)
-- GAMMA UI: the level authority checks single gifts to a companion before the engine moves them.
-- axr_companions.OnItemBeforeMove stops the next gift once the assigned weight exceeds 30 kg. The rule also sees
-- admitted moves still in the engine's event queue. Once a gift lands, the NPC's take callback assigns it locally.

local core = coop_mods_core
local RULE = "companion_assigned_weight"
local MAX_WEIGHT = 30 -- axr_companions.is_overweight
local TAKE_TTL_MS = 5000 -- same window as the engine's reservation of an admitted move
local companions
local awaiting_take = {} -- item id -> expected NPC and timestamp, bounded by the engine's object id space

local function on_npc_take(npc, item)
	local id = item:id()
	local move = awaiting_take[id]
	if not move then return end
	awaiting_take[id] = nil
	if move.npc ~= npc:id() or time_global() - move.at >= TAKE_TTL_MS or not coop_mode.leads_here() then return end
	local parent = item:parent()
	if not parent or parent:id() ~= move.npc then return end
	local ok, err = pcall(companions.OnItemAfterMove, move.npc, item, "loot", EDDListType.iActorBag)
	if not ok then core.report(RULE, "assign landed item", err) end
end

local function admit(npc_id, item_id, pending_count, pending_weight, from_id)
	if companions.Enabled == false or not coop_mode.leads_here() then return nil end
	if not core.is_player(from_id) then return nil end
	local npc = level.object_by_id(npc_id)
	if not (npc and se_load_var(npc_id, nil, "companion") and level.object_by_id(item_id)) then return nil end

	local assigned_weight = 0
	-- The UI may mark a gift before its take event. Only weigh items in the actual inventory here, once per item.
	npc:iterate_inventory(function(_, item)
		if companions.is_assigned_item(npc_id, item:id()) then assigned_weight = assigned_weight + item:weight() end
	end, npc)
	local under_limit = assigned_weight + pending_weight <= MAX_WEIGHT
	if from_id ~= 0 then
		under_limit = coop_trust.pass(RULE, under_limit,
			"companion %d: %.2f kg assigned + %.2f kg pending (%d) exceeds %d kg",
			npc_id, assigned_weight, pending_weight, pending_count, MAX_WEIGHT)
	end
	if not under_limit then return false, "companion assigned items exceed 30 kg" end

	-- Only a take event can turn this candidate into an assignment. The engine owns pending weight and rolls it back
	-- when it rejects a transfer. A delayed or failed move cannot add weight to the companion's inventory here.
	awaiting_take[item_id] = { npc = npc_id, at = time_global() }
	return true
end

local function install()
	if companions then return end
	local mod = core.mod("axr_companions")
	if not (mod and type(mod.is_assigned_item) == "function" and type(mod.OnItemAfterMove) == "function") then return end
	RegisterScriptCallback("npc_on_item_take", on_npc_take)
	assert(coop_mods_move_limits.add_rule(RULE, admit), "move admission rule registration refused")
	companions = mod
end

function on_game_start()
	local ok, err = pcall(install)
	if not ok then core.report(RULE, "install", err) end
end
