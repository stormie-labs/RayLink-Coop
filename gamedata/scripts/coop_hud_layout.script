--[[
	Anomaly Coop - the HUD: every size of the compass bar and the team panel, and the alphas of the bar, in one table
	(gamedata\scripts\coop_hud_layout.script). Spec: docs\HUD_V2.md.

	A change of size is one line: configs\mod_system_coop.ltx [coop_hud_layout] <key> = <number> wins over
	the defaults below (a missing or broken line keeps the default). Read once per Lua state (a load / level change), or
	again with reload().
	Units: px at 768 high = 1024x768 UI units down; across, the scripts multiply by kx = 1024 * H / (768 * W), so nothing
	stretches on a wide screen. bar_width_pct is a percentage of the screen width; alphas are 0..1. Fonts are in the XML
	(ui_coop_compass.xml, ui_coop_core.xml team_row).

	For other scripts:
		coop_hud_layout.get() -> the table (do not change it)
		coop_hud_layout.reload()
--]]

local tonumber, type, pairs, pcall = tonumber, type, pairs, pcall

SECTION = "coop_hud_layout"

-- docs\hud\hud_v2_mockup.png
DEFAULTS = {
	-- compass bar: look (0..1; the background and the line fade out on the last 16 % at each end, baked in the textures)
	bar_bg_alpha = 0.33, -- #0C0D0A
	bar_line_alpha = 0.8, -- the white line #F4F5F6
	-- compass bar: sizes
	bar_width_pct = 38, -- of the screen width
	bar_top = 20, -- from the top of the screen
	bar_height = 24,
	line_y = 15, -- the white line through the bar, from its top
	letter_y = 1, -- letters N NE E ...: top of their box, from the bar's top (above the line)
	letter_h = 13,
	tick_5 = 2, -- tick lengths, down from the line
	tick_15 = 4,
	tick_45 = 5,
	notch_w = 8, -- the white centre mark under the line, pointing up
	notch_h = 6,
	notch_gap = 3, -- its tip this far under the line
	heading_y = -14, -- the heading "247 deg" (top of its box), from the bar's top
	heading_h = 12,
	icon = 12, -- marker glyph
	marker_y = 9, -- marker centre, from the bar's top (sits on the line, a bit above it)
	ping_dot = 6, -- the cyan dot of a ping
	side = 8, -- the arrow of a marker pinned to an end
	side_gap = 12, -- pinned marker: centre this far from the end of the bar, its arrow as far outside it
	updown = 6, -- up / down arrow at a label (height difference > 5 m)
	label_gap = 3, -- labels: this far under the bar
	label_h = 12,
	world_ring = 16, -- a ping over its point in the world
	world_dot = 6,
	-- "Visor" compass arc (y0 64, R 372, sag 21 at 1080, half-angle 82 degrees). Convert pixels with px * 768 / 1080.
	-- The compass uses arc settings. Bar, tick, notch, heading, icon and label settings support existing LTX files.
	-- Rotated statics use square units (pixels at 768).
	arc_r = 264.5, -- radius: x = cx + R sin th (across * kx)
	arc_y0 = 45.5, -- the arc's top (its centre) from the top of the screen
	arc_sag = 14.9, -- y = y0 + sag (1 - cos th)
	arc_half = 82, -- deg of the arc either side; the player's field (120 / 160 / 200) fills it
	arc_above = 21.5, -- the dark plate: this far above y0 ...
	arc_below = 10, -- ... and this far under the arc's ends
	arc_center_above = 6.4, -- the centre line through the arc (2 px)
	arc_center_below = 9.2,
	arc_notch_y = 24.5, -- the chevron under the heading, pointing down (top of its box)
	arc_notch_w = 11.4,
	arc_notch_h = 5,
	arc_head_y = 7, -- the heading "247 deg" (top of its box, head font)
	arc_head_h = 15,
	arc_letter_gap = 8.5, -- letters: centre this far above the arc (along its normal)
	arc_letter_h = 14,
	arc_digit_gap = 7.8, -- numbers of the scale (detail only)
	arc_tick_45 = 7.1, -- tick lengths across the arc (x0.64 at the ends)
	arc_tick_15 = 5,
	arc_tick_5 = 2.8,
	arc_icon_ally = 15.6, -- 22 px at 1080
	arc_icon_mark = 13.5, -- 19 px at 1080
	arc_icon_drop = 14.2, -- icon centre this far under the arc (a thin stem between)
	arc_label_gap = 1.5, -- labels under the icon
	arc_label_h = 10,
	arc_side = 7, -- the arrow of a marker pinned to an end
	arc_side_gap = 6,
	arc_updown = 5, -- up / down arrow at a distance (height difference > 5 m)
	arc_ping_dot = 5, -- the dot of a ping (old icons only)
	-- alphas (spec_v2 "tokens"): calm -> while "detail" is held
	a_main = 0.72, -- level-1 icons, the line, the heading, N / E / S / W
	a_sec = 0.50, -- ticks, NE / SE / SW / NW
	a_shade = 0.25, -- the plate
	a_detail_main = 0.96,
	a_detail_sec = 0.78,
	a_detail_shade = 0.33,
	focus_deg = 12, -- labels within this of the heading
	look_deg = 20, -- level 2 ("by look") within this of the heading ...
	look_fade_deg = 4, -- ... fading out over the last 4 deg
	ping_fresh_s = 3, -- a fresh ping shows its distance this long
	detail_tau_ms = 140, -- easing in / out of "detail"
	-- no intensity by distance: a marker is at full alpha up to fade_near_pct % of its
	-- kind's range, then smoothly (smoothstep) down to fade_far_alpha and its icon to fade_far_scale at the range; beyond
	-- the range it is not shown (it fades out in 150 ms like any marker). A range of 0 = no limit: always shown, dimmed
	-- the same way against fade_ref_m and staying at fade_far_alpha beyond it (allies, pings, the waypoint, the active task).
	fade_near_pct = 25,
	fade_far_alpha = 0.35,
	fade_far_scale = 0.8,
	fade_ref_m = 300,
	-- ranges by kind, m (a marker's own `range` wins; a mod's kind without a line takes range_default)
	range_ally = 0,
	range_ping = 0,
	range_waypoint = 0, -- the player's own waypoint (Personal Adjustable Waypoint)
	range_task_active = 0,
	range_task = 400, -- the other tasks
	range_death = 400,
	range_camp = 300,
	range_pin = 500, -- the player's PDA pins (PAW)
	range_stash = 100,
	range_npc = 60, -- traders, mechanics, medics and the other people of the PDA
	range_sleep = 50,
	range_transition = 300, -- level changers
	range_default = 300,
	-- the sweep of the PDA marks (coop_hud_markers, level.map_get_object_spots_by_id over every object id): ids per
	-- frame for the first round after a load, then per frame for the endless round (~11 s at 60 fps)
	pda_scan_first = 2048,
	pda_scan_frame = 96,
	-- team panel: rows top left, the block grows downwards (bottom left covered the PDA
	-- news, messages_window.xml sp_log_list 15..815 x 365..635, and the chat feed)
	team_x = 18, -- from the left edge of the screen
	team_top = 20, -- the top of the highest row; below 0: the rows hang from team_bottom upwards instead
	team_bottom = 590, -- (team_top < 0) the bottom of the lowest row (the own HUD of GAMMA / stock starts lower, ~626 / 726)
	team_row = 36, -- from one row to the next
	team_strip_w = 2, -- the player's colour bar at the left of a row
	team_strip_h = 22,
	team_name_x = 8, -- nick (white, 1 px shadow) from the row's left
	team_name_y = -2,
	team_name_h = 14,
	team_name_max = 120, -- longer nicks end with an ellipsis
	team_star = 9, -- host star after the nick
	team_dist_gap = 6, -- distance this far after the nick (or the star)
	team_dist_y = 0,
	team_dist_h = 12,
	team_arrow = 10, -- direction arrow after the distance, centred team_arrow_y from the row's top
	team_arrow_y = 6,
	team_seg_x = 8, -- health: 4 segments of 25 % under the nick
	team_seg_y = 15,
	team_seg_w = 30,
	team_seg_h = 5,
	team_seg_gap = 3,
	team_seg_empty_alpha = 0.18, -- the empty part of a segment, white
	team_status = 12, -- state icon (cross in a melting ring, skull, eye, z, !) right of the segments
	team_status_gap = 10, -- its centre this far after the last segment
	team_timer_h = 12, -- "0:42" after the icon
	-- net graph (coop_hud_netgraph): FPS / ping / loss, a block at the top right under the stock timers (hud_timer ends at
	-- 66), clear of the compass bar (38 % in the middle) and of the team panel (top left)
	net_right = 12, -- from the right edge of the screen
	net_top = 74, -- the top of the plate
	net_w = 136, -- the plate: pad + label column + number + pad
	net_pad = 5, -- between the plate's edge and the rows
	net_row = 13, -- from one row to the next (a row is as high)
	net_label_w = 80, -- the label column (the longest label, Russian "loss max", is 78 wide); the number takes the rest
	net_bg_alpha = 0.33, -- the plate #0C0D0A, as the compass bar's
}

local layout

local function read(ini, key)
	local ok, v = pcall(function()
		if ini:section_exist(SECTION) and ini:line_exist(SECTION, key) then return ini:r_string(SECTION, key) end
	end)
	if not (ok and type(v) == "string") then return nil end
	v = tonumber(v:match("^%s*([%-%d%.]+)"))
	if v and v == v and v > -1000 and v < 4000 then return v end
	return nil
end

function reload()
	local t = {}
	local ini = rawget(_G, "ini_sys")
	if not ini then
		local ok, sys = pcall(function() return system_ini() end)
		ini = ok and sys or nil
	end
	for k, def in pairs(DEFAULTS) do
		t[k] = ini and read(ini, k) or def
	end
	layout = t
	return t
end

function get()
	return layout or reload()
end
