-- Ядро: без проверок режима (docs/MODES.md)
-- The level decider runs the cat's stock state machine and the engine relays its motions.
-- Lua sends sleep snapshots and individual meows to that map's players. Piano keys and autoplay share
-- the same note event. The pianist hears the stock local playback while the decider routes other listeners.

local CAT = "placeable_hideout_cat"
local PIANO = "placeable_piano"
local SNAPSHOT_MS = 3000
local cat_state = setmetatable({}, { __mode = "k" }) -- tied to the lifetime of each binder wrapper
local meow_serial = 0

local core = coop_mods_core

local function in_range(value, low, high)
	return type(value) == "number" and value >= low and value <= high
end

local function integer(value, low, high)
	return in_range(value, low, high) and value % 1 == 0
end

local function object_of(id, section)
	local local_id = integer(id, 1, 65534) and core.lid(id)
	local obj = local_id and level.object_by_id(local_id)
	if obj and obj:section() == section then return obj end
end

local function cat_wrapper(obj)
	local binder = obj and obj:binded_object()
	local w = binder and binder.wrapper
	if w and w.on_interact then return w end
end

local function checked(verb, field, ok, peer)
	return coop_trust.pass(verb .. "_" .. field, ok, "player %s: invalid or unavailable %s", peer, field)
end

local function request_object(verb, t, from, section)
	local valid = integer(t.o, 1, 65534)
	if not checked(verb, "id", valid, from) or not valid then return end
	local obj = object_of(t.o, section)
	local usable = obj and (section ~= CAT or cat_wrapper(obj) ~= nil)
	if not checked(verb, "type", usable, from) or not usable then return end
	local who = coop_mode.where(from) == "here" and core.avatar(from)
	if not checked(verb, "near", who and coop_mods_hf.near_ok(obj, who), from) or not who then return end
	return obj
end

local function submit(verb, handler, data)
	if coop_mode.leads_here() and coop_mode.actor_is_player() then
		return handler(data, core.self_peer())
	end
	if coop_mode.is_player_mirror() then return core.to_host(verb, data) end
end

local function send_listeners(verb, data, except)
	local me = core.self_peer()
	for _, player in ipairs(core.players()) do
		local peer = player.id
		if peer ~= me and peer ~= except and coop_mode.where(peer) == "here" then
			core.to_peer(peer, verb, data)
		end
	end
end

-------------------------------------------------------------------------------
-- Cat
-------------------------------------------------------------------------------

local function state_of(w)
	local state = cat_state[w]
	if not state then
		state = {}
		cat_state[w] = state
	end
	return state
end

local function sleeping(anim_state)
	return anim_state == "sleep_side" or anim_state == "sleep_belly"
end

local function publish_sleep(w)
	local s = sleeping(w.anim.state) or sleeping(w.anim.target)
	local state, now = state_of(w), time_global()
	if state.sleeping == s and state.refresh_at and now < state.refresh_at then return end
	state.sleeping, state.refresh_at = s, now + SNAPSHOT_MS
	-- Repeat the current state for late joiners and objects that were still coming online at the first send.
	send_listeners("hf_cat_sleep", { o = core.hid(w.object:id()), s = s })
end

local function update_mirror(w, orig, ...)
	local state = state_of(w)
	if not state.passive_anim then
		state.passive_anim = { phase = "loop", lock = math.huge }
		state.passive_ai = { state_timer = math.huge }
	end
	-- Reuse the mod's fur and purr update with a stationary animation state. No loop events, transitions or AI timers run.
	state.passive_anim.state = state.sleeping and "sleep_side" or "idle"
	local anim, ai = w.anim, w.ai
	w.anim, w.ai = state.passive_anim, state.passive_ai
	local ok, result = pcall(orig, w, ...)
	w.anim, w.ai = anim, ai
	if not ok then error(result, 0) end
	return result
end

local function play_meow(w, sample, pitch)
	local snd = w["snd_miau_" .. sample]
	if snd then snd:play_no_feedback(w.object, sound_object.s3d, 0, w.object:position(), 1, pitch) end
end

local function cat_use(t, from)
	local obj = request_object("hf_cat_use", t, from, CAT)
	if obj then return cat_wrapper(obj):on_interact() end
end

local function install_cat()
	local mod = core.mod("bind_hideout_cat")
	local cls = mod and mod.hideout_cat_wrapper
	if not (core.fn(mod, "toggle_hideout_cat") and core.fn(cls, "update") and core.fn(cls, "_enter_state")
		and core.fn(cls, "_play_random_miau")) then return end
	core.wrap(mod, "toggle_hideout_cat", "bind_hideout_cat.toggle_hideout_cat", function(orig)
		return function(id, ...)
			if not core.active() then return orig(id, ...) end
			return submit("hf_cat_use", cat_use, { o = core.hid(id) })
		end
	end)
	core.wrap(cls, "_enter_state", "bind_hideout_cat.hideout_cat_wrapper._enter_state", function(orig)
		return function(w, ...)
			-- The constructor also enters idle. A mirror waits for the engine's authoritative motion.
			if not core.active() or coop_mode.leads_here() then return orig(w, ...) end
		end
	end)
	core.wrap(cls, "update", "bind_hideout_cat.hideout_cat_wrapper.update", function(orig)
		return function(w, ...)
			if not core.active() then return orig(w, ...) end
			if coop_mode.leads_here() then
				local result = orig(w, ...)
				if w.object then publish_sleep(w) end
				return result
			end
			if coop_mode.is_player_mirror() then return update_mirror(w, orig, ...) end
		end
	end)
	core.wrap(cls, "_play_random_miau", "bind_hideout_cat.hideout_cat_wrapper._play_random_miau", function(orig)
		return function(w, ...)
			if not core.active() then return orig(w, ...) end
			if not coop_mode.leads_here() then return end
			local sample, pitch = math.random(1, 5), random_float(0.9, 1.1)
			if coop_mode.actor_is_player() then play_meow(w, sample, pitch) end
			meow_serial = meow_serial + 1
			send_listeners("hf_cat_meow", { o = core.hid(w.object:id()), i = sample, p = pitch, n = meow_serial })
		end
	end)
	core.set_limit("hf_cat_use", 6, 2)
	core.on("hf_cat_use", cat_use, "host")
	core.on("hf_cat_sleep", function(t)
		local w = cat_wrapper(object_of(t.o, CAT))
		if w and coop_mode.is_player_mirror() and type(t.s) == "boolean" then state_of(w).sleeping = t.s end
	end, "player")
	core.on("hf_cat_meow", function(t)
		if not coop_mode.is_player_mirror() or not integer(t.i, 1, 5) or not in_range(t.p, 0.9, 1.1)
			or not integer(t.n, 1, 2147483647) then return end
		local w = cat_wrapper(object_of(t.o, CAT))
		if not w then return end
		local state = state_of(w)
		if t.n <= (state.last_meow or 0) then return end
		state.last_meow = t.n
		play_meow(w, t.i, t.p)
	end, "player")
end

-------------------------------------------------------------------------------
-- Piano
-------------------------------------------------------------------------------

local function install_piano()
	local mod = core.mod("ui_furniture_piano")
	local play = core.fn(mod, "PlaySound")
	local get_sound = core.fn(mod, "get_safe_sound_object")
	if not (play and get_sound) then return end
	-- Use the installed mod's catalog and the exact transposition/instrument it uses for local playback.
	local instruments = core.upvalue(core.fn(mod.UIFurniturePiano, "OnInstrumentSelect"), "instruments")
	local notes, note_indices = core.upvalue(play, "notes"), core.upvalue(play, "note2i")
	local _, _, piano_id = core.upvalue(play, "playing_piano_id")
	local _, _, transpose = core.upvalue(play, "transpose")
	local _, _, volume = core.upvalue(play, "volume")
	local _, _, selection = core.upvalue(play, "note2snd")
	if not (instruments and notes and note_indices and piano_id and transpose and volume and selection) then
		return core.log("hf_sounds", "piano catalog or playback settings not found")
	end
	local instrument_ids = {}
	for id, sounds in pairs(instruments) do
		if integer(id, 1, 65534) then instrument_ids[sounds] = id end
	end
	local function get_local(index) return select(2, debug.getupvalue(play, index)) end
	local function note_path(t)
		local sounds = integer(t.i, 1, 65534) and instruments[t.i]
		local key = integer(t.n, 1, #notes) and notes[t.n]
		local path = sounds and key and sounds[key]
		if type(path) == "string" and path ~= "" then return path end
	end
	local function play_note(obj, path, gain)
		local snd = get_sound(path)
		if not snd then return end
		snd:play_at_pos(obj, obj:position(), sound_object.s3d)
		snd.volume = gain
	end
	local function piano_play(t, from)
		local obj = request_object("hf_piano_play", t, from, PIANO)
		if not obj then return end
		local path = note_path(t)
		if not checked("hf_piano_play", "note", path ~= nil, from) or not path then return end
		local gain = t.v
		if not checked("hf_piano_play", "volume", in_range(gain, 0, 2), from)
			or type(gain) ~= "number" or gain ~= gain then return end
		gain = math.max(0, math.min(2, gain)) -- log mode can accept the note with a safe volume
		if coop_mode.actor_is_player() and from ~= core.self_peer() then play_note(obj, path, gain) end
		send_listeners("hf_piano_note", { o = t.o, i = t.i, n = t.n, v = gain }, from)
	end
	core.wrap(mod, "PlaySound", "ui_furniture_piano.PlaySound", function(orig)
		return function(key, ...)
			if not core.active() then return orig(key, ...) end
			local index = note_indices[key]
			local data = { o = core.hid(get_local(piano_id)), i = instrument_ids[get_local(selection)],
				n = index and index + get_local(transpose), v = get_local(volume) }
			if not note_path(data) then return end
			local result = orig(key, ...)
			if data.o then submit("hf_piano_play", piano_play, data) end
			return result
		end
	end)
	core.set_limit("hf_piano_play", 64, 20) -- enough burst for chords, matching the transport's ScriptEvent budget
	core.on("hf_piano_play", piano_play, "host")
	core.on("hf_piano_note", function(t)
		if not in_range(t.v, 0, 2) then return end
		local path, obj = note_path(t), object_of(t.o, PIANO)
		if path and obj then play_note(obj, path, t.v) end
	end, "player")
end

function on_game_start()
	if not rawget(_G, "coop") then return end
	core.install("hf_sounds", "cat", install_cat)
	core.install("hf_sounds", "piano", install_piano)
end
