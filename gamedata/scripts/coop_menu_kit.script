--[[
	Anomaly Coop - the pure helpers of the co-op window (gamedata\scripts\coop_menu_kit.script)
	No engine call and no look here: numbers in, numbers out. The look is the theme's (coop_menu_theme), the data coop_games',
	the window coop_menu's. Tested by tests\lua\test_menu_kit.lua.

	layout(W, H, dw, dh) -> L       the design of dw x dh pixels on a W x H screen: scale s = min(W / dw, H / dh), centred, and
	                                the 1024 x 768 UI space on top (the engine scales it per axis, ui_core::OnDeviceReset), so
	                                that a square of the design is a square on any screen.
	  L:x(px, ax)  L:y(py, ay)      a position of the stage in UI units; ax / ay = -1, 1: anchored to that side of the screen
	                                (the margin of the stage is dropped), nil or 0: centred with the stage
	  L:w(px)  L:h(py)              a size in UI units
	  L:rect(x, y, w, h, ax, ay)    x1, y1, x2, y2 in UI units
	  L:view()                      the screen in design pixels { left, top, right, bottom }
	easing(curve) -> f(u)           { x1, y1, x2, y2 } of a cubic-bezier; anything else: a straight line
	tween(v), tween_to(tw, to, now, dur, delay, ease), tween_at(tw, now), tween_done(tw, now)     by the clock, never by frames;
	                                turned round half way it starts from where it is
	after(now, t0, delay, dur) -> 0..1
	cover(tw, th, area, aspect, px, py, zoom, shift) -> x1, y1, x2, y2   the part of a texture for a slot of that aspect
	map_fit(stops, w, h, area, least) -> z  camera_closed(last, tile) -> x, y       camera_open(stops, focus, map, view, opts) -> x, y
	dots_along(points, step, max) -> { { x, y, f }, ... }
	spaced(s) -> "s p a c e d"
--]]

local min, max, floor = math.min, math.max, math.floor
local type = type

-------------------------------------------------------------------------------
-- Numbers
-------------------------------------------------------------------------------
function clamp01(x)
	if x <= 0 then return 0 end
	if x >= 1 then return 1 end
	return x
end

function mix(a, b, t)
	return a + (b - a) * t
end

-------------------------------------------------------------------------------
-- Layout
-------------------------------------------------------------------------------
local UI_W, UI_H = 1024, 768

local Layout = {}
Layout.__index = Layout

function layout(W, H, dw, dh)
	local s = min(W / dw, H / dh)
	local L = { W = W, H = H, dw = dw, dh = dh, s = s, ox = (W - dw * s) / 2, oy = (H - dh * s) / 2, kx = UI_W / W, ky = UI_H / H }
	return setmetatable(L, Layout)
end

function Layout:x(px, ax)
	return (self.ox * (1 + (ax or 0)) + px * self.s) * self.kx
end

function Layout:y(py, ay)
	return (self.oy * (1 + (ay or 0)) + py * self.s) * self.ky
end

function Layout:w(px)
	return px * self.s * self.kx
end

function Layout:h(py)
	return py * self.s * self.ky
end

function Layout:rect(x, y, w, h, ax, ay)
	local x1, y1 = self:x(x, ax), self:y(y, ay)
	return x1, y1, x1 + self:w(w), y1 + self:h(h)
end

function Layout:view()
	local ex, ey = self.ox / self.s, self.oy / self.s
	return { left = -ex, top = -ey, right = self.dw + ex, bottom = self.dh + ey }
end

-------------------------------------------------------------------------------
-- Easing
-------------------------------------------------------------------------------
local STEPS = 64
local curves = {}

local function bezier_axis(a, b, t)
	local m = 1 - t
	return 3 * m * m * t * a + 3 * m * t * t * b + t * t * t
end

local function linear(u)
	if u <= 0 then return 0 end
	if u >= 1 then return 1 end
	return u
end

-- A table of y by even steps of x, made once per curve: this runs for every moving thing in every frame.
local function build_curve(x1, y1, x2, y2)
	local ys = {}
	local t = 0
	for i = 0, STEPS do
		local x = i / STEPS
		while t < 1 and bezier_axis(x1, x2, t) < x do t = t + 1 / 512 end
		ys[i] = bezier_axis(y1, y2, min(t, 1))
	end
	ys[0], ys[STEPS] = 0, 1
	return function(u)
		if u <= 0 then return 0 end
		if u >= 1 then return 1 end
		local p = u * STEPS
		local i = floor(p)
		return ys[i] + (ys[i + 1] - ys[i]) * (p - i)
	end
end

function easing(curve)
	if type(curve) ~= "table" then return linear end
	local x1, y1, x2, y2 = curve[1], curve[2], curve[3], curve[4]
	if type(x1) ~= "number" or type(y1) ~= "number" or type(x2) ~= "number" or type(y2) ~= "number" then return linear end
	local key = x1 .. "," .. y1 .. "," .. x2 .. "," .. y2
	local f = curves[key]
	if not f then
		f = build_curve(x1, y1, x2, y2)
		curves[key] = f
	end
	return f
end

-------------------------------------------------------------------------------
-- Tweens: a value that goes somewhere by the clock
-------------------------------------------------------------------------------
function tween(v)
	return { from = v, to = v, t0 = 0, dur = 0, ease = linear }
end

function tween_at(tw, now)
	if now < tw.t0 then return tw.from end
	if tw.dur <= 0 then return tw.to end
	local u = (now - tw.t0) / tw.dur
	if u >= 1 then return tw.to end
	return tw.from + (tw.to - tw.from) * tw.ease(u)
end

function tween_to(tw, to, now, dur, delay, ease)
	tw.from = tween_at(tw, now)
	tw.to, tw.t0, tw.dur, tw.ease = to, now + (delay or 0), dur or 0, ease or linear
end

function tween_set(tw, v)
	tw.from, tw.to, tw.t0, tw.dur = v, v, 0, 0
end

function tween_done(tw, now)
	return now >= tw.t0 + tw.dur
end

-- 0..1 of a step that starts `delay` after t0.
function after(now, t0, delay, dur)
	local dt = now - t0 - (delay or 0)
	if dur <= 0 then return dt >= 0 and 1 or 0 end
	return clamp01(dt / dur)
end

-------------------------------------------------------------------------------
-- The part of a texture for a slot
-------------------------------------------------------------------------------
-- The largest part of `area` (fractions of the texture) of the slot's aspect; px, py place it (the css background-position);
-- zoom >= 1 takes less of it; shift moves it by a fraction of its width. It never leaves the area.
function cover(tw, th, area, aspect, px, py, zoom, shift)
	local ax, ay = tw * area.x1, th * area.y1
	local aw, ah = tw * (area.x2 - area.x1), th * (area.y2 - area.y1)
	local vw, vh = aw, aw / aspect
	if vh > ah then vh, vw = ah, ah * aspect end
	zoom = zoom or 1
	vw, vh = vw / zoom, vh / zoom
	local x1 = ax + (aw - vw) * px + (shift or 0) * vw
	local y1 = ay + (ah - vh) * py
	x1 = max(ax, min(x1, ax + aw - vw))
	y1 = max(ay, min(y1, ay + ah - vh))
	return x1, y1, x1 + vw, y1 + vh
end

-------------------------------------------------------------------------------
-- The map
-------------------------------------------------------------------------------
-- The scale of the map for a route (stops with u, v): the whole route inside area { w, h } of the screen. Real routes are far
-- longer than a screen at the design's scale. Never above 1, never below `least`.
function map_fit(stops, w, h, area, least)
	if not stops[1] then return 1 end
	local u1, u2, v1, v2 = stops[1].u, stops[1].u, stops[1].v, stops[1].v
	for _, p in ipairs(stops) do
		u1, u2 = min(u1, p.u), max(u2, p.u)
		v1, v2 = min(v1, p.v), max(v2, p.v)
	end
	local z = 1
	local dx, dy = (u2 - u1) * w, (v2 - v1) * h
	if dx > 0 then z = min(z, area.w / dx) end
	if dy > 0 then z = min(z, area.h / dy) end
	return max(z, least)
end

-- Closed: the last stop in the middle of the tile.
function camera_closed(last, tile)
	return tile.x + tile.w / 2 - last.x, tile.y + tile.h / 2 - last.y
end

-- Open: the middle of the route on the focus point; the top of the map stays on the screen. opts (all optional):
--   open_below   the south may leave the screen's bottom: the south of the Zone is the edge of the map, it fades out, and a route
--                there must not slide under the title
--   lit          { x1, x2 } the part of the screen no shade covers: the map keeps it covered. A map's mirrored copy looks like a
--                blot in plain sight, it may only lie under the shade.
--   fit_h        a route higher than this cannot fit: its newest end (the last stop) stays in the free part
function camera_open(stops, focus, map, view, opts)
	opts = opts or {}
	local cx, cy = map.w / 2, map.h / 2
	if stops[1] then
		local x1, y1, x2, y2 = stops[1].x, stops[1].y, stops[1].x, stops[1].y
		for _, p in ipairs(stops) do
			x1, x2 = min(x1, p.x), max(x2, p.x)
			y1, y2 = min(y1, p.y), max(y2, p.y)
		end
		cx, cy = (x1 + x2) / 2, (y1 + y2) / 2
		if opts.fit_h and y2 - y1 > opts.fit_h then cy = stops[#stops].y - opts.fit_h / 2 end
	end
	local y = focus.y - cy
	y = min(y, view.top)
	if not opts.open_below then y = max(y, view.bottom - map.h) end
	local x = focus.x - cx
	if opts.lit then x = max(min(x, opts.lit.x1), opts.lit.x2 - map.w) end
	return x, y
end

-- Dots along a broken line, `step` apart, at most `limit` + 1 of them (a long way spreads them); f = how far along, 0..1.
function dots_along(points, step, limit)
	local out = {}
	local n = #points
	if n < 2 then return out end
	local total = 0
	local seg = {}
	for i = 2, n do
		local dx, dy = points[i].x - points[i - 1].x, points[i].y - points[i - 1].y
		local d = (dx * dx + dy * dy) ^ .5
		seg[i] = d
		total = total + d
	end
	if total <= 0 then return out end
	if total / step > limit then step = total / limit end
	local i, walked, at = 2, 0, 0
	while at <= total + 1e-9 do
		while i < n and walked + seg[i] < at do
			walked = walked + seg[i]
			i = i + 1
		end
		local t = seg[i] > 0 and (at - walked) / seg[i] or 0
		out[#out + 1] = { x = mix(points[i - 1].x, points[i].x, t), y = mix(points[i - 1].y, points[i].y, t), f = at / total }
		at = at + step
	end
	return out
end

-------------------------------------------------------------------------------
-- Text
-------------------------------------------------------------------------------
-- The fonts have no letter spacing; a single byte per letter (cp1251) makes this enough.
function spaced(s)
	return (tostring(s):gsub(".", "%0 "):gsub(" $", ""))
end
