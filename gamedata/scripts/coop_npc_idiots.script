--[[
	Anomaly Coop - Useful Idiots (bellyillish, G.A.M.M.A. "450- Useful Idiots") for several players
	Historical W8 implementation used borrowed literal rewrite data. The current bounded
	transform is independently specified from bellyillish's original Useful Idiots package
	(E:/GAMMA/mods/450- Useful Idiots - bellyillish/gamedata/scripts/illish/patches/xr_danger.lua).

	Useful Idiots replaces xr_danger.is_danger in its package illish.patches.xr_danger (a require()'d .lua that
	z_idiots_patches.script loads at its file scope). The last check of that function tells the player from
	everybody else by a literal "dangerObject:id() == 0" / "~= 0". On the host a client's character has another
	id, so a neutral NPC ignored a client's gunfire that it reacts to from the host.

	Fix: a package searcher, put in front of Lua's file searcher at this file's scope (axr_main loads every
	script by name before any on_game_start, coop_* before z_idiots_patches). For that one package it reads the
	file, recognises the original final relation guard by Lua tokens and changes only its two player tests.
	Comments/strings are not executable matches; formatting does not matter. A different guard or ambiguous
	code falls through to Lua's normal loader unchanged. No module is replayed and package callbacks run once.
	A native decorator cannot reach this private early return without duplicating the complete upstream
	policy or faking game_object userdata. This source transform deliberately retains every preceding guard
	and every luabind argument. No xrRazom code/assets were used to implement it.
	Outside a session coop_idiots_player_id(id) is id == 0: single player behaves exactly like the mod.

	For other scripts / status: coop_npc_idiots.state = { installed, applied, file, why }

	G12-2: the point key runs through the stock trigger. The receiving level resolves the selected companions.
	The save keeps Useful Idiots' own NPC records and stores player templates under character IDs.

	G12-4 (m21:2): the other commands of the wheel (idiots_ui OnClickButton) and of the keys (idiots_keybinds onKeybindEvent).
	On a player's machine the companions are copies: what illish.lib.npc writes there (a state's info portion, IDIOTS_RELOAD,
	a look or move point in db.storage) no AI reads. While one button or key event runs there, every NPC.setState of a
	companion (toggleState, cycleActiveState, setStates and setState(nil) end in it), setReloadModes, lookAtPoint and
	moveOutOfTheWay is noted; a state still changes the copy at once (the wheel shows it), the others are not run there. The
	notes go out as one request, mods.idiots_cmd, to the decider of the player's level (co-op: the host; server: the world
	server passes it to the map server of his level). There every companion is checked (a living companion here; its leader
	from anywhere, another player next to it: orders are the group's), each command runs once with the library, the sender's
	character is "the actor" of an away order, VAR's shout of the order is not voiced by the decider's own actor, and the
	sender gets mods.idiots_state: the true state of every companion he named, which his copy then shows. The decider never
	forwards (no scope there), the point key and the personal template keep their own requests (G12-2). The co-op host's own
	wheel and keys and single player run the mod as it is. Not covered: waypoints and unstick of the wheel (se_save_var and
	alife():teleport_object on the copy).

	Events (ids in host numbering):
	  mods.idiots_cmd    player -> decider of his level  { c = "row|row..." }, rows: s,<id>,<group>,<action>,<1|0|n> (setState)
	                     m,<id>,<wmode|n>,<emode|n> (setReloadModes)  l,<id>,<x>,<y>,<z> (lookAtPoint)  a,<id> (moveOutOfTheWay)
	  mods.idiots_state  decider -> that player  { s = "<id>:<0/1 per info-bearing action of NPC.ACTIONS, in order>|..." }
--]]

local tostring, type, ipairs, pcall = tostring, type, ipairs, pcall
local string_format = string.format

MODULE = "illish.patches.xr_danger"

state = { installed = false, applied = false, tried = false, file = nil, why = nil }

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	local pf = rawget(_G, "printf")
	if pf then pcall(pf, "[coop-npc:idiots] %s", ok and line or tostring(fmt)) end
end

-- The NPC authority extends the actor rule to player proxies while other players are connected.
-- Use the shared per-frame answer so session and role changes make the proxy rule expire with it.
_G.coop_idiots_player_id = function(id)
	if id == 0 then return true end
	local ok, P = pcall(function() return coop_npc_players end)
	return ok and type(P) == "table" and type(P.host_on) == "function"
		and P.host_on() and P.is_player_id(id) == true or false
end

-- Small lexical scanner, not a Lua reformatter: retain byte offsets and leave the rest of
-- the source untouched. Long strings/comments and escaped quotes cannot become matches.
local function tokens(text)
	local out, i, size = {}, 1, #text
	local function long_end(at)
		local eq = text:match("^%[(=*)%[", at)
		if eq == nil then return nil end
		local _, last = text:find("]" .. eq .. "]", at + #eq + 2, true)
		return last or false
	end
	while i <= size do
		local c = text:sub(i, i)
		if c:match("%s") then
			i = i + 1
		elseif text:sub(i, i + 1) == "--" then
			local last = long_end(i + 2)
			if last == false then return nil, "unterminated long comment" end
			i = last and last + 1 or (text:find("\n", i + 2, true) or size + 1)
		else
			local last, value
			if c == '"' or c == "'" then
				local at = i + 1
				while at <= size do
					local ch = text:sub(at, at)
					if ch == "\\" then at = at + 2
					elseif ch == c then last = at; break
					else at = at + 1 end
				end
				if not last then return nil, "unterminated quoted string" end
				value = "<string>"
			elseif c == "[" then
				last = long_end(i)
				if last == false then return nil, "unterminated long string" end
				if last then value = "<string>" end
			end
			if not last then
				local word = text:match("^[%a_][%w_]*", i) or text:match("^%d[%w_%.]*", i)
				local op = text:sub(i, i + 1)
				value = word or ((op == "==" or op == "~=" or op == "<=" or op == ">=") and op or c)
				last = i + #value - 1
			end
			out[#out + 1] = { value = value, first = i, last = last }
			i = last + 1
		end
	end
	return out
end

local function matches(code, pattern)
	local found = {}
	for i = 1, #code - #pattern + 1 do
		local same = true
		for j, token in ipairs(pattern) do
			if code[i + j - 1].value ~= token.value then same = false; break end
		end
		if same then found[#found + 1] = i end
	end
	return found
end

-- The upstream final branch is deliberately version-gated: changing a threshold or
-- introducing another executable player test requires review, not a guessed adaptation.
local GUARD = tokens([[if dangerObject:id() == 0 and npc:relation(dangerObject) < 1 or dangerObject:id() ~= 0 and npc:relation(dangerObject) < 2 then
return false end return xr_danger.danger_in_radius(npc, danger, dangerType) end]])
local HEADER = tokens("function xr_danger.is_danger(npc, danger)")
local PLAYER_TESTS = {
	{ tokens("dangerObject:id() == 0"), "coop_idiots_player_id(dangerObject:id())" },
	{ tokens("dangerObject:id() ~= 0"), "not coop_idiots_player_id(dangerObject:id())" },
}

function rewrite(text)
	local code, why = tokens(text)
	if not code then return nil, why end
	local headers, guards = matches(code, HEADER), matches(code, GUARD)
	if #headers ~= 1 or #guards ~= 1 or guards[1] < headers[1] then return nil, "unsupported final relation guard" end
	local edits = {}
	for _, spec in ipairs(PLAYER_TESTS) do
		local found = matches(code, spec[1])
		if #found ~= 1 or found[1] < guards[1] or found[1] >= guards[1] + #GUARD then
			return nil, "ambiguous executable player test"
		end
		local at = found[1]
		edits[#edits + 1] = { first = code[at].first, last = code[at + #spec[1] - 1].last, text = spec[2] }
	end
	-- Apply from right to left so original offsets stay valid.
	table.sort(edits, function(a, b) return a.first > b.first end)
	for _, edit in ipairs(edits) do
		text = text:sub(1, edit.first - 1) .. edit.text .. text:sub(edit.last + 1)
	end
	return text
end

-- Where require() would look (package.path), then the game's scripts folder.
local function candidates(name)
	local rel = name:gsub("%.", "\\")
	local out = {}
	for pat in tostring(package.path or ""):gmatch("[^;]+") do
		out[#out + 1] = (pat:gsub("%?", rel))
	end
	local ok, root = pcall(function() return getFS():update_path("$game_scripts$", "") end)
	if ok and type(root) == "string" and root ~= "" then
		if not root:match("[\\/]$") then root = root .. "\\" end
		out[#out + 1] = root .. rel .. ".lua"
	end
	return out
end

local function searcher(name)
	if name ~= MODULE or state.tried then return nil end
	state.tried = true -- one attempt per Lua state; a failure falls through to the normal searchers
	for _, path in ipairs(candidates(name)) do
		local fh = io.open(path, "rb")
		if fh then
			local text = fh:read("*a")
			fh:close()
			local new, why = rewrite(text or "")
			if not new then
				state.why = why
				log("! %s: %s - loaded untouched, a client's gunfire keeps the single-player rule", path, why)
				return nil
			end
			local chunk, err = loadstring(new, "@" .. path)
			if not chunk then
				state.why = tostring(err)
				log("! %s: rewritten text does not compile (%s) - loaded untouched", path, tostring(err))
				return nil
			end
			state.applied, state.file = true, path
			log("%s: danger from any co-op player counts like the player's", path)
			return chunk
		end
	end
	state.why = "file not found"
	log("! %s: file not found next to package.path - loaded untouched", name)
	return nil
end

function install()
	if not rawget(_G, "coop") then return false end -- exe without co-op: the mod as it is
	local loaders = type(package) == "table" and package.loaders
	if type(loaders) ~= "table" then return false end
	for _, f in ipairs(loaders) do
		if f == searcher then return true end
	end
	if package.loaded[MODULE] then
		state.why = "loaded before this script"
		log("! %s was loaded before the co-op searcher: not patched", MODULE)
		return false
	end
	table.insert(loaders, 2, searcher) -- after package.preload, before the .lua file searcher
	state.installed = true
	return true
end

function print_status()
	log("Useful Idiots: searcher %s, %s%s", state.installed and "on" or "off",
		state.applied and ("patched " .. tostring(state.file)) or (state.tried and "not patched" or "package not loaded"),
		state.why and (" (" .. state.why .. ")") or "")
end

local ok, err = pcall(install)
if not ok then log("! install: %s", tostring(err)) end

local POINT, TEMPLATE = "idiots_point", "idiots_template"
local TEMPLATES = "coop_idiots_templates"
local MAX_IDS, MAX_COORD = 128, 100000
local npc, beh, mdata
local installed = false

local function C() return coop_mods_core end

local function valid_id(id, min)
	return type(id) == "number" and id >= min and id < 65535 and id % 1 == 0
end

local function templates(create)
	local m = alife_storage_manager.get_state()
	if type(m[TEMPLATES]) ~= "table" and create then m[TEMPLATES] = {} end
	return type(m[TEMPLATES]) == "table" and m[TEMPLATES] or nil
end

function saved_templates()
	return npc and templates(false) or nil
end

function receive_templates(rows)
	if npc and type(rows) == "table" then alife_storage_manager.get_state()[TEMPLATES] = rows end
end

local function copy_template(saved)
	local out = dup_table(npc.DEFAULT_STATE)
	if type(saved) == "table" then
		for g, actions in pairs(out) do
			local row = saved[g]
			if type(row) == "table" then
				for a in pairs(actions) do
					if type(row[a]) == "boolean" then actions[a] = row[a] end
				end
			end
		end
	end
	return out
end

local function template_of(owner)
	local rows = templates(false)
	return copy_template(rows and rows[owner])
end

-- The same change to a template that NPC.setState(nil, ...) makes, without its walk of the UI's companion list.
local function set_template_state(template, group, action, enabled)
	local states = template[group]
	if npc.ACTIONS_KEYED[group].cycle then
		if enabled then
			for other in pairs(states) do states[other] = other == action end
		end
	else
		states[action] = enabled
	end
end

local function sender_character(from)
	for _, player in ipairs(C().players()) do
		if player.id == from then return player.avatar_id end
	end
end

local function on_template(t, from)
	local owner = sender_character(from)
	local good = npc and valid_id(owner, 1) and type(t.group) == "string" and type(t.action) == "string"
		and type(t.enabled) == "boolean" and npc.isStateful(t.group, t.action)
	if not coop_trust.pass("idiots_template_args", good, "peer %d: invalid personal template change", from) or not good then return end
	local value = template_of(owner)
	set_template_state(value, t.group, t.action, t.enabled)
	templates(true)[owner] = value
end

local function send_template(group, action, enabled)
	C().to_host(TEMPLATE, { group = group, action = action, enabled = enabled })
end

-- Iterate the actual squads and online objects, independent of who the UI's current actor is.
function capture_states()
	if not (mdata and npc and beh and C().active() and coop_mode.leads_here()) then return nil end
	local rows = {}
	local squads = axr_companions and axr_companions.companion_squads
	for _, squad in pairs(squads or {}) do
		if squad and squad.squad_members and not axr_task_manager.hostages_by_id[squad:commander_id()] then
			for member in squad:squad_members() do
				local id = member.id
				local obj = level.object_by_id(id)
				if obj and db.storage[id] and npc.isCompanion(obj) then
					local host_id = C().hid(id)
					if valid_id(host_id, 1) then
						local storage = {}
						beh.saveStorage(id, storage)
						rows[host_id] = { states = npc.getAllStates(obj), beh = storage[id] }
					end
				end
			end
		end
	end
	return rows
end

local function merge_rows(data, rows)
	data.companionStates = data.companionStates or {}
	data.beh = data.beh or {}
	for id, row in pairs(rows or {}) do
		if valid_id(id, 1) and type(row) == "table" and type(row.states) == "table" then
			data.companionStates[id] = row.states
			data.beh[id] = type(row.beh) == "table" and row.beh or nil
		end
	end
end

function receive_states(rows)
	if mdata and type(rows) == "table" then merge_rows(mdata.initStorage(), rows) end
end

local function wrap_callback(name, key, make)
	local wrapped, orig = C().wrap(mdata, key, "idiots." .. key, make)
	if wrapped then C().swap_callback(name, orig, mdata[key]) end
end

local function install_storage()
	if not (mdata and npc and beh) then return end
	wrap_callback("save_state", "onSaveState", function(orig)
		return function(...)
			if not C().active() then return orig(...) end
			if not coop_mode.decides_world() then return end
			local data = mdata.initStorage()
			if coop_mode.actor_is_player() then
				data.globalState = copy_template(npc.GLOBAL_STATE)
				templates(true)[0] = data.globalState
			end
			data.sharedItems = npc.LOOT_SHARED_ITEMS
			data.sharingNPCs = npc.LOOT_SHARING_NPCS
			merge_rows(data, capture_states())
		end
	end)
	wrap_callback("load_state", "onLoadState", function(orig)
		return function(...)
			if not C().active() then return orig(...) end
			if coop_mode.is_player_mirror() then
				npc.GLOBAL_STATE = template_of(C().hid(0))
				return
			end
			npc.GLOBAL_STATE = copy_template()
			if coop_mode.actor_is_player() then
				local rows = templates(false)
				if rows and rows[0] then mdata.initStorage().globalState = copy_template(rows[0]) end
			end
			return orig(...)
		end
	end)
	wrap_callback("npc_on_net_spawn", "onNpcSpawn", function(orig)
		return function(obj, ...)
			if not C().active() then return orig(obj, ...) end
			if not coop_mode.leads_here() then return end
			local owner = coop_npc_companions.owner_character(obj)
			if owner == nil or (owner == 0 and coop_mode.actor_is_player()) then return orig(obj, ...) end
			local previous = npc.GLOBAL_STATE
			npc.GLOBAL_STATE = template_of(owner)
			local success, e = pcall(orig, obj, ...)
			npc.GLOBAL_STATE = previous
			if not success then error(e, 0) end
		end
	end)
	C().wrap(npc, "setState", "idiots.personal_template", function(orig)
		return function(obj, group, action, enabled, ...)
			if obj or not C().active() or not coop_mode.is_player_mirror() or not npc.isStateful(group, action) then
				return orig(obj, group, action, enabled, ...)
			end
			local before = npc.GLOBAL_STATE[group][action]
			orig(obj, group, action, enabled, ...)
			local after = npc.GLOBAL_STATE[group][action]
			if before ~= after then send_template(group, action, after) end
		end
	end)
	C().set_limit(TEMPLATE, 16, 8)
	C().on(TEMPLATE, on_template, "world")
end

local function coordinate(x)
	return type(x) == "number" and x >= -MAX_COORD and x <= MAX_COORD
end

local function parse_ids(value)
	if type(value) ~= "string" or #value == 0 or #value > MAX_IDS * 6 then return nil end
	local ids, seen = {}, {}
	for word in value:gmatch("[^,]+") do
		local id = word:match("^%d+$") and tonumber(word)
		if not valid_id(id, 1) or seen[id] or #ids == MAX_IDS then return nil end
		ids[#ids + 1], seen[id] = id, true
	end
	if table.concat(ids, ",") ~= value then return nil end
	return ids
end

local function on_point(t, from)
	local ids = parse_ids(t.ids)
	local good = ids and coordinate(t.x) and coordinate(t.y) and coordinate(t.z)
		and type(t.autoWait) == "boolean" and type(t.autoGuard) == "boolean"
	if not coop_trust.pass("idiots_point_args", good, "peer %d: invalid point command", from) or not good then return false end
	local actor = C().avatar(from)
	local owner = actor and C().hid(actor:id())
	local targets = {}
	for _, id in ipairs(ids) do
		local lid = C().lid(id)
		local obj = lid and level.object_by_id(lid)
		local storage = lid and db.storage[lid]
		local ready = storage and storage[storage.enemy and "combat" or "beh"]
		if ready and npc.isCompanion(obj) and coop_npc_companions.owner_character(obj) == owner then
			targets[#targets + 1] = obj
		end
	end
	local owned = valid_id(owner, 0) and actor:alive() and #targets == #ids
	-- Even in log mode there is no valid game target for a stale or foreign selection.
	if not coop_trust.pass("idiots_point_owner", owned, "peer %d: point command has a missing or foreign companion", from)
		or not owned then return false end
	local pos = vector():set(t.x, t.y, t.z)
	for _, obj in ipairs(targets) do
		npc.moveToPoint(obj, pos)
		if t.autoWait then npc.setState(obj, "movement", "wait", true) end
		if t.autoGuard then npc.setState(obj, "combat", "guard", true) end
	end
	return true
end

local function local_point(keys)
	local companions = npc.getCompanions()
	local selected = #companions == 1 and companions or table.keys(npc.SELECTED_IDS)
	local list = #selected > 0 and selected or companions
	local pos = level.get_target_pos()
	if not pos or #list == 0 or #list > MAX_IDS then return end
	local ids = {}
	for i, obj in ipairs(list) do
		local id = C().hid(type(obj) == "number" and obj or obj:id())
		if not valid_id(id, 1) then return end
		ids[i] = id
	end
	local t = { ids = table.concat(ids, ","), x = pos.x, y = pos.y, z = pos.z,
		autoWait = not not ui_mcm.get("idiots/options/autoWait"),
		autoGuard = not not ui_mcm.get("idiots/options/autoGuard") }
	local mirror = coop_mode.is_player_mirror()
	local accepted
	if mirror then
		accepted = C().to_host(POINT, t)
	elseif coop_mode.leads_here() and coop_mode.actor_is_player() then
		accepted = on_point(t, C().self_peer())
	end
	if not accepted then return end
	if #selected == 0 then
		if t.autoWait then
			set_template_state(npc.GLOBAL_STATE, "movement", "wait", true)
			if mirror then send_template("movement", "wait", true) end
		end
		if t.autoGuard then
			set_template_state(npc.GLOBAL_STATE, "combat", "guard", true)
			if mirror then send_template("combat", "guard", true) end
		end
	end
	if #selected > 0 then
		keys.showMessage("st_idiots_move_point_message", #selected)
	else
		keys.showMessage("st_idiots_move_all_point_message")
	end
	if ui_mcm.get("idiots/options/autoDeselect") then npc.SELECTED_IDS = {} end
	if gesture and gesture.play_stuff then gesture.play_stuff("gesture_sound", "point_forward", "anm_point", true, true) end
	keys.playParticle(pos)
end

local function install_keys()
	local keys = C().mod("idiots_keybinds")
	if not (keys and npc) then return end
	local wrapped = C().wrap(keys, "checkKeybind", "idiots.point_trigger", function(orig)
		return function(event, dik, group, action)
			local trigger = orig(event, dik, group, action)
			if not trigger or group ~= "point" or action ~= "move" or not C().active()
				or not (coop_mode.is_player_mirror() or coop_mode.leads_here() and coop_mode.actor_is_player()) then return trigger end
			local_point(keys)
			return false -- the stock move branch has been served, keep testing the other bindings
		end
	end)
	if not wrapped then return end
	-- The companion adapter also has a raw on_key_press bridge for the stock game.
	-- Suppress its Useful Idiots path even when its callback runs before the mod's trigger.
	C().wrap(coop_npc_players, "send", "idiots.legacy_point", function(orig)
		return function(name, ...)
			if name == "npc.comp_go" and C().active() and coop_mode.is_player_mirror() then return false end
			return orig(name, ...)
		end
	end)
	C().set_limit(POINT, 8, 4)
	C().on(POINT, on_point, "host")
end

-- G12-4 (m21:2): the wheel's and the keys' commands on a player's machine go to the decider of his level.
local CMD, STATE = "idiots_cmd", "idiots_state"
local MAX_CMDS, MAX_ROWS, MAX_BYTES, NEAR_SQR = 256, 1024, 12000, 225 -- rows per request, per button / key event; 15 m
local scope, batch, quiet, infos = 0, nil, 0, nil -- player: inside a command / its rows; decider: running a player's rows

-- The info portions of NPC.ACTIONS in their order: a companion's state, as the decider answers it.
local function info_actions()
	if not infos then
		infos = {}
		for _, group in ipairs(npc.ACTIONS or {}) do
			for _, action in ipairs(group.actions or {}) do
				if type(action.info) == "string" then infos[#infos + 1] = action.info end
			end
		end
	end
	return infos
end

local function command_id(obj)
	if type(obj) == "number" then obj = npc.getCompanion(obj) end
	local id = obj and C().hid(obj:id())
	return valid_id(id, 1) and id or nil
end

local function note(row)
	batch = batch or {}
	if #batch < MAX_ROWS then
		batch[#batch + 1] = row
	elseif #batch == MAX_ROWS then
		log("! a companion command over %d rows is not sent", MAX_ROWS)
		batch[#batch + 1] = false
	end
	return true
end

local function note_state(obj, group, action, enabled)
	local id = command_id(obj)
	local e = enabled == true and "1" or enabled == false and "0" or enabled == nil and "n" or nil
	if id and e and type(group) == "string" and type(action) == "string" and group:match("^[%a_]+$")
		and action:match("^[%a_]+$") and npc.isStateful(group, action) then
		note(string_format("s,%d,%s,%s,%s", id, group, action, e))
	end
end

local function mode_word(v, max)
	if v == nil then return "n" end
	if type(v) == "number" and v >= 0 and v <= max and v % 1 == 0 then return string_format("%d", v) end
end

local function note_reload(obj, wmode, emode)
	local id, w, e = command_id(obj), mode_word(wmode, 1), mode_word(emode, 2)
	return id ~= nil and w ~= nil and e ~= nil and note(string_format("m,%d,%s,%s", id, w, e))
end

local function note_look(obj, pos)
	local id = command_id(obj)
	local ok, x, y, z = pcall(function() return pos.x, pos.y, pos.z end)
	return id ~= nil and ok and coordinate(x) and coordinate(y) and coordinate(z)
		and note(string_format("l,%d,%.3f,%.3f,%.3f", id, x, y, z))
end

local function note_away(obj, options)
	local id = options == nil and command_id(obj)
	return id and note(string_format("a,%d", id)) or false
end

local function send_commands(rows)
	local part, size = {}, 0
	local function flush()
		if #part > 0 then C().to_host(CMD, { c = table.concat(part, "|") }) end
		part, size = {}, 0
	end
	for _, row in ipairs(rows) do
		if row then
			if #part == MAX_CMDS or size + #row + 1 > MAX_BYTES then flush() end
			part[#part + 1] = row
			size = size + #row + 1
		end
	end
	flush()
end

local function close_scope(ok, ...)
	scope = 0
	local rows = batch
	batch = nil
	if rows then send_commands(rows) end
	if not ok then error((...), 0) end
	return ...
end

-- A wheel button or a key event of a player's machine: its library calls become one request.
local function command_scope(orig)
	return function(...)
		if scope > 0 or not (C().active() and coop_mode.is_player_mirror()) then return orig(...) end
		scope = 1
		return close_scope(pcall(orig, ...))
	end
end

local function install_library()
	C().wrap(npc, "setState", "idiots.cmd_state", function(orig)
		return function(obj, group, action, enabled, ...)
			if scope > 0 and obj ~= nil then note_state(obj, group, action, enabled) end
			return orig(obj, group, action, enabled, ...)
		end
	end)
	C().wrap(npc, "setReloadModes", "idiots.cmd_reload", function(orig)
		return function(obj, wmode, emode, ...)
			if scope > 0 and note_reload(obj, wmode, emode) then return end
			return orig(obj, wmode, emode, ...)
		end
	end)
	C().wrap(npc, "lookAtPoint", "idiots.cmd_look", function(orig)
		return function(obj, pos, ...)
			if scope > 0 and note_look(obj, pos) then return end
			return orig(obj, pos, ...)
		end
	end)
	C().wrap(npc, "moveOutOfTheWay", "idiots.cmd_away", function(orig)
		return function(obj, options, ...)
			if scope > 0 and note_away(obj, options) then return end
			return orig(obj, options, ...)
		end
	end)
end

local function parse_row(row)
	local kind = row:sub(1, 1)
	if kind == "s" then
		local id, group, action, e = row:match("^s,(%d+),([%a_]+),([%a_]+),([01n])$")
		id = tonumber(id)
		if not (valid_id(id, 1) and npc.isStateful(group, action)) then return nil end
		local enabled = nil
		if e == "1" then enabled = true elseif e == "0" then enabled = false end
		return { k = kind, id = id, group = group, action = action, enabled = enabled }
	elseif kind == "m" then
		local id, w, e = row:match("^m,(%d+),([%dn]),([%dn])$")
		id, w, e = tonumber(id), tonumber(w), tonumber(e) -- "n": nil, the library's default
		if not (valid_id(id, 1) and (w == nil or w <= 1) and (e == nil or e <= 2)) then return nil end
		return { k = kind, id = id, wmode = w, emode = e }
	elseif kind == "l" then
		local id, x, y, z = row:match("^l,(%d+),(%-?[%d%.]+),(%-?[%d%.]+),(%-?[%d%.]+)$")
		id, x, y, z = tonumber(id), tonumber(x), tonumber(y), tonumber(z)
		if not (valid_id(id, 1) and coordinate(x) and coordinate(y) and coordinate(z)) then return nil end
		return { k = kind, id = id, x = x, y = y, z = z }
	elseif kind == "a" then
		local id = tonumber(row:match("^a,(%d+)$"))
		return valid_id(id, 1) and { k = kind, id = id } or nil
	end
	return nil
end

local function parse_commands(c)
	if type(c) ~= "string" or #c == 0 or #c > MAX_BYTES or c:find("||", 1, true) or c:sub(1, 1) == "|"
		or c:sub(-1) == "|" then return nil end
	local rows = {}
	for row in c:gmatch("[^|]+") do
		if #rows == MAX_CMDS then return nil end
		local cmd = parse_row(row)
		if not cmd then return nil end
		rows[#rows + 1] = cmd
	end
	return rows
end

local function command_object(id)
	local lid = C().lid(id)
	return lid and level.object_by_id(lid), lid
end

-- The decider's companion of a command (nil: no target, or refused) and the object the sender named. Orders are the
-- group's (owner 2026-11-01): its leader's from anywhere, another player's next to it.
local function command_target(cmd, from, actor, owner)
	local obj, lid = command_object(cmd.id)
	local st = obj and db.storage[lid]
	local ready = obj and npc.isCompanion(obj) and (cmd.k ~= "l" and cmd.k ~= "a"
		or st ~= nil and st[st.enemy and "combat" or "beh"] ~= nil) or false
	if not coop_trust.guard("idiots_cmd_target", ready, "peer %d: command for %d, no living companion here", from, cmd.id)
		then return nil, obj end
	local owned = actor:alive() and (coop_npc_companions.owner_character(obj) == owner
		or actor:position():distance_to_sqr(obj:position()) <= NEAR_SQR)
	if not coop_trust.pass("idiots_cmd_owner", owned, "peer %d: command for %d, a far companion he does not lead",
		from, cmd.id) then return nil, obj end
	return obj, obj
end

local function run_command(cmd, obj, actor)
	if cmd.k == "s" then
		npc.setState(obj, cmd.group, cmd.action, cmd.enabled)
	elseif cmd.k == "m" then
		npc.setReloadModes(obj, cmd.wmode, cmd.emode)
	elseif cmd.k == "l" then
		npc.lookAtPoint(obj, vector():set(cmd.x, cmd.y, cmd.z))
	else
		local ok, e = C().as_player(actor, npc.moveOutOfTheWay, obj) -- "the actor" it steps away from is the sender
		if not ok then error(e, 0) end
	end
end

local function answer(from, ids, objs)
	local part, size = {}, 0
	for _, id in ipairs(ids) do
		local obj = objs[id]
		if npc.isCompanion(obj) then
			local bits = {}
			for i, info in ipairs(info_actions()) do bits[i] = obj:has_info(info) and "1" or "0" end
			local row = string_format("%d:%s", id, table.concat(bits))
			if size + #row + 1 > MAX_BYTES then
				C().to_peer(from, STATE, { s = table.concat(part, "|") })
				part, size = {}, 0
			end
			part[#part + 1] = row
			size = size + #row + 1
		end
	end
	if #part > 0 then C().to_peer(from, STATE, { s = table.concat(part, "|") }) end
end

local function answer_skipped(t, from, rows)
	-- The world server can drop a request at its rate limit before relaying it. Only the level leader has these states.
	if not coop_mode.leads_here() then return end
	rows = rows or parse_commands(t.c)
	if not rows then return end
	local ids, objs = {}, {}
	for _, cmd in ipairs(rows) do
		local id = cmd.id
		if not objs[id] then
			local obj = command_object(id)
			if obj then
				objs[id] = obj
				ids[#ids + 1] = id
			end
		end
	end
	answer(from, ids, objs)
end

-- Decider of the sender's level: run each command once, then tell him the true state of every companion he named.
local function on_commands(t, from)
	local rows = parse_commands(t.c)
	local good = rows ~= nil
	if not coop_trust.pass("idiots_cmd_args", good, "peer %d: invalid companion command list", from) or not good then return end
	local actor = C().avatar(from)
	local owner = actor and C().hid(actor:id())
	if not valid_id(owner, 0) then return answer_skipped(t, from, rows) end
	local ids, objs = {}, {}
	quiet = quiet + 1
	for _, cmd in ipairs(rows) do
		local okc, obj, named = pcall(command_target, cmd, from, actor, owner)
		if okc then
			if named and not objs[cmd.id] then
				objs[cmd.id] = named
				ids[#ids + 1] = cmd.id
			end
			if obj then
				local ok, e = pcall(run_command, cmd, obj, actor)
				if not ok then log("! command %s for %d: %s", cmd.k, cmd.id, e) end
			end
		else
			log("! command target %s for %d: %s", cmd.k, cmd.id, obj)
		end
	end
	quiet = quiet - 1
	answer(from, ids, objs)
end

-- Player's machine: the decider's state of his companions, on their copies.
local function on_state(t)
	if not (npc and coop_mode.is_player_mirror() and type(t.s) == "string" and #t.s <= MAX_BYTES) then return end
	local list = info_actions()
	for row in t.s:gmatch("[^|]+") do
		local id, flags = row:match("^(%d+):([01]+)$")
		id = tonumber(id)
		local lid = valid_id(id, 1) and #flags == #list and C().lid(id)
		local obj = lid and level.object_by_id(lid)
		if obj then
			for i, info in ipairs(list) do
				local want, have = flags:byte(i) == 49, obj:has_info(info)
				if want and not have then
					obj:give_info_portion(info)
				elseif have and not want then
					obj:disable_info_portion(info)
				end
			end
		end
	end
end

local function install_commands()
	if not npc then return end
	install_library()
	local keys, ui = C().mod("idiots_keybinds"), C().mod("idiots_ui")
	if keys then C().wrap(keys, "onKeybindEvent", "idiots.cmd_keys", command_scope) end
	local okw, wheel = pcall(function() return ui and ui.UIWheelCompanion end)
	if okw and wheel then C().wrap(wheel, "OnClickButton", "idiots.cmd_wheel", command_scope) end
	-- VAR shouts an order through the "actor" of this process (illish.patches.axr_companions' legacy setters): a player's
	-- order run here is his, not this process's player's
	local ac = C().mod("axr_companions")
	if ac and C().fn(ac, "actors_command") then
		C().wrap(ac, "actors_command", "idiots.remote_quiet", function(orig)
			return function(...)
				if quiet > 0 then return end
				return orig(...)
			end
		end)
	end
	C().set_limit(CMD, 8, 4, answer_skipped)
	C().on(CMD, on_commands, "host")
	C().on(STATE, on_state, "player")
end

local function start_step(name, f)
	local success, e = pcall(f)
	if not success then log("! %s: %s", name, tostring(e)) end
end

function on_game_start()
	if installed or not rawget(_G, "coop") then return end
	installed = true
	start_step("storage", function()
		mdata = C().mod("a_idiots_mdata")
		npc, beh = package.loaded["illish.lib.npc"], package.loaded["illish.lib.beh"]
		install_storage()
	end)
	start_step("point key", install_keys)
	start_step("commands", install_commands)
end
