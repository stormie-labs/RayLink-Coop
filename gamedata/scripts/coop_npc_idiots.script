--[[
	Anomaly Coop - Useful Idiots (bellyillish, G.A.M.M.A. "450- Useful Idiots") for several players
	Historical W8 implementation used borrowed literal rewrite data. The current bounded
	transform is independently specified from bellyillish's original Useful Idiots package
	(E:/GAMMA/mods/450- Useful Idiots - bellyillish/gamedata/scripts/illish/patches/xr_danger.lua).

	Useful Idiots replaces xr_danger.is_danger in its package illish.patches.xr_danger (a require()'d .lua that
	z_idiots_patches.script loads at its file scope). The last check of that function tells the player from
	everybody else by a literal "dangerObject:id() == 0" / "~= 0". On the host a client's character has another
	id, so a neutral NPC ignored a client's gunfire that it reacts to from the host.

	Fix: a package searcher, put in front of Lua's file searcher at this file's scope (axr_main loads every
	script by name before any on_game_start, coop_* before z_idiots_patches). For that one package it reads the
	file, recognises the original final relation guard by Lua tokens and changes only its two player tests.
	Comments/strings are not executable matches; formatting does not matter. A different guard or ambiguous
	code falls through to Lua's normal loader unchanged. No module is replayed and package callbacks run once.
	A native decorator cannot reach this private early return without duplicating the complete upstream
	policy or faking game_object userdata. This source transform deliberately retains every preceding guard
	and every luabind argument. No xrRazom code/assets were used to implement it.
	Outside a session coop_idiots_player_id(id) is id == 0: single player behaves exactly like the mod.

	For other scripts / status: coop_npc_idiots.state = { installed, applied, file, why }
--]]

local tostring, type, ipairs, pcall = tostring, type, ipairs, pcall
local string_format = string.format

MODULE = "illish.patches.xr_danger"

state = { installed = false, applied = false, tried = false, file = nil, why = nil }

local function log(fmt, ...)
	local ok, line = pcall(string_format, fmt, ...)
	local pf = rawget(_G, "printf")
	if pf then pcall(pf, "[coop-npc:idiots] %s", ok and line or tostring(fmt)) end
end

-- Only the host extends the actor rule to real player proxies. No cached predicate:
-- leaving a session or changing roles must immediately restore the upstream classification.
_G.coop_idiots_player_id = function(id)
	if id == 0 then return true end
	local ok, P = pcall(function() return coop_npc_players end)
	return ok and type(P) == "table" and type(P.host_with_clients) == "function"
		and P.host_with_clients() and P.is_player_id(id) == true or false
end

-- Small lexical scanner, not a Lua reformatter: retain byte offsets and leave the rest of
-- the source untouched. Long strings/comments and escaped quotes cannot become matches.
local function tokens(text)
	local out, i, size = {}, 1, #text
	local function long_end(at)
		local eq = text:match("^%[(=*)%[", at)
		if eq == nil then return nil end
		local _, last = text:find("]" .. eq .. "]", at + #eq + 2, true)
		return last or false
	end
	while i <= size do
		local c = text:sub(i, i)
		if c:match("%s") then
			i = i + 1
		elseif text:sub(i, i + 1) == "--" then
			local last = long_end(i + 2)
			if last == false then return nil, "unterminated long comment" end
			i = last and last + 1 or (text:find("\n", i + 2, true) or size + 1)
		else
			local last, value
			if c == '"' or c == "'" then
				local at = i + 1
				while at <= size do
					local ch = text:sub(at, at)
					if ch == "\\" then at = at + 2
					elseif ch == c then last = at; break
					else at = at + 1 end
				end
				if not last then return nil, "unterminated quoted string" end
				value = "<string>"
			elseif c == "[" then
				last = long_end(i)
				if last == false then return nil, "unterminated long string" end
				if last then value = "<string>" end
			end
			if not last then
				local word = text:match("^[%a_][%w_]*", i) or text:match("^%d[%w_%.]*", i)
				local op = text:sub(i, i + 1)
				value = word or ((op == "==" or op == "~=" or op == "<=" or op == ">=") and op or c)
				last = i + #value - 1
			end
			out[#out + 1] = { value = value, first = i, last = last }
			i = last + 1
		end
	end
	return out
end

local function matches(code, pattern)
	local found = {}
	for i = 1, #code - #pattern + 1 do
		local same = true
		for j, token in ipairs(pattern) do
			if code[i + j - 1].value ~= token.value then same = false; break end
		end
		if same then found[#found + 1] = i end
	end
	return found
end

-- The upstream final branch is deliberately version-gated: changing a threshold or
-- introducing another executable player test requires review, not a guessed adaptation.
local GUARD = tokens([[if dangerObject:id() == 0 and npc:relation(dangerObject) < 1 or dangerObject:id() ~= 0 and npc:relation(dangerObject) < 2 then
return false end return xr_danger.danger_in_radius(npc, danger, dangerType) end]])
local HEADER = tokens("function xr_danger.is_danger(npc, danger)")
local PLAYER_TESTS = {
	{ tokens("dangerObject:id() == 0"), "coop_idiots_player_id(dangerObject:id())" },
	{ tokens("dangerObject:id() ~= 0"), "not coop_idiots_player_id(dangerObject:id())" },
}

function rewrite(text)
	local code, why = tokens(text)
	if not code then return nil, why end
	local headers, guards = matches(code, HEADER), matches(code, GUARD)
	if #headers ~= 1 or #guards ~= 1 or guards[1] < headers[1] then return nil, "unsupported final relation guard" end
	local edits = {}
	for _, spec in ipairs(PLAYER_TESTS) do
		local found = matches(code, spec[1])
		if #found ~= 1 or found[1] < guards[1] or found[1] >= guards[1] + #GUARD then
			return nil, "ambiguous executable player test"
		end
		local at = found[1]
		edits[#edits + 1] = { first = code[at].first, last = code[at + #spec[1] - 1].last, text = spec[2] }
	end
	-- Apply from right to left so original offsets stay valid.
	table.sort(edits, function(a, b) return a.first > b.first end)
	for _, edit in ipairs(edits) do
		text = text:sub(1, edit.first - 1) .. edit.text .. text:sub(edit.last + 1)
	end
	return text
end

-- Where require() would look (package.path), then the game's scripts folder.
local function candidates(name)
	local rel = name:gsub("%.", "\\")
	local out = {}
	for pat in tostring(package.path or ""):gmatch("[^;]+") do
		out[#out + 1] = (pat:gsub("%?", rel))
	end
	local ok, root = pcall(function() return getFS():update_path("$game_scripts$", "") end)
	if ok and type(root) == "string" and root ~= "" then
		if not root:match("[\\/]$") then root = root .. "\\" end
		out[#out + 1] = root .. rel .. ".lua"
	end
	return out
end

local function searcher(name)
	if name ~= MODULE or state.tried then return nil end
	state.tried = true -- one attempt per Lua state; a failure falls through to the normal searchers
	for _, path in ipairs(candidates(name)) do
		local fh = io.open(path, "rb")
		if fh then
			local text = fh:read("*a")
			fh:close()
			local new, why = rewrite(text or "")
			if not new then
				state.why = why
				log("! %s: %s - loaded untouched, a client's gunfire keeps the single-player rule", path, why)
				return nil
			end
			local chunk, err = loadstring(new, "@" .. path)
			if not chunk then
				state.why = tostring(err)
				log("! %s: rewritten text does not compile (%s) - loaded untouched", path, tostring(err))
				return nil
			end
			state.applied, state.file = true, path
			log("%s: danger from any co-op player counts like the player's", path)
			return chunk
		end
	end
	state.why = "file not found"
	log("! %s: file not found next to package.path - loaded untouched", name)
	return nil
end

function install()
	if not rawget(_G, "coop") then return false end -- exe without co-op: the mod as it is
	local loaders = type(package) == "table" and package.loaders
	if type(loaders) ~= "table" then return false end
	for _, f in ipairs(loaders) do
		if f == searcher then return true end
	end
	if package.loaded[MODULE] then
		state.why = "loaded before this script"
		log("! %s was loaded before the co-op searcher: not patched", MODULE)
		return false
	end
	table.insert(loaders, 2, searcher) -- after package.preload, before the .lua file searcher
	state.installed = true
	return true
end

function print_status()
	log("Useful Idiots: searcher %s, %s%s", state.installed and "on" or "off",
		state.applied and ("patched " .. tostring(state.file)) or (state.tried and "not patched" or "package not loaded"),
		state.why and (" (" .. state.why .. ")") or "")
end

local ok, err = pcall(install)
if not ok then log("! install: %s", tostring(err)) end
