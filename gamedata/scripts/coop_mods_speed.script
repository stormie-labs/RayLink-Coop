--[[
	Anomaly Coop - movement speed diagnostic (gamedata\scripts\coop_mods_speed.script).

	Players asked why a client with movement 101% runs faster than the host with 110%. The percentage in the inventory is
	only the outfit's entry (outfit_speed_mcm.get_outfit_speed). The speed that moves the actor is speed.script's product of
	every run / sprint modifier: outfit, load, BHS legs, weapon in the hands, endurance skill, artefacts, anomalies. Each
	machine computes it for its own player with the same scripts, so two players with different loads or legs run at
	different speeds whatever their outfits say.

	So that one session log shows why two players differ, every machine that plays a character (the host's own game and
	every client; not a map server or a world server with no character) writes ONE line every 30 s, and only when it changed:
	  [coop-mods] [speed] run x.xx sprint x.xx = run <key> <value> ... | sprint <key> <value> ...
	run / sprint are the actor's coefficients as the engine holds them now (get_actor_run_coef / get_actor_sprint_koef);
	the pairs are speed.script's run_modifiers and sprint_modifiers.

	Reading only: no setter is called, no table is written. Every foreign read is protected, nothing reaches actor_on_update.
--]]

local api = rawget(_G, "coop")

local tostring, type, pairs, pcall, string_format = tostring, type, pairs, pcall, string.format

local core = coop_mods_core

local PERIOD_MS = 30000

local st = { next = nil, last = nil, lines = 0 }

-- "k1 v1 k2 v2" in key order, so the same state always gives the same text.
local function pairs_text(t)
	if type(t) ~= "table" then return "?" end
	local keys = {}
	for k in pairs(t) do keys[#keys + 1] = tostring(k) end
	if #keys == 0 then return "-" end
	table.sort(keys)
	local out = {}
	for _, k in ipairs(keys) do
		local v = t[k]
		if v == nil then -- the key was not a string in the table
			for kk, vv in pairs(t) do if tostring(kk) == k then v = vv break end end
		end
		out[#out + 1] = k .. " " .. (type(v) == "number" and string_format("%.3f", v) or tostring(v))
	end
	return table.concat(out, " ")
end

local function coef(actor, getter)
	local ok, v = pcall(function() return actor[getter](actor) end)
	if ok and type(v) == "number" then return string_format("%.2f", v) end
	return "?"
end

-- The text of this machine's player now, or nil when there is nothing to tell.
local function snapshot()
	local actor = db and db.actor
	if not actor then return nil end
	local M = core.mod("speed")
	local run_t, sprint_t = nil, nil
	if type(M) == "table" then
		-- speed.script keeps both tables as file locals: they are upvalues of its add_speed / remove_speed.
		local ok1, r = pcall(core.find_local, M, "run_modifiers")
		local ok2, s = pcall(core.find_local, M, "sprint_modifiers")
		run_t = ok1 and r or nil
		sprint_t = ok2 and s or nil
	end
	return string_format("run %s sprint %s = run %s | sprint %s", coef(actor, "get_actor_run_coef"),
		coef(actor, "get_actor_sprint_koef"), pairs_text(run_t), pairs_text(sprint_t))
end

-- A machine with a player character in a session: the host's game or a client, not a headless server.
local function plays_here()
	return core.active() and coop_mode.actor_is_player()
end

local function step()
	if not plays_here() then return end
	local now = time_global()
	if not st.next then
		st.next = now + PERIOD_MS
		return
	end
	st.next = now + PERIOD_MS
	local text = snapshot()
	if not text or text == st.last then return end
	st.last = text
	st.lines = st.lines + 1
	core.log("speed", "%s", text) -- the text is an argument, never the format
end

-- The 30 s timer is looked at first, and here only: the questions about the session cost engine calls, and this runs
-- every frame.
local function actor_on_update()
	if st.next and time_global() < st.next then return end
	local ok, e = pcall(step)
	if not ok then pcall(core.report, "speed", "diagnostic", e) end
end

-- The 30 s count starts when the player is in the world, so the first line comes 30 s after it.
local function actor_on_first_update()
	pcall(function() st.next = time_global() + PERIOD_MS end)
end

function status()
	return string_format("lines %d | last: %s", st.lines, tostring(st.last))
end

function on_game_start()
	if not api then return end
	core.install("speed", "start", function()
		RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
		RegisterScriptCallback("actor_on_update", actor_on_update)
		core.status_line("speed", status)
	end)
end
