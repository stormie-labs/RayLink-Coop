; The bases whose bed is the checkpoint (see "base" at the top). One row per stock sleep zone
; of [coop_rest_zones] that stands in a real base: <sleep zone> = <radius of its ground in m>, <holder>[, <owner>...] (up to
; 6) or none. The FIRST owner is the holder, the faction whose guards hold the
; place; the others are the factions its smart terrain also admits. A base is hostile to a player when its holder is his
; enemy, or when every owner the game knows is (Rookie Village is hostile to a mercenary: its stalker guards shoot him,
; though csky and ecolog would not). An owner that is no community of the game is logged once and not counted; a first
; owner that is none of them leaves the row without a holder. "none" is never hostile; an owner is hostile to a player whose
; community (his own actor_<faction>, the column the guards judge an actor by) + standing with it is an enemy's (relation +
; goodwill <= -1000, the stock game_relations.ENEMIES). 14 rows: the 25 stock sleep zones less the five secret hideouts
; below, the five wilderness camps (ros_vagon_sleep, val_vagon_sleep, val_abandoned_house_sleep, ds_farmhouse_sleep,
; mil_smart_terran_2_4_sleep: no base, they stay rest places of [coop_rest_zones]) and agr_sr_sleep_tunnel (a
; second zone of the Agroprom stalker camp; it stays a rest place). The five secret hideouts (esc_secret_sleep,
; actor_surge_hide_2, pol_secret_sleep, pri_room27_sleep, rad_sleep_room) are no bases. Owners from the game's own data
; (configs\misc\simulation_objects_props.ltx: the factions of the camp's smart terrain; the holder by the squads its smart terrain spawns, configs\scripts\<level>\smart\<smart>.ltx) and the
; zone names. Two rows whose ground overlaps are one base: the engine reads
; the lines sorted by name, the row whose zone name comes first alphabetically stays (agr_army_sleep before
; agr_sr_sleep_wagon), and the log names the dropped one.
; Mod packs change rows or add bases with DLTX (![coop_bases]).
; gar_dolg_sleep (Garbage, the Duty post) lies on the ground of gar_angar_sleep: the engine would drop it with a warning on
; every start of the Garbage, so it is not listed; gar_angar_sleep is that base.
[coop_bases]
esc_basement_sleep_area     = 50, stalker, csky, ecolog   ; Cordon, Rookie Village (esc_smart_terrain_2_12: spawns stalker squads)
bar_actor_sleep_zone        = 50, dolg      ; Rostok, the Bar (every base smart of l05_bar has dolg; bar_dolg_*, bar_zastava* only dolg)
zat_a2_sr_sleep             = 50, stalker, csky, dolg     ; Zaton, Skadovsk (zat_stalker_base_smart: spawns stalker squads)
jup_a6_sr_sleep             = 50, stalker, freedom, ecolog   ; Jupiter, Yanov (jup_a6: stalker squads first, freedom, ecolog)
mar_a3_sr_sleep             = 50, csky      ; Great Swamps, Clear Sky base (mar_smart_terrain_base: csky 2, the others 1)
yan_bunker_sleep_restrictor = 50, ecolog, stalker, csky   ; Yantar, the scientists' bunker (yan_smart_terrain_6_4: spawns ecolog squads only, its guards are the scientists')
mil_freedom_sleep           = 50, freedom   ; Army Warehouses, Freedom base (its name; mil_smart_terrain_7_7: freedom 5 only)
gar_angar_sleep             = 50, dolg      ; Garbage, the hangar (gar_smart_terrain_5_2: spawns Duty squads only, stalker_sim_dolg_post, duty_sim_squad_*)
agr_army_sleep              = 50, army      ; Agroprom, the institute (its name; agr_smart_terrain_1_6 and its near_* smarts: army only)
agr_sr_sleep_wagon          = 50, stalker, csky, ecolog   ; Agroprom, the stalker camp (props: stalker 2; spawns: 4_4 duty + renegade, near_1 renegade, near_2/3 stalker + csky)
cit_merc_sleep              = 50, killer    ; Dead City, the mercenaries (its name; cit_killers: killer 5 only)
pri_a16_sr_sleep            = 50, stalker, bandit, csky, dolg, freedom   ; Pripyat, the stalkers' base (pri_a16: spawns stalker squads)
pri_monolith_sleep          = 50, monolith  ; Pripyat, Monolith (its name; smart pri_monolith)

; Real bases without a sleeping place, not every start location. Opt-in: only a start
; location of base_start_locations named here is a base: <start location id> = <holder>[, <owner>...] (up to 6) or none.
; Its owners come from this row (the faction that holds the place in the game), never from the factions whose new-game
; lists name it; as in [coop_bases] the first owner is the holder (every row below has the one owner that holds the
; place). Its point from its own section in base_start_locations. Rows are read sorted by id: of two start locations whose
; ground overlaps, the one whose id comes first alphabetically is the base. A row whose id has no section there is
; logged once and skipped; an owner that is no community is logged once and counted as none (never an assert). Some of them may fall on the ground of a zone base of [coop_bases]: those make no base of their own, and the log
; of the host (world server, map server) names them when a level is loaded ("start location(s) of [coop_start_bases] on
; the ground of another base of this level"). Mod packs change rows with DLTX (![coop_start_bases]).
[coop_start_bases]
northern_factory            = bandit
car_park                    = bandit
train_hangar                = bandit
truck_cemetery_bandits_post = bandit
pole_bandit_base            = bandit
tc_central_tower            = army
southern_checkpoint         = army
research_institute          = army
tuzla_outpost               = renegade
makeshift_barracks          = dolg
lodging_house               = dolg
military_base               = freedom
sports_center               = killer
construction_site           = killer
cultural_center             = monolith
brain_scorcher              = monolith
power_station               = monolith
l13_generators              = monolith
