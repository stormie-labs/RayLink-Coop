<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop: message window for refusals by the host (mod-list diff, duplicate player key) and other
     co-op notices. Used by scripts\coop_ui.script in the main menu and in game. Same layout for 4:3 and 16:9
     (stretched like ui_options). -->
<w>
	<coop_shade x="0" y="0" width="1024" height="768" stretch="1">
		<texture r="0" g="0" b="0" a="150">ui_icons_PDA_tooltips</texture>
	</coop_shade>

	<coop_msg x="112" y="74" width="800" height="620" stretch="1">
		<frame x="0" y="0" width="800" height="620" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</frame>

		<cap x="30" y="16" width="740" height="34" stretch="1">
			<text complex_mode="1" r="240" g="200" b="120" align="c" vert_align="c" font="graffiti22"/>
		</cap>

		<summary x="40" y="58" width="720" height="92" stretch="1">
			<text complex_mode="1" r="225" g="225" b="225" align="l" vert_align="t" font="letterica16"/>
		</summary>

		<list_frame x="30" y="156" width="740" height="380" stretch="1">
			<texture>ui_inGame2_servers_list_frame</texture>
		</list_frame>
		<scroll x="40" y="164" width="724" height="364" right_ident="0" left_ident="0" top_indent="0" bottom_indent="0" vert_interval="2" always_show_scroll="0" stretch="1"/>
		<row x="0" y="0" width="700" height="20" stretch="1">
			<text complex_mode="1" r="200" g="200" b="200" align="l" vert_align="t" font="letterica16"/>
		</row>

		<footer x="40" y="546" width="580" height="60" stretch="1">
			<text complex_mode="1" r="160" g="160" b="160" align="l" vert_align="c" font="letterica16"/>
		</footer>

		<btn_ok x="650" y="560" width="117" height="34" stretch="1">
			<text align="c" font="letterica18">OK</text>
			<texture>ui_button_ordinary</texture>
		</btn_ok>
	</coop_msg>
</w>
