<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop (core group): text chat window, chat feed on the HUD, party panel additions.
     Used by scripts\coop_core_chat.script and scripts\coop_core_hud.script. Chat: 1024x768 space, stretched.
     Party panel (W6): see its comment. Textures: stock Anomaly + coop_ally_* (configs\ui\textures_descr\ui_coop_allies.xml)
     + coop_icon_* (W8, configs\ui\textures_descr\ui_coop_icons.xml). -->
<w>
	<!-- Chat window: history + input line. Opened with the "chat" key action or Enter. -->
	<chat x="8" y="292" width="540" height="244" stretch="1">
		<frame x="0" y="0" width="540" height="244" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</frame>
		<!-- envelope before the title; the script narrows it on wide screens so it keeps its shape -->
		<icon x="14" y="8" width="24" height="16" stretch="1">
			<texture>coop_icon_mail_e</texture>
		</icon>
		<title x="44" y="6" width="480" height="20" stretch="1">
			<text complex_mode="0" r="240" g="200" b="120" align="l" vert_align="c" font="letterica16"/>
		</title>
		<history x="12" y="28" width="516" height="170" right_ident="0" left_ident="0" top_indent="0" bottom_indent="0" vert_interval="1" always_show_scroll="0" stretch="1"/>
		<row x="0" y="0" width="500" height="18" stretch="1">
			<text complex_mode="1" r="225" g="225" b="225" align="l" vert_align="t" font="letterica16"/>
		</row>
		<input x="12" y="202" width="516" height="24" max_symb_count="200" stretch="1">
			<text x="5" font="letterica16" vert_align="c" r="235" g="235" b="235"/>
			<texture>ui_inGame2_edit_box_1</texture>
		</input>
		<hint x="14" y="227" width="510" height="14" stretch="1">
			<text complex_mode="0" r="150" g="150" b="150" align="l" vert_align="c" font="letterica16"/>
		</hint>
	</chat>

	<!-- New chat lines on the HUD while the window is closed; lines are stacked from the bottom up, each on a plate,
	     the nick in the player's colour (W6 palette). -->
	<chat_feed x="10" y="330" width="560" height="190" stretch="1">
		<!-- dark plate under each line (the script sizes it to the text and fades it with the line) -->
		<plate x="0" y="0" width="560" height="20" stretch="1">
			<texture r="0" g="0" b="0" a="120">coop_ally_white</texture>
		</plate>
		<line x="0" y="0" width="560" height="18" stretch="1">
			<text complex_mode="1" r="225" g="225" b="225" align="l" vert_align="t" font="letterica16"/>
		</line>
	</chat_feed>

	<!-- Party panel (W6 allies UI, scripts\coop_core_hud.script): other players, top right, under the stock
	     hud_timer area. Coordinates of everything below are PIXELS AT 1080p, relative to the card / row; the
	     script scales them by max(1, screen height / 1080) and converts to the 1024x768 space, so a card is
	     90x67 px at 1080p (the stock companion slot) and 120x89 px at 1440p.
	     Up to 4 other players: portrait cards (the slot frame, portrait and health bar are the stock
	     companion_list:slot nodes of ui_hud.xml, so HUD restyles apply; party:* adds on top). 5..7 players:
	     compact rows (party_row:*). Colours of strips / nicks / stars come from [coop_player_colors]. -->
	<party>
		<!-- player colour tab on the card's left edge -->
		<strip x="0" y="0" width="3" height="67" stretch="1">
			<texture>coop_ally_white</texture>
		</strip>
		<!-- top-left plate over the portrait: distance, or the state ("NEEDS HELP 0:42", "DEAD") -->
		<info_bg x="5" y="4" width="40" height="13" stretch="1">
			<texture r="0" g="0" b="0" a="175">coop_ally_white</texture>
		</info_bg>
		<info x="7" y="4" width="76" height="13" stretch="1">
			<text complex_mode="0" r="215" g="215" b="215" align="l" vert_align="c" font="letterica16"/>
		</info>
		<!-- red medic badge in the middle of the portrait while the player is down (pulses) -->
		<badge x="30" y="15" width="30" height="30" stretch="1">
			<texture>coop_ally_badge_48</texture>
		</badge>
		<name_bg x="5" y="42" width="80" height="13" stretch="1">
			<texture r="0" g="0" b="0" a="175">coop_ally_white</texture>
		</name_bg>
		<name x="8" y="42" width="64" height="13" stretch="1">
			<text complex_mode="0" r="230" g="230" b="230" align="l" vert_align="c" font="letterica16"/>
		</name>
		<!-- session host -->
		<host x="72" y="42" width="13" height="13" stretch="1">
			<texture>coop_ally_star_32</texture>
		</host>
	</party>

	<party_row x="0" y="0" width="160" height="26">
		<bg x="0" y="0" width="160" height="26" stretch="1">
			<texture r="0" g="0" b="0" a="160">coop_ally_white</texture>
		</bg>
		<strip x="0" y="0" width="3" height="26" stretch="1">
			<texture>coop_ally_white</texture>
		</strip>
		<host x="6" y="2" width="12" height="12" stretch="1">
			<texture>coop_ally_star_32</texture>
		</host>
		<name x="8" y="1" width="82" height="14" stretch="1">
			<text complex_mode="0" r="230" g="230" b="230" align="l" vert_align="c" font="letterica16"/>
		</name>
		<badge x="94" y="1" width="14" height="14" stretch="1">
			<texture>coop_ally_badge_48</texture>
		</badge>
		<info x="90" y="1" width="66" height="14" stretch="1">
			<text complex_mode="0" r="200" g="200" b="200" align="r" vert_align="c" font="letterica16"/>
		</info>
		<health x="8" y="18" width="148" height="4" stretch="1" horz="1" min="0" max="1" pos="0">
			<background x="0" y="0" width="148" height="4" stretch="1">
				<texture r="62" g="74" b="74">ui_inGame2_companion_health_bar</texture>
			</background>
			<progress stretch="1">
				<texture>ui_inGame2_companion_health_bar</texture>
			</progress>
			<min_color r="255" g="50" b="50"/>
			<middle_color r="255" g="255" b="80"/>
			<max_color r="70" g="255" b="120"/>
		</health>
	</party_row>
</w>
