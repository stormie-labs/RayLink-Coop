<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop (core group): text chat window, chat feed on the HUD, the team panel (HUD v2, variant B).
     Used by scripts\coop_core_chat.script and scripts\coop_core_hud.script. Chat: 1024x768 space, stretched.
     Team panel (HUD v2): see its comment. Textures: stock Anomaly + coop_ally_* (configs\ui\textures_descr\ui_coop_allies.xml)
     + coop_icon_* (W8, configs\ui\textures_descr\ui_coop_icons.xml) + coop_hud_* (configs\ui\textures_descr\ui_coop_hud.xml). -->
<w>
	<!-- Chat window: history + input line. Opened with the "chat" key action or Enter. -->
	<chat x="8" y="292" width="540" height="244" stretch="1">
		<frame x="0" y="0" width="540" height="244" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</frame>
		<!-- envelope before the title; the script narrows it on wide screens so it keeps its shape -->
		<icon x="14" y="8" width="24" height="16" stretch="1">
			<texture>coop_icon_mail_e</texture>
		</icon>
		<title x="44" y="6" width="480" height="20" stretch="1">
			<text complex_mode="0" r="240" g="200" b="120" align="l" vert_align="c" font="letterica16"/>
		</title>
		<history x="12" y="28" width="516" height="170" right_ident="0" left_ident="0" top_indent="0" bottom_indent="0" vert_interval="1" always_show_scroll="0" stretch="1"/>
		<row x="0" y="0" width="500" height="18" stretch="1">
			<text complex_mode="1" r="225" g="225" b="225" align="l" vert_align="t" font="letterica16"/>
		</row>
		<input x="12" y="202" width="516" height="24" max_symb_count="200" stretch="1">
			<text x="5" font="letterica16" vert_align="c" r="235" g="235" b="235"/>
			<texture>ui_inGame2_edit_box_1</texture>
		</input>
		<hint x="14" y="227" width="510" height="14" stretch="1">
			<text complex_mode="0" r="150" g="150" b="150" align="l" vert_align="c" font="letterica16"/>
		</hint>
	</chat>

	<!-- New chat lines on the HUD while the window is closed; lines are stacked from the bottom up, each on a plate,
	     the nick in the player's colour (W6 palette). -->
	<chat_feed x="10" y="330" width="560" height="190" stretch="1">
		<!-- dark plate under each line (the script sizes it to the text and fades it with the line) -->
		<plate x="0" y="0" width="560" height="20" stretch="1">
			<texture r="0" g="0" b="0" a="120">coop_ally_white</texture>
		</plate>
		<line x="0" y="0" width="560" height="18" stretch="1">
			<text complex_mode="1" r="225" g="225" b="225" align="l" vert_align="t" font="letterica16"/>
		</line>
	</chat_feed>

	<!-- Team panel (HUD v2, variant B, docs\HUD_V2.md; scripts\coop_core_hud.script): one row per other player, bottom
	     left above the own HUD. These nodes give the textures and fonts; the script places and sizes everything from the
	     layout table (scripts\coop_hud_layout.script team_*, one line per value in [coop_hud_layout] of
	     configs\mod_system_coop.ltx) and sets colours and alphas (player colours: [coop_player_colors]).
	     bar: the colour strip and the health segments; label: nick, distance, timer (with their shadows; not
	     named `text`: InitStatic("team_row") would read it as the row's own font node and FATAL on pTmpFont); icon: host
	     star and the state icon; arrow and arc turn (heading="1": the box stays square, the engine applies the aspect).
	     Textures: configs\ui\textures_descr\ui_coop_hud.xml (tools\make_hud_atlas.py). -->
	<team_row x="0" y="0" width="1" height="1">
		<bar x="0" y="0" width="30" height="5" stretch="1">
			<texture>coop_hud_white</texture>
		</bar>
		<label x="0" y="0" width="100" height="14">
			<text complex_mode="0" r="244" g="245" b="246" align="l" vert_align="c" font="letterica16"/>
		</label>
		<icon x="0" y="0" width="12" height="12" stretch="1">
			<texture>coop_hud_dot</texture>
		</icon>
		<arrow x="0" y="0" width="10" height="10" stretch="1" heading="1">
			<texture>coop_hud_arrow</texture>
		</arrow>
		<arc x="0" y="0" width="12" height="12" stretch="1" heading="1">
			<texture>coop_hud_arc8</texture>
		</arc>
	</team_row>
</w>
