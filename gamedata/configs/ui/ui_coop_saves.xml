<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop: "Restore an autosave" window of the host (scripts\coop_saves.script, opened by the Restore button of the
     Co-op window). Same frame and shade as ui_coop_menu.xml. Captions are string ids (configs\text\*\st_coop_saves.xml);
     the rows and the confirmation text are filled by the script. -->
<w>
	<restore_shade x="0" y="0" width="1024" height="768" stretch="1">
		<texture r="0" g="0" b="0" a="160">ui_icons_PDA_tooltips</texture>
	</restore_shade>

	<restore x="152" y="64" width="720" height="640" stretch="1">
		<frame x="0" y="0" width="720" height="640" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</frame>

		<cap x="30" y="14" width="660" height="34" stretch="1">
			<text complex_mode="0" r="240" g="200" b="120" align="c" vert_align="c" font="graffiti22">st_coop_saves_restore_title</text>
		</cap>
		<info x="30" y="50" width="660" height="62" stretch="1">
			<text complex_mode="1" r="190" g="190" b="190" align="l" vert_align="t" font="letterica16">st_coop_saves_restore_info</text>
		</info>

		<list_frame x="30" y="114" width="660" height="340" stretch="1">
			<texture>ui_inGame2_servers_list_frame</texture>
		</list_frame>
		<empty x="50" y="128" width="620" height="90" stretch="1">
			<text complex_mode="1" r="220" g="170" b="110" align="l" vert_align="t" font="letterica16">st_coop_saves_restore_none</text>
		</empty>
		<!-- one row per autosave (10 at most), placed by the script under each other (step 32) -->
		<btn_row x="46" y="124" width="628" height="28" stretch="1">
			<text align="l" vert_align="c" font="letterica16" x="8"></text>
			<texture>ui_button_ordinary</texture>
		</btn_row>

		<confirm x="30" y="464" width="660" height="92" stretch="1">
			<text complex_mode="1" r="240" g="200" b="120" align="l" vert_align="t" font="letterica16"></text>
		</confirm>

		<btn_confirm x="30" y="594" width="300" height="32" stretch="1">
			<text align="c" vert_align="c" font="letterica18">st_coop_saves_restore_btn_confirm</text>
			<texture>ui_button_ordinary</texture>
		</btn_confirm>
		<btn_back x="390" y="594" width="300" height="32" stretch="1">
			<text align="c" vert_align="c" font="letterica18">st_coop_saves_restore_btn_back</text>
			<texture>ui_button_ordinary</texture>
		</btn_back>
	</restore>
</w>
