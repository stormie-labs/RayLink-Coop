<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop: how many to give (scripts\coop_economy_give.script, owner 2026-11-07). "Give to <player>" on an item of
     more than one unit (rounds of ammo, a stack of items) opens it: the item's icon and name, the receiver, a slider with
     the number "N / max" and one button. Esc or a click outside closes it without giving. Same frame, caption colour and
     fonts as ui_coop_rest.xml. The icon is fitted into icon_box by the script; the texts are filled by the script. -->
<w>
	<coop_give x="322" y="279" width="380" height="210" stretch="1">
		<frame x="0" y="0" width="380" height="210" stretch="1">
			<texture>ui_inGame2_hint_wnd_main_window</texture>
		</frame>

		<icon_box x="20" y="20" width="100" height="72" stretch="1"/>
		<icon x="20" y="20" width="100" height="72" stretch="1"/>

		<name x="132" y="18" width="228" height="48" stretch="1">
			<text complex_mode="1" r="240" g="200" b="120" align="l" vert_align="c" font="letterica18"></text>
		</name>
		<whom x="132" y="68" width="228" height="22" stretch="1">
			<text complex_mode="0" r="190" g="190" b="190" align="l" vert_align="c" font="letterica16"></text>
		</whom>

		<track x="20" y="116" width="250" height="16" stretch="1" step="1.0"/>
		<num x="276" y="108" width="84" height="30" stretch="1">
			<text complex_mode="0" r="220" g="220" b="220" align="c" vert_align="c" font="letterica18"></text>
		</num>

		<btn_give x="100" y="160" width="180" height="32" stretch="1">
			<text align="c" vert_align="c" font="letterica18">st_coop_eco_give_btn</text>
			<texture>ui_button_ordinary</texture>
		</btn_give>
	</coop_give>
</w>
