<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop HUD v2 (docs\HUD_V2.md): the compass bar (scripts\coop_hud_compass.script) and the world ring of a ping
     (scripts\coop_hud_ping.script). This file gives the textures and fonts. The scripts place and size everything from
     the layout table (scripts\coop_hud_layout.script, one line per value in [coop_hud_layout] of configs\mod_system_coop.ltx:
     38 % of the screen width, 20 down, 24 high, ...; px at 768 high, never stretched) and set colours and alphas: the
     scale is white #F4F5F6 (line, ticks, letters with a 1 px shadow, notch, heading), only the markers carry colours.
     ui_coop_compass_16.xml (wide screens) has the same nodes. Textures: configs\ui\textures_descr\ui_coop_hud.xml
     (tools\make_hud_atlas.py): white glyphs with a dark 1 px outline, tinted by the scripts. -->
<w>
	<coop_compass x="0" y="0" width="1024" height="768">
		<!-- background, fading out on the last 16 % of the width at each end (baked into the texture) -->
		<bg x="0" y="0" width="389" height="24" stretch="1">
			<texture>coop_hud_bar_bg</texture>
		</bg>
		<!-- the white line through the bar, the same fade -->
		<line x="0" y="0" width="389" height="1" stretch="1">
			<texture>coop_hud_bar_line</texture>
		</line>
		<tick x="0" y="0" width="1" height="3" stretch="1">
			<texture>coop_hud_white</texture>
		</tick>
		<letter x="0" y="0" width="40" height="16">
			<text complex_mode="0" r="244" g="245" b="246" align="c" vert_align="c" font="letterica16"/>
		</letter>
		<notch x="0" y="0" width="8" height="6" stretch="1">
			<texture>coop_hud_notch</texture>
		</notch>
		<heading x="0" y="0" width="60" height="14">
			<text complex_mode="0" r="244" g="245" b="246" align="c" vert_align="c" font="letterica16"/>
		</heading>
		<icon x="0" y="0" width="12" height="12" stretch="1">
			<texture>coop_hud_dot</texture>
		</icon>
		<core x="0" y="0" width="6" height="6" stretch="1">
			<texture>coop_hud_dot</texture>
		</core>
		<side x="0" y="0" width="8" height="8" stretch="1">
			<texture>coop_hud_tri_right</texture>
		</side>
		<updown x="0" y="0" width="6" height="6" stretch="1">
			<texture>coop_hud_tri_up</texture>
		</updown>
		<label x="0" y="0" width="120" height="14">
			<text complex_mode="0" r="244" g="245" b="246" align="l" vert_align="c" font="letterica16"/>
		</label>
	</coop_compass>

	<!-- a ping over its point in the world: ring in the author's colour, cyan dot, distance -->
	<coop_ping x="0" y="0" width="1024" height="768">
		<ring x="0" y="0" width="16" height="16" stretch="1">
			<texture>coop_hud_ring</texture>
		</ring>
		<dot x="0" y="0" width="6" height="6" stretch="1">
			<texture>coop_hud_dot</texture>
		</dot>
		<label x="0" y="0" width="80" height="14">
			<text complex_mode="0" r="244" g="245" b="246" align="c" vert_align="c" font="letterica16"/>
		</label>
	</coop_ping>
</w>
