<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop: the "Game settings" block of the new game screen of a host (scripts\coop_newgame_modes.script,
     scripts\coop_game_settings_view.script). Added to the stock ui_mm_faction_select.xml layout (same main_dialog:options frame,
     880 x 160, parsed by a second CScriptXmlInit like GAMMA's soulslike_ui_mm_gamemode.xml) in the place of the second column of
     the stock modes, which a co-op host does not see (x from 331). From the top: the header (0..20), the strip of five tab
     buttons in the look of the stock new game buttons (21..42) with the bar gs_tab_mark that the script moves under the open
     tab, the scroll view of the open tab (44..142: 4 rows of 24 and a bit), the one-line hint (143..160), all inside the
     visible 160 of the frame's scroll view.
     gs_row and gs_line are the containers of a row (caption + combo box) and of a line of text in the scroll view; the nodes
     inside them are relative to the container. A row is 16 narrower than the scroll view (room for its scroll bar). A combo
     box is 20 high whatever its node says (CUIComboBox CB_HEIGHT); list_length is how many entries its drop-down shows.
     Widths of the columns follow the texts: measured with the glyph widths of GAMMA's fonts (tests/lua/test_newgame_modes.lua,
     tests/lua/support/font_letterica.lua), the widest ordinary caption takes 250 of the 288 (the three of the dynamic anomalies addon carry its name and
     are longer), the widest value 180 of the 206 left of the arrow. -->
<w>
	<main_dialog>
		<options>
			<cap_gs_header x="331" y="0" width="355" height="20" stretch="1">
				<text r="250" g="250" b="250" font="letterica18" align="l" vert_align="c">st_coop_newgame_header</text>
			</cap_gs_header>

			<btn_gs_tab_1 x="331" y="21" width="100" height="21" stretch="1">
				<text r="150" g="150" b="150" font="letterica16" align="c" vert_align="c"></text>
				<texture>ui_inGame2_button</texture>
			</btn_gs_tab_1>
			<btn_gs_tab_2 x="434" y="21" width="100" height="21" stretch="1">
				<text r="150" g="150" b="150" font="letterica16" align="c" vert_align="c"></text>
				<texture>ui_inGame2_button</texture>
			</btn_gs_tab_2>
			<btn_gs_tab_3 x="537" y="21" width="76" height="21" stretch="1">
				<text r="150" g="150" b="150" font="letterica16" align="c" vert_align="c"></text>
				<texture>ui_inGame2_button</texture>
			</btn_gs_tab_3>
			<btn_gs_tab_4 x="616" y="21" width="124" height="21" stretch="1">
				<text r="150" g="150" b="150" font="letterica16" align="c" vert_align="c"></text>
				<texture>ui_inGame2_button</texture>
			</btn_gs_tab_4>
			<btn_gs_tab_5 x="743" y="21" width="100" height="21" stretch="1">
				<text r="150" g="150" b="150" font="letterica16" align="c" vert_align="c"></text>
				<texture>ui_inGame2_button</texture>
			</btn_gs_tab_5>

			<gs_tab_mark x="331" y="40" width="100" height="2" stretch="1">
				<texture r="225" g="225" b="225" a="255">coop_menu_white</texture>
			</gs_tab_mark>

			<scroll_gs x="331" y="44" width="549" height="98" right_ident="0" left_ident="0" top_indent="0" bottom_indent="0" vert_interval="0" always_show_scroll="0"/>

			<gs_row x="0" y="0" width="526" height="24"/>
			<cap_gs_row x="2" y="2" width="288" height="20" stretch="1">
				<text r="170" g="170" b="170" font="letterica16" align="l" vert_align="c"></text>
			</cap_gs_row>
			<list_gs_row x="294" y="2" width="232" height="20" list_length="6">
				<list_font r="190" g="190" b="190" font="letterica16"/>
				<text_color>
					<e r="170" g="170" b="170"/>
					<d r="70" g="70" b="70"/>
				</text_color>
			</list_gs_row>

			<gs_line x="0" y="0" width="526" height="24"/>
			<text_gs_line x="2" y="0" width="520" height="20">
				<text complex_mode="1" r="170" g="170" b="170" align="l" vert_align="t" font="letterica16"/>
			</text_gs_line>

			<text_gs_hint x="331" y="143" width="540" height="17">
				<text complex_mode="1" r="150" g="150" b="150" align="l" vert_align="c" font="letterica16"/>
			</text_gs_hint>
		</options>
	</main_dialog>
</w>
