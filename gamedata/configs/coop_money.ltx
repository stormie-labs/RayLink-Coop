; Anomaly Coop - player money on the host (F2 T1, review R4 7), read by the engine (coop_money.cpp) once per game start.
;
; Every player's balance lives on the host: the money of his character in the host's save. A client sends changes
; of its money with a cause, never an amount; the host checks each one and answers with the balance it holds.
;   - spending is allowed while the balance covers it;
;   - money a client gains by itself comes out of two allowances of his character, kept for the whole session
;     (leaving and joining again, or talking to another NPC, refills nothing):
;       dialog - a dialog payout while the player talks to an NPC: dialog_gain_cap in a row, dialog_gain_per_min a minute;
;       script - anything else (a mod's give_money) and the rest of a payout: script_gain_burst in a row,
;                script_gain_per_min a minute;
;   - trades, transfers between players and host scripts (coop.money_grant / money_set) change balances on the host.
; A refused gain is taken back on the client by the host's answer; refusals are counted in coop_status.
; These are host settings: the host's values decide. The console changes them for the running game:
;   coop_money_gain_burst, coop_money_gain_per_min, coop_money_dialog_cap, coop_money_dialog_per_min, coop_money_max.

[coop_money]
script_gain_burst       = 50000     ; RU a client may gain without the host in a row
script_gain_per_min     = 10000     ; and then per minute
dialog_gain_cap         = 100000    ; RU dialogs may pay in a row (one big quest reward)
; and then per minute: several ordinary rewards (1 000 - 15 000 RU) a minute; farming talk locks gains no more
; than 1.2 M RU an hour on top of the cap
dialog_gain_per_min     = 20000
max_money               = 100000000 ; no balance goes above this
; Upgrades at a mechanic (F2 T5): the host accepts a client's upgrade only if it was bought from a mechanic the player
; talks to, within 6 m of his character on the host, paid at least floor(cost x upgrade_min_percent) (the upgrade's
; `cost` in item_upgrades.ltx), and his balance on the host covers what he paid; then the host charges it.
; 2.21 = 1.7 (the lowest stock mech_discount) x 1.3 (the lowest `upgrade` factor of plugins\difficulty.ltx).
; Mod packs that discount upgrades further need a lower value: G.A.M.M.A. (upgrade_rank_pricing.script) multiplies the
; price by wpn_upgr_mult 0.5, a tier discount 0.5 / 1.1 / 1.5 and 0.3 for novice outfits (MCM defaults; each slider
; goes down to 0.1): its cheapest default price is about 0.17 x cost.
upgrade_min_percent     = 2.21
; An upgrade that names no mechanic (a script installed it on the client, e.g. the workshop's upgrade with your own
; tools) is refused unless this is true. coop_status counts them: "upgrades without a mechanic".
scripted_upgrades       = false
