; Anomaly Coop - settings of the coop_npc_* scripts (scripts\coop_npc_players.script setting()). Moved out of
; coop_domains_npc.ltx (F2 T10). Every value has a default in code.

[coop_npc]
scene_radius               = 30     ; m: a story scene (arrival that disables the UI or teleports) also takes
                                    ; the players this close to those who walked in; 0 = the whole level
sound_radius               = 80     ; m: NPC voices started by Lua reach a client this close to the NPC
pad_reach                  = 6      ; m: a code typed on a code pad counts from this close to it
