[route_scripts]
; iTheon's PDA taskboard (lizzardman's version): its tab is opened through z_taskboard_overrides (on_game_load); a
; client's board rows come from the host's offers (coop_quests_offer), so the board's own fake conversations do not
; run on a client
pda_taskboard                    = view
pda_taskboard_mcm                = view
z_taskboard_overrides            = view
; Dynamic Anomalies Overhaul: its anomaly lifecycle spawns / releases world objects. The flash mine's per-player part
; runs on clients through coop_quests_story (the time jump is the host's).
drx_da_main                      = host
drx_da_main_artefacts            = host
drx_da_main_artefacts_movement   = host
