; Anomaly Coop - who owns which option in a co-op session (R-11.3), read by scripts\coop_settings.script.
;
;   host   - gameplay: difficulty, economy, A-Life, rules. The host's value is used on every client; a client
;            cannot change it while connected (its own axr_options.ltx is not touched and is used again later).
;   player - cosmetic: graphics, sound, HUD, controls, language. Every player keeps their own.
;
; Two option stores are covered, both in appdata\axr_options.ltx:
;   options - Anomaly's own options menu (ui_options), paths like "gameplay/economy_diff/buy".
;   mcm     - Mod Configuration Menu of addons (ui_mcm), paths like "<addon>/<page>/<option>".
; Difficulty and economy factors (game_difficulties, stored in the save) are always host-owned.
;
; How a path is decided (first match wins):
;   1. exact path in [<store>_host] / [<store>_player]
;   2. longest prefix ("gameplay/*") in the same sections; for equal prefixes host wins
;   3. words of the path (split at "/", "_", digits and other separators):
;        a word from [words_always_player] -> player   (key bindings, mouse, language, debug)
;        a word from [words_host]          -> host     (damage, loot, price, spawn, ...)
;        a word from [words_player]        -> player   (hud, sound, color, ...)
;      Words of 3 letters or less must match a whole word; longer ones match the start of a word
;      ("anomal" matches "anomaly", "anomalies").
;   4. [settings] <store>_default
; Unknown MCM options are host-owned: an addon nobody classified cannot give players different rules.
; To let players set an addon themselves, add "<addon>/*" to [mcm_player].
;
; The host's game (docs\GAME_SETTINGS.md, Ruling GS-1): what a path is decided by steps 1 and 2 above - named by an exact path
; or a prefix in [options_host] / [mcm_host] - the game owns: its value is kept in the record of the game, and the options
; window and the MCM window lock it for the host in a level. What only steps 3 and 4 make the host's (a word of the path, the
; default) stays the machine's on the host, so that the cosmetic options of the mods are not lost; a client gets them all.
; To make an addon part of a game, list it in [mcm_host]; to keep it out of both, list it in [mcm_player].

[settings]
options_default     = host
mcm_default         = host
poll_ms             = 3000    ; host: how often host-owned values are compared and changes sent
request_ms          = 10000   ; client: asks again for the host's settings until they arrive
chunk_bytes         = 12000   ; payload size of one settings message (the engine limit is 16 KiB)

[options_host]
gameplay/*
alife/*
video/weather/*               ; weather generation is world state
coop/coop_session/*           ; co-op page: session rules (friendly fire, death mode, ...)

[options_player]
video/*
sound/*
control/*
other/*
gameplay/general/player_name
gameplay/general/outfit_portrait
gameplay/general/show_tip_reputation
alife/dynamic_news/message_duration
coop/coop_player/*            ; co-op page: nickname, hosting port, name tags

[mcm_host]
; <addon>/* or exact paths that must follow the host even if their words look cosmetic
; Known addons whose options shape the shared world (seed list from xrRazom's MCM authority):
drx_da/*                      ; Dynamic Anomalies Overhaul: density, cleanup, spawn chance
body_health_system/*          ; limb injury thresholds and penalties
craft_from_stashes/*
customsquadsize/*             ; companion cap, squads are the host's
dit/*                         ; tool wear on disassembly
dph_loot_cond/*               ; corpse loot condition
outfitdrop/*                  ; corpse outfit drop chances
fftd/*                        ; fast travel cost and gating
extra_level_transitions/*
milpda/progressive/*          ; PDA access progression
new_tasks_addon/*
pda_taskboard/*
perk_based_artefacts/*
item_artefact/*
exo/*                         ; exoskeleton drain, battery drops
meat_spoiling/*
smooth_prog/*                 ; upgrade and repair prices
skill_system/*
yasc/*                        ; where saving is allowed
auto_looter/delete_body       ; releasing corpses and items is world state
auto_looter/delete_armor
auto_looter/delete_weapon
auto_looter/delete_misc
SMR/*                         ; Zone Customization Project: spawns, mutants, stalkers, zombies, loot, anomalies (the world's)

[mcm_player]
; <addon>/* or exact paths every player sets for themselves, e.g.:
; my_hud_addon/*
; Per-machine keys of the addons above (logging, UI, commands that wear a checkbox, key modifiers):
drx_da/debug_mode
drx_da/save_after_cleanup
drx_da/delete_dynamic_anomalies
body_health_system/text_based_patch
body_health_system/new_voice_sounds
dit/consume_warning
outfitdrop/debug
fftd/gen/squad_tp_mod
fftd/gen/show_zone_status_icon
fftd/gen/nice_round_numbers
fftd/gen/show_distdur
fftd/gen/debuglogs_enabled
fftd/gen/verbose_enabled
extra_level_transitions/delete_level_transitions
perk_based_artefacts/debug_mode
item_artefact/enable_condition_bar
exo/debug
skill_system/modifier
skill_system/debug
yasc/enablenotifications
auto_looter/*                 ; what a looter picks up or strips stays each player's own
SMR/smr_loot/send_message     ; Zone Customization Project: the bonus-loot message is each player's (W4 mods, W5)
SMR/smr_amain/smr_debug_log   ; ... the rest of SMR/* is the host's (the longer path wins over the prefix)
SMR/smr_amain/glitched_pda    ; ... a PDA effect, the player's own
