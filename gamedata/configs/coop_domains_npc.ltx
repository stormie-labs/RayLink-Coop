; Anomaly Coop - Lua execution domains of the NPC group (W4 "npc"), read by scripts\coop_main.script after
; coop_domains.ltx (same sections and rules, see that file). The coop_npc_* scripts are view-domain through
; the coop_* prefix of the main file and decide host/client themselves.

; Init callbacks of NPC mods that run on clients too (merged with [callbacks_always] of coop_domains.ltx).
[callbacks_always]
idiots_on_start            ; Useful Idiots (illish\patches\*.lua): z_idiots_patches.on_game_start sends it on every
                           ; machine; the listeners read their config and register their handlers, which keep their
                           ; own file's domain. The files are named like stock scripts (xr_combat_ignore, xr_danger,
                           ; surge_manager ...), host-only, so without this line a client never filled
                           ; xr_combat_ignore's config and the engine's is_enemy call was FATAL there (2026-10-23)

[owner]
gameplay_disguise          ; the player's half of the disguise (outfit -> community, HUD bar, sudden actions)
                           ; runs on the player's machine; the NPC half is judged by the host
                           ; (coop_npc_disguise). Its npc_on_update never fires for client puppets.
bind_campfire              ; matches on a campfire and the campfire hints are the player's; lighting goes to
                           ; the host (coop_npc_world), the flame comes back through coop_objects

; Settings of the coop_npc_* scripts (not a domain section; coop_main ignores it).
[coop_npc]
scene_radius               = 30     ; m: a story scene (arrival that disables the UI or teleports) also takes
                                    ; the players this close to those who walked in; 0 = the whole level
sound_radius               = 80     ; m: NPC voices started by Lua reach a client this close to the NPC
