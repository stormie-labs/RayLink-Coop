<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop - the "Game settings" block of the new game screen (scripts/coop_newgame_modes.script, scripts/coop_game_settings_view.script, layout configs/ui/ui_coop_newgame.xml): the header, the hint, the short labels of the tabs, the text of the "Other" tab, the note of the "Saves" tab, the units of a value added from the machine. The names of the settings and their values are st_coop_game_* (st_coop_game.xml). Ids st_coop_newgame_<name>. -->
<string_table>
	<string id="st_coop_newgame_header">
		<text>Game settings</text>
	</string>
	<string id="st_coop_newgame_hint">
		<text>Settings of this game. Change later: Co-op > Game settings</text>
	</string>
	<string id="st_coop_newgame_tab_death">
		<text>Death</text>
	</string>
	<string id="st_coop_newgame_tab_party">
		<text>Party</text>
	</string>
	<string id="st_coop_newgame_tab_world">
		<text>World</text>
	</string>
	<string id="st_coop_newgame_tab_difficulty">
		<text>Difficulty</text>
	</string>
	<string id="st_coop_newgame_tab_saves">
		<text>Saves</text>
	</string>
	<string id="st_coop_newgame_tab_other">
		<text>Other</text>
	</string>
	<string id="st_coop_newgame_other">
		<text>Other game options: %s, mod settings (MCM): %s. Taken from this machine on %s and kept with the game. Change them in the main menu (Options, Mod settings) before the start.</text>
	</string>
	<string id="st_coop_newgame_saves_note">
		<text>Nothing is saved by hand in a session. Roll back: Co-op > Restore an autosave.</text>
	</string>
	<string id="st_coop_newgame_min">
		<text>min</text>
	</string>
	<string id="st_coop_newgame_unit_s">
		<text>s</text>
	</string>
	<string id="st_coop_newgame_unit_m">
		<text>m</text>
	</string>
	<string id="st_coop_newgame_unit_h">
		<text>h</text>
	</string>
</string_table>
