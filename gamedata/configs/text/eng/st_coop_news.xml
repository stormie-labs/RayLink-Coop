<?xml version="1.0" encoding="windows-1251"?>
<!-- Anomaly Coop - messages to the player's PDA feed about the group's shared journal (scripts/coop_tasks.script, coop_quests_news.script, coop_quests_pda.script): a task another player took / finished, an encyclopedia article another player opened. %s is filled by the script, the first one is a player's nick. -->
<string_table>
	<string id="st_coop_news_task_new_by">
		<text>%s took a task</text>
	</string>
	<string id="st_coop_news_task_complete_by">
		<text>%s completed a task</text>
	</string>
	<string id="st_coop_news_task_fail_by">
		<text>%s failed a task</text>
	</string>
	<string id="st_coop_news_task_cancel_by">
		<text>%s cancelled a task</text>
	</string>
	<string id="st_coop_news_article_caption">
		<text>Encyclopedia</text>
	</string>
	<string id="st_coop_news_article_by">
		<text>New article: %s (opened by %s)</text>
	</string>
	<string id="st_coop_news_articles_many">
		<text>New articles: %s (opened by the group)</text>
	</string>
	<string id="st_coop_news_away">
		<text>Rewards while you were away</text>
	</string>
	<string id="st_coop_news_away_tasks">
		<text>Tasks done by the group: %d.</text>
	</string>
	<string id="st_coop_news_away_money">
		<text>Money: +%d RU.</text>
	</string>
	<string id="st_coop_news_away_items">
		<text>Items: %s.</text>
	</string>
	<string id="st_coop_news_away_item">
		<text>%s x%d</text>
	</string>
	<string id="st_coop_news_away_more">
		<text>And %d more items.</text>
	</string>
	<string id="st_coop_news_task_lang_caption">
		<text>Tasks</text>
	</string>
	<string id="st_coop_news_task_lang">
		<text>The host plays in another language: task texts come in his.</text>
	</string>
	<!-- Foreign loot (coop_loot_claim.script): the warning of a stalker who guards the body he killed, and the empty search; used when the strings of the GAMMA mod NPC Loot Claim are not installed. -->
	<string id="st_coop_news_loot_last_1">
		<text>Step away from that body. I killed him, it's mine.</text>
	</string>
	<string id="st_coop_news_loot_last_2">
		<text>I won't say it twice: leave my kill alone.</text>
	</string>
	<string id="st_coop_news_loot_last_3">
		<text>Touch his stuff and you will regret it.</text>
	</string>
	<string id="st_coop_news_loot_last_4">
		<text>Back off, stranger. I got him first.</text>
	</string>
	<string id="st_coop_news_loot_last_5">
		<text>Hands off, or I open fire.</text>
	</string>
	<string id="st_coop_news_loot_far">
		<text>You found nothing useful on this body.</text>
	</string>
	<!-- Foreign loot, the deal over a body (coop_loot_claim.script): a friend lets the player take it, a neutral killer names a price (%d RU, %d seconds), takes the payment, or says the money is not enough. -->
	<string id="st_coop_news_loot_friend_1">
		<text>Take it, friend. I don't mind.</text>
	</string>
	<string id="st_coop_news_loot_friend_2">
		<text>It's yours. We are on the same side.</text>
	</string>
	<string id="st_coop_news_loot_friend_3">
		<text>Go ahead, help yourself.</text>
	</string>
	<string id="st_coop_news_loot_price">
		<text>My kill. Pay me %d RU and take it: press USE again within %d seconds.</text>
	</string>
	<string id="st_coop_news_loot_paid">
		<text>Pleasure doing business. Take what you need.</text>
	</string>
	<string id="st_coop_news_loot_poor">
		<text>You don't have %d RU. Come back with the money.</text>
	</string>
	<string id="st_coop_quests_npc_limit">
		<text>This NPC has given the group all the tasks it can. Turn one of them in.</text>
	</string>
	<string id="st_coop_news_task_not_given">
		<text>The task was not given: the host ran into an error while starting it. Try taking it again.</text>
	</string>
</string_table>
