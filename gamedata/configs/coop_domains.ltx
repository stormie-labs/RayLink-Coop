; Anomaly Coop - Lua execution domains (DESIGN D6), read by scripts\coop_main.script.
;
; On a co-op CLIENT every function that is registered through RegisterScriptCallback, AddUniqueCall
; or CreateTimeEvent is classified by the script FILE that defines it (debug.getinfo source):
;   host    - world logic: quests, simulation, squads, emission, death loot, stashes, news generation.
;             Runs only on the host; on a client the call is skipped.
;   owner   - the local actor: its needs, item use, own effects. Runs on the machine that owns the actor.
;   view    - UI, HUD, sound, visuals, data helpers. Runs everywhere.
;   blocked - debug and cheat tools. Never runs on a client (R-6.6), runs on the host.
; On a client owner/view calls are wrapped in pcall: a Lua error is logged and counted, the session
; continues (R-11.4). On the host nothing is wrapped.
;
; Unknown scripts get [settings] default (host = fail closed: an unpatched addon cannot change the world
; from a client, R-11.1). Add an addon's script here to let it run on clients.
; Entries are script names without ".script", lowercase. A trailing * matches a prefix; the exact name wins
; over a prefix, a longer prefix over a shorter one. If a name is listed twice, the later section wins in
; the order view, owner, host, blocked.

[settings]
default                    = host     ; scripts not listed below
c_functions                = view     ; engine C functions registered as callbacks
protect_client_callbacks   = true     ; pcall owner/view callbacks on clients (R-11.4)
disable_dev_debug          = true     ; force DEV_DEBUG/DEV_DEBUG_DEV off on clients (debug spawner, R-6.6)

; Callback names that run on clients whatever the script's domain: they only read data or adapt the UI.
[callbacks_always]
load_state
on_pstor_load_all
on_xml_read
on_localization_change
on_screen_resolution_changed

; Callback names that never run on clients, even for owner/view scripts (ALife/simulation driven, saving).
