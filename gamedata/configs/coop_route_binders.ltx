; Anomaly Coop - object binders on a co-op CLIENT (F2 T11, docs\MOD_LAYER.md 2.2). Replaces coop_domains_binders.ltx (W10).
;
; Not callbacks: a binder is a Lua class derived from object_binder, and the ENGINE calls its methods by name (update on
; every shedule tick, net_spawn, save ...). Two halves read this file:
;   engine  [binder_host]                                    keyed by the object's script_binding, `script.function`
;                                                            (configs: script_binding = bind_camp.bind); a client does not
;                                                            call the method (CScriptBinder, xrGame\script_binder.cpp);
;                                                            read with the other coop_route*.ltx and coop_compat_*.ltx files
;   Lua     [binder_lua_skip] [binder_lua_fix] [binder_lua_guard]   keyed by `script.class` (class "camp_binder"
;                                                            (object_binder)); methods that must not run, need a fix, or
;                                                            must survive a Lua error on a client
;                                                            (scripts\coop_client_binders.script)
;
; Ruling F2-35: the engine decides Run or HostOnly and nothing else. A Lua error is FATAL in the Release engine (no C++
; exceptions: luabind's pcall handler ends in Debug.fatal), and the only thing that keeps a client alive is a Lua pcall
; around the method, so every "keep running, log the error" rule is a [binder_lua_guard] line. (The first T11 version
; swapped luabind's global callbacks around the call from C++; the review found it unsafe: a structured exception skipped the
; restore and it swallowed the errors of every nested engine-to-Lua call.)
;
; Everything here applies on a co-op CLIENT only. The host and single player run the stock code. A binding or class of a
; mod that is not installed matches nothing (coop_status lists the Lua ones). A mod adds its own lines to
; configs\coop_compat_<mod>.ltx ([binder_host], read last) or to a DLTX patch of this file (Lua sections).
;
; Engine methods (names are the Lua names of the binder's methods): reinit, reload, net_spawn, net_destroy, update, save,
; load, net_save_relevant. A method the engine skips answers what the binder object does without Lua: net_spawn true,
; net_save_relevant false, the rest nothing.

[binder_host]
; The method is the host's: a client does not call it, the C++ default stands (for update that is object_binder.update,
; which does nothing). Use it for world logic: alife():create, SIMBOARD, se_*:update, spawns, story state.
bind_faction.bind                 = update   ; se_faction:update (server object)
bind_camp.bind                    = update   ; CCampManager:update: camp states, stories, NPC voices; the NPCs are puppets
bind_heli.bind                    = update   ; helicopter logic, heli_alife, health/die on server objects; the pose comes from the host

[binder_lua_skip]
; script.class = method, method
; Methods other Lua code calls: they return at once on a client (the host spawns and releases, the client mirrors).
; anomaly_zone_binder: alife_create_item answers nil on a client and the stock code indexes it (10% of fresh zones at
; net_spawn); turn_off releases the zone's artefacts. ph_item_box: box loot, called from generic_physics_binder:death_callback.
bind_anomaly_zone.anomaly_zone_binder = spawn_artefact_randomly, turn_off
xr_box.ph_item_box                    = spawn_items

[binder_lua_fix]
; script.class = method
; A preparation built into coop_client_binders.script runs first on a client, then the stock method. Known fixes:
; bind_crow.crow_binder = update   a dead crow is released by the host, not retried on every update (body_timer = 0)
bind_crow.crow_binder                 = update

[binder_lua_guard]
; script.class = method, method
; The method runs in pcall on a client: a Lua error is logged (the first three per method, then every 100th), counted in
; coop_status and the binder stays, where the Release engine would end the game. The first 15 lines are the binders that keep
; running on a client (the update of each; the creature binders' update is suspended for puppets by the engine, their
; callbacks are the last two lines). A line is applied after [binder_lua_fix], so the crow's fix runs inside its guard.
bind_stalker.actor_binder                 = update   ; actor_binder
bind_restrictor.restrictor_binder         = update
bind_physic_object.generic_physics_binder = update
bind_car.car_binder                       = update
bind_container.container_binder           = update
bind_crow.crow_binder                     = update   ; after the fix above
bind_door_labx8.door_binder_labx8         = update
bind_red_forest_bridge.bridge_binder      = update
bind_signal_light.signal_light_binder     = update
bind_dynamic_light.generic_light_binder   = update
bind_dynamo_hand.dynamo_hand_binder       = update
gwr_worldweapon_binder.gwr_wpn_m98_binder = update   ; a modded exe's script, absent in stock
bind_item.item_binder                     = update
item_artefact.artefact_binder             = update
item_device.device_binder                 = update
; The creature binders' death, hit and use callbacks: the engine reaches them through set_callback, not through the binder,
; and does not catch their errors in Release (script_callback_ex.h process_error is empty without XRAY_EXCEPTIONS). A
; puppet dies when the host says so, the player uses a corpse, nobody asked the player's game for these.
xr_motivator.motivator_binder         = death_callback, hit_callback, use_callback
bind_monster.generic_object_binder    = death_callback, hit_callback, use_callback
