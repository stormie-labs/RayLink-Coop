; Anomaly Coop — sections added to system.ltx (DLTX: mod_system_*.ltx are merged at load).

; Character of a remote player in the host world (and avatar of other players on clients).
; Spawned by the engine (coop_join.cpp), driven by network snapshots, never by AI.
; The player's key and nick live in its custom data ([coop] section).
; Animation mods (W8, GAMMA pass): the avatar is a stalker, so NPC animation packs such as xrMPE NPC Animations
; (Chemzs) apply to it with no line here - every stalker visual loads meshes\actors\stalker_animation*.omf plus all
; meshes\actors\modded_stalker_animations\*.omf (engine SkeletonAnimated.cpp). The avatar replays its owner's
; motions by id (coop_players.cpp), so every player of a session needs the same animation mods (the host's mod
; list check refuses a player whose files differ).
[coop_player_avatar]:sim_default_stalker_0
$spawn                  = "coop\player_avatar"
character_profile       = sim_default_stalker_0
spec_rank               = experienced
community               = stalker
; Owner, live 2026-10-29 (build 29): "the PDA in the hands for others". coop_equip.cpp (show_pda) draws the PDA a player
; holds as an attachment of his avatar, at the PDA's own attach_bone_name / offsets (the left hand). The engine attaches
; only the sections listed here, by exact name (attachment_owner.cpp can_attach), and the stalker list has only
; device_pda. '>' appends to the inherited list (DLTX): the torches, the guitars and the rest of it stay.
>attachable_items       = device_pda_1, device_pda_2, device_pda_3, device_pda_milspec, itm_pda_common, itm_pda_uncommon, itm_pda_rare

; Player colours (W6 allies UI). One colour per player, the same everywhere the player is shown: minimap and PDA
; map arrows and edge pointers, the party panel, name tags over heads (C++ coop_presence), chat nicks.
; Slot of a player = his session peer id (coop.players() "id"): the host is always 0, a client gets the lowest free
; id 1..7 when he joins (xrCoop/coop_session.cpp). The id is the same on every machine and does not change while
; the player stays connected; a player who reconnects gets the lowest free id again (usually his old one).
; Ids >= 8 wrap (id % 8). Lua: coop_allies.color(peer) / argb(peer, a) / text_tag(peer).
; Values "r,g,b" 0..255. Chosen for the dark olive Zone map: muted (no neon), light enough (L* 58..86) for a dark
; map with the icons' black outline for bright roads, no pure red (red = needs help) and no grey (grey = dead),
; checked under protanopia/deuteranopia/tritanopia simulation (Machado 2009): min CIEDE2000 between any two
; colours 14 for normal vision, ~9-10 for colour-blind; slots 0-3 (usual sessions) are the most distinct set.
[coop_player_colors]
color_0                 = 217,177,96    ; sand   #D9B160 (host)
color_1                 = 83,140,224    ; blue   #538CE0
color_2                 = 146,190,154   ; sage   #92BE9A
color_3                 = 206,202,253   ; lilac  #CECAFD
color_4                 = 211,117,79    ; rust   #D3754F
color_5                 = 111,211,203   ; aqua   #6FD3CB
color_6                 = 224,218,164   ; khaki  #E0DAA4
color_7                 = 161,134,178   ; mauve  #A186B2
down                    = 226,58,48     ; needs help (wounded): marker ring, panel badge and label
dead                    = 150,150,150   ; dead / spectating / respawning: marker and panel


; HUD v2 (docs\HUD_V2.md): every size of the compass bar and the team panel, and the alphas of the bar.
; One line per value: change it here, the HUD takes it at the next load (scripts\coop_hud_layout.script; a missing
; or broken line keeps the script's default, which is the same value). Sizes are px at 768 high (1024x768 UI units
; down, times kx = 1024 * H / (768 * W) across: nothing stretches on a wide screen); alphas 0..1.
[coop_hud_layout]
; compass bar: look (0..1; the background and the line fade out on the last 16 % at each end, baked in the textures)
bar_bg_alpha            = 0.33  ; #0C0D0A (owner 2026-10-23: "a bit less murky", was ~0.6)
bar_line_alpha          = 0.8   ; the white line #F4F5F6
; compass bar: sizes
bar_width_pct           = 38    ; of the screen width
bar_top                 = 20    ; from the top of the screen
bar_height              = 24
line_y                  = 15    ; the white line through the bar, from its top
letter_y                = 1     ; letters N NE E ...: top of their box, from the bar's top (above the line)
letter_h                = 13
tick_5                  = 2     ; tick lengths, down from the line
tick_15                 = 4
tick_45                 = 5
notch_w                 = 8     ; the white centre mark under the line, pointing up
notch_h                 = 6
notch_gap               = 3     ; its tip this far under the line
heading_y               = -14   ; the heading "247 deg" (top of its box), from the bar's top
heading_h               = 12
icon                    = 12    ; marker glyph
marker_y                = 9     ; marker centre, from the bar's top (sits on the line, a bit above it)
ping_dot                = 6     ; the cyan dot of a ping
side                    = 8     ; the arrow of a marker pinned to an end
side_gap                = 12    ; pinned marker: centre this far from the end of the bar, its arrow as far outside it
updown                  = 6     ; up / down arrow at a label (height difference > 5 m)
label_gap               = 3     ; labels: this far under the bar
label_h                 = 12
world_ring              = 16    ; a ping over its point in the world
world_dot               = 6
; v2.1 (owner 2026-10-23 19:40: "no intensity by distance"): full alpha up to fade_near_pct % of a kind's range, then
; smoothly down to fade_far_alpha (the icon to fade_far_scale) at the range; beyond it the marker is not shown. Range 0 =
; no limit: always shown, dimmed against fade_ref_m and staying at fade_far_alpha beyond it.
fade_near_pct           = 25
fade_far_alpha          = 0.35
fade_far_scale          = 0.8
fade_ref_m              = 300
; ranges by kind, m (0 = no limit; a mod's kind without a line takes range_default)
range_ally              = 0
range_ping              = 0
range_waypoint          = 0     ; the player's own waypoint (Personal Adjustable Waypoint)
range_task_active       = 0
range_task              = 400   ; the other tasks
range_death             = 400
range_camp              = 300
range_pin               = 500   ; the player's PDA pins (PAW)
range_stash             = 100
range_npc               = 60    ; traders, mechanics, medics and the other people of the PDA
range_sleep             = 50
range_transition        = 300   ; level changers
range_default           = 300
; the sweep of the PDA marks over every object id (level.map_get_object_spots_by_id): ids per frame for the first round
; after a load, then for the endless round (~11 s at 60 fps)
pda_scan_first          = 2048
pda_scan_frame          = 96
; name tags over the players (engine, xrCoop\coop_nametag.h; read once per session): full alpha up to tag_near m,
; smoothly down to tag_far_alpha at tag_far; a wounded one behind a wall x tag_wall_alpha; near the crosshair (radius
; tag_aim_inner..tag_aim_outer of the screen height) down to tag_aim_alpha (wounded: tag_aim_alpha_down); icon sizes px
tag_near                = 20
tag_far                 = 250
tag_far_alpha           = 0.4
tag_wall_alpha          = 0.6
tag_aim_inner           = 0.05
tag_aim_outer           = 0.12
tag_aim_alpha           = 0.45
tag_aim_alpha_down      = 0.75
tag_line_alpha          = 0.72  ; the distance line under the nick, of the nick's alpha
tag_outline_alpha       = 0.55  ; the 1 px dark outline of the text
tag_shadow_alpha        = 0.8   ; the drop shadow (+1, +1)
tag_pulse_low           = 0.6   ; wounded: the icon and the timer line pulse between this and 1 at 1 Hz
tag_icon                = 9     ; the chevron in the player's colour
tag_icon_state          = 11    ; the down ring, the skull
tag_gap                 = 2     ; between the icon and the line
; team panel (variant B, owner 2026-10-23): rows top left, the block grows downwards (bottom left covered the PDA news)
team_x                  = 18    ; from the left edge of the screen
team_top                = 20    ; the top of the highest row; -1: the rows hang from team_bottom upwards instead
team_bottom             = 590   ; (team_top = -1) the bottom of the lowest row (the own HUD starts ~626 / 726)
team_row                = 36    ; from one row to the next
team_strip_w            = 2     ; the player's colour bar at the left of a row
team_strip_h            = 22
team_name_x             = 8     ; nick (white, 1 px shadow) from the row's left
team_name_y             = -2
team_name_h             = 14
team_name_max           = 120   ; longer nicks end with an ellipsis
team_star               = 9     ; host star after the nick
team_dist_gap           = 6     ; distance this far after the nick (or the star)
team_dist_y             = 0
team_dist_h             = 12
team_arrow              = 10    ; direction arrow after the distance, centred team_arrow_y from the row's top
team_arrow_y            = 6
team_seg_x              = 8     ; health: 4 segments of 25 % under the nick
team_seg_y              = 15
team_seg_w              = 30
team_seg_h              = 5
team_seg_gap            = 3
team_seg_empty_alpha    = 0.18  ; the empty part of a segment, white
team_status             = 12    ; state icon (cross in a melting ring, skull, eye, z, !) right of the segments
team_status_gap         = 10    ; its centre this far after the last segment
team_timer_h            = 12    ; "0:42" after the icon
; net graph (scripts\coop_hud_netgraph.script): FPS / ping / loss at the top right, under the stock timers (hud_timer ends at 66),
; clear of the compass bar (38 % in the middle) and of the team panel (top left)
net_right               = 12    ; from the right edge of the screen
net_top                 = 74    ; the top of the plate
net_w                   = 136   ; the plate: pad + label column + number + pad
net_pad                 = 5     ; between the plate's edge and the rows
net_row                 = 13    ; from one row to the next (a row is as high)
net_label_w             = 80    ; the label column (the longest label, Russian "loss max", is 78 wide); the number takes the rest
net_bg_alpha            = 0.33  ; the plate #0C0D0A, as the compass bar's
