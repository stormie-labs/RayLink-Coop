<window>
	<!-- Anomaly Coop - GAMMA: GAMMA's zone_map_16.xml (minimap bottom-right) for ultrawide (aspect over 1.8: 21:9, 32:9 and a 16:9 window's client area) screens. GAMMA kept the
	     stock top-left frame in this file. Only level_frame x differs: the frame centre is x*768 of the 1024 UI units,
	     placed at the right margin it has on 16:9 (0.1218 of the screen height); y is a share of the height already.
	     Numbers: tests/tools/test_gamma_minimap.py. -->
	<minimap>
		<level_frame x="1.265" y="0.8673" width="0.152" height="0.152" stretch="1" alignment="c" a="152"/>

		<background width="0.35" height="0.38" stretch="1" alignment="c">
			<texture>ui\squaredov\minimap</texture>
		</background>

		
	    <clock_wnd x="0.75" y="0.8" width="39" height="16" alignment="c">
	        <text x="0" y="0" font="letterica16" r="223" g="223" b="223" align="c" vert_align="c"/>
	    </clock_wnd>

		<compass x="0.5" y="0.5" width="172" height="172" stretch="1" heading="1" rounded="0" alignment="c">
			<texture>ui\squaredov\compass</texture>
		</compass>

		<center width="32" height="32" alignment="c" stretch="1">
			<texture >ui\squaredov\player</texture>
		</center>

		<static_counter x="0" y="0" width="0" height="0" alignment="c">
			<texture>ui\squaredov\scounter</texture>
			<text_static width="18" height="17">
				<text  align="c" font="letterica16" x="-1" y="0" r="179" g="152" b="109" />
			</text_static>
		</static_counter>

	</minimap>
</window>