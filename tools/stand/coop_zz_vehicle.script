-- Ядро: без проверок режима (docs/MODES.md)
-- Dev 57 F5-VEH-7. Local stand instructions, never sent over the network.
-- vehicle_h is the playing authority, vehicle_ag the test client.
-- The other authority is the process that leads the test client's map with a ghost actor.

local NICK, SECTION = "vehicle_tester", "veh_niva"
local STEP_FILE = "zz_vehicle_step.txt"
local POLL_MS, GRANT_MS, DRIVE_MS = 100, 5000, 3000
-- xrCoop/coop_vehicle_rules.h kEnterMaxDistance: the decider measures the body to the car (coop_vehicles_seat.cpp).
local ENTER_RANGE = 7
local state = { index = 1, next_poll = 0 }
local role, step_path

local function console(command)
	get_console():execute(command)
end

local function out(fmt, ...)
	printf("%s", "[vehicle-stand] " .. string.format(fmt, ...))
	console("flush")
end

local function measurement(ok, fmt, ...)
	local line = string.format(fmt, ...)
	assert(ok, line)
	out("%s", line)
	return true
end

local function instruction()
	step_path = step_path or getFS():update_path("$fs_root$", STEP_FILE)
	local file = io.open(step_path, "r")
	if not file then return end
	local line = file:read("*l")
	file:close()
	if line and #line <= 128 then return line:match("^([a-z_]+)%s*(.-)%s*$") end
end

local function copy(p)
	return {x = p.x, y = p.y, z = p.z}
end

local function delta(a, b)
	return {x = a.x - b.x, y = a.y - b.y, z = a.z - b.z}
end

local function distance(a, b)
	local d = delta(a, b)
	return math.sqrt(d.x * d.x + d.y * d.y + d.z * d.z)
end

local function flat(a, b)
	return math.sqrt((a.x - b.x) ^ 2 + (a.z - b.z) ^ 2)
end

local function car_here(id)
	local car = id and level.object_by_id(id)
	return car and car:section() == SECTION and car or nil
end

local function player_body()
	for _, player in ipairs(coop.players()) do
		if not player.is_self and player.nick == NICK and player.avatar_id
			and coop_mode.where(player.id) == "here" then
			local body = level.object_by_id(player.avatar_id)
			if body and body:alive() then return body end
		end
	end
end

-- Static ground is measured by a ray. An AI vertex alone can snap to a different floor.
local function ground_gap(p, ignore)
	local ray = rq_result()
	local top = vector():set(p.x, p.y + 1, p.z)
	if level.ray_pick(top, vector():set(0, -1, 0), 3, rq_target.rqtStatic, ray, ignore) then
		return ray.range - 1
	end
end

-- The car's forward for o_Angle (0, h, 0): the k axis of setHPB(h, 0, 0) is (-sin h, 0, cos h).
local function heading_forward(h)
	return vector():set(-math.sin(h), 0, math.cos(h))
end

-- Side offsets of the lane rays: one every 0.25 m across the car and a margin. b57i Server (l05_bar): with rays at -1.25, 0
-- and 1.25 a row of 0.3 m posts 8 m apart, 0.1-0.45 m left of the centre line, passed as a clear lane; the car came online
-- over the first post, was shoved 1.27 m off it (b57h's 6.659 m spawn distance is that same shove) and 3 s of forward
-- moved it 0.645 m. Nothing 0.25 m wide or wider stands between these rays.
local LANE_RAYS = {}
for i = 0, 10 do LANE_RAYS[i + 1] = -1.25 + 0.25 * i end

local function runway(p, forward, ignore, reach, marks)
	-- Check the space around the car and `reach` - 2 m in front of it, along `forward` (the spawn: 30 m along its heading).
	-- b57i: 3 s of the client's forward drove 23.8 m and the car coasted on; at the end of a 20 m lane it struck a static
	-- face, slewed 3.4 m aside, and the host's back lane was blocked. 30 m holds the drive and its coast on open ground.
	local side = vector():set(forward.z, 0, -forward.x)
	for _, x in ipairs(LANE_RAYS) do
		local start = vector():set(p.x + side.x * x - forward.x * 2, p.y + 1, p.z + side.z * x - forward.z * 2)
		if level.ray_pick(start, forward, reach or 32, rq_target.rqtStatic, rq_result(), ignore) then return false end
	end
	for _, d in ipairs(marks or {-2, 4, 10, 16, 22, 28}) do
		local gap = ground_gap(vector():set(p.x + forward.x * d, p.y, p.z + forward.z * d), ignore)
		if not gap or math.abs(gap) > 0.8 then return false end
	end
	return true
end

-- A flat car spot 6 m from `origin` whose lane leads away from it: straight out first, then up to 67.5 degrees off.
local function find_lane(origin, ignore)
	for i = 0, 15 do
		local angle = i * math.pi / 8
		local rx, rz = math.cos(angle), math.sin(angle)
		local near = vector():set(origin.x + 6 * rx, origin.y, origin.z + 6 * rz)
		local gap = ground_gap(near, ignore)
		if gap and math.abs(gap) <= 0.6 then
			local pos = vector():set(near.x, near.y - gap + 0.15, near.z)
			local lv = level.vertex_id(pos)
			if lv and lv >= 0 and lv < 4294967295 then
				local base = math.atan2(-rx, rz)
				for _, k in ipairs({0, 1, -1, 2, -2, 3, -3}) do
					local h = base + k * math.pi / 8
					if runway(pos, heading_forward(h), ignore) then return pos, lv, h end
				end
			end
		end
	end
end

local function spawn_car(origin, body)
	local pos, lv, h = find_lane(origin, body)
	if not pos then error("no clear flat lane for veh_niva 6 m from the client") end
	local gv = level.vertex_game_vertex_id and level.vertex_game_vertex_id(lv) or body:game_vertex_id()
	local se = assert(alife_create(SECTION, pos, lv, gv), "veh_niva spawn was refused")
	-- Turn the car onto its lane before it comes online (the stock way: itms_manager.script).
	se.angle = vector():set(0, h, 0)
	state.heading, state.asked = h, copy(pos)
	return se.id
end

-- The rookie_village start is inside a house. The client moves itself to open ground with a lane.
local PLACE_RADII = {10, 15, 20, 25, 30, 40, 50}

local function place_candidate(home, n)
	if n == 1 then return vector():set(home.x, home.y, home.z) end
	local radius = PLACE_RADII[math.floor((n - 2) / 16) + 1]
	if not radius then return end
	local angle = ((n - 2) % 16) * math.pi / 8
	return vector():set(home.x + radius * math.cos(angle), home.y, home.z + radius * math.sin(angle))
end

-- dev66b (l01_escape): the 10 m candidate -228.9 -172.2 lies in a gravitational mine of the save (b57j/b57l: a weak one struck
-- the client there 0.4 s after it was placed; dev66b: a strong one, strike 1.090 at 6 s). The mine pulls a living body to its
-- centre (GraviZone.cpp AffectPullAlife), the client left its printed spot and the authority's copy followed it 1.1 m away.
-- Metres of clearance a spot keeps from the shape of any anomaly.
local ANOMALY_CLEAR = 2

local function in_anomaly(p)
	local found = false
	level.iterate_nearest(p, ANOMALY_CLEAR, function(obj)
		found = obj:is_anomaly() and obj:inside(p, ANOMALY_CLEAR)
		return found
	end)
	return found
end

-- Walkable open ground: an AI node with static ground under it and no anomaly at it.
local function stand_spot(near)
	local lv = level.vertex_id(near)
	if not (lv and lv >= 0 and lv < 4294967295) then return end
	local node = level.vertex_position(lv)
	if math.abs(node.x - near.x) > 1 or math.abs(node.z - near.z) > 1 or math.abs(node.y - near.y) > 6 then return end
	if in_anomaly(node) then return end
	local gap = ground_gap(node, db.actor)
	if gap and math.abs(gap) <= 0.6 then return vector():set(node.x, node.y - gap, node.z) end
end

local function start_engine(car)
	if not car:IsActiveEngine() then
		if car:GetfFuel() < 1 then car:SetfFuel(car:GetfFuelTank()) end
		car:StartEngine()
		assert(car:IsActiveEngine(), "fixture engine did not start")
	end
end

local function authority_car()
	return assert(car_here(state.car), "authority lost the fixture car")
end

local function status(label)
	out("%s status", label)
	console("coop_status")
	console("flush")
	return true
end

local authority_steps = {}

function authority_steps.ready()
	if not player_body() then return end
	out("%s ready map=%s", role, level.name())
	return true
end

function authority_steps.spawn(arg, now)
	if not state.car then
		local body = player_body()
		if not body then return end
		local x, y, z = arg:match("^(-?%d+%.%d+) (-?%d+%.%d+) (-?%d+%.%d+)$")
		assert(x and y and z, "bad client place")
		-- The client moved itself to open ground and checked a lane from exactly this point.
		-- Search from the same numbers once its body has arrived here.
		local place = vector():set(tonumber(x), tonumber(y), tonumber(z))
		state.deadline = state.deadline or now + 10000
		local p = body:position()
		if math.abs(p.x - place.x) > 0.3 or math.abs(p.z - place.z) > 0.3 then
			assert(now <= state.deadline, string.format("client body %.1f %.1f %.1f never reached %s", p.x, p.y, p.z, arg))
			return
		end
		state.car, state.body = spawn_car(place, body), body:id()
		state.client_spot, state.watch_spawn = copy(place), true
	end
	local car = car_here(state.car)
	if not car then return end
	local p, asked = car:position(), state.asked
	if state.watch_spawn then
		-- b57h: one body-relative sample (6.659 m) could not tell a car put off its spot from a body off the client's spot.
		-- Polled every frame until here: where the authority put the car, and the heading it was given.
		state.watch_spawn = nil
		local off = flat(p, asked)
		assert(off <= 0.3 and math.abs(p.y - asked.y) <= 0.6, string.format(
			"car came online at %.3f %.3f %.3f, %.3f m from its spot %.3f %.3f %.3f", p.x, p.y, p.z, off, asked.x, asked.y, asked.z))
		local dir, want = car:direction(), heading_forward(state.heading)
		assert(dir.x * want.x + dir.z * want.z >= 0.9,
			string.format("car faces %.2f %.2f, its lane %.2f %.2f", dir.x, dir.z, want.x, want.z))
	end
	local body = player_body()
	if not body then return end
	local b = body:position()
	local d = distance(p, b)
	local where = string.format("car %.3f %.3f %.3f (%.3f m off its spot), body %.3f %.3f %.3f (%.3f m off the client's spot)",
		p.x, p.y, p.z, flat(p, asked), b.x, b.y, b.z, flat(b, state.client_spot))
	out("spawn at %s", where)
	-- What the scenario needs of the body: the decider's enter check passes (the same two points) and the car is clear of him.
	assert(d >= 3 and d <= ENTER_RANGE, string.format("spawn distance %.3f m: %s", d, where))
	out("spawned car=%d body=%d distance=%.3f", coop.to_host_id(state.car), coop.to_host_id(state.body), d)
	return true
end

function authority_steps.prepare(_, now)
	local car = authority_car()
	if not state.prepared then
		start_engine(car:get_car())
		state.prepared = now + 1000
		return
	end
	if now < state.prepared then return end
	state.origin = copy(car:position())
	out("drive origin=%.3f %.3f %.3f", state.origin.x, state.origin.y, state.origin.z)
	return status("driver")
end

function authority_steps.drive_sample()
	local p = authority_car():position()
	local moved = distance(p, state.origin)
	-- Forward input must move the car down the lane that was checked.
	local lane = heading_forward(state.heading)
	local along = (p.x - state.origin.x) * lane.x + (p.z - state.origin.z) * lane.z
	return measurement(moved >= 5 and along >= 0.8 * moved, "drive moved=%.3f pos=%.3f %.3f %.3f along=%.3f",
		moved, p.x, p.y, p.z, along)
end

function authority_steps.replica_sample()
	local p = authority_car():position()
	out("authority pos=%.3f %.3f %.3f", p.x, p.y, p.z)
	return true
end

function authority_steps.driver_clear() return status("driver exit") end

function authority_steps.passenger_prepare()
	out("map passenger ready car=%d", coop.to_host_id(state.car))
	return status("empty")
end

local function prepare_host_passenger()
	local car = authority_car()
	db.actor:attach_vehicle(car, true)
	local attached = db.actor:get_attached_vehicle()
	assert(attached and attached:id() == car:id(), "stock host attachment failed")
	out("host seated car=%d", coop.to_host_id(state.car))
	return status("host")
end

function authority_steps.passenger_status() return status("passenger") end

-- b57d: the client's drive ran past its checked lane and stopped at a static face (22.9 m, then 0.28 m back).
-- The host backs the car down the lane it has just driven (the stock back key: PressBack, UpdateBack -> DriveBack;
-- fwp is clear after the client's exit, ResetKeys), checked from where the car stands; it lets go after 5 m.
local HOST_REACH, HOST_MARKS, HOST_RELEASE = 12, {2, 5, 8}, 5

local function host_drive(_, now)
	local car = authority_car()
	local physics = car:get_car()
	if not state.host_drive_at then
		local key = bind_to_dik(key_bindings.kBACK, -1)
		assert(key and key > 0, "the host has no back key bound")
		local p, dir = car:position(), car:direction()
		local flat = math.sqrt(dir.x * dir.x + dir.z * dir.z)
		assert(flat > 0.5, "the car is not on its wheels")
		local back = vector():set(-dir.x / flat, 0, -dir.z / flat)
		assert(runway(p, back, car, HOST_REACH, HOST_MARKS),
			string.format("no clear lane %d m behind the car at %.3f %.3f %.3f", HOST_REACH - 2, p.x, p.y, p.z))
		start_engine(physics)
		physics:SetThrottle(1)
		state.host_origin, state.host_back = copy(p), {x = back.x, z = back.z}
		state.host_drive_at, state.host_key = now, key
		level.press_action(key)
		out("host driving")
		return
	end
	local p = car:position()
	local moved = distance(p, state.host_origin)
	if moved < HOST_RELEASE and now - state.host_drive_at < DRIVE_MS then return end
	level.release_action(state.host_key)
	state.host_key = nil
	physics:SetThrottle(0)
	physics:HandBreak()
	-- The back key must move the car back down its lane, not push it aside.
	local along = (p.x - state.host_origin.x) * state.host_back.x + (p.z - state.host_origin.z) * state.host_back.z
	return measurement(moved >= 3 and along >= 0.8 * moved, "host moved=%.3f pos=%.3f %.3f %.3f along=%.3f",
		moved, p.x, p.y, p.z, along)
end

function authority_steps.passenger_clear() return status("passenger exit") end
function authority_steps.reboard_status() return status("reboard") end

function authority_steps.disconnect(_, now)
	-- Sample as soon as the body disappears, while the map server still has the map.
	if player_body() or now < (state.next_status or 0) then return end
	state.next_status = now + 1000
	status("disconnect")
end

local client_steps = {}

function client_steps.ready(_, now)
	if not state.place then
		-- One candidate per poll: the start spot, then rings of 10..50 m around it.
		state.home = state.home or copy(db.actor:position())
		state.tries = (state.tries or 0) + 1
		local near = place_candidate(state.home, state.tries)
		assert(near, "no open ground with a car lane within 50 m of the client")
		local spot = stand_spot(near)
		if not (spot and find_lane(spot, db.actor)) then return end
		state.place, state.deadline = spot, now + GRANT_MS
		if distance(spot, db.actor:position()) > 0.5 then
			db.actor:set_actor_position(vector():set(spot.x, spot.y + 0.3, spot.z))
			return
		end
	end
	local p = db.actor:position()
	local gap = ground_gap(p, db.actor)
	local landed = math.abs(p.x - state.place.x) <= 1 and math.abs(p.z - state.place.z) <= 1 and gap and math.abs(gap) <= 0.6
	assert(landed or now <= state.deadline,
		string.format("client did not land on the lane spot (%.1f %.1f %.1f, ground gap %s)", p.x, p.y, p.z, tostring(gap)))
	if not landed then return end
	-- The authority searches from these printed numbers. A lane that does not hold here: the next candidate.
	local at = vector():set(tonumber(string.format("%.3f", p.x)), tonumber(string.format("%.3f", p.y)),
		tonumber(string.format("%.3f", p.z)))
	if not find_lane(at, db.actor) then state.place = nil; return end
	state.placed_at = copy(at)
	out("client placed pos=%.3f %.3f %.3f", at.x, at.y, at.z)
	out("client ready map=%s", level.name())
	return true
end

function client_steps.online(arg)
	local id = tonumber(arg)
	assert(arg:match("^%d+$") and id > 0 and id < 65535, "bad fixture car id")
	local local_id = coop.to_local_id(id)
	local car = car_here(local_id)
	if not car then return end
	assert(distance(car:position(), db.actor:position()) <= ENTER_RANGE, "fixture copy is outside enter range")
	state.wire_car, state.car = id, local_id
	out("client online car=%d local=%d", id, local_id)
	return true
end

local function enter(seat, command, now, label)
	if not state.deadline then
		state.deadline = now + GRANT_MS
		console(command)
		out("client asked %s seat=%d", label, seat)
	end
	assert(now <= state.deadline, "no attachment within 5 s")
	local grant = coop.vehicle.status()
	if not grant then return end
	assert(grant.car == state.car and grant.seat == seat, "different car or seat granted")
	if not coop.vehicle.attached() then return end
	out("client %s seat=%d car=%d", label, seat, state.wire_car)
	return true
end

function client_steps.driver(_, now)
	return enter(0, "coop_vehicle_enter nearest", now, "seated")
end

function client_steps.drive()
	console("coop_vehicle_drive 0x1 3000")
	out("client driving")
	return true
end

function client_steps.replica(arg)
	local x, y, z = arg:match("^(-?%d+%.%d+) (-?%d+%.%d+) (-?%d+%.%d+)$")
	local target = {x = tonumber(x), y = tonumber(y), z = tonumber(z)}
	for _, axis in ipairs({"x", "y", "z"}) do
		assert(target[axis] and math.abs(target[axis]) < 100000, "bad authority position")
	end
	local p = assert(car_here(state.car), "client lost the fixture car"):position()
	local d = distance(p, target)
	return measurement(d <= 2, "replica pos=%.3f %.3f %.3f delta=%.3f", p.x, p.y, p.z, d)
end

local function leave(seat, now)
	if not state.deadline then
		state.deadline = now + GRANT_MS
		console("coop_vehicle_exit")
	end
	local p = db.actor:position()
	local near = distance(p, assert(car_here(state.car), "fixture car went offline at exit"):position())
	local gap = ground_gap(p, db.actor)
	assert(now <= state.deadline,
		string.format("exit did not settle beside the car (distance %.3f, ground gap %s)", near, tostring(gap)))
	if coop.vehicle.status() or coop.vehicle.attached() or near > 3 or not gap or math.abs(gap) > 0.6 then return end
	out("client exited seat=%d distance=%.3f ground=%.3f", seat, near, gap)
	return true
end

function client_steps.driver_exit(_, now) return leave(0, now) end

function client_steps.passenger(_, now)
	return enter(1, string.format("coop_vehicle_enter %d 1", state.wire_car), now, "seated")
end

function client_steps.follow_start()
	state.follow_car = copy(assert(car_here(state.car), "client lost the fixture car"):position())
	state.follow_actor = copy(db.actor:position())
	out("client following")
	return true
end

function client_steps.follow_sample()
	local car, actor = assert(car_here(state.car), "client lost the fixture car"):position(), db.actor:position()
	local car_move, actor_move = distance(car, state.follow_car), distance(actor, state.follow_actor)
	local drift = distance(delta(car, state.follow_car), delta(actor, state.follow_actor))
	local near = distance(car, actor)
	local attached = coop.vehicle.attached()
	return measurement(attached and car_move >= 3 and actor_move >= 3 and drift <= 2 and near <= 3,
		"client followed car=%.3f actor=%.3f drift=%.3f distance=%.3f attached=%s", car_move, actor_move, drift, near, tostring(attached))
end

function client_steps.passenger_exit(_, now) return leave(1, now) end

function client_steps.reboard(_, now)
	return enter(1, string.format("coop_vehicle_enter %d 1", state.wire_car), now, "reboarded")
end

function client_steps.quit()
	local seat = coop.vehicle.status()
	assert(seat and seat.car == state.car and seat.seat == 1 and coop.vehicle.attached(), "client lost the seat before quit")
	out("client quit seat=1")
	console("quit")
	return true
end

local host_steps = {
	"ready", "spawn", "prepare", "drive_sample", "replica_sample", "driver_clear", "passenger_prepare",
	"passenger_status", "host_drive", "passenger_clear", "reboard_status", "disconnect",
}
local map_steps = {
	"ready", "spawn", "prepare", "drive_sample", "replica_sample", "driver_clear", "passenger_prepare",
	"passenger_status", "passenger_clear", "reboard_status", "disconnect",
}
local mirror_steps = {
	"ready", "online", "driver", "drive", "replica", "driver_exit", "passenger",
	"passenger_exit", "reboard", "quit",
}

local function update()
	if state.failed or not (coop.is_live() and db.actor) then return end
	if role == "client" then
		if not coop_mode.is_player_mirror() then return end
	elseif not coop_mode.leads_here() or coop_mode.actor_is_player() ~= (role == "host") then
		return
	end
	local now = time_global()
	if now < state.next_poll then return end
	state.next_poll = now + POLL_MS
	if role == "client" and state.placed_at and not state.left_spot and mirror_steps[state.index] == "online" then
		-- Probe (once): the client's own body leaves the spot it printed before the car comes, so the authority's
		-- "never reached" is the client's move, not its copy's.
		local p = db.actor:position()
		local off = flat(p, state.placed_at)
		if off > 0.3 then
			state.left_spot = true
			out("client body left its placed spot by %.3f m: now %.3f %.3f %.3f, health %.3f", off, p.x, p.y, p.z,
				db.actor.health or -1)
		end
	end
	local step
	local ok, err = pcall(function()
		local arg
		step, arg = instruction()
		if not step then return end
		local order = role == "client" and mirror_steps or role == "host" and host_steps or map_steps
		local expected = order[state.index]
		if expected == "disconnect" and step == "quit" then step = "disconnect" end
		local run = (role == "client" and client_steps or authority_steps)[step]
		if role == "client" and expected == "passenger_exit" then
			-- The host runner inserts the ride; the Server runner exits the stationary car.
			if step == "follow_start" and not state.follow_car then client_steps.follow_start(); return end
			if step == "follow_sample" and state.follow_car and not state.followed then
				state.followed = client_steps.follow_sample()
				return
			end
			if state.follow_car and not state.followed then return end
		elseif role == "host" then
			if step == "passenger_prepare" then run = prepare_host_passenger end
			if step == "host_drive" then run = host_drive end
		end
		if step == expected and run(arg, now) then
			state.index, state.deadline = state.index + 1, nil
		end
	end)
	-- The spawned car is looked for every frame until it comes online (its placement is measured on that frame).
	if state.watch_spawn then state.next_poll = now end
	if not ok then
		state.failed = true
		if state.host_key then pcall(level.release_action, state.host_key) end
		out("FAIL %s %s", step or "instruction", tostring(err))
	end
end

function on_game_start()
	local ok, line = pcall(command_line)
	if role or not ok or type(line) ~= "string" then return end
	local probe = line:match("%-coop_probe%s+(%S+)")
	if probe == "vehicle_h" then role = "host"
	elseif probe == "vehicle_ag" then role = "client"
	elseif not probe then role = "map"
	else return end
	RegisterScriptCallback("actor_on_update", update)
end
